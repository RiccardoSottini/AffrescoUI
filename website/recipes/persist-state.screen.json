{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"window": { "title": "Remembered", "width": 360, "height": 160 },
	"fonts": { "default": { "file": "../../examples/shared/fonts/Roboto-Regular.ttf", "size": 15 } },
	"state": { "notes": "", "opened": 0 },
	"persist": ["state.notes", "state.opened"],
	"onLoad": [{ "increment": "state.opened", "by": 1 }],
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "type": "textarea", "id": "notes", "x": 24, "y": 24, "width": 312, "height": 40, "padding": 10, "radius": 8,
			  "color": "#ffffff", "textColor": "#0f172a", "placeholder": "Kept across restarts", "bind": "state.notes" },
			{ "type": "label", "id": "opened", "x": 24, "y": 80, "width": 312, "height": 28, "textColor": "#64748b",
			  "text": "Opened {{plural(state.opened, 'time')}}" }
		]
	}
}
