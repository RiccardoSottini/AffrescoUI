{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"window": { "title": "Anchors", "width": 480, "height": 300, "minWidth": 320, "minHeight": 200 },
	"fonts": { "default": { "file": "../../examples/assets/fonts/Roboto-Regular.ttf", "size": 14 } },
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "type": "label", "id": "header", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 44, "padding": 12,
			  "color": "#1e293b", "textColor": "#ffffff", "text": "Header: stretched across" },
			{ "type": "label", "id": "footer", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 28,
			  "padding": 6, "color": "#e2e8f0", "textColor": "#334155", "text": "Footer" },
			{ "type": "label", "id": "sidebar", "anchors": { "left": 0, "top": "#header.bottom", "bottom": "#footer.top" },
			  "width": 140, "padding": 12, "color": "#e0e7ff", "textColor": "#3730a3", "text": "Sidebar" },
			{ "type": "label", "id": "content", "padding": 12, "wrap": true, "textColor": "#0f172a",
			  "anchors": { "left": "#sidebar.right + 12", "right": 12, "top": "#header.bottom + 12",
			               "bottom": "#footer.top - 12" },
			  "text": "Content fills the rest, 12 pixels from its neighbours, as the window resizes." }
		]
	}
}
