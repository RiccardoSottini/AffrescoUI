{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,
	"window": { "title": "Connection", "width": 420, "height": 200 },
	"fonts": { "default": { "file": "../../examples/assets/fonts/Roboto-Regular.ttf", "size": 15 } },
	"state": { "id": "42", "project": null, "busy": false, "error": "" },
	"connections": {
		"api": {
			"url": "https://api.example.com/v1",
			"operations": {
				"getProject": { "path": "/projects/{id}", "timeout": 5000,
				                "mock": { "status": 200, "body": { "id": "42", "name": "Sample project", "open": 3 } } }
			}
		}
	},
	"actions": {
		"load": [{ "request": "api.getProject", "with": { "id": "{{state.id}}" }, "into": "state.project",
		           "loading": "state.busy", "onError": [{ "set": "state.error", "to": "{{error.message}}" }] }]
	},
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "type": "label", "id": "load", "x": 24, "y": 24, "width": 160, "height": 40, "align": "center", "radius": 8,
			  "color": "#6366f1", "textColor": "#ffffff", "cursor": "hand", "role": "button",
			  "text": "{{state.busy ? 'Loading…' : 'Load project'}}", "onClick": "load" },
			{ "type": "label", "id": "result", "x": 24, "y": 80, "width": 372, "height": 28, "textColor": "#0f172a",
			  "text": "{{state.project ? state.project.name + ': ' + state.project.open + ' open' : state.error}}" },
			{ "type": "label", "id": "online", "x": 24, "y": 116, "width": 372, "height": 24, "textColor": "#64748b",
			  "text": "{{connections.api.online ? 'Online' : 'Offline'}}" }
		]
	}
}
