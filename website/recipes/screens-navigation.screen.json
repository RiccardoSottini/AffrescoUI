{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"window": { "title": "Screens", "width": 360, "height": 200 },
	"fonts": { "default": { "file": "../../examples/shared/fonts/Roboto-Regular.ttf", "size": 15 } },
	"styles": {
		"button": { "type": "label", "width": 140, "height": 40, "align": "center", "radius": 8, "color": "#6366f1",
		            "textColor": "#ffffff", "cursor": "hand", "role": "button" },
		"heading": { "type": "label", "x": 24, "y": 24, "width": 312, "height": 32, "textColor": "#0f172a" }
	},
	"screens": {
		"home": { "id": "home", "children": [
			{ "id": "home-title", "style": "heading", "text": "Home" },
			{ "id": "open-settings", "style": "button", "x": 24, "y": 80, "text": "Settings",
			  "onClick": { "navigate": "settings" } }
		] },
		"settings": { "id": "settings", "children": [
			{ "id": "settings-title", "style": "heading", "text": "Settings" },
			{ "id": "back", "style": "button", "x": 24, "y": 80, "text": "Back", "onClick": { "navigate": "back" } }
		] }
	},
	"root": { "color": "#f8fafc", "children": [{ "type": "outlet", "id": "outlet", "fill": true }] }
}
