{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"window": { "title": "Filter chips", "width": 420, "height": 240 },
	"fonts": { "default": { "file": "../../examples/assets/fonts/Roboto-Regular.ttf", "size": 14 } },
	"state": {
		"filter": "all",
		"tags": ["all", "bug", "feature", "docs"],
		"cards": [{ "title": "Crash on resize", "tag": "bug" }, { "title": "Dark theme", "tag": "feature" },
		          { "title": "Recipes", "tag": "docs" }]
	},
	"computed": { "shown": "{{state.filter == 'all' ? state.cards : filter(state.cards, it.tag == state.filter)}}" },
	"styles": {
		"chip": { "type": "label", "fitText": true, "height": 30, "padding": 12, "radius": 15, "align": "center",
		          "color": "#e2e8f0", "textColor": "#0f172a", "cursor": "hand", "role": "button" },
		"chipOn": { "style": "chip", "color": "#6366f1", "textColor": "#ffffff" }
	},
	"components": {
		"chip": { "params": { "label": "", "on": false },
		          "node": { "type": "label", "text": "{{label}}", "style": "{{on ? 'chipOn' : 'chip'}}" } }
	},
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "type": "row", "id": "chips", "x": 24, "y": 24, "width": 372, "height": 42, "gap": 8, "children": [
				{ "use": "chip", "id": "chip", "repeat": { "for": "tag", "in": "state.tags" },
				  "with": { "label": "{{tag}}", "on": "{{tag == state.filter}}" },
				  "onClick": [{ "set": "state.filter", "to": "{{tag}}" }] }
			] },
			{ "type": "column", "id": "cards", "x": 24, "y": 78, "width": 372, "height": 150, "gap": 6, "children": [
				{ "type": "label", "id": "card", "repeat": { "for": "card", "in": "computed.shown" },
				  "anchors": { "left": 0, "right": 0 }, "height": 32, "padding": 8, "radius": 6, "color": "#ffffff",
				  "textColor": "#0f172a", "text": "{{card.title}}" }
			] }
		]
	}
}
