{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,
	"window": { "title": "Menus", "width": 420, "height": 240, "menuBar": [{ "menu": "file", "title": "File" }] },
	"fonts": { "default": { "file": "../../examples/assets/fonts/Roboto-Regular.ttf", "size": 14 } },
	"state": { "bar": {}, "documents": 0 },
	"actions": {
		"new": { "title": "New document", "do": [{ "increment": "state.documents", "by": 1 }] },
		"clear": { "title": "Close all", "enablement": "{{state.documents > 0}}",
		           "do": [{ "set": "state.documents", "to": 0 }] }
	},
	"keys": { "mod+n": "new" },
	"menus": {
		"file": {
			"new": { "run": "new", "group": "1_new" },
			"clear": { "run": "clear", "group": "2_close" }
		}
	},
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "use": "menuBar", "id": "bar", "width": "100%", "when": "{{!window.nativeMenuBar}}",
			  "with": { "open": "state.bar", "menus": [{ "name": "file", "title": "File", "items": "{{menus.file}}" }] } },
			{ "type": "label", "id": "count", "x": 24, "y": 64, "width": 372, "height": 28, "textColor": "#0f172a",
			  "text": "{{plural(state.documents, 'document')}} open" }
		]
	}
}
