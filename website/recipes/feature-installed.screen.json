{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"window": { "title": "A feature", "width": 420, "height": 200 },
	"fonts": { "default": { "file": "../../examples/assets/fonts/Roboto-Regular.ttf", "size": 15 } },
	"include": ["parts/status-bar.json"],
	"state": { "text": "Features are packages that join named places of a screen" },
	"exports": { "editor.text": { "type": "string", "value": "{{state.text}}" } },
	"features": {
		"wordCount": {
			"release": "1.0.0",
			"enabled": true,
			"order": 10,
			"requires": { "format": 2, "points": ["statusBar.right"], "exports": { "editor.text": { "type": "string" } } },
			"provides": {
				"computed": { "words": "{{length(filter(split(app.editor.text, ' '), length(trim(it)) > 0))}}" },
				"views": {
					"statusBar.right": {
						"wordCount-label": { "type": "label", "fitText": true, "padding": 6, "textColor": "#334155",
						                     "text": "{{plural(computed.wordCount.words, 'word')}}" }
					}
				}
			}
		}
	},
	"root": {
		"color": "#f8fafc",
		"children": [
			{ "type": "textarea", "id": "text", "x": 24, "y": 24, "width": 372, "height": 96, "padding": 10, "radius": 8,
			  "color": "#ffffff", "textColor": "#0f172a", "bind": "state.text" },
			{ "use": "statusBar", "id": "status-bar", "anchors": { "left": 0, "right": 0, "bottom": 0 } }
		]
	}
}
