{
	"id": "forge-reset-layout",
	"level": "forge",
	"screen": "examples/forge/index.screen.json",
	"request": "In Forge, add a command \"Reset the Layout\" (category View) that shows the side bar and the panel and leaves Zen Mode, with a button (id status-reset) in the status bar.",
	"scenarios": [
		{
			"name": "reset",
			"steps": [
				{
					"click": "#title-sidebar"
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": false
					}
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": false
					}
				},
				{
					"click": "#status-reset"
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": true
					}
				},
				{
					"expect": {
						"state": "layout.zen",
						"is": false
					}
				}
			]
		},
		{
			"name": "zen",
			"steps": [
				{
					"key": "mod+k"
				},
				{
					"key": "z"
				},
				{
					"expect": {
						"state": "layout.zen",
						"is": true
					}
				},
				{
					"key": "mod+shift+p"
				},
				{
					"wait": 50
				},
				{
					"type": "Reset the Layout"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"state": "quickPick.query",
						"is": ">Reset the Layout"
					}
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"state": "layout.zen",
						"is": false
					}
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": true
					}
				}
			]
		}
	],
	"unchanged": [
		"#title-bar",
		"#activity-bar",
		"#panel",
		"#welcome"
	],
	"reference": [
		{
			"message": "Reset the Layout",
			"set": {
				"/actions/resetLayout": {
					"title": "Reset the Layout",
					"category": "View",
					"icon": "layout",
					"do": [
						{
							"set": "state.layout.sidebar",
							"to": true
						},
						{
							"set": "state.layout.panel",
							"to": true
						},
						{
							"set": "state.layout.zen",
							"to": false
						}
					]
				}
			},
			"add": {
				"#status-bar/children/5": {
					"use": "forgeStatusItem",
					"id": "status-reset",
					"with": {
						"icon": "layout",
						"text": "Reset Layout",
						"tip": "Reset the Layout"
					},
					"onClick": {
						"run": "resetLayout"
					}
				}
			}
		}
	]
}
