{
	"id": "forge-agent-link",
	"level": "forge",
	"screen": "examples/forge/index.screen.json",
	"request": "In Forge, add a button \"Ask the Agent\" (id welcome-agent) to the Welcome page's Quick actions, and a button with the id panel-agent in the panel's header, both showing the Agent view in the side bar.",
	"scenarios": [
		{
			"name": "welcome",
			"steps": [
				{
					"click": "#welcome-agent"
				},
				{
					"expect": {
						"state": "sideView",
						"is": "agent"
					}
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				}
			]
		},
		{
			"name": "panel",
			"steps": [
				{
					"click": "#title-sidebar"
				},
				{
					"click": "#title-panel"
				},
				{
					"click": "#panel-agent"
				},
				{
					"expect": {
						"state": "sideView",
						"is": "agent"
					}
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				}
			]
		}
	],
	"unchanged": [
		"#title-bar",
		"#activity-bar",
		"#status-bar",
		"#agent-view"
	],
	"reference": [
		{
			"message": "Agent links",
			"add": {
				"#welcome-body/children/11": {
					"type": "label",
					"id": "welcome-agent",
					"role": "button",
					"icon": "bot",
					"text": "Ask the Agent",
					"width": "100%",
					"height": 38,
					"padding": 12,
					"radius": 9,
					"color": "@color.widget",
					"cursor": "hand",
					"onClick": {
						"run": "showAgent"
					}
				},
				"#panel-head/children/5": {
					"use": "forgeTitleButton",
					"id": "panel-agent",
					"with": {
						"icon": "bot",
						"tip": "Show Agent"
					},
					"onClick": {
						"run": "showAgent"
					}
				}
			}
		}
	]
}
