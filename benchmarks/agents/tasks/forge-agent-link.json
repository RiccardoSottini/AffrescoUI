{
	"id": "forge-agent-link",
	"level": "forge",
	"screen": "examples/forge/json/index.screen.json",
	"request": "In Forge, add a button \"Ask the Agent\" (id welcome-agent) to the Welcome page's Start list, and a button with the id panel-agent in the panel's header, both showing the Agent view in the side bar.",
	"scenarios": [
		{
			"name": "welcome",
			"steps": [
				{
					"click": "#welcome-agent"
				},
				{
					"expect": {
						"state": "sideView",
						"is": "agent"
					}
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				}
			]
		},
		{
			"name": "panel",
			"steps": [
				{
					"click": "#title-sidebar"
				},
				{
					"click": "#title-panel"
				},
				{
					"click": "#panel-agent"
				},
				{
					"expect": {
						"state": "sideView",
						"is": "agent"
					}
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": true
					}
				}
			]
		}
	],
	"unchanged": [
		"#title-bar",
		"#activity-bar",
		"#status-bar",
		"#agent-view"
	],
	"reference": [
		{
			"message": "Agent links",
			"add": {
				"#welcome-left/children/6": {
					"id": "welcome-agent",
					"use": "forgeWelcomeAction",
					"with": {
						"icon": "bot",
						"text": "Ask the Agent",
						"tip": "Show the Agent view",
						"command": "showAgent"
					},
					"onClick": {
						"run": "showAgent"
					}
				},
				"#panel-head/children/5": {
					"use": "forgeTitleButton",
					"id": "panel-agent",
					"with": {
						"icon": "bot",
						"tip": "Show Agent"
					},
					"onClick": {
						"run": "showAgent"
					}
				}
			}
		}
	]
}
