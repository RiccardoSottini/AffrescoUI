{
	"id": "kanban-total",
	"level": "feature",
	"screen": "examples/flow/index.screen.json",
	"request": "Show how many cards the board has in total in the top bar, right of the scope tabs (scopeTabs), as \"12 cards\", in a label with the id totalCards that counts as cards are added.",
	"scenarios": [
		{
			"name": "total",
			"steps": [
				{
					"expect": {
						"node": "#totalCards",
						"text": "12 cards"
					}
				},
				{
					"key": "mod+n"
				},
				{
					"wait": 50
				},
				{
					"type": "One more"
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"node": "#totalCards",
						"text": "13 cards"
					}
				}
			]
		}
	],
	"unchanged": [
		"#logo",
		"#scopeTabs",
		"#toolbar",
		"#board",
		"#statusBar"
	],
	"reference": [
		{
			"message": "Total cards in the top bar",
			"add": {
				"#topBar/children/-": {
					"id": "totalCards",
					"type": "label",
					"text": "{{sum(computed.counts)}} cards",
					"textColor": "@color.topText",
					"anchors": {
						"left": 600,
						"top": 0,
						"bottom": 0
					},
					"width": 80,
					"align": {
						"vertical": "center"
					}
				}
			}
		}
	]
}
