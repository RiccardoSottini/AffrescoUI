{
	"id": "json-calamaio-body",
	"level": "feature",
	"screen": "examples/calamaio/lisp/calamaio.screen.lisp",
	"request": "In Calamaio, C-g should say \"Cancelled\" in the echo area instead of \"Quit\". Change the steps of the command keyboard-quit, a JSON action in actions.",
	"scenarios": [
		{
			"name": "cancel",
			"steps": [
				{
					"key": "ctrl+x"
				},
				{
					"key": "b"
				},
				{
					"wait": 50
				},
				{
					"type": "*scratch*"
				},
				{
					"key": "enter"
				},
				{
					"wait": 50
				},
				{
					"key": "ctrl+g"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"state": "echo",
						"is": "Cancelled"
					}
				}
			]
		}
	],
	"unchanged": [
		"/program/killring.lisp/kill-line",
		"/program/loop.lisp/eval-defun",
		"/actions/kill-buffer",
		"/program/killring.lisp/yank"
	],
	"reference": [
		{
			"message": "C-g says Cancelled",
			"set": {
				"/actions/keyboard-quit/do/3/to": "Cancelled"
			}
		}
	]
}
