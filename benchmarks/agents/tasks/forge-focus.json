{
	"id": "forge-focus",
	"level": "forge",
	"screen": "examples/forge/json/index.screen.json",
	"request": "In Forge, add a command \"Focus the Editor\" (category View) that hides the side bar and the panel, with a title-bar button (id title-focus) and a button \"Focus the Editor\" (id welcome-focus) in the Welcome page's Quick actions.",
	"scenarios": [
		{
			"name": "welcome",
			"steps": [
				{
					"click": "#welcome-focus"
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": false
					}
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": false
					}
				}
			]
		},
		{
			"name": "title",
			"steps": [
				{
					"click": "#title-panel"
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": true
					}
				},
				{
					"click": "#title-focus"
				},
				{
					"expect": {
						"state": "layout.sidebar",
						"is": false
					}
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": false
					}
				}
			]
		}
	],
	"unchanged": [
		"#activity-bar",
		"#status-bar",
		"#panel",
		"#side-bar"
	],
	"reference": [
		{
			"message": "Focus the Editor",
			"set": {
				"/actions/focusEditor": {
					"title": "Focus the Editor",
					"category": "View",
					"icon": "maximize",
					"do": [
						{
							"set": "state.layout.sidebar",
							"to": false
						},
						{
							"set": "state.layout.panel",
							"to": false
						}
					]
				}
			},
			"add": {
				"#title-bar/children/10": {
					"use": "forgeTitleButton",
					"id": "title-focus",
					"with": {
						"icon": "maximize",
						"tip": "Focus the Editor"
					},
					"onClick": {
						"run": "focusEditor"
					}
				},
				"#welcome-body/children/11": {
					"type": "label",
					"id": "welcome-focus",
					"role": "button",
					"icon": "maximize",
					"text": "Focus the Editor",
					"width": "100%",
					"height": 38,
					"padding": 12,
					"radius": 9,
					"color": "@color.widget",
					"cursor": "hand",
					"onClick": {
						"run": "focusEditor"
					}
				}
			}
		}
	]
}
