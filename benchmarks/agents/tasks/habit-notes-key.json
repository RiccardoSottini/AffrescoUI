{
	"id": "habit-notes-key",
	"level": "feature",
	"screen": "examples/streak/index.screen.json",
	"request": "Add a command \"Sort by name\" that sorts the habit list by name (state.sort to \"name\"), on the shortcut Cmd+Shift+O (mod+shift+o).",
	"scenarios": [
		{
			"name": "key",
			"steps": [
				{
					"expect": {
						"state": "sort",
						"is": "manual"
					}
				},
				{
					"key": "mod+shift+o"
				},
				{
					"expect": {
						"state": "sort",
						"is": "name"
					}
				},
				{
					"expect": {
						"node": "#label-hb-name",
						"text": "Call the family",
						"nth": 0
					}
				}
			]
		}
	],
	"unchanged": [
		"#appBar",
		"#habitList",
		"#detailPane"
	],
	"reference": [
		{
			"message": "Sort by name",
			"set": {
				"/actions/sortByName": {
					"title": "Sort by name",
					"category": "View",
					"do": [
						{
							"set": "state.sort",
							"to": "name"
						}
					]
				},
				"/keys/mod+shift+o": "sortByName"
			}
		}
	]
}
