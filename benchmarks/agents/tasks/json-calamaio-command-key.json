{
	"id": "json-calamaio-command-key",
	"level": "feature",
	"screen": "examples/calamaio/lisp/calamaio.screen.lisp",
	"request": "Add to Calamaio a command count-kills, titled \"Count Kills\", that shows in the echo area how many kills the kill ring holds, as \"Kills: 2\", on the key C-c k (ctrl+c k). Write it in JSON, as an action in actions and a key in keys.",
	"scenarios": [
		{
			"name": "count",
			"steps": [
				{
					"key": "ctrl+x"
				},
				{
					"key": "b"
				},
				{
					"wait": 50
				},
				{
					"type": "*scratch*"
				},
				{
					"key": "enter"
				},
				{
					"wait": 50
				},
				{
					"type": "one two"
				},
				{
					"key": "ctrl+a"
				},
				{
					"key": "ctrl+k"
				},
				{
					"wait": 50
				},
				{
					"key": "ctrl+c"
				},
				{
					"key": "k"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"state": "echo",
						"is": "Kills: 1"
					}
				}
			]
		}
	],
	"unchanged": [
		"/program/killring.lisp/kill-line",
		"/program/loop.lisp/eval-defun",
		"/actions/kill-buffer"
	],
	"present": [
		"/actions/count-kills"
	],
	"reference": [
		{
			"message": "C-c k counts the kills",
			"set": {
				"/actions/count-kills": {
					"title": "Count Kills",
					"category": "Killing",
					"description": "Shows how many kills the ring holds.",
					"do": [
						{
							"run": "message",
							"with": {
								"m": "{{'Kills: ' + length(state.kills)}}"
							}
						}
					]
				},
				"/keys/ctrl+c k": "count-kills"
			}
		}
	]
}
