{
	"id": "kanban-move-card",
	"level": "feature",
	"screen": "examples/flow/json/index.screen.json",
	"request": "Add a \"Start\" button with the id startFirst to the toolbar, left of the Board and Table switch, that moves the first card of the Backlog to the end of In progress.",
	"scenarios": [
		{
			"name": "moved",
			"steps": [
				{
					"click": "#startFirst"
				},
				{
					"expect": {
						"data": "lane0.length",
						"is": 3
					}
				},
				{
					"expect": {
						"data": "lane1.length",
						"is": 4
					}
				},
				{
					"expect": {
						"data": "lane1[3].title",
						"is": "Onboarding checklist for new teams"
					}
				},
				{
					"expect": {
						"node": "#columnCount",
						"text": "3",
						"nth": 0
					}
				},
				{
					"expect": {
						"node": "#columnCount",
						"text": "4",
						"nth": 1
					}
				}
			]
		}
	],
	"unchanged": [
		"#topBar",
		"#views",
		"#newCard",
		"#board",
		"#statusBar"
	],
	"reference": [
		{
			"message": "Start the first Backlog card",
			"set": {
				"/actions/startFirst": {
					"title": "Start the first Backlog card",
					"category": "Board",
					"do": [
						{
							"update": "issues",
							"id": "{{computed.columns[0].cards[0].id}}",
							"fields": {
								"status": 1,
								"order": "{{max(concat([-1], map(computed.columns[1].cards, it.order))) + 1}}"
							}
						}
					]
				}
			},
			"add": {
				"#toolbar/children/-": {
					"id": "startFirst",
					"style": "chip",
					"width": 110,
					"height": 32,
					"text": "Start",
					"anchors": {
						"right": 548,
						"top": 4
					},
					"onClick": "startFirst"
				}
			}
		}
	]
}
