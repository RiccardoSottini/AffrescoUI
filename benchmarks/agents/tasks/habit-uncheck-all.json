{
	"id": "habit-uncheck-all",
	"level": "feature",
	"screen": "examples/streak/json/index.screen.json",
	"request": "Add a \"Pick all\" link with the id pickAll to the day header (#dayHeader), above the habit names, that picks every habit the list shows (state.picked holds their ids).",
	"scenarios": [
		{
			"name": "pick",
			"steps": [
				{
					"expect": {
						"state": "picked.length",
						"is": 0
					}
				},
				{
					"click": "#pickAll"
				},
				{
					"expect": {
						"state": "picked.length",
						"is": 7
					}
				},
				{
					"expect": {
						"state": "picked[0]",
						"is": "meditate"
					}
				},
				{
					"expect": {
						"node": "#label-t-picked-n",
						"text": "7 selected"
					}
				}
			]
		}
	],
	"unchanged": [
		"#appBar",
		"#row-day-header",
		"#habitList",
		"#detailPane"
	],
	"reference": [
		{
			"message": "Pick all",
			"set": {
				"/actions/pickAll": {
					"title": "Pick every habit",
					"category": "Habits",
					"do": [
						{
							"set": "state.picked",
							"to": "{{map(computed.order, data.ordered[it].id)}}"
						}
					]
				}
			},
			"add": {
				"#dayHeader/children/-": {
					"id": "pickAll",
					"type": "label",
					"text": "Pick all",
					"fitText": true,
					"cursor": "hand",
					"anchors": {
						"left": 16,
						"top": 14
					},
					"onClick": "pickAll"
				}
			}
		}
	]
}
