{
	"id": "forge-status-output",
	"level": "forge",
	"screen": "examples/forge/json/index.screen.json",
	"request": "In Forge, add an \"Output\" item (id status-output) to the status bar that opens the panel on its Output tab.",
	"scenarios": [
		{
			"name": "output",
			"steps": [
				{
					"expect": {
						"state": "layout.panel",
						"is": false
					}
				},
				{
					"click": "#status-output"
				},
				{
					"expect": {
						"state": "layout.panel",
						"is": true
					}
				},
				{
					"expect": {
						"state": "panelTab",
						"is": "output"
					}
				},
				{
					"expect": {
						"node": "#panel-clear-output",
						"property": "shown",
						"is": true
					}
				}
			]
		}
	],
	"unchanged": [
		"#title-bar",
		"#activity-bar",
		"#panel",
		"#welcome"
	],
	"reference": [
		{
			"message": "Output in the status bar",
			"add": {
				"#status-bar/children/5": {
					"use": "forgeStatusItem",
					"id": "status-output",
					"with": {
						"icon": "terminal",
						"text": "Output",
						"tip": "Show Output"
					},
					"onClick": [
						{
							"set": "state.layout.panel",
							"to": true
						},
						{
							"set": "state.panelTab",
							"to": "output"
						}
					]
				}
			}
		}
	]
}
