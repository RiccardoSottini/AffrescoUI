{
	"id": "forge-zen-buttons",
	"level": "forge",
	"screen": "examples/forge/json/index.screen.json",
	"request": "In Forge, add a Zen Mode button with the id title-zen to the title bar, next to Toggle Panel, and one with the id panel-zen to the panel's header, next to its close button; both toggle Zen Mode.",
	"scenarios": [
		{
			"name": "title",
			"steps": [
				{
					"click": "#title-zen"
				},
				{
					"expect": {
						"state": "layout.zen",
						"is": true
					}
				}
			]
		},
		{
			"name": "panel",
			"steps": [
				{
					"click": "#title-panel"
				},
				{
					"click": "#panel-zen"
				},
				{
					"expect": {
						"state": "layout.zen",
						"is": true
					}
				}
			]
		}
	],
	"unchanged": [
		"#activity-bar",
		"#status-bar",
		"#panel-tabs",
		"#welcome"
	],
	"reference": [
		{
			"message": "Zen Mode buttons",
			"add": {
				"#title-bar/children/9": {
					"use": "forgeTitleButton",
					"id": "title-zen",
					"with": {
						"icon": "maximize",
						"tip": "Toggle Zen Mode"
					},
					"onClick": {
						"run": "toggleZen"
					}
				},
				"#panel-head/children/5": {
					"use": "forgeTitleButton",
					"id": "panel-zen",
					"with": {
						"icon": "maximize",
						"tip": "Toggle Zen Mode"
					},
					"onClick": {
						"run": "toggleZen"
					}
				}
			}
		}
	]
}
