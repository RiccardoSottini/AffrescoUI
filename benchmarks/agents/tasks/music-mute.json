{
	"id": "music-mute",
	"level": "feature",
	"screen": "examples/tempo/music-player.screen.json",
	"request": "Add a \"Mute\" button with the id mute in the playlist header, right of the play button, that sets the volume to 0, and make Cmd+M (mod+m) do the same.",
	"scenarios": [
		{
			"name": "button",
			"steps": [
				{
					"click": "#mute"
				},
				{
					"expect": {
						"state": "volume",
						"is": 0
					}
				}
			]
		},
		{
			"name": "key",
			"steps": [
				{
					"key": "mod+m"
				},
				{
					"expect": {
						"state": "volume",
						"is": 0
					}
				}
			]
		}
	],
	"unchanged": [
		"#sidebar",
		"#playButton",
		"#listName",
		"#tracks"
	],
	"reference": [
		{
			"message": "Mute",
			"set": {
				"/actions/mute": {
					"title": "Mute",
					"category": "Playback",
					"do": [
						{
							"set": "state.volume",
							"to": 0
						}
					]
				},
				"/keys/mod+m": "mute"
			},
			"add": {
				"#header/children/-": {
					"id": "mute",
					"type": "label",
					"text": "Mute",
					"fitText": true,
					"cursor": "hand",
					"anchors": {
						"left": 330,
						"top": 210
					},
					"onClick": "mute"
				}
			}
		}
	]
}
