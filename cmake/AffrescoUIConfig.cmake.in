# The AffrescoUI package (cmake/AffrescoUIInstall.cmake): find_package(AffrescoUI 0.1 CONFIG) defines the targets
# affrescoui::affrescoui (everything) and affrescoui::core, ::render, ::format, ::vcs and ::channel (one module each).

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The dependencies installed with AffrescoUI, in this prefix unless the application's CMAKE_PREFIX_PATH names another
# copy first. nlohmann/json must be the exact version: its types carry it in their names, which the libraries use.
find_dependency(nlohmann_json @AFFRESCOUI_JSON_VERSION@ EXACT CONFIG PATHS "${PACKAGE_PREFIX_DIR}")
find_dependency(glfw3 @AFFRESCOUI_GLFW_VERSION@ CONFIG PATHS "${PACKAGE_PREFIX_DIR}")

include("${CMAKE_CURRENT_LIST_DIR}/AffrescoUITargets.cmake")
check_required_components(AffrescoUI)
