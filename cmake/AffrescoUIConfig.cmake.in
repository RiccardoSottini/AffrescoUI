# The AffrescoUI package (cmake/AffrescoUIInstall.cmake): find_package(AffrescoUI 0.1 CONFIG) defines the targets
# affrescoui::affrescoui (everything) and affrescoui::core, ::render, ::format, ::themes, ::vcs, ::channel, ::net, ::services
# and, when built with it, ::audio (one module each).

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The dependencies installed with AffrescoUI, in this prefix unless the application's CMAKE_PREFIX_PATH names another
# copy first. HINTS, not PATHS: PATHS come after the system prefixes, where a different copy may be installed.
# nlohmann/json must be the exact version: its types carry it in their names, which the libraries use.
find_dependency(nlohmann_json @AFFRESCOUI_JSON_VERSION@ EXACT CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(glfw3 @AFFRESCOUI_GLFW_VERSION@ CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(freetype @AFFRESCOUI_FREETYPE_VERSION@ CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
# libcurl: the system's (macOS), or the pinned one installed with AffrescoUI (cmake/AffrescoUINetwork.cmake)
if(@AFFRESCOUI_SYSTEM_CURL@)
	find_dependency(CURL)
else()
	find_dependency(CURL @AFFRESCOUI_CURL_VERSION@ EXACT CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
endif()

# The threads of the audio module (miniaudio) and the data module (SQLite), on Linux and other Unix systems
if(UNIX AND NOT APPLE)
	find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AffrescoUITargets.cmake")
check_required_components(AffrescoUI)
