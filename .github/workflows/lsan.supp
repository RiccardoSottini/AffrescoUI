# LeakSanitizer suppressions for the sanitizers job: memory Mesa's OpenGL driver keeps until exit. GLFW unloads the
# driver at glfwTerminate(), before the leak report, so its frames show as "<unknown module>" and can't be named here;
# these are the places where GLFW and the renderer call into it.
leak:extensionSupportedGLX
leak:affresco::gl::QuadRenderer::draw
