{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/RiccardoSottini/AffrescoUI/schema/affrescoui-screen.schema.json",
	"title": "AffrescoUI Screen Format",
	"description": "A user interface for the AffrescoUI library. Specification: SCREEN_FORMAT.md. Each format version has its definitions under $defs/v<N>; \"version\" selects one.",
	"type": "object",
	"required": [
		"version"
	],
	"properties": {
		"version": {
			"enum": [
				1
			],
			"description": "Format version. This library reads: 1"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 1
					}
				},
				"required": [
					"version"
				]
			},
			"then": {
				"$ref": "#/$defs/v1/screen"
			}
		}
	],
	"$defs": {
		"v1": {
			"screen": {
				"description": "Version 1 of the format",
				"type": "object",
				"required": [
					"version",
					"root"
				],
				"additionalProperties": false,
				"properties": {
					"$schema": {
						"type": "string"
					},
					"format": {
						"const": "affrescoui-screen"
					},
					"version": {
						"const": 1
					},
					"note": {
						"type": "string"
					},
					"window": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"title": {
								"type": "string"
							},
							"width": {
								"type": "integer",
								"minimum": 1
							},
							"height": {
								"type": "integer",
								"minimum": 1
							},
							"minWidth": {
								"type": "integer",
								"minimum": 0
							},
							"minHeight": {
								"type": "integer",
								"minimum": 0
							}
						}
					},
					"fonts": {
						"type": "object",
						"description": "Fonts by name; \"default\" is used by text without a \"font\"",
						"additionalProperties": {
							"type": "object",
							"required": [
								"file",
								"size"
							],
							"additionalProperties": false,
							"properties": {
								"file": {
									"type": "string"
								},
								"size": {
									"type": "number",
									"exclusiveMinimum": 0
								},
								"fallback": {
									"type": "array",
									"description": "Other fonts in \"fonts\", asked in order for characters this one lacks; drawn at this font's size",
									"maxItems": 8,
									"items": {
										"type": "string"
									}
								}
							}
						}
					},
					"colors": {
						"type": "object",
						"description": "Named colors (\"@name\"), or per theme: {\"light\": ..., \"dark\": ...}",
						"additionalProperties": {
							"anyOf": [
								{
									"$ref": "#/$defs/v1/hexColor"
								},
								{
									"type": "object",
									"minProperties": 1,
									"additionalProperties": {
										"$ref": "#/$defs/v1/hexColor"
									}
								}
							]
						}
					},
					"theme": {
						"description": "Which color variant is shown, e.g. \"{{state.theme}}\""
					},
					"styles": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/node"
						}
					},
					"components": {
						"type": "object",
						"additionalProperties": {
							"type": "object",
							"required": [
								"node"
							],
							"additionalProperties": false,
							"properties": {
								"params": {
									"type": "object"
								},
								"node": {
									"$ref": "#/$defs/v1/node"
								},
								"note": {
									"type": "string"
								}
							}
						}
					},
					"templates": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/node"
						}
					},
					"screens": {
						"type": "object",
						"description": "Screens an \"outlet\" shows; {\"navigate\": name} switches",
						"additionalProperties": {
							"$ref": "#/$defs/v1/node"
						}
					},
					"state": {
						"type": "object"
					},
					"stateTypes": {
						"type": "object",
						"description": "A type per state key, written as JSON Schema: type, enum, const, properties, required, additionalProperties, items, minimum, maximum, minLength, maxLength, minItems, maxItems",
						"additionalProperties": {
							"$ref": "#/$defs/v1/stateType"
						}
					},
					"computed": {
						"type": "object",
						"description": "Values derived from the state, read as computed.name"
					},
					"watch": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/handler"
						},
						"description": "\"state.path\" -> handler, run when it changed"
					},
					"actions": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/steps"
						}
					},
					"keys": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/handler"
						},
						"description": "Screen-wide shortcuts: \"mod+k\" -> handler"
					},
					"onLoad": {
						"$ref": "#/$defs/v1/handler"
					},
					"channels": {
						"type": "object",
						"description": "Programs the screen talks to; messages run \"name:type\" actions. Revisions can't change it.",
						"additionalProperties": {
							"type": "object",
							"required": [
								"socket"
							],
							"additionalProperties": false,
							"properties": {
								"socket": {
									"type": "string"
								},
								"note": {
									"type": "string"
								},
								"reconnect": {
									"anyOf": [
										{
											"type": "boolean"
										},
										{
											"type": "number"
										},
										{
											"type": "object",
											"properties": {
												"after": {
													"type": "number"
												}
											}
										}
									]
								}
							}
						}
					},
					"persist": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^state\\."
						},
						"description": "State paths kept on disk. Revisions can't change it."
					},
					"include": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						]
					},
					"permissions": {
						"type": "object",
						"additionalProperties": false,
						"description": "Who may change the running screen (VERSION_CONTROL.md). Revisions can't change it.",
						"properties": {
							"allow": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/v1/permissionRule"
								}
							},
							"ask": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/v1/permissionRule"
								}
							},
							"deny": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/v1/permissionRule"
								}
							},
							"reviewers": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					},
					"root": {
						"$ref": "#/$defs/v1/node",
						"description": "The window's root panel: it always fills the window"
					}
				}
			},
			"node": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"description": "panel (default), label, textarea, editor, stack, row, column, grid, toggle, checkbox, slider, image, split, tabs, list, tree, outlet, or a type the application registers (which may add properties of its own)",
						"anyOf": [
							{
								"enum": [
									"panel",
									"label",
									"textarea",
									"editor",
									"stack",
									"row",
									"column",
									"grid",
									"toggle",
									"checkbox",
									"slider",
									"image",
									"split",
									"tabs",
									"list",
									"tree",
									"outlet"
								]
							},
							{
								"type": "string"
							}
						]
					},
					"id": {
						"type": "string",
						"description": "Addresses the node: #id in edits, nodes.id, anchors, focus"
					},
					"style": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						]
					},
					"children": {
						"type": "array",
						"items": {
							"$ref": "#/$defs/v1/node"
						}
					},
					"x": {
						"$ref": "#/$defs/v1/length"
					},
					"y": {
						"$ref": "#/$defs/v1/length"
					},
					"width": {
						"$ref": "#/$defs/v1/length"
					},
					"height": {
						"$ref": "#/$defs/v1/length"
					},
					"minWidth": {
						"$ref": "#/$defs/v1/length"
					},
					"minHeight": {
						"$ref": "#/$defs/v1/length"
					},
					"maxWidth": {
						"description": "The largest width (the minimum wins); \"none\" for no maximum",
						"anyOf": [
							{
								"const": "none"
							},
							{
								"$ref": "#/$defs/v1/length"
							}
						]
					},
					"maxHeight": {
						"description": "The largest height (the minimum wins); \"none\" for no maximum",
						"anyOf": [
							{
								"const": "none"
							},
							{
								"$ref": "#/$defs/v1/length"
							}
						]
					},
					"aspectRatio": {
						"description": "Width divided by height (1.5 or \"16/9\"): the height follows the width, or the width follows the height when only the height is set",
						"anyOf": [
							{
								"type": "number",
								"exclusiveMinimum": 0
							},
							{
								"type": "string",
								"pattern": "^[0-9]+(\\.[0-9]+)? */ *[0-9]+(\\.[0-9]+)?$"
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"anchors": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"top": {
								"$ref": "#/$defs/v1/edge"
							},
							"bottom": {
								"$ref": "#/$defs/v1/edge"
							},
							"left": {
								"$ref": "#/$defs/v1/edge"
							},
							"right": {
								"$ref": "#/$defs/v1/edge"
							}
						}
					},
					"fill": {
						"oneOf": [
							{
								"const": true
							},
							{
								"$ref": "#/$defs/v1/length"
							}
						],
						"description": "Anchor all four edges, this far in"
					},
					"grow": {
						"anyOf": [
							{
								"type": "number"
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"shrink": {
						"description": "In a row or column: how much of an overflow it gives up, in proportion to its size (CSS flex-shrink). Default 0",
						"anyOf": [
							{
								"type": "number",
								"minimum": 0
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"basis": {
						"description": "In a row or column: its size along it before growing or shrinking (CSS flex-basis); \"auto\" for its own",
						"anyOf": [
							{
								"const": "auto"
							},
							{
								"$ref": "#/$defs/v1/length"
							}
						]
					},
					"alignSelf": {
						"description": "In a row, column or grid: where it sits across, over the container's alignItems",
						"$ref": "#/$defs/v1/crossAlign"
					},
					"cell": {
						"description": "In a grid: its first column and row (from 1) and how many it spans; left out, the next free cell",
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"column": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000
							},
							"row": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000
							},
							"columnSpan": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000
							},
							"rowSpan": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000
							}
						}
					},
					"color": {
						"$ref": "#/$defs/v1/color"
					},
					"radius": {
						"description": "Rounds the corners: one radius for all four, or one per corner (left out: square)",
						"anyOf": [
							{
								"$ref": "#/$defs/v1/pixels"
							},
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"topLeft": {
										"$ref": "#/$defs/v1/pixels"
									},
									"topRight": {
										"$ref": "#/$defs/v1/pixels"
									},
									"bottomRight": {
										"$ref": "#/$defs/v1/pixels"
									},
									"bottomLeft": {
										"$ref": "#/$defs/v1/pixels"
									}
								}
							}
						]
					},
					"borderWidth": {
						"description": "A border inside the node's edges; it doesn't change the layout",
						"$ref": "#/$defs/v1/pixels"
					},
					"borderColor": {
						"description": "Default: black",
						"$ref": "#/$defs/v1/color"
					},
					"shadow": {
						"type": "object",
						"additionalProperties": false,
						"description": "Like CSS box-shadow: the node's shape, moved and blurred, under it (clipped by the parent)",
						"properties": {
							"x": {
								"anyOf": [
									{
										"type": "number"
									},
									{
										"$ref": "#/$defs/v1/dynamic"
									}
								]
							},
							"y": {
								"anyOf": [
									{
										"type": "number"
									},
									{
										"$ref": "#/$defs/v1/dynamic"
									}
								]
							},
							"blur": {
								"description": "A Gaussian blur with a standard deviation of blur / 2",
								"$ref": "#/$defs/v1/pixels"
							},
							"color": {
								"description": "Default: #00000040",
								"$ref": "#/$defs/v1/color"
							}
						}
					},
					"visible": {
						"$ref": "#/$defs/v1/flag"
					},
					"cursor": {
						"anyOf": [
							{
								"enum": [
									"arrow",
									"ibeam",
									"hand",
									"resize-horizontal",
									"resize-vertical"
								]
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"tooltip": {
						"description": "Text, or a {{binding}}"
					},
					"disabled": {
						"$ref": "#/$defs/v1/flag"
					},
					"scroll": {
						"anyOf": [
							{
								"enum": [
									"vertical",
									"horizontal",
									"both",
									"none"
								]
							},
							{
								"type": "boolean"
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"overlay": {
						"type": "object",
						"additionalProperties": false,
						"description": "Drawn above everything, next to its anchor",
						"properties": {
							"anchor": {
								"type": "string"
							},
							"placement": {
								"enum": [
									"below",
									"below-end",
									"above",
									"above-end",
									"right",
									"left",
									"center",
									"window"
								]
							},
							"open": {
								"description": "A state path (\"state.menuOpen\") or a value"
							},
							"dismiss": {
								"const": "outside"
							}
						}
					},
					"hover": {
						"$ref": "#/$defs/v1/stateBlock"
					},
					"focused": {
						"$ref": "#/$defs/v1/stateBlock"
					},
					"dragging": {
						"$ref": "#/$defs/v1/stateBlock"
					},
					"dragOver": {
						"$ref": "#/$defs/v1/stateBlock"
					},
					"pressed": {
						"$ref": "#/$defs/v1/stateBlock"
					},
					"transition": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"color": {
								"type": "number"
							},
							"textColor": {
								"type": "number"
							},
							"borderColor": {
								"type": "number"
							}
						}
					},
					"repeat": {
						"type": "object",
						"required": [
							"in"
						],
						"additionalProperties": false,
						"description": "One node per list item",
						"properties": {
							"for": {
								"type": "string"
							},
							"in": {
								"description": "A path like \"state.items\", a data model of the application like \"models.files\", or any value"
							},
							"index": {
								"type": "string"
							},
							"key": {
								"description": "Identifies an item when the list is reordered"
							}
						}
					},
					"when": {
						"description": "Build the node only if truthy"
					},
					"let": {
						"type": "object",
						"description": "Named values for the node and its children, in order"
					},
					"use": {
						"type": "string",
						"description": "A component from \"components\""
					},
					"with": {
						"type": "object",
						"description": "A component's parameters"
					},
					"check": {
						"type": "object",
						"additionalProperties": false,
						"description": "Gives valid and error",
						"properties": {
							"rule": {},
							"message": {},
							"value": {}
						}
					},
					"every": {
						"type": "object",
						"required": [
							"ms",
							"do"
						],
						"additionalProperties": false,
						"properties": {
							"ms": {
								"anyOf": [
									{
										"type": "number"
									},
									{
										"$ref": "#/$defs/v1/dynamic"
									}
								]
							},
							"do": {
								"$ref": "#/$defs/v1/handler"
							}
						}
					},
					"drag": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"data": {}
						}
					},
					"keys": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/$defs/v1/handler"
						},
						"description": "Shortcuts while focused: \"mod+k\" -> handler"
					},
					"locked": {
						"type": "boolean"
					},
					"note": {
						"type": "string",
						"description": "A comment"
					},
					"text": {
						"description": "Text, or a {{binding}}"
					},
					"textColor": {
						"$ref": "#/$defs/v1/color"
					},
					"font": {
						"type": "string"
					},
					"padding": {
						"anyOf": [
							{
								"type": "number"
							},
							{
								"$ref": "#/$defs/v1/dynamic"
							}
						]
					},
					"align": {
						"oneOf": [
							{
								"$ref": "#/$defs/v1/align"
							},
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"horizontal": {
										"$ref": "#/$defs/v1/align"
									},
									"vertical": {
										"$ref": "#/$defs/v1/align"
									}
								}
							}
						],
						"description": "label: text alignment; stack: v1 name of \"from\""
					},
					"wrap": {
						"$ref": "#/$defs/v1/flag"
					},
					"fitText": {
						"oneOf": [
							{
								"type": "boolean"
							},
							{
								"type": "object",
								"required": [
									"maxWidth"
								],
								"additionalProperties": false,
								"properties": {
									"maxWidth": {
										"type": "number",
										"exclusiveMinimum": 0
									}
								}
							}
						]
					},
					"icon": {
						"type": "string",
						"description": "label: an icon before the text, by its glyph name in the label's font or its fallbacks (e.g. Lucide's \"search\")"
					},
					"bind": {
						"type": "string",
						"description": "A state path kept in sync both ways (textarea, editor, toggle, checkbox, slider, split, tabs, list, tree)"
					},
					"caret": {
						"type": "string",
						"description": "editor: a state path the editor writes its caret to, as { line, column, selected } (from 1)"
					},
					"lineNumbers": {
						"type": "boolean",
						"description": "editor: show line numbers in a gutter"
					},
					"lineNumberColor": {
						"$ref": "#/$defs/v1/color"
					},
					"activeLineNumberColor": {
						"$ref": "#/$defs/v1/color"
					},
					"lineColor": {
						"$ref": "#/$defs/v1/color"
					},
					"selectionColor": {
						"$ref": "#/$defs/v1/color"
					},
					"caretColor": {
						"$ref": "#/$defs/v1/color"
					},
					"autofocus": {
						"type": "boolean"
					},
					"onChange": {
