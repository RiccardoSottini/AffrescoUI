# Writes a file's bytes into a C++ source file as a function returning them, so a tool carries the file with it.
#
#   cmake -DINPUT=<file> -DOUTPUT=<source.cpp> -DFUNCTION=<qualified name> -P Embed.cmake
#
# FUNCTION is declared `std::string_view FUNCTION();` by the code that uses it, e.g. affresco::cli::embeddedSchema.
file(READ "${INPUT}" content HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")
string(REGEX REPLACE "^(.*)::([^:]+)$" "\\1" namespace "${FUNCTION}")
string(REGEX REPLACE "^(.*)::([^:]+)$" "\\2" name "${FUNCTION}")
file(WRITE "${OUTPUT}.new"
	"// Generated by Embed.cmake from ${INPUT}: don't edit.\n"
	"#include <string_view>\n"
	"namespace ${namespace} {\n"
	"namespace {\n"
	"constexpr unsigned char bytes[] = {${bytes}};\n"
	"} // namespace\n"
	"std::string_view ${name}() { return {reinterpret_cast<const char*>(bytes), sizeof(bytes)}; }\n"
	"} // namespace ${namespace}\n")
# Only a change touches the source, so it isn't rebuilt for nothing
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
