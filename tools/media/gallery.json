{
	"note": "Every application's pictures, read by tools/media/capture.py (the pictures in .github/media/) and tests/smoke/first_frames.py (CI: every application opens and draws). A row: the application, its screen and its scenarios file (relative to examples/), the scenario that shows it doing its job, the pictures' name (<output>.png, <output>-scene.png), the runner that has its natives, for a picture that replaces one of another size, that size, and the milliseconds a first frame waits for (\"settle\": e.g. past a debounce that draws thumbnails). A new application is covered by a new row.",
	"runners": {
		"render": {
			"note": "The rendering check's runner: the templates, Forge, the code editor and the surfaces",
			"command": ["{build}/affrescoui_render_runner", "--out", "{out}", "{file}"]
		},
		"tempera": {
			"note": "Tempera's scenarios runner, with its natives and the sample document",
			"command": ["{build}/affrescoui_tempera_scenarios", "--out", "{out}", "{file}"]
		},
		"sinopia": {
			"note": "Sinopia, playing scenarios headless with its natives and the sample deck",
			"command": ["{build}/affrescoui_sinopia", "--check", "{file}", "--out", "{out}"]
		},
		"bottega": {
			"note": "Bottega's own runner, when it is on this base",
			"command": ["{build}/affrescoui_bottega", "--check", "{file}", "--out", "{out}"]
		}
	},
	"apps": [
		{ "app": "Launcher", "screen": "launcher/index.screen.json", "scenarios": "launcher/index.scenarios.json", "scene": "my-apps", "output": "launcher", "runner": "render" },
		{ "app": "Flow", "screen": "flow/index.screen.json", "scenarios": "flow/index.scenarios.json", "scene": "a-card-mid-drag", "output": "kanban", "runner": "render" },
		{ "app": "Haven", "screen": "haven/index.screen.json", "scenarios": "haven/index.scenarios.json", "scene": "energy-by-device", "output": "smart-home", "runner": "render" },
		{ "app": "Tempo", "screen": "tempo/index.screen.json", "scenarios": "tempo/index.scenarios.json", "scene": "now-playing-visualiser-and-lyrics", "output": "music-player", "runner": "render" },
		{ "app": "Streak", "screen": "streak/index.screen.json", "scenarios": "streak/index.scenarios.json", "scene": "a-row-selects-its-habit", "output": "habit-tracker", "runner": "render" },
		{ "app": "Sign in", "screen": "sign-in/index.screen.json", "scenarios": "sign-in/index.scenarios.json", "scene": "password-strength", "output": "sign-in", "runner": "render", "size": [1280, 960] },
		{ "app": "Quaderno", "screen": "code-editor/index.screen.json", "scenarios": "code-editor/index.scenarios.json", "scene": "a-problem-opens-its-file", "output": "code-editor", "runner": "render" },
		{ "app": "Forge", "screen": "forge/index.screen.json", "scenarios": "forge/scm.scenarios.json", "scene": "forge-scm-diff-and-terminal", "output": "forge", "runner": "render", "size": [1280, 810] },
		{ "app": "Arcadia", "screen": "arcadia/index.screen.json", "scenarios": "arcadia/index.scenarios.json", "scene": "game-page", "output": "arcadia", "runner": "render" },
		{ "app": "Tempera", "screen": "tempera/index.screen.json", "scenarios": "tempera/index.scenarios.json", "scene": "tempera-a-filter-previewing", "output": "tempera", "runner": "tempera" },
		{ "app": "Sinopia", "screen": "sinopia/index.screen.json", "scenarios": "sinopia/index.scenarios.json", "scene": "sinopia-load-the-sample", "output": "sinopia", "runner": "sinopia", "settle": 400 },
		{ "app": "Modello", "screen": "modello/index.screen.json", "scenarios": "modello/index.scenarios.json", "scene": "modello-assistant-open", "output": "modello", "runner": "render" },
		{ "app": "Orrery", "screen": "orrery/index.screen.json", "scenarios": "orrery/index.scenarios.json", "scene": "an-eclipse-seen-from-the-ground", "output": "orrery", "runner": "render" },
		{ "app": "Bottega", "screen": "bottega/bottega.screen.json", "scenarios": "bottega/bottega.scenarios.json", "scene": "bottega-sorter", "output": "bottega", "runner": "bottega" }
	]
}
