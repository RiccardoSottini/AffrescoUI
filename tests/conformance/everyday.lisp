; The everyday probes (README.md): forms people write every day in Clojure, each with the value Clojure gives. The
; runner (`affrescoui_conformance --everyday`) evaluates this file form by form, as the test `cli_lisp_everyday`;
; it needs nothing fetched. A probe that gives another value is a gap, and stays written as a probe:
;   (probe '<form> <Clojure's value>)     the language gives Clojure's value
;   (absent '<form> "<reason>")           out by design: the language has no such value (not run)
;   (differs '<form> <ours> "<reason>")   the language gives another value on purpose, which is checked
; A value written :a-function is any function, :an-error an error raised, :an-ex-info an ex-info whose message is
; "a"; a definition's probe holds when it defines its name. The reasons are those of modules/lisp/reference/
; differences.md.

(defn cf--same? "Whether a value is the one expected, or of the kind a marker names." [value expected]
  (cond
    (= expected :a-function) (fn? value)
    (= expected :an-ex-info) (= (ex-message value) "a")
    :else (= value expected)))

(defn cf--raises? "Whether calling a function raises an error." [thunk]
  (try (thunk) false (catch condition true)))

(defn cf--definition? "Whether a form is a definition, which runs at the top level only." [form]
  (and (list? form) (some (fn [word] (= word (str (first form)))) ["def" "defn" "defn-" "defonce" "declare"])))

(defmacro probe "A form and the value Clojure gives." [quoted expected]
  (let [form (second quoted)]
    (cond
      (cf--definition? form) `(do ~form (%everyday "probe" '~form true "defined"))
      (= expected :an-error) `(%everyday "probe" '~form (cf--raises? (fn [] ~form)) "")
      :else `(let [value ~form] (%everyday "probe" '~form (cf--same? value ~expected) (pr-str value))))))

(defmacro differs "A form whose value differs from Clojure's on purpose, with ours and why." [quoted ours reason]
  (let [form (second quoted)]
    (if (= ours :an-error)
      `(%everyday "differs" '~form (cf--raises? (fn [] ~form)) "" ~reason)
      `(let [value ~form] (%everyday "differs" '~form (cf--same? value ~ours) (pr-str value) ~reason)))))

(defmacro absent "A form out by design, and why: not run." [quoted reason]
  `(%everyday "absent" '~(second quoted) true "" ~reason))

