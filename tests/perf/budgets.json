      "field": "p99",
      "aggregate": "max",
      "limit": 8.0,
      "unit": "ms",
      "ciThreshold": null,
      "ciReason": "A percentile of wall-clock samples: callgrind counts the step's instructions, not a percentile; the step's own count is locked by compare.py as editor/type-100k.",
