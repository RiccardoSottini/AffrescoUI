{
  "format": "affrescoui-budgets",
  "version": 1,
  "note": "The budgets of BENCHMARKS.md. run.py --budgets measures them; --record writes 'measured'. ciThreshold: what CI fails above, in the unit CI measures (tokens; instructions under callgrind). 'pending' needs a Linux callgrind run to be set; null has its reason in ciReason. A missed token budget's ciThreshold is its recorded value (a ratchet); a met one's is its target.",
  "targets": [
    {
      "id": "idle-cpu",
      "budget": "Idle CPU: 0%",
      "source": "bench",
      "workloads": [
        "budgets/idle"
      ],
      "field": "processMs",
      "aggregate": "max",
      "limit": 0.0,
      "unit": "percent",
      "ciThreshold": null,
      "ciReason": "An idle second is wall clock by nature: callgrind counts instructions, not the time a thread sleeps.",
      "measured": {
        "value": 1.166,
        "from": "budgets/idle",
        "machine": "Apple M4 Pro, macOS 27.0.1",
        "commit": "1d60d3f",
        "date": "2026-10-22"
      }
    },
    {
      "id": "frame",
      "budget": "A full frame: 1 ms at most",
      "source": "bench",
      "workloads": [
        "frame/14"
      ],
      "field": "value",
      "aggregate": "max",
      "limit": 1.0,
      "unit": "ms",
      "ciThreshold": null,
      "ciReason": "The frames are measured as the main thread's CPU time in CI, not under callgrind (software OpenGL makes it too slow).",
      "measured": {
        "value": 0.438,
        "from": "frame/14",
        "machine": "Apple M4 Pro, macOS 27.0.1",
        "commit": "1d60d3f",
        "date": "2026-10-22"
      }
    },
    {
      "id": "state-change",
      "budget": "One state change: 1 ms at most at any size, a 50,000-panel screen included",
      "source": "bench",
      "workloads": [
        "update/400",
        "update/panels-50000"
      ],
      "field": "value",
      "aggregate": "max",
      "limit": 1.0,
      "unit": "ms",
      "ciThreshold": "pending",
      "measured": {
        "value": 3.088,
        "from": "update/400",
        "machine": "Apple M4 Pro, macOS 27.0.1",
        "commit": "1d60d3f",
        "date": "2026-10-22"
      }
    },
    {
