{
	"change-colour": {
		"message": "Teal accent",
		"change": [{ "definition": "look.lisp/part.colours", "from": ":accent {:dark \"#f2b544\" :light \"#b45309\"}", "to": ":accent \"#0d9488\"" }]
	},
	"rename-label": {
		"message": "Call the app Cadence",
		"change": [{ "definition": "sidebar.lisp/sidebar", "from": "(label#logo :text \"Tempo\"", "to": "(label#logo :text \"Cadence\"" }]
	},
	"add-node": {
		"message": "Say who made the playlist",
		"change": [{ "definition": "library.lisp/playlist-header", "append": "(label :text \"Made for you\" :textColor @muted :anchors {:left 256 :bottom 24} :fitText true)" }]
	}
}
