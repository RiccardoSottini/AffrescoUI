{"screen":{"format":"affrescoui-screen","version":2,"state":{"items":[{"id":1,"title":"a","done":false},{"id":2,"title":"b","done":true}]},"program":{"app.lisp":{"title-of":"(defn title-of [x] (str \"#\" (:title x)))"}},"actions":{"done":[{"toggle":"state.items[event.i].done"}],"push":[{"push":"state.items","value":{"id":"{{event.id}}","title":"c","done":false}}]},"root":{"type":"column","children":[{"type":"label","repeat":{"for":"item","in":"state.items","key":"{{item.id}}"},"when":"{{!item.done}}","text":"{{lisp('title-of', item)}} {{count(state.items, it.done)}}"}]}},"steps":[["done",{"i":0}],["push",{"id":3}],["done",{"i":1}],["done",{"i":5}]]}
