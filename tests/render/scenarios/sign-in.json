{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/sign-in",
	"scenarios": [
		{
			"name": "sign-in",
			"screen": "index.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#email" },
				{ "type": "ada@example" },
				{ "click": "#password" },
				{ "expect": { "image": "invalid-email" } },
				{ "type": "short" },
				{ "click": "#signIn" },
				{ "expect": { "image": "errors" } },
				{ "click": "#forgot" },
				{ "wait": 50 },
				{ "expect": { "image": "forgot-dialog" } },
				{ "key": "escape" },
				{ "click": "#toCreate" },
				{ "expect": { "image": "create-account" } },
				{ "click": "#checked-field-form-3" },
				{ "type": "Secret12" },
				{ "click": "#field-eye" },
				{ "expect": { "image": "strength-shown" } },
				{ "key": "mod+j" },
				{ "expect": { "image": "dark" } },
				{ "click": "#checked-field-form" },
				{ "type": "Ada Lovelace" },
				{ "click": "#checked-field-form-2" },
				{ "key": "end" },
				{ "type": ".com" },
				{ "click": "#label-create-account" },
				{ "expect": { "image": "signed-in-dark" } }
			]
		}
	]
}
