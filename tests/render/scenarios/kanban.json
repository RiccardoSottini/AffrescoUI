{
	"format": "affrescoui-scenarios",
	"version": 1,
	"screens": "../../../examples/assets/screens",
	"scenarios": [
		{
			"name": "kanban",
			"screen": "kanban.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": [283, 278] },
				{ "expect": { "image": "button-hover" } },
				{ "click": [283, 278] },
				{ "expect": { "image": "card-moved" } },
				{ "click": "#filter", "nth": 1 },
				{ "expect": { "image": "filter-bug" } },
				{ "click": "#filter", "nth": 0 },
				{ "click": "#newCard" },
				{ "type": "Write render tests" },
				{ "expect": { "image": "typing" } },
				{ "key": "enter" },
				{ "expect": { "image": "card-added" } },
				{ "revision": { "message": "Warm top bar", "set": { "#topBar/color": "#7c2d12" } } },
				{ "expect": { "image": "revision" } },
				{ "click": "#member" },
				{ "expect": { "image": "member-menu" } },
				{ "key": "escape" },
				{ "resize": [960, 720] },
				{ "expect": { "image": "resized" } }
			]
		},
		{
			"name": "kanban-drag",
			"screen": "kanban.screen.json",
			"steps": [
				{ "press": "#card" },
				{ "move": [600, 300] },
				{ "move": [790, 300] },
				{ "expect": { "image": "dragging" } },
				{ "release": [790, 300] },
				{ "expect": { "image": "dropped" } }
			]
		},
		{
			"name": "kanban-retina",
			"screen": "kanban.screen.json",
			"scale": 2,
			"steps": [{ "expect": { "image": "first-frame" } }]
		}
	]
}
