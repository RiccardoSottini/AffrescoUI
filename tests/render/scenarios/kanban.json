{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/flow",
	"scenarios": [
		{
			"name": "kanban",
			"screen": "kanban.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": [358, 300], "note": "over the second Backlog card" },
				{ "expect": { "image": "card-hover" } },
				{ "click": "#cardTitle", "nth": 1 },
				{ "key": "mod+right" },
				{ "expect": { "image": "card-moved" } },
				{ "click": "#filter", "nth": 1 },
				{ "expect": { "image": "filter-bug" } },
				{ "click": "#filter", "nth": 0 },
				{ "click": "#newCard" },
				{ "type": "Write render tests" },
				{ "expect": { "image": "typing" } },
				{ "key": "enter" },
				{ "expect": { "image": "card-added" } },
				{ "revision": { "message": "Warm top bar", "set": { "#topBar/color": "#7c2d12" } } },
				{ "expect": { "image": "revision" } },
				{ "click": "#member" },
				{ "expect": { "image": "member-menu" } },
				{ "key": "escape" },
				{ "resize": [960, 720] },
				{ "expect": { "image": "resized" } }
			]
		},
		{
			"name": "kanban-drag",
			"screen": "kanban.screen.json",
			"steps": [
				{ "press": "#card" },
				{ "move": [400, 300] },
				{ "move": [560, 300] },
				{ "expect": { "image": "dragging" } },
				{ "release": [560, 300] },
				{ "expect": { "image": "dropped" } }
			]
		},
		{
			"name": "kanban-details",
			"screen": "kanban.screen.json",
			"steps": [
				{ "click": "#cardTitle", "nth": 2 },
				{ "key": "space", "note": "peeks at the card in the side panel" },
				{ "expect": { "image": "card-selected" } },
				{ "click": "#detailMore" },
				{ "wait": 50 },
				{ "expect": { "image": "card-menu" } },
				{ "key": "escape" },
				{ "key": "mod+e" },
				{ "wait": 50 },
				{ "expect": { "image": "edit-dialog" } },
				{ "type": " again" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "image": "toast" } }
			]
		},
		{
			"name": "kanban-views",
			"screen": "kanban.screen.json",
			"steps": [
				{ "click": "#viewList" },
				{ "expect": { "image": "list" } },
				{ "click": "#viewTable" },
				{ "expect": { "image": "table" } },
				{ "key": "mod+p" },
				{ "wait": 50 },
				{ "type": "crash" },
				{ "wait": 50 },
				{ "expect": { "image": "go-to-card" } },
				{ "key": "escape" },
				{ "click": [582, 32], "note": "the Website board" },
				{ "click": "#viewBoard" },
				{ "key": "mod+j" },
				{ "expect": { "image": "dark-board" } },
				{ "key": "mod+shift+p" },
				{ "wait": 50 },
				{ "expect": { "image": "command-palette" } }
			]
		},
		{
			"name": "kanban-issue",
			"screen": "kanban.screen.json",
			"steps": [
				{ "click": "#cardTitle", "nth": 2 },
				{ "key": "mod+enter" },
				{ "wait": 50 },
				{ "expect": { "image": "issue-page" } },
				{ "click": "#propPriorityValue" },
				{ "wait": 50 },
				{ "expect": { "image": "issue-priority" } },
				{ "key": "escape" },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "expect": { "image": "issue-closed" } }
			]
		},
		{
			"name": "kanban-shortcuts",
			"screen": "kanban.screen.json",
			"steps": [
				{ "key": "j" },
				{ "key": "j" },
				{ "key": "p" },
				{ "wait": 50 },
				{ "expect": { "image": "priority-picker" } },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "key": "s" },
				{ "wait": 50 },
				{ "type": "rev" },
				{ "wait": 50 },
				{ "expect": { "image": "status-picker" } }
			]
		},
		{
			"name": "kanban-retina",
			"screen": "kanban.screen.json",
			"scale": 2,
			"steps": [{ "expect": { "image": "first-frame" } }]
		}
	]
}
