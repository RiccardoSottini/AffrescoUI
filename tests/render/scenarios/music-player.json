{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/tempo",
	"scenarios": [
		{
			"name": "music-player",
			"screen": "music-player.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": [344, 620] },
				{ "click": [344, 620] },
				{ "revision": { "message": "Open a song's menu", "set": { "/state/menu": { "x": 700, "y": 600, "t": 14, "n": 1, "key": "" }, "/state/open/ctx": true } } },
				{ "expect": { "image": "row-menu" } },
				{ "key": "escape" },
				{ "click": "#homeButton" },
				{ "expect": { "image": "home" } },
				{ "click": "#shortcut", "nth": 2 },
				{ "expect": { "image": "artist" } },
				{ "key": "mod+k" },
				{ "wait": 100 },
				{ "expect": { "image": "search-browse" } },
				{ "type": "shaders" },
				{ "expect": { "image": "search-results" } },
				{ "click": "#queueButton" },
				{ "expect": { "image": "queue" } },
				{ "key": "alt+shift+y" },
				{ "revision": { "message": "Halfway through the song", "set": { "/state/elapsed": 70 } } },
				{ "expect": { "image": "lyrics" } },
				{ "revision": { "message": "Library as a grid", "set": { "/state/lib/view": "grid", "/state/lib/width": 520 } } },
				{ "expect": { "image": "library-grid" } },
				{ "key": "mod+shift+f" },
				{ "wait": 500 },
				{ "expect": { "image": "full-screen" } },
				{ "key": "mod+m" },
				{ "expect": { "image": "mini-player" } },
				{ "key": "escape" },
				{ "key": "mod+t" },
				{ "click": "#forwardButton" },
				{ "expect": { "image": "light" } },
				{ "key": "mod+t" },
				{ "key": "mod+shift+l" },
				{ "key": "mod+shift+l" },
				{ "expect": { "image": "arabic" } }
			]
		},
		{
			"name": "music-player-assistant",
			"screen": "music-player.screen.json",
			"note": "The assistant add-on in Tempo's colours: an agent online, the launcher above the player bar, then the panel open",
			"steps": [
				{ "revision": { "message": "An agent online", "set": { "/state/assistant/simulate": { "online": true, "pending": [], "working": false, "proposals": [] } } } },
				{ "expect": { "image": "launcher" } },
				{ "click": "#assistantLauncher" },
				{ "wait": 250 },
				{ "expect": { "image": "open" } },
				{ "key": "escape" },
				{ "expect": { "state": "assistant.open", "is": false } }
			]
		}
	]
}
