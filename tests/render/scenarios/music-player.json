{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/tempo/json",
	"scenarios": [
		{
			"name": "music-player",
			"screen": "index.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#track", "nth": 4 },
				{ "expect": { "image": "track-chosen" } },
				{ "click": "#playlist", "nth": 2 },
				{ "expect": { "image": "playlist-chosen" } },
				{ "press": "#volume" },
				{ "move": [1172, 728] },
				{ "release": [1172, 728] },
				{ "expect": { "image": "volume-dragged" } },
				{ "scroll": "#tracks", "dy": -4 },
				{ "expect": { "image": "tracks-scrolled" } },
				{ "click": "#label-menu", "nth": 0 },
				{ "click": [400, 237] },
				{ "key": "enter" },
				{ "expect": { "image": "library" } },
				{ "scroll": "#libraryTable", "dy": -20 },
				{ "expect": { "image": "library-scrolled" } },
				{ "key": "mod+p" },
				{ "wait": 100 },
				{ "type": "silver" },
				{ "expect": { "image": "quick-pick" } },
				{ "key": "escape" },
				{ "key": "mod+shift+p" },
				{ "expect": { "image": "command-palette" } },
				{ "key": "escape" },
				{ "key": "mod+u" },
				{ "expect": { "image": "queue-hidden" } },
				{ "click": "#likeButton" },
				{ "key": "mod+4" },
				{ "expect": { "image": "liked" } },
				{ "click": [400, 191] },
				{ "key": "shift+f10" },
				{ "expect": { "image": "song-menu" } }
			]
		}
	]
}
