{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/launcher/json",
	"scenarios": [
		{
			"name": "launcher",
			"screen": "index.screen.json",
			"note": "The Launcher with nothing granted: the apps grid, a search, My apps empty then with two apps, the delete confirmation, the export dialog, the review of a file and of one refused, the create form and its error, the settings in dark and in French, and a small window",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#appSearch" },
				{ "type": "tem" },
				{ "expect": { "image": "search" } },
				{ "key": "escape" },
				{ "key": "mod+2" },
				{ "expect": { "image": "mine-empty" } },
				{ "action": "launcher.show", "event": { "mine": [
					{ "id": "reading-list", "name": "Reading list", "modified": 1760000000000 },
					{ "id": "my-budget", "name": "My budget", "modified": 1759000000000 }
				] } },
				{ "expect": { "image": "mine-list" } },
				{ "click": "#mineDelete" },
				{ "wait": 50 },
				{ "expect": { "image": "confirm" } },
				{ "key": "escape" },
				{ "action": "launcher.export", "event": { "id": "reading-list", "name": "Reading list",
					"summary": { "kind": "app", "name": "Reading list",
						"definitions": { "added": ["app.lisp/shelf", "app.lisp/rate"], "changed": [], "removed": [] },
						"impact": { "view": 3, "logic": 2 } },
					"leftOut": { "records": 12, "commits": 4 } } },
				{ "wait": 50 },
				{ "expect": { "image": "export-dialog" } },
				{ "key": "escape" },
				{ "action": "launcher.review", "event": {
					"package": { "format": "affrescoui-package", "description": "Notes for walks, with a map of where each was taken." },
					"summary": { "kind": "app", "name": "Field notes", "release": "2.0.0", "author": "Robin", "signature": "unknown:0123456789abcdef",
						"base": { "app": "field-notes", "name": "Field notes", "release": "2.0.0", "exact": null },
						"definitions": { "added": ["app.lisp/place", "app.lisp/note"], "changed": [], "removed": [] },
						"impact": { "view": 4, "logic": 2, "data": "none" },
						"extensions": { "added": [{ "kind": "hook", "name": "stamp", "target": "notes.insert" }], "removed": [] },
						"writes": [{ "step": "insert", "collection": "notes", "in": "app.lisp/note" }], "uses": [],
						"capabilities": [{ "capability": "files", "why": "Saves your notes where you choose.", "added": true }],
						"permissions": ["app.lisp: agent asks"],
						"seed": [{ "collection": "notes", "file": "seed/notes.json", "records": 3 }],
						"state": { "title": "Field notes" }, "assets": [{ "name": "cover.png", "type": "image/png", "size": 1200 }],
						"problems": [], "conflicts": [] } } },
				{ "wait": 50 },
				{ "expect": { "image": "install-review" } },
				{ "action": "launcher.review", "event": { "error": "The file isn't a version of an app: it has no format." } },
				{ "wait": 50 },
				{ "expect": { "image": "install-refused" } },
				{ "key": "mod+n" },
				{ "wait": 0 },
				{ "click": "#createName" },
				{ "key": "enter" },
				{ "expect": { "image": "create-error" } },
				{ "click": "#createName" },
				{ "type": "Garden planner" },
				{ "click": { "role": "radio", "name": "Haven" } },
				{ "scroll": [250, 650], "dy": -12 },
				{ "click": { "role": "checkbox", "name": "Charts, from Haven" } },
				{ "expect": { "image": "create-filled" } },
				{ "key": "mod+comma" },
				{ "click": { "role": "radio", "name": "Dark" } },
				{ "expect": { "image": "settings-dark" } },
				{ "click": { "role": "radio", "name": "Light" } },
				{ "wait": 200 },
				{ "expect": { "image": "settings-light" } },
				{ "click": { "role": "radio", "name": "Français" } },
				{ "key": "mod+1" },
				{ "expect": { "image": "french" } },
				{ "resize": [800, 600] },
				{ "expect": { "image": "small" } }
			]
		},
		{
			"name": "launcher-catalogue",
			"screen": "index.screen.json",
			"note": "The Catalogue page once the service answers with a catalogue, and the review of one of its versions, with where it was listed",
			"steps": [
				{ "action": "launcher.catalogue", "event": { "name": "affrescoui", "updated": "2026-11-17", "signed": true, "entries": [{ "id": "flow-by-priority", "kind": "package", "title": "Flow, by priority", "description": "Flow with every list ordered by priority.", "release": "1.0.0", "base": "flow", "installed": false}, { "id": "slideSorter", "kind": "feature", "title": "Slide sorter", "description": "Thumbnails of an ordered list of pages.", "release": "1.0.0", "base": "", "installed": false}]} },
				{ "wait": 0},
				{ "click": { "role": "tab", "name": "Catalogue" } },
				{ "expect": { "image": "catalogue" } },
				{ "action": "launcher.reviewListed", "event": { "id": "flow-by-priority", "release": "1.0.0", "description": "Flow with every list ordered by priority.", "listed": { "catalogue": "affrescoui", "updated": "2026-11-17", "signed": true}, "summary": { "kind": "changes", "name": "Flow, by priority", "release": "1.0.0", "author": "", "signature": "none", "base": { "app": "flow", "name": "Flow", "release": "", "exact": true}, "definitions": { "added": [], "changed": [], "removed": []}, "impact": { "view": 0, "logic": 1, "data": "none" }, "extensions": { "added": [], "removed": []}, "writes": [], "uses": [], "state": {}, "assets": [], "problems": [], "conflicts": []} } },
				{ "wait": 0},
				{ "expect": { "image": "catalogue-review" } }
			]
		}
	]
}
