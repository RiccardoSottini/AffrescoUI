{
	"format": "affrescoui-scenarios",
	"version": 1,
	"screens": "../../../examples/assets/screens",
	"scenarios": [
		{
			"name": "smart-home",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#light", "nth": 2 },
				{ "expect": { "image": "light-on" } },
				{ "click": "#roomRow", "nth": 1 },
				{ "expect": { "image": "kitchen" } },
				{ "click": "#scene", "nth": 1 },
				{ "wait": 1500 },
				{ "expect": { "image": "scene-settled" } },
				{ "click": [190, 432] },
				{ "wait": 600 },
				{ "expect": { "image": "light-theme" } }
			]
		}
	]
}
