{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/haven",
	"scenarios": [
		{
			"name": "smart-home",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#toggle-rooms-room-lights", "nth": 2 },
				{ "expect": { "image": "light-on" } },
				{ "click": [130, 397], "note": "Kitchen, in the rooms tree" },
				{ "expect": { "image": "kitchen" } },
				{ "click": "#scene", "nth": 1 },
				{ "wait": 1500 },
				{ "expect": { "image": "scene-settled" } },
				{ "click": "#toggle-theme-switch" },
				{ "wait": 600 },
				{ "expect": { "image": "dark-theme" } }
			]
		},
		{
			"name": "smart-home-devices",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "click": "#deviceAction", "nth": 1 },
				{ "wait": 450 },
				{ "expect": { "image": "device-working" } },
				{ "wait": 600 },
				{ "expect": { "image": "device-answered" } },
				{ "click": [26, 337], "note": "close the Ground floor in the rooms tree" },
				{ "expect": { "image": "floor-closed" } }
			]
		},
		{
			"name": "smart-home-info",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "click": "#light", "nth": 1 },
				{ "expect": { "image": "light-info" } },
				{ "click": "#barBand", "nth": 3 },
				{ "expect": { "image": "light-info-level" } },
				{ "key": "escape" },
				{ "click": "#label-climate" },
				{ "expect": { "image": "climate-info" } },
				{ "key": "escape" },
				{ "click": "#blindsIcon" },
				{ "wait": 400 },
				{ "expect": { "image": "cover-info" } },
				{ "key": "escape" },
				{ "click": "#deviceName", "nth": 2 },
				{ "expect": { "image": "device-info" } }
			]
		},
		{
			"name": "smart-home-pages",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "key": "mod+2" },
				{ "expect": { "image": "energy" } },
				{ "key": "mod+comma" },
				{ "expect": { "image": "settings" } },
				{ "key": "mod+t" },
				{ "wait": 600 },
				{ "expect": { "image": "settings-dark" } }
			]
		}
	]
}
