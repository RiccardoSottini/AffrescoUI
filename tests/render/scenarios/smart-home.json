{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/haven",
	"scenarios": [
		{
			"name": "smart-home",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": "#toggle-rooms-room-lights", "nth": 2 },
				{ "expect": { "image": "light-on" } },
				{ "click": "#viewTab", "nth": 1, "note": "Kitchen, in the view tabs" },
				{ "expect": { "image": "kitchen" } },
				{ "click": "#scene", "nth": 1 },
				{ "wait": 1500 },
				{ "expect": { "image": "scene-settled" } },
				{ "key": "mod+t" },
				{ "wait": 600 },
				{ "expect": { "image": "dark-theme" } }
			]
		},
		{
			"name": "smart-home-devices",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "click": "#deviceAction", "nth": 1 },
				{ "wait": 450 },
				{ "expect": { "image": "device-working" } },
				{ "wait": 600 },
				{ "expect": { "image": "device-answered" } },
				{ "click": "#menuButton", "note": "fold the sidebar to its icons" },
				{ "expect": { "image": "sidebar-folded" } }
			]
		},
		{
			"name": "smart-home-info",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "click": "#light", "nth": 1 },
				{ "expect": { "image": "light-info" } },
				{ "click": "#barBand", "nth": 3 },
				{ "expect": { "image": "light-info-level" } },
				{ "key": "escape" },
				{ "click": "#label-climate" },
				{ "expect": { "image": "climate-info" } },
				{ "key": "escape" },
				{ "click": "#blindsIcon" },
				{ "wait": 400 },
				{ "expect": { "image": "cover-info" } },
				{ "key": "escape" },
				{ "click": "#deviceName", "nth": 2 },
				{ "expect": { "image": "device-info" } },
				{ "click": "#infoMore" },
				{ "expect": { "image": "device-info-menu" } }
			]
		},
		{
			"name": "smart-home-pages",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "key": "mod+2" },
				{ "expect": { "image": "energy" } },
				{ "click": "#energyByRoom" },
				{ "expect": { "image": "energy-room" } },
				{ "key": "mod+l" },
				{ "key": "mod+l" },
				{ "expect": { "image": "energy-arabic" } },
				{ "key": "mod+l" },
				{ "key": "mod+4" },
				{ "expect": { "image": "automations" } },
				{ "click": "#autoRowMore", "nth": 1 },
				{ "expect": { "image": "automation-row-menu" } },
				{ "key": "escape" },
				{ "key": "mod+comma" },
				{ "expect": { "image": "settings" } },
				{ "click": "#settingsRow", "nth": 0 },
				{ "expect": { "image": "settings-devices" } },
				{ "click": "#settingsBack" },
				{ "click": "#settingsRow", "nth": 4 },
				{ "expect": { "image": "settings-profile" } },
				{ "click": "#settingsBack" },
				{ "click": "#settingsRow", "nth": 5 },
				{ "expect": { "image": "settings-general" } },
				{ "click": "#settingsBack" },
				{ "click": "#settingsRow", "nth": 6 },
				{ "expect": { "image": "settings-about" } },
				{ "click": "#settingsBack" },
				{ "key": "mod+t" },
				{ "wait": 600 },
				{ "expect": { "image": "settings-dark" } },
				{ "key": "mod+l" },
				{ "key": "mod+l" },
				{ "click": "#settingsRow", "nth": 4 },
				{ "expect": { "image": "settings-profile-arabic-dark" } },
				{ "key": "mod+l" },
				{ "key": "mod+4" },
				{ "click": "#autoRowOpen", "nth": 1 },
				{ "expect": { "image": "automation-editor-dark" } },
				{ "click": "#autoMore" },
				{ "expect": { "image": "automation-menu-dark" } },
				{ "click": { "role": "menuitem", "name": "Delete" } },
				{ "expect": { "image": "automation-delete-dark" } },
				{ "key": "escape" },
				{ "key": "mod+t" },
				{ "wait": 600 },
				{ "click": "#autoMore" },
				{ "click": { "role": "menuitem", "name": "Delete" } },
				{ "expect": { "image": "automation-delete-light" } }
			]
		},
		{
			"name": "smart-home-shell",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "click": "#searchButton" },
				{ "wait": 100 },
				{ "type": "ceil" },
				{ "expect": { "image": "entity-search" } },
				{ "key": "down" },
				{ "key": "enter" },
				{ "expect": { "image": "entity-light-info" } },
				{ "key": "escape" },
				{ "click": "#alarmMode", "nth": 2 },
				{ "click": "#alarmName" },
				{ "click": "#alarmKey", "nth": 0 },
				{ "click": "#alarmKey", "nth": 1 },
				{ "expect": { "image": "alarm-keypad" } },
				{ "key": "escape" },
				{ "click": "#assistButton" },
				{ "wait": 400 },
				{ "expect": { "image": "assist" } },
				{ "key": "escape" },
				{ "click": "#dashMore" },
				{ "expect": { "image": "dashboard-menu" } },
				{ "click": { "role": "menuitem", "name": "Edit dashboard" } },
				{ "expect": { "image": "edit-mode" } },
				{ "click": "#editClimate" },
				{ "wait": 100 },
				{ "expect": { "image": "card-editor" } },
				{ "click": "#cardCodeSwitch" },
				{ "expect": { "image": "card-code" } },
				{ "click": "#cardCancel" },
				{ "click": "#editDone" },
				{ "key": "mod+l" },
				{ "key": "mod+l" },
				{ "expect": { "image": "home-arabic" } }
			]
		},
		{
			"name": "smart-home-history",
			"screen": "smart-home.screen.json",
			"steps": [
				{ "key": "mod+5" },
				{ "expect": { "image": "logbook" } },
				{ "click": "#logSearch" },
				{ "type": "door" },
				{ "expect": { "image": "logbook-search" } },
				{ "key": "mod+6" },
				{ "expect": { "image": "history" } },
				{ "click": { "role": "tab", "name": "Areas" } },
				{ "expect": { "image": "areas" } },
				{ "key": "mod+l" },
				{ "key": "mod+l" },
				{ "key": "mod+t" },
				{ "wait": 600 },
				{ "expect": { "image": "areas-arabic-dark" } }
			]
		}
	]
}
