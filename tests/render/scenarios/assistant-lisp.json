{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../screens",
	"scenarios": [
		{
			"name": "assistant-lisp-preview",
			"screen": "assistant-lisp.screen.lisp",
			"note": "The add-on's Lisp version: a definition typed in the field is shown as an evaluation before it runs, and the send button says Evaluate",
			"steps": [
				{ "action": "test.online" },
				{ "action": "assistant.open" },
				{ "wait": 250 },
				{ "type": "(defn greet [] \"hi\")" },
				{ "wait": 50 },
				{ "expect": { "image": "preview" } }
			]
		},
		{
			"name": "assistant-lisp-evaluated",
			"screen": "assistant-lisp.screen.lisp",
			"note": "Enter evaluates the typed form as the person's: the conversation shows it as code, then its value; the field is empty again",
			"steps": [
				{ "action": "test.online" },
				{ "action": "assistant.open" },
				{ "wait": 250 },
				{ "type": "(+ 1 2)" },
				{ "key": "enter" },
				{ "wait": 100 },
				{ "expect": { "state": "assistant.draft", "is": "" } },
				{ "expect": { "image": "conversation" } }
			]
		},
		{
			"name": "assistant-lisp-history",
			"screen": "assistant-lisp.screen.lisp",
			"note": "The Lisp add-on's past conversations: New conversation keeps the one shown, titled by what the person wrote, the list shows it, and a click goes on with it",
			"steps": [
				{ "action": "test.online" },
				{ "action": "assistant.open" },
				{ "wait": 250 },
				{ "type": "(+ 1 2)" },
				{ "key": "enter" },
				{ "wait": 100 },
				{ "click": "#assistantNew" },
				{ "wait": 100 },
				{ "expect": { "state": "assistant.messages", "is": [] } },
				{ "expect": { "state": "assistant.conversations[0].title", "is": "(+ 1 2)" } },
				{ "expect": { "state": "assistant.conversations[0].count", "is": 2 } },
				{ "click": "#assistantHistoryButton" },
				{ "wait": 100 },
				{ "expect": { "state": "assistant.history", "is": true } },
				{ "click": "#assistantPastOpen0" },
				{ "wait": 100 },
				{ "expect": { "state": "assistant.history", "is": false } },
				{ "expect": { "state": "assistant.conversations", "is": [] } },
				{ "expect": { "state": "assistant.messages[0].text", "is": "(+ 1 2)" } },
				{ "expect": { "image": "resumed" } }
			]
		},
		{
			"name": "assistant-lisp-runs",
			"screen": "assistant-lisp.screen.lisp",
			"note": "The Lisp add-on's run cards: ran, denied, waiting for the person's yes, and one only the window may allow",
			"steps": [
				{ "action": "test.runs" },
				{ "action": "assistant.open" },
				{ "wait": 250 },
				{ "expect": { "image": "cards" } }
			]
		}
	]
}
