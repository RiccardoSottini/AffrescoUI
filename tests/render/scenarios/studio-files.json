{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/studio",
	"scenarios": [
		{
			"name": "studio-files",
			"screen": "studio.screen.json",
			"note": "A proposal's Files changed page: each changed section against main, unified, with line numbers and hunks; then split, without whitespace changes, the first file viewed; before that, a change request from the review box",
			"steps": [
				{"action": "host:hello", "event": {"revision": 5, "head": {"short": "b2c3d4e"}, "you": "ada", "canReview": true, "mode": "default"}},
				{"action": "host:document", "event": {"revision": 5, "head": {"short": "b2c3d4e"}, "document": {"theme": "light", "root": {"type": "stack", "gap": 8, "children": [{"id": "title", "type": "label", "text": "Tasks", "height": 32}, {"id": "count", "type": "label", "text": "0", "font": "small", "width": 40, "height": 24}]}}, "state": {}, "proposals": [{"id": 4, "branch": "proposal/4", "author": "claude", "message": "Count the clicks", "base": "b2c3d4e", "head": "f6a7b8c", "short": "f6a7b8c", "commits": 2, "operations": 3, "touches": ["/root/children/1", "/theme"], "remember": [], "changes": ["set #count/text \"Clicks: 0\"", "set #count/onClick [...]", "set /theme \"dark\""], "reason": "", "time": 1760000000, "conflicts": [], "approvals": ["grace"], "policy": "1 approval", "behaviour": []}], "previewing": null, "mode": "default", "grants": [], "you": "ada", "canReview": true}},
				{"expect": {"node": "#label-prOpened", "text": "claude opened this proposal on Oct 9, 2025"}},
				{"expect": {"node": "#prEvent", "text": "grace approved these changes", "nth": 1}},
				{"expect": {"image": "conversation"}},
				{"expect": {"node": "#mergeTitle", "text": "Ready to merge"}},
				{"expect": {"node": "#mergeDetail", "text": "1 approval · needs 1 approval"}},
				{"expect": {"node": "#prReviewer", "text": "grace · approved"}},
				{"click": "#reviewChanges"},
				{"click": "#reviewDraft"},
				{"type": "Name the counter"},
				{"click": "#reviewSubmit"},
				{"expect": {"state": "reviews.length", "is": 1}},
				{"expect": {"state": "reviewDraft", "is": ""}},
				{"expect": {"node": "#prEvent", "text": "ada requested changes: Name the counter", "nth": 2}},
				{"expect": {"node": "#mergeTitle", "text": "Changes requested"}},
				{"scroll": "#reviewTitle", "dy": -10},
				{"expect": {"image": "review"}},
				{"action": "prTab", "event": {"value": "files"}},
				{"expect": {"node": "#label-prLoad", "text": "Loading the changes…"}},
				{"action": "host:diff", "event": {"type": "diff", "id": "pr", "revision": 5, "patch": [{"op": "replace", "path": "/root/children/1/text", "value": "Clicks: 0"}, {"op": "add", "path": "/root/children/1/onClick", "value": {"set": "state.clicks", "to": "{{state.clicks + 1}}"}}, {"op": "replace", "path": "/theme", "value": "dark"}]}},
				{"expect": {"node": "#label-prLoad", "exists": false}},
				{"expect": {"node": "#label-diffPath", "text": "/root/children/1"}},
				{"expect": {"node": "#label-diffAdded", "text": "+6"}},
				{"expect": {"node": "#label-diffRemoved", "text": "−2"}},
				{"expect": {"image": "files"}},
				{"click": "#label-diffSplit"},
				{"expect": {"state": "diffSplit", "is": true}},
				{"click": "#label-diffWs"},
				{"expect": {"state": "diffWs", "is": true}},
				{"click": "#label-diffViewed"},
				{"expect": {"state": "viewed.length", "is": 1}},
				{"expect": {"image": "files-split"}}
			]
		}
	]
}
