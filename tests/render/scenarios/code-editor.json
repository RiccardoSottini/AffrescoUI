{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/code-editor/json",
	"scenarios": [
		{
			"name": "code-editor",
			"screen": "index.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": [140, 783] },
				{ "wait": 1200 },
				{ "expect": { "image": "tooltip" } },
				{ "click": [22, 14] },
				{ "wait": 50 },
				{ "expect": { "image": "menu-open" } },
				{ "key": "escape" },
				{ "click": [130, 270] },
				{ "expect": { "image": "file-opened" } },
				{ "click": [484, 45] },
				{ "click": "#editor" },
				{ "key": "cmd+down" },
				{ "expect": { "image": "large-file" } },
				{ "key": "cmd+p" },
				{ "wait": 50 },
				{ "type": "st" },
				{ "wait": 50 },
				{ "expect": { "image": "quick-open" } },
				{ "key": "escape" },
				{ "key": "cmd+shift+p" },
				{ "wait": 50 },
				{ "expect": { "image": "command-palette" } },
				{ "key": "escape" },
				{ "click": [270, 45] },
				{ "click": "#editor" },
				{ "type": "x" },
				{ "key": "cmd+w" },
				{ "wait": 50 },
				{ "expect": { "image": "close-dialog" } },
				{ "click": [735, 434] },
				{ "key": "ctrl+backquote" },
				{ "wait": 0 },
				{ "click": "#command" },
				{ "type": "help" },
				{ "key": "enter" },
				{ "expect": { "image": "terminal-help" } },
				{ "key": "cmd+shift+a" },
				{ "wait": 400 },
				{ "expect": { "image": "assistant" } }
			]
		},
		{
			"name": "code-editor-look",
			"screen": "index.screen.json",
			"note": "Quaderno's own look: the theme picker previewing Light, light with the editor's menu, Distraction Free, right to left",
			"steps": [
				{ "key": "cmd+k" },
				{ "key": "cmd+t" },
				{ "wait": 50 },
				{ "key": "down" },
				{ "wait": 50 },
				{ "expect": { "image": "theme-picker" } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "click": [900, 166] },
				{ "key": "shift+f10" },
				{ "wait": 50 },
				{ "expect": { "image": "light-editor-menu" } },
				{ "key": "escape" },
				{ "key": "ctrl+cmd+shift+f" },
				{ "wait": 50 },
				{ "expect": { "image": "distraction-free" } },
				{ "key": "ctrl+cmd+shift+f" },
				{ "click": "#themeSwitch" },
				{ "revision": { "message": "Right to left", "set": { "/state/dir": "rtl" } } },
				{ "action": "showProblems" },
				{ "wait": 50 },
				{ "expect": { "image": "rtl" } }
			]
		},
		{
			"name": "code-editing",
			"screen": "index.screen.json",
			"steps": [
				{ "click": [900, 166] },
				{ "key": "enter" },
				{ "type": "int x = (1" },
				{ "type": ");" },
				{ "expect": { "image": "typed" } },
				{ "key": "shift+up" },
				{ "key": "shift+up" },
				{ "key": "cmd+slash" },
				{ "expect": { "image": "commented" } },
				{ "key": "alt+down" },
				{ "expect": { "image": "moved" } },
				{ "key": "cmd+z" },
				{ "key": "cmd+z" },
				{ "key": "cmd+s" },
				{ "expect": { "image": "undone-saved" } },
				{ "key": "cmd+shift+f" },
				{ "wait": 50 },
				{ "type": "sensor" },
				{ "key": "enter" },
				{ "wait": 100 },
				{ "expect": { "image": "find-in-files" } },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "key": "cmd+p" },
				{ "wait": 50 },
				{ "type": "stcpp@" },
				{ "wait": 50 },
				{ "expect": { "image": "goto-symbol" } }
			]
		}
	]
}
