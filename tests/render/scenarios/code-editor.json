		{
			"name": "code-editing",
			"screen": "code-editor.screen.json",
			"steps": [
				{ "click": [900, 166] },
				{ "key": "enter" },
				{ "type": "int x = (1" },
				{ "type": ");" },
				{ "expect": { "image": "typed" } },
				{ "key": "shift+up" },
				{ "key": "shift+up" },
				{ "key": "cmd+slash" },
				{ "expect": { "image": "commented" } },
