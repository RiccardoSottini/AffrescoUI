{
	"format": "affrescoui-scenarios",
	"version": 1,
	"screens": "../../../examples/assets/screens",
	"scenarios": [
		{
			"name": "code-editor",
			"screen": "code-editor.screen.json",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": [24, 28] },
				{ "wait": 1200 },
				{ "expect": { "image": "tooltip" } },
				{ "click": "#entry", "nth": 3 },
				{ "expect": { "image": "file-opened" } },
				{ "key": "cmd+p" },
				{ "type": "read" },
				{ "expect": { "image": "palette" } },
				{ "key": "escape" },
				{ "click": "#command" },
				{ "type": "help" },
				{ "key": "enter" },
				{ "expect": { "image": "terminal-help" } }
			]
		},
		{
			"name": "code-editing",
			"screen": "code-editor.screen.json",
			"steps": [
				{ "click": [900, 166] },
				{ "key": "enter" },
				{ "type": "int x = (1" },
				{ "type": ");" },
				{ "expect": { "image": "typed" } },
				{ "key": "shift+up" },
				{ "key": "shift+up" },
				{ "key": "cmd+slash" },
				{ "expect": { "image": "commented" } },
				{ "key": "alt+down" },
				{ "expect": { "image": "moved" } },
				{ "key": "cmd+z" },
				{ "key": "cmd+z" },
				{ "key": "cmd+s" },
				{ "expect": { "image": "undone-saved" } }
			]
		}
	]
}
