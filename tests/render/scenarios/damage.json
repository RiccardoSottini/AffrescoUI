{
	"format": "affrescoui-scenarios",
	"version": 1,
	"screens": "../screens",
	"scenarios": [
		{
			"name": "damage",
			"screen": "damage.screen.json",
			"note": "Frames drawn only where they changed, each also drawn from scratch by the runner: a panel and its shadow moving over and under others, then back; a panel hidden with its children and shown again; a column pushed by its growing first child; a scrolled list of rounded cards with shadows; a text colour",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "move": "#label-mover" },
				{ "expect": { "image": "moved" } },
				{ "move": [600, 400] },
				{ "expect": { "image": "moved-back" } },
				{ "press": "#panel-hider" },
				{ "expect": { "image": "hidden" } },
				{ "release": [525, 75] },
				{ "expect": { "image": "shown" } },
				{ "move": "#label-first" },
				{ "expect": { "image": "grown" } },
				{ "scroll": "#column-list", "dy": -3 },
				{ "expect": { "image": "scrolled" } },
				{ "move": "#label-colour" },
				{ "expect": { "image": "text-colour" } },
				{ "move": [600, 400] },
				{ "expect": { "image": "rest" } }
			]
		}
	]
}
