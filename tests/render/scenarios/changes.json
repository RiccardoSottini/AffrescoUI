							"text": "(defview card \"A card on the board: its title, who owns it, and how late it is.\" [card]\n  `(column :id ~(str \"card-\" card.id)\n     :width 240\n     :padding 8\n     :spacing 4\n     :color @c.card\n     :radius 6\n     (label :id ~(str \"card-title-\" card.id)\n       :text ~card.title\n       :font heading\n       :wrap true)\n     (row :spacing 6\n       (label :text ~card.owner :textColor @c.muted)\n       (label :when ~(> card.late 0)\n         :text ~(t \"board.late\" {:days card.late})\n         :textColor @c.warning))\n     (button :id ~(str \"card-open-\" card.id)\n       :text ~(t \"board.open\")\n       :onClick ~(handler openCard card.id))))",
