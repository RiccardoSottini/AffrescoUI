{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../screens",
	"scenarios": [
		{
			"name": "kit-bars",
			"screen": "kit-bars.screen.json",
			"note": "The desktop kit's toolbar and status bar: the first frame in light, a narrow toolbar's \"more\" menu with the items that didn't fit, keyboard focus on a toolbar button, then dark and right-to-left",
			"steps": [
				{ "expect": { "image": "first-frame" } },
				{ "click": [181, 66] },
				{ "expect": { "image": "more-open" } },
				{ "key": "escape" },
				{ "key": "tab" },
				{ "expect": { "image": "focused" } },
				{ "revision": { "message": "Dark theme", "set": { "/state/theme": "dark" } } },
				{ "expect": { "image": "dark" } },
				{ "revision": { "message": "Right to left", "set": { "/state/dir": "rtl" } } },
				{ "expect": { "image": "rtl" } }
			]
		}
	]
}
