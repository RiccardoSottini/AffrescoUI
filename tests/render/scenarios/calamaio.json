{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screens": "../../../examples/calamaio",
	"scenarios": [
		{
			"name": "calamaio",
			"screen": "calamaio.screen.json",
			"steps": [
				{ "expect": { "image": "splash" } },
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "expect": { "image": "switch-buffer" } },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "ctrl+x" },
				{ "key": "2" },
				{ "wait": 50 },
				{ "key": "ctrl+x" },
				{ "key": "o" },
				{ "wait": 50 },
				{ "type": "(+ 1 2)" },
				{ "key": "ctrl+x" },
				{ "key": "3" },
				{ "wait": 50 },
				{ "expect": { "image": "three-windows" } },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "type": "load-th" },
				{ "expect": { "image": "extended-command" } },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "key": "f10" },
				{ "wait": 50 },
				{ "expect": { "image": "file-menu" } }
			]
		}
	]
}
