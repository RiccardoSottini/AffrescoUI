						{ "id": "ring", "x": 100, "y": 20, "width": 60, "height": 60, "radius": 30, "color": "transparent", "borderWidth": 1.5, "borderColor": "#0ea5e9" },
						{ "id": "lifted", "x": 20, "y": 110, "width": 140, "height": 60, "radius": { "topLeft": 4, "topRight": 12, "bottomRight": 20, "bottomLeft": 28 }, "color": "#ffffff", "shadow": { "y": 8, "blur": 16, "color": "#0f172a80" } }
					]
				} } } },
