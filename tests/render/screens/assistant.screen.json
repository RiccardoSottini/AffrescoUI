{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The assistant add-on, for the rendering check: a small page that includes it, and test actions that stand in for what the check's runner has none of (agents, requests and proposals) through the add-on's state.assistant.simulate, so the launcher, the empty, offline and conversation states, a proposal card, the dark theme and right to left can be drawn. The examples ship English, Spanish and French; this page adds the add-on's keys in Arabic to check its right-to-left layout, with a font subset that has their letters (tests/render/fonts/subset.py).",
	"include": ["../../../examples/shared/addons/assistant/assistant.json"],

	"window": { "title": "Assistant", "width": 800, "height": 700 },

	"fonts": {
		"default": {
			"file": "../../../examples/shared/fonts/Roboto-Regular.ttf",
			"size": 14,
			"fallback": ["arabic", "icons"]
		},
		"arabic": { "file": "../fonts/NotoSansArabic-Assistant.ttf", "size": 14 },
		"icons": { "file": "../../../examples/shared/fonts/Lucide.ttf", "size": 14 }
	},

	"tokens": {
		"page": { "light": "#eef1f4", "dark": "#0d1117" },
		"pageText": { "light": "#1f2328", "dark": "#e6edf3" }
	},

	"permissions": { "allow": ["studio"], "reviewers": ["studio"] },

	"state": { "theme": "light", "locale": "en" },
	"theme": "{{state.theme}}",

	"strings": {
		"locale": "{{state.locale}}",
		"ar": {
			"assistant.title": "المساعد",
			"assistant.open": "افتح المساعد",
			"assistant.close": "أغلق المساعد",
			"assistant.shortcut": "المساعد (Ctrl+Shift+A)",
			"assistant.online": "{n, plural, one {متصل} other {# وكلاء متصلون}}",
			"assistant.offline": "غير متصل",
			"assistant.offlineNote": "لا يوجد وكيل متصل. صِل وكيلًا (خادم MCP) لتسأله.",
			"assistant.empty": "اطلب تغييرًا بكلمات بسيطة. يقترحه الوكيل وتراجعه هنا.",
			"assistant.chip1": "ماذا يمكنك أن تغير هنا؟",
			"assistant.chip2": "كبّر النص",
			"assistant.chip3": "أضف سمة داكنة",
			"assistant.message": "رسالة إلى المساعد",
			"assistant.placeholder": "اطلب تغييرًا…",
			"assistant.send": "أرسل",
			"assistant.typing": "المساعد يعمل",
			"assistant.messages": "المحادثة",
			"assistant.you": "أنت",
			"assistant.touches": "{n, plural, one {يغير عنصرًا واحدًا} other {يغير # عناصر}}",
			"assistant.preview": "معاينة",
			"assistant.accept": "اقبل",
			"assistant.reject": "ارفض",
			"assistant.accepted": "مقبول",
			"assistant.rejected": "مرفوض",
			"assistant.closed": "مغلق",
			"assistant.clear": "امسح المحادثة"
		}
	},

	"actions": {
		"test.show": [{ "set": "state.assistant.show", "to": true }],
		"test.hide": [{ "set": "state.assistant.show", "to": false }],
		"test.online": [{ "set": "state.assistant.simulate", "to": { "online": true } }],
		"test.offline": [{ "set": "state.assistant.simulate", "to": { "online": false } }],
		"test.conversation": [
			{ "set": "state.assistant.simulate", "to": { "online": true, "pending": ["p2"], "working": true } },
			{ "set": "state.assistant.decided", "to": { "p1": "accepted" } },
			{ "set": "state.assistant.messages", "to": [
				{ "mine": true, "from": "You", "text": "Add a Review column between Doing and Done.", "time": 1773500966000,
				  "error": false },
				{ "mine": false, "from": "claude", "text": "Done: it waits for your review.", "time": 1773500970000,
				  "error": false },
				{ "kind": "card", "id": "p1", "title": "Add a Review column", "summary": "Changes 2 elements",
				  "lines": ["add at /root/children/0/children/2: {\"id\": \"review\", …}", "set /state/columns/2 to \"Review\""],
				  "time": 1773500970000 },
				{ "mine": true, "from": "You", "text": "Make the card titles larger too.", "time": 1773500990000,
				  "error": false },
				{ "mine": false, "from": "claude", "text": "Here it is.", "time": 1773500995000, "error": false },
				{ "kind": "card", "id": "p2", "title": "Larger card titles", "summary": "Changes 1 element",
				  "lines": ["set /styles/cardTitle/size to 17"], "time": 1773500995000 }
			] }
		],
		"test.proposal": [{ "set": "state.assistant.simulate", "to": { "online": true, "pending": ["p3"],
		                   "proposals": [{ "id": "p3", "message": "Group the cards by owner", "touches": ["a", "b", "c"],
		                   "changes": ["add at /state/groupBy: \"owner\"", "set /screens/board/children/1/groupBy to \"owner\""] }] } }],
		"test.waiting": [{ "set": "state.assistant.simulate", "to": { "online": true, "pending": ["p4"],
		                  "proposals": [{ "id": "p4", "message": "Rename the board to Q4 launch", "touches": ["a"],
		                  "changes": ["set /state/board to \"Q4 launch\""] }] } }],
		"test.models": [{ "set": "state.assistant.simulate", "to": { "online": true, "models": {
			"provider": "Claude Code", "default": "sonnet", "models": [
				{ "id": "sonnet", "name": "Claude Sonnet 5.5" }, { "id": "opus", "name": "Claude Opus 5.5" },
				{ "id": "fable", "name": "Claude Fable 5.1" }, { "id": "haiku", "name": "Claude Haiku 5.5" }] } } }],
		"test.pick": [{ "run": "assistant.pickModel", "with": { "id": "{{event.id}}" } }],
		"test.dark": [{ "set": "state.theme", "to": "dark" }],
		"test.arabic": [{ "set": "state.locale", "to": "ar" }]
	},

	"root": {
		"color": "@page",
		"children": [
			{ "type": "label", "id": "pageTitle", "anchors": { "left": 24, "top": 20 }, "fitText": true,
			  "textColor": "@pageText", "text": "{{t('assistant.title')}}" }
		]
	}
}
