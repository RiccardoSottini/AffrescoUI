{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "An infinite canvas, for the rendering check: a small whiteboard of cards (items from state, drawn by the canvas), an image and paths (children), with rulers and a grid. The scenario marquee-selects, resizes a card with snapping, drags a guide from a ruler, pans and zooms at the pointer.",

	"window": { "title": "Canvas", "width": 640, "height": 420 },

	"state": {
		"board": { "camera": { "x": -40, "y": -40, "zoom": 1 }, "selection": [], "guides": { "vertical": [], "horizontal": [] } },
		"cards": [
			{ "id": "research", "x": 0, "y": 0, "width": 140, "height": 80, "color": "#fef3c7", "borderColor": "#f59e0b",
			  "borderWidth": 1, "radius": 8, "text": "Research", "textSize": 16, "textColor": "#78350f" },
			{ "id": "design", "x": 200, "y": 0, "width": 140, "height": 80, "color": "#dbeafe", "borderColor": "#3b82f6",
			  "borderWidth": 1, "radius": 8, "text": "Design", "textSize": 16, "textColor": "#1e3a8a" },
			{ "id": "build", "x": 0, "y": 140, "width": 140, "height": 80, "color": "#dcfce7", "borderColor": "#22c55e",
			  "borderWidth": 1, "radius": 8, "text": "Build", "textSize": 16, "textColor": "#14532d" },
			{ "id": "note", "x": 200, "y": 160, "width": 100, "height": 40, "color": "#f1f5f9", "borderColor": "#94a3b8",
			  "borderWidth": 1, "radius": 4, "text": "small print", "textSize": 8, "textColor": "#334155" }
		]
	},

	"fonts": {
		"default": { "file": "../../../examples/shared/fonts/Roboto-Regular.ttf", "size": 14 }
	},

	"colors": { "paper": "#ffffff", "ink": "#0f172a", "accent": "#7c3aed" },

	"actions": {
		"placeCards": [
			{ "forEach": "{{moved}}", "as": "item", "do": [
				{ "set": "state.cards", "to": "{{map(state.cards, it.id == item.id ? merge(it, item) : it)}}" }
			] }
		]
	},

	"root": {
		"id": "page",
		"color": "@paper",
		"children": [
			{
				"type": "canvas", "id": "board", "bind": "state.board", "x": 0, "y": 0, "width": 640, "height": 420,
				"focusable": true, "grid": 20, "accentColor": "@accent", "items": "{{state.cards}}",
				"onTransform": { "run": "placeCards", "with": { "moved": "{{event.items}}" } },
				"children": [
					{ "type": "path", "id": "arrow", "x": 140, "y": 30, "width": 60, "height": 20, "viewBox": "0 0 60 20",
					  "stroke": "@ink", "strokeWidth": 2, "d": "M2 10 L52 10 M44 3 L54 10 L44 17" },
					{ "type": "image", "id": "badge", "x": 400, "y": 0, "width": 80, "height": 80,
					  "file": "images/badge.svg" },
					{ "type": "path", "id": "squiggle", "x": 360, "y": 140, "width": 160, "height": 100,
					  "viewBox": "0 0 160 100", "stroke": "@accent", "strokeWidth": 3, "strokeCap": "round",
					  "d": "M10 80 C 40 10, 70 10, 80 50 S 120 90, 150 20" }
				]
			}
		]
	}
}
