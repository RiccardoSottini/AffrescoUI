{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's shell: the title bar with a command centre, the activity bar, the explorer side bar, editor groups with tabs, the panel and the status bar. The layout (what is shown, the sash positions) is in state.layout, kept by persist; zen mode hides everything but the editors. Other features contribute commands, menus, keys, settings, tokens and components (examples/forge/README.md).",

	"state": {
		"layout": { "sidebar": true, "panel": true, "zen": false, "secondary": false, "sizes": [240], "panelSizes": [480], "groupSizes": [] },
		"folder": { "root": "", "files": [], "tree": [], "truncated": false },
		"explorer": { "expanded": [], "selected": null },
		"docs": [],
		"groups": [{ "tabs": [], "active": null }],
		"activeGroup": 0,
		"caret": { "line": 1, "column": 1, "selected": 0 },
		"menuBar": {},
		"about": false,
		"sideView": "explorer",
		"languages": { "c": "C++", "cc": "C++", "cpp": "C++", "h": "C++", "hpp": "C++", "json": "JSON", "md": "Markdown",
			"cmake": "CMake" }
	},

	"computed": {
		"docIds": "{{map(state.docs, it.id)}}",
		"dirtyIds": "{{map(filter(state.docs, it.dirty), it.id)}}",
		"activeDoc": "{{find(state.docs, it.id == state.groups[state.activeGroup].active)}}",
		"folderName": "{{empty(state.folder.root) ? 'No Folder Opened' : reverse(split(state.folder.root, '/'))[0]}}"
	},

	"actions": {
		"toggleSidebar": { "title": "Toggle Primary Side Bar", "category": "View", "icon": "panel-left",
			"do": [{ "toggle": "state.layout.sidebar" }] },
		"forgeShowView": [
			{ "if": "{{state.sideView == view && state.layout.sidebar}}",
			  "then": [{ "set": "state.layout.sidebar", "to": false }],
			  "else": [{ "set": "state.sideView", "to": "{{view}}" }, { "set": "state.layout.sidebar", "to": true }] }
		],
		"showExplorer": { "title": "Show Explorer", "category": "View", "icon": "files",
			"do": [{ "run": "forgeShowView", "with": { "view": "explorer" } }] },
		"showSearch": { "title": "Show Search", "category": "View", "icon": "search",
			"do": [{ "run": "forgeShowView", "with": { "view": "search" } }] },
		"togglePanel": { "title": "Toggle Panel", "category": "View", "icon": "panel-bottom",
			"do": [{ "toggle": "state.layout.panel" }] },
		"toggleZen": { "title": "Toggle Zen Mode", "category": "View", "icon": "maximize",
			"description": "Hide everything but the editors; run it again to bring the workbench back.",
			"do": [{ "toggle": "state.layout.zen" }] },
		"openFolder": { "title": "Open Folder...", "category": "File", "icon": "folder-open",
			"do": [{ "call": "forge.openFolder", "with": { "icons": "{{settings.workbench.fileIcons ? state.iconTheme : null}}" },
				"into": "state.folder",
				"onError": [{ "run": "notify", "with": { "severity": "info", "message": "{{'No folder opened: ' + error}}" } }],
				"then": [{ "set": "state.explorer.expanded", "to": [] },
				         { "run": "log", "with": { "text": "{{'Opened ' + result.root}}" } }] }] },
		"openExplorerItem": [
			{ "if": "{{!empty(event.id) && slice(event.id, length(event.id) - 1) != '/'}}",
			  "then": [{ "run": "openPath", "with": { "path": "{{event.id}}", "label": "{{reverse(split(event.id, '/'))[0]}}" } }] }
		],
		"showTab": [
			{ "if": "{{!some(state.groups[state.activeGroup].tabs, it.id == id)}}",
			  "then": [{ "push": "state.groups[state.activeGroup].tabs", "value": "{{ {id: id, label: label} }}" }] },
			{ "set": "state.groups[state.activeGroup].active", "to": "{{id}}" }
		],
		"openPage": [
			{ "if": "{{!contains(computed.docIds, id)}}",
			  "then": [{ "push": "state.docs", "value": "{{ {id: id, label: label, kind: kind, text: '', dirty: false, language: ''} }}" }] },
			{ "run": "showTab", "with": { "id": "{{id}}", "label": "{{label}}" } }
		],
		"closeEditor": { "title": "Close Editor", "category": "View", "icon": "x",
			"enablement": "{{!empty(state.groups[state.activeGroup].active)}}",
			"do": [{ "run": "closeTab", "with": { "gi": "{{state.activeGroup}}", "id": "{{state.groups[state.activeGroup].active}}" } }] },
		"splitEditor": { "title": "Split Editor", "category": "View", "icon": "columns-2",
			"description": "Open the active editor beside the current one (two groups at most).",
			"enablement": "{{length(state.groups) < 2 && !empty(state.groups[state.activeGroup].active)}}",
			"do": [
				{ "push": "state.groups", "value": "{{ {tabs: filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active), active: state.groups[state.activeGroup].active} }}" },
				{ "set": "state.activeGroup", "to": "{{length(state.groups) - 1}}" }
			] },
		"about": { "title": "About Forge", "category": "Help", "icon": "info", "do": [{ "set": "state.about", "to": true }] }
	},

	"keys": {
		"mod+b": "toggleSidebar",
		"mod+j": "togglePanel",
		"mod+k z": "toggleZen",
		"mod+o": "openFolder",
		"mod+w": "closeEditor",
		"mod+\\": "splitEditor"
	},

	"menus": {
		"file": {
			"openFolder": { "run": "openFolder", "group": "1_open", "order": 1 },
			"reindex": { "run": "reindex", "group": "1_open", "order": 2 },
			"closeEditor": { "run": "closeEditor", "group": "2_close", "order": 1 }
		},
		"view": {
			"sidebar": { "run": "toggleSidebar", "group": "2_layout", "order": 1 },
			"panel": { "run": "togglePanel", "group": "2_layout", "order": 2 },
			"split": { "run": "splitEditor", "group": "2_layout", "order": 3 },
			"zen": { "run": "toggleZen", "group": "2_layout", "order": 4 }
		},
		"help": {
			"keybindings": { "run": "openKeybindings", "group": "1_help", "order": 1 },
			"about": { "run": "about", "group": "2_about", "order": 1 }
		}
	},

	"components": {
		"forgeTitleBar": {
			"node": {
				"type": "row", "id": "title-bar", "role": "banner", "label": "Title Bar", "width": "100%", "height": 34, "color": "@color.titleBar", "alignItems": "center",
				"borderWidth": 1, "borderColor": "@color.border",
				"children": [
					{ "when": "{{!window.nativeMenuBar}}", "use": "menuBar", "id": "menu-bar", "width": 330,
					  "with": { "open": "state.menuBar", "menus": "{{[{name: 'file', title: 'File', items: menus.file}, {name: 'view', title: 'View', items: menus.view}, {name: 'go', title: 'Go', items: menus.go}, {name: 'preferences', title: 'Preferences', items: menus.preferences}, {name: 'help', title: 'Help', items: menus.help}]}}" } },
					{ "id": "title-left", "grow": 1 },
					{ "type": "row", "id": "command-centre", "role": "button", "label": "Search Files", "width": 420, "height": 24, "color": "@color.input", "radius": 6,
					  "borderWidth": 1, "borderColor": "@color.border", "alignItems": "center", "gap": 6,
					  "cursor": "hand", "tooltip": "Search files (> for commands, : for a line)", "hover": { "borderColor": "@color.accent" },
					  "onClick": { "run": "quickOpen" },
					  "children": [
						{ "id": "command-centre-start", "width": 0 },
						{ "type": "label", "id": "command-centre-icon", "icon": "search", "textColor": "@color.muted", "fitText": true },
						{ "type": "label", "id": "command-centre-text", "text": "{{computed.folderName}}", "textColor": "@color.muted",
						  "grow": 1, "height": 22, "align": "center" }
					  ] },
					{ "id": "title-right", "grow": 1 },
					{ "type": "label", "id": "title-sidebar", "role": "button", "icon": "panel-left", "padding": 6, "fitText": true, "cursor": "hand",
					  "textColor": "{{state.layout.sidebar ? '@color.text' : '@color.muted'}}", "tooltip": "Toggle Primary Side Bar",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "toggleSidebar" } },
					{ "type": "label", "id": "title-panel", "role": "button", "icon": "panel-bottom", "padding": 6, "fitText": true, "cursor": "hand",
					  "textColor": "{{state.layout.panel ? '@color.text' : '@color.muted'}}", "tooltip": "Toggle Panel",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "togglePanel" } },
					{ "type": "label", "id": "title-split", "role": "button", "icon": "columns-2", "padding": 6, "fitText": true, "cursor": "hand",
					  "textColor": "@color.muted", "tooltip": "Split Editor", "hover": { "color": "@color.hover" },
					  "onClick": { "run": "splitEditor" } }
				]
			}
		},
		"forgeActivityItem": {
			"params": { "view": "", "icon": "", "label": "", "tip": "" },
			"node": {
				"type": "row", "id": "activity-{{view}}", "role": "tab", "label": "{{label}}", "selected": "{{state.layout.sidebar && state.sideView == view}}",
				"width": 48, "height": 48, "cursor": "hand", "tooltip": "{{tip}}",
				"children": [
					{ "id": "activity-{{view}}-indicator", "width": 2, "height": 48,
					  "color": "{{state.layout.sidebar && state.sideView == view ? '@color.text' : '@color.activityBar'}}" },
					{ "type": "label", "icon": "{{icon}}", "font": "iconsLarge", "width": 44, "height": 48, "align": "center",
					  "textColor": "{{state.layout.sidebar && state.sideView == view ? '@color.text' : '@color.muted'}}", "hover": { "textColor": "@color.text" } }
				]
			}
		},
		"forgeActivityBar": {
			"node": {
				"type": "column", "id": "activity-bar", "role": "tablist", "label": "Activity Bar", "width": 48, "height": "100%", "color": "@color.activityBar",
				"children": [
					{ "use": "forgeActivityItem", "with": { "view": "explorer", "icon": "files", "label": "Explorer", "tip": "Explorer (Cmd+Shift+E)" },
					  "onClick": { "run": "showExplorer" } },
					{ "use": "forgeActivityItem", "with": { "view": "search", "icon": "search", "label": "Search", "tip": "Search (Cmd+Shift+F)" },
					  "onClick": { "run": "showSearch" } },
					{ "use": "forgeActivityItem", "with": { "view": "scm", "icon": "git-branch", "label": "Source Control", "tip": "Source Control (Cmd+Shift+G)" },
					  "onClick": { "run": "showSourceControl" } },
					{ "use": "forgeActivityItem", "with": { "view": "debug", "icon": "bug", "label": "Run and Debug", "tip": "Run and Debug (Cmd+Shift+D)" },
					  "onClick": { "run": "showDebug" } },
					{ "use": "forgeActivityItem", "with": { "view": "features", "icon": "blocks", "label": "Features", "tip": "Features (Cmd+Shift+X)" },
					  "onClick": { "run": "showFeatures" } },
					{ "use": "forgeActivityItem", "with": { "view": "agent", "icon": "bot", "label": "Agent", "tip": "Agent (Cmd+Alt+I)" },
					  "onClick": { "run": "showAgent" } },
					{ "id": "activity-gap", "grow": 1 },
					{ "type": "label", "id": "activity-settings", "role": "button", "label": "Settings", "icon": "settings", "font": "iconsLarge", "width": 48, "height": 48,
					  "align": "center", "cursor": "hand", "tooltip": "Settings (Cmd+,)", "textColor": "@color.muted",
					  "hover": { "textColor": "@color.text" }, "onClick": { "run": "openSettings" } }
				]
			}
		},
		"forgeViewTitle": {
			"params": { "text": "" },
			"node": { "type": "label", "text": "{{text}}", "textColor": "@color.muted", "width": "100%", "height": 35, "padding": 12 }
		},
		"forgeSideBar": {
			"node": {
				"type": "column", "id": "side-bar", "role": "complementary", "label": "Primary Side Bar", "point": "sidebar.views", "color": "@color.sideBar",
				"children": [
					{ "when": "{{state.sideView == 'scm'}}", "use": "forgeScmView" },
					{ "when": "{{state.sideView == 'debug'}}", "use": "forgeDebugView" },
					{ "when": "{{state.sideView == 'agent'}}", "use": "forgeAgentView" },
					{ "when": "{{state.sideView == 'features'}}", "use": "forgeFeaturesView" },
					{ "when": "{{state.sideView == 'search'}}", "use": "forgeSearchPage" },
					{ "when": "{{state.sideView == 'explorer'}}", "use": "forgeViewTitle", "with": { "text": "EXPLORER" }, "id": "side-bar-title" },
					{ "type": "label", "id": "side-bar-folder", "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "icon": "chevron-down",
					  "text": "{{upper(computed.folderName)}}", "textColor": "@color.text", "width": "100%", "height": 22,
					  "padding": 6 },
					{ "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "use": "forgeExplorer" },
					{ "type": "column", "id": "side-bar-empty", "when": "{{state.sideView == 'explorer' && empty(state.folder.root)}}", "width": "100%",
					  "alignItems": "center", "gap": 4,
					  "children": [
						{ "type": "label", "id": "side-bar-empty-text", "text": "You have not yet opened a folder.",
						  "textColor": "@color.text", "width": "100%", "padding": 12, "wrap": true },
						{ "type": "label", "id": "side-bar-open", "text": "Open Folder", "width": 200, "height": 28,
						  "align": "center", "color": "@color.accent", "textColor": "#ffffff", "radius": 2, "cursor": "hand",
						  "focusable": true, "onClick": { "run": "openFolder" } }
					  ] }
				]
			}
		},
		"forgeWelcome": {
			"node": {
				"type": "row", "id": "welcome", "width": "100%", "grow": 1, "color": "@color.editor",
				"children": [
					{ "id": "welcome-margin", "width": 48 },
					{ "type": "column", "id": "welcome-body", "grow": 1, "height": "100%", "gap": 10, "children": [
					{ "id": "welcome-top", "height": 38 },
					{ "type": "label", "id": "welcome-title", "text": "Forge", "font": "title", "textColor": "@color.text", "fitText": true },
					{ "type": "label", "id": "welcome-subtitle", "text": "A workbench written in JSON, changed live.",
					  "textColor": "@color.muted", "fitText": true },
					{ "type": "label", "id": "welcome-start", "text": "Start", "textColor": "@color.text", "fitText": true, "padding": 4 },
					{ "type": "label", "id": "welcome-open", "icon": "folder-open", "text": "Open Folder...", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "openFolder" } },
					{ "type": "label", "id": "welcome-files", "icon": "search", "text": "Go to File...", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "quickOpen" } },
					{ "type": "label", "id": "welcome-commands", "icon": "square-terminal", "text": "Show All Commands",
					  "textColor": "@color.info", "fitText": true, "cursor": "hand", "onClick": { "run": "showCommands" } },
					{ "type": "label", "id": "welcome-theme", "icon": "palette", "text": "Color Theme", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "pickTheme" } },
					{ "type": "label", "id": "welcome-settings", "icon": "settings", "text": "Settings", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "openSettings" } }
					] }
				]
			}
		},
		"forgeStatusBar": {
			"node": {
				"type": "row", "id": "status-bar", "role": "status", "label": "Status Bar", "point": "statusBar.right", "width": "100%", "height": 24, "color": "@color.statusBar", "alignItems": "center",
				"borderWidth": 1, "borderColor": "@color.border", "gap": 4,
				"children": [
					{ "type": "label", "id": "status-folder", "icon": "folder", "text": "{{computed.folderName}}", "padding": 6,
					  "fitText": true, "textColor": "@color.statusText" },
					{ "type": "label", "id": "status-errors", "role": "button", "label": "{{plural(computed.errors, 'error')}}", "icon": "circle-x", "padding": 6, "fitText": true, "cursor": "hand",
					  "text": "{{text(computed.errors)}}", "textColor": "@color.statusText", "tooltip": "Problems",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "showProblems" } },
					{ "type": "label", "id": "status-warnings", "role": "button", "label": "{{plural(computed.warnings, 'warning')}}", "icon": "alert-triangle", "padding": 6, "fitText": true,
					  "cursor": "hand", "text": "{{text(computed.warnings)}}", "textColor": "@color.statusText", "tooltip": "Problems",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "showProblems" } },
					{ "id": "status-gap", "grow": 1 },
					{ "type": "label", "id": "status-position", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "role": "button", "label": "Go to Line", "padding": 6, "fitText": true, "cursor": "hand",
					  "text": "{{'Ln ' + text(state.caret.line) + ', Col ' + text(state.caret.column) + (state.caret.selected > 0 ? ' (' + text(state.caret.selected) + ' selected)' : '')}}",
					  "textColor": "@color.statusText", "hover": { "color": "@color.hover" }, "onClick": { "run": "goToLinePick" } },
					{ "type": "label", "id": "status-language", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "text": "{{computed.activeDoc.language || 'Plain Text'}}", "padding": 6, "fitText": true,
					  "textColor": "@color.statusText" },
					{ "type": "label", "id": "status-theme", "role": "button", "label": "Color Theme", "icon": "palette", "padding": 6, "fitText": true, "cursor": "hand",
					  "text": "{{find(state.themes, it.id == state.theme).name ?? state.theme}}", "textColor": "@color.statusText",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "pickTheme" } },
					{ "use": "forgeAccountsStatus" },
					{ "type": "label", "id": "status-notifications", "role": "button", "label": "Notifications", "icon": "bell", "padding": 6, "fitText": true, "cursor": "hand",
					  "text": "{{length(state.notifications) > 0 ? text(length(state.notifications)) : ''}}",
					  "textColor": "@color.statusText", "tooltip": "Notifications", "hover": { "color": "@color.hover" },
					  "onClick": { "run": "showNotifications" } }
				]
			}
		}
	}
}
