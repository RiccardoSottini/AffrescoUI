{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's shell: the title bar with a command centre, the activity bar, the explorer side bar, editor groups with tabs, the panel and the status bar. The layout (what is shown, the sash positions) is in state.layout, kept by persist; zen mode hides everything but the editors. Other features contribute commands, menus, keys, settings, tokens and components (examples/forge/README.md).",

	"state": {
		"layout": { "sidebar": true, "panel": false, "panelMax": false, "zen": false, "secondary": false, "sizes": [240], "panelSizes": [480], "groupSizes": [] },
		"folder": { "root": "", "files": [],
			"skip": "**/node_modules/**,**/build/**,**/out/**,**/dist/**,**/target/**,**/__pycache__/**,**/.*/**,**/.*" },
		"explorer": { "expanded": [], "selected": null },
		"docs": [],
		"groups": [{ "tabs": [], "active": null }],
		"activeGroup": 0,
		"caret": { "line": 1, "column": 1, "selected": 0 },
		"menuBar": {},
		"about": false,
		"sideView": "explorer",
		"nav": { "back": [], "forward": [], "moving": false },
		"notificationCentre": false,
		"languages": { "c": "C++", "cc": "C++", "cpp": "C++", "h": "C++", "hpp": "C++", "json": "JSON", "md": "Markdown",
			"cmake": "CMake" }
	},

	"computed": {
		"docIds": "{{map(state.docs, it.id)}}",
		"dirtyIds": "{{map(filter(state.docs, it.dirty), it.id)}}",
		"activeDoc": "{{find(state.docs, it.id == state.groups[state.activeGroup].active)}}",
		"folderName": "{{empty(state.folder.root) ? 'No Folder Opened' : reverse(split(state.folder.root, '/'))[0]}}"
	},

	"actions": {
		"toggleSidebar": { "title": "Toggle Primary Side Bar", "category": "View", "icon": "panel-left",
			"do": [{ "toggle": "state.layout.sidebar" }] },
		"forgeShowView": [
			{ "if": "{{state.sideView == view && state.layout.sidebar}}",
			  "then": [{ "set": "state.layout.sidebar", "to": false }],
			  "else": [{ "set": "state.sideView", "to": "{{view}}" }, { "set": "state.layout.sidebar", "to": true }] }
		],
		"showExplorer": { "title": "Show Explorer", "category": "View", "icon": "files",
			"do": [{ "run": "forgeShowView", "with": { "view": "explorer" } }] },
		"showSearch": { "title": "Show Search", "category": "View", "icon": "search",
			"do": [{ "run": "forgeShowView", "with": { "view": "search" } }] },
		"navigateBack": { "title": "Go Back", "category": "Go", "icon": "arrow-left",
			"enablement": "{{length(state.nav.back) > 0}}",
			"do": [{ "set": "state.nav.forward", "to": "{{concat(filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active), state.nav.forward)}}" },
			       { "run": "forgeNavigateTo", "with": { "tab": "{{state.nav.back[length(state.nav.back) - 1]}}" } },
			       { "set": "state.nav.back", "to": "{{slice(state.nav.back, 0, length(state.nav.back) - 1)}}" }] },
		"navigateForward": { "title": "Go Forward", "category": "Go", "icon": "arrow-right",
			"enablement": "{{length(state.nav.forward) > 0}}",
			"do": [{ "set": "state.nav.back", "to": "{{concat(state.nav.back, filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active))}}" },
			       { "run": "forgeNavigateTo", "with": { "tab": "{{state.nav.forward[0]}}" } },
			       { "set": "state.nav.forward", "to": "{{slice(state.nav.forward, 1)}}" }] },
		"forgeNavigateTo": [
			{ "note": "tab: { id, label }, shown without being recorded in the history" },
			{ "set": "state.nav.moving", "to": true },
			{ "run": "showTab", "with": { "id": "{{tab.id}}", "label": "{{tab.label}}" } },
			{ "set": "state.nav.moving", "to": false }
		],
		"togglePanel": { "title": "Toggle Panel", "category": "View", "icon": "panel-bottom",
			"do": [{ "toggle": "state.layout.panel" }, { "set": "state.layout.panelMax", "to": false }] },
		"toggleMaximizedPanel": { "title": "Maximize Panel Size", "category": "View", "icon": "chevron-up",
			"do": [{ "set": "state.layout.panel", "to": true }, { "toggle": "state.layout.panelMax" }] },
		"toggleZen": { "title": "Toggle Zen Mode", "category": "View", "icon": "maximize",
			"description": "Hide everything but the editors; run it again to bring the workbench back.",
			"do": [{ "toggle": "state.layout.zen" }] },
		"openFolder": { "title": "Open Folder...", "category": "File", "icon": "folder-open",
			"do": [{ "chooseFolder": "workspace", "title": "Open Folder",
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'No folder opened: ' + error.message}}" } }],
				"onDone": [{ "set": "state.explorer", "to": "{{ {expanded: [], selected: null} }}" },
				           { "set": "state.explorerTree", "to": "{{ {entries: [], listed: []} }}" },
				           { "set": "state.folder.root", "to": "{{result.name}}" },
				           { "run": "explorerRefresh" }, { "run": "indexFolder" },
				           { "run": "log", "with": { "text": "{{'Opened ' + result.name}}" } }] }] },
		"indexFolder": [
			{ "note": "Lists the folder's files for Go to File" },
			{ "invoke": "search.files", "with": { "exclude": "{{state.folder.skip}}" },
			  "onDone": [{ "run": "indexed", "with": { "files": "{{result.files}}" } }], "onError": [{ "set": "state.folder.files", "to": [] }] }
		],
		"indexed": [{ "set": "state.folder.files", "to": "{{map(files, {id: it, title: reverse(split(it, '/'))[0], detail: join(slice(split(it, '/'), 0, -1), '/')})}}" }],
		"openExplorerItem": [
			{ "if": "{{!empty(event.id) && (find(state.explorerTree.entries, it.path == event.id) ?? {}).kind != 'folder'}}",
			  "then": [{ "run": "openPath", "with": { "path": "{{event.id}}", "label": "{{reverse(split(event.id, '/'))[0]}}" } }] }
		],
		"showTab": [
			{ "if": "{{!state.nav.moving && !empty(state.groups[state.activeGroup].active) && state.groups[state.activeGroup].active != id}}",
			  "then": [{ "set": "state.nav", "to": "{{ {back: slice(concat(state.nav.back, filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active)), max(0, length(state.nav.back) - 49)), forward: [], moving: false} }}" }] },
			{ "if": "{{!some(state.groups[state.activeGroup].tabs, it.id == id)}}",
			  "then": [{ "push": "state.groups[state.activeGroup].tabs", "value": "{{ {id: id, label: label} }}" }] },
			{ "set": "state.groups[state.activeGroup].active", "to": "{{id}}" }
		],
		"openPage": [
			{ "if": "{{!contains(computed.docIds, id)}}",
			  "then": [{ "push": "state.docs", "value": "{{ {id: id, label: label, kind: kind, text: '', dirty: false, language: ''} }}" }] },
			{ "run": "showTab", "with": { "id": "{{id}}", "label": "{{label}}" } }
		],
		"closeEditor": { "title": "Close Editor", "category": "View", "icon": "x",
			"enablement": "{{!empty(state.groups[state.activeGroup].active)}}",
			"do": [{ "run": "closeTab", "with": { "gi": "{{state.activeGroup}}", "id": "{{state.groups[state.activeGroup].active}}" } }] },
		"splitEditor": { "title": "Split Editor", "category": "View", "icon": "columns-2",
			"description": "Open the active editor beside the current one (two groups at most).",
			"enablement": "{{length(state.groups) < 2 && !empty(state.groups[state.activeGroup].active)}}",
			"do": [
				{ "push": "state.groups", "value": "{{ {tabs: filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active), active: state.groups[state.activeGroup].active} }}" },
				{ "set": "state.activeGroup", "to": "{{length(state.groups) - 1}}" }
			] },
		"about": { "title": "About Forge", "category": "Help", "icon": "info", "do": [{ "set": "state.about", "to": true }] }
	},

	"keys": {
		"mod+b": "toggleSidebar",
		"mod+j": "togglePanel",
		"mod+k z": "toggleZen",
		"mod+o": "openFolder",
		"mod+w": "closeEditor",
		"mod+\\": "splitEditor",
		"ctrl+minus": "navigateBack",
		"ctrl+shift+minus": "navigateForward"
	},

	"menus": {
		"file": {
			"openFolder": { "run": "openFolder", "group": "1_open", "order": 1 },
			"reindex": { "run": "reindex", "group": "1_open", "order": 2 },
			"closeEditor": { "run": "closeEditor", "group": "2_close", "order": 1 }
		},
		"view": {
			"sidebar": { "run": "toggleSidebar", "group": "2_layout", "order": 1 },
			"panel": { "run": "togglePanel", "group": "2_layout", "order": 2 },
			"split": { "run": "splitEditor", "group": "2_layout", "order": 3 },
			"zen": { "run": "toggleZen", "group": "2_layout", "order": 4 }
		},
		"go": {
			"back": { "run": "navigateBack", "group": "0_history", "order": 1 },
			"forward": { "run": "navigateForward", "group": "0_history", "order": 2 }
		},
		"help": {
			"keybindings": { "run": "openKeybindings", "group": "1_help", "order": 1 },
			"about": { "run": "about", "group": "2_about", "order": 1 }
		}
	},

	"components": {
		"forgeTitleBar": {
			"node": {
				"type": "row", "id": "title-bar", "role": "banner", "label": "Title Bar", "width": "100%", "height": 34, "color": "@color.titleBar", "alignItems": "center",
				"borderWidth": 1, "borderColor": "@color.border",
				"children": [
					{ "when": "{{!window.nativeMenuBar}}", "use": "menuBar", "id": "menu-bar", "width": 330,
					  "with": { "open": "state.menuBar", "menus": "{{[{name: 'file', title: 'File', items: menus.file}, {name: 'view', title: 'View', items: menus.view}, {name: 'go', title: 'Go', items: menus.go}, {name: 'preferences', title: 'Preferences', items: menus.preferences}, {name: 'help', title: 'Help', items: menus.help}]}}" } },
					{ "id": "title-left", "grow": 1 },
					{ "use": "forgeTitleButton", "id": "title-back", "with": { "icon": "arrow-left", "tip": "Go Back (Ctrl+-)", "on": "{{length(state.nav.back) > 0}}" },
					  "onClick": { "run": "navigateBack" } },
					{ "use": "forgeTitleButton", "id": "title-forward", "with": { "icon": "arrow-right", "tip": "Go Forward (Ctrl+Shift+-)", "on": "{{length(state.nav.forward) > 0}}" },
					  "onClick": { "run": "navigateForward" } },
					{ "id": "title-centre-gap", "width": 4 },
					{ "type": "row", "id": "command-centre", "role": "button", "label": "Search Files", "width": 420, "height": 22, "color": "@color.input", "radius": 5,
					  "borderWidth": 1, "borderColor": "@color.border", "alignItems": "center", "gap": 6,
					  "cursor": "hand", "tooltip": "Search files (> for commands, : for a line)", "hover": { "color": "@color.hover" },
					  "onClick": { "run": "quickOpen" },
					  "children": [
						{ "id": "command-centre-start", "grow": 1 },
						{ "type": "label", "id": "command-centre-icon", "icon": "search", "textColor": "@color.muted", "fitText": true },
						{ "type": "label", "id": "command-centre-text", "text": "{{computed.folderName}}", "textColor": "@color.muted",
						  "fitText": true, "height": 20 },
						{ "id": "command-centre-end", "grow": 1 }
					  ] },
					{ "id": "title-right", "grow": 1 },
					{ "use": "forgeTitleButton", "id": "title-sidebar", "with": { "icon": "panel-left", "tip": "Toggle Primary Side Bar (Cmd+B)", "on": "{{state.layout.sidebar}}" },
					  "onClick": { "run": "toggleSidebar" } },
					{ "use": "forgeTitleButton", "id": "title-panel", "with": { "icon": "panel-bottom", "tip": "Toggle Panel (Cmd+J)", "on": "{{state.layout.panel}}" },
					  "onClick": { "run": "togglePanel" } },
					{ "use": "forgeTitleButton", "id": "title-secondary", "with": { "icon": "panel-right", "tip": "Toggle Secondary Side Bar (Cmd+Alt+B)", "on": "{{state.layout.secondary}}" },
					  "onClick": { "run": "toggleSecondarySidebar" } },
					{ "id": "title-end", "width": 8 }
				]
			}
		},
		"forgeTitleButton": {
			"params": { "icon": "", "tip": "", "on": false },
			"node": { "type": "label", "role": "button", "label": "{{tip}}", "icon": "{{icon}}", "font": "icons", "width": 26, "height": 24, "align": "center",
			          "radius": 5, "cursor": "hand", "textColor": "{{on ? '@color.text' : '@color.muted'}}", "tooltip": "{{tip}}",
			          "hover": { "color": "@color.hover" } }
		},
		"forgeActivityItem": {
			"params": { "view": "", "icon": "", "label": "", "tip": "", "badge": 0 },
			"node": {
				"id": "activity-{{view}}", "role": "tab", "label": "{{label}}", "selected": "{{state.layout.sidebar && state.sideView == view}}",
				"width": 48, "height": 48, "color": "@color.activityBar", "cursor": "hand", "tooltip": "{{tip}}",
				"children": [
					{ "id": "activity-{{view}}-indicator", "anchors": { "left": 0, "top": 0, "bottom": 0 }, "width": 2,
					  "color": "{{state.layout.sidebar && state.sideView == view ? '@color.accent' : '@color.activityBar'}}" },
					{ "type": "label", "icon": "{{icon}}", "font": "iconsLarge", "anchors": { "left": 0, "top": 0, "right": 0, "bottom": 0 }, "align": "center",
					  "textColor": "{{state.layout.sidebar && state.sideView == view ? '@color.text' : '@color.muted'}}", "hover": { "textColor": "@color.text" } },
					{ "type": "label", "id": "activity-{{view}}-badge", "when": "{{badge > 0}}", "text": "{{badge > 99 ? '99+' : text(badge)}}",
					  "anchors": { "right": 6, "bottom": 7 }, "height": 16, "padding": 4, "fitText": true, "radius": 8, "align": "center",
					  "color": "@color.accent", "textColor": "#ffffff" }
				]
			}
		},
		"forgeActivityBar": {
			"node": {
				"type": "column", "id": "activity-bar", "role": "tablist", "label": "Activity Bar", "width": 48, "height": "100%", "color": "@color.activityBar",
				"children": [
					{ "use": "forgeActivityItem", "with": { "view": "explorer", "icon": "files", "label": "Explorer", "tip": "Explorer (Cmd+Shift+E)" },
					  "onClick": { "run": "showExplorer" } },
					{ "use": "forgeActivityItem", "with": { "view": "search", "icon": "search", "label": "Search", "tip": "Search (Cmd+Shift+F)" },
					  "onClick": { "run": "showSearch" } },
					{ "use": "forgeActivityItem", "with": { "view": "scm", "icon": "git-branch", "label": "Source Control", "tip": "Source Control (Cmd+Shift+G)",
					  "badge": "{{state.scm.status.count}}" },
					  "onClick": { "run": "showSourceControl" } },
					{ "use": "forgeActivityItem", "with": { "view": "debug", "icon": "bug", "label": "Run and Debug", "tip": "Run and Debug (Cmd+Shift+D)" },
					  "onClick": { "run": "showDebug" } },
					{ "use": "forgeActivityItem", "with": { "view": "features", "icon": "blocks", "label": "Features", "tip": "Features (Cmd+Shift+X)" },
					  "onClick": { "run": "showFeatures" } },
					{ "use": "forgeActivityItem", "with": { "view": "agent", "icon": "bot", "label": "Agent", "tip": "Agent (Cmd+Alt+I)" },
					  "onClick": { "run": "showAgent" } },
					{ "id": "activity-gap", "grow": 1 },
					{ "use": "forgeAccountsStatus" },
					{ "type": "label", "id": "activity-settings", "role": "button", "label": "Settings", "icon": "settings", "font": "iconsLarge", "width": 48, "height": 48,
					  "align": "center", "cursor": "hand", "tooltip": "Settings (Cmd+,)", "textColor": "@color.muted",
					  "hover": { "textColor": "@color.text" }, "onClick": { "run": "openSettings" } }
				]
			}
		},
		"forgeViewTitle": {
			"params": { "text": "" },
			"node": { "type": "label", "text": "{{text}}", "textColor": "@color.muted", "width": "100%", "height": 35, "padding": 12 }
		},
		"forgeSideBar": {
			"node": {
				"type": "column", "id": "side-bar", "role": "complementary", "label": "Primary Side Bar", "point": "sidebar.views", "color": "@color.sideBar",
				"children": [
					{ "when": "{{state.sideView == 'scm'}}", "use": "forgeScmView" },
					{ "when": "{{state.sideView == 'debug'}}", "use": "forgeDebugView" },
					{ "when": "{{state.sideView == 'agent'}}", "use": "forgeAgentView" },
					{ "when": "{{state.sideView == 'features'}}", "use": "forgeFeaturesView" },
					{ "when": "{{state.sideView == 'search'}}", "use": "forgeSearchPage" },
					{ "when": "{{state.sideView == 'explorer'}}", "use": "forgeViewTitle", "with": { "text": "EXPLORER" }, "id": "side-bar-title" },
					{ "type": "label", "id": "side-bar-folder", "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "icon": "chevron-down",
					  "text": "{{upper(computed.folderName)}}", "textColor": "@color.text", "width": "100%", "height": 22,
					  "padding": 6 },
					{ "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "use": "forgeExplorer" },
					{ "type": "column", "id": "side-bar-empty", "when": "{{state.sideView == 'explorer' && empty(state.folder.root)}}", "width": "100%",
					  "alignItems": "center", "gap": 4,
					  "children": [
						{ "type": "label", "id": "side-bar-empty-text", "text": "You have not yet opened a folder.",
						  "textColor": "@color.text", "width": "100%", "padding": 12, "wrap": true },
						{ "type": "label", "id": "side-bar-open", "text": "Open Folder", "width": 200, "height": 28,
						  "align": "center", "color": "@color.accent", "textColor": "#ffffff", "radius": 2, "cursor": "hand",
						  "focusable": true, "onClick": { "run": "openFolder" } }
					  ] }
				]
			}
		},
		"forgeWelcome": {
			"node": {
				"type": "row", "id": "welcome", "width": "100%", "grow": 1, "color": "@color.editor",
				"children": [
					{ "id": "welcome-margin", "width": 48 },
					{ "type": "column", "id": "welcome-body", "grow": 1, "height": "100%", "gap": 10, "children": [
					{ "id": "welcome-top", "height": 38 },
					{ "type": "label", "id": "welcome-title", "text": "Forge", "font": "title", "textColor": "@color.text", "fitText": true },
					{ "type": "label", "id": "welcome-subtitle", "text": "A workbench written in JSON, changed live.",
					  "textColor": "@color.muted", "fitText": true },
					{ "type": "label", "id": "welcome-start", "text": "Start", "textColor": "@color.text", "fitText": true, "padding": 4 },
					{ "type": "label", "id": "welcome-open", "icon": "folder-open", "text": "Open Folder...", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "openFolder" } },
					{ "type": "label", "id": "welcome-files", "icon": "search", "text": "Go to File...", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "quickOpen" } },
					{ "type": "label", "id": "welcome-commands", "icon": "square-terminal", "text": "Show All Commands",
					  "textColor": "@color.info", "fitText": true, "cursor": "hand", "onClick": { "run": "showCommands" } },
					{ "type": "label", "id": "welcome-theme", "icon": "palette", "text": "Color Theme", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "pickTheme" } },
					{ "type": "label", "id": "welcome-settings", "icon": "settings", "text": "Settings", "textColor": "@color.info",
					  "fitText": true, "cursor": "hand", "onClick": { "run": "openSettings" } }
					] }
				]
			}
		},
		"forgeStatusItem": {
			"params": { "text": "", "icon": "", "tip": "" },
			"node": { "type": "label", "role": "button", "label": "{{tip}}", "text": "{{text}}", "icon": "{{icon}}", "padding": 6, "height": 22, "fitText": true,
			          "cursor": "hand", "textColor": "@color.statusText", "tooltip": "{{tip}}", "hover": { "color": "@color.hover" } }
		},
		"forgeStatusBar": {
			"node": {
				"type": "row", "id": "status-bar", "role": "status", "label": "Status Bar", "point": "statusBar.right", "width": "100%", "height": 22, "color": "@color.statusBar", "alignItems": "center",
				"borderWidth": 1, "borderColor": "@color.border", "gap": 2,
				"children": [
					{ "type": "label", "id": "status-remote", "role": "button", "label": "Document Server", "icon": "chevrons-left-right", "width": 36, "height": 22,
					  "align": "center", "cursor": "hand", "color": "@color.accent", "textColor": "#ffffff", "tooltip": "Document Server: sign in to share and sync",
					  "onClick": { "run": "accountsMenu" } },
					{ "use": "forgeStatusItem", "id": "status-branch", "when": "{{!empty(state.scm.status.branch.head)}}",
					  "with": { "icon": "git-branch", "text": "{{computed.scmBranchText}}", "tip": "Show Branches" }, "onClick": { "run": "scmBranches" } },
					{ "use": "forgeStatusItem", "id": "status-sync", "when": "{{!empty(state.scm.status.branch.head)}}",
					  "with": { "icon": "refresh-cw", "tip": "Refresh Source Control" }, "onClick": { "run": "scmRefresh" } },
					{ "type": "label", "id": "status-problems", "role": "button", "label": "{{plural(computed.errors, 'error') + ', ' + plural(computed.warnings, 'warning')}}",
					  "runs": ["{{' '}}", { "icon": "circle-x" }, "{{' ' + text(computed.errors) + '  '}}", { "icon": "alert-triangle" }, "{{' ' + text(computed.warnings)}}"],
					  "padding": 6, "height": 22, "fitText": true, "cursor": "hand", "textColor": "@color.statusText", "tooltip": "Problems (Cmd+Shift+M)",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "showProblems" } },
					{ "id": "status-gap", "grow": 1 },
					{ "use": "forgeStatusItem", "id": "status-position", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "tip": "Go to Line", "text": "{{'Ln ' + text(state.caret.line) + ', Col ' + text(state.caret.column) + (state.caret.selected > 0 ? ' (' + text(state.caret.selected) + ' selected)' : '')}}" },
					  "onClick": { "run": "goToLinePick" } },
					{ "use": "forgeStatusItem", "id": "status-indent", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "Spaces: 4", "tip": "Indentation: four spaces" } },
					{ "use": "forgeStatusItem", "id": "status-encoding", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "UTF-8", "tip": "Encoding" } },
					{ "use": "forgeStatusItem", "id": "status-eol", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "LF", "tip": "Line endings" } },
					{ "use": "forgeStatusItem", "id": "status-language-status", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "icon": "braces", "tip": "Language Status" }, "onClick": { "run": "showOutput" } },
					{ "use": "forgeStatusItem", "id": "status-language", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "{{computed.activeDoc.language || 'Plain Text'}}", "tip": "Language" } },
					{ "use": "forgeStatusItem", "id": "status-notifications", "with": { "icon": "{{length(state.notifications) > 0 ? 'bell-dot' : 'bell'}}", "tip": "Notifications" },
					  "onClick": { "run": "showNotifications" } },
					{ "id": "status-end", "width": 4 }
				]
			}
		},
		"forgeNotificationCentre": {
			"node": {
				"type": "column", "id": "notification-centre", "role": "dialog", "label": "Notifications", "width": 450,
				"height": "{{40 + max(1, min(6, length(state.notifications))) * 28}}", "color": "@color.widget", "borderWidth": 1, "borderColor": "@color.border", "radius": 4,
				"overlay": { "anchor": "#status-notifications", "placement": "above-end", "open": "state.notificationCentre", "dismiss": "outside" },
				"children": [
					{ "type": "row", "id": "notification-centre-head", "width": "100%", "height": 34, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "notification-centre-title", "text": "{{empty(state.notifications) ? 'NO NEW NOTIFICATIONS' : 'NOTIFICATIONS'}}",
						  "textColor": "@color.muted", "grow": 1, "padding": 10 },
						{ "use": "forgeTitleButton", "id": "notification-centre-clear", "with": { "icon": "list-x", "tip": "Clear All Notifications" },
						  "onClick": { "run": "clearNotifications" } },
						{ "use": "forgeTitleButton", "id": "notification-centre-hide", "with": { "icon": "chevron-down", "tip": "Hide Notifications" },
						  "onClick": { "set": "state.notificationCentre", "to": false } },
						{ "id": "notification-centre-end", "width": 4 }
					  ] },
					{ "type": "list", "id": "notifications", "label": "Notifications", "when": "{{!empty(state.notifications)}}", "width": "100%", "grow": 1,
					  "items": "{{computed.notificationRows}}", "rowHeight": 28, "color": "@color.widget", "textColor": "@color.text",
					  "selectedBackground": "@color.selection" }
				]
			}
		}
	}
}
