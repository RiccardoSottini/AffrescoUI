{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's palette: one quick pick with four providers (files by default, '>' commands, ':' go to line, 'theme ' colour themes, 'task ' the tasks Run Task read), and the Settings and Keyboard Shortcuts pages, both generated from what the features contribute (the settings and commands sections and the keys).",

	"state": {
		"quickPick": { "open": false, "query": "" },
		"goTo": { "line": 0, "request": 0 },
		"keysQuery": "",
		"settingsQuery": ""
	},

	"computed": {
		"commandItems": "{{map(filter(commands, it.enabled), {title: (it.category ? it.category + ': ' : '') + it.title, detail: it.keyLabel ?? '', run: it.name})}}",
		"lineItems": "{{number(slice(state.quickPick.query ?? '', 1)) > 0 ? [{title: 'Go to line ' + trim(slice(state.quickPick.query, 1)), line: number(slice(state.quickPick.query, 1))}] : []}}",
		"keyRows": "{{map(filter(keybindings, empty(state.keysQuery) || contains(lower((it.title ?? it.command ?? '') + ' ' + it.keyLabel), lower(state.keysQuery))), {id: index, cells: [it.title ?? it.command ?? '', it.keyLabel, it.when ?? '', it.scope]})}}"
	},

	"settings": {
		"workbench.statusBar.visible": { "type": "boolean", "default": true, "title": "Status bar",
			"description": "Show the status bar at the bottom of the window." },
		"workbench.activityBar.visible": { "type": "boolean", "default": true, "title": "Activity bar",
			"description": "Show the activity bar on the left." },
		"workbench.startupEditor": { "type": "string", "enum": ["welcome", "none"], "default": "welcome",
			"title": "Startup editor", "description": "What the editor area shows when no file is open." },
		"editor.lineNumbers": { "type": "boolean", "default": true, "title": "Line numbers",
			"description": "Show line numbers in the editor's gutter." }
	},

	"actions": {
		"quickOpen": { "title": "Go to File...", "category": "Go", "icon": "search",
			"do": [{ "set": "state.quickPick.query", "to": "" }, { "set": "state.quickPick.open", "to": true }] },
		"showCommands": { "title": "Show All Commands", "category": "View", "icon": "search",
			"do": [{ "set": "state.quickPick.query", "to": ">" }, { "set": "state.quickPick.open", "to": true }] },
		"goToLinePick": { "title": "Go to Line...", "category": "Go", "icon": "hash",
			"do": [{ "set": "state.quickPick.query", "to": ":" }, { "set": "state.quickPick.open", "to": true }] },
		"openPicked": [{ "run": "openPath", "with": { "path": "{{item.id}}", "label": "{{item.title}}" } }],
		"goToPicked": [{ "run": "goToLine", "with": { "line": "{{item.line}}" } }],
		"goToLine": [{ "set": "state.goTo.line", "to": "{{line}}" }, { "increment": "state.goTo.request", "by": 1 }],
		"openSettings": { "title": "Open Settings", "category": "Preferences", "icon": "settings",
			"do": [{ "run": "openPage", "with": { "id": "forge:settings", "label": "Settings", "kind": "settings" } }] },
		"openKeybindings": { "title": "Open Keyboard Shortcuts", "category": "Preferences", "icon": "keyboard",
			"do": [{ "run": "openPage", "with": { "id": "forge:keybindings", "label": "Keyboard Shortcuts", "kind": "keybindings" } }] }
	},

	"keys": {
		"mod+p": "quickOpen",
		"mod+shift+p": "showCommands",
		"mod+g": "goToLinePick",
		"mod+,": "openSettings",
		"mod+k mod+s": "openKeybindings"
	},

	"menus": {
		"go": {
			"quickOpen": { "run": "quickOpen", "group": "1_go", "order": 1 },
			"goToLine": { "run": "goToLinePick", "group": "1_go", "order": 2 }
		},
		"view": {
			"commands": { "run": "showCommands", "group": "1_open", "order": 1 }
		},
		"preferences": {
			"settings": { "run": "openSettings", "group": "1_settings", "order": 1 },
			"keybindings": { "run": "openKeybindings", "group": "1_settings", "order": 2 }
		}
	},

	"components": {
		"forgePalette": {
			"node": { "id": "palette", "use": "quickPick", "with": {
				"width": 600, "color": "@color.widget", "textColor": "@color.text", "dimColor": "@color.muted",
				"accent": "@color.info", "highlight": "@color.selection", "field": "@color.input",
				"providers": [
					{ "items": "{{state.folder.files ?? []}}", "run": "openPicked",
					  "placeholder": "Search files by name (> for commands, : for a line)" },
					{ "prefix": ">", "items": "{{computed.commandItems}}", "placeholder": "Run a command" },
					{ "prefix": ":", "items": "{{computed.lineItems}}", "run": "goToPicked",
					  "placeholder": "Type a line number" },
					{ "prefix": "theme ", "items": "{{state.themes}}", "key": "name", "run": "setTheme",
					  "placeholder": "Choose a colour theme" },
					{ "prefix": "task ", "items": "{{state.tasks.items}}", "run": "taskStart",
					  "placeholder": "Choose a task to run" }
				] } }
		},
		"forgeSettingsPage": {
			"node": { "use": "settingsPage", "id": "settings-page", "width": "100%", "grow": 1, "color": "@color.editor",
			          "with": { "search": "{{state.settingsQuery}}" } }
		},
		"forgeKeybindingsPage": {
			"node": {
				"type": "column", "id": "keybindings-page", "width": "100%", "grow": 1, "color": "@color.editor", "gap": 8,
				"children": [
					{ "type": "textarea", "id": "keybindings-search", "role": "searchbox", "label": "Search Keybindings", "bind": "state.keysQuery", "width": "100%", "height": 30,
					  "padding": 7, "color": "@color.input", "textColor": "@color.text", "placeholderColor": "@color.muted",
					  "placeholder": "Search keybindings" },
					{ "type": "table", "id": "keybindings-table", "label": "Keyboard Shortcuts", "width": "100%", "grow": 1, "items": "{{computed.keyRows}}",
					  "rowHeight": 24, "color": "@color.editor", "textColor": "@color.text",
					  "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "columns": [{ "id": "command", "title": "Command", "width": 280 }, { "id": "key", "title": "Keybinding", "width": 160 },
					              { "id": "when", "title": "When", "width": 200 }, { "id": "source", "title": "Source", "width": 100 }] }
				]
			}
		}
	}
}
