{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's themes: every colour of the workbench is a token with one variant per theme, so a theme is a set of values and switching is one state change. Importing a colour theme adds a variant to each token through a patch. Importing reads the file with openFile and maps the theme format's colour keys to the tokens with themeSources. The file icon theme maps names and extensions to icons, which the explorer shows.",

	"tokens": {
		"color.titleBar": { "forge-dark": "#1b1e24", "forge-light": "#eef0f3", "forge-high-contrast": "#000000" },
		"color.activityBar": { "forge-dark": "#15181d", "forge-light": "#e6e9ed", "forge-high-contrast": "#000000" },
		"color.sideBar": { "forge-dark": "#181b21", "forge-light": "#f2f3f5", "forge-high-contrast": "#000000" },
		"color.editor": { "forge-dark": "#1d2026", "forge-light": "#fcfcfb", "forge-high-contrast": "#000000" },
		"color.editorText": { "forge-dark": "#cdd1d8", "forge-light": "#2f343b", "forge-high-contrast": "#ffffff" },
		"color.tabs": { "forge-dark": "#15181d", "forge-light": "#e9ecef", "forge-high-contrast": "#000000" },
		"color.tabActive": { "forge-dark": "#1d2026", "forge-light": "#fcfcfb", "forge-high-contrast": "#000000" },
		"color.panel": { "forge-dark": "#181b21", "forge-light": "#f2f3f5", "forge-high-contrast": "#000000" },
		"color.statusBar": { "forge-dark": "#122826", "forge-light": "#d7ebe7", "forge-high-contrast": "#04201d" },
		"color.statusText": { "forge-dark": "#b9cfcb", "forge-light": "#24423d", "forge-high-contrast": "#ffffff" },
		"color.accent": { "forge-dark": "#14907f", "forge-light": "#0b7a6c", "forge-high-contrast": "#0a8a7a" },
		"color.selection": { "forge-dark": "#284b4f", "forge-light": "#c3e4dd", "forge-high-contrast": "#0b4d5c" },
		"color.hover": { "forge-dark": "#262a31", "forge-light": "#e4e7eb", "forge-high-contrast": "#1c1c1c" },
		"color.input": { "forge-dark": "#262a31", "forge-light": "#ffffff", "forge-high-contrast": "#000000" },
		"color.border": { "forge-dark": "#2b3038", "forge-light": "#dadee3", "forge-high-contrast": "#5fd3c2" },
		"color.muted": { "forge-dark": "#8e959f", "forge-light": "#5e656e", "forge-high-contrast": "#c4c4c4" },
		"color.error": { "forge-dark": "#ee5d58", "forge-light": "#cf3a24", "forge-high-contrast": "#ff8a80" },
		"color.warning": { "forge-dark": "#d4a63a", "forge-light": "#a87908", "forge-high-contrast": "#e8c547" },
		"color.info": { "forge-dark": "#5aaedb", "forge-light": "#1d7cad", "forge-high-contrast": "#6cc4ef" },
		"color.widget": { "forge-dark": "#21252c", "forge-light": "#f5f6f8", "forge-high-contrast": "#061a18" },
		"color.text": { "forge-dark": "#cdd1d8", "forge-light": "#2f343b", "forge-high-contrast": "#ffffff" },
		"syntax.keyword": { "forge-dark": "#e07b9a", "forge-light": "#b4245a", "forge-high-contrast": "#ff93b4" },
		"syntax.type": { "forge-dark": "#7cc4d6", "forge-light": "#12708a", "forge-high-contrast": "#8fe3f2" },
		"syntax.string": { "forge-dark": "#cdb46e", "forge-light": "#876b12", "forge-high-contrast": "#ead68c" },
		"syntax.number": { "forge-dark": "#b49cf0", "forge-light": "#6b46c1", "forge-high-contrast": "#cbb8ff" },
		"syntax.comment": { "forge-dark": "#6e8572", "forge-light": "#5f7a63", "forge-high-contrast": "#92bb97" },
		"syntax.heading": { "forge-dark": "#e07b9a", "forge-light": "#b4245a", "forge-high-contrast": "#ff93b4" }
	},

	"state": {
		"theme": "forge-dark",
		"themes": [
			{ "id": "forge-dark", "name": "Forge Dark", "type": "dark" },
			{ "id": "forge-light", "name": "Forge Light", "type": "light" },
			{ "id": "forge-high-contrast", "name": "Forge High Contrast", "type": "hc" }
		],
		"imported": null,
		"importedFile": "",
		"themeSources": [
			{ "token": "titleBar", "keys": ["titleBar.activeBackground", "editorGroupHeader.tabsBackground"], "dark": "#3c3c3c", "light": "#dddddd", "hc": "#000000" },
			{ "token": "activityBar", "keys": ["activityBar.background", "sideBar.background"], "dark": "#333333", "light": "#2c2c2c", "hc": "#000000" },
			{ "token": "sideBar", "keys": ["sideBar.background", "editor.background"], "dark": "#252526", "light": "#f3f3f3", "hc": "#000000" },
			{ "token": "editor", "keys": ["editor.background"], "dark": "#1e1e1e", "light": "#ffffff", "hc": "#000000" },
			{ "token": "editorText", "keys": ["editor.foreground", "foreground"], "dark": "#d4d4d4", "light": "#000000", "hc": "#ffffff" },
			{ "token": "tabs", "keys": ["editorGroupHeader.tabsBackground", "tab.inactiveBackground"], "dark": "#252526", "light": "#f3f3f3", "hc": "#000000" },
			{ "token": "tabActive", "keys": ["tab.activeBackground", "editor.background"], "dark": "#1e1e1e", "light": "#ffffff", "hc": "#000000" },
			{ "token": "panel", "keys": ["panel.background", "editor.background"], "dark": "#1e1e1e", "light": "#ffffff", "hc": "#000000" },
			{ "token": "statusBar", "keys": ["statusBar.background"], "dark": "#007acc", "light": "#007acc", "hc": "#000000" },
			{ "token": "statusText", "keys": ["statusBar.foreground"], "dark": "#ffffff", "light": "#ffffff", "hc": "#ffffff" },
			{ "token": "accent", "keys": ["focusBorder", "activityBarBadge.background", "button.background"], "dark": "#007fd4", "light": "#0090f1", "hc": "#f38518" },
			{ "token": "selection", "keys": ["list.activeSelectionBackground", "editor.selectionBackground"], "dark": "#04395e", "light": "#0060c0", "hc": "#000000" },
			{ "token": "hover", "keys": ["list.hoverBackground"], "dark": "#2a2d2e", "light": "#e8e8e8", "hc": "#000000" },
			{ "token": "input", "keys": ["input.background", "dropdown.background"], "dark": "#3c3c3c", "light": "#ffffff", "hc": "#000000" },
			{ "token": "border", "keys": ["panel.border", "editorGroup.border", "contrastBorder"], "dark": "#454545", "light": "#d4d4d4", "hc": "#6fc3df" },
			{ "token": "muted", "keys": ["descriptionForeground", "tab.inactiveForeground"], "dark": "#8b8b8b", "light": "#717171", "hc": "#ffffff" },
			{ "token": "error", "keys": ["editorError.foreground", "errorForeground"], "dark": "#f14c4c", "light": "#e51400", "hc": "#f48771" },
			{ "token": "warning", "keys": ["editorWarning.foreground"], "dark": "#cca700", "light": "#bf8803", "hc": "#cca700" },
			{ "token": "info", "keys": ["editorInfo.foreground"], "dark": "#3794ff", "light": "#1a85ff", "hc": "#3794ff" },
			{ "token": "widget", "keys": ["editorWidget.background", "quickInput.background"], "dark": "#252526", "light": "#f3f3f3", "hc": "#0c141f" },
			{ "token": "text", "keys": ["foreground", "sideBar.foreground", "editor.foreground"], "dark": "#cccccc", "light": "#616161", "hc": "#ffffff" }
		],
		"iconTheme": {
			"file": { "icon": "file", "color": "#98a0a9" },
			"folder": { "icon": "folder", "color": "#d1a35e" },
			"extensions": {
				"c": { "icon": "file-code", "color": "#5ea7cf" },
				"cpp": { "icon": "file-code", "color": "#5ea7cf" },
				"h": { "icon": "file-code", "color": "#b48ad8" },
				"hpp": { "icon": "file-code", "color": "#b48ad8" },
				"json": { "icon": "braces", "color": "#d4b84a" },
				"md": { "icon": "file-text", "color": "#5ea7cf" },
				"txt": { "icon": "file-text", "color": "#98a0a9" },
				"cmake": { "icon": "hammer", "color": "#7f9198" },
				"py": { "icon": "file-code", "color": "#4c88bd" },
				"js": { "icon": "file-code", "color": "#d4b84a" },
				"ts": { "icon": "file-code", "color": "#5ea7cf" },
				"sh": { "icon": "file-terminal", "color": "#6a8a74" }
			},
			"names": {
				"CMakeLists.txt": { "icon": "hammer", "color": "#7f9198" },
				"README.md": { "icon": "info", "color": "#5ea7cf" },
				"LICENSE": { "icon": "file-text", "color": "#d4b84a" }
			}
		}
	},

	"actions": {
		"pickTheme": { "title": "Color Theme", "category": "Preferences", "icon": "palette",
			"description": "Choose the workbench's colour theme.",
			"do": [{ "set": "state.quickPick.open", "to": true }, { "set": "state.quickPick.query", "to": "theme " }] },
		"setTheme": [{ "set": "state.theme", "to": "{{item.id}}" }],
		"importTheme": { "title": "Import Color Theme...", "category": "Preferences", "icon": "palette",
			"description": "Read a colour theme (.json) and add it as a theme.",
			"do": [{ "openFile": "state.imported", "comments": true, "title": "Import Color Theme", "extensions": ["json"],
				"onDone": [{ "set": "state.importedFile", "to": "{{result.name}}" }, { "run": "readTheme" }],
				"onError": [{ "run": "notify", "with": { "severity": "info", "message": "{{'Theme not imported: ' + error.message}}" } }] }] },
		"readTheme": [
			{ "note": "The colour theme read into state.imported: its name (else its file's), its type and its colours" },
			{ "run": "readThemeOf", "with": { "theme": "{{state.imported}}", "file": "{{state.importedFile}}" } }
		],
		"readThemeOf": [
			{ "if": "{{type(theme) != 'object'}}",
				"then": [{ "run": "notify", "with": { "severity": "info", "message": "Theme not imported: not a colour theme: the file isn't a JSON object" } }],
				"else": [{ "run": "addTheme", "with": {
					"name": "{{type(theme.name) == 'string' ? theme.name : (slice(file, -5) == '.json' ? slice(file, 0, -5) : file)}}",
					"kind": "{{type(theme.type) != 'string' ? 'dark' : theme.type == 'light' || theme.type == 'vs' ? 'light' : slice(theme.type, 0, 2) == 'hc' || theme.type == 'high-contrast' ? 'hc' : 'dark'}}",
					"colors": "{{type(theme.colors) == 'object' ? theme.colors : null}}" } }] }
		],
		"addTheme": [
			{ "note": "Each token takes the first of its keys the theme gives a colour, else its default for the theme's kind; the theme's id is made of its name" },
			{ "run": "addThemeAs", "with": { "id": "{{slug(name, 40) || 'imported'}}", "name": "{{name}}", "kind": "{{kind}}",
				"type": "{{kind == 'light' ? 'light' : 'dark'}}",
				"values": "{{map(state.themeSources, {token: it.token, value: find(map(it.keys, hexColor(colors[it])), it != null) ?? it[kind]})}}" } }
		],
		"addThemeAs": [
			{ "patch": "{{map(values, {op: 'add', path: '/tokens/color.' + it.token + '/' + id, value: it.value})}}", "message": "{{'Import the ' + name + ' theme'}}" },
			{ "set": "state.themes", "to": "{{concat(filter(state.themes, it.id != id), [{id: id, name: name, type: type}])}}" },
			{ "set": "state.theme", "to": "{{id}}" },
			{ "run": "notify", "with": { "severity": "info", "message": "{{'Imported the ' + name + ' theme'}}" } }
		],
		"toggleIcons": { "title": "Toggle File Icons", "category": "Preferences", "icon": "file",
			"do": [{ "set": "settings.workbench.fileIcons", "to": "{{!settings.workbench.fileIcons}}" },
			       { "run": "reindex" }] }
	},

	"settings": {
		"workbench.fileIcons": { "type": "boolean", "default": true, "title": "File icons",
			"description": "Show the file icon theme's icons in the explorer." }
	},

	"menus": {
		"preferences": {
			"theme": { "run": "pickTheme", "group": "2_themes", "order": 1 },
			"importTheme": { "run": "importTheme", "group": "2_themes", "order": 2 },
			"icons": { "run": "toggleIcons", "group": "2_themes", "order": 3 }
		}
	}
}
