{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's themes: every colour of the workbench is a token with one variant per theme, so a theme is a set of values and switching is one state change. Importing a VS Code colour theme adds a variant to each token through a patch. The file icon theme maps names and extensions to icons, applied by forge.index.",

	"tokens": {
		"color.titleBar": { "forge-dark": "#1f1f1f", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.activityBar": { "forge-dark": "#181818", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.sideBar": { "forge-dark": "#181818", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.editor": { "forge-dark": "#1f1f1f", "forge-light": "#ffffff", "forge-high-contrast": "#000000" },
		"color.editorText": { "forge-dark": "#cccccc", "forge-light": "#3b3b3b", "forge-high-contrast": "#ffffff" },
		"color.tabs": { "forge-dark": "#181818", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.tabActive": { "forge-dark": "#1f1f1f", "forge-light": "#ffffff", "forge-high-contrast": "#000000" },
		"color.panel": { "forge-dark": "#181818", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.statusBar": { "forge-dark": "#181818", "forge-light": "#f8f8f8", "forge-high-contrast": "#000000" },
		"color.statusText": { "forge-dark": "#cccccc", "forge-light": "#3b3b3b", "forge-high-contrast": "#ffffff" },
		"color.accent": { "forge-dark": "#0078d4", "forge-light": "#005fb8", "forge-high-contrast": "#f38518" },
		"color.selection": { "forge-dark": "#264f78", "forge-light": "#add6ff", "forge-high-contrast": "#0f4a85" },
		"color.hover": { "forge-dark": "#2a2d2e", "forge-light": "#f2f2f2", "forge-high-contrast": "#262626" },
		"color.input": { "forge-dark": "#313131", "forge-light": "#ffffff", "forge-high-contrast": "#000000" },
		"color.border": { "forge-dark": "#2b2b2b", "forge-light": "#e5e5e5", "forge-high-contrast": "#6fc3df" },
		"color.muted": { "forge-dark": "#9d9d9d", "forge-light": "#616161", "forge-high-contrast": "#c0c0c0" },
		"color.error": { "forge-dark": "#f85149", "forge-light": "#e51400", "forge-high-contrast": "#f48771" },
		"color.warning": { "forge-dark": "#cca700", "forge-light": "#bf8803", "forge-high-contrast": "#cca700" },
		"color.info": { "forge-dark": "#3794ff", "forge-light": "#1a85ff", "forge-high-contrast": "#3794ff" },
		"color.widget": { "forge-dark": "#202020", "forge-light": "#f8f8f8", "forge-high-contrast": "#0c141f" },
		"color.text": { "forge-dark": "#cccccc", "forge-light": "#3b3b3b", "forge-high-contrast": "#ffffff" },
		"syntax.keyword": { "forge-dark": "#569cd6", "forge-light": "#0000ff", "forge-high-contrast": "#569cd6" },
		"syntax.type": { "forge-dark": "#4ec9b0", "forge-light": "#267f99", "forge-high-contrast": "#4ec9b0" },
		"syntax.string": { "forge-dark": "#ce9178", "forge-light": "#a31515", "forge-high-contrast": "#ce9178" },
		"syntax.number": { "forge-dark": "#b5cea8", "forge-light": "#098658", "forge-high-contrast": "#b5cea8" },
		"syntax.comment": { "forge-dark": "#6a9955", "forge-light": "#008000", "forge-high-contrast": "#7ca668" },
		"syntax.heading": { "forge-dark": "#569cd6", "forge-light": "#800000", "forge-high-contrast": "#6796e6" }
	},

	"state": {
		"theme": "forge-dark",
		"themes": [
			{ "id": "forge-dark", "name": "Forge Dark", "type": "dark" },
			{ "id": "forge-light", "name": "Forge Light", "type": "light" },
			{ "id": "forge-high-contrast", "name": "Forge High Contrast", "type": "hc" }
		],
		"imported": null,
		"iconTheme": {
			"file": { "icon": "file", "color": "#9d9d9d" },
			"folder": { "icon": "folder", "color": "#dcb67a" },
			"extensions": {
				"c": { "icon": "file-code", "color": "#519aba" },
				"cpp": { "icon": "file-code", "color": "#519aba" },
				"h": { "icon": "file-code", "color": "#a074c4" },
				"hpp": { "icon": "file-code", "color": "#a074c4" },
				"json": { "icon": "braces", "color": "#cbcb41" },
				"md": { "icon": "file-text", "color": "#519aba" },
				"txt": { "icon": "file-text", "color": "#9d9d9d" },
				"cmake": { "icon": "hammer", "color": "#6d8086" },
				"py": { "icon": "file-code", "color": "#3c78aa" },
				"js": { "icon": "file-code", "color": "#cbcb41" },
				"ts": { "icon": "file-code", "color": "#519aba" },
				"sh": { "icon": "file-terminal", "color": "#4d5a5e" }
			},
			"names": {
				"CMakeLists.txt": { "icon": "hammer", "color": "#6d8086" },
				"README.md": { "icon": "info", "color": "#519aba" },
				"LICENSE": { "icon": "file-text", "color": "#cbcb41" }
			}
		}
	},

	"actions": {
		"pickTheme": { "title": "Color Theme", "category": "Preferences", "icon": "palette",
			"description": "Choose the workbench's colour theme.",
			"do": [{ "set": "state.quickPick.open", "to": true }, { "set": "state.quickPick.query", "to": "theme " }] },
		"setTheme": [{ "set": "state.theme", "to": "{{item.id}}" }],
		"importTheme": { "title": "Import VS Code Color Theme...", "category": "Preferences", "icon": "palette",
			"description": "Read a VS Code colour theme (.json) and add it as a theme.",
			"do": [{ "call": "forge.importTheme", "into": "state.imported",
				"onError": [{ "run": "notify", "with": { "severity": "info", "message": "{{'Theme not imported: ' + error}}" } }],
				"then": [
					{ "patch": "{{result.patch}}", "message": "{{'Import the ' + result.name + ' theme'}}" },
					{ "set": "state.themes", "to": "{{concat(filter(state.themes, it.id != result.id), [{id: result.id, name: result.name, type: result.type}])}}" },
					{ "set": "state.theme", "to": "{{result.id}}" },
					{ "run": "notify", "with": { "severity": "info", "message": "{{'Imported the ' + result.name + ' theme'}}" } }
				] }] },
		"toggleIcons": { "title": "Toggle File Icons", "category": "Preferences", "icon": "file",
			"do": [{ "set": "settings.workbench.fileIcons", "to": "{{!settings.workbench.fileIcons}}" },
			       { "run": "reindex" }] }
	},

	"settings": {
		"workbench.fileIcons": { "type": "boolean", "default": true, "title": "File icons",
			"description": "Show the file icon theme's icons in the explorer." }
	},

	"menus": {
		"preferences": {
			"theme": { "run": "pickTheme", "group": "2_themes", "order": 1 },
			"importTheme": { "run": "importTheme", "group": "2_themes", "order": 2 },
			"icons": { "run": "toggleIcons", "group": "2_themes", "order": 3 }
		}
	}
}
