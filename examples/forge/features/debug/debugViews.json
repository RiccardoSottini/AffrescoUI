{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The debugger's views (debug.json has the logic; the source page's actions are here): the Run and Debug side bar (configurations, variables, watches, the call stack and the breakpoints), the Debug Console panel, the floating toolbar and the dialogs, and the read-only page for a source outside the open folder.",

	"actions": {
		"debugOpenOutside": [
			{ "if": "{{state.debug.outside.frame != null}}",
			  "then": [{ "run": "debugRequest", "with": { "command": "source", "answer": "debugOnSource", "refused": "debugOnSourceRefused",
				"context": "{{ {frame: state.debug.outside.frame} }}",
				"arguments": "{{ {source: merge(empty(state.debug.outside.frame.path) ? {} : {path: state.debug.outside.frame.path}, {sourceReference: state.debug.outside.frame.reference}), sourceReference: state.debug.outside.frame.reference} }}" } }] }
		],
		"debugOnSource": [
			{ "run": "debugShowSource", "with": { "id": "{{'debug-source:' + (empty(context.frame.path) ? 'ref:' + context.frame.reference : context.frame.path)}}",
			  "label": "{{(empty(context.frame.path) ? context.frame.name : reverse(split(context.frame.path, '/'))[0]) + ' (read-only)'}}", "content": "{{slice(text(body.content ?? ''), 0, 4194304)}}" } }
		],
		"debugOnSourceRefused": [
			{ "run": "notify", "with": { "severity": "info", "message": "{{'The debugger has no source for this frame: ' + message}}" } }
		],
		"debugShowSource": [
			{ "set": "state.docs", "to": "{{filter(state.docs, it.id != id)}}" },
			{ "push": "state.docs", "value": "{{ {id: id, label: label, kind: 'debugSource', text: content, dirty: false, language: ''} }}" },
			{ "run": "showTab", "with": { "id": "{{id}}", "label": "{{label}}" } }
		],
		"debugApplySource": [{ "run": "debugShowSource", "with": { "id": "{{'debug-source:' + event.path}}", "label": "{{event.label}}", "content": "{{event.content}}" } }]
	},

	"components": {
		"forgeDebugView": {
			"node": {
				"type": "column", "id": "debug-view", "width": "100%", "grow": 1, "color": "@color.sideBar", "gap": 2,
				"children": [
					{ "type": "row", "id": "debug-head", "width": "100%", "height": 35, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "debug-title", "text": "RUN AND DEBUG", "textColor": "@color.muted", "grow": 1, "height": 35, "padding": 12 },
						{ "type": "label", "id": "debug-start", "icon": "play", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "{{state.debug.status == 'inactive' ? '#89d185' : '@color.muted'}}", "tooltip": "Start Debugging (F5)",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugContinueOrStart" } },
						{ "type": "label", "id": "debug-reload", "icon": "refresh-cw", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Reload .forge/launch.json",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugLoadConfigurations" } }
					  ] },
					{ "type": "column", "id": "debug-empty", "when": "{{length(state.debug.configurations) == 0 && empty(state.debug.error) && state.debug.status == 'inactive'}}",
					  "width": "100%", "height": 124, "gap": 10, "children": [
						{ "id": "debug-empty-top", "height": 4 },
						{ "use": "forgeInset", "height": 28, "children": [
							{ "type": "label", "id": "debug-empty-start", "role": "button", "label": "Run and Debug", "text": "Run and Debug", "grow": 1,
							  "height": 28, "align": "center", "radius": 2, "cursor": "hand", "focusable": true, "color": "@color.accent",
							  "textColor": "#ffffff", "onClick": { "run": "debugContinueOrStart" } } ] },
						{ "type": "label", "id": "debug-empty-text", "wrap": true, "width": "100%", "height": 70, "padding": 12, "textColor": "@color.text",
						  "text": "{{'To choose what runs, add a configuration of type lldb or python to ' + (empty(state.folder.root) ? 'the open folder' : 'this folder') + '\\'s .forge/launch.json.' + (state.debug.skipped > 0 ? ' ' + plural(state.debug.skipped, 'configuration') + ' Forge can\\'t run were left out.' : '')}}" }
					  ] },
					{ "type": "label", "id": "debug-error", "when": "{{!empty(state.debug.error)}}", "icon": "circle-x", "wrap": true,
					  "width": "100%", "padding": 8, "textColor": "@color.text", "text": "{{state.debug.error}}" },
					{ "type": "list", "id": "debug-configurations", "when": "{{length(state.debug.configurations) > 0}}", "width": "100%",
					  "height": "{{min(4, length(state.debug.configurations)) * 22}}", "items": "{{computed.debugConfigurationRows}}",
					  "bind": "state.debug.selected", "rowHeight": 22, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "onOpen": { "run": "debugStart" } },
					{ "type": "label", "id": "debug-status", "when": "{{state.debug.status != 'inactive'}}", "width": "100%", "height": 22,
					  "padding": 8, "icon": "bug", "textColor": "{{state.debug.status == 'stopped' ? '#e5c07b' : '@color.muted'}}",
					  "text": "{{state.debug.status == 'stopped' ? 'Paused on ' + state.debug.reason : state.debug.status == 'starting' ? 'Starting…' : 'Running'}}" },

					{ "type": "row", "id": "debug-variables-head", "width": "100%", "height": 22, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "debug-variables-title", "icon": "chevron-down", "text": "VARIABLES", "textColor": "@color.text", "grow": 1, "height": 22, "padding": 4 },
						{ "type": "label", "id": "debug-set-value", "icon": "pencil", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Set Value", "hover": { "textColor": "@color.text" },
						  "onClick": { "run": "debugEditValue" } }
					  ] },
					{ "type": "list", "id": "debug-variables", "width": "100%", "grow": 2, "font": "code", "items": "{{computed.debugVariableRows}}",
					  "bind": "state.debug.selectedVariable", "rowHeight": 20, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "onOpen": { "run": "debugExpand", "with": { "path": "{{event.id}}" } } },

					{ "type": "row", "id": "debug-watch-head", "width": "100%", "height": 22, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "debug-watch-title", "icon": "chevron-down", "text": "WATCH", "textColor": "@color.text", "grow": 1, "height": 22, "padding": 4 },
						{ "type": "label", "id": "debug-watch-remove", "icon": "x", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Remove the selected expression", "hover": { "textColor": "@color.text" },
						  "onClick": { "run": "debugRemoveWatch" } }
					  ] },
					{ "type": "textarea", "id": "debug-watch-input", "width": "100%", "height": 24, "padding": 5, "color": "@color.input",
					  "textColor": "@color.text", "placeholderColor": "@color.muted", "bind": "state.debug.watchDraft",
					  "placeholder": "Expression to watch (Enter)", "onSubmit": { "run": "debugAddWatch" } },
					{ "type": "list", "id": "debug-watches", "width": "100%", "grow": 1, "font": "code", "items": "{{computed.debugWatchRows}}",
					  "bind": "state.debug.selectedWatch", "rowHeight": 20, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent" },

					{ "type": "label", "id": "debug-stack-title", "icon": "chevron-down", "text": "CALL STACK", "width": "100%", "height": 22, "textColor": "@color.text",
					  "padding": 4 },
					{ "type": "list", "id": "debug-stack", "width": "100%", "grow": 1, "items": "{{computed.debugStackRows}}",
					  "bind": "state.debug.selectedStack", "rowHeight": 22, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "onChange": { "run": "debugSelectStack", "with": { "id": "{{event.value ?? ''}}" } } },

					{ "type": "row", "id": "debug-breakpoints-head", "width": "100%", "height": 22, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "debug-breakpoints-title", "icon": "chevron-down", "text": "BREAKPOINTS", "textColor": "@color.text", "grow": 1, "height": 22, "padding": 4 },
						{ "type": "label", "id": "debug-breakpoint-edit", "icon": "pencil", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Edit Condition, Hit Count or Log Message",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugEditSelectedBreakpoint" } },
						{ "type": "label", "id": "debug-breakpoint-enable", "icon": "circle-off", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Enable or Disable the selected breakpoint",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugToggleSelectedEnabled" } },
						{ "type": "label", "id": "debug-breakpoint-remove", "icon": "x", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Remove the selected breakpoint",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugRemoveBreakpoint" } },
						{ "type": "label", "id": "debug-breakpoint-remove-all", "icon": "list-x", "padding": 4, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Remove All Breakpoints",
						  "hover": { "textColor": "@color.text" }, "onClick": { "run": "debugRemoveAllBreakpoints" } }
					  ] },
					{ "type": "label", "id": "debug-filter", "repeat": { "for": "f", "in": "state.debug.exceptionFilters", "key": "{{f.filter}}" },
					  "width": "100%", "height": 22, "padding": 8, "cursor": "hand", "textColor": "@color.text",
					  "icon": "{{f.enabled ? 'square-check' : 'square'}}", "text": "{{f.label}}",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "debugToggleFilter", "with": { "filter": "{{f.filter}}" } } },
					{ "type": "list", "id": "debug-breakpoints", "width": "100%", "grow": 1, "items": "{{computed.debugBreakpointRows}}",
					  "bind": "state.debug.selectedBreakpoint", "rowHeight": 22, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "onOpen": { "run": "debugOpenBreakpoint" } }
				]
			}
		},

		"forgeDebugConsole": {
			"node": {
				"type": "column", "id": "debug-console", "width": "100%", "grow": 1, "color": "@color.panel",
				"children": [
					{ "type": "list", "id": "debug-console-lines", "width": "100%", "grow": 1, "font": "code",
					  "items": "{{computed.debugConsoleRows}}", "rowHeight": 18, "color": "@color.panel", "textColor": "@color.text",
					  "selectedTextColor": "@color.text", "selectedBackground": "@color.selection", "accentColor": "@color.accent" },
					{ "type": "label", "id": "debug-completions", "when": "{{length(state.debug.completions) > 1}}", "width": "100%",
					  "height": 20, "padding": 4, "font": "code", "textColor": "@color.muted", "text": "{{join(state.debug.completions, '  ')}}" },
					{ "type": "row", "id": "debug-console-input-row", "width": "100%", "height": 26, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "debug-console-prompt", "icon": "chevron-right", "padding": 4, "fitText": true,
						  "textColor": "#3794ff" },
						{ "type": "textarea", "id": "debug-console-input", "grow": 1, "height": 24, "padding": 5, "font": "code",
						  "color": "@color.input", "textColor": "@color.text", "placeholderColor": "@color.muted", "bind": "state.debug.input",
						  "placeholder": "{{state.debug.status == 'inactive' ? 'Start a debug session to evaluate expressions' : 'Evaluate (Enter; Up and Down for history; Tab to complete)'}}",
						  "onSubmit": { "run": "debugEvaluate" },
						  "keys": { "up": "debugHistoryBack", "down": "debugHistoryForward", "tab": "debugComplete" } },
						{ "type": "label", "id": "debug-console-clear", "icon": "trash-2", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "@color.muted", "tooltip": "Clear Console", "hover": { "textColor": "@color.text" },
						  "onClick": { "run": "debugClearConsole" } }
					  ] }
				]
			}
		},

		"forgeDebugOverlays": {
			"node": {
				"type": "column", "id": "debug-overlays",
				"children": [
					{ "type": "row", "id": "debug-toolbar", "color": "@color.sideBar", "borderWidth": 1, "borderColor": "@color.border",
					  "radius": 4, "gap": 2, "height": 30,
					  "anchors": { "top": 40, "right": 220 },
					  "overlay": { "placement": "window", "open": "{{state.debug.status != 'inactive'}}" },
					  "children": [
						{ "type": "label", "id": "debug-toolbar-continue", "icon": "{{state.debug.status == 'stopped' ? 'play' : 'pause'}}",
						  "padding": 6, "fitText": true, "cursor": "hand", "textColor": "#89d185",
						  "tooltip": "{{state.debug.status == 'stopped' ? 'Continue (F5)' : 'Pause (F6)'}}", "hover": { "color": "@color.hover" },
						  "onClick": { "run": "{{state.debug.status == 'stopped' ? 'debugContinue' : 'debugPause'}}" } },
						{ "type": "label", "id": "debug-toolbar-over", "icon": "redo-dot", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "{{state.debug.status == 'stopped' ? '#3794ff' : '@color.muted'}}", "tooltip": "Step Over (F10)",
						  "hover": { "color": "@color.hover" }, "onClick": { "run": "debugStepOver" } },
						{ "type": "label", "id": "debug-toolbar-into", "icon": "arrow-down-to-dot", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "{{state.debug.status == 'stopped' ? '#3794ff' : '@color.muted'}}", "tooltip": "Step Into (F11)",
						  "hover": { "color": "@color.hover" }, "onClick": { "run": "debugStepInto" } },
						{ "type": "label", "id": "debug-toolbar-out", "icon": "arrow-up-from-dot", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "{{state.debug.status == 'stopped' ? '#3794ff' : '@color.muted'}}", "tooltip": "Step Out (Shift+F11)",
						  "hover": { "color": "@color.hover" }, "onClick": { "run": "debugStepOut" } },
						{ "type": "label", "id": "debug-toolbar-restart", "icon": "rotate-ccw", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "#89d185", "tooltip": "Restart (Cmd+Shift+F5)", "hover": { "color": "@color.hover" },
						  "onClick": { "run": "debugRestart" } },
						{ "type": "label", "id": "debug-toolbar-stop", "icon": "square", "padding": 6, "fitText": true, "cursor": "hand",
						  "textColor": "#f48771", "tooltip": "Stop (Shift+F5)", "hover": { "color": "@color.hover" },
						  "onClick": { "run": "debugStop" } }
					  ] },
					{ "use": "dialog", "id": "debug-edit-dialog",
					  "with": { "open": "state.debug.edit.open", "height": 230, "title": "Edit Breakpoint",
					            "message": "", "buttons": [{ "title": "OK", "run": "debugSaveBreakpoint" }, { "title": "Cancel" }] },
					  "children": [
						{ "type": "textarea", "id": "debug-edit-condition", "bind": "state.debug.edit.condition", "autofocus": true,
						  "anchors": { "left": 20, "right": 20, "top": 48 }, "height": 28, "padding": 7, "font": "code", "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted", "placeholder": "Condition: break when it is true",
						  "onSubmit": { "run": "debugSaveBreakpoint" } },
						{ "type": "textarea", "id": "debug-edit-hits", "bind": "state.debug.edit.hitCondition",
						  "anchors": { "left": 20, "right": 20, "top": 84 }, "height": 28, "padding": 7, "font": "code", "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted", "placeholder": "Hit count: break when it is reached",
						  "onSubmit": { "run": "debugSaveBreakpoint" } },
						{ "type": "textarea", "id": "debug-edit-log", "bind": "state.debug.edit.logMessage",
						  "anchors": { "left": 20, "right": 20, "top": 120 }, "height": 28, "padding": 7, "font": "code", "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted",
						  "placeholder": "Log message: log it instead of breaking; {expression} inserts a value",
						  "onSubmit": { "run": "debugSaveBreakpoint" } }
					  ] },
					{ "use": "dialog", "id": "debug-value-dialog",
					  "with": { "open": "state.debug.setValue.open", "height": 150, "title": "{{'Set Value of ' + state.debug.setValue.name}}",
					            "message": "", "buttons": [{ "title": "Set", "run": "debugSetValue" }, { "title": "Cancel" }] },
					  "children": [
						{ "type": "textarea", "id": "debug-value", "bind": "state.debug.setValue.value", "autofocus": true,
						  "anchors": { "left": 20, "right": 20, "top": 48 }, "height": 28, "padding": 7, "font": "code", "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted", "placeholder": "New value",
						  "onSubmit": { "run": "debugSetValue" } }
					  ] },
					{ "use": "dialog", "id": "debug-outside-dialog",
					  "with": { "open": "state.debug.outside.open", "title": "Open a source outside the folder?",
					            "message": "{{'The debugger stopped in ' + (state.debug.outside.frame.path || state.debug.outside.frame.name || 'a frame') + ', outside the open folder. Forge asks the debugger for its text and shows it read-only.'}}",
					            "buttons": [{ "title": "Open", "run": "debugOpenOutside" }, { "title": "Cancel" }] } }
				]
			}
		},

		"forgeDebugSource": {
			"params": { "doc": {} },
			"node": {
				"type": "column", "id": "debug-source", "width": "100%", "grow": 1, "color": "@color.editor",
				"children": [
					{ "type": "label", "id": "debug-source-note", "width": "100%", "height": 22, "padding": 6, "icon": "file-code",
					  "textColor": "@color.muted", "text": "Read-only: the debugger's text of a source outside the open folder" },
					{ "type": "list", "id": "debug-source-lines", "width": "100%", "grow": 1, "font": "code", "rowHeight": 18,
					  "items": "{{map(slice(split(doc.text ?? '', '\n'), 0, 20000), {id: text(index + 1), label: pad(text(index + 1), 6) + (state.debug.current.path == doc.id && state.debug.current.line == index + 1 ? ' → ' : '   ') + it})}}",
					  "color": "@color.editor", "textColor": "@color.editorText", "selectedTextColor": "@color.text",
					  "selectedBackground": "@color.selection", "accentColor": "@color.accent" }
				]
			}
		}
	}
}
