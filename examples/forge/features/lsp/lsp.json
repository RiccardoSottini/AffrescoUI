{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's language server: the lsp service (clangd, granted by the host when it finds it) for C and C++ files; the service speaks the protocol (initialize, open documents, positions) and answers in small shapes counted from 0. This file asks it at the caret, keeps it told of the text being edited, and shows the answers: diagnostics as squiggles and in Problems, a hover card, completion and signature help at the caret, a peek list for definitions and references, a reviewed list of edits for rename and formatting, and symbols in a quick pick ('@' this file, '#' the workspace). With no server, the editor works as before. Positions shown and gone to count from 1",

	"state": {
		"lsp": {
			"request": 0,
			"languages": { "c": "c", "h": "cpp", "cc": "cpp", "cpp": "cpp", "cxx": "cpp", "hh": "cpp", "hpp": "cpp", "hxx": "cpp",
			               "m": "objective-c", "mm": "objective-cpp" },
			"open": [],
			"listening": false,
			"files": [],
			"hover": { "open": false, "text": "", "x": 0, "y": 0, "request": 0 },
			"at": { "x": 0, "y": 0, "top": 0 },
			"completion": { "open": false, "items": [], "word": "", "index": 0, "request": 0 },
			"insert": { "text": "", "before": 0, "request": 0 },
			"signature": { "open": false, "label": "", "documentation": "" },
			"peek": { "open": false, "title": "", "items": [], "index": 0 },
			"review": { "open": false, "kind": "", "edits": [], "files": 0, "truncated": false },
			"rename": { "open": false, "name": "" },
			"symbols": []
		},
		"symbolPick": { "open": false, "query": "" }
	},

	"computed": {
		"lspLanguage": "{{computed.activeDoc == null || computed.activeDoc.kind != 'file' ? null : state.lsp.languages[lower(reverse(split(computed.activeDoc.id, '.'))[0])] ?? null}}",
		"lspCompletions": "{{fuzzySort(state.lsp.completion.items, state.lsp.completion.word, 'filter', 50)}}",
		"lspSymbolItems": "{{map(state.lsp.symbols, {title: slice('                ', 0, 2 * it.depth) + it.name, detail: it.kind + (empty(it.detail) ? '' : ' ' + it.detail) + (slice(state.symbolPick.query, 0, 1) == '#' ? ' — ' + it.path : ''), name: it.name, path: it.path, line: it.line, column: it.column})}}",
		"lspPeekRows": "{{map(state.lsp.peek.items, {id: index, cells: [reverse(split(it.path, '/'))[0] + ':' + (it.line + 1), it.path, it.line + 1]})}}"
	},

	"services": {
		"lsp": { "provider": "lsp", "process": "clangd", "root": "workspace", "language": "cpp", "start": "onDemand",
		         "restart": { "times": 3, "after": 1000 } }
	},

	"actions": {
		"lspAsk": [
			{ "note": "Asks the server about the active file, its text sent along (the service keeps the version when it is unchanged). line, column: from 0, or null for the caret's" },
			{ "increment": "state.lsp.request", "by": 1 },
			{ "if": "{{computed.lspLanguage != null}}",
			  "then": [
				{ "run": "lspListen" },
				{ "run": "lspCall", "with": { "kind": "{{kind}}", "request": "{{state.lsp.request}}",
				  "path": "{{kind == 'workspaceSymbols' ? '' : computed.activeDoc.id}}",
				  "arguments": "{{kind == 'workspaceSymbols' ? {query: query ?? ''} : merge({path: computed.activeDoc.id, text: computed.activeDoc.text, language: computed.lspLanguage}, contains(['hover', 'completion', 'signature', 'definition', 'references', 'rename'], kind) ? {line: line ?? max(state.caret.line - 1, 0), column: column ?? max(state.caret.column - 1, 0)} : {}, kind == 'rename' ? {newName: newName} : {}, kind == 'format' ? {tabSize: 4, insertSpaces: true} : {})}}" } },
				{ "if": "{{kind != 'workspaceSymbols' && !contains(state.lsp.open, computed.activeDoc.id)}}",
				  "then": [{ "set": "state.lsp.open", "to": "{{slice(concat(state.lsp.open, [computed.activeDoc.id]), -256)}}" }] }
			  ] }
		],
		"lspCall": [
			{ "note": "One invoke per kind, as a step names its method written out; the silent kinds cancel their older call. Every answer goes to lspAnswer" },
			{ "if": "{{kind == 'hover'}}", "then": [{ "invoke": "lsp.hover", "with": "{{arguments}}", "id": "lsp-hover",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'completion'}}", "then": [{ "invoke": "lsp.completion", "with": "{{arguments}}", "id": "lsp-completion",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'signature'}}", "then": [{ "invoke": "lsp.signature", "with": "{{arguments}}", "id": "lsp-signature",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'tokens'}}", "then": [{ "invoke": "lsp.tokens", "with": "{{arguments}}", "id": "lsp-tokens",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'definition'}}", "then": [{ "invoke": "lsp.definition", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'references'}}", "then": [{ "invoke": "lsp.references", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'rename'}}", "then": [{ "invoke": "lsp.rename", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'format'}}", "then": [{ "invoke": "lsp.format", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'symbols'}}", "then": [{ "invoke": "lsp.symbols", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] },
			{ "if": "{{kind == 'workspaceSymbols'}}", "then": [{ "invoke": "lsp.workspaceSymbols", "with": "{{arguments}}",
				"onDone": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: result, error: null} }}" } }],
				"onError": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: kind, request: request, path: path, result: null, error: error} }}" } }] }] }
		],
		"lspListen": [
			{ "note": "The server's diagnostics, file by file, from its first request on (again after the stream ends)" },
			{ "if": "{{!state.lsp.listening}}",
			  "then": [
				{ "set": "state.lsp.listening", "to": true },
				{ "subscribe": "lsp.diagnostics", "id": "lsp-diagnostics",
				  "do": [{ "run": "lspPublished", "with": { "published": "{{event}}" } }],
				  "onError": [{ "set": "state.lsp.listening", "to": false }] }
			  ] }
		],
		"lspChanged": [
			{ "note": "id: an edited file. A file the server has open gets its new text once typing pauses, so its diagnostics follow" },
			{ "if": "{{contains(state.lsp.open, id)}}",
			  "then": [{ "debounce": 500, "do": [
				{ "forEach": "{{filter(state.docs, it.id == id && it.kind == 'file')}}", "as": "doc", "do": [
					{ "invoke": "lsp.sync", "with": { "path": "{{doc.id}}", "text": "{{doc.text}}",
					  "language": "{{state.lsp.languages[lower(reverse(split(doc.id, '.'))[0])] ?? 'cpp'}}" }, "onError": [] }
				] }
			  ] }] }
		],
		"lspClosed": [
			{ "note": "id: a file no longer open in Forge. The server reads it from disk again" },
			{ "if": "{{contains(state.lsp.open, id)}}",
			  "then": [
				{ "set": "state.lsp.open", "to": "{{filter(state.lsp.open, it != id)}}" },
				{ "invoke": "lsp.close", "with": { "path": "{{id}}" }, "onError": [] }
			  ] }
		],
		"lspHoverAt": [
			{ "if": "{{!event.over || computed.activeDoc == null}}",
			  "then": [{ "set": "state.lsp.hover.open", "to": false }],
			  "else": [
				{ "set": "state.lsp.at", "to": "{{ {x: event.x, y: event.y, top: event.top} }}" },
				{ "run": "lspAsk", "with": { "kind": "hover", "line": "{{event.line}}", "column": "{{event.column}}", "newName": null, "query": null } },
				{ "set": "state.lsp.hover.request", "to": "{{state.lsp.request}}" }
			  ] }
		],
		"lspTyped": [
			{ "set": "state.lsp.at", "to": "{{ {x: event.x, y: event.y, top: event.top} }}" },
			{ "set": "state.lsp.hover.open", "to": false },
			{ "set": "state.lsp.completion.word", "to": "{{event.word}}" },
			{ "set": "state.lsp.completion.index", "to": 0 },
			{ "if": "{{event.text == '(' || event.text == ','}}",
			  "then": [{ "run": "lspAsk", "with": { "kind": "signature", "line": "{{event.line}}", "column": "{{event.column}}", "newName": null, "query": null } }] },
			{ "if": "{{event.text == ')'}}", "then": [{ "set": "state.lsp.signature.open", "to": false }] },
			{ "if": "{{empty(event.word) && event.text != '.'}}",
			  "then": [{ "set": "state.lsp.completion.open", "to": false }],
			  "else": [
				{ "if": "{{event.text == '.' || length(event.word) == 1 || !state.lsp.completion.open}}",
				  "then": [
					{ "run": "lspAsk", "with": { "kind": "completion", "line": "{{event.line}}", "column": "{{event.column}}", "newName": null, "query": null } },
					{ "set": "state.lsp.completion.request", "to": "{{state.lsp.request}}" }
				  ] }
			  ] }
		],
		"lspPopupKey": [
			{ "if": "{{event.key == 'escape' || length(computed.lspCompletions) == 0}}",
			  "then": [{ "set": "state.lsp.completion.open", "to": false }] },
			{ "if": "{{event.key == 'down'}}",
			  "then": [{ "set": "state.lsp.completion.index", "to": "{{min(state.lsp.completion.index + 1, length(computed.lspCompletions) - 1)}}" }] },
			{ "if": "{{event.key == 'up'}}",
			  "then": [{ "set": "state.lsp.completion.index", "to": "{{max(state.lsp.completion.index - 1, 0)}}" }] },
			{ "if": "{{event.key == 'pageDown'}}",
			  "then": [{ "set": "state.lsp.completion.index", "to": "{{min(state.lsp.completion.index + 10, length(computed.lspCompletions) - 1)}}" }] },
			{ "if": "{{event.key == 'pageUp'}}",
			  "then": [{ "set": "state.lsp.completion.index", "to": "{{max(state.lsp.completion.index - 10, 0)}}" }] },
			{ "if": "{{(event.key == 'enter' || event.key == 'tab') && state.lsp.completion.open && length(computed.lspCompletions) > 0}}",
			  "then": [{ "run": "lspComplete", "with": { "index": "{{state.lsp.completion.index}}" } }] }
		],
		"lspComplete": [
			{ "set": "state.lsp.insert",
			  "to": "{{ {text: computed.lspCompletions[index].item.insert, before: length(state.lsp.completion.word), request: state.lsp.insert.request + 1} }}" },
			{ "set": "state.lsp.completion.open", "to": false }
		],
		"lspAnswer": [
			{ "note": "answer: { kind, request, path, result, error }, its positions from 0" },
			{ "if": "{{answer.error != null}}",
			  "then": [
				{ "if": "{{answer.kind == 'rename' || answer.kind == 'format'}}",
				  "then": [{ "run": "notify", "with": { "severity": "warning", "message": "{{'Not applied: ' + answer.error.message}}" } }],
				  "else": [{ "if": "{{answer.kind != 'hover' && answer.kind != 'completion' && answer.kind != 'signature' && answer.kind != 'tokens'}}",
				             "then": [{ "run": "notify", "with": { "severity": "info", "message": "{{'Language server: ' + answer.error.message}}" } }] }] }
			  ],
			  "else": [
				{ "if": "{{answer.kind == 'hover' && answer.request == state.lsp.hover.request}}",
				  "then": [{ "set": "state.lsp.hover", "to": "{{ {open: !empty(answer.result.text), text: answer.result.text, x: state.lsp.at.x, y: state.lsp.at.y, request: answer.request} }}" }] },
				{ "if": "{{answer.kind == 'completion' && answer.request == state.lsp.completion.request}}",
				  "then": [
					{ "set": "state.lsp.completion.items", "to": "{{answer.result.items}}" },
					{ "set": "state.lsp.completion.index", "to": 0 },
					{ "set": "state.lsp.completion.open", "to": "{{length(answer.result.items) > 0}}" }
				  ] },
				{ "if": "{{answer.kind == 'signature'}}",
				  "then": [{ "set": "state.lsp.signature", "to": "{{answer.result == null ? {open: false, label: '', documentation: ''} : {open: true, label: answer.result.label, documentation: answer.result.documentation}}}" }] },
				{ "if": "{{answer.kind == 'definition' && length(answer.result.locations) == 1}}",
				  "then": [{ "run": "lspOpenLocation", "with": { "at": "{{answer.result.locations[0]}}" } }] },
				{ "if": "{{(answer.kind == 'definition' && length(answer.result.locations) != 1) || answer.kind == 'references'}}",
				  "then": [{ "set": "state.lsp.peek", "to": "{{ {open: true, index: 0, items: answer.result.locations, title: (answer.kind == 'definition' ? 'Definitions: ' : 'References: ') + length(answer.result.locations) + (answer.result.truncated ? '+' : '')} }}" }] },
				{ "if": "{{answer.kind == 'rename' || answer.kind == 'format'}}",
				  "then": [
					{ "if": "{{length(answer.result.edits) == 0}}",
					  "then": [{ "run": "log", "with": { "text": "Language server: nothing to change" } }],
					  "else": [{ "set": "state.lsp.review", "to": "{{ {open: true, kind: answer.kind, edits: answer.result.edits, files: answer.result.files, truncated: answer.result.truncated} }}" }] }
				  ] },
				{ "if": "{{answer.kind == 'symbols' || answer.kind == 'workspaceSymbols'}}",
				  "then": [{ "set": "state.lsp.symbols", "to": "{{answer.result.symbols}}" }] },
				{ "if": "{{answer.kind == 'tokens'}}",
				  "then": [{ "set": "state.lsp.files", "to": "{{concat(filter(state.lsp.files, it.id != answer.path), [{id: answer.path, decorations: (find(state.lsp.files, it.id == answer.path) ?? {}).decorations ?? [], tokens: answer.result.tokens}])}}" }] }
			  ] }
		],
		"lspPublished": [
			{ "note": "published: { path, diagnostics, truncated }, positions from 0: squiggles in the file's editor, rows (from 1) in Problems" },
			{ "set": "state.lsp.files",
			  "to": "{{concat(filter(state.lsp.files, it.id != published.path), [{id: published.path, tokens: (find(state.lsp.files, it.id == published.path) ?? {}).tokens ?? [], decorations: map(published.diagnostics, {line: it.line, column: it.column, endLine: it.endLine, endColumn: it.endLine == it.line && it.endColumn <= it.column ? it.column + 1 : it.endColumn, kind: 'squiggle', color: it.severity == 'error' ? '#f85149' : it.severity == 'warning' ? '#cca700' : '#3794ff', text: it.message})}])}}" },
			{ "set": "state.problems",
			  "to": "{{concat(filter(state.problems, !(it.server ?? false) || it.file != published.path), map(published.diagnostics, {severity: it.severity == 'hint' ? 'info' : it.severity, message: empty(it.source) ? it.message : it.message + ' (' + it.source + ')', file: published.path, label: reverse(split(published.path, '/'))[0], line: it.line + 1, column: it.column + 1, source: 'lsp', server: true}))}}" },
			{ "if": "{{computed.activeDoc != null && computed.activeDoc.id == published.path}}",
			  "then": [{ "run": "lspAsk", "with": { "kind": "tokens", "line": null, "column": null, "newName": null, "query": null } }] }
		],
		"lspPlay": [
			{ "note": "Plays an answer the service gave (event: { kind, result, path, request, error }; kind 'diagnostics' for a published file), as the scenarios do" },
			{ "if": "{{event.kind == 'diagnostics'}}",
			  "then": [{ "run": "lspPublished", "with": { "published": "{{event.result}}" } }],
			  "else": [{ "run": "lspAnswer", "with": { "answer": "{{ {kind: event.kind, request: event.request ?? state.lsp.request, path: event.path ?? '', result: event.result ?? null, error: event.error ?? null} }}" } }] }
		],
		"lspOpenLocation": [
			{ "note": "at: { path, line, column } from 0" },
			{ "run": "openPath", "with": { "path": "{{at.path}}", "label": "{{reverse(split(at.path, '/'))[0]}}" } },
			{ "set": "state.goTo.line", "to": "{{at.line + 1}}" },
			{ "set": "state.goTo.column", "to": "{{at.column + 1}}" },
			{ "increment": "state.goTo.request", "by": 1 }
		],
		"lspPeekOpen": [
			{ "run": "lspOpenLocation", "with": { "at": "{{state.lsp.peek.items[number(event.id)]}}" } },
			{ "set": "state.lsp.peek.open", "to": false }
		],
		"lspApply": [
			{ "note": "An open file changes in its editor (one undo step, left unsaved); any other is read, changed and written" },
			{ "forEach": "{{keys(fromEntries(map(state.lsp.review.edits, {key: it.path, value: true})))}}", "as": "file", "do": [
				{ "run": "lspApplyTo", "with": { "file": "{{file}}",
				  "edits": "{{map(filter(state.lsp.review.edits, it.path == file), {line: it.line, column: it.column, endLine: it.endLine, endColumn: it.endColumn, text: it.text})}}" } }
			] },
			{ "run": "log", "with": { "text": "{{'Applied ' + plural(length(state.lsp.review.edits), 'edit') + ' in ' + plural(state.lsp.review.files, 'file')}}" } },
			{ "set": "state.lsp.review.open", "to": false }
		],
		"lspApplyTo": [
			{ "if": "{{some(state.docs, it.id == file && it.kind == 'file')}}",
			  "then": [{ "forEach": "{{filter(state.docs, it.id == file && it.kind == 'file')}}", "as": "doc", "do": [
				{ "if": "{{applyEdits(doc.text, edits) == null}}",
				  "then": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Not applied to ' + file + ': an edit is past its text, or two overlap'}}" } }],
				  "else": [{ "set": "state.docs", "to": "{{map(state.docs, it.id == file ? merge(it, {text: applyEdits(it.text, edits), dirty: applyEdits(it.text, edits) != it.saved}) : it)}}" }] }
			  ] }],
			  "else": [{ "invoke": "files.read", "with": { "path": "{{file}}" },
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Not applied to ' + file + ': ' + error.message}}" } }],
				"onDone": [
					{ "if": "{{applyEdits(result.text, edits) == null}}",
					  "then": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Not applied to ' + file + ': an edit is past its text, or two overlap'}}" } }],
					  "else": [{ "invoke": "files.write", "with": { "path": "{{file}}", "text": "{{applyEdits(result.text, edits)}}" },
						"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Not applied to ' + file + ': ' + error.message}}" } }] }] }
				] }] }
		],
		"lspRenameSend": [
			{ "set": "state.lsp.rename.open", "to": false },
			{ "if": "{{!empty(trim(state.lsp.rename.name))}}",
			  "then": [{ "run": "lspAsk", "with": { "kind": "rename", "newName": "{{trim(state.lsp.rename.name)}}", "line": null, "column": null, "query": null } }] }
		],
		"lspSymbolPicked": [
			{ "run": "lspOpenLocation", "with": { "at": "{{item}}" } }
		],
		"goToDefinition": { "title": "Go to Definition", "category": "Go", "icon": "arrow-right",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [{ "run": "lspAsk", "with": { "kind": "definition", "line": null, "column": null, "newName": null, "query": null } }] },
		"findReferences": { "title": "Find All References", "category": "Go", "icon": "list",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [{ "run": "lspAsk", "with": { "kind": "references", "line": null, "column": null, "newName": null, "query": null } }] },
		"renameSymbol": { "title": "Rename Symbol", "category": "Edit", "icon": "pencil",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [{ "set": "state.lsp.rename", "to": { "open": true, "name": "" } }] },
		"formatDocument": { "title": "Format Document", "category": "Edit", "icon": "align-left",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [{ "run": "lspAsk", "with": { "kind": "format", "line": null, "column": null, "newName": null, "query": null } }] },
		"triggerSuggest": { "title": "Trigger Suggest", "category": "Edit", "icon": "list",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [
				{ "run": "lspAsk", "with": { "kind": "completion", "line": null, "column": null, "newName": null, "query": null } },
				{ "set": "state.lsp.completion.request", "to": "{{state.lsp.request}}" },
				{ "set": "state.lsp.completion.word", "to": "" }
			] },
		"goToSymbol": { "title": "Go to Symbol in Editor...", "category": "Go", "icon": "hash",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [
				{ "set": "state.lsp.symbols", "to": [] },
				{ "set": "state.symbolPick.query", "to": "@" }, { "set": "state.symbolPick.open", "to": true },
				{ "run": "lspAsk", "with": { "kind": "symbols", "line": null, "column": null, "newName": null, "query": null } }
			] },
		"goToWorkspaceSymbol": { "title": "Go to Symbol in Workspace...", "category": "Go", "icon": "hash",
			"enablement": "{{computed.activeDoc != null}}",
			"do": [
				{ "set": "state.lsp.symbols", "to": [] },
				{ "set": "state.symbolPick.query", "to": "#" }, { "set": "state.symbolPick.open", "to": true }
			] }
	},

	"watch": {
		"state.symbolPick.query": [
			{ "if": "{{state.symbolPick.open && slice(event.value, 0, 1) == '#' && length(event.value) > 1}}",
			  "then": [{ "run": "lspAsk", "with": { "kind": "workspaceSymbols", "query": "{{slice(event.value, 1)}}", "line": null, "column": null, "newName": null } }] }
		]
	},

	"keys": {
		"f12": "goToDefinition",
		"shift+f12": "findReferences",
		"f2": "renameSymbol",
		"shift+alt+f": "formatDocument",
		"ctrl+space": "triggerSuggest",
		"mod+shift+o": "goToSymbol",
		"mod+t": "goToWorkspaceSymbol"
	},

	"menus": {
		"go": {
			"definition": { "run": "goToDefinition", "group": "2_symbols", "order": 1 },
			"references": { "run": "findReferences", "group": "2_symbols", "order": 2 },
			"symbol": { "run": "goToSymbol", "group": "2_symbols", "order": 3 },
			"workspaceSymbol": { "run": "goToWorkspaceSymbol", "group": "2_symbols", "order": 4 }
		}
	},

	"components": {
		"forgeLsp": {
			"node": {
				"type": "column", "id": "lsp", "width": 0, "height": 0,
				"children": [
					{ "type": "column", "id": "lsp-hover", "width": 420, "color": "@color.widget",
					  "borderWidth": 1, "borderColor": "@color.border",
					  "x": "{{state.lsp.hover.x}}", "y": "{{state.lsp.hover.y}}",
					  "overlay": { "placement": "window", "open": "state.lsp.hover.open", "dismiss": "outside" },
					  "children": [
						{ "type": "label", "id": "lsp-hover-text", "width": "100%", "padding": 8, "wrap": true, "fitText": true,
						  "textColor": "@color.text", "text": "{{state.lsp.hover.text}}" }
					  ] },
					{ "type": "column", "id": "lsp-signature", "width": 420, "color": "@color.widget",
					  "borderWidth": 1, "borderColor": "@color.border",
					  "x": "{{state.lsp.at.x}}", "y": "{{max(state.lsp.at.top - 48, 0)}}",
					  "overlay": { "placement": "window", "open": "state.lsp.signature.open", "dismiss": "outside" },
					  "children": [
						{ "type": "label", "id": "lsp-signature-label", "padding": 6, "font": "code", "fitText": true, "textColor": "@color.text",
						  "text": "{{state.lsp.signature.label}}" },
						{ "type": "label", "id": "lsp-signature-doc", "width": "100%", "padding": 6, "wrap": true, "fitText": true,
						  "when": "{{!empty(state.lsp.signature.documentation)}}",
						  "textColor": "@color.muted", "text": "{{state.lsp.signature.documentation}}" }
					  ] },
					{ "type": "column", "id": "lsp-completion", "width": 360, "color": "@color.widget",
					  "borderWidth": 1, "borderColor": "@color.border",
					  "x": "{{state.lsp.at.x}}", "y": "{{state.lsp.at.y}}",
					  "overlay": { "placement": "window", "open": "state.lsp.completion.open", "dismiss": "outside" },
					  "children": [
						{ "type": "row", "id": "lsp-completion-item", "width": "100%", "height": 22, "gap": 8,
						  "repeat": { "for": "c", "in": "{{slice(computed.lspCompletions, max(state.lsp.completion.index - 9, 0), max(state.lsp.completion.index - 9, 0) + 10)}}", "index": "ci" },
						  "color": "{{c.index == state.lsp.completion.index ? '@color.selection' : '@color.widget'}}",
						  "cursor": "hand", "onClick": { "run": "lspComplete", "with": { "index": "{{c.index}}" } },
						  "children": [
							{ "type": "label", "id": "lsp-completion-label", "font": "code", "fitText": true, "textColor": "@color.text",
							  "text": "{{c.item.label}}" },
							{ "type": "label", "id": "lsp-completion-detail", "grow": 1, "textColor": "@color.muted",
							  "text": "{{c.item.detail}}" }
						  ] }
					  ] },
					{ "type": "column", "id": "lsp-peek", "width": 640, "height": 260, "color": "@color.widget",
					  "borderWidth": 1, "borderColor": "@color.border",
					  "overlay": { "placement": "center", "open": "state.lsp.peek.open", "dismiss": "outside" },
					  "children": [
						{ "type": "label", "id": "lsp-peek-title", "width": "100%", "padding": 6, "textColor": "@color.text",
						  "text": "{{state.lsp.peek.title}}" },
						{ "type": "table", "id": "lsp-peek-list", "width": "100%", "grow": 1, "items": "{{computed.lspPeekRows}}",
						  "rowHeight": 22, "color": "@color.widget", "textColor": "@color.text",
						  "selectedBackground": "@color.selection", "accentColor": "@color.accent",
						  "columns": [{ "id": "text", "title": "", "width": 360 }, { "id": "file", "title": "File", "width": 200 },
						              { "id": "line", "title": "Line", "width": 60 }],
						  "onOpen": { "run": "lspPeekOpen" } }
					  ] },
					{ "use": "dialog", "id": "lsp-rename-dialog",
					  "with": { "open": "state.lsp.rename.open", "height": 150, "title": "Rename Symbol", "message": "",
					            "buttons": [{ "title": "Rename", "run": "lspRenameSend" }, { "title": "Cancel" }] },
					  "children": [
						{ "type": "textarea", "id": "lsp-rename-name", "bind": "state.lsp.rename.name", "autofocus": true,
						  "anchors": { "left": 20, "right": 20, "top": 48 }, "height": 28, "padding": 7, "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted", "placeholder": "New name",
						  "onSubmit": { "run": "lspRenameSend" } }
					  ] },
					{ "use": "dialog", "id": "lsp-review-dialog",
					  "with": { "open": "state.lsp.review.open", "height": 320,
					            "title": "{{state.lsp.review.kind == 'rename' ? 'Rename Symbol' : 'Format Document'}}",
					            "message": "{{'Apply ' + plural(length(state.lsp.review.edits), 'edit') + ' in ' + plural(state.lsp.review.files, 'file') + '? Open files are changed in their editors and left unsaved; others are written.'}}",
					            "buttons": [{ "title": "Apply", "run": "lspApply" }, { "title": "Cancel" }] },
					  "children": [
						{ "type": "table", "id": "lsp-review-list", "anchors": { "left": 20, "right": 20, "top": 80, "bottom": 56 },
						  "items": "{{map(state.lsp.review.edits, {id: index, cells: [it.path, (it.line + 1) + ':' + (it.column + 1), slice(join(split(it.text, '\n'), '⏎'), 0, 80)]})}}",
						  "rowHeight": 20, "color": "@color.widget", "textColor": "@color.text",
						  "columns": [{ "id": "file", "title": "File", "width": 200 }, { "id": "at", "title": "At", "width": 70 },
						              { "id": "text", "title": "New text", "width": 260 }] }
					  ] },
					{ "id": "lsp-symbols", "use": "quickPick", "with": {
						"name": "symbolPick", "width": 600, "color": "@color.widget", "textColor": "@color.text", "dimColor": "@color.muted",
						"accent": "@color.accent", "highlight": "@color.selection", "field": "@color.input",
						"providers": [
							{ "prefix": "@", "items": "{{computed.lspSymbolItems}}", "key": "name", "run": "lspSymbolPicked",
							  "placeholder": "Go to a symbol in this file" },
							{ "prefix": "#", "items": "{{computed.lspSymbolItems}}", "key": "name", "run": "lspSymbolPicked",
							  "placeholder": "Type to search the workspace's symbols" }
						] } }
				]
			}
		}
	}
}
