{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,
	"note": "Forge's explorer: the open folder's tree (forge.explorer.tree, kept current by the file watcher), new file and folder, rename, delete behind a confirm dialog, copy and paste, move by drag and drop, and reveal of the active file. The natives are in Explorer.cpp; state.explorerEdit holds what the dialogs and the context menu are doing.",

	"state": {
		"explorerTree": { "tree": [], "truncated": false, "live": false },
		"explorerEdit": { "mode": "", "id": "", "name": "", "naming": false, "confirm": false, "menu": false, "x": 0, "y": 0,
			"clipboard": "" }
	},

	"computed": {
		"explorerTarget": "{{state.explorer.selected ?? ''}}",
		"explorerTargetName": "{{reverse(filter(split(computed.explorerTarget, '/'), !empty(it)))[0] ?? ''}}"
	},

	"watch": {
		"state.folder.root": { "run": "explorerRefresh" },
		"state.iconTheme": { "run": "explorerRefresh" }
	},

	"actions": {
		"explorerRefresh": { "title": "Refresh Explorer", "category": "Files", "icon": "refresh-cw",
			"do": [{ "call": "forge.explorer.tree", "with": { "icons": "{{settings.workbench.fileIcons ? state.iconTheme : null}}" },
				"into": "state.explorerTree" }] },
		"explorerNewFile": { "title": "New File...", "category": "Files", "icon": "file-plus",
			"enablement": "{{!empty(state.folder.root)}}",
			"do": [{ "run": "explorerAskName", "with": { "mode": "newFile", "name": "" } }] },
		"explorerNewFolder": { "title": "New Folder...", "category": "Files", "icon": "folder-plus",
			"enablement": "{{!empty(state.folder.root)}}",
			"do": [{ "run": "explorerAskName", "with": { "mode": "newFolder", "name": "" } }] },
		"explorerRename": { "title": "Rename...", "category": "Files", "icon": "pencil",
			"enablement": "{{!empty(computed.explorerTarget)}}",
			"do": [{ "run": "explorerAskName", "with": { "mode": "rename", "name": "{{computed.explorerTargetName}}" } }] },
		"explorerAskName": [
			{ "set": "state.layout.sidebar", "to": true },
			{ "set": "state.explorerEdit", "to": "{{ {mode: mode, id: computed.explorerTarget, name: name, naming: true, confirm: false, menu: false, x: 0, y: 0, clipboard: state.explorerEdit.clipboard} }}" }
		],
		"explorerSubmitName": [
			{ "set": "state.explorerEdit.naming", "to": false },
			{ "if": "{{state.explorerEdit.mode == 'rename'}}",
			  "then": [{ "call": "forge.explorer.rename", "with": { "id": "{{state.explorerEdit.id}}", "name": "{{state.explorerEdit.name}}" },
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Cannot rename: ' + error}}" } }],
				"then": [{ "run": "explorerShow", "with": { "id": "{{result}}" } }] }],
			  "else": [{ "call": "forge.explorer.create",
				"with": { "in": "{{state.explorerEdit.id}}", "name": "{{state.explorerEdit.name}}", "folder": "{{state.explorerEdit.mode == 'newFolder'}}" },
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Cannot create: ' + error}}" } }],
				"then": [{ "run": "explorerShow", "with": { "id": "{{result}}" } }] }] }
		],
		"explorerShow": [
			{ "run": "explorerRefresh" },
			{ "call": "forge.explorer.reveal", "with": { "id": "{{id}}" },
			  "then": [{ "set": "state.explorer.expanded", "to": "{{concat(filter(state.explorer.expanded, !contains(result, it)), result)}}" },
			           { "set": "state.explorer.selected", "to": "{{id}}" }] }
		],
		"explorerDelete": { "title": "Delete...", "category": "Files", "icon": "trash-2",
			"enablement": "{{!empty(computed.explorerTarget)}}",
			"do": [{ "set": "state.layout.sidebar", "to": true },
			       { "set": "state.explorerEdit.id", "to": "{{computed.explorerTarget}}" },
			       { "set": "state.explorerEdit.name", "to": "{{computed.explorerTargetName}}" },
			       { "set": "state.explorerEdit.menu", "to": false },
			       { "set": "state.explorerEdit.confirm", "to": true }] },
		"explorerDeleteConfirmed": [
			{ "set": "state.explorerEdit.confirm", "to": false },
			{ "call": "forge.explorer.delete", "with": { "id": "{{state.explorerEdit.id}}" },
			  "onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Cannot delete: ' + error}}" } }],
			  "then": [{ "set": "state.explorer.selected", "to": null }, { "run": "explorerRefresh" }] }
		],
		"explorerCopy": { "title": "Copy", "category": "Files", "icon": "copy",
			"enablement": "{{!empty(computed.explorerTarget)}}",
			"do": [{ "set": "state.explorerEdit.clipboard", "to": "{{computed.explorerTarget}}" }] },
		"explorerPaste": { "title": "Paste", "category": "Files", "icon": "clipboard-paste",
			"enablement": "{{!empty(state.explorerEdit.clipboard)}}",
			"do": [{ "call": "forge.explorer.drop",
				"with": { "ids": "{{[state.explorerEdit.clipboard]}}", "into": "{{computed.explorerTarget}}", "place": "inside", "copy": true },
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Cannot paste: ' + error}}" } }],
				"then": [{ "run": "explorerShow", "with": { "id": "{{result[0]}}" } }] }] },
		"explorerDrop": [
			{ "if": "{{event.data.ids != null}}",
			  "then": [{ "call": "forge.explorer.drop",
				"with": { "ids": "{{event.data.ids}}", "into": "{{event.id ?? ''}}", "place": "{{event.place ?? 'inside'}}", "copy": false },
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'Cannot move: ' + error}}" } }],
				"then": [{ "run": "explorerShow", "with": { "id": "{{result[0]}}" } }] }] }
		],
		"explorerReveal": { "title": "Reveal Active File in Explorer", "category": "Files", "icon": "locate",
			"enablement": "{{computed.activeDoc != null && computed.activeDoc.kind == 'file'}}",
			"do": [{ "set": "state.layout.sidebar", "to": true },
			       { "run": "explorerShow", "with": { "id": "{{computed.activeDoc.id}}" } }] }
	},

	"menus": {
		"file": {
			"newFile": { "run": "explorerNewFile", "group": "0_new", "order": 1 },
			"newFolder": { "run": "explorerNewFolder", "group": "0_new", "order": 2 }
		},
		"explorer": {
			"newFile": { "run": "explorerNewFile", "group": "1_new", "order": 1 },
			"newFolder": { "run": "explorerNewFolder", "group": "1_new", "order": 2 },
			"reveal": { "run": "explorerReveal", "group": "2_reveal", "order": 1 },
			"copy": { "run": "explorerCopy", "group": "3_clipboard", "order": 1 },
			"paste": { "run": "explorerPaste", "group": "3_clipboard", "order": 2 },
			"rename": { "run": "explorerRename", "group": "4_edit", "order": 1 },
			"delete": { "run": "explorerDelete", "group": "4_edit", "order": 2 },
			"refresh": { "run": "explorerRefresh", "group": "5_refresh", "order": 1 }
		}
	},

	"components": {
		"forgeExplorer": {
			"node": {
				"type": "column", "id": "explorer-view", "width": "100%", "grow": 1,
				"children": [
					{ "type": "tree", "id": "explorer", "width": "100%", "grow": 1, "drag": {},
					  "items": "{{state.explorerTree.tree}}", "expanded": "{{state.explorer.expanded}}", "bind": "state.explorer.selected",
					  "rowHeight": 22, "color": "@color.sideBar", "textColor": "@color.text", "selectedTextColor": "@color.text",
					  "selectedBackground": "@color.selection", "accentColor": "@color.accent",
					  "onExpand": [{ "set": "state.explorer.expanded",
						"to": "{{event.expanded ? concat(state.explorer.expanded, [event.id]) : filter(state.explorer.expanded, it != event.id)}}" }],
					  "onOpen": { "run": "openExplorerItem" },
					  "onDrop": { "run": "explorerDrop" },
					  "onContextMenu": [{ "set": "state.explorerEdit.x", "to": "{{event.x}}" }, { "set": "state.explorerEdit.y", "to": "{{event.y}}" },
					                    { "set": "state.explorerEdit.menu", "to": true }] },
					{ "type": "label", "id": "explorer-truncated", "when": "{{state.explorerTree.truncated}}", "width": "100%",
					  "height": 22, "padding": 6, "icon": "alert-triangle", "text": "Too many files to show them all",
					  "textColor": "@color.warning" },
					{ "use": "contextMenu", "id": "explorer-menu",
					  "with": { "open": "state.explorerEdit.menu", "items": "{{menus.explorer}}", "x": "{{state.explorerEdit.x}}",
					            "y": "{{state.explorerEdit.y}}" } },
					{ "use": "dialog", "id": "explorer-name-dialog",
					  "with": { "open": "state.explorerEdit.naming", "height": 150,
					            "title": "{{state.explorerEdit.mode == 'rename' ? 'Rename' : state.explorerEdit.mode == 'newFolder' ? 'New Folder' : 'New File'}}",
					            "message": "",
					            "buttons": [{ "title": "OK", "run": "explorerSubmitName" }, { "title": "Cancel" }] },
					  "children": [
						{ "type": "textarea", "id": "explorer-name", "bind": "state.explorerEdit.name", "autofocus": true,
						  "anchors": { "left": 20, "right": 20, "top": 48 }, "height": 28, "padding": 7, "color": "@color.input",
						  "textColor": "@color.text", "placeholderColor": "@color.muted", "placeholder": "Name",
						  "onSubmit": { "run": "explorerSubmitName" } }
					  ] },
					{ "use": "dialog", "id": "explorer-delete-dialog",
					  "with": { "open": "state.explorerEdit.confirm", "title": "{{'Delete ' + state.explorerEdit.name + '?'}}",
					            "message": "{{slice(state.explorerEdit.id, len(state.explorerEdit.id) - 1) == '/' ? 'The folder and everything in it will be deleted. This cannot be undone.' : 'The file will be deleted. This cannot be undone.'}}",
					            "buttons": [{ "title": "Delete", "run": "explorerDeleteConfirmed" }, { "title": "Cancel" }] } }
				]
			}
		}
	}
}
