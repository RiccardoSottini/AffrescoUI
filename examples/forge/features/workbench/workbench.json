{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's workbench extras: the secondary side bar with the Outline (forge.outline), moving tabs between editor groups (by dragging, or Move Editor into Next or Previous Group), the breadcrumbs over the editor, the recently opened files (first in Go to File, kept by persist), the minimap setting, and the settings and keyboard shortcuts as JSON. The editor groups (features/editor) use forgeBreadcrumbs and the pages; the shell (features/shell) has state.layout.secondary.",

	"state": {
		"outline": [],
		"settingsJson": "",
		"settingsJsonError": ""
	},

	"computed": {
		"outlineItems": "{{map(state.outline, {id: text(it.line), label: (it.depth > 0 ? '    ' : '') + it.label, icon: it.depth > 0 ? 'chevron-right' : 'box'})}}",
		"symbolAtCaret": "{{find(reverse(state.outline), it.line <= state.caret.line)}}",
		"keybindingsJson": "{{json(map(keybindings, {key: it.key, command: it.command, when: it.when ?? ''}))}}"
	},

	"settings": {
		"editor.minimap.enabled": { "type": "boolean", "default": false, "title": "Minimap",
			"description": "Show a narrow overview of the file at the editor's right edge; press or drag it to scroll." },
		"breadcrumbs.enabled": { "type": "boolean", "default": true, "title": "Breadcrumbs",
			"description": "Show the file's folders and the symbol at the caret above the editor." },
		"diffEditor.renderSideBySide": { "type": "boolean", "default": true, "title": "Diff side by side",
			"description": "Compare a changed file side by side; off, inline (the deleted lines above the inserted ones)." }
	},

	"actions": {
		"toggleSecondarySidebar": { "title": "Toggle Secondary Side Bar", "category": "View", "icon": "panel-right",
			"description": "Show or hide the side bar at the right, with the Outline of the active file.",
			"do": [{ "toggle": "state.layout.secondary" }, { "run": "refreshOutline" }] },
		"refreshOutline": { "title": "Refresh Outline", "category": "Outline", "icon": "refresh-cw",
			"do": [{ "if": "{{computed.activeDoc.kind == 'file'}}",
			         "then": [{ "call": "forge.outline", "with": { "id": "{{computed.activeDoc.id}}" }, "into": "state.outline" }],
			         "else": [{ "set": "state.outline", "to": [] }] }] },
		"outlinePicked": [{ "if": "{{number(event.value) > 0}}", "then": [{ "run": "goToLine", "with": { "line": "{{number(event.value)}}" } }] }],
		"toggleMinimap": { "title": "Toggle Minimap", "category": "View", "icon": "map",
			"do": [{ "set": "settings.editor.minimap.enabled", "to": "{{!settings.editor.minimap.enabled}}" }] },
		"toggleDiffInline": { "title": "Toggle Inline View", "category": "Compare", "icon": "columns",
			"do": [{ "set": "settings.diffEditor.renderSideBySide", "to": "{{!settings.diffEditor.renderSideBySide}}" }] },
		"toggleBreadcrumbs": { "title": "Toggle Breadcrumbs", "category": "View", "icon": "chevrons-right",
			"do": [{ "set": "settings.breadcrumbs.enabled", "to": "{{!settings.breadcrumbs.enabled}}" }] },
		"revealFolder": [
			{ "note": "path: a folder's id (ending in /). Opens the explorer with that folder and its parents open" },
			{ "set": "state.explorer.expanded", "to": "{{concat(filter(state.explorer.expanded, !contains(map(split(slice(path, 0, length(path) - 1), '/'), join(slice(split(path, '/'), 0, index + 1), '/') + '/'), it)), map(split(slice(path, 0, length(path) - 1), '/'), join(slice(split(path, '/'), 0, index + 1), '/') + '/'))}}" },
			{ "set": "state.sideView", "to": "explorer" },
			{ "set": "state.layout.sidebar", "to": true }
		],

		"rememberRecent": [
			{ "note": "id, label: a file just shown. Puts it first in the recently opened files (Go to File lists them first)" },
			{ "set": "state.quickPick.recent", "to": "{{slice(concat([{id: id, title: label, detail: join(slice(split(id, '/'), 0, length(split(id, '/')) - 1), '/')}], filter(state.quickPick.recent ?? [], it.id != id)), 0, 10)}}" },
			{ "run": "refreshOutline" }
		],
		"openRecent": { "title": "Open Recent...", "category": "File", "icon": "history",
			"description": "Go to File, with the recently opened files first.",
			"do": [{ "run": "quickOpen" }] },
		"clearRecent": { "title": "Clear Recently Opened", "category": "File", "icon": "trash",
			"enablement": "{{length(state.quickPick.recent ?? []) > 0}}",
			"do": [{ "set": "state.quickPick.recent", "to": [] }] },

		"moveTabToGroup": [
			{ "note": "id, to, at: a tab dropped on group to's strip at place at. It leaves the group it was in (closed if empty)" },
			{ "if": "{{some(state.groups, index != to && contains(map(it.tabs, it.id), id))}}", "then": [
				{ "set": "state.groups[to].tabs", "to": "{{concat(slice(filter(state.groups[to].tabs, it.id != id), 0, at), [find(find(state.groups, index != to && contains(map(it.tabs, it.id), id)).tabs, it.id == id)], slice(filter(state.groups[to].tabs, it.id != id), at))}}" },
				{ "set": "state.groups[to].active", "to": "{{id}}" },
				{ "run": "closeTab", "with": { "gi": "{{indexOf(map(state.groups, index != to && contains(map(it.tabs, it.id), id)), true)}}", "id": "{{id}}" } },
				{ "set": "state.activeGroup", "to": "{{indexOf(map(state.groups, it.active == id), true)}}" }
			] }
		],
		"reorderTab": [
			{ "note": "gi, from, to: a tab dragged along its strip" },
			{ "set": "state.groups[gi].tabs", "to": "{{concat(slice(filter(state.groups[gi].tabs, index != from), 0, to), [state.groups[gi].tabs[from]], slice(filter(state.groups[gi].tabs, index != from), to))}}" }
		],
		"moveEditorToNextGroup": { "title": "Move Editor into Next Group", "category": "View", "icon": "arrow-right",
			"description": "Move the active editor into the group at its right, splitting if there is none.",
			"enablement": "{{!empty(state.groups[state.activeGroup].active) && (state.activeGroup < length(state.groups) - 1 || length(state.groups[state.activeGroup].tabs) > 1)}}",
			"do": [
				{ "if": "{{state.activeGroup == length(state.groups) - 1}}",
				  "then": [{ "push": "state.groups", "value": { "tabs": [], "active": null } }] },
				{ "run": "moveTabToGroup", "with": { "id": "{{state.groups[state.activeGroup].active}}", "to": "{{state.activeGroup + 1}}", "at": 1000 } }
			] },
		"moveEditorToPreviousGroup": { "title": "Move Editor into Previous Group", "category": "View", "icon": "arrow-left",
			"enablement": "{{!empty(state.groups[state.activeGroup].active) && state.activeGroup > 0}}",
			"do": [{ "run": "moveTabToGroup", "with": { "id": "{{state.groups[state.activeGroup].active}}", "to": "{{state.activeGroup - 1}}", "at": 1000 } }] },

		"focusFirstGroup": { "title": "Focus First Editor Group", "category": "View",
			"do": [{ "set": "state.activeGroup", "to": 0 }] },
		"focusSecondGroup": { "title": "Focus Second Editor Group", "category": "View",
			"enablement": "{{length(state.groups) > 1}}",
			"do": [{ "set": "state.activeGroup", "to": 1 }] },

		"openSettingsJson": { "title": "Open Settings (JSON)", "category": "Preferences", "icon": "braces",
			"description": "The settings you changed, as JSON: edit them and Apply.",
			"do": [{ "set": "state.settingsJson", "to": "{{json(state.settings ?? {})}}" }, { "set": "state.settingsJsonError", "to": "" },
			       { "run": "openPage", "with": { "id": "forge:settings.json", "label": "settings.json", "kind": "settingsJson" } }] },
		"applySettingsJson": { "title": "Apply Settings (JSON)", "category": "Preferences", "icon": "check",
			"do": [{ "if": "{{type(parseJson(state.settingsJson)) == 'object'}}",
			         "then": [{ "set": "state.settings", "to": "{{parseJson(state.settingsJson)}}" }, { "set": "state.settingsJsonError", "to": "" }],
			         "else": [{ "set": "state.settingsJsonError", "to": "Not applied: the text isn't a JSON object of settings." }] }] },
		"openKeybindingsJson": { "title": "Open Keyboard Shortcuts (JSON)", "category": "Preferences", "icon": "braces",
			"description": "The keys every feature contributes, as JSON (read-only: a feature's keys section changes them).",
			"do": [{ "run": "openPage", "with": { "id": "forge:keybindings.json", "label": "keybindings.json", "kind": "keybindingsJson" } }] }
	},

	"watch": {
		"state.caret": [{ "debounce": 300, "do": [{ "run": "refreshOutline" }] }]
	},

	"keys": {
		"mod+alt+b": "toggleSecondarySidebar",
		"mod+ctrl+right": "moveEditorToNextGroup",
		"mod+ctrl+left": "moveEditorToPreviousGroup",
		"ctrl+r": "openRecent",
		"mod+1": "focusFirstGroup",
		"mod+2": "focusSecondGroup"
	},

	"menus": {
		"file": {
			"openRecent": { "run": "openRecent", "group": "1_open", "order": 3 },
			"clearRecent": { "run": "clearRecent", "group": "1_open", "order": 4 }
		},
		"view": {
			"secondary": { "run": "toggleSecondarySidebar", "group": "2_layout", "order": 2 },
			"moveNext": { "run": "moveEditorToNextGroup", "group": "3_groups", "order": 1 },
			"movePrevious": { "run": "moveEditorToPreviousGroup", "group": "3_groups", "order": 2 },
			"minimap": { "run": "toggleMinimap", "group": "4_editor", "order": 2 },
			"breadcrumbs": { "run": "toggleBreadcrumbs", "group": "4_editor", "order": 3 }
		},
		"preferences": {
			"settingsJson": { "run": "openSettingsJson", "group": "1_settings", "order": 3 },
			"keybindingsJson": { "run": "openKeybindingsJson", "group": "1_settings", "order": 4 }
		}
	},

	"components": {
		"forgeSecondarySideBar": {
			"node": {
				"type": "column", "id": "secondary-side-bar", "role": "complementary", "label": "Secondary Side Bar", "width": 240,
				"height": "100%", "color": "@color.sideBar", "borderWidth": 1, "borderColor": "@color.border",
				"children": [
					{ "type": "row", "id": "outline-head", "width": "100%", "height": 32, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "outline-title", "text": "OUTLINE", "textColor": "@color.muted", "grow": 1, "padding": 12 },
						{ "type": "label", "id": "outline-refresh", "role": "button", "label": "Refresh Outline", "icon": "refresh-cw",
						  "padding": 6, "fitText": true, "cursor": "hand", "textColor": "@color.muted", "tooltip": "Refresh Outline",
						  "hover": { "color": "@color.hover" }, "onClick": { "run": "refreshOutline" } },
						{ "type": "label", "id": "outline-close", "role": "button", "label": "Hide Secondary Side Bar", "icon": "x",
						  "padding": 6, "fitText": true, "cursor": "hand", "textColor": "@color.muted", "tooltip": "Hide (Cmd+Alt+B)",
						  "hover": { "color": "@color.hover" }, "onClick": { "run": "toggleSecondarySidebar" } }
					  ] },
					{ "type": "label", "id": "outline-empty", "when": "{{empty(state.outline)}}", "width": "100%", "padding": 12, "wrap": true,
					  "textColor": "@color.muted", "text": "The active editor has no symbols to outline." },
					{ "type": "list", "id": "outline", "label": "Outline", "when": "{{!empty(state.outline)}}", "width": "100%", "grow": 1,
					  "items": "{{computed.outlineItems}}", "rowHeight": 22, "color": "@color.sideBar", "textColor": "@color.text",
					  "selectedBackground": "@color.selection", "accentColor": "@color.accent", "onChange": { "run": "outlinePicked" } }
				]
			}
		},
		"forgeBreadcrumbs": {
			"params": { "path": "" },
			"node": {
				"type": "row", "id": "breadcrumbs", "role": "navigation", "label": "Breadcrumbs", "width": "100%", "height": 22,
				"alignItems": "center", "color": "@color.editor", "gap": 2,
				"children": [
					{ "id": "breadcrumbs-start", "width": 10 },
					{ "type": "label", "id": "breadcrumb", "repeat": { "for": "segment", "in": "{{split(path, '/')}}", "index": "si" },
					  "role": "button", "label": "{{segment}}", "text": "{{segment}}", "icon": "{{si > 0 ? 'chevron-right' : ''}}",
					  "fitText": true, "padding": 2, "cursor": "hand", "textColor": "@color.muted", "hover": { "textColor": "@color.text" },
					  "onClick": [{ "if": "{{si < length(split(path, '/')) - 1}}",
					               "then": [{ "run": "revealFolder", "with": { "path": "{{join(slice(split(path, '/'), 0, si + 1), '/') + '/'}}" } }],
					               "else": [{ "run": "goToSymbol" }] }] },
					{ "type": "label", "id": "breadcrumb-symbol", "when": "{{computed.symbolAtCaret != null}}", "role": "button",
					  "label": "{{trim(computed.symbolAtCaret.label ?? '')}}", "text": "{{trim(computed.symbolAtCaret.label ?? '')}}",
					  "icon": "chevron-right", "fitText": true, "padding": 2, "cursor": "hand", "textColor": "@color.muted",
					  "hover": { "textColor": "@color.text" }, "onClick": { "run": "goToSymbol" } }
				]
			}
		},
		"forgeSettingsJsonPage": {
			"node": {
				"type": "column", "id": "settings-json-page", "width": "100%", "grow": 1, "color": "@color.editor",
				"children": [
					{ "type": "row", "id": "settings-json-head", "width": "100%", "height": 30, "alignItems": "center", "gap": 8,
					  "children": [
						{ "type": "label", "id": "settings-json-hint", "text": "The settings you changed; the others keep their defaults.",
						  "textColor": "@color.muted", "padding": 8, "grow": 1 },
						{ "type": "label", "id": "settings-json-error", "when": "{{!empty(state.settingsJsonError)}}",
						  "text": "{{state.settingsJsonError}}", "textColor": "@color.error", "fitText": true },
						{ "type": "label", "id": "settings-json-apply", "role": "button", "label": "Apply", "text": "Apply", "icon": "check",
						  "padding": 6, "fitText": true, "radius": 2, "cursor": "hand", "color": "@color.accent", "textColor": "#ffffff",
						  "focusable": true, "onClick": { "run": "applySettingsJson" } },
						{ "id": "settings-json-end", "width": 4 }
					  ] },
					{ "type": "editor", "id": "settings-json", "font": "code", "width": "100%", "grow": 1, "bind": "state.settingsJson",
					  "grammar": "json", "lineNumbers": true, "color": "@color.editor", "textColor": "@color.editorText",
					  "lineNumberColor": "@color.muted", "selectionColor": "@color.selection", "caretColor": "@color.text",
					  "keys": { "mod+enter": "applySettingsJson" } }
				]
			}
		},
		"forgeKeybindingsJsonPage": {
			"node": { "type": "editor", "id": "keybindings-json", "font": "code", "width": "100%", "grow": 1, "readOnly": true,
			          "text": "{{computed.keybindingsJson}}", "grammar": "json", "lineNumbers": true, "color": "@color.editor",
			          "textColor": "@color.editorText", "lineNumberColor": "@color.muted", "selectionColor": "@color.selection" }
		}
	}
}
