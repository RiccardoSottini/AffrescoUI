{
	"$schema": "../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "Forge's accounts (features/accounts), checked headless: what the document server would send is played as the connections' actions, signed out (no network, no provider).",
	"screen": "forge.screen.json",
	"scenarios": [
		{
			"name": "accounts-signed-out",
			"note": "Signed out, the status bar offers to sign in and shows no one",
			"steps": [
				{ "expect": { "node": "#status-accounts", "text": "Sign in" } },
				{ "expect": { "state": "accounts.peers.length", "is": 0 } },
				{ "expect": { "state": "accounts.menuOpen", "is": false } }
			]
		},
		{
			"name": "accounts-settings-from-the-server",
			"note": "The person's ~settings document arrives (hello, then a later document): its settings replace this machine's, and are remembered as synced so they aren't sent back",
			"steps": [
				{
					"action": "accountsServer:hello",
					"event": {
						"type": "hello",
						"revision": 3,
						"state": { "settings": { "accounts.document": "team" } }
					}
				},
				{ "expect": { "state": "accounts.synced", "is": { "accounts.document": "team" } } },
				{ "expect": { "state": "settings", "is": { "accounts.document": "team" } } },
				{
					"action": "accountsServer:document",
					"event": {
						"type": "document",
						"revision": 4,
						"state": { "settings": { "accounts.document": "design" } }
					}
				},
				{ "expect": { "state": "settings", "is": { "accounts.document": "design" } } },
				{ "expect": { "state": "accounts.revisions", "is": 0 } }
			]
		},
		{
			"name": "accounts-a-document-without-settings",
			"note": "A new ~settings document has no settings yet: this machine's stay",
			"steps": [
				{ "action": "accountsServer:hello", "event": { "type": "hello", "revision": 0, "state": {} } },
				{ "expect": { "state": "accounts.synced", "is": null } }
			]
		},
		{
			"name": "accounts-who-is-here",
			"note": "The server's presence lists who is on the shared document, and where; closing the connection clears it",
			"steps": [
				{
					"action": "accountsTeam:presence",
					"event": {
						"type": "presence",
						"peers": [
							{ "author": "ada", "where": "main.cpp", "doing": "editing" },
							{ "author": "lin", "where": "", "doing": "" }
						]
					}
				},
				{ "expect": { "state": "accounts.peers.length", "is": 2 } },
				{ "expect": { "state": "accounts.peers[0].where", "is": "main.cpp" } },
				{ "action": "accountsTeam:closed", "event": {} },
				{ "expect": { "state": "accounts.peers.length", "is": 0 } }
			]
		},
		{
			"name": "accounts-sign-out",
			"note": "Signing out forgets the collaborators and what was synced",
			"steps": [
				{
					"action": "accountsTeam:presence",
					"event": { "type": "presence", "peers": [{ "author": "ada", "where": "", "doing": "" }] }
				},
				{
					"action": "accountsServer:hello",
					"event": { "type": "hello", "state": { "settings": { "accounts.document": "team" } } }
				},
				{ "action": "accountsSignOut" },
				{ "expect": { "state": "accounts.peers.length", "is": 0 } },
				{ "expect": { "state": "accounts.synced", "is": null } },
				{ "expect": { "node": "#status-accounts", "text": "Sign in" } }
			]
		}
	]
}
