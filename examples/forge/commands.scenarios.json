		{
			"name": "forge-commands-features-switch",
			"note": "In the agent panel's feature list, Refresh Features lists the catalogue, and Disable or Enable Feature switches the selected one off and on",
			"steps": [
				{
					"revision": {
						"author": "studio",
						"message": "Install wordCount",
						"set": {
							"/features/wordCount": {
								"release": "1.0.0",
								"title": "Word count",
								"source": "catalog:forge-examples",
								"digest": "sha512:jya0GCcYM4OCsogNXebWlUBS4klrNcN3rQ_WDY4fta8ZwZbE12H4OSm9pPlKcfvZsPhXhuEBn75BOo96GvPgZA",
								"publisher": "ed25519:wvzomDMyk9aPCGQCvTzNPugq4saaDmJdO_8LaeLFYQc",
								"enabled": true,
								"order": 10,
								"requires": {
									"format": 2,
									"points": [
										"statusBar.right"
									],
									"exports": {
										"editor.text": {
											"type": "string"
										}
									}
								},
								"provides": {
									"state": {
										"characters": false
									},
									"computed": {
										"words": "{{length(filter(split(join(split(app.editor.text, '\\n'), ' '), ' '), length(trim(it)) > 0))}}",
										"characters": "{{length(app.editor.text)}}"
									},
									"actions": {
										"toggle": {
											"title": "Toggle Word or Character Count",
											"category": "Word Count",
											"do": {
												"toggle": "state.wordCount.characters"
											}
										}
									},
									"menus": {
										"view": {
											"items": {
												"toggle": {}
											}
										}
									},
									"views": {
										"statusBar.right": {
											"wordCount-label": {
												"type": "label",
												"padding": 6,
												"fitText": true,
												"textColor": "@color.statusText",
												"cursor": "hand",
												"text": "{{state.wordCount.characters ? plural(computed.wordCount.characters, 'character') : plural(computed.wordCount.words, 'word')}}",
												"onClick": "wordCount.toggle"
											}
										}
									}
								}
							}
						}
					}
				},
				{
					"expect": {
						"state": "features.catalog.length",
						"is": 0
					}
				},
				{
					"action": "featuresRefresh"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"state": "features.catalog.length",
						"is": 2
					}
				},
				{
					"revision": {
						"type": "revision",
						"message": "Select word count",
						"set": {
							"/state/features/selected": "wordCount"
						}
					}
				},
				{
					"action": "featuresDisable"
				},
				{
					"expect": {
						"node": "#wordCount-label",
						"exists": false
					}
				},
				{
					"action": "featuresEnable"
				},
				{
					"expect": {
						"node": "#wordCount-label",
						"exists": true
					}
				}
			]
		}
	]
