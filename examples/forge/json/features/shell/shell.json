{
	"$schema": "../../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Forge's shell: the title bar with a command centre, the activity bar, the explorer side bar, editor groups with tabs, the panel and the status bar. The layout (what is shown, the sash positions) is in state.layout, kept by persist; zen mode hides everything but the editors. Other features contribute commands, menus, keys, settings, tokens and components (examples/forge/README.md).",

	"state": {
		"layout": { "sidebar": true, "panel": false, "panelMax": false, "zen": false, "secondary": false, "sizes": [240], "panelSizes": [480], "groupSizes": [] },
		"folder": { "root": "", "files": [], "truncated": false,
			"skip": "**/node_modules/**,**/build/**,**/out/**,**/dist/**,**/target/**,**/__pycache__/**,**/.*/**,**/.*" },
		"explorer": { "expanded": [], "selected": null },
		"docs": [],
		"groups": [{ "tabs": [], "active": null }],
		"activeGroup": 0,
		"caret": { "line": 1, "column": 1, "selected": 0 },
		"menuBar": {},
		"about": false,
		"sideView": "explorer",
		"nav": { "back": [], "forward": [], "moving": false },
		"notificationCentre": false,
		"walkthrough": { "theme": false, "live": false, "keys": false },
		"clone": { "url": "", "folder": "", "busy": false },
		"languages": { "c": "C++", "cc": "C++", "cpp": "C++", "h": "C++", "hpp": "C++", "json": "JSON", "md": "Markdown",
			"cmake": "CMake", "py": "Python", "js": "JavaScript", "mjs": "JavaScript", "ts": "TypeScript", "tsx": "TypeScript",
			"sh": "Shell", "bash": "Shell", "zsh": "Shell" }
	},

	"computed": {
		"docIds": "{{map(state.docs, it.id)}}",
		"dirtyIds": "{{map(filter(state.docs, it.dirty), it.id)}}",
		"activeDoc": "{{find(state.docs, it.id == state.groups[state.activeGroup].active)}}",
		"folderName": "{{empty(state.folder.root) ? 'No Folder Opened' : reverse(split(state.folder.root, '/'))[0]}}",
		"welcomeRecent": "{{empty(state.folder.root) ? [] : slice(filter(state.quickPick.recent ?? [], contains(map(state.folder.files ?? [], it.id), it.id)), 0, 5)}}",
		"welcomeKeys": "{{[{name: 'quickOpen', title: 'Go to File', key: (find(commands, it.name == 'quickOpen') ?? {}).keyLabel ?? ''}, {name: 'showCommands', title: 'Show All Commands', key: (find(commands, it.name == 'showCommands') ?? {}).keyLabel ?? ''}, {name: 'toggleSidebar', title: 'Toggle Side Bar', key: (find(commands, it.name == 'toggleSidebar') ?? {}).keyLabel ?? ''}, {name: 'togglePanel', title: 'Toggle Panel', key: (find(commands, it.name == 'togglePanel') ?? {}).keyLabel ?? ''}, {name: 'splitEditor', title: 'Split Editor', key: (find(commands, it.name == 'splitEditor') ?? {}).keyLabel ?? ''}, {name: 'toggleZen', title: 'Zen Mode', key: (find(commands, it.name == 'toggleZen') ?? {}).keyLabel ?? ''}, {name: 'openSettings', title: 'Settings', key: (find(commands, it.name == 'openSettings') ?? {}).keyLabel ?? ''}]}}",
		"cloneItems": "{{trim(slice(state.quickPick.query ?? '', 6)) == '' ? [] : [{title: 'Clone from ' + trim(slice(state.quickPick.query, 6)), url: trim(slice(state.quickPick.query, 6))}]}}"
	},

	"actions": {
		"toggleSidebar": { "title": "Toggle Left Side Bar", "category": "View", "icon": "panel-left",
			"do": [{ "toggle": "state.layout.sidebar" }] },
		"forgeShowView": [
			{ "if": "{{state.sideView == view && state.layout.sidebar}}",
			  "then": [{ "set": "state.layout.sidebar", "to": false }],
			  "else": [{ "set": "state.sideView", "to": "{{view}}" }, { "set": "state.layout.sidebar", "to": true }] }
		],
		"showExplorer": { "title": "Show Explorer", "category": "View", "icon": "files",
			"do": [{ "run": "forgeShowView", "with": { "view": "explorer" } }] },
		"showSearch": { "title": "Show Search", "category": "View", "icon": "search",
			"do": [{ "run": "forgeShowView", "with": { "view": "search" } }] },
		"navigateBack": { "title": "Go Back", "category": "Go", "icon": "arrow-left",
			"enablement": "{{length(state.nav.back) > 0}}",
			"do": [{ "set": "state.nav.forward", "to": "{{concat(filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active), state.nav.forward)}}" },
			       { "run": "forgeNavigateTo", "with": { "tab": "{{state.nav.back[length(state.nav.back) - 1]}}" } },
			       { "set": "state.nav.back", "to": "{{slice(state.nav.back, 0, length(state.nav.back) - 1)}}" }] },
		"navigateForward": { "title": "Go Forward", "category": "Go", "icon": "arrow-right",
			"enablement": "{{length(state.nav.forward) > 0}}",
			"do": [{ "set": "state.nav.back", "to": "{{concat(state.nav.back, filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active))}}" },
			       { "run": "forgeNavigateTo", "with": { "tab": "{{state.nav.forward[0]}}" } },
			       { "set": "state.nav.forward", "to": "{{slice(state.nav.forward, 1)}}" }] },
		"forgeNavigateTo": [
			{ "note": "tab: { id, label }, shown without being recorded in the history" },
			{ "set": "state.nav.moving", "to": true },
			{ "run": "showTab", "with": { "id": "{{tab.id}}", "label": "{{tab.label}}" } },
			{ "set": "state.nav.moving", "to": false }
		],
		"togglePanel": { "title": "Toggle Panel", "category": "View", "icon": "panel-bottom",
			"do": [{ "toggle": "state.layout.panel" }, { "set": "state.layout.panelMax", "to": false }] },
		"toggleMaximizedPanel": { "title": "Maximize Panel Size", "category": "View", "icon": "chevron-up",
			"do": [{ "set": "state.layout.panel", "to": true }, { "toggle": "state.layout.panelMax" }] },
		"toggleZen": { "title": "Toggle Zen Mode", "category": "View", "icon": "maximize",
			"description": "Hide everything but the editors; run it again to bring the workbench back.",
			"do": [{ "toggle": "state.layout.zen" }] },
		"openFolder": { "title": "Open Folder...", "category": "File", "icon": "folder-open",
			"do": [{ "chooseFolder": "workspace", "title": "Open Folder",
				"onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'No folder opened: ' + error.message}}" } }],
				"onDone": [{ "set": "state.explorer", "to": "{{ {expanded: [], selected: null} }}" },
				           { "set": "state.explorerTree", "to": "{{ {entries: [], listed: []} }}" },
				           { "set": "state.folder.root", "to": "{{result.name}}" },
				           { "run": "explorerRefresh" }, { "run": "indexFolder" },
				           { "run": "log", "with": { "text": "{{'Opened ' + result.name}}" } }] }] },
		"cloneRepository": { "title": "Clone Git Repository...", "category": "File", "icon": "git-branch",
			"description": "Clone a git repository into a folder you choose, then open it.",
			"do": [{ "set": "state.quickPick.query", "to": "clone " }, { "set": "state.quickPick.open", "to": true }] },
		"clonePicked": [
			{ "note": "item: the repository's address typed in the palette; an empty folder is asked for, to clone it into" },
			{ "if": "{{trim(item.url) == '' || slice(item.url, 0, 1) == '-' || contains(item.url, ' ')}}",
			  "then": [{ "run": "notify", "with": { "severity": "error", "message": "Type a repository address, without spaces" } }],
			  "else": [{ "set": "state.clone.url", "to": "{{item.url}}" },
			           { "chooseFolder": "workspace", "title": "Choose an empty folder to clone into",
			             "onError": [{ "run": "notify", "with": { "severity": "error", "message": "{{'No folder opened: ' + error.message}}" } }],
			             "onDone": [{ "run": "cloneInto", "with": { "name": "{{result.name}}" } }] }] }
		],
		"cloneInto": [
			{ "note": "name: the folder chosen. git clones the repository into it, with a toast while it runs" },
			{ "set": "state.toast", "to": "{{ {open: true, message: 'Cloning ' + state.clone.url, progress: 0.3} }}" },
			{ "set": "state.clone", "to": "{{ {url: state.clone.url, folder: name, busy: true} }}" },
			{ "invoke": "git.run", "with": { "arguments": ["clone", "--", "{{state.clone.url}}", "."], "collect": true },
			  "onError": [{ "set": "state.clone.busy", "to": false },
			              { "run": "notify", "with": { "severity": "error", "message": "{{'The repository was not cloned: ' + error.message}}" } }],
			  "onDone": [{ "set": "state.clone.busy", "to": false },
			             { "if": "{{result.code == 0}}",
			               "then": [{ "set": "state.explorer", "to": "{{ {expanded: [], selected: null} }}" },
			                        { "set": "state.explorerTree", "to": "{{ {entries: [], listed: []} }}" },
			                        { "set": "state.folder.root", "to": "{{state.clone.folder}}" },
			                        { "run": "explorerRefresh" }, { "run": "indexFolder" },
			                        { "run": "notify", "with": { "severity": "info", "message": "{{'Cloned into ' + state.clone.folder}}" } }],
			               "else": [{ "run": "notify", "with": { "severity": "error", "message": "{{'The repository was not cloned: ' + trim(result.output ?? '')}}" } }] }] }
		],
		"welcomeStepTheme": [{ "set": "state.walkthrough.theme", "to": true }, { "run": "pickTheme" }],
		"welcomeStepLive": [{ "set": "state.walkthrough.live", "to": true }, { "run": "showAgent" }],
		"welcomeStepKeys": [{ "set": "state.walkthrough.keys", "to": true }, { "run": "openKeybindings" }],
		"indexFolder": [
			{ "note": "Lists the folder's files for Go to File" },
			{ "invoke": "search.files", "with": { "exclude": "{{state.folder.skip}}" },
			  "onDone": [{ "run": "indexed", "with": { "files": "{{result.files}}" } }, { "set": "state.folder.truncated", "to": "{{result.truncated}}" }],
			  "onError": [{ "set": "state.folder.files", "to": [] }] }
		],
		"indexed": [{ "set": "state.folder.files", "to": "{{map(files, {id: it, title: reverse(split(it, '/'))[0], detail: join(slice(split(it, '/'), 0, -1), '/')})}}" }],
		"openExplorerItem": [
			{ "if": "{{!empty(event.id) && (find(state.explorerTree.entries, it.path == event.id) ?? {}).kind != 'folder'}}",
			  "then": [{ "run": "openPath", "with": { "path": "{{event.id}}", "label": "{{reverse(split(event.id, '/'))[0]}}" } }] }
		],
		"forgeRecordNav": [
			{ "note": "id: the tab about to be shown. The tab shown now goes into the history Go Back walks (the last 50), unless Go Back or Go Forward is moving" },
			{ "if": "{{!state.nav.moving && !empty(state.groups[state.activeGroup].active) && state.groups[state.activeGroup].active != id}}",
			  "then": [{ "set": "state.nav", "to": "{{ {back: slice(concat(state.nav.back, filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active)), max(0, length(state.nav.back) - 49)), forward: [], moving: false} }}" }] }
		],
		"showTab": [
			{ "run": "forgeRecordNav", "with": { "id": "{{id}}" } },
			{ "if": "{{!some(state.groups[state.activeGroup].tabs, it.id == id)}}",
			  "then": [{ "push": "state.groups[state.activeGroup].tabs", "value": "{{ {id: id, label: label} }}" }] },
			{ "set": "state.groups[state.activeGroup].active", "to": "{{id}}" }
		],
		"openPage": [
			{ "if": "{{!contains(computed.docIds, id)}}",
			  "then": [{ "push": "state.docs", "value": "{{ {id: id, label: label, kind: kind, text: '', dirty: false, language: ''} }}" }] },
			{ "run": "showTab", "with": { "id": "{{id}}", "label": "{{label}}" } }
		],
		"closeEditor": { "title": "Close Editor", "category": "View", "icon": "x",
			"enablement": "{{!empty(state.groups[state.activeGroup].active)}}",
			"do": [{ "run": "closeTab", "with": { "gi": "{{state.activeGroup}}", "id": "{{state.groups[state.activeGroup].active}}" } }] },
		"splitEditor": { "title": "Split Editor", "category": "View", "icon": "columns-2",
			"description": "Open the active editor beside the current one (two groups at most).",
			"enablement": "{{length(state.groups) < 2 && !empty(state.groups[state.activeGroup].active)}}",
			"do": [
				{ "push": "state.groups", "value": "{{ {tabs: filter(state.groups[state.activeGroup].tabs, it.id == state.groups[state.activeGroup].active), active: state.groups[state.activeGroup].active} }}" },
				{ "set": "state.activeGroup", "to": "{{length(state.groups) - 1}}" }
			] },
		"about": { "title": "About Forge", "category": "Help", "icon": "info", "do": [{ "set": "state.about", "to": true }] }
	},

	"keys": {
		"mod+b": "toggleSidebar",
		"mod+j": "togglePanel",
		"mod+k z": "toggleZen",
		"mod+o": "openFolder",
		"mod+w": "closeEditor",
		"mod+\\": "splitEditor",
		"ctrl+minus": "navigateBack",
		"ctrl+shift+minus": "navigateForward"
	},

	"menus": {
		"file": {
			"openFolder": { "run": "openFolder", "group": "1_open", "order": 1 },
			"reindex": { "run": "reindex", "group": "1_open", "order": 2 },
			"closeEditor": { "run": "closeEditor", "group": "2_close", "order": 1 }
		},
		"view": {
			"sidebar": { "run": "toggleSidebar", "group": "2_layout", "order": 1 },
			"panel": { "run": "togglePanel", "group": "2_layout", "order": 2 },
			"split": { "run": "splitEditor", "group": "2_layout", "order": 3 },
			"zen": { "run": "toggleZen", "group": "2_layout", "order": 4 }
		},
		"go": {
			"back": { "run": "navigateBack", "group": "0_history", "order": 1 },
			"forward": { "run": "navigateForward", "group": "0_history", "order": 2 }
		},
		"help": {
			"keybindings": { "run": "openKeybindings", "group": "1_help", "order": 1 },
			"about": { "run": "about", "group": "2_about", "order": 1 }
		}
	},

	"components": {
		"forgeTitleBar": {
			"node": {
				"type": "row", "id": "title-bar", "role": "banner", "label": "Title Bar", "width": "100%", "height": 38, "color": "@color.titleBar", "alignItems": "center",
				"children": [
					{ "id": "menu-bar", "when": "{{!window.nativeMenuBar}}", "use": "menuBar", "width": 330,
					  "with": { "open": "state.menuBar", "menus": "{{[{name: 'file', title: 'File', items: menus.file}, {name: 'view', title: 'View', items: menus.view}, {name: 'go', title: 'Go', items: menus.go}, {name: 'preferences', title: 'Preferences', items: menus.preferences}, {name: 'help', title: 'Help', items: menus.help}]}}" } },
					{ "id": "title-left", "grow": 1 },
					{ "id": "title-back", "use": "forgeTitleButton", "with": { "icon": "arrow-left", "tip": "Go Back (Ctrl+-)", "on": "{{length(state.nav.back) > 0}}" },
					  "onClick": { "run": "navigateBack" } },
					{ "id": "title-forward", "use": "forgeTitleButton", "with": { "icon": "arrow-right", "tip": "Go Forward (Ctrl+Shift+-)", "on": "{{length(state.nav.forward) > 0}}" },
					  "onClick": { "run": "navigateForward" } },
					{ "id": "title-centre-gap", "width": 4 },
					{ "type": "row", "id": "command-centre", "role": "button", "label": "Search Files", "width": 380, "height": 26, "color": "@color.input", "radius": 7,
					  "borderWidth": 1, "borderColor": "@color.border", "alignItems": "center", "gap": 6,
					  "cursor": "hand", "tooltip": "Search files (> for commands, : for a line)", "hover": { "color": "@color.hover" },
					  "onClick": { "run": "quickOpen" },
					  "children": [
						{ "id": "command-centre-start", "width": 6 },
						{ "type": "label", "id": "command-centre-icon", "icon": "search", "textColor": "@color.muted", "fitText": true },
						{ "type": "label", "id": "command-centre-text", "text": "{{'Search ' + computed.folderName}}", "textColor": "@color.muted",
						  "fitText": true, "height": 20 },
						{ "id": "command-centre-end", "grow": 1 },
						{ "type": "label", "id": "command-centre-hint", "text": "Cmd+P", "textColor": "@color.muted", "fitText": true, "height": 18, "padding": 6,
						  "radius": 4, "borderWidth": 1, "borderColor": "@color.border" },
						{ "id": "command-centre-hint-end", "width": 4 }
					  ] },
					{ "id": "title-right", "grow": 1 },
					{ "id": "title-sidebar", "use": "forgeTitleButton", "with": { "icon": "panel-left", "tip": "Toggle Left Side Bar (Cmd+B)", "on": "{{state.layout.sidebar}}" },
					  "onClick": { "run": "toggleSidebar" } },
					{ "id": "title-panel", "use": "forgeTitleButton", "with": { "icon": "panel-bottom", "tip": "Toggle Panel (Cmd+J)", "on": "{{state.layout.panel}}" },
					  "onClick": { "run": "togglePanel" } },
					{ "id": "title-secondary", "use": "forgeTitleButton", "with": { "icon": "panel-right", "tip": "Toggle Outline Bar (Cmd+Alt+B)", "on": "{{state.layout.secondary}}" },
					  "onClick": { "run": "toggleSecondarySidebar" } },
					{ "id": "title-end", "width": 8 }
				]
			}
		},
		"forgeTitleButton": {
			"params": { "icon": "", "tip": "", "on": false },
			"node": { "type": "label", "role": "button", "label": "{{tip}}", "icon": "{{icon}}", "font": "icons", "width": 28, "height": 26, "align": "center",
			          "radius": 7, "cursor": "hand", "textColor": "{{on ? '@color.text' : '@color.muted'}}", "tooltip": "{{tip}}",
			          "hover": { "color": "@color.hover" } }
		},
		"forgeActivityItem": {
			"params": { "view": "", "icon": "", "label": "", "tip": "", "badge": 0 },
			"node": {
				"id": "activity-{{view}}", "role": "tab", "label": "{{label}}", "selected": "{{state.layout.sidebar && state.sideView == view}}",
				"width": 44, "height": 42, "color": "@color.activityBar", "cursor": "hand", "tooltip": "{{tip}}",
				"children": [
					{ "id": "activity-{{view}}-indicator", "anchors": { "left": 5, "top": 4, "right": 5, "bottom": 4 }, "radius": 8,
					  "color": "{{state.layout.sidebar && state.sideView == view ? '@color.selection' : '@color.activityBar'}}" },
					{ "type": "label", "icon": "{{icon}}", "font": "iconsRail", "anchors": { "left": 5, "top": 4, "right": 5, "bottom": 4 }, "align": "center", "radius": 8,
					  "textColor": "{{state.layout.sidebar && state.sideView == view ? '@color.accent' : '@color.muted'}}",
					  "hover": { "textColor": "{{state.layout.sidebar && state.sideView == view ? '@color.accent' : '@color.text'}}", "borderWidth": 1, "borderColor": "@color.border" } },
					{ "type": "label", "id": "activity-{{view}}-badge", "when": "{{badge > 0}}", "text": "{{badge > 99 ? '99+' : text(badge)}}",
					  "anchors": { "right": 2, "top": 1 }, "height": 15, "padding": 4, "fitText": true, "radius": 8, "align": "center",
					  "color": "@color.accent", "textColor": "#ffffff" }
				]
			}
		},
		"forgeActivityBar": {
			"node": {
				"type": "column", "id": "activity-bar", "role": "tablist", "label": "View Rail", "width": 44, "height": "100%", "color": "@color.activityBar",
				"children": [
					{ "id": "activity-top", "height": 4 },
					{ "use": "forgeActivityItem", "with": { "view": "explorer", "icon": "folder-tree", "label": "Explorer", "tip": "Explorer (Cmd+Shift+E)" },
					  "onClick": { "run": "showExplorer" } },
					{ "use": "forgeActivityItem", "with": { "view": "search", "icon": "text-search", "label": "Search", "tip": "Search (Cmd+Shift+F)" },
					  "onClick": { "run": "showSearch" } },
					{ "use": "forgeActivityItem", "with": { "view": "scm", "icon": "git-fork", "label": "Source Control", "tip": "Source Control (Cmd+Shift+G)",
					  "badge": "{{state.scm.status.count}}" },
					  "onClick": { "run": "showSourceControl" } },
					{ "use": "forgeActivityItem", "with": { "view": "debug", "icon": "bug-play", "label": "Debugger", "tip": "Debugger (Cmd+Shift+D)" },
					  "onClick": { "run": "showDebug" } },
					{ "use": "forgeActivityItem", "with": { "view": "features", "icon": "puzzle", "label": "Features", "tip": "Features (Cmd+Shift+X)" },
					  "onClick": { "run": "showFeatures" } },
					{ "use": "forgeActivityItem", "with": { "view": "agent", "icon": "sparkles", "label": "Agent", "tip": "Agent (Cmd+Alt+I)" },
					  "onClick": { "run": "showAgent" } },
					{ "id": "activity-gap", "grow": 1 },
					{ "use": "forgeAccountsStatus" },
					{ "type": "label", "id": "activity-settings", "role": "button", "label": "Settings", "icon": "settings", "font": "iconsRail", "width": 44, "height": 42,
					  "align": "center", "cursor": "hand", "tooltip": "Settings (Cmd+,)", "textColor": "@color.muted",
					  "hover": { "textColor": "@color.text" }, "onClick": { "run": "openSettings" } },
					{ "id": "activity-bottom", "height": 4 }
				]
			}
		},
		"forgeViewTitle": {
			"params": { "text": "" },
			"node": { "type": "label", "text": "{{text}}", "textColor": "@color.muted", "width": "100%", "height": 35, "padding": 12 }
		},
		"forgeSideBar": {
			"node": {
				"type": "column", "id": "side-bar", "role": "complementary", "label": "Left Side Bar", "point": "sidebar.views", "color": "@color.sideBar",
				"children": [
					{ "when": "{{state.sideView == 'scm'}}", "use": "forgeScmView" },
					{ "when": "{{state.sideView == 'debug'}}", "use": "forgeDebugView" },
					{ "when": "{{state.sideView == 'agent'}}", "use": "forgeAgentView" },
					{ "when": "{{state.sideView == 'features'}}", "use": "forgeFeaturesView" },
					{ "when": "{{state.sideView == 'search'}}", "use": "forgeSearchPage" },
					{ "when": "{{state.sideView == 'explorer'}}", "use": "forgeExplorerTitle" },
					{ "type": "label", "id": "side-bar-folder", "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "icon": "chevron-down",
					  "text": "{{upper(computed.folderName)}}", "textColor": "@color.text", "width": "100%", "height": 22,
					  "padding": 6 },
					{ "when": "{{state.sideView == 'explorer' && !empty(state.folder.root)}}", "use": "forgeExplorer" },
					{ "type": "column", "id": "side-bar-empty", "when": "{{state.sideView == 'explorer' && empty(state.folder.root)}}", "width": "100%",
					  "fitContent": "height", "alignItems": "center", "gap": 4,
					  "children": [
						{ "type": "label", "id": "side-bar-empty-text", "text": "You have not yet opened a folder.",
						  "textColor": "@color.text", "width": "100%", "height": 40, "padding": 12, "wrap": true },
						{ "type": "label", "id": "side-bar-open", "text": "Open Folder", "width": 200, "height": 28,
						  "align": "center", "color": "@color.accent", "textColor": "#ffffff", "radius": 6, "cursor": "hand",
						  "focusable": true, "onClick": { "run": "openFolder" } }
					  ] }
				]
			}
		},
		"forgeWelcome": {
			"node": {
				"type": "row", "id": "welcome", "width": "100%", "grow": 1, "color": "@color.editor", "scroll": "vertical",
				"children": [
					{ "id": "welcome-margin", "grow": 1 },
					{ "type": "column", "id": "welcome-body", "width": 760, "fitContent": "height", "gap": 6, "children": [
					{ "id": "welcome-top", "height": 40 },
					{ "id": "welcome-mark", "width": 36, "height": 4, "radius": 2, "color": "@color.accent" },
					{ "type": "label", "id": "welcome-title", "text": "Forge", "font": "title", "textColor": "@color.text", "fitText": true },
					{ "type": "label", "id": "welcome-subtitle", "text": "A workbench made of live documents, written in Lisp: change any part of it while it runs.",
					  "textColor": "@color.muted", "fitText": true },
					{ "id": "welcome-gap", "height": 22 },
					{ "type": "row", "id": "welcome-columns", "width": "100%", "fitContent": "height", "gap": 48, "children": [
						{ "type": "column", "id": "welcome-left", "width": 330, "fitContent": "height", "gap": 2, "children": [
							{ "type": "label", "id": "welcome-start", "text": "Start", "textColor": "@color.text", "fitText": true, "height": 24 },
							{ "id": "welcome-new-file", "when": "{{!empty(state.folder.root)}}", "use": "forgeWelcomeAction",
							  "with": { "icon": "file-plus", "text": "New File...", "tip": "Create a file in the open folder", "command": "explorerNewFile" },
							  "onClick": { "run": "explorerNewFile" } },
							{ "id": "welcome-open", "use": "forgeWelcomeAction",
							  "with": { "icon": "folder-open", "text": "Open Folder...", "tip": "Open a folder to work in", "command": "openFolder" },
							  "onClick": { "run": "openFolder" } },
							{ "id": "welcome-clone", "use": "forgeWelcomeAction",
							  "with": { "icon": "git-branch", "text": "Clone Git Repository...", "tip": "Clone a repository into a folder you choose, then open it", "command": "cloneRepository" },
							  "onClick": { "run": "cloneRepository" } },
							{ "id": "welcome-files", "use": "forgeWelcomeAction",
							  "with": { "icon": "file-search", "text": "Go to File...", "tip": "Find a file of the open folder by its name", "command": "quickOpen" },
							  "onClick": { "run": "quickOpen" } },
							{ "id": "welcome-commands", "use": "forgeWelcomeAction",
							  "with": { "icon": "command", "text": "Run a Command...", "tip": "Search every command of the workbench", "command": "showCommands" },
							  "onClick": { "run": "showCommands" } },
							{ "id": "welcome-recent-gap", "height": 18 },
							{ "type": "label", "id": "welcome-recent", "text": "Recent", "textColor": "@color.text", "fitText": true, "height": 24 },
							{ "type": "label", "id": "welcome-recent-none", "when": "{{empty(computed.welcomeRecent)}}", "text": "The files you open in this folder are listed here.",
							  "textColor": "@color.muted", "width": "100%", "height": 36, "wrap": true },
							{ "type": "row", "id": "{{'welcome-recent-' + fi}}",
							  "repeat": { "for": "file", "in": "{{computed.welcomeRecent}}", "index": "fi", "key": "{{file.id}}" }, "role": "link", "label": "{{'Open ' + file.id}}",
							  "width": "100%", "height": 26, "radius": 6, "alignItems": "center", "gap": 8, "focusable": true, "cursor": "hand",
							  "tooltip": "{{file.id}}", "hover": { "color": "@color.hover" }, "focused": { "color": "@color.hover" },
							  "onClick": { "run": "openPath", "with": { "path": "{{file.id}}", "label": "{{file.title}}" } },
							  "children": [
								{ "width": 2 },
								{ "type": "label", "icon": "file", "textColor": "@color.muted", "fitText": true },
								{ "type": "label", "id": "{{'welcome-recent-' + fi + '-name'}}", "text": "{{file.title}}", "textColor": "@color.accent", "fitText": true, "height": 20 },
								{ "type": "label", "text": "{{file.detail ?? ''}}", "textColor": "@color.muted", "grow": 1, "height": 20 }
							  ] }
						] },
						{ "type": "column", "id": "welcome-right", "grow": 1, "fitContent": "height", "gap": 4, "children": [
							{ "type": "label", "id": "welcome-walkthrough", "text": "Get started", "textColor": "@color.text", "fitText": true, "height": 24 },
							{ "id": "welcome-step-theme", "use": "forgeWelcomeStep",
							  "with": { "icon": "palette", "title": "Choose your look", "text": "A dark, a light or a high-contrast theme.", "done": "{{state.walkthrough.theme}}" },
							  "onClick": { "run": "welcomeStepTheme" } },
							{ "id": "welcome-step-folder", "use": "forgeWelcomeStep",
							  "with": { "icon": "folder-open", "title": "Open a folder", "text": "Its files, search, source control and terminal.", "done": "{{!empty(state.folder.root)}}" },
							  "onClick": { "run": "openFolder" } },
							{ "id": "welcome-step-live", "use": "forgeWelcomeStep",
							  "with": { "icon": "sparkles", "title": "Change Forge while it runs", "text": "Ask the agent: you review each change it proposes.", "done": "{{state.walkthrough.live}}" },
							  "onClick": { "run": "welcomeStepLive" } },
							{ "id": "welcome-step-keys", "use": "forgeWelcomeStep",
							  "with": { "icon": "keyboard", "title": "Learn the keys", "text": "Every keyboard shortcut, searchable.", "done": "{{state.walkthrough.keys}}" },
							  "onClick": { "run": "welcomeStepKeys" } },
							{ "id": "welcome-keys-gap", "height": 12 },
							{ "type": "label", "id": "welcome-keys", "text": "Keys", "textColor": "@color.text", "fitText": true, "height": 24 },
							{ "type": "row", "id": "{{'welcome-key-' + ki}}", "repeat": { "for": "k", "in": "{{computed.welcomeKeys}}", "index": "ki", "key": "{{k.name}}" },
							  "width": "100%", "height": 24, "alignItems": "center",
							  "children": [
								{ "type": "label", "text": "{{k.title}}", "textColor": "@color.muted", "grow": 1, "height": 24, "align": "start center" },
								{ "type": "label", "text": "{{k.key}}", "font": "code", "textColor": "@color.text", "fitText": true, "height": 20, "padding": 6,
								  "radius": 4, "borderWidth": 1, "borderColor": "@color.border" }
							  ] }
						] }
					] },
					{ "id": "welcome-bottom", "height": 32 }
					] },
					{ "id": "welcome-end", "grow": 1 }
				]
			}
		},
		"forgeWelcomeAction": {
			"params": { "icon": "", "text": "", "tip": "", "command": "" },
			"node": { "type": "row", "role": "button", "label": "{{text}}", "width": "100%", "height": 30, "radius": 6, "alignItems": "center", "gap": 8,
			          "focusable": true, "cursor": "hand", "tooltip": "{{tip}}", "hover": { "color": "@color.hover" }, "focused": { "color": "@color.hover" },
			          "children": [
				{ "width": 2 },
				{ "type": "label", "icon": "{{icon}}", "textColor": "@color.accent", "fitText": true },
				{ "type": "label", "text": "{{text}}", "textColor": "@color.accent", "grow": 1, "height": 20 },
				{ "type": "label", "text": "{{(find(commands, it.name == command) ?? {}).keyLabel ?? ''}}", "font": "code", "textColor": "@color.muted", "fitText": true, "height": 20 },
				{ "width": 6 }
			] }
		},
		"forgeWelcomeStep": {
			"params": { "icon": "", "title": "", "text": "", "done": false },
			"node": { "type": "row", "role": "button", "label": "{{title}}", "selected": "{{done}}", "width": "100%", "height": 48, "radius": 8,
			          "color": "@color.widget", "borderWidth": 1, "borderColor": "@color.border", "gap": 10, "focusable": true, "cursor": "hand",
			          "hover": { "color": "@color.hover", "borderColor": "@color.accent" }, "focused": { "borderColor": "@color.accent" },
			          "children": [
				{ "width": 2 },
				{ "type": "label", "icon": "{{done ? 'check-circle' : icon}}", "textColor": "{{done ? '@color.accent' : '@color.muted'}}", "width": 18, "height": 48, "align": "center" },
				{ "type": "column", "grow": 1, "height": 48, "children": [
					{ "height": 6 },
					{ "type": "label", "text": "{{title}}", "textColor": "@color.text", "width": "100%", "height": 18 },
					{ "type": "label", "text": "{{text}}", "textColor": "@color.muted", "width": "100%", "height": 18 }
				] },
				{ "width": 8 }
			] }
		},
		"forgeStatusItem": {
			"params": { "text": "", "icon": "", "tip": "" },
			"node": { "type": "label", "role": "button", "label": "{{tip}}", "text": "{{text}}", "icon": "{{icon}}", "padding": 7, "height": 20, "fitText": true, "radius": 5,
			          "cursor": "hand", "textColor": "@color.statusText", "tooltip": "{{tip}}", "hover": { "color": "@color.hover" } }
		},
		"forgeStatusBar": {
			"node": {
				"type": "row", "id": "status-bar", "role": "status", "label": "Status Bar", "point": "statusBar.right", "width": "100%", "height": 28, "color": "@color.statusBar", "alignItems": "center", "gap": 2,
				"children": [
					{ "id": "status-start", "width": 6 },
					{ "type": "label", "id": "status-remote", "role": "button", "label": "Document Server", "icon": "cloud", "width": 28, "height": 20, "radius": 5,
					  "align": "center", "cursor": "hand", "textColor": "@color.accent", "hover": { "color": "@color.hover" }, "tooltip": "Document Server: sign in to share and sync",
					  "onClick": { "run": "accountsMenu" } },
					{ "id": "status-branch", "use": "forgeStatusItem", "when": "{{!empty(state.scm.status.branch.head)}}",
					  "with": { "icon": "git-branch", "text": "{{computed.scmBranchText}}", "tip": "Show Branches" }, "onClick": { "run": "scmBranches" } },
					{ "id": "status-sync", "use": "forgeStatusItem", "when": "{{!empty(state.scm.status.branch.head)}}",
					  "with": { "icon": "refresh-cw", "tip": "Refresh Source Control" }, "onClick": { "run": "scmRefresh" } },
					{ "type": "label", "id": "status-problems", "role": "button", "label": "{{plural(computed.errors, 'error') + ', ' + plural(computed.warnings, 'warning')}}",
					  "runs": ["{{' '}}", { "icon": "circle-x" }, "{{' ' + text(computed.errors) + '  '}}", { "icon": "alert-triangle" }, "{{' ' + text(computed.warnings)}}"],
					  "padding": 7, "height": 20, "fitText": true, "radius": 5, "cursor": "hand", "textColor": "@color.statusText", "tooltip": "Problems (Cmd+Shift+M)",
					  "hover": { "color": "@color.hover" }, "onClick": { "run": "showProblems" } },
					{ "id": "status-gap", "grow": 1 },
					{ "id": "status-position", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "tip": "Go to Line", "text": "{{'Ln ' + text(state.caret.line) + ', Col ' + text(state.caret.column) + (state.caret.selected > 0 ? ' (' + text(state.caret.selected) + ' selected)' : '')}}" },
					  "onClick": { "run": "goToLinePick" } },
					{ "id": "status-indent", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "{{'Spaces: ' + text(settings.editor.tabSize ?? 4)}}", "tip": "Select Indentation" }, "onClick": { "run": "changeIndentation" } },
					{ "id": "status-encoding", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "UTF-8", "tip": "Encoding: UTF-8. Other encodings aren't available yet" }, "disabled": true, "cursor": "arrow", "textColor": "@color.muted" },
					{ "id": "status-eol", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "{{computed.activeDoc.eol ?? 'LF'}}", "tip": "Select End of Line Sequence" }, "onClick": { "run": "changeEndOfLine" } },
					{ "id": "status-language-status", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "icon": "braces", "tip": "Language Status" }, "onClick": { "run": "showOutput" } },
					{ "id": "status-language", "use": "forgeStatusItem", "when": "{{computed.activeDoc && computed.activeDoc.kind == 'file'}}",
					  "with": { "text": "{{computed.activeDoc.language || 'Plain Text'}}", "tip": "Select Language Mode" }, "onClick": { "run": "changeLanguageMode" } },
					{ "id": "status-notifications", "use": "forgeStatusItem", "with": { "icon": "{{length(state.notifications) > 0 ? 'bell-dot' : 'bell'}}", "tip": "Notifications" },
					  "onClick": { "run": "showNotifications" } },
					{ "id": "status-end", "width": 6 }
				]
			}
		},
		"forgeNotificationCentre": {
			"node": {
				"type": "column", "id": "notification-centre", "role": "dialog", "label": "Notifications", "width": 450,
				"height": "{{40 + max(1, min(6, length(state.notifications))) * 28}}", "color": "@color.widget", "borderWidth": 1, "borderColor": "@color.border", "radius": 8,
				"overlay": { "anchor": "#status-notifications", "placement": "above-end", "open": "state.notificationCentre", "dismiss": "outside" },
				"children": [
					{ "type": "row", "id": "notification-centre-head", "width": "100%", "height": 34, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "notification-centre-title", "text": "{{empty(state.notifications) ? 'NO NEW NOTIFICATIONS' : 'NOTIFICATIONS'}}",
						  "textColor": "@color.muted", "grow": 1, "padding": 10 },
						{ "id": "notification-centre-clear", "use": "forgeTitleButton", "with": { "icon": "list-x", "tip": "Clear All Notifications" },
						  "onClick": { "run": "clearNotifications" } },
						{ "id": "notification-centre-hide", "use": "forgeTitleButton", "with": { "icon": "chevron-down", "tip": "Hide Notifications" },
						  "onClick": { "set": "state.notificationCentre", "to": false } },
						{ "id": "notification-centre-end", "width": 4 }
					  ] },
					{ "type": "list", "id": "notifications", "label": "Notifications", "when": "{{!empty(state.notifications)}}", "width": "100%", "grow": 1,
					  "items": "{{computed.notificationRows}}", "rowHeight": 28, "color": "@color.widget", "textColor": "@color.text",
					  "selectedBackground": "@color.selection" }
				]
			}
		}
	}
}
