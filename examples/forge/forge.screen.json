{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,
	"note": "Forge, a demo IDE. This file only names the window, the fonts and the features; each feature (features/<name>/<name>.json) contributes its state, commands, menus, keys, settings, tokens and components, merged by include. The natives (forge.index, forge.openFolder, forge.read, forge.importTheme) are in Forge.cpp.",

	"window": {
		"title": "Forge", "width": 1200, "height": 760, "minWidth": 800, "minHeight": 500,
		"menuBar": [{ "menu": "file", "title": "File" }, { "menu": "view", "title": "View" }, { "menu": "go", "title": "Go" },
		            { "menu": "preferences", "title": "Preferences" }, { "menu": "help", "title": "Help" }]
	},

	"fonts": {
		"default": { "file": "../assets/fonts/Roboto-Regular.ttf", "size": 13, "fallback": ["icons"] },
		"title": { "file": "../assets/fonts/Roboto-Regular.ttf", "size": 28 },
		"icons": { "file": "../assets/fonts/Lucide.ttf", "size": 13 },
		"iconsLarge": { "file": "../assets/fonts/Lucide.ttf", "size": 22 },
		"code": { "file": "../assets/fonts/JetBrainsMono-Regular.ttf", "size": 13, "fallback": ["icons"] }
	},

	"include": ["features/themes/themes.json", "features/panels/panels.json", "features/palette/palette.json",
	            "features/shell/shell.json", "features/scm/scm.json"],

	"theme": "{{state.theme}}",

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"reviewers": ["studio"]
	},

	"persist": ["state.layout", "state.theme", "state.themes", "state.settings", "state.iconTheme"],

	"onLoad": [
		{ "call": "forge.index", "with": { "icons": "{{settings.workbench.fileIcons ? state.iconTheme : null}}" },
		  "into": "state.folder" }
	],

	"root": {
		"id": "root", "color": "@color.editor",
		"children": [
			{ "type": "column", "id": "workbench", "fill": true, "children": [
			{ "when": "{{!state.layout.zen}}", "use": "forgeTitleBar" },
			{ "type": "row", "id": "middle", "width": "100%", "grow": 1,
			  "children": [
				{ "when": "{{!state.layout.zen && settings.workbench.activityBar.visible}}", "use": "forgeActivityBar" },
				{ "type": "split", "id": "main-split", "grow": 1, "height": "100%", "bind": "state.layout.sizes", "minSize": 170,
				  "sashSize": 4, "sashColor": "@color.border", "sashActiveColor": "@color.accent",
				  "children": [
					{ "visible": "{{state.layout.sidebar && !state.layout.zen}}", "use": "forgeSideBar" },
					{ "type": "split", "id": "editor-split", "direction": "column", "bind": "state.layout.panelSizes", "minSize": 100,
					  "sashSize": 4, "sashColor": "@color.border", "sashActiveColor": "@color.accent",
					  "children": [
						{ "use": "forgeEditors" },
						{ "visible": "{{state.layout.panel && !state.layout.zen}}", "use": "forgePanel" }
					  ] }
				  ] }
			  ] },
			{ "when": "{{!state.layout.zen && settings.workbench.statusBar.visible}}", "use": "forgeStatusBar" }
			] },
			{ "use": "forgePalette" },
			{ "use": "toast", "with": { "open": "state.toast.open", "message": "{{state.toast.message}}",
				"progress": "{{state.toast.progress}}" } },
			{ "use": "dialog", "with": { "open": "state.about", "title": "Forge",
				"message": "A demo IDE built with AffrescoUI: its whole workbench is a screen document that people and agents change while it runs.",
				"buttons": [{ "title": "OK" }] } }
		]
	}
}
