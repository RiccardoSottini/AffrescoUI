{
	"screen": "index.screen.json",
	"cases": [
		{
			"name": "the studio changes the Launcher",
			"revision": { "author": "studio", "set": { "#sidebar/color": "#000000" } },
			"expect": "allow"
		},
		{
			"name": "an agent's change always waits for the person's review",
			"revision": { "author": "agent/claude-code", "set": { "#sidebar/color": "#000000" } },
			"expect": "ask",
			"reason": "the rule \"agent\" asks"
		},
		{
			"name": "a change to the live state waits too",
			"revision": { "author": "agent", "set": { "/state/page": "settings" } },
			"expect": "ask"
		},
		{
			"name": "another author's change waits",
			"revision": { "author": "features", "set": { "#sidebar/color": "#000000" } },
			"expect": "ask"
		},
		{
			"name": "no agent adds an accept to a button",
			"revision": {
				"author": "agent/claude-code",
				"set": { "#sidebar/onClick": [{ "accept": "latest" }] }
			},
			"expect": "deny",
			"reason": "can't add, change or move accept"
		},
		{
			"name": "no one widens what the Launcher may touch",
			"revision": {
				"author": "studio",
				"set": { "/services/home": { "provider": "fs", "root": "workspace" } }
			},
			"expect": "deny",
			"reason": "can't change \"services\""
		},
		{
			"name": "no one changes the permissions",
			"revision": { "author": "studio", "set": { "/permissions/allow": ["*"] } },
			"expect": "deny",
			"reason": "can't change \"permissions\""
		}
	]
}
