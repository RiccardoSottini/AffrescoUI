{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,

	"note": "Arcadia: a game launcher. A library of games with covers, collections and filters, details, play stats and a settings page. Built from the public docs only; see README.md next to it.",

	"window": {
		"title": "Arcadia: a game launcher built with AffrescoUI",
		"width": 1280,
		"height": 800,
		"minWidth": 960,
		"minHeight": 600,
		"menuBar": [
			{ "menu": "game", "title": "Game" },
			{ "menu": "view", "title": "View" }
		],
		"focusRing": "#7c5cff"
	},

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "fallback": ["icons"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["icons"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 22, "fallback": ["icons"] },
		"big": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 30 },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 16 }
	},

	"include": ["../shared/components/charts.json"],

	"tokens": {
		"space.s": 8,
		"space.m": 12,
		"space.l": 20,
		"radius.s": 6,
		"radius.card": 10,
		"color.bg": { "dark": "#0f1115", "light": "#f4f4f6" },
		"color.surface": { "dark": "#171a21", "light": "#ffffff" },
		"color.raised": { "dark": "#222633", "light": "#eceef3" },
		"color.border": { "dark": "#2a2f3b", "light": "#e2e4ea" },
		"color.text": { "dark": "#e8eaf0", "light": "#16181d" },
		"color.muted": { "dark": "#8a92a6", "light": "#6b7180" },
		"color.accent": "#7c5cff",
		"color.accentHover": "#9479ff",
		"color.accentSoft": { "dark": "#2a2452", "light": "#ebe6ff" },
		"color.good": "#30a46c",
		"color.danger": "#e5484d",
		"color.chart": { "dark": "#7c5cff", "light": "#6a4cf0" },
		"color.chartFill": { "dark": "#7c5cff55", "light": "#7c5cff40" }
	},

	"theme": "{{settings.appearance.theme}}",

	"styles": {
		"button": {
			"type": "label",
			"height": 32,
			"padding": 12,
			"fitText": true,
			"align": "center",
			"radius": "@radius.s",
			"color": "@color.raised",
			"textColor": "@color.text",
			"cursor": "hand",
			"focusable": true,
			"hover": { "color": "@color.border" },
			"transition": { "color": 120 }
		},
		"primary": {
			"style": "button",
			"color": "@color.accent",
			"textColor": "#ffffff",
			"hover": { "color": "@color.accentHover" }
		},
		"muted": { "type": "label", "font": "small", "textColor": "@color.muted" },
		"heading": { "type": "label", "font": "small", "textColor": "@color.muted", "height": 20, "fitText": true },
		"card": { "color": "@color.surface", "radius": "@radius.card", "borderWidth": 1, "borderColor": "@color.border" }
	},

	"components": {
		"statCard": {
			"params": { "value": "", "caption": "", "icon": "" },
			"node": {
				"style": "card",
				"height": 88,
				"grow": 1,
				"children": [
					{ "id": "stat-value", "type": "label", "font": "big", "text": "{{value}}", "textColor": "@color.text", "anchors": { "left": 16, "top": 12 }, "fitText": true },
					{ "id": "stat-caption", "type": "label", "style": "muted", "icon": "{{icon}}", "text": "{{caption}}", "anchors": { "left": 16, "bottom": 12 }, "fitText": true }
				]
			}
		}
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent"],
		"reviewers": ["studio"]
	},

	"settings": {
		"appearance.theme": { "type": "string", "enum": ["dark", "light"], "default": "dark", "title": "Theme", "description": "Dark or light colours for the whole launcher." },
		"library.coverSize": { "type": "number", "minimum": 120, "maximum": 220, "default": 150, "title": "Cover size", "description": "The width of a cover in the library grid, in pixels." },
		"library.showUninstalled": { "type": "boolean", "default": true, "title": "Show games that aren't installed", "description": "List every game you own, installed or not." },
		"library.sortBy": { "type": "string", "enum": ["title", "hours"], "default": "title", "title": "Sort the library by", "description": "Title, A to Z, or the hours played, most first." },
		"launcher.confirmUninstall": { "type": "boolean", "default": true, "title": "Ask before uninstalling", "description": "Show a confirmation before a game is removed from this computer." }
	},

	"stateTypes": {
		"view": { "enum": ["library", "stats", "settings"] },
		"layout": { "enum": ["grid", "table"] },
		"games": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "title", "genre", "cover", "hours"],
				"properties": {
					"id": { "type": "string" },
					"title": { "type": "string" },
					"genre": { "type": "string" },
					"developer": { "type": "string" },
					"cover": { "type": "string" },
					"hours": { "type": "number", "minimum": 0 },
					"lastPlayed": { "type": "string" },
					"installed": { "type": "boolean" },
					"favourite": { "type": "boolean" },
					"sizeGb": { "type": "number" },
					"week": { "type": "array", "items": { "type": "number" } },
					"blurb": { "type": "string" }
				}
			}
		}
	},

	"state": {
		"view": "library",
		"layout": "grid",
		"filter": "all",
		"query": "",
		"selected": "starfall",
		"sizes": [210, 640],
		"expanded": ["genres"],
		"sort": null,
		"viewMenu": false,
		"ctxOpen": false,
		"ctx": { "x": 0, "y": 0 },
		"confirm": false,
		"toast": { "open": false, "message": "", "progress": null },
		"settingsQuery": "",
		"quickPick": { "open": false, "query": "", "index": 0, "top": 0, "recent": [] },
		"settings": {},
		"genres": ["Action", "Adventure", "Racing", "RPG", "Strategy"],
		"weekDays": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
		"games": [
			{ "id": "starfall", "title": "Starfall Odyssey", "genre": "RPG", "developer": "Lantern Works", "cover": "covers/starfall.svg", "hours": 86.5, "lastPlayed": "20 Oct", "installed": true, "favourite": true, "sizeGb": 48.2, "week": [1.5, 2, 0, 3, 1, 4.5, 2], "blurb": "Chart a course through a dying galaxy, recruit a crew of misfits and decide which stars go dark." },
			{ "id": "ember", "title": "Ember Knights", "genre": "Action", "developer": "Forge & Feather", "cover": "covers/ember.svg", "hours": 41, "lastPlayed": "18 Oct", "installed": true, "favourite": false, "sizeGb": 12.6, "week": [0, 1, 1.5, 0, 2, 3, 0.5], "blurb": "A fast co-op brawler: three knights, one burning keep, no second chances." },
			{ "id": "tidebreaker", "title": "Tidebreaker", "genre": "Adventure", "developer": "Low Tide", "cover": "covers/tidebreaker.svg", "hours": 23.5, "lastPlayed": "12 Oct", "installed": true, "favourite": true, "sizeGb": 9.1, "week": [0, 0, 0.5, 0, 0, 1, 0], "blurb": "Sail a patched-up boat between drowned islands and read the sea to find the way home." },
			{ "id": "neon", "title": "Neon Drift", "genre": "Racing", "developer": "Gridline", "cover": "covers/neon.svg", "hours": 64, "lastPlayed": "19 Oct", "installed": true, "favourite": false, "sizeGb": 22.4, "week": [2, 1, 2.5, 1.5, 0, 2, 3], "blurb": "Night races on endless synth highways, tuned to the beat of the soundtrack." },
			{ "id": "mossheart", "title": "Mossheart", "genre": "Adventure", "developer": "Small Grove", "cover": "covers/mossheart.svg", "hours": 12, "lastPlayed": "3 Oct", "installed": false, "favourite": false, "sizeGb": 4.3, "week": [0, 0, 0, 0, 0, 0, 0], "blurb": "A quiet forest tale about a golem who wakes up covered in moss and wants to know why." },
			{ "id": "ironhollow", "title": "Iron Hollow", "genre": "Strategy", "developer": "Blackrock Games", "cover": "covers/ironhollow.svg", "hours": 132, "lastPlayed": "17 Oct", "installed": true, "favourite": true, "sizeGb": 31, "week": [3, 2, 0, 4, 2.5, 0, 5], "blurb": "Build a mining town under the mountain and keep it alive through forty winters." },
			{ "id": "skyward", "title": "Skyward Isles", "genre": "RPG", "developer": "Lantern Works", "cover": "covers/skyward.svg", "hours": 7.5, "lastPlayed": "28 Sep", "installed": false, "favourite": false, "sizeGb": 36.8, "week": [0, 0, 0, 0, 0, 0, 0], "blurb": "Floating islands, airships and a sky that falls one piece at a time." },
			{ "id": "quietorbit", "title": "Quiet Orbit", "genre": "Strategy", "developer": "Halfmoon", "cover": "covers/quietorbit.svg", "hours": 19, "lastPlayed": "15 Oct", "installed": true, "favourite": false, "sizeGb": 2.7, "week": [1, 0, 0.5, 0, 1, 0, 0], "blurb": "Run a space station for one hundred days, where every decision costs oxygen." }
		],
		"sessions": [
			{ "id": "s1", "label": "Starfall Odyssey  ·  2 h  ·  Sun 20 Oct" },
			{ "id": "s2", "label": "Neon Drift  ·  3 h  ·  Sat 19 Oct" },
			{ "id": "s3", "label": "Ember Knights  ·  30 min  ·  Fri 18 Oct" },
			{ "id": "s4", "label": "Iron Hollow  ·  5 h  ·  Thu 17 Oct" },
			{ "id": "s5", "label": "Quiet Orbit  ·  1 h  ·  Tue 15 Oct" },
			{ "id": "s6", "label": "Tidebreaker  ·  1 h  ·  Sat 12 Oct" }
		]
	},

	"computed": {
		"matches": "{{filter(state.games, (state.filter == 'all' || (state.filter == 'installed' && it.installed) || (state.filter == 'favourites' && it.favourite) || it.genre == state.filter) && (empty(state.query) || fuzzy(state.query, it.title) != null) && (settings.library.showUninstalled || it.installed))}}",
		"visible": "{{settings.library.sortBy == 'hours' ? sort(computed.matches, it.hours, 'desc') : sort(computed.matches, it.title)}}",
		"game": "{{find(state.games, it.id == state.selected)}}",
		"totalHours": "{{sum(state.games, it.hours)}}",
		"installedCount": "{{count(state.games, it.installed)}}",
		"weekTotals": "{{map(state.weekDays, sum(map(state.games, it.week), 0))}}",
		"weekHours": "{{[sum(state.games, it.week[0]), sum(state.games, it.week[1]), sum(state.games, it.week[2]), sum(state.games, it.week[3]), sum(state.games, it.week[4]), sum(state.games, it.week[5]), sum(state.games, it.week[6])]}}",
		"byHours": "{{sort(state.games, it.hours, 'desc')}}",
		"collections": "{{[{ id: 'all', label: 'All games  ' + length(state.games) }, { id: 'installed', label: 'Installed  ' + computed.installedCount }, { id: 'favourites', label: 'Favourites  ' + count(state.games, it.favourite) }, { id: 'genres', label: 'Genres', children: map(state.genres, { id: it, label: it }) }]}}",
		"rows": "{{map(computed.visible, { id: it.id, cells: [it.title, it.genre, it.hours, it.lastPlayed, it.installed ? 'Installed' : fixed(it.sizeGb, 1) + ' GB'] })}}"
	},

	"actions": {
		"play": {
			"title": "Play",
			"category": "Game",
			"icon": "play",
			"enablement": "{{computed.game.installed}}",
			"description": "Launch the selected game.",
			"do": [
				{ "forEach": "state.games", "as": "g", "index": "i", "do": [
					{ "if": "{{g.id == state.selected}}", "then": [
						{ "increment": "state.games[i].hours", "by": 0.5 },
						{ "set": "state.games[i].lastPlayed", "to": "Today" }
					] }
				] },
				{ "run": "notify", "with": { "message": "Launching {{computed.game.title}}…", "loading": true } }
			]
		},
		"install": {
			"title": "Install",
			"category": "Game",
			"icon": "download",
			"enablement": "{{!computed.game.installed}}",
			"do": [
				{ "forEach": "state.games", "as": "g", "index": "i", "do": [
					{ "if": "{{g.id == state.selected}}", "then": [{ "set": "state.games[i].installed", "to": true }] }
				] },
				{ "run": "notify", "with": { "message": "Installing {{computed.game.title}} ({{fixed(computed.game.sizeGb, 1)}} GB)", "loading": true } }
			]
		},
		"toggleFavourite": {
			"title": "Toggle favourite",
			"category": "Game",
			"icon": "heart",
			"do": [
				{ "forEach": "state.games", "as": "g", "index": "i", "do": [
					{ "if": "{{g.id == state.selected}}", "then": [{ "toggle": "state.games[i].favourite" }] }
				] }
			]
		},
		"uninstall": {
			"title": "Uninstall…",
			"category": "Game",
			"icon": "trash-2",
			"enablement": "{{computed.game.installed}}",
			"do": [
				{ "if": "{{settings.launcher.confirmUninstall}}", "then": [{ "set": "state.confirm", "to": true }], "else": [{ "run": "removeGame" }] }
			]
		},
		"removeGame": [
			{ "set": "state.confirm", "to": false },
			{ "forEach": "state.games", "as": "g", "index": "i", "do": [
				{ "if": "{{g.id == state.selected}}", "then": [{ "set": "state.games[i].installed", "to": false }] }
			] },
			{ "run": "notify", "with": { "message": "{{computed.game.title}} was uninstalled", "loading": false } }
		],
		"notify": [
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}", "progress": "{{loading ? 0 : null}}" } },
			{ "if": "{{loading}}", "then": [{ "animate": "state.toast.progress", "to": 1, "ms": 1200, "easing": "out" }] },
			{ "debounce": 2400, "do": [{ "set": "state.toast.open", "to": false }] }
		],
		"showLibrary": { "title": "Show the library", "category": "View", "icon": "library", "do": [{ "set": "state.view", "to": "library" }] },
		"showStats": { "title": "Show play stats", "category": "View", "icon": "chart-column", "do": [{ "set": "state.view", "to": "stats" }] },
		"showSettings": { "title": "Open settings", "category": "View", "icon": "settings", "do": [{ "set": "state.view", "to": "settings" }] },
		"gridView": { "title": "Show covers", "category": "View", "icon": "layout-grid", "do": [{ "set": "state.layout", "to": "grid" }] },
		"tableView": { "title": "Show a table", "category": "View", "icon": "table", "do": [{ "set": "state.layout", "to": "table" }] },
		"toggleTheme": {
			"title": "Toggle light and dark",
			"category": "View",
			"icon": "sun-moon",
			"do": [{ "set": "settings.appearance.theme", "to": "{{settings.appearance.theme == 'dark' ? 'light' : 'dark'}}" }]
		},
		"goToGame": {
			"title": "Go to a game…",
			"category": "View",
			"icon": "search",
			"do": [{ "set": "state.quickPick", "to": { "open": true, "query": "", "index": 0, "top": 0, "recent": "{{state.quickPick.recent}}" } }]
		},
		"commandPalette": {
			"title": "Show all commands",
			"category": "View",
			"icon": "command",
			"do": [{ "set": "state.quickPick", "to": { "open": true, "query": ">", "index": 0, "top": 0, "recent": "{{state.quickPick.recent}}" } }]
		},
		"pickGame": [
			{ "set": "state.selected", "to": "{{item.id}}" },
			{ "set": "state.view", "to": "library" }
		],
		"runCommand": [{ "run": "{{item.name}}" }],
		"openContextMenu": [
			{ "set": "state.ctx", "to": { "x": "{{event.x}}", "y": "{{event.y}}" } },
			{ "set": "state.ctxOpen", "to": true }
		],
		"openStore": [{ "run": "notify", "with": { "message": "The store page for {{computed.game.title}} would open here", "loading": false } }]
	},

	"keys": {
		"mod+p": "goToGame",
		"mod+shift+p": "commandPalette",
		"mod+1": "showLibrary",
		"mod+2": "showStats",
		"mod+3": "showSettings",
		"mod+enter": "play",
		"mod+d": "toggleFavourite",
		"mod+k mod+t": "toggleTheme"
	},

	"menus": {
		"game": {
			"play": { "run": "play", "group": "1_play", "order": 1 },
			"install": { "run": "install", "group": "1_play", "order": 2, "when": "{{!computed.game.installed}}" },
			"favourite": { "run": "toggleFavourite", "group": "2_library" },
			"uninstall": { "run": "uninstall", "group": "3_danger", "when": "{{computed.game.installed}}" }
		},
		"view": {
			"library": { "run": "showLibrary", "group": "1_views", "order": 1 },
			"stats": { "run": "showStats", "group": "1_views", "order": 2 },
			"settings": { "run": "showSettings", "group": "1_views", "order": 3 },
			"grid": { "run": "gridView", "group": "2_layout", "order": 1 },
			"table": { "run": "tableView", "group": "2_layout", "order": 2 },
			"theme": { "run": "toggleTheme", "group": "3_look" },
			"palette": { "run": "commandPalette", "group": "4_go", "order": 1 },
			"go": { "run": "goToGame", "group": "4_go", "order": 2 }
		}
	},

	"root": {
		"id": "app",
		"color": "@color.bg",
		"children": [
			{
				"id": "top-bar",
				"type": "row",
				"anchors": { "left": 0, "right": 0, "top": 0 },
				"height": 56,
				"color": "@color.surface",
				"alignItems": "center",
				"gap": "@space.m",
				"children": [
					{ "id": "top-bar-start", "width": 4, "height": 1, "color": "transparent" },
					{ "id": "logo", "type": "label", "font": "title", "icon": "gamepad-2", "text": "Arcadia", "textColor": "@color.text", "fitText": true, "height": 32 },
					{
						"id": "view-tabs",
						"type": "tabs",
						"width": 330,
						"height": 40,
						"tabs": [
							{ "id": "library", "label": "Library", "closable": false },
							{ "id": "stats", "label": "Play stats", "closable": false },
							{ "id": "settings", "label": "Settings", "closable": false }
						],
						"bind": "state.view",
						"color": "@color.surface",
						"textColor": "@color.muted",
						"activeTextColor": "@color.text",
						"activeBackground": "@color.raised",
						"accentColor": "@color.accent"
					},
					{ "id": "top-bar-spacer", "grow": 1, "height": 1, "color": "transparent" },
					{
						"id": "search",
						"type": "textarea",
						"width": 240,
						"height": 32,
						"padding": 10,
						"radius": "@radius.s",
						"color": "@color.raised",
						"textColor": "@color.text",
						"placeholder": "Filter the library",
						"placeholderColor": "@color.muted",
						"bind": "state.query",
						"keys": { "escape": [{ "set": "state.query", "to": "" }] }
					},
					{ "id": "palette-button", "style": "button", "icon": "command", "text": "Commands", "tooltip": "Show all commands (mod+shift+P)", "onClick": "commandPalette" },
					{
						"id": "view-menu-button",
						"style": "button",
						"icon": "ellipsis",
						"tooltip": "More",
						"role": "button",
						"label": "More",
						"onClick": [{ "toggle": "state.viewMenu" }],
						"children": [
							{ "id": "view-menu", "use": "menu", "with": { "items": "{{menus.view}}", "open": "state.viewMenu", "placement": "below-end", "width": 240, "color": "@color.surface", "textColor": "@color.text", "dimColor": "@color.muted", "highlight": "@color.accentSoft" } }
						]
					},
					{ "id": "top-bar-end", "width": 4, "height": 1, "color": "transparent" }
				]
			},
			{ "id": "top-bar-line", "anchors": { "left": 0, "right": 0, "top": 56 }, "height": 1, "color": "@color.border" },

			{
				"id": "library",
				"when": "{{state.view == 'library'}}",
				"type": "split",
				"anchors": { "left": 0, "right": 0, "top": 57, "bottom": 0 },
				"color": "transparent",
				"bind": "state.sizes",
				"defaultSizes": [210, 640],
				"minSize": [160, 360, 280],
				"sashSize": 1,
				"sashColor": "@color.border",
				"sashActiveColor": "@color.accent",
				"children": [
					{
						"id": "sidebar",
						"color": "@color.surface",
						"children": [
							{ "id": "sidebar-heading", "style": "heading", "text": "COLLECTIONS", "anchors": { "left": 16, "top": 16, "right": 16 } },
							{
								"id": "collections",
								"type": "tree",
								"anchors": { "left": 8, "right": 8, "top": 44, "bottom": 8 },
								"items": "{{computed.collections}}",
								"expanded": "{{state.expanded}}",
								"bind": "state.filter",
								"rowHeight": 30,
								"color": "transparent",
								"textColor": "@color.text",
								"selectedTextColor": "@color.text",
								"selectedBackground": "@color.accentSoft",
								"accentColor": "@color.accent",
								"onExpand": [{ "set": "state.expanded", "to": "{{event.expanded ? concat(state.expanded, [event.id]) : filter(state.expanded, it != event.id)}}" }]
							}
						]
					},
					{
						"id": "library-main",
						"color": "transparent",
						"children": [
							{
								"id": "library-toolbar",
								"type": "row",
								"anchors": { "left": 20, "right": 20, "top": 12 },
								"height": 36,
								"alignItems": "center",
								"gap": "@space.s",
								"children": [
									{
										"id": "library-count",
										"type": "label",
										"fitText": true,
										"height": 24,
										"textColor": "@color.text",
										"runs": [
											{ "text": "{{plural(length(computed.visible), 'game')}}", "bold": true },
											{ "text": "{{empty(state.query) ? '' : '  matching “' + state.query + '”'}}", "color": "@color.muted" }
										]
									},
									{ "id": "library-toolbar-spacer", "grow": 1, "height": 1, "color": "transparent" },
									{ "id": "grid-button", "style": "button", "icon": "layout-grid", "tooltip": "Covers", "label": "Covers", "role": "button", "color": "{{state.layout == 'grid' ? '@color.accentSoft' : '@color.raised'}}", "onClick": "gridView" },
									{ "id": "table-button", "style": "button", "icon": "table", "tooltip": "Table", "label": "Table", "role": "button", "color": "{{state.layout == 'table' ? '@color.accentSoft' : '@color.raised'}}", "onClick": "tableView" }
								]
							},
							{
								"id": "covers",
								"when": "{{state.layout == 'grid'}}",
								"anchors": { "left": 0, "right": 0, "top": 56, "bottom": 0 },
								"color": "transparent",
								"scroll": "vertical",
								"children": [
									{
										"id": "cover-grid",
										"type": "row",
										"wrap": true,
										"gap": "@space.l",
										"anchors": { "left": 20, "right": 20, "top": 4 },
										"height": "{{(floor(length(computed.visible) / max(1, floor((nodes['library-main'].width - 40 + 20) / (settings.library.coverSize + 20)))) + 1) * (settings.library.coverSize * 4 / 3 + 72)}}",
										"children": [
											{
												"id": "game-card",
												"repeat": { "for": "game", "in": "computed.visible", "key": "{{game.id}}" },
												"type": "column",
												"width": "{{settings.library.coverSize}}",
												"height": "{{settings.library.coverSize * 4 / 3 + 52}}",
												"gap": 6,
												"color": "transparent",
												"focusable": true,
												"role": "button",
												"label": "{{game.title}}",
												"cursor": "hand",
												"onClick": [{ "set": "state.selected", "to": "{{game.id}}" }],
												"onDoubleClick": [{ "set": "state.selected", "to": "{{game.id}}" }, { "run": "play" }],
												"onContextMenu": [{ "set": "state.selected", "to": "{{game.id}}" }, { "run": "openContextMenu" }],
												"children": [
													{
														"id": "game-cover-frame",
														"width": "{{settings.library.coverSize}}",
														"height": "{{settings.library.coverSize * 4 / 3}}",
														"radius": "@radius.card",
														"color": "@color.raised",
														"borderWidth": "{{game.id == state.selected ? 3 : 0}}",
														"borderColor": "@color.accent",
														"shadow": { "y": 6, "blur": 14, "color": "#00000050" },
														"children": [
															{ "id": "game-cover", "type": "image", "file": "{{game.cover}}", "fit": "cover", "fill": "{{game.id == state.selected ? 3 : 0}}" },
															{ "id": "game-fav", "when": "{{game.favourite}}", "type": "label", "font": "icons", "icon": "heart", "textColor": "#ff6b8a", "anchors": { "right": 10, "top": 8 }, "fitText": true },
															{ "id": "game-not-installed", "when": "{{!game.installed}}", "type": "label", "font": "small", "icon": "cloud-download", "text": "Not installed", "textColor": "#ffffff", "color": "#000000a0", "radius": 4, "padding": 6, "fitText": true, "anchors": { "left": 8, "bottom": 8 } }
														]
													},
													{ "id": "game-title", "type": "label", "text": "{{game.title}}", "textColor": "@color.text", "width": "{{settings.library.coverSize}}", "height": 18 },
													{ "id": "game-meta", "style": "muted", "text": "{{game.genre}}  ·  {{game.hours}} h", "width": "{{settings.library.coverSize}}", "height": 16 }
												]
											}
										]
									}
								]
							},
							{
								"id": "games-table",
								"when": "{{state.layout == 'table'}}",
								"type": "table",
								"anchors": { "left": 20, "right": 20, "top": 56, "bottom": 20 },
								"columns": [
									{ "id": "title", "title": "Title", "width": 220 },
									{ "id": "genre", "title": "Genre", "width": 110 },
									{ "id": "hours", "title": "Hours", "width": 80 },
									{ "id": "last", "title": "Last played", "width": 110 },
									{ "id": "status", "title": "Status", "width": 110 }
								],
								"items": "{{computed.rows}}",
								"bind": "state.selected",
								"sort": "{{state.sort}}",
								"rowHeight": 30,
								"color": "@color.surface",
								"radius": "@radius.s",
								"textColor": "@color.text",
								"selectedTextColor": "@color.text",
								"selectedBackground": "@color.accentSoft",
								"accentColor": "@color.accent",
								"onOpen": "play",
								"onSort": [{ "set": "state.sort", "to": { "column": "{{event.column}}", "descending": "{{event.descending}}" } }],
								"onContextMenu": "openContextMenu"
							}
						]
					},
					{
						"id": "details",
						"color": "@color.surface",
						"scroll": "vertical",
						"children": [
							{
								"id": "details-column",
								"type": "column",
								"anchors": { "left": 20, "right": 20, "top": 20 },
								"height": 760,
								"gap": "@space.m",
								"children": [
									{ "id": "details-cover", "type": "image", "file": "{{computed.game.cover}}", "fit": "cover", "height": 200, "anchors": { "left": 0, "right": 0 }, "radius": "@radius.card" },
									{ "id": "details-title", "type": "label", "font": "title", "text": "{{computed.game.title}}", "textColor": "@color.text", "height": 30, "anchors": { "left": 0, "right": 0 } },
									{
										"id": "details-byline",
										"type": "label",
										"height": 20,
										"anchors": { "left": 0, "right": 0 },
										"textColor": "@color.muted",
										"runs": [
											{ "text": "{{computed.game.developer}}", "bold": true, "color": "@color.text" },
											{ "text": "  ·  {{computed.game.genre}}  ·  " },
											{ "text": "Store page ", "link": "store", "color": "@color.accent" },
											{ "icon": "external-link", "link": "store", "color": "@color.accent" }
										],
										"onLink": "openStore"
									},
									{ "id": "details-blurb", "type": "label", "wrap": true, "text": "{{computed.game.blurb}}", "textColor": "@color.text", "height": 60, "anchors": { "left": 0, "right": 0 } },
									{
										"id": "details-actions",
										"type": "row",
										"height": 36,
										"gap": "@space.s",
										"anchors": { "left": 0, "right": 0 },
										"children": [
											{ "id": "play-button", "when": "{{computed.game.installed}}", "style": "primary", "icon": "play", "text": "Play", "height": 36, "onClick": "play" },
											{ "id": "install-button", "when": "{{!computed.game.installed}}", "style": "primary", "icon": "download", "text": "Install  {{fixed(computed.game.sizeGb, 1)}} GB", "height": 36, "onClick": "install" },
											{ "id": "favourite-button", "style": "button", "height": 36, "icon": "heart", "text": "{{computed.game.favourite ? 'Favourite' : 'Add to favourites'}}", "textColor": "{{computed.game.favourite ? '#ff6b8a' : '@color.text'}}", "onClick": "toggleFavourite" },
											{ "id": "uninstall-button", "when": "{{computed.game.installed}}", "style": "button", "height": 36, "icon": "trash-2", "tooltip": "Uninstall", "label": "Uninstall", "onClick": "uninstall" }
										]
									},
									{
										"id": "details-stats",
										"type": "row",
										"height": 64,
										"gap": "@space.s",
										"anchors": { "left": 0, "right": 0 },
										"children": [
											{ "id": "details-hours", "style": "card", "grow": 1, "height": 64, "children": [
												{ "id": "details-hours-value", "type": "label", "font": "title", "text": "{{computed.game.hours}} h", "textColor": "@color.text", "anchors": { "left": 12, "top": 8 }, "fitText": true },
												{ "id": "details-hours-caption", "style": "muted", "text": "played", "anchors": { "left": 12, "bottom": 8 }, "fitText": true }
											] },
											{ "id": "details-last", "style": "card", "grow": 1, "height": 64, "children": [
												{ "id": "details-last-value", "type": "label", "font": "title", "text": "{{computed.game.lastPlayed}}", "textColor": "@color.text", "anchors": { "left": 12, "top": 8 }, "fitText": true },
												{ "id": "details-last-caption", "style": "muted", "text": "last played", "anchors": { "left": 12, "bottom": 8 }, "fitText": true }
											] }
										]
									},
									{ "id": "details-week-heading", "style": "heading", "text": "THIS WEEK  ·  {{sum(computed.game.week)}} h", "anchors": { "left": 0, "right": 0 } },
									{ "id": "details-week-chart", "use": "areaChart", "with": { "values": "{{computed.game.week}}", "top": 6, "color": "@color.chartFill" }, "height": 80, "anchors": { "left": 0, "right": 0 } },
									{
										"id": "details-week-days",
										"type": "row",
										"height": 16,
										"justify": "space-between",
										"anchors": { "left": 0, "right": 0 },
										"children": [
											{ "id": "details-week-day", "repeat": { "for": "day", "in": "state.weekDays" }, "style": "muted", "text": "{{day}}", "fitText": true }
										]
									}
								]
							}
						]
					}
				]
			},

			{
				"id": "stats",
				"when": "{{state.view == 'stats'}}",
				"anchors": { "left": 0, "right": 0, "top": 57, "bottom": 0 },
				"color": "transparent",
				"scroll": "vertical",
				"children": [
					{
						"id": "stats-column",
						"type": "column",
						"anchors": { "left": 32, "right": 32, "top": 24 },
						"height": 700,
						"gap": "@space.l",
						"children": [
							{
								"id": "stats-cards",
								"type": "row",
								"height": 88,
								"gap": "@space.l",
								"anchors": { "left": 0, "right": 0 },
								"children": [
									{ "id": "stat-total", "use": "statCard", "with": { "value": "{{round(computed.totalHours)}} h", "caption": "played in all", "icon": "clock" } },
									{ "id": "stat-week", "use": "statCard", "with": { "value": "{{sum(computed.weekHours)}} h", "caption": "this week", "icon": "calendar" } },
									{ "id": "stat-installed", "use": "statCard", "with": { "value": "{{computed.installedCount}} / {{length(state.games)}}", "caption": "installed", "icon": "hard-drive" } },
									{ "id": "stat-top", "use": "statCard", "with": { "value": "{{computed.byHours[0].title}}", "caption": "most played", "icon": "trophy" } }
								]
							},
							{
								"id": "stats-charts",
								"type": "row",
								"height": 280,
								"gap": "@space.l",
								"anchors": { "left": 0, "right": 0 },
								"children": [
									{
										"id": "hours-card",
										"style": "card",
										"grow": 1,
										"height": 280,
										"children": [
											{ "id": "hours-heading", "style": "heading", "text": "HOURS PER GAME", "anchors": { "left": 16, "top": 14 } },
											{ "id": "hours-chart", "use": "barChart", "with": { "values": "{{map(computed.byHours, it.hours)}}", "color": "@color.chart", "gap": 0.35 }, "anchors": { "left": 16, "right": 16, "top": 44, "bottom": 56 } },
											{
												"id": "hours-legend",
												"type": "row",
												"anchors": { "left": 16, "right": 16, "bottom": 16 },
												"height": 32,
												"children": [
													{ "id": "hours-legend-item", "repeat": { "for": "g", "in": "computed.byHours" }, "type": "label", "font": "small", "wrap": true, "align": "center", "grow": 1, "basis": 0, "height": 32, "text": "{{g.title}}", "textColor": "@color.muted" }
												]
											}
										]
									},
									{
										"id": "week-card",
										"style": "card",
										"grow": 1,
										"height": 280,
										"children": [
											{ "id": "week-heading", "style": "heading", "text": "THIS WEEK, ALL GAMES", "anchors": { "left": 16, "top": 14 } },
											{ "id": "week-area", "use": "areaChart", "with": { "values": "{{computed.weekHours}}", "color": "@color.chartFill" }, "anchors": { "left": 16, "right": 16, "top": 44, "bottom": 40 } },
											{ "id": "week-line", "use": "lineChart", "with": { "values": "{{computed.weekHours}}", "color": "@color.chart", "lineWidth": 2.5 }, "anchors": { "left": 16, "right": 16, "top": 44, "bottom": 40 } },
											{
												"id": "week-days",
												"type": "row",
												"anchors": { "left": 16, "right": 16, "bottom": 14 },
												"height": 16,
												"justify": "space-between",
												"children": [
													{ "id": "week-day", "repeat": { "for": "day", "in": "state.weekDays" }, "style": "muted", "text": "{{day}}", "fitText": true }
												]
											}
										]
									}
								]
							},
							{ "id": "sessions-heading", "style": "heading", "text": "RECENT SESSIONS", "anchors": { "left": 0, "right": 0 } },
							{
								"id": "sessions",
								"type": "list",
								"height": 200,
								"anchors": { "left": 0, "right": 0 },
								"items": "{{state.sessions}}",
								"rowHeight": 32,
								"selection": "none",
								"color": "@color.surface",
								"radius": "@radius.s",
								"textColor": "@color.text",
								"accentColor": "@color.accent"
							}
						]
					}
				]
			},

			{
				"id": "settings",
				"when": "{{state.view == 'settings'}}",
				"anchors": { "left": 0, "right": 0, "top": 57, "bottom": 0 },
				"color": "@color.bg",
				"children": [
					{
						"id": "settings-page",
						"use": "settingsPage",
						"with": { "query": "state.settingsQuery", "color": "@color.surface", "textColor": "@color.text", "dimColor": "@color.muted", "accent": "@color.accent", "field": "@color.raised" },
						"anchors": { "left": 32, "right": 32, "top": 24, "bottom": 24 }
					}
				]
			},

			{
				"id": "game-menu",
				"use": "contextMenu",
				"with": { "items": "{{menus.game}}", "open": "state.ctxOpen", "x": "{{state.ctx.x}}", "y": "{{state.ctx.y}}", "width": 220, "color": "@color.surface", "textColor": "@color.text", "dimColor": "@color.muted", "highlight": "@color.accentSoft" }
			},
			{
				"id": "uninstall-dialog",
				"use": "dialog",
				"with": {
					"open": "state.confirm",
					"title": "Uninstall {{computed.game.title}}?",
					"message": "This frees {{fixed(computed.game.sizeGb, 1)}} GB. Your saves and play time stay.",
					"buttons": [{ "title": "Remove", "run": "removeGame" }, { "title": "Cancel" }],
					"color": "@color.surface",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"highlight": "@color.accent"
				}
			},
			{
				"id": "toast",
				"use": "toast",
				"with": { "open": "state.toast.open", "message": "{{state.toast.message}}", "progress": "{{state.toast.progress}}", "color": "@color.raised", "textColor": "@color.text", "accent": "@color.accent" }
			},
			{
				"id": "quick-pick",
				"use": "quickPick",
				"with": {
					"providers": [
						{ "placeholder": "Go to a game (type > for commands)", "items": "{{map(state.games, { id: it.id, title: it.title, detail: it.genre })}}", "key": "title", "run": "pickGame" },
						{ "prefix": ">", "placeholder": "Run a command", "items": "{{commands}}", "key": "title", "run": "runCommand" }
					],
					"color": "@color.surface",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"accent": "@color.accent",
					"highlight": "@color.accentSoft"
				}
			}
		]
	}
}
