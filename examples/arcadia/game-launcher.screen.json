{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Arcadia: a desktop game store and launcher, modelled on the layout of popular game-store clients. A menu row and a big navigation (store, library, community, profile) with back and forward; a library with a game list on the left, a home of shelves and a page per game; a bottom bar with the downloads and friends. Every game, studio, friend and picture is invented. The parts: parts/data.json (the data), parts/chrome.json (the bars around the pages), parts/library.json (the library). Built from the public docs only; see README.md next to it.",

	"window": {
		"title": "Arcadia",
		"width": 1280,
		"height": 800,
		"minWidth": 1024,
		"minHeight": 680,
		"focusRing": { "color": "#1a9fff", "width": 2, "offset": 1 }
	},

	"include": ["parts/data.json", "parts/chrome.json", "parts/library.json", "parts/store.json", "parts/downloads.json", "../shared/addons/assistant/assistant.json"],

	"theme": "{{settings.appearance.theme}}",

	"permissions": { "allow": ["studio"], "ask": ["agent"], "reviewers": ["studio"] },

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "fallback": ["icons"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["icons"] },
		"caps": {
			"file": "../shared/fonts/Roboto-Regular.ttf",
			"size": 12,
			"bold": true,
			"fallback": ["icons"]
		},
		"strong": {
			"file": "../shared/fonts/Roboto-Regular.ttf",
			"size": 14,
			"bold": true,
			"fallback": ["icons"]
		},
		"heading": {
			"file": "../shared/fonts/Roboto-Regular.ttf",
			"size": 17,
			"bold": true,
			"fallback": ["icons"]
		},
		"nav": {
			"file": "../shared/fonts/Roboto-Regular.ttf",
			"size": 21,
			"bold": true,
			"fallback": ["icons"]
		},
		"button": {
			"file": "../shared/fonts/Roboto-Regular.ttf",
			"size": 18,
			"bold": true,
			"fallback": ["icons"]
		},
		"logo": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 48, "bold": true },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 14 }
	},

	"tokens": {
		"color.top": { "dark": "#171a21", "light": "#dde3ea" },
		"color.page": { "dark": "#1b2838", "light": "#eef2f6" },
		"color.side": { "dark": "#1e2329", "light": "#e6ebf0" },
		"color.sideTop": { "dark": "#23272e", "light": "#eef2f6" },
		"color.main": { "dark": "#1f252d", "light": "#f4f6f9" },
		"color.panel": { "dark": "#23272f", "light": "#ffffff" },
		"color.raised": { "dark": "#2d333c", "light": "#e4e9ef" },
		"color.hover": { "dark": "#3d4450", "light": "#d5dde6" },
		"color.select": { "dark": "#3e4c61", "light": "#c9d9ec" },
		"color.field": { "dark": "#2c3139", "light": "#ffffff" },
		"color.border": { "dark": "#2f3640", "light": "#cfd8e2" },
		"color.text": { "dark": "#c7d5e0", "light": "#1f2a36" },
		"color.bright": { "dark": "#ffffff", "light": "#0e1620" },
		"color.muted": { "dark": "#8f98a0", "light": "#5b6672" },
		"color.dim": { "dark": "#5d6670", "light": "#97a2ad" },
		"color.accent": { "dark": "#1a9fff", "light": "#1673c4" },
		"color.link": { "dark": "#66c0f4", "light": "#2475b0" },
		"color.play": { "dark": "#5cb71f", "light": "#4ea51a" },
		"color.playEnd": { "dark": "#2f8f1d", "light": "#2f8a1b" },
		"color.blue": { "dark": "#47bfff", "light": "#2f9be6" },
		"color.blueEnd": { "dark": "#1a44c2", "light": "#1a4fb8" },
		"color.ingame": { "dark": "#90ba3c", "light": "#5a8a12" },
		"color.online": { "dark": "#57cbde", "light": "#1d8aa0" },
		"color.offline": { "dark": "#898989", "light": "#7a838c" },
		"color.badge": { "dark": "#4c6b22", "light": "#4c6b22" },
		"color.onBadge": { "dark": "#beee11", "light": "#d8ff4a" },
		"color.shade": { "dark": "#0e1116cc", "light": "#0e1116aa" },
		"assistant.accent": "@color.accent",
		"assistant.accentHover": "@color.blue",
		"assistant.surface": "@color.panel",
		"assistant.raised": "@color.raised",
		"assistant.border": "@color.border",
		"assistant.text": "@color.text",
		"assistant.dim": "@color.muted",
		"assistant.dot": "@color.dim",
		"assistant.success": "@color.play",
		"kit.background": "@color.page",
		"kit.surface": { "dark": "#3d4450", "light": "#ffffff" },
		"kit.bar": "@color.top",
		"kit.barHover": "@color.hover",
		"kit.field": "@color.field",
		"kit.text": { "dark": "#dcdedf", "light": "#1f2a36" },
		"kit.dim": "@color.muted",
		"kit.body": "@color.muted",
		"kit.selection": { "dark": "#56657a", "light": "#c9d9ec" },
		"kit.border": { "dark": "#4a5260", "light": "#cfd8e2" },
		"kit.primary": "@color.accent",
		"kit.accent": "@color.link",
		"kit.focus": "@color.accent",
		"kit.radius": 3,
		"kit.cardRadius": 4
	},

	"strings": { "default": "en", "locale": "{{settings.appearance.language}}" },

	"settings": {
		"appearance.theme": {
			"type": "string",
			"enum": ["dark", "light"],
			"default": "dark",
			"title": "Theme",
			"description": "Dark or light colours for the whole client."
		},
		"appearance.language": {
			"type": "string",
			"enum": ["en", "es", "fr"],
			"default": "en",
			"title": "Language",
			"description": "English, Spanish or French."
		},
		"library.sortBy": {
			"type": "string",
			"enum": ["name", "playtime", "recent"],
			"default": "name",
			"title": "Sort the library by",
			"description": "Name from A to Z, the most hours, or the most recently played."
		}
	},

	"state": {
		"nav": [{ "tab": "library", "page": "home", "id": null }],
		"at": 0
	},

	"computed": {
		"rtl": "{{slice(locale, 0, 2) == 'ar'}}",
		"here": "{{state.nav[state.at]}}",
		"owned": "{{filter(state.games, it.owned)}}",
		"game": "{{find(state.games, it.id == (computed.here.id ?? state.selected))}}"
	},

	"actions": {
		"go": {
			"title": "Go to a page",
			"category": "View",
			"description": "Goes to { tab, page, id }, dropping the pages ahead of this one, as a browser does.",
			"do": [
				{
					"if": "{{tab != computed.here.tab || page != computed.here.page || id != computed.here.id}}",
					"then": [
						{
							"set": "state.nav",
							"to": "{{concat(slice(state.nav, 0, state.at + 1), [{ tab: tab, page: page, id: id }])}}"
						},
						{ "set": "state.at", "to": "{{state.at + 1}}" }
					]
				}
			]
		},
		"back": {
			"title": "Back",
			"category": "View",
			"icon": "arrow-left",
			"enablement": "{{state.at > 0}}",
			"do": [{ "set": "state.at", "to": "{{max(0, state.at - 1)}}" }]
		},
		"forward": {
			"title": "Forward",
			"category": "View",
			"icon": "arrow-right",
			"enablement": "{{state.at < length(state.nav) - 1}}",
			"do": [{ "set": "state.at", "to": "{{min(length(state.nav) - 1, state.at + 1)}}" }]
		},
		"showStore": {
			"title": "Store",
			"category": "View",
			"do": [{ "run": "go", "with": { "tab": "store", "page": "home", "id": null } }]
		},
		"showLibrary": {
			"title": "Library",
			"category": "View",
			"do": [{ "run": "go", "with": { "tab": "library", "page": "home", "id": null } }]
		},
		"showCommunity": {
			"title": "Community",
			"category": "View",
			"do": [{ "run": "go", "with": { "tab": "community", "page": "home", "id": null } }]
		},
		"showProfile": {
			"title": "Profile",
			"category": "View",
			"do": [{ "run": "go", "with": { "tab": "profile", "page": "home", "id": null } }]
		},
		"toggleTheme": {
			"title": "Switch between dark and light",
			"category": "View",
			"do": [
				{
					"set": "settings.appearance.theme",
					"to": "{{settings.appearance.theme == 'dark' ? 'light' : 'dark'}}"
				}
			]
		},
		"nextLanguage": {
			"title": "Next language",
			"category": "View",
			"do": [
				{
					"set": "settings.appearance.language",
					"to": "{{settings.appearance.language == 'en' ? 'es' : settings.appearance.language == 'es' ? 'fr' : 'en'}}"
				}
			]
		}
	},

	"keys": {
		"alt+left": "back",
		"alt+right": "forward",
		"mod+1": "showStore",
		"mod+2": "showLibrary",
		"mod+3": "showCommunity",
		"mod+k mod+t": "toggleTheme",
		"mod+k mod+l": "nextLanguage"
	},

	"root": {
		"id": "app",
		"color": "@color.page",
		"children": [
			{
				"id": "app-body",
				"type": "column",
				"fill": true,
				"dir": "auto",
				"children": [
					{ "use": "menuRow", "id": "menu-row" },
					{ "use": "navRow", "id": "nav-row" },
					{
						"id": "body",
						"grow": 1,
						"anchors": { "left": 0, "right": 0 },
						"children": [
							{ "when": "{{computed.here.tab == 'library'}}", "use": "libraryPage", "id": "library" },
							{ "when": "{{computed.here.tab == 'store'}}", "use": "storePage" },
							{ "when": "{{computed.here.tab == 'downloads'}}", "use": "downloadsPage" },
							{ "when": "{{!contains(['library', 'store', 'downloads'], computed.here.tab)}}", "use": "comingSoon", "id": "elsewhere" }
						]
					},
					{ "use": "bottomBar", "id": "bottom-bar" }
				]
			}
		]
	}
}
