{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"note": "Arcadia's records: the games (owned or only in the store), the friends, the library's news and the activity. Their first records are in seed/, all invented. Times are milliseconds, measured from state.today; `ago` is in days.",
	"models": {
		"games": {
			"fields": {
				"title": {
					"type": "string",
					"required": true,
					"maxLength": 100
				},
				"genre": {
					"type": "string"
				},
				"developer": {
					"type": "string"
				},
				"publisher": {
					"type": "string"
				},
				"owned": {
					"type": "boolean",
					"default": false
				},
				"installed": {
					"type": "boolean",
					"default": false
				},
				"status": {
					"type": "enum",
					"values": ["none", "ready", "running", "downloading", "update"],
					"default": "none"
				},
				"favourite": {
					"type": "boolean",
					"default": false
				},
				"sizeGb": {
					"type": "number",
					"minimum": 0
				},
				"hours": {
					"type": "number",
					"minimum": 0,
					"default": 0
				},
				"lastPlayed": {
					"type": "dateTime"
				},
				"achievements": {
					"type": "list",
					"of": {
						"type": "integer",
						"minimum": 0
					},
					"maxItems": 2,
					"description": "Earned, of how many."
				},
				"price": {
					"type": "number",
					"minimum": 0
				},
				"discount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100,
					"default": 0
				},
				"review": {
					"type": "enum",
					"values": ["mixed", "mostlyPositive", "positive", "veryPositive", "overwhelminglyPositive"]
				},
				"reviewPercent": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100
				},
				"reviewCount": {
					"type": "integer",
					"minimum": 0
				},
				"release": {
					"type": "string"
				},
				"tags": {
					"type": "list",
					"of": {
						"type": "string"
					},
					"maxItems": 16
				},
				"controller": {
					"type": "enum",
					"values": ["none", "partial", "full"]
				},
				"blurb": {
					"type": "string"
				},
				"logo": {
					"type": "string"
				}
			}
		},
		"friends": {
			"fields": {
				"name": {
					"type": "string",
					"required": true,
					"maxLength": 100
				},
				"avatar": {
					"type": "string"
				},
				"presence": {
					"type": "enum",
					"values": ["online", "ingame", "away", "offline"],
					"default": "offline"
				},
				"game": {
					"type": "reference",
					"to": "games",
					"onDelete": "nullify",
					"description": "The game they are playing."
				},
				"since": {
					"type": "integer",
					"description": "Minutes in their present presence."
				}
			}
		},
		"news": {
			"fields": {
				"game": {
					"type": "reference",
					"to": "games",
					"onDelete": "nullify"
				},
				"kind": {
					"type": "enum",
					"values": ["update", "news", "event"]
				},
				"ago": {
					"type": "integer",
					"minimum": 0
				},
				"title": {
					"type": "string",
					"required": true
				},
				"text": {
					"type": "string"
				}
			}
		},
		"activity": {
			"fields": {
				"who": {
					"type": "reference",
					"to": "friends",
					"onDelete": "nullify"
				},
				"game": {
					"type": "reference",
					"to": "games",
					"onDelete": "nullify"
				},
				"kind": {
					"type": "enum",
					"values": ["achievement", "played", "review", "screenshot"]
				},
				"ago": {
					"type": "integer",
					"minimum": 0
				},
				"text": {
					"type": "string"
				},
				"detail": {
					"type": "string"
				},
				"shot": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3
				}
			}
		}
	}
}
