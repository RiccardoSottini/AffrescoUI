{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "index.screen.lisp",
	"scenarios": [
		{
			"name": "home",
			"steps": [
				{
					"expect": {
						"node": "#library-home",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "home"
				}
			]
		},
		{
			"name": "game-page",
			"steps": [
				{
					"click": "#row-favourites-starfall"
				},
				{
					"expect": {
						"state": "selected",
						"is": "starfall"
					}
				},
				{
					"expect": {
						"node": "#details-title",
						"text": "Starfall Odyssey"
					}
				},
				{
					"capture": "game-page"
				},
				{
					"click": "#game-info"
				},
				{
					"expect": {
						"node": "#details-blurb",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "game-info"
				},
				{
					"key": "escape"
				},
				{
					"action": "back"
				},
				{
					"expect": {
						"node": "#library-home",
						"property": "shown",
						"is": true
					}
				}
			]
		},
		{
			"name": "play",
			"steps": [
				{
					"click": "#row-favourites-starfall"
				},
				{
					"click": "#play-button"
				},
				{
					"expect": {
						"state": "running",
						"is": "starfall"
					}
				},
				{
					"expect": {
						"node": "#play-button",
						"text": "Stop"
					}
				},
				{
					"click": "#play-button"
				},
				{
					"expect": {
						"state": "running",
						"is": null
					}
				}
			]
		},
		{
			"name": "install",
			"steps": [
				{
					"click": "#row-favourites-mossheart"
				},
				{
					"expect": {
						"node": "#play-button",
						"text": "Install"
					}
				},
				{
					"capture": "not-installed"
				},
				{
					"click": "#play-button"
				},
				{
					"expect": {
						"state": "downloads[6].id",
						"is": "mossheart"
					}
				}
			]
		},
		{
			"name": "filter",
			"steps": [
				{
					"click": "#library-search"
				},
				{
					"type": "iron"
				},
				{
					"expect": {
						"node": "#row-uncategorised-ironhollow",
						"property": "shown",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#row-favourites-starfall",
						"exists": false
					}
				},
				{
					"capture": "search"
				}
			]
		},
		{
			"name": "dark-light-french",
			"steps": [
				{
					"action": "toggleTheme"
				},
				{
					"capture": "light"
				},
				{
					"action": "toggleTheme"
				},
				{
					"action": "nextLanguage"
				},
				{
					"action": "nextLanguage"
				},
				{
					"capture": "french"
				}
			]
		},
		{
			"name": "store",
			"steps": [
				{
					"action": "storeHome"
				},
				{
					"expect": {
						"node": "#store-home",
						"property": "shown",
						"is": true
					}
				},
				{
					"move": "#offer-saltmarsh"
				},
				{
					"capture": "store-home"
				},
				{
					"click": "#offer-saltmarsh"
				},
				{
					"capture": "store-page"
				},
				{
					"scroll": "#store-title",
					"dy": -6
				},
				{
					"expect": {
						"node": "#add-to-cart",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "purchase"
				},
				{
					"click": "#add-to-cart"
				},
				{
					"capture": "added-to-cart"
				},
				{
					"key": "escape"
				},
				{
					"action": "showCart"
				},
				{
					"capture": "cart"
				},
				{
					"action": "showWishlist"
				},
				{
					"capture": "wishlist"
				}
			]
		},
		{
			"name": "assistant",
			"steps": [
				{
					"action": "assistant.open"
				},
				{
					"expect": {
						"node": "#assistantPanel",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "assistant"
				},
				{
					"key": "escape"
				}
			]
		},
		{
			"name": "friends",
			"steps": [
				{
					"click": "#friends-chat"
				},
				{
					"expect": {
						"node": "#friends-page",
						"property": "shown",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#chat-name",
						"property": "text",
						"is": "NightDrifter"
					}
				},
				{
					"capture": "friends"
				},
				{
					"click": "#chat-input"
				},
				{
					"type": "Want to play tonight?"
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"node": "#chat-input",
						"property": "text",
						"is": ""
					}
				},
				{
					"wait": 1200
				},
				{
					"expect": {
						"node": "#chat-typing",
						"property": "shown",
						"is": true
					}
				},
				{
					"wait": 2600
				},
				{
					"click": "#chat-invite"
				},
				{
					"wait": 200
				},
				{
					"capture": "friends-chat"
				},
				{
					"click": "#my-status"
				},
				{
					"capture": "friends-status"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Away"
					}
				},
				{
					"expect": {
						"node": "#my-status",
						"property": "text",
						"is": "Away "
					}
				},
				{
					"click": "#friend-f9"
				},
				{
					"expect": {
						"node": "#chat-name",
						"property": "text",
						"is": "IronMole"
					}
				},
				{
					"click": "#add-friend"
				},
				{
					"click": "#add-friend-name"
				},
				{
					"type": "Ember"
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"node": "#friends-group-offline",
						"property": "shown",
						"is": true
					}
				},
				{
					"action": "toggleTheme"
				},
				{
					"capture": "friends-light"
				},
				{
					"action": "toggleTheme"
				}
			]
		},
		{
			"name": "profile",
			"steps": [
				{
					"action": "showProfile"
				},
				{
					"expect": {
						"node": "#profile-name",
						"property": "text",
						"is": "Mira"
					}
				},
				{
					"capture": "profile"
				},
				{
					"click": "#profile-recent-starfall"
				},
				{
					"expect": {
						"node": "#library",
						"property": "shown",
						"is": true
					}
				}
			]
		},
		{
			"name": "manage",
			"note": "A game's menu (right click, Shift+F10 or the gear): Properties keeps its launch options and settings, verifies the files; Uninstall asks first",
			"steps": [
				{
					"click": "#row-favourites-starfall"
				},
				{
					"key": "shift+f10"
				},
				{
					"expect": {
						"node": "#game-menu",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "menu"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Properties…"
					}
				},
				{
					"expect": {
						"node": "#properties-launch",
						"property": "shown",
						"is": true
					}
				},
				{
					"click": "#properties-launch"
				},
				{
					"type": "-windowed"
				},
				{
					"capture": "general"
				},
				{
					"click": "#properties-tab-updates"
				},
				{
					"click": "#properties-updates-launch"
				},
				{
					"capture": "updates"
				},
				{
					"click": "#properties-tab-files"
				},
				{
					"click": "#properties-verify"
				},
				{
					"wait": 1700
				},
				{
					"click": "#properties-browse"
				},
				{
					"expect": {
						"node": "#properties-file-content-pak",
						"property": "shown",
						"is": true
					}
				},
				{
					"capture": "files"
				},
				{
					"click": "#properties-move"
				},
				{
					"expect": {
						"node": "#properties-folder",
						"text": "Game drive  ›  Arcadia/games/Starfall Odyssey"
					}
				},
				{
					"click": "#properties-move"
				},
				{
					"key": "escape"
				},
				{
					"click": "#game-settings"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Properties…"
					}
				},
				{
					"expect": {
						"node": "#properties-launch",
						"property": "text",
						"is": "-windowed"
					}
				},
				{
					"key": "escape"
				},
				{
					"click": "#game-settings"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Uninstall…"
					}
				},
				{
					"capture": "uninstall"
				},
				{
					"click": {
						"role": "button",
						"name": "Uninstall"
					}
				},
				{
					"capture": "uninstalled"
				},
				{
					"action": "toggleTheme"
				},
				{
					"click": "#game-settings"
				},
				{
					"capture": "menu-light"
				},
				{
					"key": "escape"
				},
				{
					"action": "nextLanguage"
				},
				{
					"action": "nextLanguage"
				},
				{
					"wait": 100,
					"note": "the new language's labels move the gear: it is laid out on the next frame"
				},
				{
					"click": "#game-settings"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Propriétés…"
					}
				},
				{
					"capture": "fr"
				}
			]
		},
		{
			"name": "collections",
			"steps": [
				{
					"click": "#library-new-collection"
				},
				{
					"wait": 0
				},
				{
					"expect": {
						"state": "newCollection.open",
						"is": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Create"
					}
				},
				{
					"expect": {
						"node": "#coll-error",
						"text": "Give the collection a name."
					}
				},
				{
					"click": "#coll-name"
				},
				{
					"type": "Weekend"
				},
				{
					"click": "#coll-check-driftwood"
				},
				{
					"click": "#coll-check-ember"
				},
				{
					"capture": "new-collection"
				},
				{
					"click": {
						"role": "button",
						"name": "Create"
					}
				},
				{
					"expect": {
						"state": "newCollection.open",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#section-mine-1",
						"text": "WEEKEND (2)"
					}
				},
				{
					"expect": {
						"node": "#row-mine-1-driftwood",
						"exists": true
					}
				},
				{
					"click": "#library-new-collection"
				},
				{
					"wait": 0
				},
				{
					"click": "#coll-name"
				},
				{
					"type": "Ready"
				},
				{
					"click": "#coll-kind-dynamic"
				},
				{
					"click": {
						"role": "button",
						"name": "Create"
					}
				},
				{
					"expect": {
						"node": "#coll-error",
						"text": "Choose a rule for the collection."
					}
				},
				{
					"click": "#coll-rule-installed"
				},
				{
					"capture": "dynamic-collection"
				},
				{
					"click": {
						"role": "button",
						"name": "Create"
					}
				},
				{
					"expect": {
						"state": "collections[3].rule.field",
						"is": "installed"
					}
				},
				{
					"expect": {
						"node": "#row-mine-2-starfall",
						"exists": true
					}
				},
				{
					"command": "deleteCollection",
					"with": {
						"id": "mine-1"
					},
					"as": "studio"
				},
				{
					"expect": {
						"node": "#section-mine-1",
						"exists": false
					}
				}
			]
		},
		{
			"name": "couch-rows",
			"steps": [
				{
					"action": "enterCouch"
				},
				{
					"wait": 0
				},
				{
					"key": "down"
				},
				{
					"expect": {
						"state": "couch.section",
						"is": "store"
					}
				},
				{
					"key": "right"
				},
				{
					"capture": "store"
				},
				{
					"key": "down"
				},
				{
					"expect": {
						"state": "couch.section",
						"is": "friends"
					}
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"state": "couch.open",
						"is": false
					}
				},
				{
					"expect": {
						"state": "chatWith",
						"is": "f1"
					}
				},
				{
					"action": "enterCouch"
				},
				{
					"wait": 0
				},
				{
					"click": "#couch-tab-store"
				},
				{
					"wait": 0
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"state": "couch.open",
						"is": false
					}
				}
			]
		},
		{
			"name": "collection-edit",
			"note": "A collection's shelf has an edit button and its heading in the list a right click: the window opens with its name and games, saves a new name and games, and deletes it.",
			"steps": [
				{
					"rightClick": "#section-coop"
				},
				{
					"wait": 0
				},
				{
					"expect": {
						"state": "newCollection.editing",
						"is": "coop"
					}
				},
				{
					"expect": {
						"state": "newCollection.title",
						"is": "Co-op Nights"
					}
				},
				{
					"capture": "edit-collection"
				},
				{
					"click": "#coll-name"
				},
				{
					"key": "cmd+a"
				},
				{
					"type": "Friday Co-op"
				},
				{
					"click": "#coll-check-ember"
				},
				{
					"click": {
						"role": "button",
						"name": "Save"
					}
				},
				{
					"expect": {
						"state": "newCollection.open",
						"is": false
					}
				},
				{
					"expect": {
						"state": "collections[0].title",
						"is": "Friday Co-op"
					}
				},
				{
					"expect": {
						"state": "collections[0].games",
						"is": [
							"pebble",
							"neon"
						]
					}
				},
				{
					"rightClick": "#section-cozy"
				},
				{
					"wait": 0
				},
				{
					"click": {
						"role": "button",
						"name": "Delete"
					}
				},
				{
					"expect": {
						"state": "collections.length",
						"is": 1
					}
				},
				{
					"expect": {
						"node": "#section-cozy",
						"exists": false
					}
				}
			]
		},
		{
			"name": "couch-settings",
			"note": "Couch mode has a Settings row: Enter steps the chosen setting to its next value.",
			"steps": [
				{
					"action": "enterCouch"
				},
				{
					"wait": 0
				},
				{
					"key": "down"
				},
				{
					"key": "down"
				},
				{
					"key": "down"
				},
				{
					"expect": {
						"state": "couch.section",
						"is": "settings"
					}
				},
				{
					"capture": "couch-settings"
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"state": "couch.open",
						"is": true
					}
				},
				{
					"key": "right"
				},
				{
					"key": "right"
				},
				{
					"key": "right"
				},
				{
					"key": "enter"
				},
				{
					"expect": {
						"state": "couch.at",
						"is": 3
					}
				},
				{
					"click": "#couch-leave"
				}
			]
		},
		{
			"name": "compatibility",
			"note": "A game's properties have a Compatibility page: forcing a layer and choosing which one.",
			"steps": [
				{
					"with": {
						"id": "ember",
						"tab": "compat"
					},
					"command": "openProperties",
					"as": "studio"
				},
				{
					"wait": 0
				},
				{
					"expect": {
						"state": "compat",
						"is": {}
					}
				},
				{
					"click": "#properties-compat-toggle"
				},
				{
					"expect": {
						"state": "compat.ember",
						"is": "bridge9"
					}
				},
				{
					"click": "#properties-compat-experimental"
				},
				{
					"expect": {
						"state": "compat.ember",
						"is": "experimental"
					}
				},
				{
					"capture": "compatibility"
				},
				{
					"click": "#properties-compat-toggle"
				},
				{
					"expect": {
						"state": "compat.ember",
						"is": null
					}
				}
			]
		},
		{
			"name": "profile-rewards",
			"note": "The rewards redeemed show on the profile's banner.",
			"steps": [
				{
					"action": "showProfile"
				},
				{
					"wait": 0
				},
				{
					"expect": {
						"node": "#profile-reward-gem-badge",
						"exists": true
					}
				},
				{
					"capture": "profile-rewards"
				}
			]
		}
	]
}
