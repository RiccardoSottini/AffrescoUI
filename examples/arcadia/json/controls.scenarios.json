{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "index.screen.json",
	"note": "Every control of the client's own: each menu item, the bar buttons, Settings, codes, a game from this computer, backup, couch mode, the game page's links, the library's tools and the store bar, each with a step that proves what it does. The menu bar's headings have no id: they are clicked where they are (Arcadia, View, Friends, Games, Help from the left).",
	"scenarios": [
		{
			"name": "settings",
			"steps": [
				{ "key": "mod+comma" },
				{ "expect": { "state": "settingsDialog.open", "is": true } },
				{ "expect": { "node": "#settings-pages", "property": "shown", "is": true } },
				{ "click": "#setting-appearance-theme-light" },
				{ "expect": { "node": "#app", "property": "color", "is": "#f6f2f7" } },
				{ "capture": "interface-light" },
				{ "click": "#setting-appearance-theme-dark" },
				{ "expect": { "node": "#app", "property": "color", "is": "#211a28" } },
				{ "click": "#setting-appearance-language-fr" },
				{ "expect": { "node": "#settings-page-storage", "text": "Stockage" } },
				{ "click": "#setting-appearance-language-en" },
				{ "click": "#setting-appearance-startpage-store" },
				{ "expect": { "node": "#setting-appearance-startpage-store", "property": "color", "is": "#54405e" } },
				{ "click": "#setting-library-sortby-playtime" },
				{ "expect": { "node": "#setting-library-sortby-playtime", "property": "color", "is": "#54405e" } },
				{ "click": "#settings-page-downloads" },
				{ "click": "#setting-downloads-limit-10" },
				{ "expect": { "node": "#setting-downloads-limit-10", "property": "color", "is": "#54405e" } },
				{ "click": "#settings-while-playing-toggle" },
				{ "expect": { "node": "#settings-while-playing-toggle", "property": "checked", "is": false } },
				{ "click": "#settings-clear-cache" },
				{ "expect": { "state": "toast.text", "is": "The download cache is clear." } },
				{ "capture": "downloads" },
				{ "click": "#settings-page-storage" },
				{ "expect": { "node": "#storage-bar", "property": "shown", "is": true } },
				{ "capture": "storage" },
				{ "click": "#storage-uninstall-starfall" },
				{ "expect": { "state": "uninstall.open", "is": true } },
				{ "expect": { "state": "manage", "is": "starfall" } },
				{ "key": "escape" },
				{ "key": "mod+comma" },
				{ "click": "#settings-page-account" },
				{ "expect": { "node": "#settings-wallet", "text": "€42.17" } },
				{ "capture": "account" },
				{ "click": "#settings-redeem" },
				{ "expect": { "state": "code.kind", "is": "redeem" } },
				{ "wait": 100 },
				{ "type": "gift-2026-arcd" },
				{ "key": "enter" },
				{ "expect": { "state": "user.wallet", "is": 62.17 } },
				{ "expect": { "node": "#settings-wallet", "text": "€62.17" } },
				{ "click": "#settings-redeem" },
				{ "wait": 100 },
				{ "type": "GIFT-2026-ARCD" },
				{ "key": "enter" },
				{ "expect": { "node": "#code-error", "text": "That gift code has already been used." } },
				{ "click": { "role": "button", "name": "Cancel" } },
				{ "expect": { "state": "code.open", "is": false } },
				{ "click": "#settings-sign-out" },
				{ "expect": { "node": "#signed-out", "property": "shown", "is": true } },
				{ "capture": "signed-out" },
				{ "click": "#sign-in" },
				{ "expect": { "state": "session.signedOut", "is": false } }
			]
		},
		{
			"name": "app-menu",
			"steps": [
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Check for Client Updates…" } },
				{ "expect": { "state": "toast.text", "is": "Checking for client updates…" } },
				{ "wait": 1300 },
				{ "expect": { "state": "toast.text", "is": "Arcadia is up to date." } },
				{ "capture": "updates" },
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Offline Mode" } },
				{ "expect": { "state": "session.offline", "is": true } },
				{ "click": "#nav-store" },
				{ "expect": { "node": "#offline-page", "property": "shown", "is": true } },
				{ "capture": "offline" },
				{ "click": "#offline-online" },
				{ "expect": { "state": "session.offline", "is": false } },
				{ "expect": { "node": "#store-home", "property": "shown", "is": true } },
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Back Up and Restore Games…" } },
				{ "expect": { "state": "backup.open", "is": true } },
				{ "choose": "backup.json" },
				{ "click": { "role": "button", "name": "Back up…" } },
				{ "wait": 0 },
				{ "expect": { "state": "toast.text", "is": "Backup saved." } },
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Back Up and Restore Games…" } },
				{ "choose": "backup.json" },
				{ "click": { "role": "button", "name": "Restore…" } },
				{ "wait": 0 },
				{ "expect": { "state": "backup.restored.format", "is": "arcadia-backup" } },
				{ "expect": { "state": "toast.text", "is": "Backup restored." } },
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Settings" } },
				{ "expect": { "state": "settingsDialog.open", "is": true } },
				{ "key": "escape" },
				{ "click": [38, 15] },
				{ "click": { "role": "menuitem", "name": "Change Account…" } },
				{ "expect": { "state": "session.signedOut", "is": true } },
				{ "click": "#sign-in" },
				{ "expect": { "state": "session.signedOut", "is": false } }
			]
		},
		{
			"name": "games-menu",
			"steps": [
				{ "click": [234, 15] },
				{ "click": { "role": "menuitem", "name": "Activate a Product…" } },
				{ "expect": { "state": "code.kind", "is": "activate" } },
				{ "wait": 100 },
				{ "type": "AAAAA-BBBBB-CCCCC" },
				{ "key": "enter" },
				{ "expect": { "node": "#code-error", "text": "That key isn't valid. Check it and try again." } },
				{ "capture": "bad-key" },
				{ "click": { "role": "button", "name": "Cancel" } },
				{ "expect": { "state": "code.open", "is": false } },
				{ "click": [234, 15] },
				{ "click": { "role": "menuitem", "name": "Activate a Product…" } },
				{ "click": "#code-text" },
				{ "type": "hx5re-2pwna-7ldkc" },
				{ "key": "enter" },
				{ "expect": { "state": "code.open", "is": false } },
				{ "expect": { "node": "#details-title", "text": "Volt Breakers" } },
				{ "click": [234, 15] },
				{ "click": { "role": "menuitem", "name": "Redeem a gift code…" } },
				{ "wait": 100 },
				{ "type": "GIFT-0000-NONE" },
				{ "key": "enter" },
				{ "expect": { "node": "#code-error", "text": "That gift code isn't valid. Check it and try again." } },
				{ "click": { "role": "button", "name": "Cancel" } },
				{ "click": "#add-game" },
				{ "click": { "role": "menuitem", "name": "Add a Game from This Computer…" } },
				{ "expect": { "state": "addGame.open", "is": true } },
				{ "click": "#add-game-name" },
				{ "type": "Pixel Garden" },
				{ "key": "enter" },
				{ "expect": { "state": "addGame.open", "is": false } },
				{ "expect": { "node": "#details-title", "text": "Pixel Garden" } },
				{ "expect": { "node": "#section-link-store", "exists": false } },
				{ "capture": "local-game" },
				{ "action": "showStore" },
				{ "expect": { "node": "#store-home", "property": "shown", "is": true } },
				{ "click": "#add-game" },
				{ "click": { "role": "menuitem", "name": "Activate a Product…" } },
				{ "click": "#code-text" },
				{ "type": "AR7Q2-KX4MZ-P9T3L" },
				{ "key": "enter" },
				{ "expect": { "node": "#details-title", "text": "Glasswing" } }
			]
		},
		{
			"name": "view-and-help",
			"steps": [
				{ "click": [102, 15] },
				{ "click": { "role": "menuitem", "name": "Couch mode" } },
				{ "expect": { "state": "couch.open", "is": true } },
				{ "wait": 0 },
				{ "capture": "couch" },
				{ "key": "right" },
				{ "expect": { "state": "couch.at", "is": 1 } },
				{ "key": "left" },
				{ "expect": { "state": "couch.at", "is": 0 } },
				{ "key": "escape" },
				{ "expect": { "state": "couch.open", "is": false } },
				{ "click": "#tv-button" },
				{ "expect": { "state": "couch.open", "is": true } },
				{ "click": "#couch-leave" },
				{ "expect": { "state": "couch.open", "is": false } },
				{ "click": [290, 15] },
				{ "click": { "role": "menuitem", "name": "About Arcadia" } },
				{ "expect": { "state": "info.kind", "is": "about" } },
				{ "capture": "about" },
				{ "key": "escape" },
				{ "click": [290, 15] },
				{ "click": { "role": "menuitem", "name": "System Information" } },
				{ "expect": { "state": "info.kind", "is": "system" } },
				{ "key": "escape" },
				{ "click": [290, 15] },
				{ "click": { "role": "menuitem", "name": "Privacy Policy" } },
				{ "expect": { "state": "info.kind", "is": "privacy" } },
				{ "key": "escape" },
				{ "click": [290, 15] },
				{ "click": { "role": "menuitem", "name": "Arcadia Support" } },
				{ "expect": { "state": "info.kind", "is": "support" } },
				{ "key": "escape" },
				{ "expect": { "state": "info.open", "is": false } }
			]
		},
		{
			"name": "account-and-notices",
			"steps": [
				{ "click": "#bell" },
				{ "click": { "role": "menuitem" } },
				{ "expect": { "state": "notifications[0].unread", "is": false } },
				{ "expect": { "node": "#dl-graph", "exists": true } },
				{ "click": "#account" },
				{ "click": { "role": "menuitem", "name": "Account details" } },
				{ "expect": { "state": "settingsDialog.page", "is": "account" } },
				{ "key": "escape" },
				{ "click": "#account" },
				{ "click": { "role": "menuitem", "name": "Sign out" } },
				{ "expect": { "node": "#signed-out", "property": "shown", "is": true } },
				{ "click": "#sign-in" }
			]
		},
		{
			"name": "game-links",
			"steps": [
				{ "click": "#row-favourites-starfall" },
				{ "click": "#section-link-dlc" },
				{ "expect": { "state": "properties.tab", "is": "dlc" } },
				{ "key": "escape" },
				{ "click": "#section-link-discussions" },
				{ "expect": { "node": "#hub-page", "property": "shown", "is": true } },
				{ "expect": { "state": "hubTab", "is": "discussions" } },
				{ "click": "#hub-tab-guides" },
				{ "expect": { "state": "hubTab", "is": "guides" } },
				{ "capture": "hub" },
				{ "click": "#hub-back" },
				{ "expect": { "node": "#game-page", "property": "shown", "is": true } },
				{ "click": "#section-link-support" },
				{ "expect": { "state": "info.kind", "is": "support" } },
				{ "key": "escape" },
				{ "click": "#play-more" },
				{ "click": { "role": "menuitem", "name": "Play in Safe Mode" } },
				{ "expect": { "state": "running", "is": "starfall" } },
				{ "click": "#play-button" },
				{ "expect": { "state": "running", "is": null } },
				{ "click": "#play-more" },
				{ "click": { "role": "menuitem", "name": "Launch Options…" } },
				{ "capture": "launch-options" },
				{ "expect": { "state": "properties.open", "is": true } },
				{ "key": "escape" },
				{ "scroll": [700, 500], "dy": -30 },
				{ "capture": "note" },
				{ "click": "#write-note" },
				{ "wait": 100 },
				{ "type": "Finish the lighthouse run" },
				{ "click": { "role": "button", "name": "Save" } },
				{ "expect": { "node": "#write-note", "text": "Finish the lighthouse run" } }
			]
		},
		{
			"name": "library-tools",
			"steps": [
				{ "click": "#library-collections" },
				{ "expect": { "state": "collapsed.favourites", "is": true } },
				{ "expect": { "node": "#library-collections", "property": "tooltip", "is": "Expand every collection" } },
				{ "click": "#library-collections" },
				{ "expect": { "node": "#library-collections", "property": "tooltip", "is": "Collapse every collection" } },
				{ "click": "#library-filter" },
				{ "click": { "role": "menuitem", "name": "Favourites only" } },
				{ "expect": { "state": "favOnly", "is": true } },
				{ "click": "#library-filter" },
				{ "click": { "role": "menuitem", "name": "Clear filters" } },
				{ "expect": { "state": "favOnly", "is": false } },
				{ "click": "#news-settings" },
				{ "click": { "role": "menuitem", "name": "Show the latest news" } },
				{ "expect": { "node": "#news-shelf", "exists": false } },
				{ "click": "#news-settings" },
				{ "click": { "role": "menuitem", "name": "Show the latest news" } },
				{ "expect": { "node": "#news-shelf", "exists": true } }
			]
		},
		{
			"name": "store-bar",
			"steps": [
				{ "action": "showStore" },
				{ "capture": "store" },
				{ "click": "#store-bar-noteworthy" },
				{ "wait": 100 },
				{ "click": "#store-tab-top" },
				{ "expect": { "state": "storeList", "is": "top" } },
				{ "scroll": [700, 400], "dy": 40 },
				{ "click": "#store-bar-noteworthy" },
				{ "expect": { "state": "storeList", "is": "new" } },
				{ "expect": { "node": "#store-bar-points", "property": "tooltip", "is": "Coming in a later version" } },
				{ "click": "#store-bar-points" },
				{ "expect": { "node": "#store-home", "property": "shown", "is": true } },
				{ "click": "#store-bar-news" },
				{ "expect": { "node": "#library-home", "property": "shown", "is": true } },
				{ "action": "showStore" },
				{ "capture": "store-again" },
				{ "click": "#featured-capsule" },
				{ "scroll": [700, 400], "dy": -60 },
				{ "capture": "reviews" },
				{ "click": "#vote-mossygolem-yes" },
				{ "expect": { "state": "votes.mossygolem", "is": "yes" } },
				{ "click": "#vote-mossygolem-yes" },
				{ "expect": { "state": "votes.mossygolem", "is": null } }
			]
		}
	]
}
