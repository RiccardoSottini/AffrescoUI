{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "A game's player hub: what players post about it, as discussions and guides, opened from the links under the game's banner, and a post's thread. The posts and their first replies are invented, the same for every game, with its name in them. A post opens on its thread: what it says, its replies, and a box to reply in.",
	"state": {
		"hubTab": "hub",
		"hubPosts": [
			{
				"id": "firstHours",
				"kind": "discussions",
				"key": "hub.post.firstHours",
				"by": 0,
				"replies": 48,
				"votes": 112
			},
			{
				"id": "allEndings",
				"kind": "guides",
				"key": "hub.post.allEndings",
				"by": 3,
				"replies": 17,
				"votes": 640
			},
			{
				"id": "controller",
				"kind": "discussions",
				"key": "hub.post.controller",
				"by": 1,
				"replies": 9,
				"votes": 21
			},
			{
				"id": "beginner",
				"kind": "guides",
				"key": "hub.post.beginner",
				"by": 5,
				"replies": 31,
				"votes": 288
			},
			{
				"id": "coop",
				"kind": "discussions",
				"key": "hub.post.coop",
				"by": 2,
				"replies": 73,
				"votes": 96
			},
			{
				"id": "secrets",
				"kind": "guides",
				"key": "hub.post.secrets",
				"by": 4,
				"replies": 12,
				"votes": 154
			}
		],
		"hubPost": null,
		"hubDraft": "",
		"hubReplies": [],
		"hubVoted": []
	},
	"computed": {
		"hubOpen": "{{find(state.hubPosts, it.id == state.hubPost)}}",
		"hubThread": "{{computed.hubOpen == null ? [] : concat(map([0, 1, 2], { by: (computed.hubOpen.by + it + 1) % length(data.friends), key: 'hub.reply.' + ((computed.hubOpen.by + it) % 4), mine: false }), map(filter(state.hubReplies, it.post == state.hubPost), { text: it.text, mine: true }))}}"
	},
	"actions": {
		"openHub": {
			"title": "Open the game's player hub",
			"category": "Game",
			"description": "section is hub (everything), discussions or guides.",
			"do": [
				{
					"set": "state.hubTab",
					"to": "{{section ?? 'hub'}}"
				},
				{
					"set": "state.hubPost",
					"to": null
				},
				{
					"run": "go",
					"with": {
						"tab": "library",
						"page": "hub",
						"id": "{{id}}"
					}
				}
			]
		},
		"openHubPost": {
			"title": "Open a post of the player hub",
			"category": "Game",
			"description": "Opens a post of the player hub on its thread: what it says, its replies, and a box to reply in.",
			"do": [
				{
					"set": "state.hubDraft",
					"to": ""
				},
				{
					"set": "state.hubPost",
					"to": "{{post}}"
				}
			]
		},
		"closeHubPost": {
			"title": "Back to the hub's posts",
			"category": "Game",
			"description": "Goes back from a post's thread to the hub's list of posts.",
			"enablement": "{{state.hubPost != null}}",
			"do": [
				{
					"set": "state.hubPost",
					"to": null
				}
			]
		},
		"replyToPost": {
			"title": "Reply to the post",
			"category": "Game",
			"icon": "send",
			"description": "Posts the reply written under the open post of the player hub.",
			"enablement": "{{state.hubPost != null && trim(state.hubDraft) != ''}}",
			"do": [
				{
					"if": "{{state.hubPost != null && trim(state.hubDraft) != ''}}",
					"then": [
						{
							"push": "state.hubReplies",
							"value": {
								"post": "{{state.hubPost}}",
								"text": "{{trim(state.hubDraft)}}"
							}
						},
						{
							"set": "state.hubDraft",
							"to": ""
						}
					]
				}
			]
		},
		"voteHubPost": {
			"title": "Mark the post as helpful",
			"category": "Game",
			"icon": "thumbs-up",
			"description": "Marks a post of the player hub as helpful, or takes the vote back.",
			"do": [
				{
					"set": "state.hubVoted",
					"to": "{{contains(state.hubVoted, post) ? filter(state.hubVoted, it != post) : concat(state.hubVoted, [post])}}"
				}
			]
		}
	},
	"components": {
		"hubPage": {
			"note": "The hub of the game on the page: its name, the three sections and the posts of the one chosen.",
			"params": {},
			"node": {
				"type": "column",
				"fill": true,
				"scroll": "vertical",
				"let": {
					"g": "{{computed.game}}"
				},
				"children": [
					{
						"type": "row",
						"height": 84,
						"anchors": {
							"left": 32,
							"right": 32
						},
						"gap": 16,
						"alignItems": "center",
						"children": [
							{
								"type": "image",
								"file": "{{'../assets/art/' + (g.art ?? g.id) + '/cover.svg'}}",
								"width": 40,
								"height": 60,
								"radius": 6,
								"fit": "cover"
							},
							{
								"type": "column",
								"grow": 1,
								"height": 48,
								"children": [
									{
										"type": "label",
										"font": "heading",
										"height": 26,
										"anchors": {
											"left": 0,
											"right": 0
										},
										"text": "{{g.title}}",
										"textColor": "@color.bright"
									},
									{
										"type": "label",
										"font": "small",
										"height": 18,
										"anchors": {
											"left": 0,
											"right": 0
										},
										"text": "{{t('hub.subtitle')}}",
										"textColor": "@color.muted"
									}
								]
							},
							{
								"id": "hub-back",
								"style": "sectionLink",
								"icon": "arrow-left",
								"text": "{{t('hub.back')}}",
								"onClick": {
									"run": "openGame",
									"with": {
										"id": "{{g.id}}"
									}
								}
							}
						]
					},
					{
						"type": "row",
						"id": "hub-tabs",
						"when": "{{state.hubPost == null}}",
						"height": 40,
						"anchors": {
							"left": 32,
							"right": 32
						},
						"gap": 6,
						"alignItems": "center",
						"role": "tablist",
						"arrows": "horizontal",
						"children": [
							{
								"id": "{{'hub-tab-' + s}}",
								"repeat": {
									"for": "s",
									"in": "{{['hub', 'discussions', 'guides']}}"
								},
								"style": "pillButton",
								"role": "tab",
								"selected": "{{state.hubTab == s}}",
								"color": "{{state.hubTab == s ? '@color.select' : 'transparent'}}",
								"textColor": "{{state.hubTab == s ? '@color.bright' : '@color.text'}}",
								"text": "{{t(s == 'hub' ? 'hub.all' : 'game.section.' + s)}}",
								"onClick": {
									"set": "state.hubTab",
									"to": "{{s}}"
								}
							}
						]
					},
					{
						"type": "column",
						"id": "hub-thread",
						"when": "{{computed.hubOpen != null}}",
						"let": {
							"p": "{{computed.hubOpen}}"
						},
						"anchors": {
							"left": 32,
							"right": 32
						},
						"height": "{{40 + 196 + 18 + length(computed.hubThread) * 80 + 72 + 48}}",
						"gap": 12,
						"children": [
							{
								"type": "row",
								"height": 40,
								"anchors": {
									"left": 0,
									"right": 0
								},
								"alignItems": "center",
								"children": [
									{
										"id": "hub-thread-back",
										"style": "sectionLink",
										"icon": "arrow-left",
										"text": "{{t('hub.backToPosts')}}",
										"onClick": {
											"run": "closeHubPost"
										}
									}
								]
							},
							{
								"type": "column",
								"id": "hub-thread-post",
								"let": {
									"who": "{{data.friends[p.by % length(data.friends)]}}"
								},
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": 196,
								"color": "@color.panel",
								"radius": 10,
								"gap": 8,
								"children": [
									{
										"type": "panel",
										"height": 6,
										"anchors": {
											"left": 0,
											"right": 0
										},
										"color": "transparent"
									},
									{
										"type": "label",
										"font": "caps",
										"height": 18,
										"anchors": {
											"left": 20,
											"right": 20
										},
										"icon": "{{p.kind == 'guides' ? 'book-open' : 'messages-square'}}",
										"text": "{{upper(t('game.section.' + p.kind))}}",
										"textColor": "@color.accent"
									},
									{
										"type": "label",
										"id": "hub-thread-title",
										"font": "heading",
										"height": 26,
										"anchors": {
											"left": 20,
											"right": 20
										},
										"text": "{{t(p.key, { game: g.title })}}",
										"textColor": "@color.bright"
									},
									{
										"type": "row",
										"height": 24,
										"anchors": {
											"left": 20,
											"right": 20
										},
										"gap": 8,
										"alignItems": "center",
										"children": [
											{
												"use": "avatar",
												"with": {
													"avatar": "{{who.avatar}}",
													"presence": "{{who.presence}}",
													"size": 22
												}
											},
											{
												"type": "label",
												"font": "small",
												"fitText": true,
												"text": "{{t('hub.by', { who: who.name })}}",
												"textColor": "@color.muted"
											}
										]
									},
									{
										"type": "label",
										"font": "default",
										"height": 40,
										"anchors": {
											"left": 20,
											"right": 20
										},
										"wrap": true,
										"text": "{{t('hub.body.' + p.id, { game: g.title })}}",
										"textColor": "@color.text"
									},
									{
										"type": "row",
										"height": 28,
										"anchors": {
											"left": 20,
											"right": 20
										},
										"gap": 8,
										"alignItems": "center",
										"children": [
											{
												"type": "label",
												"id": "hub-vote",
												"font": "small",
												"fitText": true,
												"padding": 10,
												"height": 26,
												"radius": 13,
												"icon": "thumbs-up",
												"text": "{{t('hub.helpful') + '  ' + formatNumber((computed.hubOpen.votes + (contains(state.hubVoted, computed.hubOpen.id) ? 1 : 0)))}}",
												"focusable": true,
												"role": "button",
												"cursor": "hand",
												"selected": "{{contains(state.hubVoted, p.id)}}",
												"color": "{{contains(state.hubVoted, p.id) ? '@color.accent' : '@color.raised'}}",
												"textColor": "{{contains(state.hubVoted, p.id) ? '@color.onAccent' : '@color.text'}}",
												"hover": {
													"textColor": "@color.bright"
												},
												"onClick": {
													"run": "voteHubPost",
													"with": {
														"post": "{{p.id}}"
													}
												}
											}
										]
									}
								]
							},
							{
								"type": "label",
								"font": "caps",
								"height": 18,
								"anchors": {
									"left": 0,
									"right": 0
								},
								"text": "{{upper(t('hub.replies', { n: (computed.hubOpen.replies + count(state.hubReplies, it.post == computed.hubOpen.id)) }))}}",
								"textColor": "@color.muted"
							},
							{
								"type": "column",
								"id": "hub-replies",
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": "{{length(computed.hubThread) * 80}}",
								"gap": 8,
								"role": "list",
								"label": "{{t('hub.replies', { n: (computed.hubOpen.replies + count(state.hubReplies, it.post == computed.hubOpen.id)) })}}",
								"children": [
									{
										"type": "row",
										"repeat": {
											"for": "r",
											"in": "{{computed.hubThread}}"
										},
										"let": {
											"who": "{{r.mine ? null : data.friends[r.by]}}"
										},
										"role": "listitem",
										"anchors": {
											"left": 0,
											"right": 0
										},
										"height": 72,
										"gap": 12,
										"alignItems": "center",
										"color": "{{r.mine ? '@color.raised' : '@color.panel'}}",
										"radius": 8,
										"children": [
											{
												"type": "panel",
												"width": 4,
												"height": 1,
												"color": "transparent"
											},
											{
												"use": "avatar",
												"with": {
													"avatar": "{{r.mine ? state.user.avatar : who.avatar}}",
													"presence": "{{r.mine ? state.user.status : who.presence}}",
													"size": 36
												}
											},
											{
												"type": "column",
												"grow": 1,
												"height": 44,
												"gap": 4,
												"children": [
													{
														"type": "label",
														"font": "strong",
														"height": 20,
														"anchors": {
															"left": 0,
															"right": 0
														},
														"text": "{{r.mine ? t('hub.you', { name: state.user.name }) : who.name}}",
														"textColor": "{{r.mine ? '@color.accent' : '@color.bright'}}"
													},
													{
														"type": "label",
														"font": "default",
														"height": 20,
														"anchors": {
															"left": 0,
															"right": 0
														},
														"text": "{{r.mine ? r.text : t(r.key, { game: g.title })}}",
														"textColor": "@color.text"
													}
												]
											},
											{
												"type": "panel",
												"width": 4,
												"height": 1,
												"color": "transparent"
											}
										]
									}
								]
							},
							{
								"type": "row",
								"height": 72,
								"anchors": {
									"left": 0,
									"right": 0
								},
								"gap": 10,
								"alignItems": "center",
								"children": [
									{
										"type": "textarea",
										"id": "hub-reply-input",
										"grow": 1,
										"height": 38,
										"padding": 12,
										"bind": "state.hubDraft",
										"radius": 6,
										"color": "@color.field",
										"borderWidth": 1,
										"borderColor": "@color.border",
										"placeholder": "{{t('hub.replyPlaceholder')}}",
										"placeholderColor": "@color.dim",
										"textColor": "@color.text",
										"label": "{{t('hub.replyPlaceholder')}}",
										"focused": {
											"borderColor": "@color.accent"
										},
										"onSubmit": {
											"run": "replyToPost"
										}
									},
									{
										"type": "label",
										"id": "hub-reply-send",
										"font": "strong",
										"fitText": true,
										"padding": 16,
										"height": 38,
										"radius": 6,
										"icon": "send",
										"text": "{{t('hub.reply')}}",
										"focusable": true,
										"role": "button",
										"cursor": "hand",
										"color": "{{trim(state.hubDraft) == '' ? '@color.raised' : '@color.accent'}}",
										"textColor": "{{trim(state.hubDraft) == '' ? '@color.dim' : '@color.onAccent'}}",
										"onClick": {
											"run": "replyToPost"
										}
									}
								]
							}
						]
					},
					{
						"type": "column",
						"id": "hub-posts",
						"when": "{{state.hubPost == null}}",
						"anchors": {
							"left": 32,
							"right": 32
						},
						"height": "{{8 + count(state.hubPosts, state.hubTab == 'hub' || it.kind == state.hubTab) * 76}}",
						"gap": 8,
						"role": "list",
						"label": "{{t('hub.subtitle')}}",
						"children": [
							{
								"type": "row",
								"id": "{{'hub-post-' + p.id}}",
								"repeat": {
									"for": "p",
									"in": "{{filter(state.hubPosts, state.hubTab == 'hub' || it.kind == state.hubTab)}}"
								},
								"let": {
									"who": "{{data.friends[p.by % length(data.friends)]}}"
								},
								"role": "listitem",
								"label": "{{t(p.key, { game: g.title })}}",
								"focusable": true,
								"cursor": "hand",
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": 68,
								"gap": 12,
								"alignItems": "center",
								"color": "@color.panel",
								"radius": 8,
								"hover": {
									"color": "@color.raised"
								},
								"onClick": {
									"run": "openHubPost",
									"with": {
										"post": "{{p.id}}"
									}
								},
								"children": [
									{
										"type": "panel",
										"width": 2,
										"height": 1,
										"color": "transparent"
									},
									{
										"type": "label",
										"icon": "{{p.kind == 'guides' ? 'book-open' : 'messages-square'}}",
										"text": "",
										"fitText": true,
										"textColor": "@color.accent"
									},
									{
										"type": "column",
										"grow": 1,
										"height": 40,
										"children": [
											{
												"type": "label",
												"font": "strong",
												"height": 22,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"text": "{{t(p.key, { game: g.title })}}",
												"textColor": "@color.text"
											},
											{
												"type": "label",
												"font": "small",
												"height": 18,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"text": "{{t('hub.by', { who: who.name })}}",
												"textColor": "@color.muted"
											}
										]
									},
									{
										"type": "label",
										"font": "small",
										"fitText": true,
										"icon": "thumbs-up",
										"text": "{{formatNumber((p.votes + (contains(state.hubVoted, p.id) ? 1 : 0)))}}",
										"textColor": "@color.muted"
									},
									{
										"type": "label",
										"font": "small",
										"fitText": true,
										"icon": "message-circle",
										"text": "{{formatNumber((p.replies + count(state.hubReplies, it.post == p.id)))}}",
										"textColor": "@color.muted"
									},
									{
										"type": "panel",
										"width": 2,
										"height": 1,
										"color": "transparent"
									}
								]
							}
						]
					}
				]
			}
		}
	}
}
