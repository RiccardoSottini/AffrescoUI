{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The client's own windows, reached from the menus: Settings (interface, downloads, storage, account), product keys and gift codes, a game from this computer, back up and restore, About and Help, signing out, offline and couch mode (big tiles for a television). Product keys and gift codes are invented, for trying it out.",

	"state": {
		"settingsDialog": { "open": false, "page": "interface" },
		"code": { "open": false, "kind": "activate", "text": "", "error": "" },
		"addGame": { "open": false, "name": "" },
		"backup": { "open": false, "restored": null },
		"info": { "open": false, "kind": "about" },
		"session": { "signedOut": false, "offline": false },
		"couch": { "open": false, "at": 0, "section": "library" },
		"toast": { "open": false, "text": "" },
		"productKeys": { "AR7Q2-KX4MZ-P9T3L": "glasswing", "HX5RE-2PWNA-7LDKC": "volt" },
		"giftCodes": { "GIFT-2026-ARCD": 20, "GIFT-5555-PLUM": 5 },
		"redeemed": [],
		"storageDrive": "main"
	},

	"computed": {
		"couchGames": "{{sort(computed.owned, it.lastPlayed ?? 0, 'desc')}}",
		"couchGame": "{{computed.couchGames[state.couch.at]}}",
		"gameTitles": "{{fromEntries(map(data.games, { key: it.id, value: it.title }))}}",
		"couchItems": "{{state.couch.section == 'store' ? map(filter(computed.storeGames, !it.owned), { id: it.id, title: it.title, file: '../assets/art/' + (it.art ?? it.id) + '/cover.svg', sub: t('couch.storeLine', { genre: it.genre ?? '', price: formatCurrency(it.price * (1 - (it.discount ?? 0) / 100), 'EUR') }) }) : state.couch.section == 'friends' ? map(data.friends, { id: it.id, title: it.name, file: '../assets/art/avatars/' + it.avatar + '.svg', sub: it.presence == 'ingame' ? t('couch.playing', { game: computed.gameTitles[it.game] ?? '' }) : t('presence.' + it.presence) }) : map(computed.couchGames, { id: it.id, title: it.title, file: '../assets/art/' + (it.art ?? it.id) + '/cover.svg', sub: t('couch.gameLine', { genre: it.genre ?? '', hours: formatNumber(it.hours ?? 0, 0, 1) }) })}}",
		"couchItem": "{{computed.couchItems[state.couch.at]}}",
		"installedGames": "{{sort(filter(data.games, it.installed), it.sizeGb ?? 0, 'desc')}}",
		"usedGb": "{{sum(filter(data.games, it.installed), it.sizeGb ?? 0)}}",
		"drives": "{{[{ id: 'main', title: t('storage.main'), totalGb: 1000, otherGb: 180 }, { id: 'second', title: t('storage.second'), totalGb: 2000, otherGb: 60 }]}}",
		"drive": "{{find(computed.drives, it.id == state.storageDrive)}}",
		"driveGames": "{{filter(computed.installedGames, (it.drive ?? 'main') == state.storageDrive)}}",
		"driveUsedGb": "{{computed.drive.otherGb + sum(computed.driveGames, it.sizeGb ?? 0)}}"
	},

	"actions": {
		"setSetting": {
			"title": "Change a setting",
			"category": "Settings",
			"do": [{ "set": "{{'settings.' + key}}", "to": "{{value}}" }]
		},
		"openSettings": {
			"title": "Settings",
			"category": "Arcadia",
			"icon": "settings",
			"description": "Opens Settings at a page (interface, downloads, storage or account).",
			"do": [{ "dismiss": true }, { "set": "state.settingsDialog", "to": { "open": true, "page": "{{page ?? 'interface'}}" } }]
		},
		"moveGame": {
			"title": "Move to the other drive",
			"category": "Settings",
			"icon": "hard-drive",
			"description": "Moves an installed game to the computer's other drive; it plays the same from there.",
			"arguments": { "id": { "type": "string", "description": "The game's id" } },
			"do": [
				{
					"if": "{{find(data.games, it.id == id).installed && find(data.games, it.id == id).status != 'running'}}",
					"then": [
						{ "update": "games", "id": "{{id}}", "fields": { "drive": "{{(find(data.games, it.id == id).drive ?? 'main') == 'main' ? 'second' : 'main'}}" } },
						{ "run": "notify", "with": { "text": "{{t('storage.moved', { title: find(data.games, it.id == id).title, name: t('storage.' + find(data.games, it.id == id).drive) })}}" } }
					]
				}
			]
		},
		"notify": {
			"title": "Show a notice",
			"category": "Arcadia",
			"description": "Shows a short notice at the bottom right; it goes away by itself.",
			"do": [
				{ "set": "state.toast", "to": { "open": true, "text": "{{text}}" } },
				{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
			]
		},
		"checkUpdates": {
			"title": "Check for client updates",
			"category": "Arcadia",
			"do": [
				{ "run": "notify", "with": { "text": "{{t('notice.checking')}}" } },
				{ "after": 1200, "do": [{ "run": "notify", "with": { "text": "{{t('notice.upToDate')}}" } }] }
			]
		},
		"exitApp": {
			"title": "Exit",
			"category": "Arcadia",
			"do": [{ "closeWindow": "main" }]
		},
		"clearCache": {
			"title": "Clear the download cache",
			"category": "Settings",
			"do": [{ "run": "notify", "with": { "text": "{{t('settings.cacheCleared')}}" } }]
		},
		"toggleOffline": {
			"title": "Go offline or online",
			"category": "Arcadia",
			"description": "Offline, the store and friends wait for the network; installed games still play.",
			"do": [
				{ "toggle": "state.session.offline" },
				{ "run": "notify", "with": { "text": "{{t(state.session.offline ? 'notice.offline' : 'notice.online')}}" } }
			]
		},
		"signOut": {
			"title": "Sign out",
			"category": "Arcadia",
			"do": [{ "dismiss": true }, { "set": "state.session.signedOut", "to": true }, { "set": "state.couch.open", "to": false }]
		},
		"signIn": {
			"title": "Sign in",
			"category": "Arcadia",
			"do": [{ "set": "state.session.signedOut", "to": false }]
		},
		"openCode": {
			"title": "Activate a product or redeem a gift code",
			"category": "Games",
			"description": "kind is activate (a product key adds a game) or redeem (a gift code adds to the wallet).",
			"do": [{ "set": "state.code", "to": { "open": true, "kind": "{{kind}}", "text": "", "error": "" } }]
		},
		"closeCode": {
			"title": "Close the code window",
			"category": "Games",
			"description": "Closes only the code window, so Settings stays open under it.",
			"do": [{ "set": "state.code.open", "to": false }]
		},
		"submitCode": {
			"title": "Use the code",
			"category": "Games",
			"description": "Checks the code typed; a good one adds its game or its amount, a wrong one says why.",
			"do": [
				{ "set": "state.code.text", "to": "{{upper(trim(state.code.text))}}" },
				{
					"if": "{{state.code.kind == 'activate'}}",
					"then": [{ "run": "activateKey", "with": { "id": "{{state.productKeys[state.code.text]}}" } }],
					"else": [{ "run": "redeemGift", "with": { "amount": "{{state.giftCodes[state.code.text]}}" } }]
				}
			]
		},
		"activateKey": {
			"title": "Activate a product key",
			"category": "Games",
			"do": [
				{
					"if": "{{id == null}}",
					"then": [{ "set": "state.code.error", "to": "{{t('code.badKey')}}" }],
					"else": [
						{
							"if": "{{find(data.games, it.id == id).owned}}",
							"then": [{ "set": "state.code.error", "to": "{{t('code.owned')}}" }],
							"else": [
								{ "update": "games", "id": "{{id}}", "fields": { "owned": true } },
								{ "set": "state.code.open", "to": false },
								{ "run": "notify", "with": { "text": "{{t('code.added', { game: find(data.games, it.id == id).title })}}" } },
								{ "run": "openGame", "with": { "id": "{{id}}" } }
							]
						}
					]
				}
			]
		},
		"redeemGift": {
			"title": "Redeem a gift code",
			"category": "Games",
			"do": [
				{
					"if": "{{amount == null}}",
					"then": [{ "set": "state.code.error", "to": "{{t('code.badGift')}}" }],
					"else": [
						{
							"if": "{{contains(state.redeemed, state.code.text)}}",
							"then": [{ "set": "state.code.error", "to": "{{t('code.used')}}" }],
							"else": [
								{ "push": "state.redeemed", "value": "{{state.code.text}}" },
								{ "set": "state.user.wallet", "to": "{{round((state.user.wallet + amount) * 100) / 100}}" },
								{ "set": "state.code.open", "to": false },
								{ "run": "notify", "with": { "text": "{{t('code.funded', { amount: formatCurrency(amount, 'EUR') })}}" } }
							]
						}
					]
				}
			]
		},
		"openAddGame": {
			"title": "Add a game from this computer",
			"category": "Games",
			"icon": "package-plus",
			"do": [{ "dismiss": true }, { "set": "state.addGame", "to": { "open": true, "name": "" } }]
		},
		"addLocalGame": {
			"title": "Add a game from this computer",
			"category": "Games",
			"description": "Adds a game Arcadia doesn't sell to the library, ready to play from it.",
			"do": [
				{
					"if": "{{trim(state.addGame.name) != ''}}",
					"then": [
						{
							"insert": "games",
							"value": {
								"title": "{{trim(state.addGame.name)}}",
								"genre": "Other",
								"owned": true,
								"installed": true,
								"status": "ready",
								"sizeGb": 0,
								"local": true,
								"art": "local",
								"logo": "#f5a524",
								"achievements": [0, 0]
							},
							"then": [{ "run": "openGame", "with": { "id": "{{result.id}}" } }]
						},
						{ "set": "state.addGame.open", "to": false }
					]
				}
			]
		},
		"openBackup": {
			"title": "Back up and restore games",
			"category": "Arcadia",
			"do": [{ "dismiss": true }, { "set": "state.backup", "to": { "open": true, "restored": null } }]
		},
		"backUp": {
			"title": "Back up the installed games",
			"category": "Arcadia",
			"description": "Saves which games are installed, with their launch options and update choices, as a JSON file.",
			"do": [
				{
					"saveFile": "{{{ format: 'arcadia-backup', version: 1, games: map(filter(data.games, it.installed), { id: it.id, launchOptions: it.launchOptions ?? '', overlay: it.overlay, cloud: it.cloud, updates: it.updates }) }}}",
					"name": "arcadia-backup.json",
					"onDone": [{ "run": "notify", "with": { "text": "{{t('backup.saved')}}" } }]
				}
			]
		},
		"restore": {
			"title": "Restore a backup",
			"category": "Arcadia",
			"description": "Reads a backup and puts back the settings of the games it names that are in the library.",
			"do": [
				{
					"openFile": "state.backup.restored",
					"extensions": ["json"],
					"onDone": [
						{
							"forEach": "{{state.backup.restored.games ?? []}}",
							"as": "b",
							"do": [
								{
									"if": "{{find(computed.owned, it.id == b.id) != null}}",
									"then": [
										{
											"update": "games",
											"id": "{{b.id}}",
											"fields": { "launchOptions": "{{text(b.launchOptions ?? '')}}", "updates": "{{b.updates ?? 'auto'}}" }
										}
									]
								}
							]
						},
						{ "run": "notify", "with": { "text": "{{t('backup.restored')}}" } }
					]
				}
			]
		},
		"showInfo": {
			"title": "About and help",
			"category": "Help",
			"description": "kind is about, support, privacy or system.",
			"do": [{ "dismiss": true }, { "set": "state.info", "to": { "open": true, "kind": "{{kind}}" } }]
		},
		"openNotice": {
			"title": "Open a notification",
			"category": "Arcadia",
			"do": [
				{ "set": "{{'state.notifications[' + i + '].unread'}}", "to": false },
				{ "run": "{{state.notifications[i].icon == 'download' ? 'showDownloads' : state.notifications[i].icon == 'user-plus' ? 'showCommunity' : 'showStore'}}" }
			]
		},
		"enterCouch": {
			"title": "Couch mode",
			"category": "View",
			"icon": "sofa",
			"description": "Big tiles for a television across the room, the whole screen, arrows and Enter.",
			"do": [
				{ "dismiss": true },
				{ "set": "state.couch", "to": { "open": true, "at": 0, "section": "library" } },
				{ "fullscreen": true },
				{ "focus": "#couch-shelf" }
			]
		},
		"leaveCouch": {
			"title": "Leave couch mode",
			"category": "View",
			"do": [{ "set": "state.couch.open", "to": false }, { "fullscreen": false }]
		},
		"couchMove": {
			"title": "Move along the couch shelf",
			"category": "View",
			"do": [{ "set": "state.couch.at", "to": "{{clamp(state.couch.at + by, 0, length(computed.couchItems) - 1)}}" }]
		},
		"couchSection": {
			"title": "Show a row of couch mode",
			"category": "View",
			"description": "Shows your games, the store or your friends in couch mode, from the first tile.",
			"arguments": { "section": { "enum": ["library", "store", "friends"] } },
			"do": [{ "set": "state.couch.section", "to": "{{section}}" }, { "set": "state.couch.at", "to": 0 }, { "focus": "#couch-shelf" }]
		},
		"couchStep": {
			"title": "Show the couch row before or after",
			"category": "View",
			"arguments": { "by": { "type": "integer" } },
			"do": [{ "run": "couchSection", "with": { "section": "{{['library', 'store', 'friends'][clamp(indexOf(['library', 'store', 'friends'], state.couch.section) + by, 0, 2)]}}" } }]
		},
		"couchEnter": {
			"title": "Open the couch tile chosen",
			"category": "View",
			"description": "Plays a game of yours, opens a store game's page, or chats with a friend; the last two leave couch mode.",
			"do": [
				{
					"if": "{{state.couch.section == 'store'}}",
					"then": [{ "run": "leaveCouch" }, { "run": "openStore", "with": { "id": "{{computed.couchItem.id}}" } }],
					"else": [
						{
							"if": "{{state.couch.section == 'friends'}}",
							"then": [{ "run": "leaveCouch" }, { "run": "showCommunity" }, { "run": "openChat", "with": { "id": "{{computed.couchItem.id}}" } }],
							"else": [{ "run": "primary", "with": { "game": "{{computed.couchGame}}" } }]
						}
					]
				}
			]
		}
	},

	"styles": {
		"sectionCaps": {
			"type": "label",
			"font": "caps",
			"textColor": "@color.muted",
			"anchors": { "left": 0, "right": 0 },
			"height": 18
		},
		"pillButton": {
			"type": "label",
			"fitText": true,
			"padding": 12,
			"height": 30,
			"radius": 15,
			"focusable": true,
			"role": "button",
			"cursor": "hand",
			"color": "@color.raised",
			"textColor": "@color.text",
			"hover": { "color": "@color.hover", "textColor": "@color.bright" }
		}
	},

	"components": {
		"choice": {
			"note": "One choice of a setting, as a pill: lit when it is the current value.",
			"params": { "title": "", "key": "", "value": null, "current": null },
			"node": {
				"style": "pillButton",
				"role": "radio",
				"text": "{{title}}",
				"selected": "{{current == value}}",
				"color": "{{current == value ? '@color.select' : '@color.raised'}}",
				"textColor": "{{current == value ? '@color.bright' : '@color.text'}}",
				"hover": { "color": "{{current == value ? '@color.select' : '@color.hover'}}", "textColor": "@color.bright" },
				"onClick": { "run": "setSetting", "with": { "key": "{{key}}", "value": "{{value}}" } }
			}
		},
		"choiceRow": {
			"note": "A setting's caps title over its choices, each { value, title }.",
			"params": { "title": "", "key": "", "current": null, "options": [], "top": 0 },
			"node": {
				"anchors": { "left": 0, "right": 0, "top": "{{top}}" },
				"height": 56,
				"color": "transparent",
				"children": [
					{ "style": "sectionCaps", "text": "{{upper(title)}}" },
					{
						"type": "row",
						"anchors": { "left": 0, "right": 0, "top": 22 },
						"height": 38,
						"gap": 6,
						"alignItems": "center",
						"role": "radiogroup",
						"label": "{{title}}",
						"arrows": "horizontal",
						"children": [
							{
								"id": "{{'setting-' + slug(key) + '-' + o.value}}",
								"repeat": { "for": "o", "in": "{{options}}" },
								"use": "choice",
								"with": { "title": "{{o.title}}", "key": "{{key}}", "value": "{{o.value}}", "current": "{{current}}" }
							}
						]
					}
				]
			}
		},
		"settingsDialog": {
			"note": "Settings: a page per category on the left, like a game's properties.",
			"params": {},
			"node": {
				"use": "dialog",
				"with": {
					"open": "state.settingsDialog.open",
					"width": 700,
					"height": 470,
					"title": "{{t('menu.settings')}}",
					"color": "@color.panel",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"highlight": "@color.accent",
					"buttons": [{ "title": "{{t('dialog.close')}}" }]
				},
				"children": [
					{
						"type": "row",
						"id": "settings-body",
						"anchors": { "left": 20, "right": 20, "top": 52, "bottom": 60 },
						"gap": 20,
						"children": [
							{
								"type": "column",
								"id": "settings-pages",
								"width": 150,
								"alignSelf": "stretch",
								"gap": 2,
								"role": "tablist",
								"arrows": "vertical",
								"children": [
									{
										"type": "label",
										"id": "{{'settings-page-' + page}}",
										"repeat": { "for": "page", "in": "{{['interface', 'downloads', 'storage', 'account']}}" },
										"anchors": { "left": 0, "right": 0 },
										"height": 30,
										"padding": 10,
										"radius": 15,
										"role": "tab",
										"focusable": true,
										"cursor": "hand",
										"selected": "{{state.settingsDialog.page == page}}",
										"text": "{{t('settings.page.' + page)}}",
										"color": "{{state.settingsDialog.page == page ? '@color.select' : 'transparent'}}",
										"textColor": "{{state.settingsDialog.page == page ? '@color.bright' : '@color.muted'}}",
										"hover": { "textColor": "@color.bright" },
										"onClick": { "set": "state.settingsDialog.page", "to": "{{page}}" }
									}
								]
							},
							{ "type": "panel", "width": 1, "alignSelf": "stretch", "color": "@color.border" },
							{
								"id": "settings-page",
								"grow": 1,
								"alignSelf": "stretch",
								"color": "transparent",
								"children": [
									{ "when": "{{state.settingsDialog.page == 'interface'}}", "use": "settingsInterface" },
									{ "when": "{{state.settingsDialog.page == 'downloads'}}", "use": "settingsDownloads" },
									{ "when": "{{state.settingsDialog.page == 'storage'}}", "use": "settingsStorage" },
									{ "when": "{{state.settingsDialog.page == 'account'}}", "use": "settingsAccount" }
								]
							}
						]
					}
				]
			}
		},
		"settingsInterface": {
			"params": {},
			"node": {
				"fill": true,
				"color": "transparent",
				"children": [
					{
						"use": "choiceRow",
						"with": {
							"top": 0,
							"title": "{{t('settings.theme')}}",
							"key": "appearance.theme",
							"current": "{{settings.appearance.theme}}",
							"options": "{{[{ value: 'dark', title: t('settings.dark') }, { value: 'light', title: t('settings.light') }]}}"
						}
					},
					{
						"use": "choiceRow",
						"with": {
							"top": 64,
							"title": "{{t('settings.language')}}",
							"key": "appearance.language",
							"current": "{{settings.appearance.language}}",
							"options": [
								{ "value": "en", "title": "English" },
								{ "value": "es", "title": "Español" },
								{ "value": "fr", "title": "Français" }
							]
						}
					},
					{
						"use": "choiceRow",
						"with": {
							"top": 128,
							"title": "{{t('settings.startPage')}}",
							"key": "appearance.startPage",
							"current": "{{settings.appearance.startPage}}",
							"options": "{{map(['library', 'store', 'community'], { value: it, title: t('nav.' + it) })}}"
						}
					},
					{
						"use": "choiceRow",
						"with": {
							"top": 192,
							"title": "{{t('settings.sortBy')}}",
							"key": "library.sortBy",
							"current": "{{settings.library.sortBy}}",
							"options": "{{map(['name', 'playtime', 'recent'], { value: it, title: t('sort.' + it) })}}"
						}
					}
				]
			}
		},
		"settingsDownloads": {
			"params": {},
			"node": {
				"fill": true,
				"color": "transparent",
				"children": [
					{
						"use": "choiceRow",
						"with": {
							"top": 0,
							"title": "{{t('settings.region')}}",
							"key": "downloads.region",
							"current": "{{settings.downloads.region}}",
							"options": "{{map(['auto', 'europe', 'americas', 'asia'], { value: it, title: t('settings.region.' + it) })}}"
						}
					},
					{
						"use": "choiceRow",
						"with": {
							"top": 64,
							"title": "{{t('settings.limit')}}",
							"key": "downloads.limit",
							"current": "{{settings.downloads.limit}}",
							"options": "{{map([0, 10, 25], { value: it, title: it == 0 ? t('settings.noLimit') : it + ' MB/s' })}}"
						}
					},
					{
						"use": "choiceRow",
						"with": {
							"top": 128,
							"title": "{{t('settings.schedule')}}",
							"key": "downloads.schedule",
							"current": "{{settings.downloads.schedule}}",
							"options": "{{[{ value: 'anytime', title: t('settings.schedule.anytime') }, { value: 'night', title: t('settings.schedule.night') }]}}"
						}
					},
					{
						"type": "row",
						"id": "settings-while-playing",
						"anchors": { "left": 0, "right": 0, "top": 196 },
						"height": 30,
						"alignItems": "center",
