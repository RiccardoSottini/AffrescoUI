								"width": 40,
								"height": 22,
								"label": "{{t('settings.whilePlaying')}}",
								"checked": "{{settings.downloads.whilePlaying}}",
								"activeColor": "@color.accent",
								"onChange": { "set": "settings.downloads.whilePlaying", "to": "{{event.value}}" }
							}
						]
					},
					{ "style": "sectionCaps", "anchors": { "left": 0, "right": 0, "top": 244 }, "text": "{{upper(t('settings.cache'))}}" },
					{
						"type": "label",
						"font": "small",
						"wrap": true,
						"anchors": { "left": 0, "right": 0, "top": 266 },
						"height": 36,
						"text": "{{t('settings.cacheNote')}}",
						"textColor": "@color.muted"
					},
					{
						"id": "settings-clear-cache",
						"style": "pillButton",
						"anchors": { "left": 0, "top": 304 },
						"text": "{{t('settings.clearCache')}}",
						"onClick": "clearCache"
					}
				]
			}
		},
		"settingsStorage": {
			"note": "The storage page: the drives to choose from, the one chosen's use, a bar of the games on it, and each game with a way to move it to the other drive or uninstall it.",
			"params": {},
			"node": {
				"fill": true,
				"color": "transparent",
				"children": [
					{
						"type": "row",
						"id": "storage-drives",
						"anchors": {
							"left": 0,
							"right": 0,
							"top": 0
						},
						"height": 38,
						"gap": 6,
						"alignItems": "center",
						"role": "tablist",
						"arrows": "horizontal",
						"children": [
							{
								"repeat": {
									"for": "d",
									"in": "{{computed.drives}}",
									"key": "{{d.id}}"
								},
								"id": "{{'storage-drive-' + d.id}}",
								"style": "pillButton",
								"role": "tab",
								"icon": "hard-drive",
								"text": "{{t('storage.driveTab', { name: d.title, size: formatNumber(d.totalGb) })}}",
								"selected": "{{state.storageDrive == d.id}}",
								"color": "{{state.storageDrive == d.id ? '@color.select' : '@color.raised'}}",
								"textColor": "{{state.storageDrive == d.id ? '@color.bright' : '@color.text'}}",
								"onClick": {
									"set": "state.storageDrive",
									"to": "{{d.id}}"
								}
							}
						]
					},
					{
						"type": "label",
						"id": "storage-used",
						"font": "small",
						"anchors": {
							"left": 0,
							"right": 0,
							"top": 48
						},
						"height": 18,
						"text": "{{t('settings.used', { used: formatNumber(computed.driveUsedGb, 0, 1), total: formatNumber(computed.drive.totalGb) })}}",
						"textColor": "@color.text"
					},
					{
						"type": "row",
						"id": "storage-bar",
						"anchors": {
							"left": 0,
							"right": 0,
							"top": 72
						},
						"height": 12,
						"radius": 6,
						"color": "@color.raised",
						"label": "{{t('settings.used', { used: formatNumber(computed.driveUsedGb, 0, 1), total: formatNumber(computed.drive.totalGb) })}}",
						"children": [
							{
								"width": "{{text(100 * computed.drive.otherGb / computed.drive.totalGb) + '%'}}",
								"alignSelf": "stretch",
								"color": "@color.dim"
							},
							{
								"repeat": {
									"for": "g",
									"in": "{{computed.driveGames}}",
									"index": "i"
								},
								"width": "{{text(100 * g.sizeGb / computed.drive.totalGb) + '%'}}",
								"alignSelf": "stretch",
								"color": "{{['@color.accent', '@color.play', '@color.online', '@color.warm', '@color.link'][i % 5]}}"
							}
						]
					},
					{
						"type": "label",
						"id": "storage-empty",
						"when": "{{empty(computed.driveGames)}}",
						"font": "small",
						"anchors": {
							"left": 0,
							"right": 0,
							"top": 100
						},
						"height": 18,
						"text": "{{t('storage.empty')}}",
						"textColor": "@color.muted"
					},
					{
						"type": "column",
						"id": "storage-games",
						"anchors": {
							"left": 0,
							"right": 0,
							"top": 96,
							"bottom": 0
						},
						"scroll": "vertical",
						"children": [
							{
								"type": "row",
								"id": "{{'storage-' + g.id}}",
								"repeat": {
									"for": "g",
									"in": "{{computed.driveGames}}",
									"index": "i",
									"key": "{{g.id}}"
								},
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": 32,
								"gap": 10,
								"alignItems": "center",
								"children": [
									{
										"type": "panel",
										"width": 10,
										"height": 10,
										"radius": 5,
										"color": "{{['@color.accent', '@color.play', '@color.online', '@color.warm', '@color.link'][i % 5]}}"
									},
									{
										"type": "label",
										"grow": 1,
										"height": 20,
										"text": "{{g.title}}",
										"textColor": "@color.text"
									},
									{
										"type": "label",
										"font": "small",
										"fitText": true,
										"text": "{{t('properties.sizeValue', { size: formatNumber(g.sizeGb, 0, 1) })}}",
										"textColor": "@color.muted"
									},
									{
										"type": "label",
										"id": "{{'storage-move-' + g.id}}",
										"font": "small",
										"fitText": true,
										"padding": 6,
										"radius": 3,
										"focusable": true,
										"role": "button",
										"cursor": "hand",
										"hover": {
											"color": "@color.hover"
										},
										"text": "{{t('storage.moveTo', { name: t(state.storageDrive == 'main' ? 'storage.second' : 'storage.main') })}}",
										"textColor": "{{g.status == 'running' ? '@color.dim' : '@color.link'}}",
										"disabled": "{{g.status == 'running'}}",
										"tooltip": "{{t(g.status == 'running' ? 'storage.moveRunning' : 'storage.moveAbout')}}",
										"onClick": {
											"run": "moveGame",
											"with": {
												"id": "{{g.id}}"
											}
										}
									},
									{
										"type": "label",
										"id": "{{'storage-uninstall-' + g.id}}",
										"font": "small",
										"fitText": true,
										"padding": 6,
										"radius": 3,
										"focusable": true,
										"role": "button",
										"cursor": "hand",
										"hover": {
											"color": "@color.hover"
										},
										"text": "{{t('menu.game.uninstall')}}",
										"textColor": "{{g.status == 'running' ? '@color.dim' : '@color.link'}}",
										"disabled": "{{g.status == 'running'}}",
										"onClick": {
											"run": "askUninstall",
											"with": {
												"id": "{{g.id}}"
											}
										}
									}
								]
							}
						]
					}
				]
			}
		},
