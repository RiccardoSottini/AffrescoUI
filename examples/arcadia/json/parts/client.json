		"couchMode": {
			"note": "Couch mode: the whole screen, big tiles of your games, the store's or your friends; left and right to choose, up and down to change the row, Enter to play, open or chat, Escape to leave.",
			"params": {},
			"node": {
				"id": "couch",
				"overlay": { "placement": "window", "open": "state.couch.open", "modal": true },
				"fill": true,
				"gradient": { "kind": "linear", "angle": 160, "stops": ["@color.select", "@color.top"] },
				"children": [
					{ "type": "label", "font": "logo", "anchors": { "left": 48, "top": 32 }, "fitText": true, "text": "Arcadia", "textColor": "@color.accent" },
					{
						"type": "row",
						"id": "couch-tabs",
						"anchors": { "left": 300, "right": 300, "top": 34 },
						"height": 56,
						"gap": 8,
						"justify": "center",
						"alignItems": "center",
						"role": "tablist",
						"arrows": "horizontal",
						"label": "{{t('couch.rows')}}",
						"children": [
							{
								"repeat": { "for": "section", "in": "{{['library', 'store', 'friends']}}" },
								"id": "{{'couch-tab-' + section}}",
								"style": "pillButton",
								"role": "tab",
								"font": "strong",
								"radius": 20,
								"padding": 12,
								"icon": "{{section == 'library' ? 'gamepad-2' : section == 'store' ? 'store' : 'users'}}",
								"text": "{{t('couch.tab.' + section)}}",
								"selected": "{{state.couch.section == section}}",
								"color": "{{state.couch.section == section ? '@color.accent' : '@color.raised'}}",
								"textColor": "{{state.couch.section == section ? '@color.top' : '@color.text'}}",
								"onClick": { "run": "couchSection", "with": { "section": "{{section}}" } }
							}
						]
					},
					{
						"id": "couch-leave",
						"style": "pillButton",
						"anchors": { "right": 48, "top": 44 },
						"icon": "x",
						"text": "{{t('couch.leave')}}",
						"onClick": "leaveCouch"
					},
					{
						"type": "row",
						"id": "couch-shelf",
						"anchors": { "left": 48, "right": 48, "top": 140 },
						"height": 330,
						"gap": 24,
						"alignItems": "center",
						"focusable": true,
						"role": "listbox",
						"label": "{{t('couch.shelf')}}",
						"autofocus": true,
						"keys": {
							"left": { "run": "couchMove", "with": { "by": -1 } },
							"right": { "run": "couchMove", "with": { "by": 1 } },
							"up": { "run": "couchStep", "with": { "by": -1 } },
							"down": { "run": "couchStep", "with": { "by": 1 } },
							"enter": "couchEnter",
							"escape": "leaveCouch"
						},
						"children": [
							{
								"type": "image",
								"id": "{{'couch-' + g.id}}",
								"repeat": { "for": "g", "in": "{{slice(computed.couchItems, max(0, state.couch.at - 1), max(0, state.couch.at - 1) + 9)}}", "index": "i" },
								"let": { "on": "{{g.id == computed.couchItem.id}}", "square": "{{state.couch.section == 'friends'}}" },
								"role": "option",
								"label": "{{g.title}}",
								"selected": "{{on}}",
								"file": "{{g.file}}",
								"fit": "cover",
								"width": "{{on ? 210 : 150}}",
								"height": "{{square ? (on ? 210 : 150) : on ? 315 : 225}}",
								"radius": "{{square ? 105 : 12}}",
								"borderWidth": "{{on ? 4 : 0}}",
								"borderColor": "@color.accent",
								"cursor": "hand",
								"onClick": { "set": "state.couch.at", "to": "{{indexOf(map(computed.couchItems, it.id), g.id)}}" }
							}
						]
					},
					{
						"type": "label",
						"font": "logo",
						"anchors": { "left": 48, "right": 48, "top": 500 },
						"height": 60,
						"text": "{{computed.couchItem.title ?? ''}}",
						"textColor": "@color.bright"
					},
					{
						"type": "label",
						"id": "couch-sub",
						"font": "heading",
						"anchors": { "left": 48, "right": 48, "top": 560 },
						"height": 24,
						"text": "{{computed.couchItem.sub ?? ''}}",
						"textColor": "@color.muted"
					},
					{
						"id": "couch-play",
						"style": "pillButton",
						"anchors": { "left": 48, "top": 604 },
						"height": 44,
						"radius": 22,
						"padding": 22,
						"font": "button",
						"color": "{{state.couch.section == 'friends' || computed.couchGame.status == 'ready' ? '@color.play' : '@color.accent'}}",
						"textColor": "@color.top",
						"text": "{{t(state.couch.section == 'store' ? 'couch.viewStore' : state.couch.section == 'friends' ? 'couch.chat' : computed.couchGame.status == 'ready' ? 'menu.game.play' : computed.couchGame.status == 'running' ? 'menu.game.stop' : computed.couchGame.status == 'update' ? 'menu.game.update' : 'menu.game.install')}}",
						"onClick": "couchEnter"
					},
					{
						"type": "label",
						"font": "strong",
						"anchors": { "left": 48, "bottom": 32 },
						"fitText": true,
						"text": "{{t('couch.hint')}}",
						"textColor": "@color.muted"
					}
				]
			}
		}
	}
}
