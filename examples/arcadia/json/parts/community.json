												"anchors": {
													"left": 24,
													"right": 24
												},
												"fitContent": "height",
												"gap": 10,
												"children": [
													{
														"type": "row",
														"when": "{{i == 0 || floor(computed.chat[i - 1].at / 86400000) != floor(m.at / 86400000)}}",
														"height": 20,
														"anchors": {
															"left": 0,
															"right": 0
														},
