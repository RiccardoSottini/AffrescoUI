																		},
																		"radius": 3,
																		"width": "{{text(floor(100 * g.achievements[0] / max(1, g.achievements[1]))) + '%'}}",
																		"gradient": {
																			"kind": "linear",
																			"angle": 90,
																			"stops": ["@color.warm", "@color.accent"]
																		}
																	}
																]
															}
														]
													},
													{
														"type": "panel",
														"color": "transparent",
														"width": 16,
														"height": 1
													}
												]
											}
										]
									},
									{
										"type": "column",
										"id": "profile-friends",
										"width": 260,
										"gap": 8,
										"alignSelf": "stretch",
										"children": [
											{
												"type": "panel",
												"color": "transparent",
												"width": 1,
												"height": 16
											},
											{
												"type": "label",
												"style": "caps",
												"height": 18,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"role": "heading",
												"text": "{{t('profile.friendsCount', { n: length(data.friends) })}}"
											},
											{
												"type": "row",
												"repeat": {
													"for": "f",
													"in": "{{slice(sort(data.friends, it.presence == 'offline' ? 1 : 0), 0, 8)}}",
													"key": "{{f.id}}"
												},
												"height": 40,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"gap": 10,
												"alignItems": "center",
												"focusable": true,
												"role": "link",
												"cursor": "hand",
												"label": "{{f.name}}",
												"hover": {
													"color": "@color.raised"
												},
												"onClick": {
													"run": "openChat",
													"with": {
														"id": "{{f.id}}"
													}
												},
												"children": [
													{
														"use": "avatar",
														"with": {
															"avatar": "{{f.avatar}}",
															"presence": "{{f.presence}}",
															"size": 30
														}
													},
													{
														"type": "label",
														"let": {
															"p": "{{f.presence}}"
														},
														"grow": 1,
														"height": 18,
														"text": "{{f.name}}",
														"textColor": "{{p == 'ingame' ? '@color.ingame' : p == 'offline' || p == 'invisible' ? '@color.offline' : '@color.online'}}"
													}
												]
											}
										]
									}
								]
							}
						]
					}
				]
			}
		}
	}
}
