{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Arcadia's friends and profile: the friends list grouped by presence with your own status, a chat per friend (its messages are records of models.json's messages, an invitation to play is a message with a game) and the profile page. Every friend and message is invented.",
	"tokens": {
		"chat.mine": {
			"dark": "#5a3f1c",
			"light": "#f8dfb6"
		},
		"chat.onMine": {
			"dark": "#ffe7c2",
			"light": "#3d2508"
		},
		"profile.bannerStart": {
			"dark": "#3b2346",
			"light": "#eadcf2"
		},
		"profile.bannerEnd": {
			"dark": "#211a28",
			"light": "#f6f2f7"
		}
	},
	"state": {
		"chatWith": "f2",
		"chatDraft": "",
		"friendQuery": "",
		"statusOpen": false,
		"typing": null,
		"replyTo": null,
		"read": {},
		"addFriend": {
			"open": false,
			"name": ""
		}
	},
	"computed": {
		"friendGroups": "{{filter([{ key: 'ingame', friends: filter(data.friends, it.presence == 'ingame' && (empty(state.friendQuery) || fuzzy(state.friendQuery, it.name) != null)) }, { key: 'online', friends: filter(data.friends, (it.presence == 'online' || it.presence == 'away') && (empty(state.friendQuery) || fuzzy(state.friendQuery, it.name) != null)) }, { key: 'offline', friends: filter(data.friends, it.presence == 'offline' && (empty(state.friendQuery) || fuzzy(state.friendQuery, it.name) != null)) }], length(it.friends) > 0)}}",
		"chatFriend": "{{find(data.friends, it.id == state.chatWith)}}",
		"chat": "{{filter(data.messages, it.friend == state.chatWith)}}",
		"inviteGame": "{{find(data.games, it.id == state.running) ?? sort(filter(computed.owned, it.installed && it.lastPlayed != null), it.lastPlayed, 'desc')[0]}}",
		"profileRecent": "{{slice(sort(filter(computed.owned, it.lastPlayed != null), it.lastPlayed, 'desc'), 0, 4)}}"
	},
	"actions": {
		"openChat": {
			"title": "Chat with a friend",
			"category": "Friends",
			"icon": "message-circle",
			"do": [
				{
					"set": "state.chatWith",
					"to": "{{id}}"
				},
				{
					"set": "state.chatDraft",
					"to": ""
				},
				{
					"set": "state.read",
					"to": "{{merge(state.read, fromEntries([{ key: id, value: now() }]))}}"
				},
				{
					"run": "go",
					"with": {
						"tab": "community",
						"page": "home",
						"id": null
					}
				},
				{
					"scrollTo": "#chat-end"
				},
				{
					"focus": "#chat-input"
				}
			]
		},
		"sendMessage": {
			"title": "Send the message",
			"category": "Friends",
			"icon": "send",
			"enablement": "{{computed.chatFriend != null && trim(state.chatDraft) != ''}}",
			"do": [
				{
					"if": "{{computed.chatFriend != null && trim(state.chatDraft) != ''}}",
					"then": [
						{
							"insert": "messages",
							"value": {
								"friend": "{{state.chatWith}}",
								"mine": true,
								"at": "{{now()}}",
								"text": "{{trim(state.chatDraft)}}"
							}
						},
						{
							"set": "state.chatDraft",
							"to": ""
						},
						{
							"after": 50,
							"do": [
								{
									"scrollTo": "#chat-end"
								}
							]
						},
						{
							"run": "awaitReply"
						}
					]
				}
			]
		},
		"awaitReply": {
			"title": "The friend answers",
			"category": "Friends",
			"description": "An online friend starts typing a moment later and answers; an offline one reads it later.",
			"do": [
				{
					"if": "{{computed.chatFriend.presence != 'offline' && state.replyTo == null}}",
					"then": [
						{
							"set": "state.replyTo",
							"to": "{{state.chatWith}}"
						},
						{
							"after": 900,
							"do": [
								{
									"set": "state.typing",
									"to": "{{state.replyTo}}"
								},
								{
									"scrollTo": "#chat-end"
								}
							]
						},
						{
							"after": 3200,
							"do": [
								{
									"insert": "messages",
									"value": {
										"friend": "{{state.replyTo}}",
										"at": "{{now()}}",
										"text": "{{t('chat.reply' + text(count(data.messages, it.mine) % 3))}}"
									}
								},
								{
									"set": "state.typing",
									"to": null
								},
								{
									"set": "state.replyTo",
									"to": null
								},
								{
									"scrollTo": "#chat-end"
								}
							]
						}
					]
				}
			]
		},
		"inviteToPlay": {
			"title": "Invite to play",
			"category": "Friends",
			"icon": "gamepad-2",
			"enablement": "{{computed.chatFriend != null && computed.inviteGame != null}}",
			"do": [
				{
					"if": "{{computed.chatFriend != null && computed.inviteGame != null}}",
					"then": [
						{
							"insert": "messages",
							"value": {
								"friend": "{{state.chatWith}}",
								"mine": true,
								"at": "{{now()}}",
								"game": "{{computed.inviteGame.id}}"
							}
						},
						{
							"after": 50,
							"do": [
								{
									"scrollTo": "#chat-end"
								}
							]
						}
					]
				}
			]
		},
		"setStatus": {
			"title": "Set your status",
			"category": "Friends",
			"do": [
				{
					"set": "state.user.status",
					"to": "{{status}}"
				}
			]
		},
		"addFriend": {
			"title": "Add a friend",
			"category": "Friends",
			"icon": "user-plus",
			"description": "Sends a friend request by name; they show as offline until they answer.",
			"do": [
				{
					"if": "{{trim(state.addFriend.name) != ''}}",
					"then": [
						{
							"insert": "friends",
							"value": {
								"name": "{{trim(state.addFriend.name)}}",
								"avatar": "ghost",
								"presence": "offline",
								"since": 0
							}
						},
						{
							"set": "state.addFriend",
							"to": {
								"open": false,
								"name": ""
							}
						}
					]
				}
			]
		},
		"addFriendDialog": {
			"title": "Add a friend",
			"category": "Friends",
			"icon": "user-plus",
			"do": [
				{
					"run": "go",
					"with": {
						"tab": "community",
						"page": "home",
						"id": null
					}
				},
				{
					"set": "state.addFriend",
					"to": {
						"open": true,
						"name": ""
					}
				}
			]
		},
		"showProfileOf": {
			"title": "Your profile",
			"category": "Friends",
			"do": [
				{
					"run": "go",
					"with": {
						"tab": "profile",
						"page": "home",
						"id": null
					}
				}
			]
		}
	},
	"components": {
		"avatar": {
			"note": "A person's avatar with a frame in their presence's colour: in a game lime, online lilac, offline grey.",
			"params": {
				"avatar": "fox",
				"presence": "online",
				"size": 36
			},
			"node": {
				"type": "panel",
				"let": {
					"p": "{{presence}}"
				},
				"width": "{{size}}",
				"height": "{{size}}",
				"radius": 4,
				"color": "{{p == 'ingame' ? '@color.ingame' : p == 'offline' || p == 'invisible' ? '@color.offline' : '@color.online'}}",
				"children": [
					{
						"type": "image",
						"file": "{{'../assets/art/avatars/' + avatar + '.svg'}}",
						"fill": 2,
						"fit": "cover"
					}
				]
			}
		},
		"friendRow": {
			"note": "A friend in the list: avatar, name in their presence's colour, what they are doing; opens the chat.",
			"params": {
				"friend": {}
			},
			"node": {
				"type": "row",
				"id": "{{'friend-' + friend.id}}",
				"let": {
					"p": "{{friend.presence}}",
					"here": "{{state.chatWith == friend.id}}"
				},
				"height": 52,
				"anchors": {
					"left": 0,
					"right": 0
				},
				"gap": 10,
				"alignItems": "center",
				"focusable": true,
				"role": "listitem",
				"cursor": "hand",
				"label": "{{friend.name}}",
				"selected": "{{here}}",
				"color": "{{here ? '@color.select' : 'transparent'}}",
				"hover": {
					"color": "@color.hover"
				},
				"onClick": {
					"run": "openChat",
					"with": {
						"id": "{{friend.id}}"
					}
				},
				"children": [
					{
						"type": "panel",
						"color": "transparent",
						"width": 14,
						"height": 1
					},
					{
						"use": "avatar",
						"with": {
							"avatar": "{{friend.avatar}}",
							"presence": "{{p}}",
							"size": 34
						}
					},
					{
						"type": "column",
						"grow": 1,
						"height": 36,
						"gap": 2,
						"alignSelf": "center",
						"children": [
							{
								"type": "label",
								"font": "strong",
								"text": "{{friend.name}}",
								"textColor": "{{p == 'ingame' ? '@color.ingame' : p == 'offline' || p == 'invisible' ? '@color.offline' : '@color.online'}}",
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": 18
							},
							{
								"type": "label",
								"font": "small",
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": 16,
								"textColor": "{{p == 'ingame' ? '@color.ingame' : '@color.muted'}}",
								"text": "{{p == 'ingame' ? find(data.games, it.id == friend.game).title ?? t('presence.ingame') : p == 'offline' && friend.since > 0 ? t('friends.lastOnline', { n: friend.since }) : t('presence.' + p)}}"
							}
						]
					},
					{
						"type": "panel",
						"when": "{{count(data.messages, it.friend == friend.id && !it.mine && it.at > (state.read[friend.id] ?? 0)) > 0 && !here}}",
						"width": 8,
						"height": 8,
						"radius": 4,
						"color": "@color.accent",
						"label": "{{t('friends.unread')}}"
					},
					{
						"type": "panel",
						"color": "transparent",
						"width": 14,
						"height": 1
					}
				]
			}
		},
		"friendsList": {
			"note": "The left column: your own card with its status menu, a search, and the friends grouped by presence.",
			"params": {},
			"node": {
				"type": "column",
				"id": "friends-side",
				"width": 300,
				"anchors": {
					"top": 0,
					"bottom": 0
				},
				"color": "@color.side",
				"children": [
					{
						"type": "row",
						"id": "me-card",
						"height": 76,
						"anchors": {
							"left": 0,
							"right": 0
						},
						"gap": 12,
						"alignItems": "center",
						"color": "@color.sideTop",
						"children": [
							{
								"type": "panel",
								"color": "transparent",
								"width": 14,
								"height": 1
							},
							{
								"use": "avatar",
								"with": {
									"avatar": "{{state.user.avatar}}",
									"presence": "{{state.user.status}}",
									"size": 46
								}
							},
							{
								"type": "column",
								"grow": 1,
								"height": 42,
								"gap": 2,
								"alignSelf": "center",
								"children": [
									{
										"type": "label",
										"font": "heading",
										"text": "{{state.user.name}}",
										"textColor": "@color.online",
										"anchors": {
											"left": 0,
											"right": 0
										},
										"height": 22
									},
									{
										"type": "label",
										"id": "my-status",
										"font": "small",
										"fitText": true,
										"padding": 2,
										"height": 18,
										"cursor": "hand",
										"focusable": true,
										"role": "button",
										"runs": [
											{
												"text": "{{t('presence.' + state.user.status) + ' '}}"
											},
											{
												"icon": "chevron-down"
											}
										],
										"textColor": "@color.muted",
										"label": "{{t('friends.status')}}",
										"hover": {
											"textColor": "@color.bright"
										},
										"isOpen": "{{state.statusOpen}}",
										"onClick": {
											"toggle": "state.statusOpen"
										},
										"children": [
											{
												"use": "menu",
												"with": {
													"open": "state.statusOpen",
													"width": 180,
													"items": "{{map(['online', 'away', 'invisible', 'offline'], { title: t('presence.' + it), checked: state.user.status == it, run: 'setStatus', with: { status: it } })}}"
												}
											}
										]
									}
								]
							},
							{
								"id": "add-friend",
								"style": "iconButton",
								"font": "heading",
								"icon": "user-plus",
								"tooltip": "{{t('friends.add')}}",
								"label": "{{t('friends.add')}}",
								"onClick": {
									"run": "addFriendDialog"
								}
							},
							{
								"type": "panel",
								"color": "transparent",
								"width": 10,
								"height": 1
							}
						]
					},
					{
						"type": "row",
						"height": 48,
						"anchors": {
							"left": 12,
							"right": 12
						},
						"alignItems": "center",
						"children": [
							{
								"type": "textarea",
								"id": "friends-search",
								"grow": 1,
								"height": 28,
								"padding": 8,
								"bind": "state.friendQuery",
								"placeholder": "{{t('friends.search')}}",
								"placeholderColor": "@color.dim",
								"textColor": "@color.text",
								"color": "@color.field",
								"radius": 3,
								"label": "{{t('friends.search')}}",
								"focused": {
									"borderWidth": 1,
									"borderColor": "@color.accent"
								},
								"children": [
									{
										"type": "label",
										"icon": "search",
										"text": "",
										"textColor": "@color.dim",
										"fitText": true,
										"anchors": {
											"right": 8,
											"top": 6
										}
									}
								]
							}
						]
					},
					{
						"type": "column",
						"id": "friends-scroll",
						"grow": 1,
						"anchors": {
							"left": 0,
							"right": 0
						},
						"scroll": "vertical",
						"role": "list",
						"label": "{{t('nav.community')}}",
						"children": [
							{
								"type": "column",
								"id": "{{'friends-group-' + group.key}}",
								"repeat": {
									"for": "group",
									"in": "{{computed.friendGroups}}",
									"key": "{{group.key}}"
								},
								"anchors": {
									"left": 0,
									"right": 0
								},
								"height": "{{34 + 52 * length(group.friends)}}",
								"children": [
									{
										"type": "label",
										"style": "caps",
										"height": 34,
										"anchors": {
											"left": 14,
											"right": 14
										},
										"align": {
											"vertical": "center"
										},
										"role": "heading",
										"text": "{{t('friends.group.' + group.key, { n: length(group.friends) })}}"
									},
									{
										"repeat": {
											"for": "f",
											"in": "{{group.friends}}",
											"key": "{{f.id}}"
										},
										"use": "friendRow",
										"with": {
											"friend": "{{f}}"
										}
									}
								]
							},
							{
								"type": "label",
								"when": "{{sum(computed.friendGroups, length(it.friends)) == 0}}",
								"height": 60,
								"anchors": {
									"left": 14,
									"right": 14
								},
								"wrap": true,
								"textColor": "@color.muted",
								"text": "{{t('friends.noMatch', { query: state.friendQuery })}}"
							}
						]
					}
				]
			}
		},
		"chatMessage": {
			"note": "One message: a bubble on the right for yours, on the left with the friend's avatar for theirs; an invitation to play is a card with the game's cover and Join.",
			"params": {
				"m": {},
				"friend": {}
			},
			"node": {
				"type": "row",
				"let": {
					"g": "{{m.game == null ? null : find(data.games, it.id == m.game)}}"
				},
				"anchors": {
					"left": 0,
					"right": 0
				},
				"gap": 8,
				"fitContent": "height",
				"justify": "{{m.mine ? 'end' : 'start'}}",
				"alignItems": "end",
				"role": "listitem",
				"label": "{{(m.mine ? state.user.name : friend.name) + ': ' + (g == null ? m.text : t('chat.invite', { game: g.title }))}}",
				"children": [
					{
						"type": "image",
						"when": "{{!m.mine}}",
						"file": "{{'../assets/art/avatars/' + friend.avatar + '.svg'}}",
						"width": 28,
						"height": 28,
						"fit": "cover",
						"radius": 14
					},
					{
						"type": "column",
						"fitContent": true,
						"gap": 3,
						"alignItems": "{{m.mine ? 'end' : 'start'}}",
						"children": [
							{
								"type": "label",
								"when": "{{g == null}}",
								"text": "{{m.text}}",
								"wrap": true,
								"fitText": {
									"maxWidth": 440
								},
								"padding": 10,
								"radius": 12,
								"selectable": true,
								"color": "{{m.mine ? '@chat.mine' : '@color.raised'}}",
								"textColor": "{{m.mine ? '@chat.onMine' : '@color.text'}}"
							},
							{
								"type": "row",
								"when": "{{g != null}}",
								"width": 320,
								"height": 96,
								"gap": 12,
								"color": "@color.panel",
								"radius": 8,
								"borderWidth": 1,
								"borderColor": "@color.border",
								"alignItems": "center",
								"children": [
									{
										"type": "panel",
										"color": "transparent",
										"width": 2,
										"height": 1
									},
									{
										"type": "image",
										"file": "{{'../assets/art/' + g.id + '/cover.svg'}}",
										"width": 48,
										"height": 72,
										"fit": "cover",
										"radius": 3
									},
									{
										"type": "column",
										"grow": 1,
										"height": 64,
										"gap": 4,
										"alignSelf": "center",
										"children": [
											{
												"type": "label",
												"style": "caps",
												"height": 16,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"text": "{{t(m.mine ? 'chat.invited' : 'chat.invites')}}"
											},
											{
												"type": "label",
												"font": "strong",
												"height": 18,
												"anchors": {
													"left": 0,
													"right": 0
												},
												"text": "{{g.title}}",
												"textColor": "@color.bright"
											},
											{
												"type": "label",
												"id": "{{'join-' + m.id}}",
												"when": "{{!m.mine}}",
												"font": "strong",
												"fitText": true,
												"padding": 6,
												"height": 26,
												"radius": 3,
												"focusable": true,
												"role": "button",
												"cursor": "hand",
												"text": "{{t(g.installed ? 'chat.join' : 'chat.install')}}",
												"gradient": {
													"kind": "linear",
													"angle": 90,
													"stops": [
														"{{g.installed ? '@color.play' : '@color.warm'}}",
														"{{g.installed ? '@color.playEnd' : '@color.warmEnd'}}"
													]
												},
												"textColor": "#ffffff",
												"onClick": {
													"run": "primary",
													"with": {
														"game": "{{g}}"
													}
												}
											}
										]
									}
								]
							},
							{
								"type": "label",
								"font": "small",
								"fitText": true,
								"textColor": "@color.dim",
								"text": "{{now() - m.at < 60000 ? t('chat.now') : formatTime(m.at, 'short', 'utc')}}"
							}
						]
					}
				]
			}
