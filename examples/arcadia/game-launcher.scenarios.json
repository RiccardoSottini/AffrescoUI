{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "game-launcher.screen.json",
	"scenarios": [
		{ "name": "library", "steps": [
			{ "expect": { "node": "#details-title", "text": "Starfall Odyssey" } },
			{ "click": { "role": "button", "name": "Neon Drift" } },
			{ "expect": { "state": "selected", "is": "neon" } },
			{ "expect": { "node": "#details-title", "text": "Neon Drift" } },
			{ "capture": "covers" }
		] },
		{ "name": "filter", "steps": [
			{ "click": "#search" },
			{ "type": "iron" },
			{ "expect": { "node": "#game-card", "property": "name", "is": "Iron Hollow" } },
			{ "expect": { "node": "#game-card", "nth": 1, "exists": false } },
			{ "key": "escape" },
			{ "expect": { "state": "query", "is": "" } },
			{ "action": "showLibrary" },
			{ "revision": { "type": "revision", "message": "Show favourites", "set": { "/state/filter": "favourites" } } },
			{ "expect": { "node": "#game-card", "nth": 2, "property": "name", "is": "Tidebreaker" } }
		] },
		{ "name": "table", "steps": [
			{ "action": "tableView" },
			{ "action": "showLibrary" },
			{ "expect": { "node": "#games-table", "property": "shown", "is": true } },
			{ "capture": "table" }
		] },
		{ "name": "play", "steps": [
			{ "click": "#play-button" },
			{ "expect": { "state": "games[0].hours", "is": 87 } },
			{ "expect": { "state": "toast.open", "is": true } },
			{ "wait": 600 },
			{ "capture": "toast" },
			{ "wait": 3000 },
			{ "expect": { "state": "toast.open", "is": false } }
		] },
		{ "name": "uninstall", "steps": [
			{ "click": "#uninstall-button" },
			{ "expect": { "state": "confirm", "is": true } },
			{ "capture": "dialog" },
			{ "click": { "role": "button", "name": "Remove" } },
			{ "expect": { "state": "games[0].installed", "is": false } },
			{ "expect": { "node": "#install-button", "property": "shown", "is": true } }
		] },
		{ "name": "context-menu", "steps": [
			{ "click": { "role": "button", "name": "Iron Hollow" } },
			{ "action": "openContextMenu", "event": { "x": 470, "y": 220 } },
			{ "expect": { "state": "ctxOpen", "is": true } },
			{ "expect": { "state": "selected", "is": "ironhollow" } },
			{ "wait": 0 },
			{ "capture": "menu" }
		] },
		{ "name": "quick-pick", "steps": [
			{ "key": "mod+p" },
			{ "wait": 50 },
			{ "expect": { "state": "quickPick.open", "is": true } },
			{ "type": "tide" },
			{ "wait": 0 },
			{ "capture": "games" },
			{ "key": "enter" },
			{ "expect": { "state": "selected", "is": "tidebreaker" } },
			{ "key": "mod+shift+p" },
			{ "wait": 50 },
			{ "type": "stats" },
			{ "wait": 0 },
			{ "capture": "commands" },
			{ "key": "enter" },
			{ "expect": { "state": "view", "is": "stats" } }
		] },
		{ "name": "stats", "steps": [
			{ "key": "mod+2" },
			{ "expect": { "state": "view", "is": "stats" } },
			{ "capture": "charts" }
		] },
		{ "name": "settings", "steps": [
			{ "key": "mod+3" },
			{ "capture": "page" },
			{ "action": "toggleTheme" },
			{ "expect": { "state": "settings['appearance.theme']", "is": "light" } },
			{ "action": "showLibrary" },
			{ "wait": 200 },
			{ "capture": "light" }
		] },
		{ "name": "sort", "note": "The sort chips and the Mod+K Mod+S chord change the order, and the setting follows.", "steps": [
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Ember Knights" } },
			{ "click": "#sort-chip-playtime" },
			{ "expect": { "state": "settings['library.sortBy']", "is": "playtime" } },
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Iron Hollow" } },
			{ "expect": { "node": "#game-card", "nth": 1, "property": "name", "is": "Starfall Odyssey" } },
			{ "expect": { "node": "#game-card", "nth": 7, "property": "name", "is": "Skyward Isles" } },
			{ "click": "#sort-chip-recent" },
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Starfall Odyssey" } },
			{ "expect": { "node": "#game-card", "nth": 1, "property": "name", "is": "Neon Drift" } },
			{ "expect": { "node": "#game-card", "nth": 2, "property": "name", "is": "Ember Knights" } },
			{ "key": "mod+k" },
			{ "key": "mod+s" },
			{ "expect": { "state": "settings['library.sortBy']", "is": "playtime" } },
			{ "key": "mod+k" },
			{ "key": "mod+s" },
			{ "expect": { "state": "settings['library.sortBy']", "is": "name" } },
			{ "expect": { "node": "#sort-chip-name", "property": "color", "is": "#2a2452" } }
		] },
		{ "name": "collections", "note": "The installed, favourites and genre collections filter the grid.", "steps": [
			{ "expect": { "node": "#library-count", "text": "8 games" } },
			{ "click": [60, 146], "note": "Installed, in the collections tree" },
			{ "expect": { "state": "filter", "is": "installed" } },
			{ "expect": { "node": "#library-count", "text": "6 games" } },
			{ "expect": { "node": "#game-card", "nth": 6, "exists": false } },
			{ "click": [60, 176], "note": "Favourites" },
			{ "expect": { "node": "#library-count", "text": "3 games" } },
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Iron Hollow" } },
			{ "click": [60, 326], "note": "RPG, under Genres" },
			{ "expect": { "state": "filter", "is": "RPG" } },
			{ "expect": { "node": "#library-count", "text": "2 games" } },
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Skyward Isles" } },
			{ "expect": { "node": "#game-card", "nth": 1, "property": "name", "is": "Starfall Odyssey" } }
		] },
		{ "name": "show-uninstalled", "note": "Turning off games that aren't installed hides Skyward Isles from the RPG collection.", "steps": [
			{ "click": [60, 326], "note": "RPG, under Genres" },
			{ "expect": { "node": "#library-count", "text": "2 games" } },
			{ "key": "mod+3" },
			{ "click": "#show-uninstalled-checkbox" },
			{ "expect": { "state": "settings['library.showUninstalled']", "is": false } },
			{ "key": "mod+1" },
			{ "expect": { "node": "#library-count", "text": "1 game" } },
			{ "expect": { "node": "#game-card", "nth": 0, "property": "name", "is": "Starfall Odyssey" } },
			{ "expect": { "node": "#game-card", "nth": 1, "exists": false } }
		] },
		{ "name": "grid-keyboard", "note": "Arrow keys move through the cover grid in two dimensions, Home and End jump, Enter opens the game.", "steps": [
			{ "click": { "role": "button", "name": "Ember Knights" } },
			{ "wait": 0 },
			{ "expect": { "node": "#cover-grid", "property": "focused", "is": true } },
			{ "key": "down" },
			{ "expect": { "state": "selected", "is": "neon" } },
			{ "key": "right" },
			{ "expect": { "state": "selected", "is": "quietorbit" } },
			{ "key": "up" },
			{ "expect": { "state": "selected", "is": "ironhollow" } },
			{ "key": "left" },
			{ "expect": { "state": "selected", "is": "ember" } },
			{ "key": "up" },
			{ "expect": { "state": "selected", "is": "ember" } },
			{ "key": "end" },
			{ "expect": { "state": "selected", "is": "tidebreaker" } },
			{ "key": "down" },
			{ "expect": { "state": "selected", "is": "tidebreaker" } },
			{ "key": "home" },
			{ "expect": { "state": "selected", "is": "ember" } },
			{ "key": "enter" },
			{ "wait": 0 },
			{ "expect": { "state": "view", "is": "game" } },
			{ "expect": { "node": "#game-page-title", "text": "Ember Knights" } }
		] },
		{ "name": "game-page", "note": "The screenshot carousel by keyboard, then Escape goes back to the grid with the focus.", "steps": [
			{ "click": { "role": "button", "name": "Starfall Odyssey" } },
			{ "wait": 0 },
			{ "key": "enter" },
			{ "wait": 0 },
			{ "expect": { "node": "#shots", "property": "focused", "is": true } },
			{ "expect": { "state": "shot", "is": 0 } },
			{ "expect": { "node": "#shot-caption", "text": "Cover art  ·  1 of 4" } },
			{ "key": "right" },
			{ "expect": { "state": "shot", "is": 1 } },
			{ "expect": { "node": "#shot-caption", "text": "The world  ·  2 of 4" } },
			{ "key": "right" },
			{ "key": "right" },
			{ "expect": { "state": "shot", "is": 3 } },
			{ "wait": 400 },
			{ "capture": "carousel" },
			{ "key": "left" },
			{ "expect": { "state": "shot", "is": 2 } },
			{ "key": "escape" },
			{ "wait": 0 },
			{ "expect": { "state": "view", "is": "library" } },
			{ "expect": { "node": "#cover-grid", "property": "focused", "is": true } }
		] },
		{ "name": "achievements-news", "note": "Achievements and news follow the game; a game without news says so.", "steps": [
			{ "action": "openGame" },
			{ "expect": { "node": "#achievements-count", "text": "4 of 6 unlocked" } },
			{ "expect": { "node": "#news-item", "nth": 2, "exists": true } },
			{ "expect": { "node": "#news-none", "exists": false } },
			{ "expect": { "node": "#achievement", "nth": 5, "property": "role", "is": "listitem" } },
			{ "action": "back" },
			{ "wait": 0 },
			{ "click": { "role": "button", "name": "Mossheart" } },
			{ "action": "openGame" },
			{ "expect": { "node": "#achievements-count", "text": "1 of 6 unlocked" } },
			{ "expect": { "node": "#news-none", "property": "shown", "is": true } },
			{ "expect": { "node": "#game-install-button", "property": "shown", "is": true } }
		] },
		{ "name": "friends-presence", "note": "Friends sorted by presence; offline friends only when asked for.", "steps": [
			{ "key": "mod+4" },
			{ "expect": { "state": "view", "is": "friends" } },
			{ "expect": { "node": "#friends-online", "text": "7 online" } },
			{ "expect": { "node": "#friend-empty", "property": "shown", "is": true } },
			{ "click": "#friends-list" },
			{ "key": "home" },
			{ "expect": { "state": "friend", "is": "f9" } },
			{ "expect": { "node": "#friend-presence", "text": "Playing Starfall Odyssey" } },
			{ "key": "end" },
			{ "expect": { "state": "friend", "is": "f3" } },
			{ "expect": { "node": "#friend-presence", "text": "Away" } },
			{ "click": "#show-offline" },
			{ "expect": { "state": "showOffline", "is": true } },
			{ "click": "#friends-list" },
			{ "key": "end" },
			{ "expect": { "state": "friend", "is": "f5" } },
			{ "expect": { "node": "#friend-presence", "text": "Offline" } },
			{ "expect": { "node": "#friend-join-button", "exists": false } },
			{ "expect": { "node": "#friend-invite-button", "exists": false } },
			{ "wait": 200 },
			{ "capture": "list" }
		] },
		{ "name": "friends-actions", "note": "Join a friend in a game, invite one online, and send a message capped at 80 characters.", "steps": [
			{ "key": "mod+4" },
			{ "click": "#friends-list" },
			{ "key": "home" },
			{ "expect": { "state": "friend", "is": "f9" } },
			{ "click": "#friend-join-button" },
			{ "expect": { "state": "toast.open", "is": true } },
			{ "expect": { "state": "toast.message", "is": "Joining IronMole in Starfall Odyssey…" } },
			{ "wait": 3000 },
			{ "click": "#friends-list" },
			{ "key": "home" },
			{ "key": "down" },
			{ "key": "down" },
			{ "key": "down" },
			{ "expect": { "state": "friend", "is": "f2" } },
			{ "expect": { "node": "#friend-invite-button", "property": "shown", "is": true } },
			{ "click": "#friend-send-button" },
			{ "expect": { "state": "toast.open", "is": false } },
			{ "click": "#friend-message" },
			{ "type": "See you tonight? See you tonight? See you tonight? See you tonight? See you tonight? See you tonight? " },
			{ "expect": { "state": "message.length", "is": 80 } },
			{ "expect": { "node": "#friend-message-count", "text": "80 / 80" } },
			{ "key": "enter" },
			{ "expect": { "state": "message", "is": "" } },
			{ "expect": { "state": "toast.message", "is": "NightDrifter will see your message" } },
			{ "click": "#friend-invite-button" },
			{ "expect": { "state": "toast.message", "is": "NightDrifter was invited to play" } }
		] },
		{ "name": "downloads-progress", "note": "Installing queues a download that advances with time.", "steps": [
			{ "click": { "role": "button", "name": "Mossheart" } },
			{ "click": "#install-button" },
			{ "expect": { "state": "downloads.length", "is": 2 } },
			{ "expect": { "state": "downloads[1].status", "is": "downloading" } },
			{ "expect": { "state": "downloads[1].done", "is": 0 } },
			{ "wait": 1000 },
			{ "expect": { "state": "downloads[1].done", "is": 0.4 } },
			{ "key": "mod+5" },
			{ "expect": { "node": "#download-status", "nth": 1, "text": "Downloading" } },
			{ "expect": { "node": "#download-status", "nth": 0, "text": "Paused" } },
			{ "wait": 1000 },
			{ "expect": { "node": "#download-size", "nth": 1, "text": "0.8 of 4.3 GB" } },
			{ "capture": "queue" }
		] },
		{ "name": "downloads-pause", "note": "Pause and resume all, with Mod+Shift+D and with the buttons: a paused download doesn't move.", "steps": [
			{ "click": { "role": "button", "name": "Mossheart" } },
			{ "click": "#install-button" },
			{ "wait": 500 },
			{ "key": "mod+shift+d" },
			{ "expect": { "state": "downloads[1].status", "is": "paused" } },
			{ "expect": { "state": "downloads[1].done", "is": 0.2 } },
			{ "wait": 1000 },
			{ "expect": { "state": "downloads[1].done", "is": 0.2 } },
			{ "key": "mod+shift+d" },
			{ "expect": { "state": "downloads[0].status", "is": "downloading" } },
			{ "expect": { "state": "downloads[1].status", "is": "queued" } },
			{ "key": "mod+5" },
			{ "click": "#downloads-pause-all" },
			{ "expect": { "state": "downloads[0].status", "is": "paused" } },
			{ "click": "#downloads-resume-all" },
			{ "expect": { "state": "downloads[0].status", "is": "downloading" } }
		] },
		{ "name": "downloads-queue", "note": "Reorder, pause one, cancel one, and a finished download installs the game.", "steps": [
			{ "key": "mod+3" },
			{ "click": "#speed-slider" },
			{ "key": "end" },
			{ "expect": { "state": "settings['downloads.speed']", "is": 1000 } },
			{ "key": "mod+1" },
			{ "click": { "role": "button", "name": "Mossheart" } },
			{ "click": "#install-button" },
			{ "key": "mod+5" },
			{ "click": "#download-up" },
			{ "expect": { "state": "downloads[0].id", "is": "mossheart" } },
			{ "click": "#download-toggle", "nth": 0 },
			{ "expect": { "state": "downloads[0].status", "is": "paused" } },
			{ "click": "#download-toggle", "nth": 1 },
			{ "expect": { "state": "downloads[1].status", "is": "downloading" } },
			{ "click": "#download-toggle", "nth": 1 },
			{ "click": "#download-toggle", "nth": 0 },
			{ "expect": { "state": "downloads[0].status", "is": "downloading" } },
			{ "click": "#download-cancel", "nth": 1 },
			{ "expect": { "state": "downloads.length", "is": 1 } },
			{ "wait": 4600 },
			{ "expect": { "state": "downloads.length", "is": 0 } },
			{ "expect": { "state": "games[4].installed", "is": true } },
			{ "expect": { "state": "toast.message", "is": "Mossheart is installed and ready to play" } },
			{ "expect": { "node": "#downloads-empty", "property": "shown", "is": true } }
		] },
		{ "name": "theme-dark", "note": "The dark theme by default, chosen in the settings.", "steps": [
			{ "expect": { "node": "#palette-button", "property": "color", "is": "#222633" } },
			{ "key": "mod+3" },
			{ "expect": { "node": "#theme-dark", "property": "color", "is": "#2a2452" } },
			{ "click": "#theme-light" },
			{ "click": "#theme-dark" },
			{ "expect": { "state": "settings['appearance.theme']", "is": "dark" } },
			{ "wait": 200 },
			{ "expect": { "node": "#palette-button", "property": "color", "is": "#222633" } },
			{ "capture": "settings" }
		] },
		{ "name": "theme-light", "note": "Bug: buttons with a colour transition kept their dark colour after the theme changed.", "steps": [
			{ "key": "mod+3" },
			{ "click": "#theme-light" },
			{ "expect": { "state": "settings['appearance.theme']", "is": "light" } },
			{ "wait": 300 },
			{ "expect": { "node": "#palette-button", "property": "color", "is": "#eceef3" } },
			{ "expect": { "node": "#view-menu-button", "property": "color", "is": "#eceef3" } },
			{ "expect": { "node": "#reset-settings-button", "property": "color", "is": "#eceef3" } },
			{ "key": "mod+5" },
			{ "wait": 200 },
			{ "capture": "downloads" }
		] },
		{ "name": "locale-it", "note": "Italian from the settings: every visible text changes.", "steps": [
			{ "key": "mod+3" },
			{ "click": "#language-it" },
			{ "expect": { "state": "settings['appearance.language']", "is": "it" } },
			{ "expect": { "node": "#view-tabs", "property": "name", "is": "Viste" } },
			{ "key": "mod+1" },
			{ "expect": { "node": "#library-count", "text": "8 giochi" } },
			{ "expect": { "node": "#view-tabs", "property": "role", "is": "tablist" } },
			{ "expect": { "node": "#search", "property": "name", "is": "Filtra la libreria" } },
			{ "click": "#sort-chip-playtime" },
			{ "expect": { "node": "#sort-chip-playtime", "text": "Ore" } },
			{ "action": "openGame" },
			{ "expect": { "node": "#shot-caption", "text": "Copertina  ·  1 di 4" } },
			{ "wait": 200 },
			{ "capture": "game" }
		] },
		{ "name": "locale-ar", "note": "Arabic, right to left: the layout and the arrow keys mirror; the split's sashes don't show (they aren't mirrored).", "steps": [
			{ "key": "mod+k" },
			{ "key": "mod+l" },
			{ "key": "mod+k" },
			{ "key": "mod+l" },
			{ "expect": { "state": "settings['appearance.language']", "is": "ar" } },
			{ "expect": { "node": "#library-count", "text": "8 ألعاب" } },
			{ "click": { "role": "button", "name": "Iron Hollow" } },
			{ "wait": 0 },
			{ "key": "right" },
			{ "expect": { "state": "selected", "is": "ember" } },
			{ "key": "left" },
			{ "key": "left" },
			{ "expect": { "state": "selected", "is": "mossheart" } },
			{ "key": "enter" },
			{ "wait": 0 },
			{ "key": "left" },
			{ "expect": { "state": "shot", "is": 1 } },
			{ "expect": { "node": "#shot-caption", "text": "العالم  ·  2 من 4" } },
			{ "key": "escape" },
			{ "wait": 200 },
			{ "capture": "library" }
		] },
		{ "name": "keyboard-only", "note": "Search, pick, open, favourite and play without the pointer.", "steps": [
			{ "key": "mod+f" },
			{ "wait": 0 },
			{ "expect": { "node": "#search", "property": "focused", "is": true } },
			{ "type": "orbit" },
			{ "expect": { "node": "#library-count", "text": "1 game  matching “orbit”" } },
			{ "key": "down" },
			{ "wait": 0 },
			{ "expect": { "node": "#cover-grid", "property": "focused", "is": true } },
			{ "expect": { "state": "selected", "is": "quietorbit" } },
			{ "key": "mod+d" },
			{ "expect": { "state": "games[7].favourite", "is": true } },
			{ "key": "enter" },
			{ "wait": 0 },
			{ "expect": { "state": "view", "is": "game" } },
			{ "key": "mod+enter" },
			{ "expect": { "state": "games[7].hours", "is": 19.5 } },
			{ "key": "alt+left" },
			{ "wait": 0 },
			{ "expect": { "state": "view", "is": "library" } },
			{ "key": "mod+f" },
			{ "wait": 0 },
			{ "key": "escape" },
			{ "expect": { "state": "query", "is": "" } },
			{ "key": "mod+5" },
			{ "expect": { "state": "view", "is": "downloads" } }
		] },
		{ "name": "dialog-escape", "note": "Escape closes the uninstall dialog and keeps the game.", "steps": [
			{ "click": "#uninstall-button" },
			{ "expect": { "state": "confirm", "is": true } },
			{ "key": "escape" },
			{ "expect": { "state": "confirm", "is": false } },
			{ "expect": { "state": "games[0].installed", "is": true } }
		] },
		{ "name": "commands", "note": "The command palette and the Mod+K chords.", "steps": [
			{ "key": "mod+k" },
			{ "key": "mod+t" },
			{ "expect": { "state": "settings['appearance.theme']", "is": "light" } },
			{ "key": "mod+k" },
			{ "key": "mod+l" },
			{ "expect": { "state": "settings['appearance.language']", "is": "it" } },
			{ "key": "mod+shift+p" },
			{ "wait": 50 },
			{ "type": "download" },
			{ "wait": 0 },
			{ "key": "enter" },
			{ "expect": { "state": "view", "is": "downloads" } },
			{ "key": "mod+shift+p" },
			{ "wait": 50 },
			{ "type": "chiaro" },
			{ "wait": 0 },
			{ "key": "enter" },
			{ "expect": { "state": "settings['appearance.theme']", "is": "dark" } }
		] },
		{ "name": "layout-min", "note": "The smallest window (asked for 480 x 640, held at 960 x 600): every view fits.", "steps": [
			{ "resize": [480, 640] },
			{ "wait": 50 },
			{ "expect": { "node": "#top-bar-end", "property": "x", "is": 956 } },
			{ "expect": { "node": "#search", "property": "width", "is": 160 } },
			{ "capture": "library" },
			{ "action": "openGame" },
			{ "wait": 50 },
			{ "capture": "game" },
			{ "key": "mod+4" },
			{ "wait": 50 },
			{ "capture": "friends" },
			{ "key": "mod+5" },
			{ "wait": 50 },
			{ "capture": "downloads" },
			{ "key": "mod+3" },
			{ "wait": 50 },
			{ "expect": { "node": "#reset-settings-button", "property": "shown", "is": true } },
			{ "capture": "settings" }
		] },
		{ "name": "layout-max", "note": "Full HD: the grid, not the details, takes the extra width (bug: the details pane used to).", "steps": [
			{ "resize": [1920, 1080] },
			{ "wait": 50 },
			{ "expect": { "node": "#top-bar-end", "property": "x", "is": 1916 } },
			{ "expect": { "node": "#search", "property": "width", "is": 240 } },
			{ "expect": { "node": "#library-main", "property": "width", "is": 1280 } },
			{ "expect": { "node": "#palette-button", "text": "Commands" } },
			{ "click": { "role": "button", "name": "Ember Knights" } },
			{ "wait": 0 },
			{ "key": "down" },
			{ "expect": { "state": "selected", "is": "tidebreaker" } },
			{ "capture": "library" }
		] },
		{ "name": "settings-controls", "note": "Without the confirmation an uninstall is immediate; reset brings every setting back.", "steps": [
			{ "key": "mod+3" },
			{ "click": "#confirm-uninstall-checkbox" },
			{ "expect": { "state": "settings['launcher.confirmUninstall']", "is": false } },
			{ "click": "#setting-sort-playtime" },
			{ "click": "#cover-size-slider" },
			{ "key": "end" },
			{ "expect": { "state": "settings['library.coverSize']", "is": 220 } },
			{ "key": "mod+1" },
			{ "click": "#uninstall-button" },
			{ "expect": { "state": "confirm", "is": false } },
			{ "expect": { "state": "games[0].installed", "is": false } },
			{ "key": "mod+3" },
			{ "click": "#reset-settings-button" },
			{ "expect": { "node": "#confirm-uninstall-checkbox", "property": "checked", "is": true } },
			{ "expect": { "node": "#setting-sort-name", "property": "color", "is": "#2a2452" } }
		] },
		{ "name": "pick-then-palette", "note": "Bug: picking a game focused the carousel a frame late and stole the next palette's input.", "steps": [
			{ "key": "mod+p" },
			{ "wait": 50 },
			{ "type": "neon" },
			{ "wait": 0 },
			{ "key": "enter" },
			{ "expect": { "state": "view", "is": "game" } },
			{ "key": "mod+shift+p" },
			{ "wait": 50 },
			{ "type": "downloads" },
			{ "wait": 0 },
			{ "expect": { "state": "quickPick.open", "is": true } },
			{ "key": "enter" },
			{ "wait": 0 },
			{ "expect": { "state": "view", "is": "downloads" } }
		] },
		{ "name": "chips", "note": "Bug: rows of chips had no width, so the sort and settings chips didn't show; then the settings chips didn't line up at the end with the other controls.", "steps": [
			{ "expect": { "node": "#sort-chip-playtime", "property": "shown", "is": true } },
			{ "expect": { "node": "#sort-chip-name", "property": "width", "is": 49 } },
			{ "key": "mod+3" },
			{ "expect": { "node": "#language-ar", "property": "shown", "is": true } },
			{ "expect": { "node": "#theme-light", "property": "height", "is": 34 } },
			{ "expect": { "node": "#theme-light", "property": "x", "is": 1191 }, "note": "Ends at 1248, the right edge of the sliders" },
			{ "expect": { "node": "#language-ar", "property": "x", "is": 1192 } }
		] },
		{ "name": "narrow-top-bar", "note": "Bug: at 960 the top bar ran off the window, hiding the More menu.", "steps": [
			{ "resize": [960, 600] },
			{ "wait": 50 },
			{ "expect": { "node": "#search", "property": "width", "is": 160 } },
			{ "expect": { "node": "#palette-button", "property": "width", "is": 32 } },
			{ "expect": { "node": "#top-bar-end", "property": "x", "is": 956 } },
			{ "click": "#view-menu-button" },
			{ "expect": { "state": "viewMenu", "is": true } },
			{ "resize": [1280, 800] },
			{ "wait": 50 },
			{ "expect": { "node": "#search", "property": "width", "is": 240 } }
		] }
	]
