{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "calamaio.screen.json",
	"scenarios": [
		{
			"name": "frame",
			"note": "The start screen, then the scratch buffer, two windows and the minibuffer.",
			"steps": [
				{ "capture": "splash" },
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.open", "is": true } },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "b1" } },
				{ "key": "ctrl+x" },
				{ "key": "2" },
				{ "wait": 50 },
				{ "expect": { "state": "layout.groups.length", "is": 2 } },
				{ "key": "ctrl+x" },
				{ "key": "o" },
				{ "wait": 50 },
				{ "expect": { "state": "sel", "is": "w2" } },
				{ "type": "(+ 1 2)" },
				{ "capture": "split" },
				{ "key": "ctrl+x" },
				{ "key": "3" },
				{ "wait": 50 },
				{ "capture": "three" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "expect": { "state": "layout.groups.length", "is": 1 } },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "type": "forward" },
				{ "capture": "mx" },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.open", "is": false } },
				{ "capture": "quit" }
			]
		},
		{
			"name": "minibuffer",
			"note": "Completion, history, a prefix argument and the help commands.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scr" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "*scratch*" } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "type": "desc" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-" } },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.comp.length", "is": 5 } },
				{ "capture": "completions" },
				{ "type": "f" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-function" } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "type": "forward-c" },
				{ "key": "tab" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "expect": { "state": "bufs.bh.name", "is": "*Help*" } },
				{ "capture": "help-function" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "ctrl+h" },
				{ "key": "k" },
				{ "wait": 50 },
				{ "expect": { "state": "keyread.on", "is": true } },
				{ "key": "ctrl+x" },
				{ "wait": 50 },
				{ "capture": "describe-key-prefix" },
				{ "key": "ctrl+f" },
				{ "wait": 120 },
				{ "expect": { "state": "keyread.on", "is": false } },
				{ "capture": "describe-key" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "ctrl+h" },
				{ "key": "v" },
				{ "wait": 50 },
				{ "type": "fill" },
				{ "key": "tab" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "capture": "describe-variable" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "key": "alt+p" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-function" } },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+a" },
				{ "key": "ctrl+u" },
				{ "key": "ctrl+u" },
				{ "wait": 50 },
				{ "expect": { "state": "arg", "is": 16 } },
				{ "capture": "universal-argument" },
				{ "key": "ctrl+f" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.column", "is": 17 } }
			]
		},
		{
			"name": "search",
			"note": "Incremental search forward, repeat, stop and quit; a query replace answered y then n.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+shift+comma" },
				{ "wait": 50 },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": true } },
				{ "type": "buf" },
				{ "wait": 50 },
				{ "wait": 50 },
				{ "expect": { "state": "is.text", "is": "buf" } },
				{ "expect": { "state": "win.w1.caret.matches", "is": 2 } },
				{ "capture": "isearch" },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.line", "is": 2 } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": false } },
				{ "key": "ctrl+s" },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "is.text", "is": "buf" } },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": false } },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+a" },
				{ "key": "alt+shift+5" },
				{ "wait": 50 },
				{ "type": "buffer" },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "type": "BUFFER" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "expect": { "state": "qr.on", "is": true } },
				{ "capture": "query-replace" },
				{ "key": "y" },
				{ "wait": 80 },
				{ "key": "n" },
				{ "wait": 120 },
				{ "expect": { "state": "qr.on", "is": false } },
				{ "capture": "replaced" }
			]
		}
	]
}
