{
	"note": "Calamaio's state: the buffers (by id, the most recent first in order), the windows and how they are laid out (groups of windows across dir), the minibuffer, the echo area, the mark and the kill ring, and the modes.",
	"state": {
		"theme": "default",
		"menuBar": {},
		"sel": "w1",
		"nextWin": 2,
		"nextBuf": 3,
		"layout": { "dir": "column", "groups": [["w1"]] },
		"win": { "w1": { "buf": "b0", "caret": { "line": 1, "column": 1, "selected": 0 }, "view": {} } },
		"order": ["b0", "b1", "b2"],
		"bufs": {
			"b0": { "name": "*Calamaio*", "mode": "fundamental", "kind": "splash", "text": "", "readOnly": true },
			"b1": {
				"name": "*scratch*",
				"mode": "lisp-interaction",
				"pt": { "line": 4, "column": 1 },
				"text": ";; This buffer is for notes you won't keep and for Lisp you want to try out.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n"
			},
			"b2": {
				"name": "*Messages*",
				"mode": "messages",
				"readOnly": true,
				"text": "Welcome to Calamaio.  Type C-h t for the tutorial.\n"
			}
		},
		"echo": "Welcome to Calamaio.  Type C-h t for the tutorial.",
		"mb": {
			"open": false,
			"prompt": "",
			"text": "",
			"kind": "",
			"def": "",
			"hist": {},
			"hi": -1,
			"comp": null,
			"note": ""
		},
		"arg": null,
		"mark": { "on": false, "line": 1, "column": 1 },
		"kills": [],
		"splashAtStart": true,
		"modes": {
			"fundamental": { "title": "Fundamental" },
			"text": { "title": "Text", "menu": "text" },
			"lisp-interaction": {
				"title": "Lisp Interaction",
				"menu": "lisp",
				"patterns": [
					{ "match": ";.*", "style": "comment" },
					{ "match": "\"(?:[^\"\\\\]|\\\\.)*\"?", "style": "string" },
					{
						"match": "(?<=\\()(?:defun|defmacro|defvar|defcustom|defconst|defgroup|let\\*?|if|when|unless|cond|while|dolist|dotimes|progn|lambda|setq|and|or|require|provide|interactive|save-excursion|condition-case)(?=[\\s()])",
						"style": "keyword"
					},
					{ "match": "(?<=\\(defun )[^\\s()]+|(?<=\\(defmacro )[^\\s()]+", "style": "function" },
					{
						"match": "(?<=\\(defvar )[^\\s()]+|(?<=\\(defcustom )[^\\s()]+|(?<=\\(defconst )[^\\s()]+",
						"style": "label"
					},
					{ "match": "(?<![\\w-]):[\\w-]+", "style": "function.builtin" }
				]
			},
			"emacs-lisp": {
				"title": "ELisp/l",
				"menu": "lisp",
				"patterns": [
					{ "match": ";.*", "style": "comment" },
					{ "match": "\"(?:[^\"\\\\]|\\\\.)*\"?", "style": "string" },
					{
						"match": "(?<=\\()(?:defun|defmacro|defvar|defcustom|defconst|defgroup|let\\*?|if|when|unless|cond|while|dolist|dotimes|progn|lambda|setq|and|or|require|provide|interactive|save-excursion|condition-case)(?=[\\s()])",
						"style": "keyword"
					},
					{ "match": "(?<=\\(defun )[^\\s()]+|(?<=\\(defmacro )[^\\s()]+", "style": "function" },
					{
						"match": "(?<=\\(defvar )[^\\s()]+|(?<=\\(defcustom )[^\\s()]+|(?<=\\(defconst )[^\\s()]+",
						"style": "label"
					},
					{ "match": "(?<![\\w-]):[\\w-]+", "style": "function.builtin" }
				]
			},
			"python": { "title": "Python", "menu": "python", "grammar": "python" },
			"c": { "title": "C/*l", "menu": "c", "grammar": "c" },
			"markdown": { "title": "Markdown", "menu": "outline", "grammar": "markdown" },
			"org": {
				"title": "Org",
				"menu": "outline",
				"patterns": [
					{ "match": "^#\\+\\w+:.*", "style": "comment" },
					{ "match": "^\\* .*", "style": "text.title" },
					{ "match": "^\\*\\* .*", "style": "label" },
					{ "match": "^\\*{3,} .*", "style": "keyword" },
					{ "match": "\\[\\[[^\\]]*\\](?:\\[[^\\]]*\\])?\\]", "style": "text.uri" },
					{ "match": "\\b(?:TODO|NEXT)\\b", "style": "string" },
					{ "match": "\\bDONE\\b", "style": "type" }
				]
			},
			"messages": { "title": "Messages" },
			"help": { "title": "Help" },
			"dired": { "title": "Dired by name", "menu": "dired" },
			"buffer-menu": { "title": "Buffer Menu", "menu": "bufferMenu" }
		},
		"modeFor": { "py": "python", "c": "c", "h": "c", "el": "emacs-lisp", "md": "markdown", "org": "org", "txt": "text" },
		"keyread": { "on": false, "seq": "" },
		"argDigits": false,
		"argU": 0,
		"is": {
			"on": false,
			"text": "",
			"back": false,
			"step": "first",
			"req": 0,
			"start": { "line": 1, "column": 1 },
			"last": null
		},
		"qr": { "on": false, "from": null, "to": "", "step": "first", "req": 0, "replace": "", "done": 0 }
	}
}
