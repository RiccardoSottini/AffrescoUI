{
	"note": "Calamaio's keys, written as the editor it follows binds them: C- is ctrl, M- is alt. The echo area shows them in that notation (window.keyLabels).",
	"keys": {
		"ctrl+f": "forward-char",
		"ctrl+b": "backward-char",
		"ctrl+n": "next-line",
		"ctrl+p": "previous-line",
		"alt+f": "forward-word",
		"alt+b": "backward-word",
		"ctrl+a": "move-beginning-of-line",
		"ctrl+e": "move-end-of-line",
		"alt+shift+comma": "beginning-of-buffer",
		"alt+shift+period": "end-of-buffer",
		"ctrl+v": "scroll-up-command",
		"alt+v": "scroll-down-command",
		"ctrl+d": "delete-char",
		"ctrl+slash": "undo",
		"ctrl+shift+minus": "undo",
		"ctrl+alt+slash": "undo-redo",
		"ctrl+space": "set-mark-command",
		"ctrl+g": "keyboard-quit",
		"alt+x": "execute-extended-command",
		"ctrl+x 2": "split-window-below",
		"ctrl+x 3": "split-window-right",
		"ctrl+x 0": "delete-window",
		"ctrl+x 1": "delete-other-windows",
		"ctrl+x o": "other-window",
		"ctrl+x b": "switch-to-buffer",
		"ctrl+x k": "kill-buffer",
		"ctrl+x ctrl+f": "find-file",
		"ctrl+x ctrl+s": "save-buffer",
		"ctrl+x ctrl+c": "save-buffers-kill-terminal",
		"ctrl+z": "suspend-frame",
		"f10": "menu-bar-open",
		"ctrl+u": "universal-argument",
		"alt+0": { "do": "digit-argument", "with": { "d": 0 } },
		"alt+1": { "do": "digit-argument", "with": { "d": 1 } },
		"alt+2": { "do": "digit-argument", "with": { "d": 2 } },
		"alt+3": { "do": "digit-argument", "with": { "d": 3 } },
		"alt+4": { "do": "digit-argument", "with": { "d": 4 } },
		"alt+5": { "do": "digit-argument", "with": { "d": 5 } },
		"alt+6": { "do": "digit-argument", "with": { "d": 6 } },
		"alt+7": { "do": "digit-argument", "with": { "d": 7 } },
		"alt+8": { "do": "digit-argument", "with": { "d": 8 } },
		"alt+9": { "do": "digit-argument", "with": { "d": 9 } },
		"ctrl+h f": "describe-function",
		"ctrl+h v": "describe-variable",
		"ctrl+h k": "describe-key",
		"ctrl+h b": "describe-bindings",
		"ctrl+h m": "describe-mode",
		"ctrl+h e": "view-echo-area-messages",
		"ctrl+h t": "help-with-tutorial",
		"ctrl+s": "isearch-forward",
		"ctrl+r": "isearch-backward",
		"alt+shift+5": "query-replace",
		"ctrl+x ctrl+w": "write-file",
		"ctrl+x i": "insert-file"
	}
}
