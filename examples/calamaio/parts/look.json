	"tokens": {
		"kit.background": "@bg",
		"kit.surface": { "default": "#ffffff", "inchiostro": "#1a1b33", "pergamena": "#fffdf6" },
		"kit.bar": "@bar",
		"kit.barHover": "@barHover",
		"kit.field": "@field",
		"kit.text": "@barFg",
		"kit.dim": { "default": "#6d7275", "inchiostro": "#8d8fb0", "pergamena": "#7a705a" },
		"kit.body": "@barFg",
