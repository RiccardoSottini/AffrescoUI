		"kit.onPrimary": "#ffffff",
		"kit.secondary": "@button",
		"kit.onSecondary": "@barFg",
		"kit.accent": "@link",
		"kit.focus": "@link",
		"kit.backdrop": "#00000030",
		"kit.info": "@link",
		"kit.warning": "@warn",
		"kit.error": "@err",
		"kit.success": "@ok",
		"kit.radius": 3,
		"kit.cardRadius": 4,
		"kit.borderWidth": 1
