{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "calamaio.screen.json",
	"scenarios": [
		{
			"name": "frame",
			"note": "The start screen, then the scratch buffer, two windows and the minibuffer.",
			"steps": [
				{ "capture": "splash" },
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.open", "is": true } },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "b1" } },
				{ "key": "ctrl+x" },
				{ "key": "2" },
				{ "wait": 50 },
				{ "expect": { "state": "layout.groups.length", "is": 2 } },
				{ "key": "ctrl+x" },
				{ "key": "o" },
				{ "wait": 50 },
				{ "expect": { "state": "sel", "is": "w2" } },
				{ "type": "(+ 1 2)" },
				{ "capture": "split" },
				{ "key": "ctrl+x" },
				{ "key": "3" },
				{ "wait": 50 },
				{ "capture": "three" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "expect": { "state": "layout.groups.length", "is": 1 } },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "type": "forward" },
				{ "capture": "mx" },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.open", "is": false } },
				{ "capture": "quit" }
			]
		},
		{
			"name": "minibuffer",
			"note": "Completion, history, a prefix argument and the help commands.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scr" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "*scratch*" } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "type": "desc" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-" } },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.comp.length", "is": 5 } },
				{ "capture": "completions" },
				{ "type": "f" },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-function" } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "type": "forward-c" },
				{ "key": "tab" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "expect": { "state": "bufs.bh.name", "is": "*Help*" } },
				{ "capture": "help-function" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "ctrl+h" },
				{ "key": "k" },
				{ "wait": 50 },
				{ "expect": { "state": "keyread.on", "is": true } },
				{ "key": "ctrl+x" },
				{ "wait": 50 },
				{ "capture": "describe-key-prefix" },
				{ "key": "ctrl+f" },
				{ "wait": 120 },
				{ "expect": { "state": "keyread.on", "is": false } },
				{ "capture": "describe-key" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "ctrl+h" },
				{ "key": "v" },
				{ "wait": 50 },
				{ "type": "fill" },
				{ "key": "tab" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "capture": "describe-variable" },
				{ "key": "ctrl+x" },
				{ "key": "1" },
				{ "wait": 50 },
				{ "key": "alt+x" },
				{ "wait": 50 },
				{ "key": "alt+p" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.text", "is": "describe-function" } },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+a" },
				{ "key": "ctrl+u" },
				{ "key": "ctrl+u" },
				{ "wait": 50 },
				{ "expect": { "state": "arg", "is": 16 } },
				{ "capture": "universal-argument" },
				{ "key": "ctrl+f" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.column", "is": 17 } }
			]
		},
		{
			"name": "search",
			"note": "Incremental search forward, repeat, stop and quit; a query replace answered y then n.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+shift+comma" },
				{ "wait": 50 },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": true } },
				{ "key": "b" },
				{ "key": "u" },
				{ "key": "f" },
				{ "wait": 50 },
				{ "wait": 50 },
				{ "expect": { "state": "is.text", "is": "buf" } },
				{ "expect": { "state": "win.w1.caret.matches", "is": 2 } },
				{ "capture": "isearch" },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.line", "is": 2 } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": false } },
				{ "key": "ctrl+s" },
				{ "key": "ctrl+s" },
				{ "wait": 50 },
				{ "expect": { "state": "is.text", "is": "buf" } },
				{ "key": "ctrl+g" },
				{ "wait": 50 },
				{ "expect": { "state": "is.on", "is": false } },
				{ "key": "ctrl+p" },
				{ "key": "ctrl+a" },
				{ "key": "alt+shift+5" },
				{ "wait": 50 },
				{ "type": "buffer" },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "type": "BUFFER" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "expect": { "state": "qr.on", "is": true } },
				{ "capture": "query-replace" },
				{ "key": "y" },
				{ "wait": 80 },
				{ "key": "n" },
				{ "wait": 120 },
				{ "expect": { "state": "qr.on", "is": false } },
				{ "capture": "replaced" }
			]
		},
		{
			"name": "files",
			"note": "Save As writes the buffer to a new file it then visits; Insert File puts a file's text at point, which stays before it.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "ctrl+x" },
				{ "key": "ctrl+w" },
				{ "wait": 50 },
				{ "type": "scratch.el" },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "expect": { "state": "bufs.b1.file", "is": "~/scratch.el" } },
				{ "expect": { "state": "bufs.b1.name", "is": "scratch.el" } },
				{ "expect": { "state": "bufs.b1.dirty", "is": false } },
				{ "expect": { "state": "echo", "is": "Wrote ~/scratch.el" } },
				{ "expect": { "state": "files.length", "is": 9 } },
				{ "key": "ctrl+x" },
				{ "key": "i" },
				{ "wait": 50 },
				{ "type": "nope" },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "expect": { "state": "echo", "is": "No file named ~/nope" } },
				{ "key": "ctrl+x" },
				{ "key": "i" },
				{ "wait": 50 },
				{ "type": "hello.py" },
				{ "key": "enter" },
				{ "wait": 120 },
				{ "expect": { "state": "bufs.b1.text", "is": ";; This buffer is for notes you won't keep and for Lisp you want to try out.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n\"\"\"Counts the words of a text file and prints the most common ones.\"\"\"\n\nimport sys\nfrom collections import Counter\n\n\ndef words(text):\n    \"\"\"Splits the text into lowercase words, dropping punctuation.\"\"\"\n    cleaned = \"\".join(c if c.isalnum() else \" \" for c in text.lower())\n    return cleaned.split()\n\n\ndef main(path, top=10):\n    with open(path, encoding=\"utf-8\") as handle:\n        counts = Counter(words(handle.read()))\n    for word, n in counts.most_common(top):\n        print(f\"{n:6}  {word}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else \"notes.txt\"))\n" } },
				{ "expect": { "state": "win.w1.caret.line", "is": 4 } },
				{ "expect": { "state": "bufs.b1.dirty", "is": true } },
				{ "capture": "inserted" }
			]
		},
		{
			"name": "kill-ring",
			"note": "C-k twice kills a line and joins its line break into the same kill; C-y yanks it back, M-y swaps in an older kill, and C-x h M-w copies the whole buffer.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+shift+comma" },
				{ "wait": 50 },
				{ "key": "ctrl+k" },
				{ "wait": 50 },
				{ "expect": { "state": "kills[0]", "is": ";; This buffer is for notes you won't keep and for Lisp you want to try out." } },
				{ "expect": { "state": "bufs.b1.text", "is": "\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "ctrl+k" },
				{ "wait": 50 },
				{ "expect": { "state": "kills.length", "is": 1 } },
				{ "expect": { "state": "kills[0]", "is": ";; This buffer is for notes you won't keep and for Lisp you want to try out.\n" } },
				{ "expect": { "state": "bufs.b1.text", "is": ";; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "ctrl+y" },
				{ "wait": 50 },
				{ "expect": { "state": "bufs.b1.text", "is": ";; This buffer is for notes you won't keep and for Lisp you want to try out.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "expect": { "state": "win.w1.caret.line", "is": 2 } },
				{ "key": "ctrl+e" },
				{ "key": "ctrl+b" },
				{ "key": "alt+backspace" },
				{ "wait": 50 },
				{ "expect": { "state": "kills[0]", "is": "own" } },
				{ "expect": { "state": "kills.length", "is": 2 } },
				{ "key": "ctrl+y" },
				{ "wait": 50 },
				{ "key": "alt+y" },
				{ "wait": 50 },
				{ "expect": { "state": "yank.i", "is": 1 } },
				{ "expect": { "state": "bufs.b1.text", "is": ";; This buffer is for notes you won't keep and for Lisp you want to try out.\n;; To visit a file, type C-x C-f; its text gets a buffer of its ;; This buffer is for notes you won't keep and for Lisp you want to try out.\n.\n\n" } },
				{ "capture": "yank-pop" },
				{ "key": "ctrl+x" },
				{ "key": "h" },
				{ "wait": 50 },
				{ "expect": { "state": "mark.on", "is": true } },
				{ "key": "alt+w" },
				{ "wait": 50 },
				{ "expect": { "state": "echo", "is": "Copied the region" } },
				{ "expect": { "state": "kills.length", "is": 3 } }
			]
		},
		{
			"name": "editing",
			"note": "The region's case, a comment toggled with the mode's marker, transposed characters, an opened line, and point and mark exchanged.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+shift+comma" },
				{ "wait": 50 },
				{ "key": "ctrl+space" },
				{ "key": "ctrl+e" },
				{ "wait": 50 },
				{ "key": "ctrl+x" },
				{ "key": "ctrl+u" },
				{ "wait": 50 },
				{ "expect": { "state": "bufs.b1.text", "is": ";; THIS BUFFER IS FOR NOTES YOU WON'T KEEP AND FOR LISP YOU WANT TO TRY OUT.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "alt+semicolon" },
				{ "wait": 50 },
				{ "expect": { "state": "bufs.b1.text", "is": "THIS BUFFER IS FOR NOTES YOU WON'T KEEP AND FOR LISP YOU WANT TO TRY OUT.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "ctrl+a" },
				{ "key": "ctrl+f" },
				{ "key": "ctrl+t" },
				{ "wait": 50 },
				{ "expect": { "state": "bufs.b1.text", "is": "HTIS BUFFER IS FOR NOTES YOU WON'T KEEP AND FOR LISP YOU WANT TO TRY OUT.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "ctrl+a" },
				{ "key": "ctrl+o" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.line", "is": 1 } },
				{ "expect": { "state": "bufs.b1.text", "is": "\nHTIS BUFFER IS FOR NOTES YOU WON'T KEEP AND FOR LISP YOU WANT TO TRY OUT.\n;; To visit a file, type C-x C-f; its text gets a buffer of its own.\n\n" } },
				{ "key": "ctrl+x" },
				{ "key": "h" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.line", "is": 1 } },
				{ "key": "ctrl+x" },
				{ "key": "ctrl+x" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.caret.line", "is": 5 } },
				{ "capture": "region" }
			]
		},
		{
			"name": "options",
			"note": "Options turns line numbers, line wrapping, bracket matching, the tool bar and the menu bar off and on again; F10 still opens a menu with the bar hidden.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "b" },
				{ "wait": 50 },
				{ "type": "*scratch*" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "key": "alt+shift+comma" },
				{ "wait": 50 },
				{ "action": "display-line-numbers-mode" },
				{ "wait": 50 },
				{ "expect": { "state": "settings['global-display-line-numbers-mode']", "is": true } },
				{ "expect": { "state": "echo", "is": "Line numbers on" } },
				{ "action": "tool-bar-mode" },
				{ "wait": 50 },
				{ "expect": { "node": "#tool-bar-root", "exists": false } },
				{ "action": "menu-bar-mode" },
				{ "wait": 50 },
				{ "expect": { "node": "#menuBar", "exists": false } },
				{ "action": "visual-line-mode" },
				{ "wait": 50 },
				{ "expect": { "state": "settings['visual-line-mode']", "is": true } },
				{ "capture": "bars-off" },
				{ "key": "f10" },
				{ "wait": 50 },
				{ "expect": { "node": "#menuBar", "exists": true } },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "action": "tool-bar-mode" },
				{ "action": "menu-bar-mode" },
				{ "action": "display-line-numbers-mode" },
				{ "wait": 50 },
				{ "expect": { "node": "#tool-bar-root", "exists": true } },
				{ "expect": { "state": "settings['global-display-line-numbers-mode']", "is": false } }
			]
		},
		{
			"name": "listings",
			"note": "C-x d lists the home folder and RET visits a file; C-x C-b lists the buffers, RET shows one, q leaves the list.",
			"steps": [
				{ "key": "ctrl+x" },
				{ "key": "d" },
				{ "wait": 50 },
				{ "expect": { "state": "mb.open", "is": true } },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "expect": { "state": "bufs.bd.mode", "is": "dired" } },
				{ "capture": "dired" },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "wait": 80 },
				{ "expect": { "state": "win.w1.buf", "is": "b3" } },
				{ "expect": { "state": "bufs.b3.file", "is": "~/hello.py" } },
				{ "key": "ctrl+x" },
				{ "key": "ctrl+b" },
				{ "wait": 80 },
				{ "expect": { "state": "bufs.bl.mode", "is": "buffer-menu" } },
				{ "capture": "buffer-list" },
				{ "key": "g" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "bl" } },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "key": "ctrl+n" },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "bd" } },
				{ "key": "ctrl+x" },
				{ "key": "ctrl+b" },
				{ "wait": 50 },
				{ "key": "q" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "bd" } }
			]
		},
		{
			"name": "start-screen",
			"note": "The start screen's cards and buttons run their commands; its checkbox keeps Calamaio from opening on it.",
			"steps": [
				{ "click": [330, 323] },
				{ "wait": 80 },
				{ "expect": { "state": "win.w1.buf", "is": "bt" } },
				{ "expect": { "state": "bufs.bt.name", "is": "TUTORIAL" } },
				{ "capture": "tutorial" },
				{ "action": "show-splash" },
				{ "wait": 50 },
				{ "click": [617, 323] },
				{ "wait": 80 },
				{ "expect": { "state": "bufs.bg.name", "is": "*Tour*" } },
				{ "key": "q" },
				{ "wait": 50 },
				{ "expect": { "state": "win.w1.buf", "is": "bt" } },
				{ "action": "show-splash" },
				{ "wait": 50 },
				{ "click": { "role": "button", "name": "Startup Options" } },
				{ "wait": 80 },
				{ "expect": { "state": "customQuery", "is": "startup" } },
				{ "capture": "customize" },
				{ "action": "show-splash" },
				{ "wait": 50 },
				{ "click": "#splashAtStart" },
				{ "wait": 50 },
				{ "expect": { "state": "settings['inhibit-startup-screen']", "is": true } }
			]
		},
		{
			"name": "assistant-in-its-colours",
			"note": "The assistant add-on in Calamaio's colours: it opens from its launcher, and Escape collapses it.",
			"steps": [
				{ "action": "assistant.open" },
				{ "wait": 250 },
				{ "expect": { "state": "assistant.open", "is": true } },
				{ "capture": "open" },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "expect": { "state": "assistant.open", "is": false } }
			]
		}
	]
}
