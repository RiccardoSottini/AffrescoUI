{
	"note": "Flow's list view, included by kanban.screen.json: every card in one list, grouped by column, a row each.",

	"components": {
		"listView": {
			"note": "The cards grouped by column: a header with the column's name and count, then a row a card",
			"params": {},
			"node": {
				"id": "list",
				"type": "column",
				"scroll": "vertical",
				"radius": "@radius.card",
				"color": "@color.surface",
				"role": "list",
				"children": [
					{
						"id": "listGroup",
						"repeat": { "for": "column", "in": "state.columns", "index": "c" },
						"anchors": { "left": 0, "right": 0 },
						"height": "{{36 + 36 * count(column.cards, contains(computed.visibleRefs, it.ref))}}",
						"color": "transparent",
						"role": "group",
						"label": "{{column.name}}",
						"onDrop": { "run": "moveCard", "with": { "from": "{{event.data.from}}", "at": "{{event.data.at}}", "to": "{{c}}" } },
						"children": [
							{
								"id": "listHeader",
								"anchors": { "left": 0, "right": 0, "top": 0 },
								"height": 36,
								"color": "@color.column",
								"children": [
									{ "id": "listStatus", "type": "label", "icon": "{{state.statusIcons[c] ?? 'circle'}}", "text": "", "textColor": "{{column.color}}", "fitText": true,
										"anchors": { "left": 20, "top": 0, "bottom": 0 }, "align": "center" },
									{ "id": "listTitle", "type": "row", "gap": 10, "alignItems": "center", "anchors": { "left": 44, "right": 52, "top": 0, "bottom": 0 }, "children": [
										{ "id": "listName", "type": "label", "font": "small", "text": "{{column.name}}", "textColor": "@color.text", "fitText": true, "height": 36,
											"align": { "horizontal": "start", "vertical": "center" } },
										{ "id": "listCount", "style": "caption", "text": "{{length(column.cards)}}", "textColor": "{{computed.over[c] ? '@bug' : '@color.muted'}}", "fitText": true, "height": 36,
											"align": { "horizontal": "start", "vertical": "center" } }
									] },
									{ "id": "listAdd", "type": "label", "icon": "plus", "text": "", "textColor": "@color.muted", "width": 28, "height": 28, "radius": "@radius.chip", "align": "center",
										"anchors": { "right": 12, "top": 4 }, "hover": { "color": "@color.chipHover" }, "cursor": "hand", "focusable": true, "role": "button",
										"label": "{{t('composer.in', { column: column.name })}}", "tooltip": "{{t('composer.in', { column: column.name })}}", "onClick": { "run": "openComposer", "with": { "c": "{{c}}" } } }
								]
							},
							{
								"id": "listRows",
								"type": "column",
								"anchors": { "left": 0, "right": 0, "top": 36, "bottom": 0 },
								"children": [
									{
										"id": "listRow",
										"repeat": { "for": "card", "in": "column.cards", "index": "i" },
										"when": "{{contains(computed.visibleRefs, card.ref)}}",
										"anchors": { "left": 0, "right": 0 },
										"height": 36,
										"color": "{{contains(state.marked, card.ref) || (state.selected != null && state.selected.c == c && state.selected.i == i) ? '@color.accentSoft' : 'transparent'}}",
										"hover": { "color": "{{contains(state.marked, card.ref) || (state.selected != null && state.selected.c == c && state.selected.i == i) ? '@color.accentSoft' : '@color.column'}}" },
										"cursor": "hand",
										"focusable": true,
										"role": "listitem",
										"label": "{{t('card.label', { title: card.title, tag: t('tag.' + card.tag), who: find(state.members, it.who == card.who).name ?? card.who, column: column.name })}}",
										"onFocus": { "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } },
										"keys": { "enter": "editCard", "space": "togglePeek", "shift+f10": { "run": "openCardMenu", "with": { "c": "{{c}}", "i": "{{i}}" } } },
										"drag": { "data": { "from": "{{c}}", "at": "{{i}}" } },
										"onClick": { "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } },
										"onDoubleClick": [{ "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } }, { "run": "openIssue" }],
										"onContextMenu": { "run": "openCardMenu", "with": { "c": "{{c}}", "i": "{{i}}" } },
										"children": [
											{ "id": "rowLine", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 1, "color": "@color.border" },
											{ "id": "rowPriority", "type": "label", "icon": "{{state.priorities[card.priority ?? 0]}}", "text": "", "fitText": true,
												"textColor": "{{card.priority == 1 ? '@bug' : '@color.muted'}}", "anchors": { "left": 20, "top": 0, "bottom": 0 }, "align": "center",
												"tooltip": "{{t('priority.' + (card.priority ?? 0))}}" },
											{ "id": "rowRef", "type": "label", "font": "small", "text": "{{card.ref ?? ''}}", "textColor": "@color.muted", "width": 56,
												"anchors": { "left": 44, "top": 0, "bottom": 0 }, "align": { "horizontal": "start", "vertical": "center" } },
											{ "id": "rowStatus", "type": "label", "icon": "{{state.statusIcons[c] ?? 'circle'}}", "text": "", "fitText": true, "textColor": "{{column.color}}",
												"anchors": { "left": 104, "top": 0, "bottom": 0 }, "align": "center", "tooltip": "{{column.name}}" },
											{ "id": "rowTitle", "type": "label", "text": "{{card.title}}", "textColor": "{{c == computed.lastColumn ? '@color.muted' : '@color.text'}}",
												"anchors": { "left": 130, "right": 260, "top": 0, "bottom": 0 }, "align": { "horizontal": "start", "vertical": "center" } },
											{ "id": "rowTag", "type": "label", "font": "small", "text": " {{t('tag.' + card.tag)}}", "icon": "{{state.tagIcons[card.tag]}}", "fitText": true,
												"padding": 6, "height": 22, "radius": 999, "borderWidth": 1, "borderColor": "@color.border", "color": "transparent", "textColor": "@{{card.tag}}",
												"anchors": { "right": 148, "top": 7 } },
											{ "id": "rowDue", "style": "caption", "when": "{{card.due != null}}", "text": "{{formatDate(dateMs(card.due), 'short', 'utc')}}",
												"textColor": "{{daysBetween(state.today, card.due) < 0 && c != computed.lastColumn ? '@bug' : '@color.muted'}}",
												"anchors": { "right": 84, "top": 0, "bottom": 0 }, "align": { "horizontal": "end", "vertical": "center" } },
											{ "id": "rowPoints", "style": "caption", "text": "{{card.points}}", "width": 20, "anchors": { "right": 52, "top": 0, "bottom": 0 },
												"align": { "horizontal": "end", "vertical": "center" }, "tooltip": "{{t('card.points', { n: card.points })}}" },
											{ "id": "rowWho", "style": "badge", "text": "{{card.who}}", "width": 22, "height": 22, "radius": 999, "anchors": { "right": 20, "top": 7 },
												"color": "{{find(state.members, it.who == card.who).color ?? '@color.muted'}}", "textColor": "#ffffff",
												"tooltip": "{{find(state.members, it.who == card.who).name ?? card.who}}" }
										]
									}
								]
							}
						]
					}
				]
			}
		}
	}
}
