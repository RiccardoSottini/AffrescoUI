{
	"$schema": "../../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "What the Kanban template does, checked headless: affrescoui test kanban.scenarios.json",
	"screen": "kanban.screen.json",
	"scenarios": [
		{
			"name": "add-a-card",
			"note": "Typing in the new-card field and pressing Enter adds the card at the end of the Backlog",
			"steps": [
				{ "click": "#newCard" },
				{ "type": "Write render tests" },
				{ "expect": { "state": "newCard", "is": "Write render tests" } },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards.length", "is": 5 } },
				{ "expect": { "state": "columns[0].cards[4].title", "is": "Write render tests" } },
				{ "expect": { "state": "newCard", "is": "" } },
				{ "expect": { "node": "#cardTitle", "nth": 4, "text": "Write render tests" } },
				{ "expect": { "node": "#columnCount", "text": "5" } }
			]
		},
		{
			"name": "ignore-a-blank-card",
			"note": "Pressing Enter with only spaces in the new-card field adds nothing",
			"steps": [
				{ "click": "#newCard" },
				{ "type": "   " },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards.length", "is": 4 } },
				{ "expect": { "node": "#columnCount", "text": "4" } }
			]
		},
		{
			"name": "filter-by-tag",
			"note": "Clicking the bug chip shows only bug cards, and a new card takes the filter's tag; Escape shows every card again",
			"steps": [
				{ "click": "#filter", "nth": 1 },
				{ "expect": { "state": "filter", "is": "bug" } },
				{ "expect": { "node": "#cardTitle", "nth": 0, "text": "Crash when a board has no columns" } },
				{ "expect": { "node": "#card", "nth": 2, "exists": true } },
				{ "expect": { "node": "#card", "nth": 3, "exists": false } },
				{ "click": "#newCard" },
				{ "type": "Login loops forever" },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards[4].tag", "is": "bug" } },
				{ "key": "escape" },
				{ "expect": { "state": "filter", "is": "all" } },
				{ "expect": { "node": "#card", "nth": 12, "exists": true } }
			]
		},
		{
			"name": "move-a-card-with-buttons",
			"note": "» moves a card one column right and « moves it back to the end of the column it came from",
			"steps": [
				{ "click": "#move-button-card-2", "note": "» on the first Backlog card" },
				{ "expect": { "state": "columns[0].cards.length", "is": 3 } },
				{ "expect": { "state": "columns[1].cards.length", "is": 4 } },
				{ "expect": { "state": "columns[1].cards[3].title", "is": "Onboarding checklist for new teams" } },
				{ "expect": { "node": "#columnCount", "nth": 1, "text": "4" } },
				{ "click": "#move-button-card", "nth": 3, "note": "« on the moved card, the fourth In progress card" },
				{ "expect": { "state": "columns[0].cards[3].title", "is": "Onboarding checklist for new teams" } },
				{ "expect": { "state": "columns[1].cards.length", "is": 3 } }
			]
		},
		{
			"name": "drag-a-card-to-another-column",
			"note": "Dragging the first Backlog card onto the Review column moves it there",
			"steps": [
				{ "drag": "#card", "to": "#column", "toNth": 2, "moves": 4, "note": "the first card onto the third column, Review" },
				{ "expect": { "state": "columns[0].cards.length", "is": 3 } },
				{ "expect": { "state": "columns[2].cards.length", "is": 3 } },
				{ "expect": { "state": "columns[2].cards[2].title", "is": "Onboarding checklist for new teams" } },
				{ "expect": { "node": "#columnCount", "nth": 2, "text": "3" } }
			]
		},
		{
			"name": "show-one-members-cards",
			"note": "The avatars open the members menu; picking a person shows only their cards and closes the menu; Escape clears it",
			"steps": [
				{ "click": "#member" },
				{ "expect": { "state": "membersOpen", "is": true } },
				{ "expect": { "node": "#label-member-name", "nth": 1, "text": "Maya Klein" } },
				{ "click": "#panel-member", "nth": 1 },
				{ "expect": { "state": "owner", "is": "MK" } },
				{ "expect": { "state": "membersOpen", "is": false } },
				{ "expect": { "node": "#cardOwner", "nth": 0, "text": "MK" } },
				{ "expect": { "node": "#card", "nth": 2, "exists": true } },
				{ "expect": { "node": "#card", "nth": 3, "exists": false } },
				{ "key": "escape" },
				{ "expect": { "state": "owner", "is": "" } }
			]
		},
		{
			"name": "shortcut-focuses-new-card",
			"note": "Cmd+N puts the keyboard in the new-card field, so typing and Enter add a card",
			"steps": [
				{ "key": "mod+n" },
				{ "wait": 0, "note": "the focus lands on the next frame" },
				{ "expect": { "node": "#newCard", "property": "focused", "is": true } },
				{ "type": "From the keyboard" },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards[4].title", "is": "From the keyboard" } }
			]
		},
		{
			"name": "select-a-card-shows-its-details",
			"note": "Clicking a card selects it; the details show its title, owner and description, and the link runs a toast",
			"steps": [
				{ "click": "#cardTitle" },
				{ "expect": { "state": "selected.c", "is": 0 } },
				{ "expect": { "state": "selected.i", "is": 0 } },
				{ "expect": { "node": "#detailTitle", "text": "Onboarding checklist for new teams" } },
				{ "expect": { "node": "#detailOwner", "text": "Ada Lewis" } },
				{ "expect": { "node": "#noCard", "exists": false } }
			]
		},
		{
			"name": "switch-boards-with-tabs",
			"note": "A board tab brings that board's columns in and keeps the first board's; going back restores it",
			"steps": [
				{ "click": "#move-button-card-2", "note": "» on the first Backlog card, so the board has changed" },
				{ "expect": { "state": "columns[1].cards.length", "is": 4 } },
				{ "click": "#boardTabs" },
				{ "click": [277, 32], "note": "the Website tab" },
				{ "expect": { "state": "boardId", "is": "website" } },
				{ "expect": { "state": "board", "is": "Website" } },
				{ "expect": { "node": "#cardTitle", "nth": 0, "text": "Pricing page comparison table" } },
				{ "click": [200, 32], "note": "the Product launch tab" },
				{ "expect": { "state": "boardId", "is": "launch" } },
				{ "expect": { "state": "columns[1].cards.length", "is": 4 } }
			]
		},
		{
			"name": "table-of-every-card",
			"note": "The Table view lists every card of the board, one row each; choosing a row selects its card",
			"steps": [
				{ "click": "#viewTable" },
				{ "expect": { "state": "view", "is": "table" } },
				{ "expect": { "node": "#cardTable", "exists": true } },
				{ "expect": { "node": "#board", "exists": false } },
				{ "expect": { "state": "selected", "is": null } },
				{ "click": [300, 236], "note": "the third row: Crash when a board has no columns" },
				{ "expect": { "state": "selected.c", "is": 0 } },
				{ "expect": { "state": "selected.i", "is": 2 } },
				{ "expect": { "node": "#detailTitle", "text": "Crash when a board has no columns" } },
				{ "click": "#viewBoard" },
				{ "expect": { "node": "#board", "exists": true } }
			]
		},
		{
			"name": "edit-a-card-in-a-dialog",
			"note": "Cmd+E on the chosen card opens the edit dialog with its title; Enter saves it and shows a toast",
			"steps": [
				{ "key": "mod+e", "note": "no card chosen yet: the command is disabled" },
				{ "expect": { "state": "edit.open", "is": false } },
				{ "click": "#cardTitle", "nth": 1 },
				{ "key": "mod+e" },
				{ "wait": 50 },
				{ "expect": { "state": "edit.open", "is": true } },
				{ "expect": { "node": "#editTitle", "text": "Empty states for every page" } },
				{ "type": ", even errors" },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards[1].title", "is": "Empty states for every page, even errors" } },
				{ "expect": { "state": "edit.open", "is": false } },
				{ "expect": { "state": "toast.open", "is": true } },
				{ "wait": 4100 },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "card-menu",
			"note": "The card's menu holds its commands; Move card right moves it",
			"steps": [
				{ "click": "#cardTitle" },
				{ "click": "#detailMore" },
				{ "wait": 50 },
				{ "expect": { "state": "cardMenu", "is": true } },
				{ "key": "down" },
				{ "key": "enter", "note": "the next enabled item: Move card right (Move card left is disabled in the Backlog)" },
				{ "expect": { "state": "cardMenu", "is": false } },
				{ "expect": { "state": "columns[1].cards[3].title", "is": "Onboarding checklist for new teams" } },
				{ "key": "mod+left" },
				{ "expect": { "state": "columns[0].cards[3].title", "is": "Onboarding checklist for new teams" } }
			]
		},
		{
			"name": "go-to-a-card",
			"note": "Cmd+P opens the quick pick over every card; typing filters it and Enter selects the card",
			"steps": [
				{ "click": "#filter", "nth": 1, "note": "a filter that hides the card, cleared by going to it" },
				{ "key": "mod+p" },
				{ "wait": 50 },
				{ "expect": { "state": "quickPick.open", "is": true } },
				{ "type": "invite" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "expect": { "state": "quickPick.open", "is": false } },
				{ "expect": { "state": "filter", "is": "all" } },
				{ "expect": { "state": "selected.c", "is": 2 } },
				{ "expect": { "state": "selected.i", "is": 0 } }
			]
		},
		{
			"name": "kanban-command-palette",
			"note": "Cmd+Shift+P lists the commands; running Switch light and dark changes the theme",
			"steps": [
				{ "key": "mod+shift+p" },
				{ "wait": 50 },
				{ "expect": { "state": "quickPick.query", "is": ">" } },
				{ "type": "dark" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "key": "mod+j" },
				{ "expect": { "state": "theme", "is": "light" } }
			]
		}
	]
}
