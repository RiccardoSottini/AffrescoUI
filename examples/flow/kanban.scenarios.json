				{ "click": "#propPriorityValue" },
				{ "click": "#priorityPick", "nth": 1 },
				{ "expect": { "state": "issuePriorityOpen", "is": false } },
				{ "expect": { "state": "columns[0].cards[2].priority", "is": 1 } },
				{ "click": "#propStatusValue" },
				{ "click": "#statusPick", "nth": 1 },
				{ "expect": { "state": "columns[1].cards.length", "is": 4 } },
				{ "key": "escape" },
				{ "expect": { "state": "issueOpen", "is": false } },
				{ "expect": { "node": "#issuePage", "exists": false } }
			]
		},
		{
			"name": "single-key-shortcuts",
			"note": "J and K walk the cards, P, S and A pick the selected card's priority, status and assignee, I assigns it to me",
			"steps": [
				{ "key": "j" },
				{ "expect": { "state": "selected.i", "is": 0 } },
				{ "key": "j" },
				{ "key": "j" },
				{ "key": "k" },
				{ "expect": { "state": "selected.i", "is": 1 } },
				{ "key": "p" },
				{ "wait": 50 },
				{ "expect": { "state": "propPick.open", "is": true } },
				{ "type": "urgent" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "expect": { "state": "propPick.open", "is": false } },
				{ "expect": { "state": "columns[0].cards[1].priority", "is": 1 } },
				{ "wait": 50 },
				{ "key": "a" },
				{ "wait": 50 },
				{ "expect": { "state": "propKind", "is": "assignee" } },
				{ "expect": { "state": "propPick.open", "is": true } },
				{ "type": "jon" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "expect": { "state": "columns[0].cards[1].who", "is": "JD" } },
				{ "wait": 50 },
				{ "key": "i" },
				{ "expect": { "state": "columns[0].cards[1].who", "is": "RS" } },
				{ "key": "s" },
				{ "wait": 50 },
				{ "type": "review" },
				{ "wait": 50 },
				{ "key": "enter" },
				{ "expect": { "state": "selected.c", "is": 2 } },
				{ "key": "mod+k" },
				{ "expect": { "state": "quickPick.query", "is": ">" } }
			]
		},
		{
			"name": "team-pages",
			"note": "The inbox picks, marks, snoozes and opens notifications; G chords go to cycles, projects and back to the issues",
			"steps": [
				{ "expect": { "node": "#navCount", "text": "3" } },
				{ "click": "#navInbox" },
				{ "expect": { "state": "page", "is": "inbox" } },
				{ "key": "j" },
				{ "expect": { "state": "inboxAt", "is": 1 } },
				{ "expect": { "state": "inbox[1].read", "is": true } },
				{ "key": "u" },
				{ "expect": { "state": "inbox[1].read", "is": false } },
				{ "key": "h" },
				{ "expect": { "state": "inbox[1].snoozed", "is": true } },
				{ "expect": { "node": "#navCount", "text": "2" } },
				{ "key": "k" },
				{ "key": "enter" },
				{ "expect": { "state": "issueOpen", "is": true } },
				{ "expect": { "state": "selected", "is": { "c": 0, "i": 2 } } },
				{ "key": "escape" },
				{ "key": "g" },
				{ "key": "v" },
