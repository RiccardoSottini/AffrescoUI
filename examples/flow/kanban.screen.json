{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Flow: a kanban board. Boards are tabs; the board, swimlanes by member, a table of every card or a timeline of due dates shares a split with the chosen card's drawer, or the board's insights. Drag a card to another column, use « and », Alt and the arrows, or right-click it for its menu; double-click it or press Cmd+Enter to open it as a page, Enter to edit it. Cmd+P goes to a card, Cmd+Shift+P runs a command, Cmd+N types a new card, Cmd+F searches, Cmd+Z undoes, Cmd+J switches light and dark, Cmd+L the language, Cmd+, opens the settings, Escape closes the issue page, then clears the filters.",

	"window": { "title": "Flow: an AffrescoUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"include": ["../shared/components/charts.json", "strings.json", "board.json", "drawer.json", "views.json", "sidebar.json", "list.json", "issue.json"],

	"persist": ["state.theme", "state.sizes", "state.view", "state.swimlanes", "state.settings"],

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "fallback": ["icons", "symbols", "arabic"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["iconsSmall", "arabicSmall"] },
		"heading": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "fallback": ["icons", "symbols", "arabic"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 20, "fallback": ["iconsLarge", "arabicLarge"] },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 15 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 13 },
		"iconsLarge": { "file": "../shared/fonts/Lucide.ttf", "size": 20 },
		"symbols": { "file": "../shared/fonts/JetBrainsMono-Regular.ttf", "size": 13 },
		"arabic": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 14 },
		"arabicSmall": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 12 },
		"arabicLarge": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 20 }
	},

	"theme": "{{state.theme}}",

	"tokens": {
		"radius.card": 6,
		"radius.chip": 6,
		"color.background": { "light": "#f4f4f5", "dark": "#08090a" },
		"color.topBar": { "light": "#ffffff", "dark": "#0f1011" },
		"color.topText": { "light": "#282a30", "dark": "#f7f8f8" },
		"color.topMuted": { "light": "#6b6f76", "dark": "#8a8f98" },
		"color.topLine": { "light": "#ececee", "dark": "#1c1d21" },
		"color.surface": { "light": "#ffffff", "dark": "#0f1011" },
		"color.column": { "light": "#f4f4f5", "dark": "#141516" },
		"color.text": { "light": "#282a30", "dark": "#f7f8f8" },
		"color.muted": { "light": "#6b6f76", "dark": "#8a8f98" },
		"color.border": { "light": "#e6e6e8", "dark": "#23252a" },
		"color.input": { "light": "#ffffff", "dark": "#141516" },
		"color.inputFocused": { "light": "#f4f5ff", "dark": "#191a23" },
		"color.accent": { "light": "#5e6ad2", "dark": "#7c86e4" },
		"color.accentSoft": { "light": "#e8eafb", "dark": "#1f2238" },
		"color.chipHover": { "light": "#ececee", "dark": "#1c1d21" },
		"color.chipOn": { "light": "#e8eafb", "dark": "#262840" },
		"color.chipOnText": { "light": "#3b45a8", "dark": "#d4d8fa" },
		"color.menu": { "light": "#ffffff", "dark": "#1c1d21" },
		"color.field": { "light": "#f4f4f5", "dark": "#141516" },
		"color.backdrop": { "light": "#0000004d", "dark": "#00000099" },
		"color.card": { "light": "#ffffff", "dark": "#18191b" },
		"color.sidebar": { "light": "#f4f4f5", "dark": "#08090a" },
		"color.sidebarHover": { "light": "#e8e8ea", "dark": "#16171a" },
		"color.sidebarOn": { "light": "#e2e2e5", "dark": "#1c1d21" },
		"color.urgent": { "light": "#eb5757", "dark": "#f2787a" },
		"color.high": { "light": "#6b6f76", "dark": "#8a8f98" },
		"bug": { "light": "#d93f3f", "dark": "#f2787a" },
		"bugSoft": { "light": "#fbe9e9", "dark": "#2e1617" },
		"feature": { "light": "#3d7ae0", "dark": "#78a6f0" },
		"featureSoft": { "light": "#e7effc", "dark": "#16213a" },
		"design": { "light": "#8e4fd9", "dark": "#b48cf0" },
		"designSoft": { "light": "#f1e9fb", "dark": "#24183a" },
		"chore": { "light": "#26a17a", "dark": "#4cc79e" },
		"choreSoft": { "light": "#e2f5ef", "dark": "#122a22" }
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"],
		"budgets": [{"author": "agent", "added": 20, "removed": 5, "changed": 50}]
	},

	"state": {
		"theme": "light",
		"board": "Product launch",
		"boardId": "launch",
		"boards": [
			{ "id": "launch", "label": "Product launch", "closable": false },
			{ "id": "website", "label": "Website", "closable": false },
			{ "id": "mobile", "label": "Mobile app", "closable": false }
		],
		"stash": {
			"website": [
				{ "name": "Backlog", "color": "#94a3b8", "cards": [
					{ "ref": "FLO-13", "priority": 3, "title": "Pricing page comparison table", "tag": "design", "who": "MK", "points": 3 },
					{ "ref": "FLO-14", "priority": 2, "title": "Broken anchor links in the docs", "tag": "bug", "who": "AL", "points": 1 }
				] },
				{ "name": "In progress", "color": "#4f46e5", "cards": [
					{ "ref": "FLO-15", "priority": 3, "title": "Blog with tags and search", "tag": "feature", "who": "JD", "points": 5 }
				] },
				{ "name": "Review", "color": "#d97706", "cards": [] },
				{ "name": "Done", "color": "#059669", "cards": [
					{ "ref": "FLO-16", "priority": 4, "title": "Move hosting to the new provider", "tag": "chore", "who": "RS", "points": 2 }
				] }
			],
			"mobile": [
				{ "name": "Backlog", "color": "#94a3b8", "cards": [
					{ "ref": "FLO-17", "priority": 2, "title": "Offline mode for boards", "tag": "feature", "who": "RS", "points": 8 }
				] },
				{ "name": "In progress", "color": "#4f46e5", "cards": [
					{ "ref": "FLO-18", "priority": 3, "title": "Push notifications for mentions", "tag": "feature", "who": "AL", "points": 3 },
					{ "ref": "FLO-19", "priority": 4, "title": "Dark launch screen", "tag": "design", "who": "MK", "points": 1 }
				] },
				{ "name": "Review", "color": "#d97706", "cards": [
					{ "ref": "FLO-20", "priority": 1, "title": "Crash on rotate in card view", "tag": "bug", "who": "JD", "points": 2 }
				] },
				{ "name": "Done", "color": "#059669", "cards": [] }
			]
		},
		"view": "board",
		"me": "RS",
		"nextRef": 21,
		"priorities": ["ellipsis", "badge-alert", "signal-high", "signal-medium", "signal-low"],
		"statusIcons": ["circle-dashed", "circle-dot", "circle-ellipsis", "check-circle-2"],
		"filter": "all",
		"filters": ["all", "bug", "feature", "design", "chore"],
		"tagIcons": { "bug": "bug", "feature": "sparkles", "design": "palette", "chore": "wrench" },
		"newCard": "",
		"owner": "",
		"membersOpen": false,
		"selected": null,
		"peek": false,
		"sizes": [900],
		"tableSort": null,
		"columnWidths": { "title": 300, "column": 120, "tag": 110, "who": 90, "points": 80 },
		"cardMenu": false,
		"menuAt": { "x": 0, "y": 0 },
		"edit": { "open": false, "title": "" },
		"toast": { "open": false, "message": "" },
		"quickPick": { "open": false, "query": "" },
		"propPick": { "open": false, "query": "" },
		"propKind": "status",
		"members": [
			{ "who": "RS", "name": "Remy Shaw", "color": "#4f46e5" },
			{ "who": "MK", "name": "Maya Klein", "color": "#9333ea" },
			{ "who": "AL", "name": "Ada Lewis", "color": "#0f766e" },
			{ "who": "JD", "name": "Jon Doe", "color": "#d97706" }
		],
		"columns": [
			{
				"name": "Backlog",
				"color": "#94a3b8",
				"cards": [
					{ "ref": "FLO-1", "priority": 3, "title": "Onboarding checklist for new teams", "tag": "feature", "who": "AL", "points": 5,
						"notes": "A short list of *first steps* on an empty board, under five items. Spec:", "linkText": "onboarding", "link": "https://example.com/specs/onboarding",
						"start": "2026-03-12", "due": "2026-03-20", "labels": ["frontend"], "assignees": ["AL", "MK"],
						"checklist": [{ "text": "List the first steps", "done": true }, { "text": "Draw the empty board", "done": false }, { "text": "Write the copy", "done": false }],
						"comments": [{ "who": "MK", "text": "The empty board drawing is on its way." }],
						"attachments": ["onboarding-flow.png"] },
					{ "ref": "FLO-2", "priority": 4, "title": "Empty states for every page", "tag": "design", "who": "MK", "points": 3 },
					{ "ref": "FLO-3", "priority": 1, "title": "Crash when a board has no columns", "tag": "bug", "who": "RS", "points": 2,
						"notes": "Opening a board whose columns were all deleted *crashes*. The steps:", "linkText": "issue 214", "link": "https://example.com/issues/214",
						"due": "2026-03-14", "labels": ["urgent", "backend"] },
					{ "ref": "FLO-4", "priority": 0, "title": "Upgrade the build toolchain", "tag": "chore", "who": "JD", "points": 1 }
				]
			},
			{
				"name": "In progress",
				"color": "#4f46e5",
				"limit": 3,
				"cards": [
					{ "ref": "FLO-5", "priority": 2, "title": "Keyboard shortcuts for moving cards", "tag": "feature", "who": "RS", "points": 3, "start": "2026-03-10", "due": "2026-03-17", "labels": ["frontend"] },
					{ "ref": "FLO-6", "priority": 3, "title": "New colour palette for labels", "tag": "design", "who": "MK", "points": 2, "start": "2026-03-11", "due": "2026-03-18" },
					{ "ref": "FLO-7", "priority": 2, "title": "Card counts drift after a filter", "tag": "bug", "who": "AL", "points": 1 }
				]
			},
			{
				"name": "Review",
				"color": "#d97706",
				"limit": 3,
				"cards": [
					{ "ref": "FLO-8", "priority": 2, "title": "Invite teammates by email", "tag": "feature", "who": "JD", "points": 5, "start": "2026-03-09", "due": "2026-03-19", "labels": ["backend"],
						"comments": [{ "who": "JD", "text": "Ready for review, the email copy is still a draft." }] },
					{ "ref": "FLO-9", "priority": 4, "title": "Document the board API", "tag": "chore", "who": "AL", "points": 2, "start": "2026-03-13", "due": "2026-03-23", "labels": ["docs"] }
				]
			},
			{
				"name": "Done",
				"color": "#059669",
				"cards": [
					{ "ref": "FLO-10", "priority": 3, "title": "Drag-free card moves", "tag": "feature", "who": "RS", "points": 3 },
					{ "ref": "FLO-11", "priority": 1, "title": "Fix blurry text on HiDPI screens", "tag": "bug", "who": "MK", "points": 2 },
					{ "ref": "FLO-12", "priority": 4, "title": "Launch page illustrations", "tag": "design", "who": "JD", "points": 3 }
				]
			}
		]
	},

	"stateTypes": {
		"theme": { "enum": ["light", "dark"] },
		"board": { "type": "string" },
		"boardId": { "type": "string" },
		"view": { "enum": ["board", "list", "table", "timeline"] },
		"nextRef": { "type": "number" },
		"swimlanes": { "type": "boolean" },
		"query": { "type": "string" },
		"filter": { "type": "string" },
		"filters": { "type": "array", "items": { "type": "string" } },
		"newCard": { "type": "string" },
		"owner": { "type": "string" },
		"membersOpen": { "type": "boolean" },
		"cardMenu": { "type": "boolean" },
		"members": { "type": "array", "items": { "type": "object", "properties": { "who": { "type": "string" }, "name": { "type": "string" }, "color": { "type": "string" } } } },
		"columns": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "color": { "type": "string" }, "limit": { "type": "number" }, "cards": { "type": "array", "items": { "type": "object", "properties": { "ref": { "type": "string" }, "priority": { "type": "number" }, "title": { "type": "string" }, "tag": { "type": "string" }, "who": { "type": "string" }, "points": { "type": "number" }, "notes": { "type": "string" }, "linkText": { "type": "string" }, "link": { "type": "string" }, "start": { "type": "string" }, "due": { "type": "string" }, "labels": { "type": "array", "items": { "type": "string" } }, "assignees": { "type": "array", "items": { "type": "string" } }, "attachments": { "type": "array", "items": { "type": "string" } } } } } } } }
	},

	"computed": {
		"lastColumn": "{{length(state.columns) - 1}}",
		"card": "{{state.selected == null ? null : state.columns[state.selected.c].cards[state.selected.i]}}",
		"counts": "{{map(state.columns, length(it.cards))}}",
		"allCards": "{{parseJson('[' + join(filter(map(state.columns, slice(join(split(json(map(it.cards, { at: index, ref: it.ref, priority: it.priority, due: it.due, points: it.points, start: it.start, tag: it.tag, title: it.title, who: it.who })), '{\"at\":'), '{\"c\":' + index + ',\"at\":'), 1, -1)), it != ''), ',') + ']')}}",
		"rows": "{{map(computed.allCards, { id: it.c + '-' + it.at, cells: [it.title, state.columns[it.c].name, it.tag, it.who, it.points] })}}",
		"picks": "{{map(computed.allCards, { title: it.title, detail: state.columns[it.c].name + ' · ' + it.who, c: it.c, at: it.at })}}",
		"over": "{{map(state.columns, it.limit != null && length(it.cards) > it.limit)}}",
		"tableColumns": "{{[{ id: 'title', title: t('table.card'), width: state.columnWidths.title }, { id: 'column', title: t('table.column'), width: state.columnWidths.column }, { id: 'tag', title: t('table.label'), width: state.columnWidths.tag }, { id: 'who', title: t('table.owner'), width: state.columnWidths.who }, { id: 'points', title: t('table.points'), width: state.columnWidths.points }]}}",
		"palette": "{{map(filter(commands, it.enabled), { title: it.title, detail: it.keyLabel ?? it.category, run: it.name })}}",
		"visible": "{{filter(computed.allCards, (state.filter == 'all' || it.tag == state.filter) && (state.owner == '' || it.who == state.owner) && (state.query == '' || fuzzy(state.query, it.title) != null))}}",
		"next": "{{state.selected == null ? computed.visible[0] : find(computed.visible, it.c > state.selected.c || (it.c == state.selected.c && it.at > state.selected.i))}}",
		"prev": "{{state.selected == null ? null : computed.visible[count(computed.visible, it.c < state.selected.c || (it.c == state.selected.c && it.at < state.selected.i)) - 1]}}",
		"propItems": "{{state.propKind == 'status' ? map(state.columns, { title: it.name, detail: index == state.selected.c ? '✓' : '', run: 'setStatus', with: { to: index } }) : state.propKind == 'priority' ? map(state.priorities, { title: t('priority.' + index), detail: index == (computed.card.priority ?? 0) ? '✓' : '', run: 'setPriority', with: { p: index } }) : map(state.members, { title: it.name, detail: it.who == computed.card.who ? '✓' : it.who, run: 'setAssignee', with: { who: it.who } })}}"
	},

	"styles": {
		"caption": { "type": "label", "font": "small", "textColor": "@color.muted", "fitText": true },
		"badge": { "type": "label", "font": "small", "align": "center" },
		"cardChip": { "type": "label", "font": "small", "fitText": true, "padding": 6, "height": 22, "radius": "@radius.chip", "borderWidth": 1,
			"borderColor": "@color.border", "color": "transparent", "textColor": "@color.muted" },
		"chip": {
			"style": "badge",
			"width": 84,
			"height": 32,
			"radius": "@radius.chip",
			"color": "@color.surface",
			"hover": { "color": "@color.chipHover" },
			"textColor": "@color.text",
			"cursor": "hand"
		},
		"chipOn": { "style": "chip", "color": "@color.chipOn", "hover": { "color": "@color.chipOn" }, "textColor": "@color.chipOnText" },
		"topButton": {
			"type": "label",
			"font": "small",
			"height": 32,
			"radius": "@radius.chip",
			"padding": 10,
			"fitText": true,
			"color": "transparent",
			"hover": { "color": "@color.topLine" },
			"textColor": "@color.topText",
			"cursor": "hand"
		},
		"detailButton": {
			"type": "label",
			"font": "small",
			"height": 30,
			"radius": "@radius.chip",
			"padding": 12,
			"fitText": true,
			"borderWidth": 1,
			"borderColor": "@color.border",
			"color": "@color.surface",
			"hover": { "color": "@color.chipHover" },
			"textColor": "@color.text",
			"cursor": "hand"
		}
	},

	"components": {
	},

	"menus": {
		"card": {
			"edit": { "run": "editCard", "group": "1_edit" },
			"left": { "run": "moveLeft", "group": "2_move", "order": 1 },
			"right": { "run": "moveRight", "group": "2_move", "order": 2 },
			"delete": { "run": "deleteCard", "group": "3_delete" }
		}
	},

	"actions": {
		"addCard": [
			{ "if": "{{length(trim(state.newCard)) == 0}}", "then": [{ "stop": true }] },
			{ "run": "remember" },
			{
				"push": "state.columns[0].cards",
				"value": {
					"ref": "FLO-{{state.nextRef}}",
					"priority": 0,
					"title": "{{trim(state.newCard)}}",
					"tag": "{{state.filter == 'all' ? 'feature' : state.filter}}",
					"who": "RS",
					"points": 1
				}
			},
			{ "run": "notify", "with": { "message": "{{t('toast.added', { title: trim(state.newCard), column: state.columns[0].name })}}" } },
			{ "run": "logActivity", "with": { "key": "added", "title": "{{trim(state.newCard)}}", "column": "" } },
			{ "set": "state.nextRef", "to": "{{state.nextRef + 1}}" },
			{ "set": "state.newCard", "to": "" }
		],
		"moveCard": [
			{ "note": "with: from (column), at (card index), to (column)" },
			{ "if": "{{from == to || to < 0 || to > computed.lastColumn}}", "then": [{ "stop": true }] },
			{ "run": "remember" },
			{ "push": "state.columns[to].cards", "value": "{{state.columns[from].cards[at]}}" },
			{ "remove": "state.columns[from].cards", "at": "{{at}}" },
			{ "set": "state.selected", "to": { "c": "{{to}}", "i": "{{length(state.columns[to].cards) - 1}}" } },
			{ "run": "logActivity", "with": { "key": "moved", "title": "{{state.columns[to].cards[length(state.columns[to].cards) - 1].title}}", "column": "{{state.columns[to].name}}" } },
			{ "run": "checkLimit", "with": { "c": "{{to}}" } }
		],
		"notify": [
			{ "note": "with: message. A toast in the corner for a few seconds" },
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}" } },
			{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
		],
		"selectCard": [
			{ "note": "with: c (column), i (card index)" },
			{ "if": "{{state.selected != null && state.selected.c == c && state.selected.i == i}}", "then": [{ "stop": true }] },
			{ "set": "state.selected", "to": { "c": "{{c}}", "i": "{{i}}" } },
			{ "set": "state.draft", "to": { "editing": false, "notes": "" } },
			{ "set": "state.dueOpen", "to": false },
			{ "run": "announcePresence" }
		],
		"openCardMenu": [
			{ "note": "with: c, i; at the pointer" },
			{ "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } },
			{ "set": "state.menuAt", "to": { "x": "{{event.x}}", "y": "{{event.y}}" } },
			{ "set": "state.cardMenu", "to": true }
		],
		"goToCard": [
			{ "note": "with: item, a quick pick row" },
			{ "set": "state.view", "to": "board" },
			{ "set": "state.filter", "to": "all" },
			{ "set": "state.owner", "to": "" },
			{ "run": "selectCard", "with": { "c": "{{item.c}}", "i": "{{item.at}}" } }
		],
		"openRow": [
			{ "note": "A table row chosen: its id is 'column-index'" },
			{ "run": "selectCard", "with": { "c": "{{number(split(event.id ?? event.value, '-')[0])}}", "i": "{{number(split(event.id ?? event.value, '-')[1])}}" } }
		],
		"switchBoard": [
			{ "note": "A board tab chosen: keeps this board's columns and brings the other's in" },
			{ "if": "{{event.value == state.boardId}}", "then": [{ "stop": true }] },
			{ "set": "state.stash[state.boardId]", "to": "{{state.columns}}" },
			{ "set": "state.columns", "to": "{{state.stash[event.value]}}" },
			{ "set": "state.boardId", "to": "{{event.value}}" },
			{ "set": "state.board", "to": "{{find(state.boards, it.id == event.value).label}}" },
			{ "set": "state.selected", "to": null },
			{ "set": "state.undoStack", "to": [], "note": "undo keeps one board's columns" }
		],
		"saveCard": [
			{ "if": "{{computed.card == null || length(trim(state.edit.title)) == 0}}", "then": [{ "stop": true }] },
			{ "run": "remember" },
			{ "set": "state.columns[state.selected.c].cards[state.selected.i].title", "to": "{{trim(state.edit.title)}}" },
			{ "set": "state.edit.open", "to": false },
			{ "run": "notify", "with": { "message": "{{t('toast.renamed')}}" } },
			{ "run": "logActivity", "with": { "key": "renamed", "title": "{{trim(state.edit.title)}}", "column": "" } }
		],
		"closeEdit": [{ "set": "state.edit.open", "to": false }],
		"moveSelected": [
			{ "note": "with: by, -1 or 1" },
			{ "run": "moveCard", "with": { "from": "{{state.selected.c}}", "at": "{{state.selected.i}}", "to": "{{state.selected.c + by}}" } }
		],
		"openPropPick": [
			{ "note": "with: kind, 'status', 'priority' or 'assignee': a picker over the selected card's property" },
			{ "set": "state.propKind", "to": "{{kind}}" },
			{ "set": "state.propPick", "to": { "open": true, "query": "", "index": 0, "top": 0 } }
		],
		"selectNext": { "title": "Select the next card", "category": "Go", "icon": "arrow-down", "enablement": "{{computed.next != null}}",
			"do": [{ "run": "selectCard", "with": { "c": "{{computed.next.c}}", "i": "{{computed.next.at}}" } }] },
		"selectPrev": { "title": "Select the previous card", "category": "Go", "icon": "arrow-up", "enablement": "{{computed.prev != null}}",
			"do": [{ "run": "selectCard", "with": { "c": "{{computed.prev.c}}", "i": "{{computed.prev.at}}" } }] },
		"changeStatus": { "title": "Change status…", "category": "Card", "icon": "circle-dashed", "enablement": "{{computed.card != null}}",
			"do": [{ "run": "openPropPick", "with": { "kind": "status" } }] },
		"changePriority": { "title": "Change priority…", "category": "Card", "icon": "signal-high", "enablement": "{{computed.card != null}}",
			"do": [{ "run": "openPropPick", "with": { "kind": "priority" } }] },
		"changeAssignee": { "title": "Assign to…", "category": "Card", "icon": "user", "enablement": "{{computed.card != null}}",
			"do": [{ "run": "openPropPick", "with": { "kind": "assignee" } }] },
		"assignToMe": { "title": "Assign to me", "category": "Card", "icon": "user-check", "enablement": "{{computed.card != null}}",
			"do": [{ "run": "setAssignee", "with": { "who": "{{state.me}}" } }] },
		"newCardCommand": { "title": "New card", "category": "Card", "icon": "plus", "do": [{ "focus": "#newCard" }] },
		"goToCardCommand": { "title": "Go to card…", "category": "Go", "icon": "search",
			"do": [{ "set": "state.quickPick.query", "to": "" }, { "set": "state.quickPick.open", "to": true }] },
		"commandPalette": { "title": "Show all commands", "category": "Go", "icon": "command",
			"do": [{ "set": "state.quickPick.query", "to": ">" }, { "set": "state.quickPick.open", "to": true }] },
		"editCard": { "title": "Edit card…", "category": "Card", "icon": "pencil", "enablement": "{{computed.card != null}}",
			"do": [{ "set": "state.edit", "to": { "open": true, "title": "{{computed.card.title}}" } }] },
		"deleteCard": { "title": "Delete card", "category": "Card", "icon": "trash-2", "enablement": "{{computed.card != null}}",
			"do": [
				{ "run": "remember" },
				{ "run": "notify", "with": { "message": "{{t('toast.deleted', { title: computed.card.title })}}" } },
				{ "run": "logActivity", "with": { "key": "deleted", "title": "{{computed.card.title}}", "column": "" } },
				{ "remove": "state.columns[state.selected.c].cards", "at": "{{state.selected.i}}" },
				{ "set": "state.selected", "to": null }
			] },
		"moveRight": { "title": "Move card right", "category": "Card", "icon": "arrow-right",
			"enablement": "{{computed.card != null && state.selected.c < computed.lastColumn}}",
			"do": [{ "run": "moveSelected", "with": { "by": 1 } }] },
		"moveLeft": { "title": "Move card left", "category": "Card", "icon": "arrow-left",
			"enablement": "{{computed.card != null && state.selected.c > 0}}",
			"do": [{ "run": "moveSelected", "with": { "by": -1 } }] },
		"showBoard": { "title": "Show the board", "category": "View", "icon": "kanban", "do": [{ "set": "state.view", "to": "board" }] },
		"showList": { "title": "Show the list", "category": "View", "icon": "layout-list", "do": [{ "set": "state.view", "to": "list" }] },
		"showTable": { "title": "Show the table", "category": "View", "icon": "table", "do": [{ "set": "state.view", "to": "table" }] },
		"toggleTheme": { "title": "Switch light and dark", "category": "View", "icon": "moon",
			"do": [{ "set": "state.theme", "to": "{{state.theme == 'light' ? 'dark' : 'light'}}" }] },
		"togglePeek": { "title": "Show or hide the side panel", "category": "View", "icon": "panel-right", "do": [{ "toggle": "state.peek" }] },
		"clearFilters": { "title": "Clear the filters", "category": "View",
			"do": [{ "set": "state.filter", "to": "all" }, { "set": "state.owner", "to": "" }, { "set": "state.query", "to": "" }] }
	},

	"keys": {
		"mod+n": "newCardCommand",
		"mod+p": "goToCardCommand",
		"mod+shift+p": "commandPalette",
		"mod+k": "commandPalette",
		"c": { "when": "{{!context.textInputFocus}}", "do": "newCardCommand" },
		"j": { "when": "{{!context.textInputFocus}}", "do": "selectNext" },
		"k": { "when": "{{!context.textInputFocus}}", "do": "selectPrev" },
		"s": { "when": "{{!context.textInputFocus}}", "do": "changeStatus" },
		"p": { "when": "{{!context.textInputFocus}}", "do": "changePriority" },
		"a": { "when": "{{!context.textInputFocus}}", "do": "changeAssignee" },
		"i": { "when": "{{!context.textInputFocus}}", "do": "assignToMe" },
		"slash": { "when": "{{!context.textInputFocus}}", "do": "focusSearch" },
		"mod+e": "editCard",
		"mod+j": "toggleTheme",
		"mod+right": "moveRight",
		"mod+left": "moveLeft",
		"mod+enter": "openIssue",
		"escape": [{ "when": "{{state.issueOpen}}", "do": "closeIssue" }, { "do": "clearFilters" }]
	},

	"root": {
		"id": "panel-root",
		"color": "@color.sidebar",
		"children": [
			{
				"id": "topBar",
				"dir": "auto",
				"anchors": { "left": 228, "right": 8, "top": 8 },
				"height": 48,
				"radius": { "topLeft": 8, "topRight": 8 },
				"color": "@color.topBar",
				"children": [
					{
						"id": "logo",
						"type": "label",
						"text": "  Flow",
						"icon": "box",
						"textColor": "@color.topText",
						"anchors": { "left": 16, "top": 0, "bottom": 0 },
						"width": 100,
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{ "id": "panel-top-bar", "anchors": { "left": 216, "top": 16, "bottom": 16 }, "width": 1, "color": "@color.topLine" },
					{
						"id": "boardTabs",
						"type": "tabs",
						"anchors": { "left": 228, "top": 10 },
						"width": 300,
						"height": 28,
						"tabs": "{{state.boards}}",
						"value": "{{state.boardId}}",
						"textColor": "@color.topMuted",
						"activeTextColor": "@color.topText",
						"activeBackground": "@color.topLine",
						"color": "transparent",
						"accentColor": "@color.accent",
						"onChange": "switchBoard"
					},
					{
						"id": "search",
						"type": "textarea",
						"anchors": { "left": 544, "right": 308, "top": 10 },
						"height": 28,
						"padding": 10,
						"radius": "@radius.chip",
						"color": "@color.topLine",
						"focused": { "color": "@color.topLine", "borderColor": "@color.accent" },
						"borderWidth": 1,
						"borderColor": "@color.topLine",
						"textColor": "@color.topText",
						"placeholder": "{{t('search.placeholder')}}",
						"placeholderColor": "@color.topMuted",
						"label": "{{t('search.label')}}",
						"bind": "state.query",
						"keys": { "escape": [{ "set": "state.query", "to": "" }] }
					},
					{ "id": "languageButton", "style": "topButton", "text": "{{upper(settings.appearance.language)}}", "anchors": { "right": 264, "top": 8 }, "focusable": true, "role": "button",
						"tooltip": "{{t('locale.tooltip')}}", "label": "{{t('locale.tooltip')}}", "onClick": "changeLanguage" },
					{ "id": "settingsButton", "style": "topButton", "text": "", "icon": "settings", "anchors": { "right": 220, "top": 8 }, "focusable": true, "role": "button",
						"isOpen": "{{state.settingsOpen}}", "tooltip": "{{t('settings.title')}} (Cmd+,)", "label": "{{t('settings.title')}}", "onClick": "openSettings" },
					{
						"id": "themeToggle",
						"style": "topButton",
						"text": "",
						"icon": "{{state.theme == 'light' ? 'moon' : 'sun'}}",
						"anchors": { "right": 176, "top": 8 },
						"focusable": true,
						"role": "button",
						"label": "{{t('theme.tooltip')}}",
						"tooltip": "{{t('theme.tooltip')}}",
						"onClick": "toggleTheme"
					},
					{
						"id": "members",
						"type": "row",
						"gap": 4,
						"anchors": { "right": 16, "top": 8 },
						"width": 140,
						"height": 32,
						"cursor": "hand",
						"focusable": true,
						"role": "button",
						"label": "{{t('members.label')}}. {{t('presence.here', { n: length(computed.present) })}}",
						"tooltip": "{{t('presence.here', { n: length(computed.present) })}}",
						"isOpen": "{{state.membersOpen}}",
						"keys": { "enter": { "toggle": "state.membersOpen" }, "space": { "toggle": "state.membersOpen" } },
						"onClick": { "toggle": "state.membersOpen" },
						"children": [
							{
								"id": "memberMenu",
								"overlay": { "placement": "below-end", "open": "state.membersOpen", "dismiss": "outside" },
								"y": 8,
								"width": 240,
								"height": "{{length(state.members) * 40 + 56}}",
								"radius": "@radius.card",
								"shadow": { "y": 6, "blur": 16, "color": "#0000002e" },
								"color": "@color.menu",
								"children": [
									{ "id": "label-show-the-cards", "style": "caption", "text": "{{t('members.title')}}", "anchors": { "left": 16, "top": 12 } },
									{
										"id": "column-member-menu",
										"type": "column",
										"anchors": { "left": 8, "right": 8, "top": 36 },
										"height": "{{length(state.members) * 40 + 12}}",
										"children": [
											{
												"id": "panel-member",
												"repeat": { "for": "member", "in": "state.members" },
												"anchors": { "left": 0, "right": 0 },
												"height": 40,
												"radius": "@radius.chip",
												"color": "{{state.owner == member.who ? '@color.accentSoft' : '@color.menu'}}",
												"hover": { "color": "@color.chipHover" },
												"focusable": true,
												"role": "menuitemradio",
												"selected": "{{state.owner == member.who}}",
												"label": "{{member.name}}",
												"onClick": [
													{ "set": "state.owner", "to": "{{state.owner == member.who ? '' : member.who}}" },
													{ "set": "state.membersOpen", "to": false }
												],
												"children": [
													{ "id": "label-member-who", "style": "badge", "text": "{{member.who}}", "anchors": { "left": 8, "top": 6 }, "width": 28, "height": 28, "radius": 999, "color": "{{member.color}}", "textColor": "#ffffff" },
													{ "id": "label-member-name", "type": "label", "text": "{{member.name}}", "textColor": "@color.text", "anchors": { "left": 46, "top": 0, "bottom": 0 }, "width": 150, "align": { "horizontal": "start", "vertical": "center" } }
												]
											}
										]
									}
								]
							},
							{
								"id": "member",
								"repeat": { "for": "member", "in": "state.members" },
								"style": "badge",
								"text": "{{member.who}}",
								"width": 32,
								"height": 32,
								"radius": 999,
								"color": "{{member.color}}",
								"textColor": "#ffffff",
								"borderWidth": "{{contains(computed.present, member.who) ? 2 : 0}}",
								"borderColor": "@color.topText"
							}
						]
					}
				]
			},
			{
				"id": "toolbar",
				"dir": "auto",
				"anchors": { "left": 228, "right": 8, "top": "#topBar.bottom" },
				"height": 44,
				"color": "@color.surface",
				"children": [
					{
						"id": "filters",
						"type": "row",
						"gap": 4,
						"anchors": { "left": 12, "top": 6, "right": 560 },
						"height": 32,
						"role": "radiogroup",
						"arrows": "horizontal",
						"children": [
							{
								"id": "filter",
								"repeat": { "for": "tag", "in": "state.filters" },
								"style": "{{tag == state.filter ? 'chipOn' : 'chip'}}",
								"width": "{{window.width < 1200 ? (tag == 'all' ? 52 : 40) : (tag == 'all' ? 76 : 84)}}",
								"height": 28,
								"text": "{{tag == 'all' ? (window.width < 1200 ? '' : t('filter.all')) : (window.width < 1200 ? '' : ' ' + t('tag.' + tag))}}",
								"icon": "{{tag == 'all' ? (window.width < 1200 ? 'layers-2' : '') : state.tagIcons[tag]}}",
								"focusable": true,
								"role": "radio",
								"selected": "{{tag == state.filter}}",
								"label": "{{tag == 'all' ? t('filter.all') : t('tag.' + tag)}}",
								"tooltip": "{{window.width < 1200 ? (tag == 'all' ? t('filter.all') : t('tag.' + tag)) : ''}}",
								"onClick": { "set": "state.filter", "to": "{{tag}}" }
							}
						]
					},
					{
						"id": "views",
						"type": "row",
						"gap": 4,
						"anchors": { "right": 356, "top": 4 },
						"width": 186,
						"height": 32,
						"role": "toolbar",
						"arrows": "horizontal",
						"children": [
							{ "id": "viewBoard", "style": "{{state.view == 'board' ? 'chipOn' : 'chip'}}", "width": 34, "text": "", "icon": "kanban", "onClick": "showBoard",
								"focusable": true, "role": "radio", "selected": "{{state.view == 'board'}}", "label": "{{trim(t('view.board'))}}", "tooltip": "{{trim(t('view.board'))}}" },
							{ "id": "viewList", "style": "{{state.view == 'list' ? 'chipOn' : 'chip'}}", "width": 34, "text": "", "icon": "layout-list", "onClick": "showList",
								"focusable": true, "role": "radio", "selected": "{{state.view == 'list'}}", "label": "{{trim(t('view.list'))}}", "tooltip": "{{trim(t('view.list'))}}" },
							{ "id": "viewTable", "style": "{{state.view == 'table' ? 'chipOn' : 'chip'}}", "width": 34, "text": "", "icon": "table", "onClick": "showTable",
								"focusable": true, "role": "radio", "selected": "{{state.view == 'table'}}", "label": "{{trim(t('view.table'))}}", "tooltip": "{{trim(t('view.table'))}}" },
							{ "id": "viewTimeline", "style": "{{state.view == 'timeline' ? 'chipOn' : 'chip'}}", "width": 34, "text": "", "icon": "chart-gantt", "onClick": "showTimeline",
								"focusable": true, "role": "radio", "selected": "{{state.view == 'timeline'}}", "label": "{{trim(t('view.timeline'))}}", "tooltip": "{{trim(t('view.timeline'))}}" },
							{ "id": "viewLanes", "style": "{{state.swimlanes ? 'chipOn' : 'chip'}}", "width": 34, "text": "", "icon": "rows-2", "onClick": "toggleSwimlanes",
								"when": "{{state.view == 'board'}}", "focusable": true, "role": "switch", "selected": "{{state.swimlanes}}", "label": "{{t('view.lanes')}}", "tooltip": "{{t('view.lanes')}}" }
						]
					},
					{
						"id": "newCard",
						"type": "textarea",
						"anchors": { "right": 0, "top": 4 },
						"width": 340,
						"height": 32,
						"padding": 10,
						"radius": "@radius.chip",
						"color": "@color.input",
						"focused": { "color": "@color.inputFocused" },
						"textColor": "@color.text",
						"placeholder": "{{t('newCard.placeholder')}}",
						"label": "{{t('newCard.placeholder')}}",
						"placeholderColor": "@color.muted",
						"bind": "state.newCard",
						"onSubmit": "addCard"
					}
				]
			},
			{
				"id": "main",
				"dir": "auto",
				"type": "split",
				"anchors": { "left": 228, "right": 8, "top": "#toolbar.bottom", "bottom": "#statusBar.top" },
				"color": "@color.surface",
				"bind": "state.sizes",
				"minSize": 280,
				"sashSize": 6,
				"sashColor": "transparent",
				"sashActiveColor": "@color.accent",
				"children": [
					{
						"id": "content",
						"color": "transparent",
						"children": [
							{
								"id": "lanesView",
								"use": "swimlanes",
								"when": "{{state.view == 'board' && state.swimlanes}}",
								"fill": true
							},
							{ "id": "listView", "use": "listView", "when": "{{state.view == 'list'}}", "fill": 6 },
							{
								"id": "timelineView",
								"use": "timelineView",
								"when": "{{state.view == 'timeline'}}",
								"fill": 6
							},
							{
								"id": "board",
								"type": "row",
								"when": "{{state.view == 'board' && !state.swimlanes}}",
								"fill": true,
								"children": [
									{
										"id": "column",
										"repeat": { "for": "column", "in": "state.columns", "index": "c" },
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"color": "transparent",
										"onDrop": { "run": "moveCard", "with": { "from": "{{event.data.from}}", "at": "{{event.data.at}}", "to": "{{c}}" } },
										"children": [
											{
												"id": "columnBody",
												"fill": 4,
												"radius": "@radius.card",
												"color": "@color.column",
												"children": [
													{ "id": "columnStatus", "type": "label", "icon": "{{state.statusIcons[c] ?? 'circle'}}", "text": "", "textColor": "{{column.color}}", "fitText": false, "width": 18,
														"anchors": { "left": 10, "top": 0 }, "height": 40, "align": "center" },
													{ "id": "columnTitle", "type": "row", "gap": 8, "alignItems": "center", "anchors": { "left": 36, "right": 44, "top": 0 }, "height": 40, "children": [
														{ "id": "columnName", "type": "label", "font": "small", "text": "{{column.name}}", "textColor": "@color.text", "fitText": true, "height": 40,
															"align": { "horizontal": "start", "vertical": "center" } },
														{ "id": "columnCount", "type": "label", "font": "small", "text": "{{length(column.cards)}}", "fitText": true, "height": 40,
															"align": { "horizontal": "start", "vertical": "center" }, "textColor": "{{computed.over[c] ? '@bug' : '@color.muted'}}",
															"label": "{{computed.over[c] ? t('column.over', { name: column.name, count: length(column.cards), limit: column.limit }) : length(column.cards)}}" },
														{ "id": "columnLimit", "style": "caption", "when": "{{column.limit != null}}", "text": "{{t('column.limit', { limit: column.limit })}}", "height": 40,
															"align": { "horizontal": "start", "vertical": "center" }, "textColor": "{{computed.over[c] ? '@bug' : '@color.muted'}}" }
													] },
													{ "id": "columnAdd", "type": "label", "icon": "plus", "text": "", "fitText": false, "textColor": "@color.muted", "width": 26, "height": 26, "radius": "@radius.chip",
														"align": "center", "anchors": { "right": 8, "top": 7 }, "hover": { "color": "@color.chipHover" }, "cursor": "hand", "when": "{{c == 0}}",
														"tooltip": "{{t('newCard.placeholder')}}", "onClick": { "focus": "#newCard" } },
													{
														"id": "cards",
														"type": "stack",
														"anchors": { "left": 6, "right": 6, "top": 40, "bottom": 6 },
														"gap": 6,
														"scroll": "vertical",
														"children": [
															{
																"id": "card",
																"repeat": { "for": "card", "in": "column.cards", "index": "i" },
																"when": "{{(state.filter == 'all' || card.tag == state.filter) && (state.owner == '' || card.who == state.owner) && (state.query == '' || fuzzy(state.query, card.title) != null)}}",
																"anchors": { "left": 0, "right": 0 },
																"height": 96,
																"radius": "@radius.card",
																"color": "@color.card",
																"borderWidth": 1,
																"borderColor": "{{state.selected != null && state.selected.c == c && state.selected.i == i ? '@color.accent' : '@color.border'}}",
																"shadow": { "y": 1, "blur": 2, "color": "#0000000f" },
																"hover": { "borderColor": "{{state.selected != null && state.selected.c == c && state.selected.i == i ? '@color.accent' : '@color.muted'}}" },
																"cursor": "hand",
																"focusable": true,
																"role": "button",
																"label": "{{t('card.label', { title: card.title, tag: t('tag.' + card.tag), who: find(state.members, it.who == card.who).name ?? card.who, column: column.name })}}",
																"onFocus": { "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } },
																"keys": { "enter": "editCard", "space": "togglePeek", "shift+f10": { "run": "openCardMenu", "with": { "c": "{{c}}", "i": "{{i}}" } } },
																"drag": { "data": { "from": "{{c}}", "at": "{{i}}" } },
																"dragging": { "color": "@color.column", "borderColor": "@color.border", "shadow": { "y": 0, "blur": 0, "color": "#00000000" } },
																"onClick": { "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } },
																"onDoubleClick": [{ "run": "selectCard", "with": { "c": "{{c}}", "i": "{{i}}" } }, { "run": "openIssue" }],
																"onContextMenu": { "run": "openCardMenu", "with": { "c": "{{c}}", "i": "{{i}}" } },
																"children": [
																	{ "id": "cardRef", "type": "label", "font": "small", "text": "{{card.ref ?? ''}}", "textColor": "@color.muted", "fitText": true, "anchors": { "left": 12, "top": 10 } },
																	{ "id": "cardOwner", "style": "badge", "text": "{{card.who}}", "width": 20, "height": 20, "radius": 999, "anchors": { "right": 10, "top": 8 },
																		"color": "{{find(state.members, it.who == card.who).color ?? '@color.muted'}}", "textColor": "#ffffff",
																		"tooltip": "{{find(state.members, it.who == card.who).name ?? card.who}}" },
																	{ "id": "cardTitle", "type": "label", "text": "{{card.title}}", "textColor": "{{c == computed.lastColumn ? '@color.muted' : '@color.text'}}",
																		"anchors": { "left": 12, "right": 12, "top": 30 }, "height": 34, "wrap": true, "align": { "horizontal": "start", "vertical": "start" } },
																	{ "id": "cardChips", "type": "row", "gap": 4, "alignItems": "center", "anchors": { "left": 10, "right": 10, "bottom": 9 }, "height": 22, "children": [
																		{ "id": "cardPriority", "style": "cardChip", "icon": "{{state.priorities[card.priority ?? 0]}}", "text": "", "width": 22, "fitText": false, "align": "center",
																			"textColor": "{{card.priority == 1 ? '@bug' : '@color.muted'}}", "tooltip": "{{t('priority.' + (card.priority ?? 0))}}" },
																		{ "id": "cardTag", "style": "cardChip", "runs": [{ "icon": "circle", "color": "@{{card.tag}}" }, "  {{t('tag.' + card.tag)}}"], "tooltip": "{{t('tag.' + card.tag)}}" },
																		{ "id": "cardDue", "style": "cardChip", "when": "{{card.due != null}}", "icon": "calendar", "text": "{{formatDate(dateMs(card.due), 'short', 'utc')}}",
																			"tooltip": "{{formatDate(dateMs(card.due), 'medium', 'utc')}}",
																			"textColor": "{{daysBetween(state.today, card.due) < 0 && c != computed.lastColumn ? '@bug' : '@color.muted'}}" },
																		{ "id": "cardNotes", "style": "cardChip", "when": "{{card.notes != null}}", "icon": "message-square", "text": "", "width": 22, "fitText": false, "align": "center" },
																		{ "id": "cardPoints", "style": "cardChip", "icon": "triangle", "text": "{{card.points}}", "tooltip": "{{t('card.points', { n: card.points })}}" }
																	] }
																]
															}
														]
													}
												]
											}
										]
									}
								]
							},
							{
								"id": "cardTable",
								"type": "table",
								"when": "{{state.view == 'table'}}",
								"fill": 6,
								"radius": "@radius.card",
								"color": "@color.surface",
								"rowHeight": 32,
								"items": "{{computed.rows}}",
								"value": "{{state.selected == null ? null : state.selected.c + '-' + state.selected.i}}",
								"sort": "{{state.tableSort}}",
								"columns": "{{computed.tableColumns}}",
								"textColor": "@color.text",
								"selectedTextColor": "@color.text",
								"selectedBackground": "@color.accentSoft",
								"accentColor": "@color.accent",
								"onChange": "openRow",
								"keys": { "space": "togglePeek" },
								"onOpen": [{ "run": "openRow" }, { "run": "editCard" }],
								"onSort": { "set": "state.tableSort", "to": { "column": "{{event.column}}", "descending": "{{event.descending}}" } },
								"onColumnResize": { "set": "state.columnWidths[event.column]", "to": "{{event.width}}" }
							}
						]
					},
					{
						"id": "details",
						"when": "{{state.peek}}",
						"color": "transparent",
						"children": [
							{
								"id": "detailBody",
								"fill": 6,
								"radius": "@radius.card",
								"color": "@color.surface",
								"children": [
									{ "id": "chartTitle", "when": "{{computed.card == null}}", "style": "caption", "text": "{{t('chart.title')}}", "icon": "bar-chart-3", "anchors": { "left": 20, "top": 18 } },
									{ "id": "chart", "when": "{{computed.card == null}}", "use": "barChart", "with": { "values": "{{computed.counts}}", "color": "@color.accent", "gap": 0.4 },
										"anchors": { "left": 20, "right": 20, "top": 44 }, "height": 96 },
									{
										"id": "chartLabels", "when": "{{computed.card == null}}",
										"type": "row",
										"anchors": { "left": 20, "right": 20, "top": 146 },
										"height": 32,
										"children": [
											{
												"id": "chartLabel",
												"repeat": { "for": "column", "in": "state.columns" },
												"type": "label",
												"grow": 1,
												"anchors": { "top": 0, "bottom": 0 },
												"font": "small",
												"align": { "horizontal": "center", "vertical": "start" },
												"textColor": "@color.muted",
												"text": "{{column.name}}: {{length(column.cards)}}"
											}
										]
									},
									{ "id": "detailLine", "when": "{{computed.card == null}}", "anchors": { "left": 20, "right": 20, "top": 186 }, "height": 1, "color": "@color.border" },
									{
										"id": "noCard",
										"when": "{{computed.card == null}}",
										"type": "label",
										"anchors": { "left": 20, "right": 20, "top": 206 },
										"height": 60,
										"wrap": true,
										"textColor": "@color.muted",
										"runs": ["{{t('noCard.select')}}", { "text": "{{t('noCard.rightClick')}}", "bold": true }, "{{t('noCard.menu')}}", { "text": "Cmd+P", "bold": true }, "{{t('noCard.goTo')}}"]
									},
									{ "id": "insightsPanel", "use": "insights", "when": "{{computed.card == null}}", "anchors": { "left": 20, "right": 20, "top": 276, "bottom": 16 } },
									{ "id": "drawer", "use": "cardDrawer", "when": "{{computed.card != null}}", "anchors": { "left": 8, "right": 8, "top": 18, "bottom": 16 } }
								]
							}
						]
					}
				]
			},
			{
				"id": "statusBar",
				"use": "statusBar",
				"anchors": { "left": 228, "right": 8, "bottom": 8 },
				"radius": { "bottomLeft": 8, "bottomRight": 8 },
				"with": { "height": 32, "color": "@color.surface", "textColor": "@color.muted", "highlight": "@color.chipHover", "items": [
					{ "text": "{{t('status.revision', { number: revision.number, author: revision.author, message: revision.message })}}" },
					{ "text": "{{window.width}} × {{window.height}}", "side": "end" }
				] }
			},
			{
				"id": "issuePage",
				"use": "issuePage",
				"when": "{{state.issueOpen && computed.card != null}}",
				"anchors": { "left": 228, "right": 8, "top": 8, "bottom": "#statusBar.top" },
				"radius": { "topLeft": 8, "topRight": 8 }
			},
			{
				"id": "cardMenu",
				"use": "contextMenu",
				"with": {
					"open": "state.cardMenu",
					"items": "{{menus.card}}",
					"x": "{{min(state.menuAt.x, window.width - 228)}}",
					"y": "{{state.menuAt.y}}",
					"width": 220,
					"color": "@color.menu",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"highlight": "@color.accentSoft"
				}
			},
			{
				"id": "editDialog",
				"use": "dialog",
				"with": {
					"open": "state.edit.open",
					"title": "{{t('edit.title')}}",
					"message": "{{t('edit.message')}}",
					"width": 440,
					"height": 180,
					"color": "@color.menu",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"highlight": "@color.accent",
					"backdrop": "@color.backdrop",
					"buttons": [{ "title": "{{t('detail.save')}}", "run": "saveCard" }, { "title": "{{t('detail.cancel')}}", "run": "closeEdit" }]
				},
				"children": [
					{
						"id": "editTitle",
						"type": "textarea",
						"anchors": { "left": 20, "right": 20, "top": 76 },
						"height": 34,
						"padding": 10,
						"radius": "@radius.chip",
						"borderWidth": 1,
						"borderColor": "@color.border",
						"color": "@color.input",
						"focused": { "borderColor": "@color.accent" },
						"textColor": "@color.text",
						"autofocus": true,
						"label": "{{t('edit.title')}}",
						"bind": "state.edit.title",
						"onSubmit": "saveCard"
					}
				]
			},
			{ "id": "settings", "use": "settingsSheet" },
			{
				"id": "toast",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"color": "@color.chipOn",
					"textColor": "@color.chipOnText",
					"accent": "@color.accent"
				}
			},
			{
				"id": "quickPick",
				"use": "quickPick",
				"with": {
					"color": "@color.menu",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"accent": "@color.accent",
					"highlight": "@color.accentSoft",
					"field": "@color.field",
					"providers": [
						{ "items": "{{computed.picks}}", "run": "goToCard", "placeholder": "{{t('quick.cards')}}" },
						{ "prefix": ">", "items": "{{computed.palette}}", "placeholder": "{{t('quick.commands')}}" }
					]
				}
			},
			{
				"id": "propPick",
				"use": "quickPick",
				"with": {
					"name": "propPick",
					"width": 360,
					"recentLimit": 0,
					"color": "@color.menu",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"accent": "@color.accent",
					"highlight": "@color.accentSoft",
					"field": "@color.field",
					"providers": [{ "items": "{{computed.propItems}}", "placeholder": "{{t('quick.' + (state.propKind ?? 'status'))}}" }]
				}
			},
			{ "id": "sidebar", "use": "sidebar" }
		]
	}
}
