{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Tempo: a music player laid out like the desktop streaming apps people use every day. A top bar with back, forward, home and search; Your Library on the left (filters, search, sort, list, compact and grid views, pins; drag its edge to resize or collapse it); the main view (home, playlists, albums, artists, podcasts, search, lyrics) with a header in the cover's colour that turns into a bar as it scrolls; the Now Playing or queue panel on the right; the player bar at the bottom; full screen and a mini player. Track tables select with Cmd and Shift, sort by a column, reorder by dragging and open a menu on a right click. Light and dark themes, English, Italian and Arabic. Playback is simulated: no sound plays. Catalogue, art and names are invented.",

	"include": ["strings.json", "catalog.json", "panels.json", "pages.json"],

	"window": { "title": "Tempo", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600, "focusRing": { "color": "@text", "width": 2 } },

	"persist": ["state.theme", "state.settings", "state.volume", "state.lib", "state.right", "state.liked", "state.playlists", "state.saved", "state.following"],

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "fallback": ["icons", "arabic"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["iconsSmall", "arabicSmall"] },
		"bold": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 14, "bold": true, "fallback": ["icons", "arabicBold"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 16, "bold": true, "fallback": ["icons", "arabicTitle"] },
		"h2": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 24, "bold": true, "fallback": ["arabicH2"] },
		"hero": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 72, "bold": true, "fallback": ["arabicHero"] },
		"heroSmall": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 44, "bold": true, "fallback": ["arabicHero"] },
		"heroMid": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 32, "bold": true, "fallback": ["arabicHero"] },
		"lyric": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 28, "bold": true, "fallback": ["arabicH2"] },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 16 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 12 },
		"iconsLarge": { "file": "../shared/fonts/Lucide.ttf", "size": 22 },
		"arabic": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 14 },
		"arabicSmall": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 12 },
		"arabicBold": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 14, "bold": true },
		"arabicTitle": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 16, "bold": true },
		"arabicH2": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 24, "bold": true },
		"arabicHero": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 44, "bold": true }
	},

	"theme": "{{state.theme}}",

	"colors": {
		"window": { "dark": "#000000", "light": "#e4e4e9" },
		"panel": { "dark": "#121212", "light": "#ffffff" },
		"fade": { "dark": "#121212", "light": "#00000033" },
		"raised": { "dark": "#1f1f1f", "light": "#f0f0f3" },
		"raisedHover": { "dark": "#2a2a2a", "light": "#e6e6eb" },
		"card": { "dark": "#242424", "light": "#f3f3f6" },
		"rowHover": { "dark": "#ffffff1a", "light": "#0000000d" },
		"rowOn": { "dark": "#ffffff33", "light": "#0000001f" },
		"chip": { "dark": "#ffffff12", "light": "#0000000d" },
		"chipHover": { "dark": "#ffffff24", "light": "#0000001a" },
		"chipOn": { "dark": "#ffffff", "light": "#121212" },
		"onChip": { "dark": "#000000", "light": "#ffffff" },
		"text": { "dark": "#ffffff", "light": "#121212" },
		"muted": { "dark": "#b3b3b3", "light": "#5e5e66" },
		"faint": { "dark": "#4d4d4d", "light": "#c9c9cf" },
		"line": { "dark": "#ffffff1a", "light": "#0000001a" },
		"accent": { "dark": "#ff5c7a", "light": "#e0244b" },
		"accentHover": { "dark": "#ff7d94", "light": "#f03d62" },
		"onAccent": { "dark": "#000000", "light": "#ffffff" },
		"menu": { "dark": "#282828", "light": "#ffffff" }
	},

	"tokens": {
		"kit.surface": "@menu",
		"kit.text": "@text",
		"kit.dim": "@muted",
		"kit.selection": "@raisedHover",
		"kit.border": "@line",
		"kit.accent": "@accent",
		"kit.primary": "@accent",
		"kit.onPrimary": "@onAccent",
		"kit.field": "@raised",
		"kit.radius": 4
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#player)"],
		"reviewers": ["studio"],
		"budgets": [{"author": "agent", "added": 20, "removed": 5, "changed": 50}]
	},

	"settings": {
		"playback.crossfade": {
			"type": "integer",
			"minimum": 0,
			"maximum": 12,
			"default": 0,
			"title": "Crossfade",
			"description": "How many seconds the end of a song overlaps the start of the next; 0 for none."
		},
		"ui.language": {
			"type": "string",
			"enum": ["en", "it", "ar"],
			"default": "en",
			"title": "Language",
			"description": "English, Italian or Arabic (right to left)."
		}
	},

	"state": {
		"theme": "dark",
		"daypart": "evening",
		"view": { "page": "playlist", "i": 0 },
		"back": [{ "page": "home", "i": 0 }],
		"forward": [],
		"scroll": 0,
		"query": "",
		"ctx": { "kind": "playlist", "i": 0 },
		"plain": [0, 14, 1, 25, 15, 33, 26, 34, 2, 3, 101, 103, 39, 8],
		"list": [0, 14, 1, 25, 15, 33, 26, 34, 2, 3, 101, 103, 39, 8],
		"pos": 2,
		"track": 1,
		"upNext": [],
		"recent": ["playlist:0", "album:0", "artist:1", "liked:0", "playlist:6", "show:0"],
		"isPlaying": true,
		"elapsed": 84,
		"volume": 70,
		"muted": false,
		"shuffle": false,
		"repeat": "off",
		"right": "now",
		"rightScroll": 0,
		"full": false,
		"fullLyrics": false,
		"mini": false,
		"pinned": ["liked:0", "playlist:0"],
		"lib": { "width": 300, "collapsed": false, "filter": "", "sort": "recents", "view": "list", "searching": false, "query": "" },
		"sort": { "by": "", "desc": false },
		"sel": [],
		"selFrom": 0,
		"hov": "",
		"press": { "at": 0, "width": 1, "from": 0 },
		"menu": { "x": 0, "y": 0, "t": 0, "n": -1 },
		"open": { "ctx": false, "app": false, "sort": false, "user": false, "create": false, "keys": false },
		"shelf": {},
		"searchKind": "all",
		"homeKind": "all",
		"toast": "",
		"quickPick": { "open": false, "query": "" }
	},

	"stateTypes": {
		"theme": {"type": "string", "enum": ["dark", "light"]},
		"view": {"type": "object", "properties": {"page": {"type": "string", "enum": ["home", "playlist", "album", "artist", "liked", "show", "search", "genre", "lyrics"]}, "i": {"type": "number"}}},
		"repeat": {"type": "string", "enum": ["off", "all", "one"]},
		"right": {"type": "string", "enum": ["", "now", "queue"]},
		"volume": {"type": "number", "minimum": 0, "maximum": 100},
		"elapsed": {"type": "number"},
		"scroll": {"type": "number"}
	},

	"computed": {
		"rtl": "{{settings.ui.language == 'ar'}}",
		"libW": "{{state.lib.collapsed ? 72 : state.lib.width}}",
		"rightW": "{{state.right != '' ? 320 : 0}}",
		"mainW": "{{window.width - computed.libW - 24 - (state.right != '' ? 328 : 0)}}",
		"mainH": "{{window.height - 144}}",
		"cols": "{{max(2, floor((computed.mainW - 24) / 196))}}",
		"cardW": "{{floor((computed.mainW - 24) / computed.cols)}}",
		"cur": "{{state.tracks[state.track]}}",
		"curAlbum": "{{state.albums[computed.cur.al]}}",
		"curArtist": "{{state.artists[computed.cur.ar]}}",
		"elapsedText": "{{floor(state.elapsed / 60)}}:{{pad(floor(state.elapsed % 60), 2)}}",
		"ctxName": "{{state.ctx.kind == 'playlist' ? state.playlists[state.ctx.i].name : state.ctx.kind == 'album' ? state.albums[state.ctx.i].title : state.ctx.kind == 'artist' ? state.artists[state.ctx.i].name : t('liked')}}",
		"nextTracks": "{{concat(state.upNext, slice(state.list, state.pos + 1))}}",
		"liked": "{{contains(state.liked, state.track)}}",
		"lyrics": "{{state.lyrics[computed.cur.title] ?? []}}",
		"lyricAt": "{{count(computed.lyrics, it.at <= state.elapsed) - 1}}",
		"own": "{{filter(range(length(state.playlists)), state.playlists[it].owner == 'Robin')}}",
		"palette": "{{map(filter(commands, it.enabled), { title: it.title, detail: it.keyLabel || it.category, run: it.name })}}",
		"picks": "{{state.quickPick.open ? map(state.tracks, { title: it.title, detail: it.artist + ' · ' + it.album, track: index }) : []}}",
		"bars": "{{join(map(range(48), 'M ' + (index * 4 + 2) + ' 40 V ' + (40 - (state.isPlaying ? 4 + (index * index * 7 + state.elapsed * (index % 5 + 3)) % 34 : 2))), ' ')}}",
		"eq": "{{join(map(range(4), 'M ' + (2 + index * 4) + ' 16 V ' + (16 - (state.isPlaying ? 4 + (index * 5 + state.elapsed * (index + 2)) % 11 : 3))), ' ')}}"
	},

	"styles": {
		"text": { "type": "label", "textColor": "@text", "fitText": true },
		"muted": { "type": "label", "textColor": "@muted", "fitText": true },
		"small": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"heading": { "type": "label", "font": "h2", "textColor": "@text", "fitText": true },
		"icon": {
			"type": "label",
			"text": "",
			"width": 32,
			"height": 32,
			"radius": 999,
			"align": "center",
			"textColor": "@muted",
			"hover": { "textColor": "@text" },
			"focused": { "textColor": "@text", "borderWidth": 1, "borderColor": "@muted" },
			"cursor": "hand",
			"focusable": true,
			"role": "button"
		},
		"pill": {
			"type": "label",
			"height": 32,
			"padding": 9,
			"radius": 999,
			"align": "center",
			"fitText": true,
			"color": "@chip",
			"hover": { "color": "@chipHover" },
			"focused": { "borderWidth": 1, "borderColor": "@muted" },
			"textColor": "@text",
			"cursor": "hand",
			"focusable": true,
			"role": "button"
		},
		"pillOn": { "style": "pill", "color": "@chipOn", "hover": { "color": "@chipOn" }, "textColor": "@onChip" },
		"outline": { "style": "pill", "font": "bold", "color": "transparent", "hover": { "color": "transparent", "borderColor": "@text" }, "borderWidth": 1, "borderColor": "@muted" },
		"link": { "type": "label", "font": "bold", "textColor": "@muted", "hover": { "textColor": "@text" }, "fitText": true, "cursor": "hand", "focusable": true, "role": "link" },
		"bigPlay": {
			"type": "label",
			"font": "iconsLarge",
			"text": "",
			"width": 56,
			"height": 56,
			"radius": 999,
			"align": "center",
			"color": "@accent",
			"hover": { "color": "@accentHover", "scale": 1.04 },
			"focused": { "color": "@accentHover" },
			"textColor": "@onAccent",
			"shadow": { "y": 8, "blur": 16, "color": "#0000004d" },
			"cursor": "hand",
			"focusable": true,
			"role": "button"
		}
	},

	"actions": {
		"go": [
			{ "note": "with: page, i. Opens a page and keeps the one left for Back" },
			{ "if": "{{state.view.page == page && state.view.i == i}}", "then": [{ "stop": true }] },
			{ "push": "state.back", "value": "{{state.view}}" },
			{ "set": "state.forward", "to": [] },
			{ "set": "state.view", "to": { "page": "{{page}}", "i": "{{i}}" } },
			{ "set": "state.scroll", "to": 0 },
			{ "set": "state.sel", "to": [] },
			{ "set": "state.sort", "to": { "by": "", "desc": false } }
		],
		"goBack": { "title": "Go back", "category": "Go", "icon": "chevron-left", "enablement": "{{length(state.back) > 0}}", "do": [
			{ "push": "state.forward", "value": "{{state.view}}" },
			{ "set": "state.view", "to": "{{state.back[length(state.back) - 1]}}" },
			{ "remove": "state.back", "at": "{{length(state.back) - 1}}" },
			{ "set": "state.scroll", "to": 0 },
			{ "set": "state.sel", "to": [] }
		] },
		"goForward": { "title": "Go forward", "category": "Go", "icon": "chevron-right", "enablement": "{{length(state.forward) > 0}}", "do": [
			{ "push": "state.back", "value": "{{state.view}}" },
			{ "set": "state.view", "to": "{{state.forward[length(state.forward) - 1]}}" },
			{ "remove": "state.forward", "at": "{{length(state.forward) - 1}}" },
			{ "set": "state.scroll", "to": 0 },
			{ "set": "state.sel", "to": [] }
		] },
		"start": [
			{ "note": "with: kind, i (the context), tracks (its songs, in order), at (the place to start from)" },
			{ "set": "state.ctx", "to": { "kind": "{{kind}}", "i": "{{i}}" } },
			{ "set": "state.plain", "to": "{{tracks}}" },
			{ "set": "state.list", "to": "{{state.shuffle ? concat([tracks[at]], sort(filter(tracks, index != at), (it * 7919 + 13) % 101)) : tracks}}" },
			{ "set": "state.pos", "to": "{{state.shuffle ? 0 : at}}" },
			{ "set": "state.track", "to": "{{tracks[at]}}" },
			{ "set": "state.elapsed", "to": 0 },
			{ "set": "state.isPlaying", "to": true },
			{ "set": "state.recent", "to": "{{concat([kind + ':' + i], filter(state.recent, it != kind + ':' + i))}}" }
		],
		"playItem": [
			{ "note": "with: kind, i. Plays a playlist, album, artist (their popular songs) or the liked songs from the start; the one playing pauses or resumes" },
			{ "if": "{{state.ctx.kind == kind && state.ctx.i == i}}", "then": [{ "toggle": "state.isPlaying" }, { "stop": true }] },
			{ "run": "start", "with": { "kind": "{{kind}}", "i": "{{i}}", "at": 0,
				"tracks": "{{kind == 'playlist' ? state.playlists[i].tracks : kind == 'album' ? filter(range(length(state.tracks)), state.tracks[it].al == i) : kind == 'artist' ? slice(sort(filter(range(length(state.tracks)), state.tracks[it].ar == i), state.tracks[it].plays, 'desc'), 0, 10) : state.liked}}" } }
		],
		"advance": [
			{ "note": "The next song: the queue's first, else the context's next; past the end it starts again on repeat, else stops" },
			{ "set": "state.elapsed", "to": 0 },
			{ "if": "{{length(state.upNext) > 0}}", "then": [{ "set": "state.track", "to": "{{state.upNext[0]}}" }, { "remove": "state.upNext", "at": 0 }, { "stop": true }] },
			{ "if": "{{state.pos + 1 < length(state.list)}}", "then": [{ "increment": "state.pos" }],
				"else": [{ "set": "state.pos", "to": 0 }, { "if": "{{state.repeat == 'off'}}", "then": [{ "set": "state.isPlaying", "to": false }] }] },
			{ "set": "state.track", "to": "{{state.list[state.pos]}}" }
		],
		"tick": [
			{ "if": "{{!state.isPlaying}}", "then": [{ "stop": true }] },
			{ "increment": "state.elapsed" },
			{ "if": "{{state.elapsed >= computed.cur.d - settings.playback.crossfade}}", "then": [
				{ "if": "{{state.repeat == 'one'}}", "then": [{ "set": "state.elapsed", "to": 0 }], "else": [{ "run": "advance" }] }
			] }
		],
		"seek": [{ "set": "state.elapsed", "to": "{{round(clamp(to, 0, 1) * computed.cur.d)}}" }],
		"setVolume": [{ "set": "state.volume", "to": "{{round(clamp(to, 0, 1) * 100)}}" }, { "set": "state.muted", "to": false }],
		"say": [{ "set": "state.toast", "to": "{{text}}" }, { "debounce": 3000, "do": [{ "set": "state.toast", "to": "" }] }],
		"like": [
			{ "note": "with: track" },
			{ "if": "{{contains(state.liked, track)}}", "then": [
				{ "set": "state.liked", "to": "{{filter(state.liked, it != track)}}" }, { "run": "say", "with": { "text": "{{t('toast.unliked')}}" } }
			], "else": [
				{ "set": "state.liked", "to": "{{concat([track], state.liked)}}" }, { "run": "say", "with": { "text": "{{t('toast.liked')}}" } }
			] }
		],
		"playPause": { "title": "Play or pause", "category": "Playback", "icon": "play", "do": [{ "toggle": "state.isPlaying" }] },
		"next": { "title": "Next song", "category": "Playback", "icon": "skip-forward", "do": [{ "run": "advance" }, { "set": "state.isPlaying", "to": true }] },
		"previous": { "title": "Previous song", "category": "Playback", "icon": "skip-back", "do": [
			{ "if": "{{state.elapsed > 3 || state.pos == 0}}", "then": [{ "set": "state.elapsed", "to": 0 }, { "stop": true }] },
			{ "increment": "state.pos", "by": -1 },
			{ "set": "state.track", "to": "{{state.list[state.pos]}}" },
			{ "set": "state.elapsed", "to": 0 }
		] },
		"shuffle": { "title": "Shuffle", "category": "Playback", "icon": "shuffle", "do": [
			{ "toggle": "state.shuffle" },
			{ "set": "state.list", "to": "{{state.shuffle ? concat([state.track], sort(filter(state.plain, it != state.track), (it * 7919 + 13) % 101)) : state.plain}}" },
			{ "set": "state.pos", "to": "{{max(indexOf(state.list, state.track), 0)}}" }
		] },
		"repeat": { "title": "Repeat", "category": "Playback", "icon": "repeat", "do": [
			{ "set": "state.repeat", "to": "{{state.repeat == 'off' ? 'all' : state.repeat == 'all' ? 'one' : 'off'}}" }
		] },
		"likeCurrent": { "title": "Save the song to your liked songs", "category": "Playback", "icon": "heart", "do": [{ "run": "like", "with": { "track": "{{state.track}}" } }] },
		"volumeUp": { "title": "Volume up", "category": "Playback", "icon": "volume-2", "do": [{ "set": "state.volume", "to": "{{min(state.volume + 10, 100)}}" }, { "set": "state.muted", "to": false }] },
		"volumeDown": { "title": "Volume down", "category": "Playback", "icon": "volume-1", "do": [{ "set": "state.volume", "to": "{{max(state.volume - 10, 0)}}" }] },
		"mute": { "title": "Mute", "category": "Playback", "icon": "volume-x", "do": [{ "toggle": "state.muted" }] },
		"goHome": { "title": "Home", "category": "Go", "icon": "home", "do": [{ "run": "go", "with": { "page": "home", "i": 0 } }] },
		"goSearch": { "title": "Search", "category": "Go", "icon": "search", "do": [{ "run": "go", "with": { "page": "search", "i": 0 } }, { "focus": "#search" }] },
		"goLiked": { "title": "Liked songs", "category": "Go", "icon": "heart", "do": [{ "run": "go", "with": { "page": "liked", "i": 0 } }] },
		"lyrics": { "title": "Lyrics", "category": "View", "icon": "mic-2", "do": [
			{ "if": "{{state.view.page == 'lyrics'}}", "then": [{ "run": "goBack" }], "else": [{ "run": "go", "with": { "page": "lyrics", "i": 0 } }] }
		] },
		"nowPlayingView": { "title": "Now playing view", "category": "View", "icon": "play-square", "do": [{ "set": "state.right", "to": "{{state.right == 'now' ? '' : 'now'}}" }, { "set": "state.rightScroll", "to": 0 }] },
		"queue": { "title": "Queue", "category": "View", "icon": "list-music", "do": [{ "set": "state.right", "to": "{{state.right == 'queue' ? '' : 'queue'}}" }, { "set": "state.rightScroll", "to": 0 }] },
		"collapseLibrary": { "title": "Collapse or expand Your Library", "category": "View", "icon": "library", "do": [{ "toggle": "state.lib.collapsed" }] },
		"fullScreen": { "title": "Full screen", "category": "View", "icon": "maximize-2", "do": [{ "toggle": "state.full" }, { "set": "state.mini", "to": false }] },
		"miniPlayer": { "title": "Mini player", "category": "View", "icon": "picture-in-picture-2", "do": [{ "toggle": "state.mini" }, { "set": "state.full", "to": false }] },
		"leave": { "title": "Leave full screen", "category": "View", "icon": "minimize-2", "enablement": "{{state.full || state.mini || state.open.keys}}", "do": [
			{ "set": "state.full", "to": false }, { "set": "state.mini", "to": false }, { "set": "state.open.keys", "to": false }
		] },
		"shortcuts": { "title": "Keyboard shortcuts", "category": "Help", "icon": "keyboard", "do": [{ "set": "state.open.keys", "to": true }] },
		"findSong": { "title": "Find a song…", "category": "Go", "icon": "search", "do": [{ "set": "state.quickPick.query", "to": "" }, { "set": "state.quickPick.open", "to": true }] },
		"commandPalette": { "title": "Show all commands", "category": "Go", "icon": "command", "do": [{ "set": "state.quickPick.query", "to": ">" }, { "set": "state.quickPick.open", "to": true }] },
		"playFromPick": [
			{ "note": "with: item, a quick pick row: its album plays from that song" },
			{ "run": "start", "with": { "kind": "album", "i": "{{state.tracks[item.track].al}}", "tracks": "{{filter(range(length(state.tracks)), state.tracks[it].al == state.tracks[item.track].al)}}",
				"at": "{{indexOf(filter(range(length(state.tracks)), state.tracks[it].al == state.tracks[item.track].al), item.track)}}" } }
		],
		"toggleTheme": { "title": "Switch light and dark", "category": "View", "icon": "moon", "do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },
		"switchLanguage": { "title": "Change the language", "category": "View", "icon": "languages",
			"do": [{ "set": "settings.ui.language", "to": "{{settings.ui.language == 'en' ? 'it' : settings.ui.language == 'it' ? 'ar' : 'en'}}" }] }
	},

	"keys": {
		"space": "playPause",
		"mod+right": "next",
		"mod+left": "previous",
		"mod+up": "volumeUp",
		"mod+down": "volumeDown",
		"mod+shift+down": "mute",
		"mod+s": "shuffle",
		"mod+r": "repeat",
		"alt+shift+b": "likeCurrent",
		"alt+left": "goBack",
		"alt+right": "goForward",
		"alt+shift+h": "goHome",
		"mod+k": "goSearch",
		"mod+l": "goSearch",
		"alt+shift+s": "goLiked",
		"alt+shift+l": "collapseLibrary",
		"alt+shift+r": "nowPlayingView",
		"alt+shift+q": "queue",
		"alt+shift+y": "lyrics",
		"mod+shift+f": "fullScreen",
		"mod+m": "miniPlayer",
		"escape": "leave",
		"mod+slash": "shortcuts",
		"mod+p": "findSong",
		"mod+shift+p": "commandPalette",
		"mod+t": "toggleTheme",
		"mod+shift+l": "switchLanguage"
	},

	"root": {
		"id": "window",
		"color": "@window",
		"children": [
			{
			"id": "app",
				"fill": 0,
			"color": "@window",
			"dir": "auto",
			"every": { "ms": 1000, "do": "tick" },
			"children": [
				{ "id": "topBar", "when": "{{!state.mini}}", "use": "topBar", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 64 },
				{ "id": "library", "when": "{{!state.mini}}", "use": "library", "anchors": { "left": 8, "top": 64, "bottom": 80 }, "width": "{{computed.libW}}" },
				{
					"id": "librarySash",
					"when": "{{!state.mini}}",
					"anchors": { "left": "{{computed.libW + 8}}", "top": 64, "bottom": 80 },
					"width": 8,
					"color": "transparent",
					"hover": { "color": "@line" },
					"cursor": "resize-horizontal",
					"tooltip": "{{t('lib.resize')}}",
					"onPress": { "set": "state.press", "to": { "at": 0, "width": 1, "from": "{{computed.libW}}" } },
					"onDrag": [
						{ "set": "state.lib.collapsed", "to": "{{state.press.from + event.dx * (computed.rtl ? -1 : 1) < 180}}" },
						{ "set": "state.lib.width", "to": "{{clamp(state.press.from + event.dx * (computed.rtl ? -1 : 1), 280, 480)}}" }
					],
					"onDoubleClick": "collapseLibrary"
				},
				{ "id": "main", "when": "{{!state.mini}}", "use": "mainView", "anchors": { "left": "{{computed.libW + 16}}", "right": "{{state.right != '' ? 336 : 8}}", "top": 64, "bottom": 80 } },
				{ "id": "rightPanel", "when": "{{!state.mini && state.right != ''}}", "use": "rightPanel", "anchors": { "right": 8, "top": 64, "bottom": 80 }, "width": 320 },
				{ "id": "player", "when": "{{!state.mini}}", "use": "playerBar", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 72 },
				{
					"id": "toast",
					"when": "{{state.toast != '' && !state.mini}}",
					"type": "label",
					"text": "{{state.toast}}",
					"live": "polite",
					"anchors": { "bottom": 96 },
					"x": "{{floor(window.width / 2) - 140}}",
					"width": 280,
					"height": 40,
					"radius": 8,
					"align": "center",
					"color": "#3d91f4",
					"textColor": "#ffffff",
					"shadow": { "y": 4, "blur": 16, "color": "#00000080" }
				},
				{ "id": "fullView", "when": "{{state.full}}", "use": "fullScreen", "fill": true },
				{ "id": "miniView", "when": "{{state.mini}}", "use": "miniPlayer", "fill": true },
				{
					"id": "trackMenu",
					"use": "contextMenu",
					"with": { "open": "state.open.ctx", "x": "{{state.menu.x}}", "y": "{{min(state.menu.y, window.height - 24 - 30 * length(computed.menuItems))}}", "icons": true, "items": "{{computed.menuItems}}" }
				},
				{
					"id": "shortcutsDialog",
					"use": "dialog",
					"with": { "open": "state.open.keys", "title": "{{t('keys.title')}}", "buttons": [{ "title": "{{t('keys.close')}}" }] },
					"children": [
						{
							"id": "shortcutsList",
							"type": "grid",
							"columns": ["1fr", "auto"],
							"rowGap": 6,
							"columnGap": 24,
							"width": 420,
							"height": 400,
							"scroll": "vertical",
							"children": [
								{ "id": "shortcutTitle", "repeat": { "for": "k", "in": "keybindings" }, "style": "muted", "text": "{{k.title}}", "height": 20 },
								{ "id": "shortcutKey", "repeat": { "for": "k", "in": "keybindings" }, "type": "label", "font": "small", "text": "{{k.keyLabel}}", "textColor": "@text", "height": 20, "padding": 6, "radius": 4, "color": "@raised", "fitText": true }
							]
						}
					]
				},
				{
					"id": "quickPick",
					"when": "{{state.quickPick.open}}",
					"use": "quickPick",
					"with": {
						"providers": [
							{ "items": "{{computed.picks}}", "run": "playFromPick", "placeholder": "{{t('pick.songs')}}" },
							{ "prefix": ">", "items": "{{computed.palette}}", "placeholder": "{{t('pick.commands')}}" }
						]
					}
				}
			]
		}
		]
	}
}
