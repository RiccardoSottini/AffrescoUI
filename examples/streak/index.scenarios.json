{
	"$schema": "../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "What Streak does, checked headless: affrescoui test index.scenarios.json",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "check-a-habit",
			"note": "A click on an empty box ticks it, a second skips the day, a third clears it",
			"steps": [
				{
					"expect": {
						"node": "#cell",
						"nth": 40,
						"property": "name",
						"is": "Thu 15 Oct: 1 cups"
					}
				},
				{
					"expect": {
						"node": "#cell",
						"nth": 48,
						"property": "name",
						"is": "Thu 15 Oct: on target"
					}
				},
				{
					"click": "#cell",
					"nth": 48
				},
				{
					"expect": {
						"node": "#cell",
						"nth": 48,
						"property": "name",
						"is": "Thu 15 Oct: done"
					}
				},
				{
					"click": "#cell",
					"nth": 48
				},
				{
					"expect": {
						"node": "#cell",
						"nth": 48,
						"property": "name",
						"is": "Thu 15 Oct: skipped"
					}
				},
				{
					"click": "#cell",
					"nth": 48
				},
				{
					"expect": {
						"node": "#cell",
						"nth": 48,
						"property": "name",
						"is": "Thu 15 Oct: on target"
					}
				}
			]
		},
		{
			"name": "a-row-selects-its-habit",
			"note": "A click on a habit's name shows it in the detail pane",
			"steps": [
				{
					"expect": {
						"state": "selected",
						"is": "meditate"
					}
				},
				{
					"click": [
						100,
						248
					]
				},
				{
					"expect": {
						"state": "selected",
						"is": "read"
					}
				},
				{
					"expect": {
						"node": "#detailBar",
						"property": "name",
						"is": "Read"
					}
				}
			]
		},
		{
			"name": "enter-a-number",
			"note": "A measurable box asks for the number; Enter saves it",
			"steps": [
				{
					"click": "#cell",
					"nth": 40
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"node": "#popupValue",
						"exists": true
					}
				},
				{
					"key": "backspace"
				},
				{
					"type": "4"
				},
				{
					"key": "enter"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"node": "#cell",
						"nth": 40,
						"property": "name",
						"is": "Thu 15 Oct: 4 cups"
					}
				},
				{
					"expect": {
						"state": "popup.open",
						"is": false
					}
				}
			]
		},
		{
			"name": "a-note-on-a-day",
			"note": "The day's menu (Shift+F10) writes a note; the notes card shows it",
			"steps": [
				{
					"click": "#cell",
					"nth": 0
				},
				{
					"click": "#cell",
					"nth": 0
				},
				{
					"click": "#cell",
					"nth": 0
				},
				{
					"key": "shift+f10"
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"node": "#popupNote",
