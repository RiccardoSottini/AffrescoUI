{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"note": "The Studio's Features screen (RFC 0004), included by studio.screen.json: what the host's signed catalogues offer, installed and upgraded through the features service, enabled, disabled and removed by revisions on /features/<name>. Cmd+6 opens it. A catalogue the host doesn't trust lists nothing.",
	"services": {
		"features": {
			"provider": "features"
		}
	},
	"state": {
		"featuresOpen": false,
		"featureRows": [],
		"featuresStatus": ""
	},
	"actions": {
		"openFeatures": [
			{
				"set": "state.featuresOpen",
				"to": true
			},
			{
				"run": "refreshFeatures"
			}
		],
		"refreshFeatures": [
			{
				"invoke": "features.catalog",
				"into": "state.featureRows",
				"onError": [
					{
						"set": "state.featuresStatus",
						"to": "{{error.message}}"
					}
				]
			}
		],
		"installFeature": [
			{
				"note": "with: name"
			},
			{
				"invoke": "features.install",
				"with": {
					"name": "{{name}}"
				},
				"onDone": [
					{
						"set": "state.featuresStatus",
						"to": "{{t('features.status', {name: name, status: result.status})}}"
					},
					{
						"run": "refreshFeatures"
					}
				],
				"onError": [
					{
						"set": "state.featuresStatus",
						"to": "{{error.message}}"
					}
				]
			}
		],
		"upgradeFeature": [
			{
				"note": "with: name"
			},
			{
				"invoke": "features.upgrade",
				"with": {
					"name": "{{name}}"
				},
				"onDone": [
					{
						"set": "state.featuresStatus",
						"to": "{{t('features.status', {name: name, status: result.status})}}"
					},
					{
						"run": "refreshFeatures"
					}
				],
				"onError": [
					{
						"set": "state.featuresStatus",
						"to": "{{error.message}}"
					}
				]
			}
		],
		"enableFeature": [
			{
				"note": "with: name, on"
			},
			{
				"patch": [
					{
						"op": "replace",
						"path": "{{'/features/' + name + '/enabled'}}",
						"value": "{{on}}"
					}
				],
				"message": "{{(on ? 'Enable ' : 'Disable ') + name}}"
			},
			{
				"run": "refreshFeatures"
			}
		],
		"removeFeature": [
			{
				"note": "with: name"
			},
			{
				"patch": [
					{
						"op": "remove",
						"path": "{{'/features/' + name}}"
					}
				],
				"message": "{{'Remove ' + name}}"
			},
			{
				"run": "refreshFeatures"
			}
		],
		"showFeatures": {
			"title": "Open the features",
			"category": "view",
			"icon": "puzzle",
			"enablement": "{{state.connected}}",
			"do": "openFeatures"
		}
	},
	"keys": {
		"mod+6": "showFeatures"
	},
	"components": {
		"featuresDialog": {
			"params": {
				"open": "state.featuresOpen",
				"title": "{{t('features.title')}}",
				"message": "{{state.featuresStatus == '' ? t('features.message') : state.featuresStatus}}",
				"width": "{{min(560, window.width - 32)}}",
				"height": 420,
				"highlight": "@color.accent",
				"buttons": [
					{
						"title": "{{t('dialog.close')}}"
					}
				],
				"color": "@color.card",
				"textColor": "@color.text",
				"dimColor": "@color.muted",
				"backdrop": "@color.backdrop"
			},
			"node": {
				"use": "dialog",
				"with": {
					"open": "state.featuresOpen",
					"title": "{{t('features.title')}}",
					"message": "{{state.featuresStatus == '' ? t('features.message') : state.featuresStatus}}",
					"width": "{{min(560, window.width - 32)}}",
					"height": 420,
					"highlight": "@color.accent",
					"buttons": [
						{
							"title": "{{t('dialog.close')}}"
						}
					],
					"color": "@color.card",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"backdrop": "@color.backdrop"
				},
				"children": [
					{
						"id": "featureList",
						"type": "column",
						"anchors": {
							"left": 20,
							"right": 20,
							"top": 72,
							"bottom": 56
						},
						"scroll": "vertical",
						"gap": 6,
						"children": [
							{
								"when": "{{length(state.featureRows) == 0}}",
								"style": "empty",
								"width": "100%",
								"height": 48,
								"text": "{{t('features.none')}}",
								"id": "featuresNone"
							},
							{
								"repeat": {
									"for": "f",
									"in": "{{state.featureRows}}"
								},
								"width": "100%",
								"height": 52,
								"style": "card",
								"color": "@color.cardRaised",
								"children": [
									{
										"type": "label",
										"text": "{{f.title + '  ' + f.version}}",
										"textColor": "@color.text",
										"anchors": {
											"left": 12,
											"top": 8
										},
										"fitText": true,
										"id": "featureTitle"
									},
									{
										"style": "caption",
										"text": "{{t('features.publisher', {publisher: f.publisher, installed: f.installed ? 'yes' : 'no', enabled: f.enabled ? 'yes' : 'no'})}}",
										"anchors": {
											"left": 12,
											"top": 28
										},
										"id": "featurePublisher"
									},
									{
										"type": "row",
										"anchors": {
											"right": 10,
											"top": 12
										},
										"width": 248,
										"height": 28,
										"gap": 8,
										"justify": "end",
										"children": [
											{
												"when": "{{!f.installed}}",
												"style": "goodButton",
												"width": 80,
												"text": "{{t('features.install')}}",
												"onClick": {
													"run": "installFeature",
													"with": {
														"name": "{{f.name}}"
													}
												},
												"id": "featureInstall",
												"label": "{{t('features.install')}}",
												"focusable": true
											},
											{
												"when": "{{f.installed}}",
												"style": "smallButton",
												"width": 80,
												"text": "{{t('features.upgrade')}}",
												"onClick": {
													"run": "upgradeFeature",
													"with": {
														"name": "{{f.name}}"
													}
												},
												"id": "featureUpgrade",
												"label": "{{t('features.upgrade')}}",
												"focusable": true
											},
											{
												"when": "{{f.installed}}",
												"style": "smallButton",
												"width": 72,
												"text": "{{t('features.enable', {on: f.enabled ? 'yes' : 'no'})}}",
												"onClick": {
													"run": "enableFeature",
													"with": {
														"name": "{{f.name}}",
														"on": "{{!f.enabled}}"
													}
												},
												"id": "featureEnable",
												"label": "{{t('features.enable', {on: f.enabled ? 'yes' : 'no'})}}",
												"focusable": true
											},
											{
												"when": "{{f.installed}}",
												"style": "badButton",
												"width": 72,
												"text": "{{t('features.remove')}}",
												"onClick": {
													"run": "removeFeature",
													"with": {
														"name": "{{f.name}}"
													}
												},
												"id": "featureRemove",
												"label": "{{t('features.remove')}}",
												"focusable": true
											}
										],
										"id": "featureButtons",
										"arrows": "horizontal"
									}
								],
								"id": "featureRow",
								"role": "listitem",
								"label": "{{f.title}}"
							}
						],
						"role": "list",
						"label": "{{t('features.title')}}"
					}
				]
			}
		}
	}
}
