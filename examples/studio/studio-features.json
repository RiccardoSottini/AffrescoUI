{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"note": "The Studio's Features screen (RFC 0004), included by studio.screen.json: what the host's signed catalogues offer, installed and upgraded through the features service, enabled, disabled and removed by revisions on /features/<name>. Cmd+4 opens it. A catalogue the host doesn't trust lists nothing.",

	"services": { "features": { "provider": "features" } },

	"state": {
		"featuresOpen": false,
		"featureRows": [],
		"featuresStatus": ""
	},

	"actions": {
		"openFeatures": [{ "set": "state.featuresOpen", "to": true }, { "run": "refreshFeatures" }],
		"refreshFeatures": [
			{
				"invoke": "features.catalog",
				"into": "state.featureRows",
				"onError": [{ "set": "state.featuresStatus", "to": "{{error.message}}" }]
			}
		],
		"installFeature": [
			{ "note": "with: name" },
			{
				"invoke": "features.install",
				"with": { "name": "{{name}}" },
				"onDone": [
					{ "set": "state.featuresStatus", "to": "{{name + ': ' + result.status}}" },
					{ "run": "refreshFeatures" }
				],
				"onError": [{ "set": "state.featuresStatus", "to": "{{error.message}}" }]
			}
		],
		"upgradeFeature": [
			{ "note": "with: name" },
			{
				"invoke": "features.upgrade",
				"with": { "name": "{{name}}" },
				"onDone": [
					{ "set": "state.featuresStatus", "to": "{{name + ': ' + result.status}}" },
					{ "run": "refreshFeatures" }
				],
				"onError": [{ "set": "state.featuresStatus", "to": "{{error.message}}" }]
			}
		],
		"enableFeature": [
			{ "note": "with: name, on" },
			{
				"patch": [{ "op": "replace", "path": "{{'/features/' + name + '/enabled'}}", "value": "{{on}}" }],
				"message": "{{(on ? 'Enable ' : 'Disable ') + name}}"
			},
			{ "run": "refreshFeatures" }
		],
		"removeFeature": [
			{ "note": "with: name" },
			{ "patch": [{ "op": "remove", "path": "{{'/features/' + name}}" }], "message": "{{'Remove ' + name}}" },
			{ "run": "refreshFeatures" }
		]
	},

	"keys": { "mod+4": "openFeatures" },

	"components": {
		"featuresDialog": {
			"params": {},
			"node": {
				"use": "dialog",
				"with": {
					"open": "state.featuresOpen",
					"title": "Features",
					"message": "{{state.featuresStatus == '' ? 'From the catalogues the host trusts; each change is a revision.' : state.featuresStatus}}",
					"width": 560,
					"height": 420,
					"highlight": "@color.accent",
					"buttons": [{ "title": "Close" }],
					"color": "@color.card",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"backdrop": "@color.backdrop"
				},
				"children": [
					{
						"id": "featureList",
						"type": "column",
						"anchors": { "left": 20, "right": 20, "top": 72, "bottom": 56 },
						"scroll": "vertical",
						"gap": 6,
						"children": [
							{
								"when": "{{length(state.featureRows) == 0}}",
								"style": "empty",
								"width": "100%",
								"height": 48,
								"text": "No feature: the host trusts no catalogue yet."
							},
							{
								"repeat": { "for": "f", "in": "{{state.featureRows}}" },
								"width": "100%",
								"height": 52,
								"style": "card",
								"color": "@color.cardRaised",
								"children": [
									{
										"type": "label",
										"text": "{{f.title + '  ' + f.version}}",
										"textColor": "@color.text",
										"anchors": { "left": 12, "top": 8 },
										"fitText": true
									},
									{
										"style": "caption",
										"text": "{{f.publisher + (f.installed ? (f.enabled ? ' · enabled' : ' · disabled') : '')}}",
										"anchors": { "left": 12, "top": 28 }
									},
									{
										"type": "row",
										"anchors": { "right": 10, "top": 12 },
										"width": 248,
										"height": 28,
										"gap": 8,
										"justify": "end",
										"children": [
											{
												"when": "{{!f.installed}}",
												"style": "goodButton",
												"width": 80,
												"text": "Install",
												"onClick": { "run": "installFeature", "with": { "name": "{{f.name}}" } }
											},
											{
												"when": "{{f.installed}}",
												"style": "smallButton",
												"width": 80,
												"text": "Upgrade",
												"onClick": { "run": "upgradeFeature", "with": { "name": "{{f.name}}" } }
											},
											{
												"when": "{{f.installed}}",
												"style": "smallButton",
												"width": 72,
												"text": "{{f.enabled ? 'Disable' : 'Enable'}}",
												"onClick": {
													"run": "enableFeature",
													"with": { "name": "{{f.name}}", "on": "{{!f.enabled}}" }
												}
											},
											{
												"when": "{{f.installed}}",
												"style": "badButton",
												"width": 72,
												"text": "Remove",
												"onClick": { "run": "removeFeature", "with": { "name": "{{f.name}}" } }
											}
										]
									}
								]
							}
						]
					}
				]
			}
		}
	}
}
