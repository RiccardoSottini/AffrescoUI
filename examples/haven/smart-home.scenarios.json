				{ "expect": { "state": "mode", "is": "Cool" } },
				{ "expect": { "node": "#infoModeValue", "text": "Cool" } },
				{ "key": "escape" },
				{ "click": "#deviceName", "nth": 2 },
				{ "expect": { "node": "#infoVolume", "property": "shown", "is": true } },
				{ "click": "#infoPlay" },
				{ "expect": { "state": "devices[2].busy", "is": true } },
				{ "click": "#infoMore" },
				{ "click": { "role": "menuitem", "name": "Related" } },
				{ "expect": { "state": "page", "is": "automations" } },
				{ "key": "mod+comma" },
				{ "click": "#settingsRow", "nth": 0 },
				{ "click": { "role": "tab", "name": "Entities" } },
				{ "expect": { "node": "#roomEntityTable", "property": "shown", "is": true } },
				{ "click": "#devSearch" },
				{ "type": "kit" },
				{ "expect": { "state": "devQuery", "is": "kit" } },
				{ "click": "#settingsBack" },
				{ "key": "mod+4", "note": "the related automation is still open" },
				{ "click": "#autoMore" },
				{ "click": { "role": "menuitem", "name": "Disable" } },
				{ "expect": { "node": "#autoOffBanner", "property": "shown", "is": true } },
				{ "click": "#autoOffEnable" },
				{ "expect": { "node": "#autoOffBanner", "exists": false } }
			]
		}
