{
	"$schema": "../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "What the Smart home template does, checked headless: affrescoui test smart-home.scenarios.json",
	"screen": "smart-home.screen.json",
	"scenarios": [
		{
			"name": "switch-a-light-on",
			"note": "Clicking a light that is off switches it on, its toggle follows, and the summary counts it",
			"steps": [
				{ "expect": { "node": "#toggle-rooms-room-lights", "nth": 2, "property": "checked", "is": false } },
				{ "click": "#light", "nth": 2 },
				{ "expect": { "state": "rooms[0].lights[2].on", "is": true } },
				{ "expect": { "node": "#toggle-rooms-room-lights", "nth": 2, "property": "checked", "is": true } },
				{ "expect": { "node": "#label-light-on-on", "nth": 2, "text": "On  ·  30%" } },
				{ "expect": { "node": "#summary", "text": "3 of 4 lights on" } },
				{ "click": "#toggle-rooms-room-lights", "nth": 2, "note": "the toggle itself switches it off again" },
				{ "expect": { "state": "rooms[0].lights[2].on", "is": false } },
				{ "expect": { "node": "#label-light-on-on", "nth": 2, "text": "Off" } }
			]
		},
		{
			"name": "set-a-lights-brightness",
			"note": "Clicking the middle of a brightness slider sets the light's level to the nearest step",
			"steps": [
				{ "click": "#slider-rooms-room-lights", "nth": 0 },
				{ "expect": { "state": "rooms[0].lights[0].level", "is": 60 } },
				{ "expect": { "node": "#slider-rooms-room-lights", "nth": 0, "property": "value", "is": 60 } },
				{ "expect": { "node": "#label-light-on-on", "nth": 0, "text": "On  ·  60%" } }
			]
		},
		{
			"name": "pick-a-room",
			"note": "Clicking a room in the rooms tree shows its name, its picture, its lights and its climate",
			"steps": [
				{ "click": [130, 397], "note": "Kitchen, under Ground floor" },
				{ "expect": { "state": "room", "is": 1 } },
				{ "expect": { "node": "#greeting", "text": "Kitchen" } },
				{ "expect": { "node": "#roomImage", "property": "shown", "is": true } },
				{ "expect": { "node": "#label-light-name", "nth": 0, "text": "Pendants" } },
				{ "expect": { "node": "#light", "nth": 2, "exists": false } },
				{ "expect": { "node": "#target", "text": "21°" } },
				{ "click": [26, 337], "note": "the arrow closes a floor; picking a floor picks no room" },
				{ "expect": { "state": "room", "is": 1 } },
				{ "expect": { "state": "floorsOpen", "is": ["upper"] } }
			]
		},
		{
			"name": "scene-animates-the-blinds",
			"note": "Movie night dims the room's lights at once and closes the blinds over 600 ms",
			"steps": [
				{ "click": "#scene", "nth": 1 },
				{ "expect": { "state": "scene", "is": "Movie night" } },
				{ "expect": { "state": "rooms[0].lights[0].level", "is": 20 } },
				{ "expect": { "state": "rooms[0].blinds", "is": 60, "note": "the blinds have not moved yet" } },
				{ "wait": 700 },
				{ "expect": { "state": "rooms[0].blinds", "is": 0 } },
				{ "expect": { "node": "#label-round-room-blinds", "text": "0% open" } }
			]
		},
		{
			"name": "away-turns-everything-off",
			"note": "The Away scene switches off every light in every room and lowers every target to 17°",
			"steps": [
				{ "click": "#scene", "nth": 2 },
				{ "expect": { "state": "scene", "is": "Away" } },
				{ "expect": { "state": "rooms[3].lights[0].on", "is": false } },
				{ "expect": { "state": "rooms[2].target", "is": 17 } },
				{ "expect": { "node": "#summary", "text": "0 of 4 lights on  ·  scene: Away" } },
				{ "click": "#light", "nth": 0, "note": "touching a light clears the scene" },
				{ "expect": { "state": "scene", "is": "" } }
			]
		},
		{
			"name": "change-the-target-temperature",
			"note": "The arrow keys and the +/- buttons move the target by half a degree",
			"steps": [
				{ "key": "up" },
				{ "key": "up" },
				{ "expect": { "state": "rooms[0].target", "is": 23 } },
				{ "click": "#label-down-arrow" },
				{ "expect": { "state": "rooms[0].target", "is": 22.5 } },
				{ "expect": { "node": "#target", "text": "22.5°" } },
				{ "click": "#panel-mode", "nth": 1 },
				{ "expect": { "state": "mode", "is": "Cool" } }
			]
		},
		{
			"name": "smart-home-switch-the-theme",
			"note": "The theme switch and Cmd+T flip between the dark and the light theme",
			"steps": [
				{ "click": "#toggle-theme-switch" },
				{ "expect": { "state": "theme", "is": "light" } },
				{ "expect": { "node": "#toggle-theme-switch", "property": "checked", "is": true } },
				{ "key": "mod+t" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "expect": { "node": "#toggle-theme-switch", "property": "checked", "is": false } }
			]
		},
		{
			"name": "a-device-call-takes-a-while",
			"note": "A device tile shows its progress while the call runs, then its new state and a toast; a second call waits for the first",
			"steps": [
				{ "click": "#deviceAction", "nth": 1 },
				{ "expect": { "state": "devices[1].busy", "is": true } },
				{ "expect": { "node": "#deviceState", "nth": 1, "text": "Waiting for it…" } },
				{ "click": "#deviceAction", "nth": 2, "note": "ignored while the vacuum is busy" },
				{ "expect": { "state": "devices[2].busy", "is": false } },
				{ "wait": 450 },
				{ "expect": { "node": "#busyToast", "exists": true } },
				{ "wait": 500 },
				{ "expect": { "state": "devices[1].busy", "is": false } },
				{ "expect": { "state": "devices[1].on", "is": true } },
				{ "expect": { "node": "#deviceState", "nth": 1, "text": "Cleaning" } },
				{ "expect": { "node": "#deviceAction", "nth": 1, "text": "Dock" } },
				{ "expect": { "state": "toast", "is": { "open": true, "message": "Vacuum: cleaning" } } },
				{ "wait": 4100 },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "pages-from-the-sidebar-and-keys",
			"note": "The sidebar and Cmd+1, Cmd+2, Cmd+, switch between Home, Energy and Settings",
			"steps": [
				{ "click": "#navItem", "nth": 1 },
				{ "expect": { "state": "page", "is": "energy" } },
				{ "expect": { "node": "#greeting", "exists": false } },
				{ "expect": { "node": "#todayFigure", "text": "24.4 kWh" } },
				{ "expect": { "node": "#peakFigure", "text": "18:00" } },
				{ "key": "mod+comma" },
				{ "expect": { "state": "page", "is": "settings" } },
				{ "key": "mod+1" },
				{ "expect": { "node": "#greeting", "text": "Living room" } },
				{ "click": "#energy", "note": "the energy card in the sidebar opens the Energy page" },
				{ "expect": { "state": "page", "is": "energy" } }
			]
		},
		{
			"name": "the-room-table-picks-a-room",
			"note": "On the Energy page, picking a row of the table picks that room",
			"steps": [
				{ "key": "mod+2" },
				{ "click": [800, 629], "note": "the Bedroom row" },
				{ "expect": { "state": "room", "is": 2 } },
				{ "key": "mod+1" },
				{ "expect": { "node": "#greeting", "text": "Bedroom" } }
			]
		},
		{
			"name": "settings-change-the-scenes",
			"note": "The Away temperature and the device notifications come from the settings page",
			"steps": [
				{ "key": "mod+comma" },
				{ "click": [1060, 180], "note": "the Away temperature slider, near its start" },
				{ "click": [1191, 237], "note": "switch device notifications off" },
				{ "key": "mod+1" },
				{ "click": "#scene", "nth": 2 },
				{ "expect": { "state": "rooms[2].target", "is": 13 } },
				{ "click": "#deviceAction", "nth": 0 },
				{ "wait": 1000 },
				{ "expect": { "state": "devices[0].on", "is": false } },
				{ "expect": { "state": "toast.open", "is": false, "note": "no toast with notifications off" } }
			]
		},
		{
			"name": "plan-click-picks-a-room",
			"note": "On the floor plan, clicking a room on the canvas makes it the room the other pages show",
			"steps": [
				{ "key": "mod+3" },
				{ "expect": { "state": "page", "is": "plan" } },
				{ "click": [700, 250], "note": "the Kitchen on the canvas" },
				{ "expect": { "state": "room", "is": 1 } },
				{ "expect": { "node": "#planRoomName", "text": "Kitchen" } },
				{ "click": "#planShow" },
				{ "expect": { "state": "page", "is": "home" } },
				{ "expect": { "node": "#greeting", "text": "Kitchen" } }
			]
		},
		{
			"name": "colour-a-light",
			"note": "A light's bulb opens the colour dialog; Warm white sets its colour and Done closes it",
			"steps": [
				{ "click": "#lightIcon", "nth": 1 },
				{ "wait": 100, "note": "the dialog takes the focus once it is laid out" },
				{ "expect": { "state": "colourOpen", "is": true } },
				{ "expect": { "state": "light", "is": 1 } },
				{ "expect": { "node": "#colourPicker", "property": "focused", "is": true } },
				{ "click": "#colourWarm" },
				{ "expect": { "state": "rooms[0].lights[1].color", "is": "#ffd58aff" } },
				{ "click": "#colourDone" },
				{ "expect": { "state": "colourOpen", "is": false } },
				{ "click": "#lightIcon", "nth": 0 },
				{ "wait": 100 },
				{ "key": "escape", "note": "Escape closes it too" },
				{ "expect": { "state": "colourOpen", "is": false } }
			]
		},
		{
			"name": "automations-add-a-node",
			"note": "The Add buttons put a new node on the automation graph, chosen",
			"steps": [
				{ "key": "mod+4" },
				{ "expect": { "state": "autoNodes.length", "is": 6 } },
				{ "click": "#autoAddTime" },
				{ "expect": { "state": "autoNodes.length", "is": 7 } },
				{ "expect": { "state": "autoNodes[6].kind", "is": "time" } },
				{ "expect": { "state": "autoSelected", "is": ["time6"] } },
				{ "click": "#autoAddScene" },
				{ "expect": { "state": "autoNodes.length", "is": 8 } }
			]
		},
		{
			"name": "drag-a-schedule-clip",
			"note": "Dragging the Morning heating clip two hours later moves it by whole hours",
			"steps": [
				{ "key": "mod+4" },
				{ "drag": [680, 630], "to": [748, 630], "moves": 8 },
				{ "expect": { "state": "schedules[0].clips[0].start", "is": 8 } },
				{ "expect": { "state": "schedules[0].clips[0].duration", "is": 3 } }
			]
		},
		{
			"name": "energy-by-device",
			"note": "The By device switch charts the week's energy per device, labelled by device",
			"steps": [
				{ "key": "mod+2" },
				{ "click": "#energyByDevice" },
				{ "expect": { "state": "energyView", "is": "device" } },
				{ "expect": { "node": "#energyByDevice", "property": "role", "is": "button" } },
				{ "expect": { "node": "#weekDay", "exists": false } },
				{ "expect": { "node": "#weekDevice", "exists": true } },
				{ "click": "#energyByDay" },
				{ "expect": { "state": "energyView", "is": "day" } }
			]
		},
		{
			"name": "security-mode-and-notifications",
			"note": "Cmd+Shift+A cycles Off, Home, Away; each change is a notification, the bell counts them, Cmd+Shift+N shows them and Clear empties them",
			"steps": [
				{ "key": "mod+shift+a" },
				{ "expect": { "state": "security", "is": "home" } },
				{ "click": "#securityButton" },
				{ "expect": { "state": "security", "is": "away" } },
				{ "expect": { "node": "#bellCount", "text": "2" } },
				{ "key": "mod+shift+n" },
				{ "expect": { "state": "notificationsOpen", "is": true } },
				{ "expect": { "node": "#notification", "nth": 0, "text": "Security: Away" } },
				{ "click": "#notificationsClear" },
				{ "expect": { "state": "notifications", "is": [] } },
				{ "expect": { "node": "#bellCount", "exists": false } }
			]
		},
		{
			"name": "simulated-service-moves-rooms",
			"note": "Every ten seconds the simulated service moves each room half a degree towards its target",
			"steps": [
				{ "expect": { "state": "rooms[0].temp", "is": 21.5 } },
				{ "wait": 10100 },
				{ "expect": { "state": "tick", "is": 1 } },
				{ "expect": { "state": "rooms[0].temp", "is": 22 } },
				{ "expect": { "state": "rooms[2].temp", "is": 18.5 } },
				{ "expect": { "state": "rooms[3].temp", "is": 22 } }
			]
		},
		{
			"name": "motion-alerts-while-away",
			"note": "While away, the simulated service reports motion in the hall every fourth tick",
			"steps": [
				{ "key": "mod+shift+a" },
				{ "key": "mod+shift+a" },
				{ "expect": { "state": "security", "is": "away" } },
				{ "wait": 40100 },
				{ "expect": { "state": "notifications[0].message", "is": "Motion in the hall while away" } }
			]
		},
		{
			"name": "arabic-reads-right-to-left",
			"note": "Cmd+L twice switches to Arabic: the page title and the sidebar read in Arabic; once more is English again",
			"steps": [
				{ "key": "mod+l" },
				{ "expect": { "node": "#languageButton", "text": "IT" } },
				{ "key": "mod+l" },
				{ "expect": { "node": "#languageButton", "text": "AR" } },
				{ "expect": { "node": "#navItem", "nth": 0, "property": "name", "is": "المنزل" } },
				{ "key": "mod+l" },
				{ "expect": { "node": "#languageButton", "text": "EN" } }
			]
		},
		{
			"name": "small-dark-window",
			"note": "Regression: at 1040 by 640 in the dark theme the sidebar's energy card makes room, the lights card ends before the climate card, and the devices stay usable",
			"steps": [
				{ "resize": [1040, 640] },
				{ "key": "mod+t" },
				{ "expect": { "node": "#energy", "exists": false } },
				{ "expect": { "node": "#lightsCard", "property": "x", "is": 280 } },
				{ "expect": { "node": "#lightsCard", "property": "width", "is": 355.5999755859375 } },
				{ "expect": { "node": "#climateCard", "property": "x", "is": 651.5999755859375, "note": "16 after the lights card" } },
				{ "click": "#deviceAction", "nth": 1 },
				{ "expect": { "state": "devices[1].busy", "is": true } }
			]
		},
		{
			"name": "haven-palette-runs-a-command",
			"note": "Cmd+K opens the command palette; typing filters it and Enter runs the command",
			"steps": [
				{ "key": "mod+k" },
				{ "wait": 100 },
				{ "type": "floor plan" },
				{ "key": "enter" },
				{ "expect": { "state": "page", "is": "plan" } }
			]
		},
		{
			"name": "keyboard-only-language",
			"note": "Tab reaches the language button and Enter presses it",
			"steps": [
				{ "key": "tab" },
				{ "wait": 50 },
				{ "key": "tab" },
				{ "wait": 50 },
				{ "expect": { "node": "#languageButton", "property": "focused", "is": true } },
				{ "key": "enter" },
				{ "expect": { "node": "#languageButton", "text": "IT" } }
			]
		},
		{
			"name": "arrows-at-start-change-the-target",
			"note": "Regression: the closed quick pick's field took the focus at start and swallowed Up and Down",
			"steps": [
				{ "key": "up" },
				{ "expect": { "state": "rooms[0].target", "is": 22.5 } },
				{ "key": "down" },
				{ "key": "down" },
				{ "expect": { "state": "rooms[0].target", "is": 21.5 } }
			]
		},
		{
			"name": "blinds-slider-on-the-first-frame",
			"note": "Regression: the blinds slider anchored to a button laid out after it, so the first frame had no slider",
			"steps": [
				{ "expect": { "node": "#blinds", "property": "width", "is": 172.4000244140625 } }
			]
		}
	]
}
