{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Haven: a smart-home dashboard. Rooms in a tree by floor, scenes, lights (switch, dim), climate, blinds, device tiles whose calls take a while (progress, then a toast), an energy page with charts and a table, and a settings page from the settings schema; a light and a dark theme.",
	"include": ["../shared/components/charts.json"],

	"window": { "title": "Haven: an AffrescoUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 15, "fallback": ["icons"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["iconsSmall"] },
		"heading": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 17, "fallback": ["icons"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 26, "fallback": ["iconsLarge"] },
		"figure": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 48 },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 18 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 13 },
		"iconsLarge": { "file": "../shared/fonts/Lucide.ttf", "size": 26 }
	},

	"theme": "{{state.theme}}",
	"colors": {
		"background": { "dark": "#0b1020", "light": "#eef2f7" },
		"sidebar": { "dark": "#0f1529", "light": "#ffffff" },
		"card": { "dark": "#161d33", "light": "#ffffff" },
		"cardHover": { "dark": "#1c2440", "light": "#f1f5f9" },
		"raised": { "dark": "#222b48", "light": "#e7ecf3" },
		"raisedHover": { "dark": "#2b355a", "light": "#d8e0ea" },
		"text": { "dark": "#e5e9f5", "light": "#0f172a" },
		"muted": { "dark": "#8b93ad", "light": "#64748b" },
		"border": { "dark": "#232b45", "light": "#e2e8f0" },
		"accent": { "dark": "#22d3ee", "light": "#0891b2" },
		"accentSoft": { "dark": "#0e3a4a", "light": "#cffafe" },
		"accentFill": { "dark": "#22d3ee40", "light": "#0891b233" },
		"warm": { "dark": "#fbbf24", "light": "#d97706" },
		"warmSoft": { "dark": "#3d3214", "light": "#fef3c7" },
		"off": { "dark": "#3a4363", "light": "#cbd5e1" },
		"selected": { "dark": "#1f2a4a", "light": "#e0f2fe" },
		"field": { "dark": "#0f1529", "light": "#f1f5f9" },
		"knob": { "dark": "#ffffff", "light": "#ffffff" }
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"],
		"budgets": [{"author": "agent", "added": 20, "removed": 5, "changed": 50}]
	},

	"settings": {
		"climate.awayTarget": { "type": "number", "minimum": 12, "maximum": 20, "default": 17, "title": "Away temperature",
		                        "description": "The target the Away scene sets in every room, in degrees." },
		"scenes.blindsMs": { "type": "integer", "minimum": 0, "maximum": 3000, "default": 600, "title": "Blinds speed",
		                     "description": "How long the blinds take to move in a scene, in milliseconds." },
		"energy.dailyBudget": { "type": "integer", "minimum": 5, "maximum": 60, "default": 12, "title": "Daily budget",
		                        "description": "The energy a day should stay under, in kWh, shown on the Energy page." },
		"devices.notify": { "type": "boolean", "default": true, "title": "Device notifications",
		                    "description": "Show a note in the corner when a device has answered." }
	},

	"state": {
		"theme": "dark",
		"page": "home",
		"pages": [
			{ "id": "home", "title": "Home", "icon": "layout-dashboard" },
			{ "id": "energy", "title": "Energy", "icon": "zap" },
			{ "id": "settings", "title": "Settings", "icon": "settings" }
		],
		"room": 0,
		"floorsOpen": ["ground", "upper"],
		"mode": "Heat",
		"modes": ["Heat", "Cool", "Auto"],
		"scene": "",
		"rooms": [
			{
				"name": "Living room",
				"image": "images/living-room.svg",
				"temp": 21.5,
				"target": 22,
				"humidity": 44,
				"blinds": 60,
				"kwh": 21.4,
				"lights": [
					{ "name": "Ceiling", "on": true, "level": 80 },
					{ "name": "Floor lamp", "on": true, "level": 40 },
					{ "name": "TV backlight", "on": false, "level": 30 },
					{ "name": "Shelf strip", "on": false, "level": 60 }
				]
			},
			{
				"name": "Kitchen",
				"image": "images/kitchen.svg",
				"temp": 20.5,
				"target": 21,
				"humidity": 51,
				"blinds": 100,
				"kwh": 17.9,
				"lights": [
					{ "name": "Pendants", "on": true, "level": 90 },
					{ "name": "Under cabinet", "on": false, "level": 70 }
				]
			},
			{
				"name": "Bedroom",
				"image": "images/bedroom.svg",
				"temp": 19,
				"target": 18.5,
				"humidity": 47,
				"blinds": 0,
				"kwh": 6.2,
				"lights": [
					{ "name": "Bedside left", "on": false, "level": 30 },
					{ "name": "Bedside right", "on": false, "level": 30 },
					{ "name": "Wardrobe", "on": false, "level": 100 }
				]
			},
			{
				"name": "Office",
				"image": "images/office.svg",
				"temp": 22,
				"target": 22,
				"humidity": 40,
				"blinds": 80,
				"kwh": 11.6,
				"lights": [
					{ "name": "Desk lamp", "on": true, "level": 100 },
					{ "name": "Ceiling", "on": false, "level": 70 }
				]
			}
		],
		"devices": [
			{ "name": "Front door", "icon": "lock", "iconOff": "lock-open", "on": true, "onText": "Locked", "offText": "Unlocked",
			  "doOn": "Lock", "doOff": "Unlock", "busy": false, "progress": 0 },
			{ "name": "Vacuum", "icon": "bot", "iconOff": "bot", "on": false, "onText": "Cleaning", "offText": "Docked",
			  "doOn": "Start", "doOff": "Dock", "busy": false, "progress": 0 },
			{ "name": "Speaker", "icon": "speaker", "iconOff": "speaker", "on": false, "onText": "Playing", "offText": "Paused",
			  "doOn": "Play", "doOff": "Pause", "busy": false, "progress": 0 }
		],
		"toast": { "open": false, "message": "" },
		"settingsQuery": "",
		"scenes": [
			{ "name": "Morning", "action": "sceneMorning" },
			{ "name": "Movie night", "action": "sceneMovie" },
			{ "name": "Away", "action": "sceneAway" },
			{ "name": "Good night", "action": "sceneNight" }
		],
		"energy": [
			{ "day": "Mon", "kwh": 62 }, { "day": "Tue", "kwh": 55 }, { "day": "Wed", "kwh": 71 }, { "day": "Thu", "kwh": 48 },
			{ "day": "Fri", "kwh": 66 }, { "day": "Sat", "kwh": 83 }, { "day": "Sun", "kwh": 58 }
		],
		"hourly": [0.4, 0.3, 0.3, 0.3, 0.3, 0.4, 0.9, 1.6, 1.4, 0.9, 0.7, 0.8, 1.1, 0.9, 0.7, 0.8, 1.2, 2.1, 2.6, 2.3, 1.8, 1.3, 0.8, 0.5]
	},

	"stateTypes": {
		"theme": {"enum": ["dark", "light"]},
		"page": {"enum": ["home", "energy", "settings"]},
		"pages": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "icon": {"type": "string"}}}},
		"room": {"type": "number"},
		"floorsOpen": {"type": "array", "items": {"type": "string"}},
		"mode": {"type": "string"},
		"modes": {"type": "array", "items": {"type": "string"}},
		"scene": {"type": "string"},
		"rooms": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "image": {"type": "string"}, "temp": {"type": "number"}, "target": {"type": "number"}, "humidity": {"type": "number"}, "blinds": {"type": "number"}, "kwh": {"type": "number"}, "lights": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "on": {"type": "boolean"}, "level": {"type": "number"}}}}}}},
		"devices": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "icon": {"type": "string"}, "iconOff": {"type": "string"}, "on": {"type": "boolean"}, "onText": {"type": "string"}, "offText": {"type": "string"}, "doOn": {"type": "string"}, "doOff": {"type": "string"}, "busy": {"type": "boolean"}, "progress": {"type": "number"}}}},
		"toast": {"type": "object", "properties": {"open": {"type": "boolean"}, "message": {"type": "string"}}},
		"settingsQuery": {"type": "string"},
		"scenes": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "action": {"type": "string"}}}},
		"energy": {"type": "array", "items": {"type": "object", "properties": {"day": {"type": "string"}, "kwh": {"type": "number"}}}},
		"hourly": {"type": "array", "items": {"type": "number"}}
	},

	"computed": {
		"room": "{{state.rooms[state.room]}}",
		"lightsOn": "{{count(computed.room.lights, it.on)}}",
		"energyTotal": "{{sum(state.energy, it.kwh)}}",
		"peakDay": "{{sort(state.energy, it.kwh, 'desc')[0].day}}",
		"weekValues": "{{map(state.energy, it.kwh)}}",
		"today": "{{fixed(sum(state.hourly), 1)}}",
		"peakHour": "{{indexOf(state.hourly, max(state.hourly))}}",
		"busyDevice": "{{find(state.devices, it.busy)}}",
		"floors": "{{[{ id: 'ground', label: 'Ground floor', children: [{ id: 'r0', label: state.rooms[0].name }, { id: 'r1', label: state.rooms[1].name }] }, { id: 'upper', label: 'Upstairs', children: [{ id: 'r2', label: state.rooms[2].name }, { id: 'r3', label: state.rooms[3].name }] }]}}",
		"roomRows": "{{map(state.rooms, { id: it.name, cells: [it.name, fixed(it.kwh, 1) + ' kWh', it.temp + '°', round(it.blinds) + '%'] })}}"
	},

	"styles": {
		"card": { "color": "@card", "radius": 12 },
		"cardTitle": { "type": "label", "font": "heading", "textColor": "@text", "anchors": { "left": 24, "top": 20 }, "fitText": true },
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"button": { "type": "label", "align": "center", "color": "@raised", "radius": 8, "hover": { "color": "@raisedHover" }, "textColor": "@text", "cursor": "hand" },
		"round": { "style": "button", "font": "heading", "width": 44, "height": 44, "radius": 22 },
		"choice": { "style": "button" },
		"choiceOn": { "style": "button", "color": "@accentSoft", "hover": { "color": "@accentSoft" }, "textColor": "@accent" },
		"pageTitle": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 32, "top": 28 }, "fitText": true },
		"stat": { "style": "card", "anchors": { "top": 0, "bottom": 0 }, "grow": 1 },
		"statFigure": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 20, "top": 36 }, "fitText": true }
	},

	"actions": {
		"sceneMorning": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].on", "to": true }, { "set": "state.rooms[state.room].lights[i].level", "to": 80 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 100, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Morning" }
		],
		"sceneMovie": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].level", "to": 20 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 0, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Movie night" }
		],
		"sceneAway": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].target", "to": "{{settings.climate.awayTarget}}" }
			] },
			{ "set": "state.scene", "to": "Away" }
		],
		"sceneNight": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].blinds", "to": 0 }
			] },
			{ "set": "state.scene", "to": "Good night" }
		],
		"setTarget": [
			{ "note": "with: by (degrees)" },
			{ "set": "state.rooms[state.room].target", "to": "{{clamp(computed.room.target + by, 16, 28)}}" }
		],
		"pickRoom": [
			{ "note": "with: id, a row of the rooms tree (r0 to r3; the floors only open and close)" },
			{ "if": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id) >= 0}}", "then": [{ "set": "state.room", "to": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id)}}" }] }
		],
		"deviceCall": [
			{ "note": "with: i. A device call takes a while: the tile shows its progress, then the new state and a toast. A host would make it a call with onAsyncCall; here a timer stands in for the device." },
			{ "if": "{{computed.busyDevice == null}}", "then": [
				{ "set": "state.devices[i].busy", "to": true },
				{ "set": "state.devices[i].progress", "to": 0 },
				{ "animate": "state.devices[i].progress", "to": 1, "ms": 900 },
				{ "after": 900, "do": [
					{ "set": "state.devices[i].busy", "to": false },
					{ "toggle": "state.devices[i].on" },
					{ "if": "{{settings.devices.notify}}", "then": [{ "run": "showToast", "with": {
						"message": "{{state.devices[i].name}}: {{lower(state.devices[i].on ? state.devices[i].onText : state.devices[i].offText)}}" } }] }
				] }
			] }
		],
		"showToast": [
			{ "note": "with: message. A note in the corner for a few seconds" },
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}" } },
			{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
		]
	},

	"keys": {
		"up": { "run": "setTarget", "with": { "by": 0.5 } },
		"down": { "run": "setTarget", "with": { "by": -0.5 } },
		"mod+t": { "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" },
		"mod+1": { "set": "state.page", "to": "home" },
		"mod+2": { "set": "state.page", "to": "energy" },
		"mod+comma": { "set": "state.page", "to": "settings" }
	},

	"root": {
		"id": "panel-root",
		"color": "@background",
		"children": [
			{
				"id": "sidebar",
				"anchors": { "left": 0, "top": 0, "bottom": 0 },
				"width": 248,
				"color": "@sidebar",
				"children": [
					{ "id": "logo", "type": "label", "icon": "home", "text": " Haven", "font": "title", "textColor": "@text", "anchors": { "left": 28, "top": 26 }, "fitText": true },
					{ "id": "label-an-affresco-ui", "style": "caption", "text": "an AffrescoUI template", "anchors": { "left": 28, "top": 64 } },
					{
						"id": "nav",
						"type": "stack",
						"anchors": { "left": 12, "right": 12, "top": 100 },
						"height": 128,
						"gap": 4,
						"children": [
							{
								"id": "navItem",
								"repeat": { "for": "p", "in": "state.pages" },
								"let": { "on": "{{p.id == state.page}}" },
								"type": "label",
								"icon": "{{p.icon}}",
								"text": "    {{p.title}}",
								"anchors": { "left": 0, "right": 0 },
								"height": 40,
								"padding": 16,
								"radius": 8,
								"align": { "horizontal": "start", "vertical": "center" },
								"color": "{{on ? '@selected' : '@sidebar'}}",
								"hover": { "color": "{{on ? '@selected' : '@cardHover'}}" },
								"textColor": "{{on ? '@accent' : '@text'}}",
								"cursor": "hand",
								"onClick": { "set": "state.page", "to": "{{p.id}}" }
							}
						]
					},
					{ "id": "label-rooms", "style": "caption", "text": "ROOMS", "anchors": { "left": 28, "top": 246 } },
					{
						"id": "roomTree",
						"type": "tree",
						"anchors": { "left": 12, "right": 12, "top": 268 },
						"height": 180,
						"rowHeight": 30,
						"color": "@sidebar",
						"items": "{{computed.floors}}",
						"expanded": "{{state.floorsOpen}}",
						"value": "{{'r' + state.room}}",
						"textColor": "@text",
						"selectedTextColor": "@accent",
						"selectedBackground": "@selected",
						"accentColor": "@accent",
						"onChange": { "run": "pickRoom", "with": { "id": "{{event.value}}" } },
						"onExpand": [{ "set": "state.floorsOpen",
							"to": "{{event.expanded ? concat(state.floorsOpen, [event.id]) : filter(state.floorsOpen, it != event.id)}}" }]
					},
					{
						"id": "themeSwitch",
						"anchors": { "left": 28, "right": 28, "top": 468 },
						"height": 24,
						"color": "transparent",
						"tooltip": "Cmd+T",
						"children": [
							{ "id": "label-light-theme", "style": "caption", "text": "Light theme", "anchors": { "left": 0, "top": 5 } },
							{
								"id": "toggle-theme-switch",
								"type": "toggle",
								"anchors": { "right": 0, "top": 0 },
								"width": 44,
								"height": 24,
								"checked": "{{state.theme == 'light'}}",
								"activeColor": "@accent",
								"trackColor": "@off",
								"onChange": { "set": "state.theme", "to": "{{event.value ? 'light' : 'dark'}}" }
							}
						]
					},
					{
						"id": "energy",
						"anchors": { "left": 16, "right": 16, "bottom": 52 },
						"height": 176,
						"style": "card",
						"cursor": "hand",
						"tooltip": "Open the Energy page",
						"onClick": { "set": "state.page", "to": "energy" },
						"children": [
							{ "id": "label-energy-this-week", "style": "caption", "text": "Energy this week", "anchors": { "left": 16, "top": 16 } },
							{ "id": "energyTotal", "type": "label", "text": "{{computed.energyTotal}} kWh", "font": "heading", "textColor": "@text", "anchors": { "left": 16, "top": 36 }, "fitText": true },
							{ "id": "energyBars", "use": "barChart", "with": { "values": "{{computed.weekValues}}", "color": "@accent", "gap": 0.35 },
								"anchors": { "left": 16, "right": 16, "top": 70, "bottom": 34 } },
							{
								"id": "energyDays",
								"type": "row",
								"anchors": { "left": 16, "right": 16, "bottom": 10 },
								"height": 18,
								"children": [
									{
										"id": "label-d-day",
										"repeat": { "for": "d", "in": "state.energy" },
										"type": "label",
										"text": "{{d.day}}",
										"font": "small",
										"textColor": "{{d.day == computed.peakDay ? '@warm' : '@muted'}}",
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"align": "center"
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "main",
				"when": "{{state.page == 'home'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{ "id": "roomImage", "type": "image", "file": "{{computed.room.image}}", "fit": "cover", "radius": 10, "anchors": { "left": 32, "top": 22 }, "width": 112, "height": 66 },
					{
						"id": "greeting",
						"type": "label",
						"text": "{{computed.room.name}}",
						"font": "title",
						"textColor": "@text",
						"anchors": { "left": 164, "top": 26 },
						"fitText": true
					},
					{
						"id": "summary",
						"style": "caption",
						"text": "{{computed.lightsOn}} of {{length(computed.room.lights)}} lights on{{state.scene ? '  ·  scene: ' + state.scene : ''}}",
						"anchors": { "left": 164, "top": 64 }
					},
					{
						"id": "weather",
						"anchors": { "right": 32, "top": 24 },
						"width": 220,
						"height": 60,
						"style": "card",
						"children": [
							{ "id": "weatherIcon", "type": "label", "icon": "cloud-sun", "text": "", "font": "title", "textColor": "@warm", "anchors": { "left": 14, "top": 0, "bottom": 0 }, "width": 30, "align": { "horizontal": "start", "vertical": "center" } },
							{ "id": "label-14", "type": "label", "text": "14°", "font": "title", "textColor": "@warm", "anchors": { "left": 50, "top": 0, "bottom": 0 }, "width": 60, "align": { "horizontal": "start", "vertical": "center" } },
							{ "id": "label-outside", "style": "caption", "text": "Outside", "anchors": { "left": 108, "top": 14 } },
							{ "id": "label-cloudy-light-wind", "style": "caption", "text": "Cloudy, light wind", "textColor": "@text", "anchors": { "left": 108, "top": 31 } }
						]
					},
					{
						"id": "scenes",
						"type": "row",
						"anchors": { "left": 24, "right": 24, "top": 104 },
						"height": 64,
						"children": [
							{
								"id": "scene",
								"repeat": { "for": "scene", "in": "state.scenes" },
								"anchors": { "top": 0, "bottom": 0 },
								"grow": 1,
								"color": "transparent",
								"children": [
									{
										"id": "label-scene-name",
										"type": "label",
										"text": "{{scene.name}}",
										"fill": 8,
										"radius": 10,
										"align": "center",
										"color": "{{scene.name == state.scene ? '@accentSoft' : '@card'}}",
										"hover": { "color": "@cardHover" },
										"textColor": "{{scene.name == state.scene ? '@accent' : '@text'}}",
										"cursor": "hand",
										"onClick": { "run": "{{scene.action}}" }
									}
								]
							}
						]
					},
					{
						"id": "lightsCard",
						"anchors": { "left": 32, "top": 184, "bottom": 24 },
						"width": "48%",
						"style": "card",
						"children": [
							{ "id": "label-lights", "style": "cardTitle", "text": "Lights" },
							{ "id": "label-click-a-light", "style": "caption", "text": "Click to switch, drag to dim", "anchors": { "right": 24, "top": 24 } },
							{
								"id": "lights",
								"type": "stack",
								"anchors": { "left": 16, "right": 16, "top": 64, "bottom": 16 },
								"gap": 8,
								"scroll": "vertical",
								"children": [
									{
										"id": "light",
										"repeat": { "for": "light", "in": "computed.room.lights", "index": "i" },
										"anchors": { "left": 0, "right": 0 },
										"height": 76,
										"radius": 10,
										"color": "{{light.on ? '@warmSoft' : '@raised'}}",
										"hover": { "color": "{{light.on ? '@warmSoft' : '@raisedHover'}}" },
										"transition": { "color": 150 },
										"cursor": "hand",
										"onClick": [{ "toggle": "state.rooms[state.room].lights[i].on" }, { "set": "state.scene", "to": "" }],
										"children": [
											{
												"id": "toggle-rooms-room-lights",
												"type": "toggle",
												"anchors": { "left": 16, "top": 26 },
												"width": 44,
												"height": 24,
												"bind": "state.rooms[state.room].lights[i].on",
												"activeColor": "@warm",
												"trackColor": "@off",
												"knobColor": "@knob",
												"onChange": { "set": "state.scene", "to": "" }
											},
											{ "id": "lightIcon", "type": "label", "icon": "{{light.on ? 'lightbulb' : 'lightbulb-off'}}", "text": "", "textColor": "{{light.on ? '@warm' : '@muted'}}", "anchors": { "left": 76, "top": 0, "bottom": 0 }, "width": 22, "align": { "horizontal": "start", "vertical": "center" } },
											{ "id": "label-light-name", "type": "label", "text": "{{light.name}}", "textColor": "@text", "anchors": { "left": 108, "top": 18 }, "fitText": true },
											{
												"id": "label-light-on-on",
												"style": "caption",
												"text": "{{light.on ? 'On  ·  ' + light.level + '%' : 'Off'}}",
												"textColor": "{{light.on ? '@warm' : '@muted'}}",
												"anchors": { "left": 108, "top": 42 }
											},
											{
												"id": "slider-rooms-room-lights",
												"type": "slider",
												"anchors": { "right": 24, "top": 28 },
												"width": 140,
												"height": 20,
												"min": 10,
												"max": 100,
												"step": 10,
												"bind": "state.rooms[state.room].lights[i].level",
												"trackColor": "@off",
												"activeColor": "{{light.on ? '@warm' : '@muted'}}",
												"knobColor": "@knob",
												"tooltip": "Brightness"
											}
										]
									}
								]
							}
						]
					},
					{
						"id": "climateCard",
						"anchors": { "right": 32, "top": 184 },
						"x": "52%",
						"width": "45%",
						"height": 200,
						"style": "card",
						"children": [
							{ "id": "label-climate", "style": "cardTitle", "icon": "thermometer", "text": " Climate" },
							{ "id": "label-now-room-temp", "style": "caption", "text": "Now {{computed.room.temp}}°  ·  humidity {{computed.room.humidity}}%", "anchors": { "right": 24, "top": 24 } },
							{
								"id": "target",
								"type": "label",
								"text": "{{computed.room.target}}°",
								"font": "figure",
								"textColor": "@accent",
								"anchors": { "left": 0, "right": 0, "top": 50 },
								"height": 64,
								"align": "center"
							},
							{ "id": "label-target", "style": "caption", "text": "target", "anchors": { "left": 0, "right": 0, "top": 114 }, "fitText": false, "height": 16, "align": "center" },
							{ "id": "label-down-arrow", "style": "round", "text": "-", "anchors": { "left": 32, "top": 60 }, "tooltip": "Down arrow", "onClick": { "run": "setTarget", "with": { "by": -0.5 } } },
							{ "id": "label-up-arrow", "style": "round", "text": "+", "anchors": { "right": 32, "top": 60 }, "tooltip": "Up arrow", "onClick": { "run": "setTarget", "with": { "by": 0.5 } } },
							{
								"id": "modes",
								"type": "row",
								"anchors": { "left": 24, "right": 24, "bottom": 18 },
								"height": 36,
								"gap": 8,
								"children": [
									{
										"id": "panel-mode",
										"repeat": { "for": "mode", "in": "state.modes" },
										"style": "{{mode == state.mode ? 'choiceOn' : 'choice'}}",
										"text": "{{mode}}",
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"onClick": { "set": "state.mode", "to": "{{mode}}" }
									}
								]
							}
						]
					},
					{
						"id": "blindsCard",
						"anchors": { "right": 32, "top": 400 },
						"x": "52%",
						"width": "45%",
						"height": 132,
						"style": "card",
						"children": [
							{ "id": "label-blinds", "style": "cardTitle", "icon": "blinds", "text": " Blinds" },
							{ "id": "label-round-room-blinds", "style": "caption", "text": "{{round(computed.room.blinds)}}% open", "anchors": { "right": 24, "top": 24 } },
							{
								"id": "blinds",
								"type": "slider",
								"anchors": { "left": 24, "right": 24, "top": 56 },
								"height": 20,
								"step": 10,
								"bind": "state.rooms[state.room].blinds",
								"trackColor": "@off",
								"activeColor": "@accent",
								"knobColor": "@knob"
							},
							{ "id": "label-close", "style": "button", "text": "Close", "anchors": { "left": 24, "bottom": 16 }, "width": 110, "height": 32, "onClick": { "animate": "state.rooms[state.room].blinds", "to": 0, "ms": 500 } },
							{ "id": "label-open", "style": "button", "text": "Open", "anchors": { "right": 24, "bottom": 16 }, "width": 110, "height": 32, "onClick": { "animate": "state.rooms[state.room].blinds", "to": 100, "ms": 500 } }
						]
					},
					{
						"id": "devicesCard",
						"anchors": { "right": 32, "top": 548, "bottom": 24 },
						"x": "52%",
						"width": "45%",
						"style": "card",
						"children": [
							{ "id": "label-devices", "style": "cardTitle", "icon": "plug", "text": " Devices" },
							{
								"id": "devices",
								"type": "row",
								"anchors": { "left": 16, "right": 16, "top": 56, "bottom": 16 },
								"gap": 10,
								"children": [
									{
										"id": "device",
										"repeat": { "for": "d", "in": "state.devices", "index": "i" },
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"radius": 10,
										"color": "{{d.on ? '@accentSoft' : '@raised'}}",
										"transition": { "color": 150 },
										"children": [
											{ "id": "deviceIcon", "type": "label", "icon": "{{d.on ? d.icon : d.iconOff}}", "text": "", "textColor": "{{d.on ? '@accent' : '@muted'}}", "anchors": { "left": 12, "top": 10 }, "width": 22, "height": 22 },
											{ "id": "deviceName", "type": "label", "text": "{{d.name}}", "textColor": "@text", "anchors": { "left": 40, "top": 12 }, "fitText": true },
											{ "id": "deviceState", "style": "caption", "text": "{{d.busy ? 'Waiting for it…' : (d.on ? d.onText : d.offText)}}", "textColor": "{{d.on ? '@accent' : '@muted'}}", "anchors": { "left": 12, "top": 38 } },
											{
												"id": "deviceAction",
												"style": "button",
												"text": "{{d.busy ? '…' : (d.on ? d.doOff : d.doOn)}}",
												"font": "small",
												"anchors": { "left": 10, "right": 10, "bottom": 10 },
												"height": 26,
												"color": "{{d.on ? '@card' : '@raisedHover'}}",
												"onClick": { "run": "deviceCall", "with": { "i": "{{i}}" } }
											},
											{ "id": "deviceProgress", "when": "{{d.busy}}", "anchors": { "left": 0, "bottom": 0 }, "width": "{{d.progress * 100}}%", "height": 3, "color": "@accent" }
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "energyPage",
				"when": "{{state.page == 'energy'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{ "id": "energyTitle", "style": "pageTitle", "icon": "zap", "text": " Energy" },
					{ "id": "energySummary", "style": "caption", "text": "{{computed.energyTotal}} kWh this week  ·  the most on {{computed.peakDay}}", "anchors": { "left": 32, "top": 66 } },
					{
						"id": "stats",
						"type": "row",
						"anchors": { "left": 32, "right": 32, "top": 104 },
						"height": 88,
						"gap": 16,
						"children": [
							{ "id": "statToday", "style": "stat", "children": [
								{ "id": "label-today", "style": "caption", "text": "Today so far", "anchors": { "left": 20, "top": 16 } },
								{ "id": "todayFigure", "style": "statFigure", "text": "{{computed.today}} kWh" }
							] },
							{ "id": "statBudget", "style": "stat", "children": [
								{ "id": "label-budget", "style": "caption", "text": "Daily budget", "anchors": { "left": 20, "top": 16 } },
								{ "id": "budgetFigure", "style": "statFigure", "text": "{{settings.energy.dailyBudget}} kWh",
									"textColor": "{{number(computed.today) > settings.energy.dailyBudget ? '@warm' : '@text'}}" }
							] },
							{ "id": "statPeak", "style": "stat", "children": [
								{ "id": "label-peak-hour", "style": "caption", "text": "Peak hour", "anchors": { "left": 20, "top": 16 } },
								{ "id": "peakFigure", "style": "statFigure", "text": "{{pad(computed.peakHour, 2)}}:00" }
							] },
							{ "id": "statWeek", "style": "stat", "children": [
								{ "id": "label-week", "style": "caption", "text": "This week", "anchors": { "left": 20, "top": 16 } },
								{ "id": "weekFigure", "style": "statFigure", "text": "{{computed.energyTotal}} kWh" }
							] }
						]
					},
					{
						"id": "hourlyCard",
						"anchors": { "left": 32, "right": 32, "top": 208 },
						"height": 250,
						"style": "card",
						"children": [
							{ "id": "label-today-by-hour", "style": "cardTitle", "text": "Today, hour by hour" },
							{ "id": "label-kwh", "style": "caption", "text": "kWh", "anchors": { "right": 24, "top": 24 } },
							{ "id": "hourlyArea", "use": "areaChart", "with": { "values": "{{state.hourly}}", "color": "@accentFill" },
								"anchors": { "left": 24, "right": 24, "top": 60, "bottom": 40 } },
							{ "id": "hourlyLine", "use": "lineChart", "with": { "values": "{{state.hourly}}", "color": "@accent", "lineWidth": 2 },
								"anchors": { "left": 24, "right": 24, "top": 60, "bottom": 40 } },
							{
								"id": "hours",
								"type": "row",
								"anchors": { "left": 24, "right": 24, "bottom": 12 },
								"height": 18,
								"children": [
									{ "id": "hour", "repeat": { "for": "h", "in": "{{['00:00', '06:00', '12:00', '18:00', '23:00']}}" }, "type": "label", "text": "{{h}}",
										"font": "small", "textColor": "@muted", "anchors": { "top": 0, "bottom": 0 }, "grow": 1,
										"align": { "horizontal": "{{index == 0 ? 'start' : (index == 4 ? 'end' : 'center')}}", "vertical": "center" } }
								]
							}
						]
					},
					{
						"id": "weekCard",
						"anchors": { "left": 32, "top": 474, "bottom": 24 },
						"width": "44%",
						"style": "card",
						"children": [
							{ "id": "label-this-week", "style": "cardTitle", "text": "This week" },
							{ "id": "weekBars", "use": "barChart", "with": { "values": "{{computed.weekValues}}", "color": "@accent", "gap": 0.4 },
								"anchors": { "left": 24, "right": 24, "top": 56, "bottom": 40 } },
							{
								"id": "weekDays",
								"type": "row",
								"anchors": { "left": 24, "right": 24, "bottom": 12 },
								"height": 18,
								"children": [
									{ "id": "weekDay", "repeat": { "for": "d", "in": "state.energy" }, "type": "label", "text": "{{d.day}}", "font": "small",
										"textColor": "{{d.day == computed.peakDay ? '@warm' : '@muted'}}", "anchors": { "top": 0, "bottom": 0 }, "grow": 1, "align": "center" }
								]
							}
						]
					},
					{
						"id": "roomsCard",
						"anchors": { "right": 32, "top": 474, "bottom": 24 },
						"width": "48%",
						"style": "card",
						"children": [
							{ "id": "label-by-room", "style": "cardTitle", "text": "By room, this week" },
							{
								"id": "roomTable",
								"type": "table",
								"anchors": { "left": 12, "right": 12, "top": 52, "bottom": 12 },
								"rowHeight": 30,
								"color": "@card",
								"items": "{{computed.roomRows}}",
								"columns": [
									{ "id": "room", "title": "Room", "width": 150 },
									{ "id": "kwh", "title": "Energy", "width": 100 },
									{ "id": "temp", "title": "Now", "width": 70 },
									{ "id": "blinds", "title": "Blinds", "width": 70 }
								],
								"value": "{{state.rooms[state.room].name}}",
								"textColor": "@text",
								"selectedTextColor": "@text",
								"selectedBackground": "@selected",
								"accentColor": "@accent",
								"onChange": { "set": "state.room", "to": "{{max(indexOf(map(state.rooms, it.name), event.value), 0)}}" },
								"onOpen": { "set": "state.page", "to": "home" }
							}
						]
					}
				]
			},
			{
				"id": "settingsPageView",
				"when": "{{state.page == 'settings'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{ "id": "settingsTitle", "style": "pageTitle", "icon": "settings", "text": " Settings" },
					{ "id": "settingsSummary", "style": "caption", "text": "Every value comes from the settings schema; a changed one can be reset", "anchors": { "left": 32, "top": 66 } },
					{
						"id": "settingsCard",
						"anchors": { "left": 32, "right": 32, "top": 104, "bottom": 24 },
						"style": "card",
						"children": [
							{ "use": "settingsPage", "id": "settingsList", "fill": 8,
								"with": { "search": "{{state.settingsQuery}}", "color": "@card", "textColor": "@text", "dimColor": "@muted", "accent": "@accent", "field": "@field" } }
						]
					}
				]
			},
			{
				"id": "statusBar",
				"anchors": { "left": 248, "right": 0, "bottom": 0 },
				"height": 32,
				"color": "@sidebar",
				"children": [
					{ "id": "panel-status-bar", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"id": "statusText",
						"type": "label",
						"text": "Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "left": 32, "top": 0, "bottom": 0, "right": 200 },
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{
						"id": "statusSize",
						"type": "label",
						"text": "{{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "right": 32, "top": 0, "bottom": 0 },
						"width": 160,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			},
			{
				"id": "toast",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"progress": null,
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			},
			{
				"id": "busyToast",
				"when": "{{computed.busyDevice != null}}",
				"use": "toast",
				"with": {
					"open": true,
					"message": "Waiting for the {{lower(computed.busyDevice.name)}}…",
					"progress": "{{computed.busyDevice.progress}}",
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			}
		]
	}
}
