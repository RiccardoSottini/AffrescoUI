								"children": [
									{ "id": "hour", "repeat": { "for": "h", "in": "{{['00:00', '06:00', '12:00', '18:00', '23:00']}}" }, "type": "label", "text": "{{h}}",
										"font": "small", "textColor": "@muted", "anchors": { "top": 0, "bottom": 0 }, "grow": 1,
										"align": { "horizontal": "{{index == 0 ? 'start' : (index == 4 ? 'end' : 'center')}}", "vertical": "center" } }
								]
							}
						]
					},
					{
						"id": "weekCard",
						"anchors": { "left": 32, "top": "#hourlyCard.bottom + 16", "bottom": 24 },
						"width": "44%",
						"style": "card",
						"children": [
							{ "id": "label-this-week", "style": "cardTitle", "text": "{{state.energyView == 'day' ? t('week.byDay') : t('week.byDevice')}}" },
							{
								"id": "energyViews",
								"type": "row",
								"anchors": { "right": 16, "top": 14 },
								"width": 172,
								"height": 28,
								"gap": 4,
								"role": "toolbar",
								"arrows": "horizontal",
								"children": [
									{ "id": "energyByDay", "style": "{{state.energyView == 'day' ? 'choiceOn' : 'choice'}}", "font": "small", "text": "{{t('week.dayButton')}}", "grow": 1,
										"anchors": { "top": 0, "bottom": 0 }, "selected": "{{state.energyView == 'day'}}", "onClick": { "set": "state.energyView", "to": "day" } },
									{ "id": "energyByDevice", "style": "{{state.energyView == 'device' ? 'choiceOn' : 'choice'}}", "font": "small", "text": "{{t('week.deviceButton')}}", "grow": 1,
										"anchors": { "top": 0, "bottom": 0 }, "selected": "{{state.energyView == 'device'}}", "onClick": { "set": "state.energyView", "to": "device" } }
								]
							},
							{ "id": "weekBars", "use": "barChart", "with": { "values": "{{state.energyView == 'day' ? computed.weekValues : computed.deviceValues}}", "color": "{{state.energyView == 'day' ? '@accent' : '@warm'}}", "gap": 0.4 },
								"anchors": { "left": 24, "right": 24, "top": 56, "bottom": 36 }, "role": "img",
								"label": "{{state.energyView == 'day' ? t('week.byDay') : t('week.byDevice')}}" },
							{
								"id": "weekDays",
								"type": "row",
								"anchors": { "left": 24, "right": 24, "bottom": 10 },
								"height": 18,
								"children": [
									{ "id": "weekDay", "when": "{{state.energyView == 'day'}}", "repeat": { "for": "d", "in": "state.energy" }, "type": "label", "text": "{{t('day.' + d.day)}}", "font": "small",
										"textColor": "{{d.day == computed.peakDay ? '@warm' : '@muted'}}", "anchors": { "top": 0, "bottom": 0 }, "grow": 1, "align": "center" },
									{ "id": "weekDevice", "when": "{{state.energyView == 'device'}}", "repeat": { "for": "d", "in": "state.deviceEnergy" }, "type": "label", "text": "{{t('use.' + d.id)}}", "font": "small",
										"tooltip": "{{t('use.' + d.id)}}: {{d.kwh}} kWh", "textColor": "@muted", "anchors": { "top": 0, "bottom": 0 }, "grow": 1, "align": "center" }
								]
							}
						]
					},
					{
						"id": "roomsCard",
						"anchors": { "left": "#weekCard.right + 16", "right": 32, "top": "#hourlyCard.bottom + 16", "bottom": 24 },
						"style": "card",
						"children": [
							{ "id": "label-by-room", "style": "cardTitle", "text": "{{t('byRoom.title')}}" },
							{
								"id": "roomTable",
								"type": "table",
								"anchors": { "left": 12, "right": 12, "top": 52, "bottom": 12 },
								"rowHeight": 30,
								"color": "@card",
								"items": "{{computed.roomRows}}",
								"columns": "{{computed.roomColumns}}",
								"value": "{{state.rooms[state.room].name}}",
								"label": "{{t('byRoom.title')}}",
								"textColor": "@text",
								"selectedTextColor": "@text",
								"selectedBackground": "@selected",
								"accentColor": "@accent",
								"onChange": { "set": "state.room", "to": "{{max(indexOf(map(state.rooms, it.name), event.value), 0)}}" },
								"onOpen": { "set": "state.page", "to": "home" }
							}
						]
					}
				]
			},
			{ "id": "planPage", "when": "{{state.page == 'plan'}}", "use": "planPage", "anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 } },
			{ "id": "automationsPage", "when": "{{state.page == 'automations'}}", "use": "automationsPage", "anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 } },
			{
				"id": "settingsPageView",
				"when": "{{state.page == 'settings'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{ "id": "settingsTitle", "style": "pageTitle", "icon": "settings", "text": " {{t('page.settings')}}" },
					{ "id": "settingsSummary", "style": "caption", "text": "{{t('settings.summary')}}", "anchors": { "left": 32, "top": 66 } },
					{
						"id": "settingsCard",
						"anchors": { "left": 32, "right": 32, "top": 104, "bottom": 24 },
						"style": "card",
						"children": [
							{ "use": "settingsPage", "id": "settingsList", "fill": 8,
								"with": { "search": "{{state.settingsQuery}}", "color": "@card", "textColor": "@text", "dimColor": "@muted", "accent": "@accent", "field": "@field" } }
						]
					}
				]
			},
			{
				"id": "statusBar",
				"anchors": { "left": 248, "right": 0, "bottom": 0 },
				"height": 32,
				"color": "@sidebar",
				"children": [
					{ "id": "panel-status-bar", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"id": "statusText",
						"type": "label",
						"text": "Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "left": 32, "top": 0, "bottom": 0, "right": 200 },
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{
						"id": "statusSize",
						"type": "label",
						"text": "{{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "right": 32, "top": 0, "bottom": 0 },
						"width": 160,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			},
			{ "id": "colourDialog", "use": "colourDialog" },
			{ "id": "notificationsPanel", "use": "notificationsPanel" },
			{ "id": "simulator", "use": "simulator" },
			{
				"id": "toast",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"progress": null,
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			},
			{
				"id": "busyToast",
				"when": "{{computed.busyDevice != null}}",
				"use": "toast",
				"with": {
					"open": true,
					"message": "{{t('device.busy', { name: lower(computed.busyDevice.name) })}}",
					"progress": "{{computed.busyDevice.progress}}",
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			},
			{
				"id": "quickPick",
				"use": "quickPick",
				"with": {
					"color": "@card",
					"textColor": "@text",
					"dimColor": "@muted",
					"accent": "@accent",
					"highlight": "@accentSoft",
					"field": "@field",
					"providers": [
						{ "prefix": ">", "items": "{{computed.palette}}", "placeholder": "{{t('quick.commands')}}" }
					]
				}
			}
		]
	}
}
