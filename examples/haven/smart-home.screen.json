{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Haven: a smart-home dashboard. Rooms in a tree by floor, scenes, lights (switch, dim, colour), climate, blinds, device tiles whose calls take a while (progress, then a toast), a floor plan on a canvas with media, automations as a node graph with schedules on a timeline, an energy page by day and by device, security modes and notifications, device state from a simulated service, and a settings page from the settings schema; light and dark themes, English, Italian and Arabic. Cmd+1 to Cmd+4 and Cmd+, change the page, Cmd+Shift+P runs a command, Cmd+T switches light and dark, Cmd+L the language, Cmd+Shift+A the security mode, Cmd+Shift+N the notifications, Up and Down the target temperature, Alt and Up or Down the room.",
	"include": ["../shared/components/charts.json", "strings.json", "plan.json", "automations.json", "moreinfo.json", "energy.json"],

	"window": { "title": "Haven: an AffrescoUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"persist": ["state.theme", "state.settings", "state.security"],

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 15, "fallback": ["icons", "symbols", "arabic"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["iconsSmall", "arabicSmall"] },
		"heading": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 17, "fallback": ["icons", "symbols", "arabic"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 26, "fallback": ["iconsLarge", "arabicLarge"] },
		"figure": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 48 },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 18 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 13 },
		"iconsLarge": { "file": "../shared/fonts/Lucide.ttf", "size": 26 },
		"symbols": { "file": "../shared/fonts/JetBrainsMono-Regular.ttf", "size": 14 },
		"arabic": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 15 },
		"arabicSmall": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 12 },
		"arabicLarge": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 26 }
	},

	"theme": "{{state.theme}}",
	"colors": {
		"background": { "dark": "#111111", "light": "#fafafa" },
		"sidebar": { "dark": "#1c1c1c", "light": "#ffffff" },
		"header": { "dark": "#101e24", "light": "#03a9f4" },
		"onHeader": { "dark": "#e1e1e1", "light": "#ffffff" },
		"card": { "dark": "#1c1c1c", "light": "#ffffff" },
		"cardHover": { "dark": "#262626", "light": "#f5f5f5" },
		"raised": { "dark": "#2a2a2a", "light": "#f0f0f0" },
		"raisedHover": { "dark": "#343434", "light": "#e5e5e5" },
		"text": { "dark": "#e1e1e1", "light": "#212121" },
		"muted": { "dark": "#9b9b9b", "light": "#727272" },
		"border": { "dark": "#2f2f2f", "light": "#e0e0e0" },
		"divider": { "dark": "#2f2f2f", "light": "#e0e0e0" },
		"primary": { "dark": "#03a9f4", "light": "#03a9f4" },
		"accent": { "dark": "#03a9f4", "light": "#0288d1" },
		"accentSoft": { "dark": "#0d2a38", "light": "#e1f5fe" },
		"accentFill": { "dark": "#03a9f440", "light": "#03a9f433" },
		"warm": { "dark": "#ffc107", "light": "#f5a300" },
		"warmSoft": { "dark": "#33290d", "light": "#fff8e1" },
		"alert": { "dark": "#f44336", "light": "#db4437" },
		"alertSoft": { "dark": "#3d1513", "light": "#fdecea" },
		"off": { "dark": "#4a4a4a", "light": "#bdbdbd" },
		"selected": { "dark": "#0d2a38", "light": "#e1f5fe" },
		"field": { "dark": "#262626", "light": "#f5f5f5" },
		"knob": { "dark": "#ffffff", "light": "#ffffff" },
		"plan": { "dark": "#161616", "light": "#ffffff" },
		"cover": { "dark": "#926bc7", "light": "#926bc7" },
		"grid": { "dark": "#488fc2", "light": "#488fc2" },
		"gridOut": { "dark": "#8353d1", "light": "#8353d1" },
		"solar": { "dark": "#ff9800", "light": "#ff9800" },
		"media": { "dark": "#03a9f4", "light": "#03a9f4" },
		"kit.surface": { "dark": "#1c1c1c", "light": "#ffffff" },
		"kit.text": { "dark": "#e1e1e1", "light": "#212121" },
		"kit.dim": { "dark": "#9b9b9b", "light": "#727272" },
		"kit.selection": { "dark": "#2a2a2a", "light": "#f0f0f0" },
		"kit.border": { "dark": "#2f2f2f", "light": "#e0e0e0" },
		"kit.primary": { "dark": "#03a9f4", "light": "#0288d1" },
		"kit.onPrimary": { "dark": "#ffffff", "light": "#ffffff" },
		"kit.secondary": { "dark": "#2a2a2a", "light": "#f0f0f0" },
		"kit.onSecondary": { "dark": "#e1e1e1", "light": "#212121" },
		"kit.accent": { "dark": "#03a9f4", "light": "#0288d1" },
		"kit.field": { "dark": "#262626", "light": "#f5f5f5" },
		"kit.focus": { "dark": "#03a9f4", "light": "#0288d1" },
		"kit.backdrop": { "dark": "#00000052", "light": "#00000052" }
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"],
		"budgets": [{"author": "agent", "added": 20, "removed": 5, "changed": 50}]
	},

	"settings": {
		"climate.awayTarget": { "type": "number", "minimum": 12, "maximum": 20, "default": 17, "title": "Away temperature",
		                        "description": "The target the Away scene sets in every room, in degrees." },
		"scenes.blindsMs": { "type": "integer", "minimum": 0, "maximum": 3000, "default": 600, "title": "Blinds speed",
		                     "description": "How long the blinds take to move in a scene, in milliseconds." },
		"energy.dailyBudget": { "type": "integer", "minimum": 5, "maximum": 60, "default": 12, "title": "Daily budget",
		                        "description": "The energy a day should stay under, in kWh, shown on the Energy page." },
		"devices.notify": { "type": "boolean", "default": true, "title": "Device notifications",
		                    "description": "Show a note in the corner when a device has answered." },
		"ui.language": { "type": "string", "enum": ["en", "it", "ar"], "default": "en", "title": "Language",
		                 "description": "English, Italian or Arabic (right to left)." }
	},

	"state": {
		"theme": "light",
		"page": "home",
		"pages": [
			{ "id": "home", "icon": "layout-dashboard", "key": "Cmd+1" },
			{ "id": "energy", "icon": "zap", "key": "Cmd+2" },
			{ "id": "plan", "icon": "map", "key": "Cmd+3" },
			{ "id": "automations", "icon": "workflow", "key": "Cmd+4" },
			{ "id": "settings", "icon": "settings", "key": "Cmd+," }
		],
		"room": 0,
		"floorsOpen": ["ground", "upper"],
		"mode": "Heat",
		"modes": ["Heat", "Cool", "Auto"],
		"scene": "",
		"rooms": [
			{
				"name": "Living room",
				"image": "images/living-room.svg",
				"temp": 21.5,
				"target": 22,
				"humidity": 44,
				"blinds": 60,
				"kwh": 21.4,
				"lights": [
					{ "name": "Ceiling", "on": true, "level": 80, "color": "#ffd58aff" },
					{ "name": "Floor lamp", "on": true, "level": 40, "color": "#ffd58aff" },
					{ "name": "TV backlight", "on": false, "level": 30, "color": "#8ab4ffff" },
					{ "name": "Shelf strip", "on": false, "level": 60, "color": "#ff9ad5ff" }
				]
			},
			{
				"name": "Kitchen",
				"image": "images/kitchen.svg",
				"temp": 20.5,
				"target": 21,
				"humidity": 51,
				"blinds": 100,
				"kwh": 17.9,
				"lights": [
					{ "name": "Pendants", "on": true, "level": 90, "color": "#ffd58aff" },
					{ "name": "Under cabinet", "on": false, "level": 70, "color": "#fff4e0ff" }
				]
			},
			{
				"name": "Bedroom",
				"image": "images/bedroom.svg",
				"temp": 19,
				"target": 18.5,
				"humidity": 47,
				"blinds": 0,
				"kwh": 6.2,
				"lights": [
					{ "name": "Bedside left", "on": false, "level": 30, "color": "#ffc078ff" },
					{ "name": "Bedside right", "on": false, "level": 30, "color": "#ffc078ff" },
					{ "name": "Wardrobe", "on": false, "level": 100, "color": "#fff4e0ff" }
				]
			},
			{
				"name": "Office",
				"image": "images/office.svg",
				"temp": 22,
				"target": 22,
				"humidity": 40,
				"blinds": 80,
				"kwh": 11.6,
				"lights": [
					{ "name": "Desk lamp", "on": true, "level": 100, "color": "#fff4e0ff" },
					{ "name": "Ceiling", "on": false, "level": 70, "color": "#fff4e0ff" }
				]
			}
		],
		"devices": [
			{ "id": "door", "name": "Front door", "icon": "lock", "iconOff": "lock-open", "on": true, "busy": false, "progress": 0 },
			{ "id": "vacuum", "name": "Vacuum", "icon": "bot", "iconOff": "bot", "on": false, "busy": false, "progress": 0 },
			{ "id": "speaker", "name": "Speaker", "icon": "speaker", "iconOff": "speaker", "on": false, "busy": false, "progress": 0 }
		],
		"toast": { "open": false, "message": "" },
		"quickPick": { "open": false, "query": "" },
		"settingsQuery": "",
		"scenes": [
			{ "name": "Morning", "key": "morning", "action": "sceneMorning", "icon": "sunrise" },
			{ "name": "Movie night", "key": "movie", "action": "sceneMovie", "icon": "clapperboard" },
			{ "name": "Away", "key": "away", "action": "sceneAway", "icon": "plane" },
			{ "name": "Good night", "key": "night", "action": "sceneNight", "icon": "moon" }
		],
		"energyView": "day",
		"energy": [
			{ "day": "Mon", "kwh": 62 }, { "day": "Tue", "kwh": 55 }, { "day": "Wed", "kwh": 71 }, { "day": "Thu", "kwh": 48 },
			{ "day": "Fri", "kwh": 66 }, { "day": "Sat", "kwh": 83 }, { "day": "Sun", "kwh": 58 }
		],
		"deviceEnergy": [
			{ "id": "heating", "kwh": 180 }, { "id": "kitchen", "kwh": 92 }, { "id": "lights", "kwh": 46 },
			{ "id": "media", "kwh": 31 }, { "id": "vacuum", "kwh": 9 }, { "id": "other", "kwh": 85 }
		],
		"hourly": [0.4, 0.3, 0.3, 0.3, 0.3, 0.4, 0.9, 1.6, 1.4, 0.9, 0.7, 0.8, 1.1, 0.9, 0.7, 0.8, 1.2, 2.1, 2.6, 2.3, 1.8, 1.3, 0.8, 0.5]
	},

	"stateTypes": {
		"theme": {"enum": ["dark", "light"]},
		"page": {"enum": ["home", "energy", "plan", "automations", "settings"]},
		"pages": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "icon": {"type": "string"}, "key": {"type": "string"}}}},
		"room": {"type": "number"},
		"floorsOpen": {"type": "array", "items": {"type": "string"}},
		"mode": {"type": "string"},
		"modes": {"type": "array", "items": {"type": "string"}},
		"scene": {"type": "string"},
		"rooms": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "image": {"type": "string"}, "temp": {"type": "number"}, "target": {"type": "number"}, "humidity": {"type": "number"}, "blinds": {"type": "number"}, "kwh": {"type": "number"}, "lights": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "on": {"type": "boolean"}, "level": {"type": "number"}, "color": {"type": "string"}}}}}}},
		"devices": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "icon": {"type": "string"}, "iconOff": {"type": "string"}, "on": {"type": "boolean"}, "busy": {"type": "boolean"}, "progress": {"type": "number"}}}},
		"toast": {"type": "object", "properties": {"open": {"type": "boolean"}, "message": {"type": "string"}}},
		"settingsQuery": {"type": "string"},
		"scenes": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "key": {"type": "string"}, "action": {"type": "string"}, "icon": {"type": "string"}}}},
		"energyView": {"enum": ["day", "device", "room"]},
		"energy": {"type": "array", "items": {"type": "object", "properties": {"day": {"type": "string"}, "kwh": {"type": "number"}}}},
		"deviceEnergy": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "kwh": {"type": "number"}}}},
		"hourly": {"type": "array", "items": {"type": "number"}}
	},

	"computed": {
		"room": "{{state.rooms[state.room]}}",
		"lightsOn": "{{count(computed.room.lights, it.on)}}",
		"energyTotal": "{{sum(state.energy, it.kwh)}}",
		"peakDay": "{{sort(state.energy, it.kwh, 'desc')[0].day}}",
		"weekValues": "{{map(state.energy, it.kwh)}}",
		"deviceValues": "{{map(state.deviceEnergy, it.kwh)}}",
		"today": "{{fixed(sum(state.hourly), 1)}}",
		"peakHour": "{{indexOf(state.hourly, max(state.hourly))}}",
		"busyDevice": "{{find(state.devices, it.busy)}}",
		"compact": "{{window.height < 760}}",
		"modeColor": "{{state.mode == 'Heat' ? '#ff6f22' : (state.mode == 'Cool' ? '#2196f3' : '#4caf50')}}",
		"dialShare": "{{clamp((computed.room.target - 16) / 12, 0, 1)}}",
		"coverTint": "{{computed.room.blinds > 0 ? '#926bc733' : '@raised'}}",
		"sceneKey": "{{find(state.scenes, it.name == state.scene).key ?? ''}}",
		"floors": "{{[{ id: 'ground', label: t('floor.ground'), children: [{ id: 'r0', label: state.rooms[0].name }, { id: 'r1', label: state.rooms[1].name }] }, { id: 'upper', label: t('floor.upper'), children: [{ id: 'r2', label: state.rooms[2].name }, { id: 'r3', label: state.rooms[3].name }] }]}}",
		"palette": "{{map(filter(commands, it.enabled), { title: it.title, detail: it.keyLabel ?? it.category, run: it.name })}}"
	},

	"styles": {
		"card": { "color": "@card", "radius": 12, "borderWidth": 1, "borderColor": "@border" },
		"chip": { "type": "label", "font": "small", "textColor": "@text", "color": "@card", "borderWidth": 1, "borderColor": "@border", "radius": 18, "padding": 12,
			"anchors": { "top": 0, "bottom": 0 }, "fitText": true, "align": { "horizontal": "start", "vertical": "center" } },
		"cardTitle": { "type": "label", "font": "heading", "textColor": "@text", "anchors": { "left": 24, "top": 20 }, "fitText": true },
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"button": { "type": "label", "align": "center", "color": "@raised", "radius": 8, "hover": { "color": "@raisedHover" }, "textColor": "@text", "cursor": "hand", "focusable": true },
		"round": { "style": "button", "font": "heading", "width": 44, "height": 44, "radius": 22 },
		"choice": { "style": "button" },
		"choiceOn": { "style": "button", "color": "@accentSoft", "hover": { "color": "@accentSoft" }, "textColor": "@accent" },
		"pageTitle": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 32, "top": 28 }, "fitText": true },
		"stat": { "style": "card", "anchors": { "top": 0, "bottom": 0 }, "grow": 1 },
		"statFigure": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 20, "top": 36 }, "fitText": true }
	},

	"actions": {
		"sceneMorning": { "title": "Scene: Morning", "category": "Scenes", "icon": "sunrise", "do": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].on", "to": true }, { "set": "state.rooms[state.room].lights[i].level", "to": 80 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 100, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Morning" }
		] },
		"sceneMovie": { "title": "Scene: Movie night", "category": "Scenes", "icon": "clapperboard", "do": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].level", "to": 20 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 0, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Movie night" }
		] },
		"sceneAway": { "title": "Scene: Away", "category": "Scenes", "icon": "plane", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].target", "to": "{{settings.climate.awayTarget}}" }
			] },
			{ "set": "state.scene", "to": "Away" }
		] },
		"sceneNight": { "title": "Scene: Good night", "category": "Scenes", "icon": "moon", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].blinds", "to": 0 }
			] },
			{ "set": "state.scene", "to": "Good night" }
		] },
		"setTarget": [
			{ "note": "with: by (degrees)" },
			{ "set": "state.rooms[state.room].target", "to": "{{clamp(computed.room.target + by, 16, 28)}}" }
		],
		"pickRoom": [
			{ "note": "with: id, a row of the rooms tree (r0 to r3; the floors only open and close)" },
			{ "if": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id) >= 0}}", "then": [{ "set": "state.room", "to": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id)}}" }] }
		],
		"deviceCall": [
			{ "note": "with: i. A device call takes a while: the tile shows its progress, then the new state and a toast. A host would make it a call with onAsyncCall; here a timer stands in for the device." },
			{ "if": "{{computed.busyDevice == null}}", "then": [
				{ "set": "state.devices[i].busy", "to": true },
				{ "set": "state.devices[i].progress", "to": 0 },
				{ "animate": "state.devices[i].progress", "to": 1, "ms": 900 },
				{ "after": 900, "do": [
					{ "set": "state.devices[i].busy", "to": false },
					{ "toggle": "state.devices[i].on" },
					{ "if": "{{settings.devices.notify}}", "then": [{ "run": "showToast", "with": {
						"message": "{{t('toast.device', { name: state.devices[i].name, state: lower(t('device.' + state.devices[i].id + (state.devices[i].on ? '.on' : '.off'))) })}}" } }] }
				] }
			] }
		],
		"showToast": [
			{ "note": "with: message. A note in the corner for a few seconds, kept in the notifications too" },
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}" } },
			{ "run": "notify", "with": { "message": "{{message}}", "icon": "bell" } },
			{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
		],
		"stepRoom": [
			{ "note": "with: by, -1 or 1: the previous or next room, wrapping" },
			{ "set": "state.room", "to": "{{(state.room + by + length(state.rooms)) % length(state.rooms)}}" }
		],
		"goHome": { "title": "Go to Home", "category": "Go", "icon": "layout-dashboard", "do": [{ "set": "state.page", "to": "home" }] },
		"goEnergy": { "title": "Go to Energy", "category": "Go", "icon": "zap", "do": [{ "set": "state.page", "to": "energy" }] },
		"goPlan": { "title": "Go to the floor plan", "category": "Go", "icon": "map", "do": [{ "set": "state.page", "to": "plan" }] },
		"goAutomations": { "title": "Go to Automations", "category": "Go", "icon": "workflow", "do": [{ "set": "state.page", "to": "automations" }] },
		"goSettings": { "title": "Go to Settings", "category": "Go", "icon": "settings", "do": [{ "set": "state.page", "to": "settings" }] },
		"commandPalette": { "title": "Show all commands", "category": "Go", "icon": "command",
			"do": [{ "set": "state.quickPick.query", "to": ">" }, { "set": "state.quickPick.open", "to": true }] },
		"toggleTheme": { "title": "Switch light and dark", "category": "View", "icon": "moon",
			"do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },
		"switchLanguage": { "title": "Change the language", "category": "View", "icon": "languages",
			"do": [{ "set": "settings.ui.language", "to": "{{settings.ui.language == 'en' ? 'it' : settings.ui.language == 'it' ? 'ar' : 'en'}}" }] },
		"nextRoom": { "title": "Next room", "category": "Rooms", "icon": "arrow-down", "do": [{ "run": "stepRoom", "with": { "by": 1 } }] },
		"previousRoom": { "title": "Previous room", "category": "Rooms", "icon": "arrow-up", "do": [{ "run": "stepRoom", "with": { "by": -1 } }] },
		"allLightsOff": { "title": "Switch every light off", "category": "Rooms", "icon": "lightbulb-off", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] }
			] },
			{ "set": "state.scene", "to": "" }
		] }
	},

	"keys": {
		"up": { "run": "setTarget", "with": { "by": 0.5 } },
		"down": { "run": "setTarget", "with": { "by": -0.5 } },
		"alt+down": "nextRoom",
		"alt+up": "previousRoom",
		"mod+t": "toggleTheme",
		"mod+l": "switchLanguage",
		"mod+1": "goHome",
		"mod+2": "goEnergy",
		"mod+3": "goPlan",
		"mod+4": "goAutomations",
		"mod+comma": "goSettings",
		"mod+shift+p": "commandPalette",
		"mod+k": "commandPalette",
		"mod+shift+a": "cycleSecurity",
		"mod+shift+n": "toggleNotifications"
	},

	"root": {
		"id": "panel-root",
		"color": "@background",
		"children": [
			{
				"id": "sidebar",
				"dir": "auto",
				"anchors": { "left": 0, "top": 0, "bottom": 0 },
				"width": 248,
				"color": "@sidebar",
				"role": "navigation",
				"children": [
					{ "id": "sidebarHeader", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 56, "color": "transparent", "children": [
						{ "id": "logo", "type": "label", "icon": "home", "text": "  Haven", "font": "heading", "textColor": "@text", "anchors": { "left": 24, "top": 0, "bottom": 0 }, "fitText": true,
							"align": { "horizontal": "start", "vertical": "center" } },
						{ "id": "languageButton", "style": "button", "font": "small", "text": "{{upper(settings.ui.language)}}", "anchors": { "right": 16, "top": 14 }, "width": 40, "height": 28,
							"label": "{{t('language.label')}}", "tooltip": "{{t('language.label')}} (Cmd+L)", "onClick": "switchLanguage" }
					] },
					{ "id": "sidebarRule", "anchors": { "left": 0, "right": 0, "top": 56 }, "height": 1, "color": "@divider" },
					{
						"id": "nav",
						"type": "stack",
						"anchors": { "left": 8, "right": 8, "top": 64 },
						"height": 216,
						"gap": 2,
						"role": "tablist",
						"arrows": "vertical",
						"children": [
							{
								"id": "navItem",
								"repeat": { "for": "p", "in": "state.pages" },
								"let": { "on": "{{p.id == state.page}}" },
								"type": "label",
								"icon": "{{p.icon}}",
								"text": "     {{t('page.' + p.id)}}",
								"anchors": { "left": 0, "right": 0 },
								"height": 40,
								"padding": 16,
								"radius": 8,
								"align": { "horizontal": "start", "vertical": "center" },
								"color": "{{on ? '@selected' : '@sidebar'}}",
								"hover": { "color": "{{on ? '@selected' : '@cardHover'}}" },
								"textColor": "{{on ? '@accent' : '@text'}}",
								"cursor": "hand",
								"focusable": true,
								"role": "tab",
								"selected": "{{on}}",
								"label": "{{t('page.' + p.id)}}",
								"tooltip": "{{p.key}}",
								"onClick": { "set": "state.page", "to": "{{p.id}}" }
							}
						]
					},
					{ "id": "label-rooms", "style": "caption", "text": "{{t('rooms.caption')}}", "anchors": { "left": 24, "top": 300 } },
					{
						"id": "roomTree",
						"type": "tree",
						"anchors": { "left": 12, "right": 12, "top": 322 },
						"height": 180,
						"rowHeight": 30,
						"color": "@sidebar",
						"items": "{{computed.floors}}",
						"expanded": "{{state.floorsOpen}}",
						"value": "{{'r' + state.room}}",
						"label": "{{t('rooms.label')}}",
						"textColor": "@text",
						"selectedTextColor": "@accent",
						"selectedBackground": "@selected",
						"accentColor": "@accent",
						"onChange": { "run": "pickRoom", "with": { "id": "{{event.value}}" } },
						"onExpand": [{ "set": "state.floorsOpen",
							"to": "{{event.expanded ? concat(state.floorsOpen, [event.id]) : filter(state.floorsOpen, it != event.id)}}" }]
					},
					{
						"id": "themeSwitch",
						"anchors": { "left": 24, "right": 24, "top": 514 },
						"height": 24,
						"color": "transparent",
						"tooltip": "Cmd+T",
						"children": [
							{ "id": "label-light-theme", "style": "caption", "text": "{{t('theme.light')}}", "anchors": { "left": 0, "top": 5 } },
							{
								"id": "toggle-theme-switch",
								"type": "toggle",
								"anchors": { "right": 0, "top": 0 },
								"width": 44,
								"height": 24,
								"label": "{{t('theme.light')}}",
								"checked": "{{state.theme == 'light'}}",
								"activeColor": "@accent",
								"trackColor": "@off",
								"onChange": { "set": "state.theme", "to": "{{event.value ? 'light' : 'dark'}}" }
							}
						]
					},
					{
						"id": "energy",
						"when": "{{window.height >= 780}}",
						"anchors": { "left": 16, "right": 16, "bottom": 60 },
						"height": 168,
						"style": "card",
						"cursor": "hand",
						"focusable": true,
						"role": "button",
						"label": "{{t('energy.open')}}",
						"tooltip": "{{t('energy.open')}}",
						"onClick": "goEnergy",
						"children": [
							{ "id": "label-energy-this-week", "style": "caption", "text": "{{t('energy.week')}}", "anchors": { "left": 16, "top": 14 } },
							{ "id": "energyTotal", "type": "label", "text": "{{t('kwh', { n: computed.energyTotal })}}", "font": "heading", "textColor": "@text", "anchors": { "left": 16, "top": 32 }, "fitText": true },
							{ "id": "energyBars", "use": "barChart", "with": { "values": "{{computed.weekValues}}", "color": "@accent", "gap": 0.35 },
								"anchors": { "left": 16, "right": 16, "top": 64, "bottom": 32 } },
							{
								"id": "energyDays",
								"type": "row",
								"anchors": { "left": 16, "right": 16, "bottom": 10 },
								"height": 18,
								"children": [
									{
										"id": "label-d-day",
										"repeat": { "for": "d", "in": "state.energy" },
										"type": "label",
										"text": "{{t('day.' + d.day)}}",
										"font": "small",
										"textColor": "{{d.day == computed.peakDay ? '@warm' : '@muted'}}",
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"align": "center"
									}
								]
							}
						]
					},
					{ "id": "securityBar", "use": "securityBar" },
					{ "id": "sidebarEdge", "anchors": { "right": 0, "top": 0, "bottom": 0 }, "width": 1, "color": "@divider" }
				]
			},
			{
				"id": "main",
				"dir": "auto",
				"when": "{{state.page == 'home'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{
						"id": "toolbar",
						"anchors": { "left": 0, "right": 0, "top": 0 },
						"height": 56,
						"color": "@header",
						"role": "banner",
						"children": [
							{ "id": "greeting", "type": "label", "text": "{{computed.room.name}}", "font": "heading", "textColor": "@onHeader", "anchors": { "left": 24, "top": 0, "bottom": 0 },
								"fitText": true, "align": { "horizontal": "start", "vertical": "center" } },
							{ "id": "searchButton", "type": "label", "icon": "search", "text": "", "textColor": "@onHeader", "anchors": { "right": 64, "top": 8 }, "width": 40, "height": 40, "radius": 20,
								"align": "center", "hover": { "color": "#ffffff22" }, "cursor": "hand", "focusable": true, "role": "button",
								"label": "{{t('toolbar.search')}}", "tooltip": "{{t('toolbar.search')}} (Cmd+K)", "onClick": "commandPalette" },
							{ "id": "editButton", "type": "label", "icon": "pencil", "text": "", "textColor": "@onHeader", "anchors": { "right": 16, "top": 8 }, "width": 40, "height": 40, "radius": 20,
								"align": "center", "hover": { "color": "#ffffff22" }, "cursor": "hand", "focusable": true, "role": "button",
								"label": "{{t('toolbar.edit')}}", "tooltip": "{{t('toolbar.edit')}}", "onClick": { "run": "showToast", "with": { "message": "{{t('toolbar.editSoon')}}" } } }
						]
					},
					{
						"id": "chips",
						"type": "row",
						"anchors": { "left": 24, "right": 24, "top": 68 },
						"height": 36,
						"gap": 8,
						"role": "group",
						"label": "{{t('chips.label')}}",
						"children": [
							{ "id": "summary", "style": "chip", "icon": "lightbulb",
								"text": "  {{t('summary.lights', { on: computed.lightsOn, total: length(computed.room.lights) })}}{{state.scene ? t('summary.scene', { scene: t('scene.' + computed.sceneKey) }) : ''}}" },
							{ "id": "weather", "style": "chip", "icon": "cloud-sun", "text": "  14°  ·  {{t('weather.sky')}}", "label": "{{t('weather.outside')}}: 14°, {{t('weather.sky')}}" },
							{ "id": "climateChip", "style": "chip", "icon": "thermometer", "text": "  {{computed.room.temp}}°  ·  {{computed.room.humidity}}%",
								"label": "{{t('climate.now', { temp: computed.room.temp, humidity: computed.room.humidity })}}" }
						]
					},
					{
						"id": "lightsCard",
						"anchors": { "top": 116, "bottom": 16 },
						"x": 24,
						"width": "{{(window.width - 248) * 0.55 - 64}}",
						"color": "transparent",
						"scroll": "vertical",
						"children": [
							{ "id": "areaCard", "when": "{{!computed.compact}}", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 120, "radius": 12, "color": "@card",
								"role": "group", "label": "{{computed.room.name}}", "children": [
								{ "id": "roomImage", "type": "image", "file": "{{computed.room.image}}", "fit": "cover", "radius": 12, "anchors": { "left": 0, "right": 0, "top": 0, "bottom": 0 }, "label": "{{computed.room.name}}" },
								{ "id": "areaShade", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 44, "color": "#00000088", "radius": 12 },
								{ "id": "areaName", "type": "label", "text": "{{computed.room.name}}", "font": "heading", "textColor": "#ffffff", "anchors": { "left": 16, "bottom": 10 }, "fitText": true },
								{ "id": "areaStats", "type": "label", "font": "small", "textColor": "#ffffff", "icon": "thermometer",
									"text": " {{computed.room.temp}}°   {{computed.room.humidity}}%", "anchors": { "right": 16, "bottom": 13 }, "fitText": true }
							] },
							{ "id": "label-lights", "type": "label", "font": "heading", "textColor": "@text", "text": "{{t('lights.title')}}", "anchors": { "left": 4, "top": "{{computed.compact ? 0 : 136}}" }, "fitText": true },
							{ "id": "label-click-a-light", "style": "caption", "text": "{{t('lights.hint')}}", "anchors": { "right": 4, "top": "{{computed.compact ? 4 : 140}}" } },
							{
								"id": "lights",
								"type": "grid",
								"columns": 2,
								"gap": 8,
								"anchors": { "left": 0, "right": 0, "top": "{{computed.compact ? 30 : 166}}" },
								"height": "{{ceil(length(computed.room.lights) / 2) * 104 - 8}}",
								"role": "list",
								"children": [
									{
										"id": "light",
										"repeat": { "for": "light", "in": "computed.room.lights", "index": "i" },
										"height": 96,
										"radius": 12,
										"color": "@card",
										"borderWidth": 1,
										"borderColor": "@border",
										"hover": { "color": "@cardHover" },
										"transition": { "color": 150 },
										"cursor": "hand",
										"role": "listitem",
										"label": "{{light.name}}",
										"description": "{{t('info.open')}}",
										"onClick": { "run": "openInfo", "with": { "kind": "light", "i": "{{i}}" } },
										"children": [
											{ "id": "lightIcon", "type": "label", "icon": "{{light.on ? 'lightbulb' : 'lightbulb-off'}}", "text": "",
												"textColor": "{{light.on ? slice(light.color, 0, 7) : '@muted'}}", "color": "{{light.on ? slice(light.color, 0, 7) + '33' : '@raised'}}",
												"anchors": { "left": 12, "top": 12 }, "width": 36, "height": 36, "radius": 18, "align": "center",
												"focusable": true, "role": "button", "label": "{{t('light.colour', { name: light.name })}}", "tooltip": "{{t('light.colour', { name: light.name })}}",
												"onClick": { "run": "openColour", "with": { "i": "{{i}}" } } },
											{ "id": "label-light-name", "type": "label", "text": "{{light.name}}", "textColor": "@text", "anchors": { "left": 56, "right": 58, "top": 12 }, "height": 18 },
											{
												"id": "label-light-on-on",
												"style": "caption",
												"text": "{{light.on ? t('light.on', { level: light.level }) : t('light.off')}}",
												"anchors": { "left": 56, "top": 32 }
											},
											{
												"id": "toggle-rooms-room-lights",
												"type": "toggle",
												"anchors": { "right": 12, "top": 18 },
												"width": 40,
												"height": 22,
												"label": "{{light.name}}",
												"bind": "state.rooms[state.room].lights[i].on",
												"activeColor": "@warm",
												"trackColor": "@off",
												"knobColor": "@knob",
												"onChange": { "set": "state.scene", "to": "" }
											},
											{
												"id": "slider-rooms-room-lights",
												"type": "slider",
												"anchors": { "left": 12, "right": 12, "bottom": 12 },
												"height": 20,
												"min": 10,
												"max": 100,
												"step": 10,
												"label": "{{t('light.brightness')}}: {{light.name}}",
												"bind": "state.rooms[state.room].lights[i].level",
												"trackColor": "@off",
												"activeColor": "{{light.on ? '@warm' : '@muted'}}",
												"knobColor": "@knob",
												"tooltip": "{{t('light.brightness')}}"
											}
										]
									}
								]
							},
							{ "id": "label-scenes", "type": "label", "font": "heading", "textColor": "@text", "text": "{{t('scenes.label')}}", "anchors": { "left": 4, "top": "#lights.bottom + 16" }, "fitText": true },
							{
								"id": "scenes",
								"type": "row",
								"anchors": { "left": 0, "right": 0, "top": "#label-scenes.bottom + 10" },
								"height": 76,
								"gap": 8,
								"role": "toolbar",
								"arrows": "horizontal",
								"label": "{{t('scenes.label')}}",
								"children": [
									{
										"id": "scene",
										"repeat": { "for": "scene", "in": "state.scenes" },
										"let": { "on": "{{scene.name == state.scene}}" },
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"basis": 0,
										"radius": 12,
										"color": "{{on ? '@accentSoft' : '@card'}}",
										"borderWidth": 1,
										"borderColor": "{{on ? '@accent' : '@border'}}",
										"hover": { "color": "{{on ? '@accentSoft' : '@cardHover'}}" },
										"cursor": "hand",
										"children": [
											{ "id": "sceneIcon", "type": "label", "icon": "{{scene.icon}}", "text": "", "font": "title", "textColor": "{{on ? '@accent' : '@muted'}}", "anchors": { "left": 0, "right": 0, "top": 12 }, "height": 24, "align": "center" },
											{
												"id": "label-scene-name",
												"type": "label",
												"text": "{{t('scene.' + scene.key)}}",
												"font": "small",
												"anchors": { "left": 4, "right": 4, "top": 0, "bottom": 0 },
												"padding": 10,
												"align": { "horizontal": "center", "vertical": "end" },
												"color": "transparent",
												"textColor": "{{on ? '@accent' : '@text'}}",
												"focusable": true,
												"role": "button",
												"selected": "{{on}}",
												"onClick": { "run": "{{scene.action}}" }
											}
										]
									}
								]
							}
						]
					},
					{
						"id": "climateCard",
						"anchors": { "right": 24, "top": 116 },
						"x": "52%",
						"width": "45%",
						"height": "{{computed.compact ? 228 : 300}}",
						"style": "card",
						"role": "group",
						"label": "{{t('climate.label')}}",
						"children": [
							{ "id": "label-climate", "style": "cardTitle", "icon": "thermometer", "text": " {{t('climate.title')}}", "cursor": "hand", "focusable": true, "role": "button",
								"tooltip": "{{t('info.open')}}", "onClick": { "run": "openInfo", "with": { "kind": "climate", "i": 0 } } },
							{ "id": "label-now-room-temp", "style": "caption", "text": "{{t('climate.now', { temp: computed.room.temp, humidity: computed.room.humidity })}}", "anchors": { "right": 24, "top": 24 } },
							{ "use": "thermoDial", "with": { "p": "", "small": "{{computed.compact}}" }, "id": "dial", "anchors": { "left": 0, "right": 0, "top": 44 } },
							{ "use": "iconBtn", "with": { "icon": "minus", "tip": "climate.down" }, "id": "label-down-arrow", "anchors": { "left": 24, "bottom": "{{computed.compact ? 60 : 72}}" }, "onClick": { "run": "setTarget", "with": { "by": -0.5 } } },
							{ "use": "iconBtn", "with": { "icon": "plus", "tip": "climate.up" }, "id": "label-up-arrow", "anchors": { "right": 24, "bottom": "{{computed.compact ? 60 : 72}}" }, "onClick": { "run": "setTarget", "with": { "by": 0.5 } } },
							{
								"id": "modes",
								"type": "row",
								"anchors": { "left": 0, "right": 0, "bottom": 16 },
								"justify": "center",
								"height": 44,
								"gap": 12,
								"role": "toolbar",
								"arrows": "horizontal",
								"children": [
									{
										"id": "panel-mode",
										"repeat": { "for": "mode", "in": "state.modes" },
										"type": "label",
										"icon": "{{mode == 'Heat' ? 'flame' : (mode == 'Cool' ? 'snowflake' : 'sun-snow')}}",
										"text": "",
										"width": 44,
										"height": 44,
										"radius": 22,
										"align": "center",
										"color": "{{mode == state.mode ? computed.modeColor + '33' : '@raised'}}",
										"hover": { "color": "{{mode == state.mode ? computed.modeColor + '33' : '@raisedHover'}}" },
										"textColor": "{{mode == state.mode ? computed.modeColor : '@muted'}}",
										"cursor": "hand",
										"focusable": true,
										"role": "button",
										"label": "{{t('mode.' + mode)}}",
										"tooltip": "{{t('mode.' + mode)}}",
										"selected": "{{mode == state.mode}}",
										"onClick": { "set": "state.mode", "to": "{{mode}}" }
									}
								]
							}
						]
					},
					{
						"id": "blindsCard",
						"anchors": { "right": 24, "top": "#climateCard.bottom + 12" },
						"x": "52%",
						"width": "45%",
						"height": 96,
						"style": "card",
						"role": "group",
						"label": "{{t('blinds.title')}}",
						"children": [
							{ "id": "blindsIcon", "type": "label", "icon": "blinds", "text": "", "textColor": "@cover", "color": "{{computed.coverTint}}", "anchors": { "left": 12, "top": 12 }, "width": 36, "height": 36, "radius": 18, "align": "center",
								"cursor": "hand", "focusable": true, "role": "button", "label": "{{t('info.cover')}}", "tooltip": "{{t('info.open')}}", "onClick": { "run": "openInfo", "with": { "kind": "cover", "i": 0 } } },
							{ "id": "label-blinds", "type": "label", "text": "{{t('blinds.title')}}", "textColor": "@text", "anchors": { "left": 60, "top": 12 }, "fitText": true,
								"cursor": "hand", "onClick": { "run": "openInfo", "with": { "kind": "cover", "i": 0 } } },
							{ "id": "label-round-room-blinds", "style": "caption", "text": "{{t('blinds.open', { n: round(computed.room.blinds) })}}", "anchors": { "left": 60, "top": 32 } },
							{ "id": "label-open", "type": "label", "icon": "chevron-up", "text": "", "anchors": { "right": 12, "top": 12 }, "width": 36, "height": 36, "radius": 18, "align": "center",
								"color": "@raised", "hover": { "color": "@raisedHover" }, "textColor": "@text", "cursor": "hand", "focusable": true, "role": "button",
								"label": "{{t('blinds.openButton')}}", "tooltip": "{{t('blinds.openButton')}}", "onClick": { "animate": "state.rooms[state.room].blinds", "to": 100, "ms": 500 } },
							{ "id": "label-close", "type": "label", "icon": "chevron-down", "text": "", "anchors": { "right": 56, "top": 12 }, "width": 36, "height": 36, "radius": 18, "align": "center",
								"color": "@raised", "hover": { "color": "@raisedHover" }, "textColor": "@text", "cursor": "hand", "focusable": true, "role": "button",
								"label": "{{t('blinds.close')}}", "tooltip": "{{t('blinds.close')}}", "onClick": { "animate": "state.rooms[state.room].blinds", "to": 0, "ms": 500 } },
							{
								"id": "blinds",
								"type": "slider",
								"anchors": { "left": 12, "right": 12, "bottom": 12 },
								"height": 20,
								"step": 10,
								"label": "{{t('blinds.title')}}",
								"bind": "state.rooms[state.room].blinds",
								"trackColor": "@off",
								"activeColor": "@cover",
								"knobColor": "@knob"
							}
						]
					},
					{
						"id": "devicesCard",
						"anchors": { "right": 24, "top": "#blindsCard.bottom + 12", "bottom": 16 },
						"x": "52%",
						"width": "45%",
						"color": "transparent",
						"role": "group",
						"label": "{{t('devices.title')}}",
						"children": [
							{ "id": "label-devices", "when": "{{!computed.compact}}", "type": "label", "font": "heading", "textColor": "@text", "text": "{{t('devices.title')}}", "anchors": { "left": 4, "top": 4 }, "fitText": true },
							{
								"id": "devices",
								"type": "row",
								"anchors": { "left": 0, "right": 0, "top": "{{computed.compact ? 0 : 34}}" },
								"height": "{{computed.compact ? 96 : 124}}",
								"gap": 8,
								"children": [
									{
										"id": "device",
										"repeat": { "for": "d", "in": "state.devices", "index": "i" },
										"anchors": { "top": 0, "bottom": 0 },
										"grow": 1,
										"basis": 0,
										"radius": 12,
										"color": "@card",
										"borderWidth": 1,
										"borderColor": "@border",
										"hover": { "color": "@cardHover" },
										"cursor": "hand",
										"role": "group",
										"label": "{{d.name}}",
										"onClick": { "run": "openInfo", "with": { "kind": "device", "i": "{{i}}" } },
										"children": [
											{ "id": "deviceIcon", "type": "label", "icon": "{{d.on ? d.icon : d.iconOff}}", "text": "", "textColor": "{{d.on ? '@accent' : '@muted'}}", "color": "{{d.on ? '@accentSoft' : '@raised'}}",
												"anchors": { "left": 10, "top": 12 }, "width": 32, "height": 32, "radius": 16, "align": "center" },
											{ "id": "deviceName", "type": "label", "text": "{{d.name}}", "textColor": "@text", "anchors": { "left": 50, "right": 4, "top": 12 }, "height": 18 },
											{ "id": "deviceState", "style": "caption", "text": "{{d.busy ? t('device.waiting') : t('device.' + d.id + (d.on ? '.on' : '.off'))}}", "anchors": { "left": 50, "top": 32 }, "live": "polite" },
											{
												"id": "deviceAction",
												"style": "button",
												"text": "{{d.busy ? '…' : t('device.' + d.id + (d.on ? '.doOff' : '.doOn'))}}",
												"font": "small",
												"anchors": { "left": 12, "right": 12, "bottom": 12 },
												"height": 28,
												"label": "{{d.name}}: {{d.busy ? t('device.waiting') : t('device.' + d.id + (d.on ? '.doOff' : '.doOn'))}}",
												"onClick": { "run": "deviceCall", "with": { "i": "{{i}}" } }
											},
											{ "id": "deviceProgress", "when": "{{d.busy}}", "anchors": { "left": 0, "bottom": 0 }, "width": "{{d.progress * 100}}%", "height": 3, "color": "@accent" }
										]
									}
								]
							}
						]
					}
				]
			},
			{ "id": "energyPage", "dir": "auto", "when": "{{state.page == 'energy'}}", "use": "energyPage", "anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 } },
			{ "id": "planPage", "when": "{{state.page == 'plan'}}", "use": "planPage", "anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 } },
			{ "id": "automationsPage", "when": "{{state.page == 'automations'}}", "use": "automationsPage", "anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 } },
			{
				"id": "settingsPageView",
				"dir": "auto",
				"when": "{{state.page == 'settings'}}",
				"anchors": { "left": 248, "right": 0, "top": 0, "bottom": 32 },
				"color": "transparent",
				"children": [
					{ "id": "settingsTitle", "style": "pageTitle", "icon": "settings", "text": " {{t('page.settings')}}" },
					{ "id": "settingsSummary", "style": "caption", "text": "{{t('settings.summary')}}", "anchors": { "left": 32, "top": 66 } },
					{
						"id": "settingsCard",
						"anchors": { "left": 32, "right": 32, "top": 104, "bottom": 24 },
						"style": "card",
						"children": [
							{ "use": "settingsPage", "id": "settingsList", "fill": 8,
								"with": { "search": "{{state.settingsQuery}}", "color": "@card", "textColor": "@text", "dimColor": "@muted", "accent": "@accent", "field": "@field" } }
						]
					}
				]
			},
			{
				"id": "statusBar",
				"dir": "auto",
				"anchors": { "left": 248, "right": 0, "bottom": 0 },
				"height": 32,
				"color": "@sidebar",
				"children": [
					{ "id": "panel-status-bar", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"id": "statusText",
						"type": "label",
						"text": "Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "left": 32, "top": 0, "bottom": 0, "right": 200 },
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{
						"id": "statusSize",
						"type": "label",
						"text": "{{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "right": 32, "top": 0, "bottom": 0 },
						"width": 160,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			},
			{ "use": "scrim", "with": { "open": "state.colourOpen" } },
			{ "id": "colourDialog", "use": "colourDialog" },
			{ "use": "scrim", "with": { "open": "state.info.open" } },
			{ "id": "moreInfo", "use": "moreInfo" },
			{ "id": "notificationsPanel", "use": "notificationsPanel" },
			{ "id": "simulator", "use": "simulator" },
			{
				"id": "toast",
				"dir": "auto",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"progress": null,
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			},
			{
				"id": "busyToast",
				"dir": "auto",
				"when": "{{computed.busyDevice != null}}",
				"use": "toast",
				"with": {
					"open": true,
					"message": "{{t('device.busy', { name: lower(computed.busyDevice.name) })}}",
					"progress": "{{computed.busyDevice.progress}}",
					"color": "@raised",
					"textColor": "@text",
					"accent": "@accent"
				}
			},
			{
				"id": "quickPick",
				"dir": "auto",
				"use": "quickPick",
				"with": {
					"highlight": "@accentSoft",
					"providers": [
						{ "prefix": ">", "items": "{{computed.palette}}", "placeholder": "{{t('quick.commands')}}" }
					]
				}
			}
		]
	}
}
