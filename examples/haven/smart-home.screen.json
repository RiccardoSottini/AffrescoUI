{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Haven: a smart-home dashboard. Rooms in a tree by floor, scenes, lights (switch, dim, colour), climate, blinds, device tiles whose calls take a while (progress, then a toast), a floor plan on a canvas with media, automations as a node graph with schedules on a timeline, an energy page by day and by device, security modes and notifications, device state from a simulated service, and a settings page from the settings schema; light and dark themes, English, Italian and Arabic. Cmd+1 to Cmd+4 and Cmd+, change the page, Cmd+Shift+P runs a command, Cmd+T switches light and dark, Cmd+L the language, Cmd+Shift+A the security mode, Cmd+Shift+N the notifications, Up and Down the target temperature, Alt and Up or Down the room.",
	"include": ["../shared/components/charts.json", "strings.json", "plan.json", "automations.json"],

	"window": { "title": "Haven: an AffrescoUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"persist": ["state.theme", "state.settings", "state.security"],

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 15, "fallback": ["icons", "symbols", "arabic"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["iconsSmall", "arabicSmall"] },
		"heading": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 17, "fallback": ["icons", "symbols", "arabic"] },
		"title": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 26, "fallback": ["iconsLarge", "arabicLarge"] },
		"figure": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 48 },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 18 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 13 },
		"iconsLarge": { "file": "../shared/fonts/Lucide.ttf", "size": 26 },
		"symbols": { "file": "../shared/fonts/JetBrainsMono-Regular.ttf", "size": 14 },
		"arabic": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 15 },
		"arabicSmall": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 12 },
		"arabicLarge": { "file": "../shared/fonts/NotoSansArabic-Subset.ttf", "size": 26 }
	},

	"theme": "{{state.theme}}",
	"colors": {
		"background": { "dark": "#0b1020", "light": "#eef2f7" },
		"sidebar": { "dark": "#0f1529", "light": "#ffffff" },
		"card": { "dark": "#161d33", "light": "#ffffff" },
		"cardHover": { "dark": "#1c2440", "light": "#f1f5f9" },
		"raised": { "dark": "#222b48", "light": "#e7ecf3" },
		"raisedHover": { "dark": "#2b355a", "light": "#d8e0ea" },
		"text": { "dark": "#e5e9f5", "light": "#0f172a" },
		"muted": { "dark": "#8b93ad", "light": "#64748b" },
		"border": { "dark": "#232b45", "light": "#e2e8f0" },
		"accent": { "dark": "#22d3ee", "light": "#0891b2" },
		"accentSoft": { "dark": "#0e3a4a", "light": "#cffafe" },
		"accentFill": { "dark": "#22d3ee40", "light": "#0891b233" },
		"warm": { "dark": "#fbbf24", "light": "#d97706" },
		"warmSoft": { "dark": "#3d3214", "light": "#fef3c7" },
		"alert": { "dark": "#f87171", "light": "#dc2626" },
		"alertSoft": { "dark": "#450a0a", "light": "#fee2e2" },
		"off": { "dark": "#3a4363", "light": "#cbd5e1" },
		"selected": { "dark": "#1f2a4a", "light": "#e0f2fe" },
		"field": { "dark": "#0f1529", "light": "#f1f5f9" },
		"knob": { "dark": "#ffffff", "light": "#ffffff" },
		"plan": { "dark": "#10172c", "light": "#f8fafc" },
		"wall": { "dark": "#3a4363", "light": "#94a3b8" },
		"floor": { "dark": "#1a2340", "light": "#ffffff" }
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"],
		"budgets": [{"author": "agent", "added": 20, "removed": 5, "changed": 50}]
	},

	"settings": {
		"climate.awayTarget": { "type": "number", "minimum": 12, "maximum": 20, "default": 17, "title": "Away temperature",
		                        "description": "The target the Away scene sets in every room, in degrees." },
		"scenes.blindsMs": { "type": "integer", "minimum": 0, "maximum": 3000, "default": 600, "title": "Blinds speed",
		                     "description": "How long the blinds take to move in a scene, in milliseconds." },
		"energy.dailyBudget": { "type": "integer", "minimum": 5, "maximum": 60, "default": 12, "title": "Daily budget",
		                        "description": "The energy a day should stay under, in kWh, shown on the Energy page." },
		"devices.notify": { "type": "boolean", "default": true, "title": "Device notifications",
		                    "description": "Show a note in the corner when a device has answered." },
		"ui.language": { "type": "string", "enum": ["en", "it", "ar"], "default": "en", "title": "Language",
		                 "description": "English, Italian or Arabic (right to left)." }
	},

	"state": {
		"theme": "dark",
		"page": "home",
		"pages": [
			{ "id": "home", "icon": "layout-dashboard", "key": "Cmd+1" },
			{ "id": "energy", "icon": "zap", "key": "Cmd+2" },
			{ "id": "plan", "icon": "map", "key": "Cmd+3" },
			{ "id": "automations", "icon": "workflow", "key": "Cmd+4" },
			{ "id": "settings", "icon": "settings", "key": "Cmd+," }
		],
		"room": 0,
		"floorsOpen": ["ground", "upper"],
		"mode": "Heat",
		"modes": ["Heat", "Cool", "Auto"],
		"scene": "",
		"rooms": [
			{
				"name": "Living room",
				"image": "images/living-room.svg",
				"temp": 21.5,
				"target": 22,
				"humidity": 44,
				"blinds": 60,
				"kwh": 21.4,
				"lights": [
					{ "name": "Ceiling", "on": true, "level": 80, "color": "#ffd58aff" },
					{ "name": "Floor lamp", "on": true, "level": 40, "color": "#ffd58aff" },
					{ "name": "TV backlight", "on": false, "level": 30, "color": "#8ab4ffff" },
					{ "name": "Shelf strip", "on": false, "level": 60, "color": "#ff9ad5ff" }
				]
			},
			{
				"name": "Kitchen",
				"image": "images/kitchen.svg",
				"temp": 20.5,
				"target": 21,
				"humidity": 51,
				"blinds": 100,
				"kwh": 17.9,
				"lights": [
					{ "name": "Pendants", "on": true, "level": 90, "color": "#ffd58aff" },
					{ "name": "Under cabinet", "on": false, "level": 70, "color": "#fff4e0ff" }
				]
			},
			{
				"name": "Bedroom",
				"image": "images/bedroom.svg",
				"temp": 19,
				"target": 18.5,
				"humidity": 47,
				"blinds": 0,
				"kwh": 6.2,
				"lights": [
					{ "name": "Bedside left", "on": false, "level": 30, "color": "#ffc078ff" },
					{ "name": "Bedside right", "on": false, "level": 30, "color": "#ffc078ff" },
					{ "name": "Wardrobe", "on": false, "level": 100, "color": "#fff4e0ff" }
				]
			},
			{
				"name": "Office",
				"image": "images/office.svg",
				"temp": 22,
				"target": 22,
				"humidity": 40,
				"blinds": 80,
				"kwh": 11.6,
				"lights": [
					{ "name": "Desk lamp", "on": true, "level": 100, "color": "#fff4e0ff" },
					{ "name": "Ceiling", "on": false, "level": 70, "color": "#fff4e0ff" }
				]
			}
		],
		"devices": [
			{ "id": "door", "name": "Front door", "icon": "lock", "iconOff": "lock-open", "on": true, "busy": false, "progress": 0 },
			{ "id": "vacuum", "name": "Vacuum", "icon": "bot", "iconOff": "bot", "on": false, "busy": false, "progress": 0 },
			{ "id": "speaker", "name": "Speaker", "icon": "speaker", "iconOff": "speaker", "on": false, "busy": false, "progress": 0 }
		],
		"toast": { "open": false, "message": "" },
		"quickPick": { "open": false, "query": "" },
		"settingsQuery": "",
		"scenes": [
			{ "name": "Morning", "key": "morning", "action": "sceneMorning" },
			{ "name": "Movie night", "key": "movie", "action": "sceneMovie" },
			{ "name": "Away", "key": "away", "action": "sceneAway" },
			{ "name": "Good night", "key": "night", "action": "sceneNight" }
		],
		"energyView": "day",
		"energy": [
			{ "day": "Mon", "kwh": 62 }, { "day": "Tue", "kwh": 55 }, { "day": "Wed", "kwh": 71 }, { "day": "Thu", "kwh": 48 },
			{ "day": "Fri", "kwh": 66 }, { "day": "Sat", "kwh": 83 }, { "day": "Sun", "kwh": 58 }
		],
		"deviceEnergy": [
			{ "id": "heating", "kwh": 180 }, { "id": "kitchen", "kwh": 92 }, { "id": "lights", "kwh": 46 },
			{ "id": "media", "kwh": 31 }, { "id": "vacuum", "kwh": 9 }, { "id": "other", "kwh": 85 }
		],
		"hourly": [0.4, 0.3, 0.3, 0.3, 0.3, 0.4, 0.9, 1.6, 1.4, 0.9, 0.7, 0.8, 1.1, 0.9, 0.7, 0.8, 1.2, 2.1, 2.6, 2.3, 1.8, 1.3, 0.8, 0.5]
	},

	"stateTypes": {
		"theme": {"enum": ["dark", "light"]},
		"page": {"enum": ["home", "energy", "plan", "automations", "settings"]},
		"pages": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "icon": {"type": "string"}, "key": {"type": "string"}}}},
		"room": {"type": "number"},
		"floorsOpen": {"type": "array", "items": {"type": "string"}},
		"mode": {"type": "string"},
		"modes": {"type": "array", "items": {"type": "string"}},
		"scene": {"type": "string"},
		"rooms": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "image": {"type": "string"}, "temp": {"type": "number"}, "target": {"type": "number"}, "humidity": {"type": "number"}, "blinds": {"type": "number"}, "kwh": {"type": "number"}, "lights": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "on": {"type": "boolean"}, "level": {"type": "number"}, "color": {"type": "string"}}}}}}},
		"devices": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "icon": {"type": "string"}, "iconOff": {"type": "string"}, "on": {"type": "boolean"}, "busy": {"type": "boolean"}, "progress": {"type": "number"}}}},
		"toast": {"type": "object", "properties": {"open": {"type": "boolean"}, "message": {"type": "string"}}},
		"settingsQuery": {"type": "string"},
		"scenes": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "key": {"type": "string"}, "action": {"type": "string"}}}},
		"energyView": {"enum": ["day", "device"]},
		"energy": {"type": "array", "items": {"type": "object", "properties": {"day": {"type": "string"}, "kwh": {"type": "number"}}}},
		"deviceEnergy": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "kwh": {"type": "number"}}}},
		"hourly": {"type": "array", "items": {"type": "number"}}
	},

	"computed": {
		"room": "{{state.rooms[state.room]}}",
		"lightsOn": "{{count(computed.room.lights, it.on)}}",
		"energyTotal": "{{sum(state.energy, it.kwh)}}",
		"peakDay": "{{sort(state.energy, it.kwh, 'desc')[0].day}}",
		"weekValues": "{{map(state.energy, it.kwh)}}",
		"deviceValues": "{{map(state.deviceEnergy, it.kwh)}}",
		"today": "{{fixed(sum(state.hourly), 1)}}",
		"peakHour": "{{indexOf(state.hourly, max(state.hourly))}}",
		"busyDevice": "{{find(state.devices, it.busy)}}",
		"compact": "{{window.height < 760}}",
		"sceneKey": "{{find(state.scenes, it.name == state.scene).key ?? ''}}",
		"floors": "{{[{ id: 'ground', label: t('floor.ground'), children: [{ id: 'r0', label: state.rooms[0].name }, { id: 'r1', label: state.rooms[1].name }] }, { id: 'upper', label: t('floor.upper'), children: [{ id: 'r2', label: state.rooms[2].name }, { id: 'r3', label: state.rooms[3].name }] }]}}",
		"roomRows": "{{map(state.rooms, { id: it.name, cells: [it.name, fixed(it.kwh, 1) + ' kWh', it.temp + '°', round(it.blinds) + '%'] })}}",
		"roomColumns": "{{[{ id: 'room', title: t('table.room'), width: 150 }, { id: 'kwh', title: t('table.energy'), width: 100 }, { id: 'temp', title: t('table.now'), width: 70 }, { id: 'blinds', title: t('table.blinds'), width: 70 }]}}",
		"palette": "{{map(filter(commands, it.enabled), { title: it.title, detail: it.keyLabel ?? it.category, run: it.name })}}"
	},

	"styles": {
		"card": { "color": "@card", "radius": 12 },
		"cardTitle": { "type": "label", "font": "heading", "textColor": "@text", "anchors": { "left": 24, "top": 20 }, "fitText": true },
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"button": { "type": "label", "align": "center", "color": "@raised", "radius": 8, "hover": { "color": "@raisedHover" }, "textColor": "@text", "cursor": "hand", "focusable": true },
		"round": { "style": "button", "font": "heading", "width": 44, "height": 44, "radius": 22 },
		"choice": { "style": "button" },
		"choiceOn": { "style": "button", "color": "@accentSoft", "hover": { "color": "@accentSoft" }, "textColor": "@accent" },
		"pageTitle": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 32, "top": 28 }, "fitText": true },
		"stat": { "style": "card", "anchors": { "top": 0, "bottom": 0 }, "grow": 1 },
		"statFigure": { "type": "label", "font": "title", "textColor": "@text", "anchors": { "left": 20, "top": 36 }, "fitText": true }
	},

	"actions": {
		"sceneMorning": { "title": "Scene: Morning", "category": "Scenes", "icon": "sunrise", "do": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].on", "to": true }, { "set": "state.rooms[state.room].lights[i].level", "to": 80 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 100, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Morning" }
		] },
		"sceneMovie": { "title": "Scene: Movie night", "category": "Scenes", "icon": "clapperboard", "do": [
			{ "forEach": "computed.room.lights", "index": "i", "do": [{ "set": "state.rooms[state.room].lights[i].level", "to": 20 }] },
			{ "animate": "state.rooms[state.room].blinds", "to": 0, "ms": "{{settings.scenes.blindsMs}}" },
			{ "set": "state.scene", "to": "Movie night" }
		] },
		"sceneAway": { "title": "Scene: Away", "category": "Scenes", "icon": "plane", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].target", "to": "{{settings.climate.awayTarget}}" }
			] },
			{ "set": "state.scene", "to": "Away" }
		] },
		"sceneNight": { "title": "Scene: Good night", "category": "Scenes", "icon": "moon", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] },
				{ "set": "state.rooms[r].blinds", "to": 0 }
			] },
			{ "set": "state.scene", "to": "Good night" }
		] },
		"setTarget": [
			{ "note": "with: by (degrees)" },
			{ "set": "state.rooms[state.room].target", "to": "{{clamp(computed.room.target + by, 16, 28)}}" }
		],
		"pickRoom": [
			{ "note": "with: id, a row of the rooms tree (r0 to r3; the floors only open and close)" },
			{ "if": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id) >= 0}}", "then": [{ "set": "state.room", "to": "{{indexOf(['r0', 'r1', 'r2', 'r3'], id)}}" }] }
		],
		"deviceCall": [
			{ "note": "with: i. A device call takes a while: the tile shows its progress, then the new state and a toast. A host would make it a call with onAsyncCall; here a timer stands in for the device." },
			{ "if": "{{computed.busyDevice == null}}", "then": [
				{ "set": "state.devices[i].busy", "to": true },
				{ "set": "state.devices[i].progress", "to": 0 },
				{ "animate": "state.devices[i].progress", "to": 1, "ms": 900 },
				{ "after": 900, "do": [
					{ "set": "state.devices[i].busy", "to": false },
					{ "toggle": "state.devices[i].on" },
					{ "if": "{{settings.devices.notify}}", "then": [{ "run": "showToast", "with": {
						"message": "{{t('toast.device', { name: state.devices[i].name, state: lower(t('device.' + state.devices[i].id + (state.devices[i].on ? '.on' : '.off'))) })}}" } }] }
				] }
			] }
		],
		"showToast": [
			{ "note": "with: message. A note in the corner for a few seconds, kept in the notifications too" },
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}" } },
			{ "run": "notify", "with": { "message": "{{message}}", "icon": "bell" } },
			{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
		],
		"stepRoom": [
			{ "note": "with: by, -1 or 1: the previous or next room, wrapping" },
			{ "set": "state.room", "to": "{{(state.room + by + length(state.rooms)) % length(state.rooms)}}" }
		],
		"goHome": { "title": "Go to Home", "category": "Go", "icon": "layout-dashboard", "do": [{ "set": "state.page", "to": "home" }] },
		"goEnergy": { "title": "Go to Energy", "category": "Go", "icon": "zap", "do": [{ "set": "state.page", "to": "energy" }] },
		"goPlan": { "title": "Go to the floor plan", "category": "Go", "icon": "map", "do": [{ "set": "state.page", "to": "plan" }] },
		"goAutomations": { "title": "Go to Automations", "category": "Go", "icon": "workflow", "do": [{ "set": "state.page", "to": "automations" }] },
		"goSettings": { "title": "Go to Settings", "category": "Go", "icon": "settings", "do": [{ "set": "state.page", "to": "settings" }] },
		"commandPalette": { "title": "Show all commands", "category": "Go", "icon": "command",
			"do": [{ "set": "state.quickPick.query", "to": ">" }, { "set": "state.quickPick.open", "to": true }] },
		"toggleTheme": { "title": "Switch light and dark", "category": "View", "icon": "moon",
			"do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },
		"switchLanguage": { "title": "Change the language", "category": "View", "icon": "languages",
			"do": [{ "set": "settings.ui.language", "to": "{{settings.ui.language == 'en' ? 'it' : settings.ui.language == 'it' ? 'ar' : 'en'}}" }] },
		"nextRoom": { "title": "Next room", "category": "Rooms", "icon": "arrow-down", "do": [{ "run": "stepRoom", "with": { "by": 1 } }] },
		"previousRoom": { "title": "Previous room", "category": "Rooms", "icon": "arrow-up", "do": [{ "run": "stepRoom", "with": { "by": -1 } }] },
		"allLightsOff": { "title": "Switch every light off", "category": "Rooms", "icon": "lightbulb-off", "do": [
			{ "forEach": "state.rooms", "index": "r", "do": [
				{ "forEach": "state.rooms[r].lights", "index": "i", "do": [{ "set": "state.rooms[r].lights[i].on", "to": false }] }
			] },
			{ "set": "state.scene", "to": "" }
		] }
	},

	"keys": {
		"up": { "run": "setTarget", "with": { "by": 0.5 } },
		"down": { "run": "setTarget", "with": { "by": -0.5 } },
		"alt+down": "nextRoom",
		"alt+up": "previousRoom",
		"mod+t": "toggleTheme",
		"mod+l": "switchLanguage",
		"mod+1": "goHome",
		"mod+2": "goEnergy",
		"mod+3": "goPlan",
		"mod+4": "goAutomations",
		"mod+comma": "goSettings",
		"mod+shift+p": "commandPalette",
		"mod+k": "commandPalette",
		"mod+shift+a": "cycleSecurity",
		"mod+shift+n": "toggleNotifications"
	},

	"root": {
		"id": "panel-root",
		"color": "@background",
		"children": [
			{
				"id": "sidebar",
				"anchors": { "left": 0, "top": 0, "bottom": 0 },
				"width": 248,
				"color": "@sidebar",
				"role": "navigation",
				"children": [
					{ "id": "logo", "type": "label", "icon": "home", "text": " Haven", "font": "title", "textColor": "@text", "anchors": { "left": 28, "top": 26 }, "fitText": true },
					{ "id": "languageButton", "style": "button", "font": "small", "text": "{{upper(settings.ui.language)}}", "anchors": { "right": 16, "top": 28 }, "width": 40, "height": 28,
						"label": "{{t('language.label')}}", "tooltip": "{{t('language.label')}} (Cmd+L)", "onClick": "switchLanguage" },
					{ "id": "label-an-affresco-ui", "style": "caption", "text": "{{t('app.tagline')}}", "anchors": { "left": 28, "top": 64 } },
					{
						"id": "nav",
						"type": "stack",
						"anchors": { "left": 12, "right": 12, "top": 100 },
						"height": 188,
						"gap": 2,
						"role": "tablist",
						"arrows": "vertical",
						"children": [
							{
								"id": "navItem",
								"repeat": { "for": "p", "in": "state.pages" },
								"let": { "on": "{{p.id == state.page}}" },
								"type": "label",
								"icon": "{{p.icon}}",
								"text": "    {{t('page.' + p.id)}}",
								"anchors": { "left": 0, "right": 0 },
								"height": 36,
