{
	"note": "Haven's shell, included by smart-home.screen.json: the sidebar's entries (open or folded to icons), the rooms as view tabs in the top bar, the entity search, and the alarm tile with its keypad.",

	"state": {
		"sidebarCollapsed": false,
		"alarmCode": ""
	},

	"computed": {
		"sideWidth": "{{state.sidebarCollapsed ? 56 : 256}}",
		"navPages": "{{filter(state.pages, it.id != 'settings')}}",
		"alarmColor": "{{state.security == 'off' ? '@ok' : '@alert'}}",
		"entities": "{{concat(computed.lightEntities, map(state.rooms, { title: t('info.climate'), detail: it.name, run: 'openEntity', with: { room: index, kind: 'climate', i: 0 } }), map(state.rooms, { title: t('info.cover'), detail: it.name, run: 'openEntity', with: { room: index, kind: 'cover', i: 0 } }), map(state.devices, { title: it.name, detail: t('info.home'), run: 'openEntity', with: { room: null, kind: 'device', i: index } }), [{ title: t('alarm.title'), detail: t('info.home'), run: 'openEntity', with: { room: null, kind: 'alarm', i: 0 } }])}}",
		"lightEntities": "{{concat(map(state.rooms[0].lights, { title: it.name, detail: state.rooms[0].name, run: 'openEntity', with: { room: 0, kind: 'light', i: index } }), map(state.rooms[1].lights, { title: it.name, detail: state.rooms[1].name, run: 'openEntity', with: { room: 1, kind: 'light', i: index } }), map(state.rooms[2].lights, { title: it.name, detail: state.rooms[2].name, run: 'openEntity', with: { room: 2, kind: 'light', i: index } }), map(state.rooms[3].lights, { title: it.name, detail: state.rooms[3].name, run: 'openEntity', with: { room: 3, kind: 'light', i: index } }))}}"
	},

	"actions": {
		"openEntity": [
			{ "note": "with: room (null keeps the room shown), kind and i: picks the room, then opens that entity's more-info" },
			{ "if": "{{room != null}}", "then": [{ "set": "state.room", "to": "{{room}}" }] },
			{ "run": "openInfo", "with": { "kind": "{{kind}}", "i": "{{i}}" } }
		],
		"searchEntities": { "title": "Search entities", "category": "Go", "icon": "search",
			"do": [{ "set": "state.quickPick.query", "to": "" }, { "set": "state.quickPick.open", "to": true }] },
		"toggleSidebar": { "title": "Fold the sidebar", "category": "View", "icon": "panel-left",
			"do": [{ "toggle": "state.sidebarCollapsed" }] },
		"armAlarm": [
			{ "note": "with: mode (off, home or away). Disarming takes the code typed on the keypad, any four digits or more here, as the simulated panel has no stored code" },
			{ "if": "{{mode == 'off' && state.security != 'off' && length(state.alarmCode) < 4}}",
				"then": [{ "run": "showToast", "with": { "message": "{{t('alarm.needCode')}}" } }],
				"else": [
					{ "set": "state.security", "to": "{{mode}}" },
					{ "set": "state.alarmCode", "to": "" },
					{ "run": "notify", "with": { "message": "{{t('security.changed', { mode: t('security.' + mode) })}}", "icon": "shield" } }
				] }
		]
	},

	"components": {
		"sideItem": {
			"note": "A sidebar entry: its icon, its title while the sidebar is open, and a count of what waits",
			"params": { "icon": "", "title": "", "selected": false, "keyLabel": "", "badge": 0 },
			"node": {
				"anchors": { "left": 0, "right": 0 }, "height": 40, "radius": 4,
				"color": "{{selected ? '@selected' : '@sidebar'}}", "hover": { "color": "{{selected ? '@selected' : '@cardHover'}}" },
				"cursor": "hand", "focusable": true, "selected": "{{selected}}", "label": "{{title}}",
				"tooltip": "{{state.sidebarCollapsed ? title + (keyLabel ? ' (' + keyLabel + ')' : '') : keyLabel}}",
				"children": [
					{ "type": "label", "font": "iconsMedium", "icon": "{{icon}}", "text": "", "textColor": "{{selected ? '@accent' : '@muted'}}", "anchors": { "left": 8, "top": 8 },
						"width": 24, "height": 24, "align": "center" },
					{ "when": "{{!state.sidebarCollapsed}}", "type": "label", "text": "{{title}}", "textColor": "{{selected ? '@accent' : '@text'}}",
						"anchors": { "left": 52, "right": 40, "top": 0, "bottom": 0 }, "align": { "horizontal": "start", "vertical": "center" } },
					{ "when": "{{badge > 0}}", "type": "label", "font": "small", "text": "{{min(badge, 9)}}", "textColor": "@knob", "color": "@accent",
						"anchors": { "left": "{{state.sidebarCollapsed ? 22 : 196}}", "top": "{{state.sidebarCollapsed ? 2 : 10}}" }, "width": 20, "height": 20,
						"radius": 10, "align": "center" }
				]
			}
		},

		"popMenu": {
			"note": "An overflow menu open at the state path: a raised, rounded list of items (title, icon, run and its with, or a separator) under its button",
			"params": { "open": "", "items": [], "width": 200 },
			"node": {
				"overlay": { "placement": "below-end", "open": "{{open}}", "dismiss": "outside", "modal": true },
				"width": "{{width}}", "height": "{{16 + sum(items, it.separator == true ? 17 : 48)}}", "radius": 8,
				"color": "@card", "shadow": { "y": 4, "blur": 16, "color": "#00000047" },
				"children": [{ "type": "column", "fill": 8, "color": "transparent", "role": "menu", "arrows": "vertical", "children": [{
					"repeat": { "for": "item", "in": "{{items}}" }, "anchors": { "left": 0, "right": 0 }, "height": "{{item.separator == true ? 17 : 48}}", "color": "transparent",
					"children": [
						{ "when": "{{item.separator == true}}", "role": "separator", "anchors": { "left": 0, "right": 0, "top": 8 }, "height": 1, "color": "@divider" },
						{ "when": "{{item.separator != true}}", "fill": 0, "color": "transparent", "hover": { "color": "@cardHover" }, "focused": { "color": "@cardHover" },
							"cursor": "hand", "focusable": true, "role": "menuitem", "label": "{{item.title}}",
							"onClick": [{ "set": "{{open}}", "to": false }, { "run": "{{item.run}}", "with": "{{item.with}}" }], "children": [
								{ "type": "label", "icon": "{{item.icon}}", "text": "", "textColor": "@muted", "anchors": { "left": 16, "top": 12 }, "width": 24, "height": 24, "align": "center" },
								{ "type": "label", "text": "{{item.title}}", "textColor": "@text", "anchors": { "left": 56, "right": 16, "top": 0, "bottom": 0 },
									"align": { "horizontal": "start", "vertical": "center" } }
							] }
					] }] }]
			}
		},

		"levelBar": {
			"note": "A tile's rounded bar, filled from the start to level (0 to 1), with a mark at the fill's end; a transparent slider over it drags it",
			"params": { "level": 0, "fill": "@accent", "back": "@raised" },
			"node": {
				"height": 40, "radius": 12, "color": "{{back}}",
				"children": [{
					"when": "{{level > 0}}", "anchors": { "left": 0, "top": 0, "bottom": 0 }, "width": "{{clamp(level, 0, 1) * 100 + '%'}}", "minWidth": 24, "radius": 12, "color": "{{fill}}",
					"children": [{ "anchors": { "right": 8, "top": 12 }, "width": 4, "height": 16, "radius": 2, "color": "#ffffffcc" }]
				}]
			}
		},

		"snackbar": {
			"note": "A short message in a dark bar at the bottom centre, with Dismiss and, while a call runs, its progress",
			"params": { "open": "state.toast.open", "message": "", "progress": null },
			"node": {
				"overlay": { "placement": "window", "open": "{{open}}" },
				"anchors": { "bottom": 24 }, "x": "{{(window.width - min(480, window.width - 32)) / 2}}", "width": "{{min(480, window.width - 32)}}", "height": 48,
				"color": "@snack", "radius": 4, "shadow": { "y": 3, "blur": 10, "color": "#00000052" }, "role": "status", "live": "polite",
				"children": [
					{ "type": "label", "text": "{{message}}", "textColor": "#ffffffde", "anchors": { "left": 16, "right": 104, "top": 0, "bottom": 0 },
						"align": { "horizontal": "start", "vertical": "center" } },
					{ "when": "{{progress == null}}", "style": "button", "text": "{{t('snack.dismiss')}}", "color": "transparent", "hover": { "color": "#ffffff14" },
						"textColor": "@snackAction", "anchors": { "right": 8, "top": 6 }, "width": 88, "height": 36, "radius": 4, "onClick": { "set": "{{open}}", "to": false } },
					{ "when": "{{progress != null}}", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 3, "color": "#ffffff1f",
						"children": [{ "anchors": { "left": 0, "top": 0, "bottom": 0 }, "width": "{{clamp(progress ?? 0, 0, 1) * 100 + '%'}}", "color": "@snackAction" }] }
				]
			}
		},

		"viewTab": {
			"note": "A view in the top bar: its title, underlined while it is the one shown",
			"params": { "title": "", "selected": false },
			"node": {
				"type": "label", "text": "{{title}}", "textColor": "{{selected ? '@onHeader' : '@onHeaderDim'}}",
				"anchors": { "top": 0, "bottom": 0 }, "fitText": true, "padding": 16, "align": "center",
				"hover": { "color": "#ffffff1a" }, "cursor": "hand", "focusable": true, "role": "tab", "selected": "{{selected}}",
				"children": [{ "when": "{{selected}}", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 2, "color": "@onHeader" }]
			}
		},

		"alarmTile": {
			"note": "The alarm panel as a tile: the shield in the state's colour, the state, and a button per mode; the tile opens the keypad",
			"params": {},
			"node": {
				"style": "card", "height": 72, "hover": { "color": "@cardHover" }, "cursor": "hand", "role": "group", "label": "{{t('alarm.title')}}",
				"onClick": { "run": "openInfo", "with": { "kind": "alarm", "i": 0 } },
				"children": [
					{ "id": "alarmIcon", "type": "label", "icon": "{{state.security == 'off' ? 'shield-off' : 'shield-check'}}", "text": "",
						"textColor": "{{computed.alarmColor}}", "color": "{{state.security == 'off' ? '@okSoft' : '@alertSoft'}}",
						"anchors": { "left": 12, "top": 18 }, "width": 36, "height": 36, "radius": 18, "align": "center" },
					{ "id": "alarmName", "type": "label", "text": "{{t('alarm.title')}}", "textColor": "@text", "anchors": { "left": 60, "top": 17 }, "height": 18, "fitText": true },
					{ "id": "alarmState", "style": "caption", "text": "{{t('alarm.' + state.security)}}", "anchors": { "left": 60, "top": 38 }, "live": "polite" },
					{ "id": "alarmModes", "type": "row", "anchors": { "right": 12, "top": 18 }, "width": 280, "height": 36, "gap": 6, "justify": "end", "role": "toolbar", "arrows": "horizontal",
						"children": [{
							"id": "alarmMode", "repeat": { "for": "mode", "in": "state.securityModes" },
							"style": "{{mode == state.security ? 'choiceOn' : 'choice'}}", "font": "small", "text": "{{t('alarm.do.' + mode)}}", "padding": 12, "fitText": true,
							"anchors": { "top": 0, "bottom": 0 }, "radius": 18, "selected": "{{mode == state.security}}",
							"color": "{{mode == state.security ? (mode == 'off' ? '@okSoft' : '@alertSoft') : '@raised'}}",
							"textColor": "{{mode == state.security ? (mode == 'off' ? '@ok' : '@alert') : '@text'}}",
							"onClick": { "if": "{{mode == 'off'}}", "then": [{ "run": "openInfo", "with": { "kind": "alarm", "i": 0 } }],
								"else": [{ "run": "armAlarm", "with": { "mode": "{{mode}}" } }] }
						}] }
				]
			}
		},

		"alarmKeypad": {
			"note": "The keypad of the alarm's more-info: the typed code as dots, the digits, clear, and the modes",
			"params": {},
			"node": {
				"anchors": { "left": 0, "right": 0, "top": 120, "bottom": 0 }, "color": "transparent",
				"children": [
					{ "id": "alarmCode", "type": "label", "text": "{{empty(state.alarmCode) ? t('alarm.code') : join(map(split(state.alarmCode, ''), '●'), ' ')}}",
						"textColor": "{{empty(state.alarmCode) ? '@muted' : '@text'}}", "anchors": { "left": 100, "right": 100, "top": 0 }, "height": 40, "align": "center",
						"color": "@field", "radius": 8, "label": "{{t('alarm.code')}}" },
					{ "id": "alarmKeys", "type": "grid", "columns": 3, "gap": 10, "anchors": { "left": 92, "right": 92, "top": 56 }, "height": 230, "role": "group",
						"label": "{{t('alarm.keypad')}}",
						"children": [{
							"id": "alarmKey", "repeat": { "for": "key", "in": "{{['1', '2', '3', '4', '5', '6', '7', '8', '9', 'clear', '0', 'back']}}" },
							"style": "button", "height": 50, "radius": 25, "font": "{{length(key) == 1 ? 'heading' : 'icons'}}",
							"icon": "{{key == 'clear' ? 'x' : key == 'back' ? 'delete' : ''}}", "text": "{{length(key) == 1 ? key : ''}}",
							"label": "{{length(key) == 1 ? key : t('alarm.' + key)}}",
							"onClick": { "set": "state.alarmCode",
								"to": "{{key == 'clear' ? '' : key == 'back' ? slice(state.alarmCode, 0, max(0, length(state.alarmCode) - 1)) : slice(state.alarmCode + key, 0, 8)}}" }
						}] },
					{ "id": "alarmActions", "type": "row", "anchors": { "left": 24, "right": 24, "top": 300 }, "height": 40, "gap": 8, "justify": "center", "role": "toolbar",
						"arrows": "horizontal",
						"children": [{
							"id": "alarmAction", "repeat": { "for": "mode", "in": "state.securityModes" },
							"style": "{{mode == state.security ? 'choiceOn' : 'choice'}}", "text": "{{t('alarm.do.' + mode)}}", "width": 108, "height": 40, "radius": 20,
							"color": "{{mode == state.security ? (mode == 'off' ? '@okSoft' : '@alertSoft') : '@raised'}}",
							"textColor": "{{mode == state.security ? (mode == 'off' ? '@ok' : '@alert') : '@text'}}",
							"selected": "{{mode == state.security}}", "onClick": { "run": "armAlarm", "with": { "mode": "{{mode}}" } }
						}] }
				]
			}
		}
	}
}
