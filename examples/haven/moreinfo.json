{
	"note": "Haven's more-info dialog, included by smart-home.screen.json: a click on a light, the climate, the blinds or a device opens it in the middle of the window, with the big control of that kind, its details and its recent activity. Escape or a click outside closes it.",

	"state": {
		"info": { "open": false, "kind": "light", "index": 0 },
		"tempHistory": [20.1, 19.8, 19.6, 19.4, 19.3, 19.2, 19.4, 20.2, 21.0, 21.4, 21.6, 21.5, 21.7, 21.8, 21.6, 21.5, 21.6, 21.9, 22.1, 22.0, 21.8, 21.6, 21.4, 21.5],
		"deviceFacts": {
			"door": { "battery": 82, "changed": "08:12", "log": ["08:12", "07:40", "22:05"] },
			"vacuum": { "battery": 64, "changed": "10:30", "log": ["10:30", "09:55", "18:20"] },
			"speaker": { "battery": 100, "changed": "09:02", "log": ["09:02", "08:47", "21:30"] }
		}
	},

	"computed": {
		"infoLight": "{{computed.room.lights[state.info.index]}}",
		"infoDevice": "{{state.devices[state.info.index]}}",
		"infoFacts": "{{state.deviceFacts[computed.infoDevice.id]}}",
		"infoName": "{{state.info.kind == 'light' ? computed.infoLight.name : (state.info.kind == 'device' ? computed.infoDevice.name : t('info.' + state.info.kind))}}",
		"infoState": "{{state.info.kind == 'light' ? (computed.infoLight.on ? computed.infoLight.level + '%' : t('light.off')) : (state.info.kind == 'climate' ? computed.room.target + '°' : (state.info.kind == 'cover' ? t('blinds.open', { n: round(computed.room.blinds) }) : (computed.infoDevice.busy ? t('device.waiting') : t('device.' + computed.infoDevice.id + (computed.infoDevice.on ? '.on' : '.off')))))}}"
	},

	"actions": {
		"openInfo": [
			{ "note": "with: kind (light, climate, cover or device) and i, the light or device it shows" },
			{ "set": "state.info", "to": { "open": true, "kind": "{{kind}}", "index": "{{i}}" } }
		],
		"setLevel": [
			{ "note": "with: by, a step of the shown light's brightness; it switches the light on" },
			{ "set": "state.rooms[state.room].lights[state.info.index].level", "to": "{{clamp(computed.infoLight.level + by, 10, 100)}}" },
			{ "set": "state.rooms[state.room].lights[state.info.index].on", "to": true },
			{ "set": "state.scene", "to": "" }
		],
		"pickLevel": [{ "run": "setLevel", "with": { "by": "{{level - computed.infoLight.level}}" } }],
		"levelUp": [{ "run": "setLevel", "with": { "by": 10 } }],
		"levelDown": [{ "run": "setLevel", "with": { "by": -10 } }],
		"pickBlinds": [{ "animate": "state.rooms[state.room].blinds", "to": "{{level}}", "ms": 300 }],
		"blindsUp": [{ "set": "state.rooms[state.room].blinds", "to": "{{clamp(computed.room.blinds + 10, 0, 100)}}" }],
		"blindsDown": [{ "set": "state.rooms[state.room].blinds", "to": "{{clamp(computed.room.blinds - 10, 0, 100)}}" }]
	},

	"components": {
		"iconBtn": {
			"note": "A round button with an icon, named and explained by the string tip",
			"params": { "icon": "", "tip": "" },
			"node": { "style": "round", "icon": "{{icon}}", "text": "", "label": "{{t(tip)}}", "tooltip": "{{t(tip)}}" }
		},
		"infoBody": {
			"note": "The part of the dialog for one kind",
			"params": { "kind": "" },
			"node": { "when": "{{state.info.kind == kind}}", "anchors": { "left": 0, "right": 0, "top": 0, "bottom": 0 }, "color": "transparent", "children": [{ "slot": true }] }
		},
		"infoRow": {
			"note": "The dialog's row of round buttons under its big bar",
			"params": {},
			"node": { "type": "row", "anchors": { "left": 0, "right": 0, "top": 396 }, "height": 44, "gap": 16, "justify": "center", "role": "toolbar", "arrows": "horizontal", "children": [{ "slot": true }] }
		},
		"bigBar": {
			"note": "A tall rounded bar filled from the bottom to share (0 to 1); a click on one of its ten bands runs pick with level, 10 to 100",
			"params": { "share": 0, "fill": "@accent", "label": "", "pick": "", "up": "", "down": "" },
			"node": {
				"anchors": { "left": 140, "top": 132 }, "width": 120, "height": 240, "radius": 28, "color": "@raised",
				"focusable": true, "role": "slider", "label": "{{label}}",
				"keys": { "up": { "run": "{{up}}" }, "down": { "run": "{{down}}" } },
				"children": [
					{ "id": "barFill", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": "{{240 * share}}", "radius": 28, "color": "{{fill}}" },
					{ "id": "barBand", "repeat": { "for": "k", "in": "{{range(10)}}" }, "anchors": { "left": 0, "right": 0, "top": "{{k * 24}}" }, "height": 24,
						"color": "transparent", "cursor": "hand", "onClick": { "run": "{{pick}}", "with": { "level": "{{(10 - k) * 10}}" } } }
				]
			}
		},

		"thermoDial": {
			"note": "The target temperature on a dial coloured by the mode; p prefixes the inner ids",
			"params": { "p": "", "small": false },
			"node": {
				"width": "{{small ? 150 : 200}}", "height": "{{small ? 150 : 200}}", "color": "transparent",
				"children": [
					{ "id": "{{p}}dialTrack", "type": "path", "fill": 0, "viewBox": "0 0 200 200", "d": "M 43.43 156.57 A 80 80 0 1 1 156.57 156.57",
						"stroke": "@off", "strokeWidth": 14, "strokeCap": "round" },
					{ "id": "{{p}}dialArc", "type": "path", "fill": 0, "viewBox": "0 0 200 200", "d": "M 43.43 156.57 A 80 80 0 1 1 156.57 156.57",
						"stroke": "{{computed.modeColor}}", "strokeWidth": 14, "strokeCap": "round", "strokeDash": "{{[max(computed.dialShare * 377, 0.01), 400]}}" },
					{ "id": "{{p}}dialKnob", "type": "path", "fill": 0, "viewBox": "0 0 200 200", "d": "M 93 20 A 7 7 0 1 0 107 20 A 7 7 0 1 0 93 20",
						"fillColor": "@knob", "stroke": "{{computed.modeColor}}", "strokeWidth": 3, "rotate": "{{-135 + 270 * computed.dialShare}}" },
					{ "id": "{{p}}label-mode-now", "type": "label", "font": "small", "textColor": "@muted", "text": "{{t('mode.' + state.mode)}}",
						"anchors": { "left": 0, "right": 0, "top": "{{small ? 30 : 46}}" }, "height": 16, "align": "center" },
					{ "id": "{{p}}target", "type": "label", "text": "{{computed.room.target}}°", "font": "figure", "textColor": "@text",
						"anchors": { "left": 0, "right": 0, "top": "{{small ? 46 : 66}}" }, "height": 60, "align": "center",
						"label": "{{t('climate.targetIs', { target: computed.room.target })}}", "live": "polite" },
					{ "id": "{{p}}label-target", "when": "{{!small}}", "style": "caption", "icon": "thermometer", "text": " {{computed.room.temp}}°",
						"anchors": { "left": 0, "right": 0, "top": 128 }, "height": 16, "align": "center" }
				]
			}
		},

		"scrim": {
			"note": "Dims the page behind a dialog that is open at the state path",
			"params": { "open": "" },
			"node": {
				"overlay": { "placement": "window", "open": "{{open}}" },
				"x": 0, "y": 0, "width": "{{window.width}}", "height": "{{window.height}}", "color": "#00000052"
			}
		},

		"moreInfo": {
			"note": "The details of one light, the climate, the blinds or one device",
			"params": {},
			"node": {
				"dir": "auto",
				"overlay": { "placement": "center", "open": "state.info.open", "dismiss": "outside", "modal": true },
				"width": 400, "height": "{{state.info.kind == 'device' ? 560 : state.info.kind == 'climate' ? 536 : 500}}", "radius": 12, "color": "@card",
				"shadow": { "y": 8, "blur": 24, "color": "#00000040" },
				"role": "dialog", "label": "{{computed.infoName}}",
				"children": [
					{ "use": "iconBtn", "with": { "icon": "x", "tip": "info.close" }, "id": "infoClose", "font": "icons", "color": "transparent", "anchors": { "left": 10, "top": 10 },
						"onClick": { "set": "state.info.open", "to": false } },
					{ "id": "infoName", "type": "label", "font": "heading", "textColor": "@text", "text": "{{computed.infoName}}", "anchors": { "left": 64, "right": 20, "top": 14 }, "height": 22 },
					{ "id": "infoRoom", "style": "caption", "text": "{{state.info.kind == 'device' ? t('info.home') : computed.room.name}}", "anchors": { "left": 64, "top": 36 } },
					{ "id": "infoState", "when": "{{state.info.kind != 'climate'}}", "type": "label", "font": "title", "textColor": "@text", "text": "{{computed.infoState}}", "anchors": { "left": 0, "right": 0, "top": 76 }, "height": 36,
						"align": "center", "live": "polite" },

					{ "use": "infoBody", "with": { "kind": "light" }, "id": "infoLightBody", "children": [
						{ "use": "bigBar", "with": { "share": "{{computed.infoLight.on ? computed.infoLight.level / 100 : 0}}", "fill": "{{slice(computed.infoLight.color, 0, 7)}}",
							"label": "{{t('light.brightness')}}: {{computed.infoLight.on ? computed.infoLight.level + '%' : t('light.off')}}",
							"pick": "pickLevel", "up": "levelUp", "down": "levelDown" } },
						{ "use": "infoRow", "id": "infoLightButtons",
							"children": [
								{ "use": "iconBtn", "with": { "icon": "power", "tip": "info.power" }, "id": "infoPower",
									"selected": "{{computed.infoLight.on}}", "color": "{{computed.infoLight.on ? '@warmSoft' : '@raised'}}", "textColor": "{{computed.infoLight.on ? '@warm' : '@text'}}",
									"onClick": [{ "toggle": "state.rooms[state.room].lights[state.info.index].on" }, { "set": "state.scene", "to": "" }] },
								{ "use": "iconBtn", "with": { "icon": "palette", "tip": "colour.title" }, "id": "infoColour",
									"onClick": [{ "set": "state.info.open", "to": false }, { "run": "openColour", "with": { "i": "{{state.info.index}}" } }] },
								{ "use": "iconBtn", "with": { "icon": "thermometer-sun", "tip": "colour.warm" }, "id": "infoWarm",
									"onClick": { "set": "state.rooms[state.room].lights[state.info.index].color", "to": "#ffd58aff" } }
							] },
						{ "id": "infoLightHint", "style": "caption", "text": "{{t('info.lightHint')}}", "anchors": { "left": 0, "right": 0, "top": 460 }, "height": 16, "align": "center", "fitText": false }
					] },

					{ "use": "infoBody", "with": { "kind": "climate" }, "id": "infoClimateBody", "children": [
						{ "use": "thermoDial", "with": { "p": "info-" }, "id": "infoDial", "anchors": { "left": 0, "right": 0, "top": 64 } },
						{ "use": "iconBtn", "with": { "icon": "minus", "tip": "climate.down" }, "id": "infoDown", "anchors": { "left": 132, "top": 232 },
							"onClick": { "run": "setTarget", "with": { "by": -0.5 } } },
						{ "use": "iconBtn", "with": { "icon": "plus", "tip": "climate.up" }, "id": "infoUp", "anchors": { "right": 132, "top": 232 },
							"onClick": { "run": "setTarget", "with": { "by": 0.5 } } },
						{ "id": "infoModes", "type": "row", "anchors": { "left": 0, "right": 0, "top": 288 }, "height": 40, "gap": 8, "justify": "center", "role": "toolbar", "arrows": "horizontal",
							"children": [
								{ "id": "infoMode", "repeat": { "for": "mode", "in": "state.modes" }, "style": "{{mode == state.mode ? 'choiceOn' : 'choice'}}",
									"icon": "{{mode == 'Heat' ? 'flame' : (mode == 'Cool' ? 'snowflake' : 'sun-snow')}}", "text": " {{t('mode.' + mode)}}", "width": 104, "height": 40, "radius": 20,
									"color": "{{mode == state.mode ? computed.modeColor + '33' : '@raised'}}", "textColor": "{{mode == state.mode ? computed.modeColor : '@text'}}",
									"selected": "{{mode == state.mode}}", "onClick": { "set": "state.mode", "to": "{{mode}}" } }
							] },
						{ "id": "infoHistoryTitle", "type": "label", "textColor": "@text", "icon": "history", "text": " {{t('info.history')}}", "anchors": { "left": 24, "top": 348 }, "fitText": true },
						{ "id": "infoHistory", "style": "card", "anchors": { "left": 24, "right": 24, "top": 376 }, "height": 136, "color": "@field", "borderWidth": 0,
							"role": "img", "label": "{{t('info.historyLabel', { low: min(state.tempHistory), high: max(state.tempHistory) })}}",
							"children": [
								{ "use": "lineChart", "with": { "values": "{{map(state.tempHistory, it - 19)}}", "top": 4, "color": "{{computed.modeColor}}", "lineWidth": 2 }, "anchors": { "left": 48, "right": 12, "top": 16, "bottom": 28 } },
								{ "id": "infoHistoryHigh", "style": "caption", "text": "23°", "anchors": { "left": 12, "top": 12 } },
								{ "id": "infoHistoryLow", "style": "caption", "text": "19°", "anchors": { "left": 12, "bottom": 28 } },
								{ "id": "infoHistoryStart", "style": "caption", "text": "00:00", "anchors": { "left": 48, "bottom": 8 } },
								{ "id": "infoHistoryEnd", "style": "caption", "text": "{{t('info.now')}}", "anchors": { "right": 12, "bottom": 8 } }
							] }
					] },

					{ "use": "infoBody", "with": { "kind": "cover" }, "id": "infoCoverBody", "children": [
						{ "use": "bigBar", "with": { "share": "{{computed.room.blinds / 100}}", "fill": "@cover", "label": "{{t('blinds.title')}}: {{t('blinds.open', { n: round(computed.room.blinds) })}}",
							"pick": "pickBlinds", "up": "blindsUp", "down": "blindsDown" } },
						{ "use": "infoRow", "id": "infoCoverButtons",
							"children": [
								{ "use": "iconBtn", "with": { "icon": "chevron-up", "tip": "blinds.openButton" }, "id": "infoOpen",
									"onClick": { "animate": "state.rooms[state.room].blinds", "to": 100, "ms": 500 } },
								{ "use": "iconBtn", "with": { "icon": "square", "tip": "info.stop" }, "id": "infoStop",
									"onClick": { "set": "state.rooms[state.room].blinds", "to": "{{round(computed.room.blinds / 10) * 10}}" } },
								{ "use": "iconBtn", "with": { "icon": "chevron-down", "tip": "blinds.close" }, "id": "infoShut",
									"onClick": { "animate": "state.rooms[state.room].blinds", "to": 0, "ms": 500 } }
							] },
						{ "id": "infoCoverHint", "style": "caption", "text": "{{t('info.coverHint')}}", "anchors": { "left": 0, "right": 0, "top": 460 }, "height": 16, "align": "center", "fitText": false }
					] },

					{ "use": "infoBody", "with": { "kind": "device" }, "id": "infoDeviceBody", "children": [
						{ "id": "infoDeviceIcon", "type": "label", "font": "title", "icon": "{{computed.infoDevice.on ? computed.infoDevice.icon : computed.infoDevice.iconOff}}", "text": "",
							"anchors": { "left": 164, "top": 128 }, "width": 72, "height": 72, "radius": 36, "align": "center",
							"textColor": "{{computed.infoDevice.on ? '@accent' : '@muted'}}", "color": "{{computed.infoDevice.on ? '@accentSoft' : '@raised'}}" },
						{ "id": "infoDeviceAction", "style": "choiceOn", "anchors": { "left": 120, "top": 216 }, "width": 160, "height": 36, "radius": 18,
							"text": "{{t('device.' + computed.infoDevice.id + (computed.infoDevice.on ? '.doOff' : '.doOn'))}}",
							"onClick": { "run": "deviceCall", "with": { "i": "{{state.info.index}}" } } },
						{ "id": "infoFacts", "type": "stack", "anchors": { "left": 24, "right": 24, "top": 276 }, "height": 80, "gap": 0, "role": "list", "children": [
							{ "id": "infoBattery", "type": "label", "icon": "battery-medium", "text": "  {{t('info.battery', { n: computed.infoFacts.battery })}}", "textColor": "@text", "role": "listitem",
								"anchors": { "left": 0, "right": 0 }, "height": 40, "align": { "horizontal": "start", "vertical": "center" } },
							{ "id": "infoChanged", "type": "label", "icon": "history", "text": "  {{t('info.changed', { time: computed.infoFacts.changed })}}", "textColor": "@text", "role": "listitem",
								"anchors": { "left": 0, "right": 0 }, "height": 40, "align": { "horizontal": "start", "vertical": "center" } }
						] },
						{ "id": "infoLogTitle", "type": "label", "textColor": "@text", "icon": "activity", "text": " {{t('info.activity')}}", "anchors": { "left": 24, "top": 372 }, "fitText": true },
						{ "id": "infoLog", "type": "stack", "anchors": { "left": 24, "right": 24, "top": 404 }, "height": 132, "gap": 4, "role": "list", "children": [
							{ "id": "infoLogRow", "repeat": { "for": "time", "in": "computed.infoFacts.log", "index": "n" }, "anchors": { "left": 0, "right": 0 }, "height": 40, "radius": 8,
								"color": "@field", "role": "listitem", "label": "{{time}}", "children": [
									{ "id": "infoLogTime", "style": "caption", "text": "{{time}}", "anchors": { "left": 12, "top": 12 } },
									{ "id": "infoLogText", "type": "label", "textColor": "@text", "anchors": { "left": 64, "right": 12, "top": 10 }, "height": 20,
										"text": "{{t('device.' + computed.infoDevice.id + ((n % 2 == 0) == computed.infoDevice.on ? '.on' : '.off'))}}" }
								] }
						] }
					] }
				]
			}
		}
	}
}
