{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "TypeScript: include it to colour and edit TypeScript in an editor ({ \"language\": \"typescript\" }).",
	"languages": {
		"typescript": {
			"title": "TypeScript",
			"aliases": ["ts", "tsx"],
			"files": ["*.ts", "*.mts", "*.cts", "*.tsx"],
			"comments": {
				"line": "//",
				"block": ["/*", "*/"]
			},
			"brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
			"pairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"]],
			"indent": {
				"increase": "^.*(?:\\{[^}\\\"'`]*|\\([^)\\\"'`]*|\\[[^\\]\\\"'`]*)$",
				"decrease": "^\\s*[}\\])]"
			},
			"wordPattern": "[\\w$]+",
			"patterns": [
				{
					"begin": "/\\*",
					"end": "\\*/",
					"scope": "comment.block"
				},
				{
					"match": "//.*",
					"scope": "comment.line"
				},
				{
					"include": "#template"
				},
				{
					"match": "\"(?:[^\"\\\\]|\\\\.)*\"?",
					"scope": "string.quoted.double"
				},
				{
					"match": "'(?:[^'\\\\]|\\\\.)*'?",
					"scope": "string.quoted.single"
				},
				{
					"match": "\\b(?:0[xXbBoO][\\da-fA-F_]+n?|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?n?)",
					"scope": "number"
				},
				{
					"match": "\\b(?:abstract|as|async|await|break|case|catch|class|const|continue|debugger|declare|default|delete|do|else|enum|export|extends|false|finally|for|from|function|get|if|implements|import|in|infer|instanceof|interface|is|keyof|let|namespace|new|null|of|private|protected|public|readonly|return|satisfies|set|static|super|switch|this|throw|true|try|type|typeof|undefined|var|void|while|with|yield)\\b",
					"scope": "keyword"
				},
				{
					"match": "\\b(?:Array|BigInt|Boolean|Date|Error|Map|Math|Number|Object|Promise|RegExp|Set|String|Symbol|any|bigint|boolean|console|never|number|object|string|symbol|unknown)\\b|\\b[A-Z][\\w$]*",
					"scope": "type"
				}
			],
			"repository": {
				"template": {
					"begin": "`",
					"end": "`",
					"scope": "string.template",
					"patterns": [
						{
							"match": "\\\\.",
							"scope": "string.escape"
						},
						{
							"begin": "\\$\\{",
							"end": "\\}",
							"scope": "meta.interpolation",
							"patterns": [
								{
									"include": "$self"
								}
							]
						}
					]
				}
			}
		}
	}
}
