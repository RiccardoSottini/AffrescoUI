			"intelligence.loadingModels": "Chargement des modèles…",
			"intelligence.refresh": "Actualiser les modèles",
			"intelligence.recommended": "Recommandé",
			"intelligence.save": "Enregistrer et utiliser",
			"intelligence.test": "Tester la connexion",
			"intelligence.testing": "Test en cours…",
			"intelligence.saved": "Enregistré : l'assistant de chaque application l'utilise maintenant.",
			"intelligence.launcherOnly": "Ces réglages ne se changent que dans AffrescoUI Launcher."
		}
	},
	"state": {
		"intelligence": {
			"native": false, "loaded": false, "selected": "", "baseUrl": "", "model": "", "query": "", "models": [],
			"loadingModels": false, "testing": false, "test": null, "notice": "", "error": "", "keyShown": true,
			"data": {
				"current": { "provider": "", "model": "" },
				"keyStore": "Keychain",
				"persistent": true,
				"providers": [
					{ "id": "anthropic", "name": "Anthropic (Claude)", "kind": "anthropic", "needsKey": true, "takesKey": true,
					  "hasKey": false, "available": true, "baseUrl": "https://api.anthropic.com", "editableUrl": false,
					  "model": "claude-sonnet-5-5", "defaultModel": "claude-sonnet-5-5", "fixedModels": false,
					  "keyHelp": "https://console.anthropic.com/settings/keys",
					  "models": [{ "id": "claude-opus-5-5", "name": "Claude Opus 5.5" }, { "id": "claude-sonnet-5-5", "name": "Claude Sonnet 5.5" },
					             { "id": "claude-haiku-5-5", "name": "Claude Haiku 5.5" }, { "id": "claude-fable-5-1", "name": "Claude Fable 5.1" }] },
					{ "id": "openai", "name": "OpenAI", "kind": "openai", "needsKey": true, "takesKey": true, "hasKey": false,
					  "available": true, "baseUrl": "https://api.openai.com/v1", "editableUrl": false, "model": "gpt-5",
					  "defaultModel": "gpt-5", "fixedModels": false,
					  "keyHelp": "https://platform.openai.com/api-keys",
					  "models": [{ "id": "gpt-5", "name": "GPT-5" }, { "id": "gpt-5-mini", "name": "GPT-5 mini" }] },
					{ "id": "openai-compatible", "name": "OpenAI-compatible server", "kind": "openai-compatible", "needsKey": false,
					  "takesKey": true, "hasKey": false, "available": true, "baseUrl": "http://127.0.0.1:11434/v1",
					  "editableUrl": true, "model": "", "defaultModel": "", "fixedModels": false,
					  "keyHelp": "https://ollama.com/download", "models": [] },
					{ "id": "claude-code", "name": "Claude Code", "kind": "claude-code", "needsKey": false, "takesKey": false,
					  "hasKey": false, "available": true, "baseUrl": "", "editableUrl": false, "model": "sonnet",
					  "defaultModel": "sonnet", "fixedModels": true,
					  "keyHelp": "https://claude.com/claude-code",
					  "models": [
						{ "id": "sonnet", "name": "Claude Sonnet 5.5", "description": { "en": "Fast and strong at editing screens: the best for most asks.", "es": "Rápido y bueno editando pantallas: el mejor para casi todo.", "fr": "Rapide et doué pour modifier les écrans : le meilleur pour presque tout." } },
						{ "id": "opus", "name": "Claude Opus 5.5", "description": { "en": "Deeper reasoning, for harder and longer changes.", "es": "Razona más a fondo, para cambios difíciles y largos.", "fr": "Raisonne plus en profondeur, pour les changements longs et difficiles." } },
						{ "id": "fable", "name": "Claude Fable 5.1", "description": { "en": "The most capable, for the hardest asks; the slowest.", "es": "El más capaz, para lo más difícil; el más lento.", "fr": "Le plus capable, pour le plus difficile ; le plus lent." } },
						{ "id": "haiku", "name": "Claude Haiku 5.5", "description": { "en": "The fastest, for quick small changes.", "es": "El más rápido, para cambios pequeños y rápidos.", "fr": "Le plus rapide, pour les petits changements rapides." } }
					  ] }
				]
			}
		}
	},
	"components": {
		"intelligenceButton": {
			"params": { "text": "", "run": "", "primary": false, "enabled": true, "width": 150 },
			"node": {
				"id": "label-text",
				"type": "label", "text": "{{text}}", "width": "{{width}}", "height": 32, "radius": 6, "align": "center",
				"color": "{{primary ? '@intelligence.accent' : '@intelligence.raised'}}",
				"textColor": "{{primary ? '@intelligence.onAccent' : '@intelligence.text'}}",
				"borderWidth": "{{primary ? 0 : 1}}", "borderColor": "@intelligence.border",
				"hover": { "color": "{{primary ? '@intelligence.accentHover' : '@intelligence.border'}}" },
				"focused": { "borderWidth": 2, "borderColor": "@intelligence.accentHover" },
				"role": "button", "focusable": true, "cursor": "hand", "disabled": "{{!enabled}}",
				"onClick": [{ "run": "{{run}}" }]
			}
		},
		"intelligenceSettings": {
			"params": {},
			"node": {
				"id": "intelligenceSettings", "fill": true, "color": "transparent", "scroll": "vertical", "dir": "auto",
				"onShow": [{ "run": "intelligence.load" }],
				"let": {
					"iData": "{{state.intelligence.data}}",
					"iProvider": "{{find(state.intelligence.data.providers, it.id == state.intelligence.selected) ?? state.intelligence.data.providers[0]}}"
				},
				"children": [{
					"id": "intelligenceColumn", "type": "column", "gap": 14, "alignItems": "stretch", "fitContent": "height",
					"anchors": { "left": 24, "right": 24, "top": 24 }, "maxWidth": 720,
					"children": [
						{ "id": "intelligenceTitle", "type": "label", "role": "heading", "height": 28, "textColor": "@intelligence.text",
						  "runs": [{ "text": "{{t('intelligence.title')}}", "bold": true, "size": 20 }] },
						{ "id": "intelligenceIntro", "type": "label", "wrap": true, "height": 40, "textColor": "@intelligence.dim",
						  "text": "{{t('intelligence.intro')}}" },
						{ "id": "intelligenceCurrent", "type": "label", "role": "status", "live": "polite", "height": 22,
						  "textColor": "{{iData.current.provider != '' ? '@intelligence.success' : '@intelligence.warning'}}",
						  "text": "{{iData.current.provider != '' ? t('intelligence.inUse', {provider: find(iData.providers, it.id == iData.current.provider).name ?? iData.current.provider, model: iData.current.model}) : t('intelligence.none')}}" },
						{ "id": "intelligenceProvidersTitle", "type": "label", "height": 20, "textColor": "@intelligence.text",
						  "runs": [{ "text": "{{t('intelligence.providers')}}", "bold": true }] },
						{ "id": "intelligenceProviders", "type": "column", "gap": 8, "alignItems": "stretch", "fitContent": "height",
						  "role": "radiogroup", "label": "{{t('intelligence.providers')}}",
						  "children": [
							{ "repeat": { "for": "provider", "in": "{{iData.providers}}", "index": "p" },
							  "id": "intelligenceProvider{{p}}", "height": 56, "radius": 8, "borderWidth": 1,
							  "color": "{{provider.id == iProvider.id ? '@intelligence.selected' : '@intelligence.surface'}}",
							  "borderColor": "{{provider.id == iProvider.id ? '@intelligence.accent' : '@intelligence.border'}}",
							  "hover": { "borderColor": "@intelligence.accent" }, "focused": { "borderColor": "@intelligence.accentHover", "borderWidth": 2 },
							  "role": "radio", "checked": "{{provider.id == iProvider.id}}", "focusable": true, "cursor": "hand",
							  "label": "{{provider.name}}",
							  "let": { "iStatus": "{{provider.id == iData.current.provider ? 'inUse' : !provider.available ? 'notInstalled' : provider.needsKey && !provider.hasKey ? 'needsKey' : provider.hasKey ? 'keySaved' : 'ready'}}" },
							  "onClick": [{ "run": "intelligence.pick", "with": { "id": "{{provider.id}}" } }],
							  "keys": { "space": [{ "run": "intelligence.pick", "with": { "id": "{{provider.id}}" } }] },
							  "children": [
								{ "id": "label-intelligence-provider-p", "type": "label", "anchors": { "left": 16, "top": 9 }, "fitText": true, "textColor": "@intelligence.text",
								  "runs": [{ "text": "{{provider.name}}", "bold": true }] },
								{ "id": "label-provider-kind-claude", "type": "label", "anchors": { "left": 16, "top": 31 }, "fitText": true, "textColor": "@intelligence.dim",
								  "text": "{{provider.kind == 'claude-code' ? 'claude' : provider.baseUrl}}" },
								{ "id": "row-intelligence-provider-p", "anchors": { "right": 16, "top": 17 }, "height": 22, "fitContent": "width", "type": "row", "gap": 6,
								  "alignItems": "center", "children": [
									{ "id": "panel-intelligence-provider", "width": 8, "height": 8, "radius": 4,
									  "color": "{{iStatus == 'inUse' || iStatus == 'keySaved' || iStatus == 'ready' ? '@intelligence.success' : iStatus == 'needsKey' ? '@intelligence.warning' : '@intelligence.dim'}}" },
									{ "id": "label-t-intelligence-status", "type": "label", "fitText": true, "textColor": "@intelligence.dim",
									  "text": "{{t('intelligence.status.' + iStatus)}}" }
								  ] }
							  ] }
						  ] },
						{ "id": "intelligenceForm", "type": "column", "gap": 10, "fitContent": "height",
						  "color": "@intelligence.surface", "radius": 8, "borderWidth": 1, "borderColor": "@intelligence.border",
						  "children": [
							{ "id": "intelligenceFormTitle", "type": "label", "height": 40, "anchors": { "left": 14, "right": 14 },
							  "align": "start center", "textColor": "@intelligence.text",
							  "runs": [{ "text": "{{iProvider.name}}", "bold": true, "size": 16 }] },
							{ "when": "{{!iProvider.takesKey}}", "id": "intelligenceClaudeNote", "type": "label", "wrap": true, "height": 40,
							  "anchors": { "left": 14, "right": 14 }, "textColor": "@intelligence.dim", "text": "{{t('intelligence.claudeCode')}}" },
							{ "when": "{{!iProvider.available}}", "id": "intelligenceInstall", "use": "intelligenceButton",
							  "anchors": { "left": 14 }, "with": { "text": "{{t('intelligence.install')}}", "run": "intelligence.getKey", "width": 150 } },
							{ "when": "{{iProvider.takesKey}}", "id": "intelligenceKeyLabel", "type": "label", "height": 18,
							  "anchors": { "left": 14, "right": 14 }, "textColor": "@intelligence.text",
							  "text": "{{t(iProvider.needsKey ? 'intelligence.key' : 'intelligence.keyOptional')}}" },
							{ "when": "{{iProvider.takesKey}}", "id": "intelligenceKeyRow", "type": "row", "height": 32, "gap": 8,
							  "anchors": { "left": 14, "right": 14 },
							  "children": [
								{ "when": "{{state.intelligence.keyShown}}", "id": "intelligenceKey", "type": "textarea", "secret": true,
								  "grow": 1, "height": 32, "padding": 8, "radius": 6, "borderWidth": 1,
								  "color": "@intelligence.raised", "borderColor": "@intelligence.border",
								  "focused": { "borderColor": "@intelligence.accent" }, "textColor": "@intelligence.text",
								  "placeholder": "{{t('intelligence.keyPlaceholder')}}", "placeholderColor": "@intelligence.dim",
								  "label": "{{t(iProvider.needsKey ? 'intelligence.key' : 'intelligence.keyOptional')}}",
								  "maxLength": 4096,
								  "onChange": [{ "call": "intelligence.stageKey", "with": { "provider": "{{iProvider.id}}", "key": "{{event.value}}" },
								                 "onError": [] }],
								  "onSubmit": [{ "run": "intelligence.apply" }] },
								{ "when": "{{indexOf(iProvider.keyHelp, 'https://') == 0}}", "use": "intelligenceButton", "id": "intelligenceGetKey",
								  "with": { "text": "{{t('intelligence.getKey')}}", "run": "intelligence.getKey", "width": 130 } }
							  ] },
							{ "when": "{{iProvider.takesKey && iProvider.hasKey}}", "id": "intelligenceKeySaved", "type": "row", "height": 32, "gap": 8,
							  "anchors": { "left": 14, "right": 14 }, "alignItems": "center", "children": [
								{ "id": "label-t-intelligence-key", "type": "label", "grow": 1, "height": 32, "align": "start center", "textColor": "@intelligence.success",
								  "text": "{{t('intelligence.keySaved', {store: iData.keyStore})}}" },
								{ "use": "intelligenceButton", "id": "intelligenceRemoveKey",
								  "with": { "text": "{{t('intelligence.removeKey')}}", "run": "intelligence.removeKey", "width": 140 } }
							  ] },
							{ "when": "{{iProvider.takesKey && !iData.persistent}}", "id": "intelligenceNotKept", "type": "label",
							  "height": 32, "anchors": { "left": 14, "right": 14 }, "align": "start center", "wrap": true,
							  "textColor": "@intelligence.danger", "text": "{{t('intelligence.notKept')}}" },
							{ "when": "{{iProvider.editableUrl}}", "id": "intelligenceBaseUrlLabel", "type": "label", "height": 18,
							  "anchors": { "left": 14, "right": 14 }, "textColor": "@intelligence.text", "text": "{{t('intelligence.baseUrl')}}" },
							{ "when": "{{iProvider.editableUrl}}", "id": "intelligenceBaseUrl", "type": "textarea", "height": 32, "padding": 8,
							  "radius": 6, "anchors": { "left": 14, "right": 14 },
							  "borderWidth": 1, "color": "@intelligence.raised", "borderColor": "@intelligence.border",
							  "focused": { "borderColor": "@intelligence.accent" }, "textColor": "@intelligence.text",
							  "bind": "state.intelligence.baseUrl", "maxLength": 512, "label": "{{t('intelligence.baseUrl')}}",
							  "placeholder": "{{t('intelligence.baseUrlHelp')}}", "placeholderColor": "@intelligence.dim" },
							{ "id": "intelligenceModelLabel", "type": "label", "height": 18, "anchors": { "left": 14, "right": 14 },
							  "textColor": "@intelligence.text",
							  "text": "{{state.intelligence.model != '' ? t('intelligence.modelChosen', {model: find(iProvider.models ?? [], it.id == state.intelligence.model).name ?? state.intelligence.model}) : t('intelligence.model')}}" },
							{ "id": "intelligenceModelSearch", "type": "textarea", "height": 32, "padding": 8, "radius": 6,
							  "anchors": { "left": 14, "right": 14 },
							  "borderWidth": 1, "color": "@intelligence.raised", "borderColor": "@intelligence.border",
							  "focused": { "borderColor": "@intelligence.accent" }, "textColor": "@intelligence.text",
							  "bind": "state.intelligence.query", "maxLength": 200, "label": "{{t('intelligence.searchModels')}}",
							  "placeholder": "{{t('intelligence.searchModels')}}", "placeholderColor": "@intelligence.dim",
							  "onSubmit": [{ "if": "{{length(trim(state.intelligence.query)) > 0 && (!iProvider.fixedModels || some(iProvider.models, it.id == trim(state.intelligence.query)))}}",
							                 "then": [{ "run": "intelligence.pickModel", "with": { "id": "{{trim(state.intelligence.query)}}" } }] }] },
							{ "id": "intelligenceModels", "type": "column", "gap": 2, "alignItems": "stretch", "fitContent": "height",
							  "anchors": { "left": 14, "right": 14 }, "role": "listbox", "label": "{{t('intelligence.model')}}",
							  "let": {
								"iMatches": "{{map(fuzzySort(length(state.intelligence.models) > 0 ? state.intelligence.models : iProvider.models ?? [], trim(state.intelligence.query), 'name', 6), it.item)}}"
							  },
							  "children": [
								{ "when": "{{state.intelligence.loadingModels}}", "id": "intelligenceModelsLoading", "type": "label", "height": 28,
								  "align": "start center", "textColor": "@intelligence.dim", "text": "{{t('intelligence.loadingModels')}}" },
								{ "when": "{{!state.intelligence.loadingModels && length(iMatches) == 0 && length(trim(state.intelligence.query)) == 0}}",
								  "id": "intelligenceNoModels", "type": "label", "height": 28, "align": "start center",
								  "textColor": "@intelligence.dim", "text": "{{t('intelligence.noModels')}}" },
								{ "repeat": { "for": "model", "in": "{{iMatches}}", "index": "m" },
								  "id": "intelligenceModel{{m}}", "height": "{{model.description != null ? 46 : 30}}", "radius": 6,
								  "color": "{{model.id == state.intelligence.model ? '@intelligence.selected' : 'transparent'}}",
								  "hover": { "borderColor": "@intelligence.accent", "borderWidth": 1 }, "role": "option",
								  "checked": "{{model.id == state.intelligence.model}}",
								  "focusable": true, "cursor": "hand", "label": "{{model.name}}",
								  "onClick": [{ "run": "intelligence.pickModel", "with": { "id": "{{model.id}}" } }],
								  "keys": { "space": [{ "run": "intelligence.pickModel", "with": { "id": "{{model.id}}" } }] },
								  "children": [
									{ "id": "label-model-name", "type": "label", "anchors": { "left": 8, "top": 7 }, "fitText": true, "textColor": "@intelligence.text",
									  "text": "{{model.name}}" },
									{ "id": "label-model-id", "when": "{{model.name != model.id || model.id == iProvider.defaultModel}}", "type": "label", "anchors": { "right": 8, "top": 7 }, "fitText": true,
									  "textColor": "@intelligence.dim",
									  "text": "{{(model.id == iProvider.defaultModel ? t('intelligence.recommended') + ' · ' : '') + model.id}}" },
									{ "id": "label-model-description", "when": "{{model.description != null}}", "type": "label",
									  "anchors": { "left": 8, "right": 8, "top": 25 }, "height": 16, "textColor": "@intelligence.dim",
									  "text": "{{model.description[slice(locale, 0, 2)] ?? model.description.en ?? ''}}" }
								  ] },
								{ "when": "{{!iProvider.fixedModels && length(trim(state.intelligence.query)) > 0 && !some(iMatches, it.id == trim(state.intelligence.query))}}",
								  "id": "intelligenceUseModel", "height": 30, "radius": 6, "color": "transparent",
								  "hover": { "borderColor": "@intelligence.accent", "borderWidth": 1 },
								  "role": "option", "focusable": true, "cursor": "hand",
								  "label": "{{t('intelligence.useModel', {model: trim(state.intelligence.query)})}}",
								  "onClick": [{ "run": "intelligence.pickModel", "with": { "id": "{{trim(state.intelligence.query)}}" } }],
								  "children": [{ "id": "label-t-intelligence-use", "type": "label", "anchors": { "left": 8, "top": 7 }, "fitText": true,
								                 "textColor": "@intelligence.accent",
								                 "text": "{{t('intelligence.useModel', {model: trim(state.intelligence.query)})}}" }] }
							  ] },
							{ "id": "intelligenceActions", "type": "row", "height": 32, "gap": 8, "anchors": { "left": 14, "right": 14 },
							  "children": [
								{ "use": "intelligenceButton", "id": "intelligenceSave",
								  "with": { "text": "{{t('intelligence.save')}}", "run": "intelligence.apply", "primary": true,
								            "enabled": "{{state.intelligence.model != '' && iProvider.available}}", "width": 170 } },
								{ "use": "intelligenceButton", "id": "intelligenceTest",
								  "with": { "text": "{{t(state.intelligence.testing ? 'intelligence.testing' : 'intelligence.test')}}",
								            "run": "intelligence.check", "enabled": "{{iData.current.provider != '' && !state.intelligence.testing}}",
								            "width": 170 } },
								{ "when": "{{iProvider.kind != 'claude-code'}}", "use": "intelligenceButton", "id": "intelligenceRefresh",
								  "with": { "text": "{{t('intelligence.refresh')}}", "run": "intelligence.refresh", "width": 170 } }
							] },
							{ "id": "intelligenceFeedback", "type": "label", "role": "status", "live": "polite", "wrap": true, "height": 40,
							  "anchors": { "left": 14, "right": 14 },
							  "textColor": "{{state.intelligence.error != '' || (state.intelligence.test != null && !state.intelligence.test.ok) ? '@intelligence.danger' : '@intelligence.success'}}",
							  "text": "{{state.intelligence.error != '' ? state.intelligence.error : state.intelligence.test != null ? state.intelligence.test.message : state.intelligence.notice}}" }
						  ] },
						{ "id": "panel-intelligence-column", "height": 24, "color": "transparent" }
					]
				}]
			}
		}
	},
	"actions": {
		"intelligence.load": [
			{ "note": "The first provider until the host says which is in use; without the natives (the rendering check) the call fails and the stand-in data stays" },
			{ "if": "{{state.intelligence.selected == ''}}", "then": [
				{ "run": "intelligence.choose", "with": { "id": "{{state.intelligence.data.providers[0].id}}" } }
			] },
			{ "call": "intelligence.providers", "into": "state.intelligence.data", "onError": [],
			  "then": [
				{ "set": "state.intelligence.native", "to": true },
				{ "if": "{{!state.intelligence.loaded}}", "then": [
					{ "set": "state.intelligence.loaded", "to": true },
					{ "run": "intelligence.choose",
					  "with": { "id": "{{state.intelligence.data.current.provider != '' ? state.intelligence.data.current.provider : state.intelligence.selected}}" } }
				] }
			  ] }
		],
		"intelligence.pick": [{ "run": "intelligence.choose", "with": { "id": "{{id}}" } }, { "run": "intelligence.resetKey" }],
		"intelligence.choose": [
			{ "set": "state.intelligence.selected", "to": "{{id}}" },
			{ "set": "state.intelligence.baseUrl", "to": "{{find(state.intelligence.data.providers, it.id == id).baseUrl ?? ''}}" },
			{ "set": "state.intelligence.model", "to": "{{find(state.intelligence.data.providers, it.id == id).model ?? ''}}" },
			{ "set": "state.intelligence.query", "to": "" },
			{ "set": "state.intelligence.models", "to": [] },
			{ "set": "state.intelligence.test", "to": null },
			{ "set": "state.intelligence.error", "to": "" },
			{ "set": "state.intelligence.notice", "to": "" },
			{ "run": "intelligence.refresh" }
		],
		"intelligence.refresh": [
			{ "if": "{{!state.intelligence.native}}", "then": [{ "stop": true }] },
			{ "call": "intelligence.models", "with": { "provider": "{{state.intelligence.selected}}" },
			  "into": "state.intelligence.models", "loading": "state.intelligence.loadingModels", "timeout": 20000,
			  "onError": [{ "set": "state.intelligence.models", "to": [] }] }
		],
		"intelligence.pickModel": [
			{ "set": "state.intelligence.model", "to": "{{id}}" },
			{ "set": "state.intelligence.query", "to": "" }
		],
		"intelligence.apply": [
			{ "set": "state.intelligence.error", "to": "" },
			{ "set": "state.intelligence.test", "to": null },
			{ "if": "{{!state.intelligence.native}}", "then": [
				{ "set": "state.intelligence.error", "to": "{{t('intelligence.launcherOnly')}}" }, { "stop": true }
			] },
			{ "call": "intelligence.save", "into": "state.intelligence.data",
			  "with": { "provider": "{{state.intelligence.selected}}", "model": "{{state.intelligence.model}}",
			            "baseUrl": "{{state.intelligence.baseUrl}}" },
			  "then": [{ "set": "state.intelligence.notice", "to": "{{t('intelligence.saved')}}" },
			           { "run": "intelligence.resetKey" }, { "run": "intelligence.refresh" }],
			  "onError": [{ "set": "state.intelligence.error", "to": "{{error}}" }] }
		],
		"intelligence.check": [
			{ "set": "state.intelligence.error", "to": "" },
			{ "call": "intelligence.test", "into": "state.intelligence.test", "loading": "state.intelligence.testing",
			  "timeout": 100000,
			  "onError": [{ "set": "state.intelligence.test", "to": "{{ {ok: false, message: state.intelligence.native ? error : t('intelligence.launcherOnly')} }}" }] }
		],
		"intelligence.removeKey": [
			{ "call": "intelligence.forget", "with": { "provider": "{{state.intelligence.selected}}" },
			  "into": "state.intelligence.data", "onError": [{ "set": "state.intelligence.error", "to": "{{error}}" }] },
			{ "run": "intelligence.resetKey" }
		],
		"intelligence.getKey": [
			{ "call": "intelligence.openKeyHelp", "with": { "provider": "{{state.intelligence.selected}}" }, "onError": [] }
		],
		"intelligence.resetKey": [
			{ "note": "The key field isn't bound to the state: building it again empties it" },
			{ "set": "state.intelligence.keyShown", "to": false },
			{ "after": 0, "do": [{ "set": "state.intelligence.keyShown", "to": true }] }
		]
	}
}
