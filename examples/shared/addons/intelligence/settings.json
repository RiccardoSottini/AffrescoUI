{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The intelligence settings, to include: which provider of intelligence (Anthropic, OpenAI, an OpenAI-compatible server, Claude Code) and which model every app's assistant uses. Put { \"use\": \"intelligenceSettings\" } in a container (the AffrescoUI Launcher's settingsIntelligence). It calls the host's intelligence.* natives (examples/shared/intelligence/Intelligence.hpp), which only the Launcher's host registers; without them it shows stand-in data and can't save. The API key field isn't bound to the state: what is typed goes to the host's memory (intelligence.stageKey), then to the system's keychain on save, and the field is emptied. Everything here is named intelligence..., state under state.intelligence. See README.md.",
	"tokens": {
		"intelligence.accent": { "light": "#0969da", "dark": "#4493f8" },
		"intelligence.accentHover": { "light": "#0550ae", "dark": "#2f81f7" },
		"intelligence.onAccent": { "light": "#ffffff", "dark": "#ffffff" },
		"intelligence.surface": { "light": "#ffffff", "dark": "#161b22" },
		"intelligence.raised": { "light": "#f6f8fa", "dark": "#21262d" },
		"intelligence.selected": { "light": "#ddf4ff", "dark": "#0c2d6b" },
		"intelligence.border": { "light": "#d0d7de", "dark": "#30363d" },
		"intelligence.text": { "light": "#1f2328", "dark": "#e6edf3" },
		"intelligence.dim": { "light": "#57606a", "dark": "#8d96a0" },
		"intelligence.success": { "light": "#1a7f37", "dark": "#3fb950" },
		"intelligence.warning": { "light": "#9a6700", "dark": "#d29922" },
		"intelligence.danger": { "light": "#cf222e", "dark": "#f85149" }
	},
	"strings": {
		"default": "en",
		"en": {
			"intelligence.title": "AI assistant",
			"intelligence.intro": "Choose the provider of intelligence the assistant of every app uses. Keys are kept in the system's keychain, never in a file.",
			"intelligence.inUse": "In use: {provider} · {model}",
			"intelligence.none": "No provider is set up yet: choose one below.",
			"intelligence.providers": "Providers",
			"intelligence.status.inUse": "In use",
			"intelligence.status.ready": "Ready",
			"intelligence.status.keySaved": "Key saved",
			"intelligence.status.needsKey": "Needs a key",
			"intelligence.status.notInstalled": "Not installed",
			"intelligence.key": "API key",
			"intelligence.keyOptional": "API key (optional)",
			"intelligence.keyPlaceholder": "Paste the key",
			"intelligence.keySaved": "A key is saved in {store}.",
			"intelligence.notKept": "This system has no keychain: a key is kept only until AffrescoUI closes.",
			"intelligence.getKey": "Get a key",
			"intelligence.install": "Install it",
			"intelligence.removeKey": "Remove the key",
			"intelligence.baseUrl": "Base URL",
			"intelligence.baseUrlHelp": "https://, or http:// on this computer (Ollama, LM Studio)",
			"intelligence.claudeCode": "Uses your own Claude Code and its sign-in, with no tools: it can't run commands or change files.",
			"intelligence.model": "Model",
			"intelligence.modelChosen": "Model: {model}",
			"intelligence.searchModels": "Search the models…",
			"intelligence.useModel": "Use “{model}”",
			"intelligence.noModels": "No model matches.",
			"intelligence.loadingModels": "Loading the models…",
			"intelligence.refresh": "Refresh models",
			"intelligence.recommended": "Recommended",
			"intelligence.save": "Save and use",
			"intelligence.test": "Test connection",
			"intelligence.testing": "Testing…",
			"intelligence.saved": "Saved: every app's assistant uses it now.",
			"intelligence.launcherOnly": "These settings can only be changed in the AffrescoUI Launcher."
		},
		"es": {
			"intelligence.title": "Asistente de IA",
			"intelligence.intro": "Elige el proveedor de inteligencia que usa el asistente de cada aplicación. Las claves se guardan en el llavero del sistema, nunca en un archivo.",
			"intelligence.inUse": "En uso: {provider} · {model}",
			"intelligence.none": "Aún no hay ningún proveedor: elige uno abajo.",
			"intelligence.providers": "Proveedores",
			"intelligence.status.inUse": "En uso",
			"intelligence.status.ready": "Listo",
			"intelligence.status.keySaved": "Clave guardada",
			"intelligence.status.needsKey": "Necesita una clave",
			"intelligence.status.notInstalled": "No instalado",
			"intelligence.key": "Clave de API",
			"intelligence.keyOptional": "Clave de API (opcional)",
			"intelligence.keyPlaceholder": "Pega la clave",
			"intelligence.keySaved": "Hay una clave guardada en {store}.",
			"intelligence.notKept": "Este sistema no tiene llavero: una clave solo se guarda hasta que se cierra AffrescoUI.",
			"intelligence.getKey": "Obtener una clave",
			"intelligence.install": "Instalarlo",
			"intelligence.removeKey": "Borrar la clave",
			"intelligence.baseUrl": "URL base",
			"intelligence.baseUrlHelp": "https://, o http:// en este equipo (Ollama, LM Studio)",
			"intelligence.claudeCode": "Usa tu propio Claude Code y su sesión, sin herramientas: no puede ejecutar órdenes ni cambiar archivos.",
			"intelligence.model": "Modelo",
			"intelligence.modelChosen": "Modelo: {model}",
			"intelligence.searchModels": "Busca los modelos…",
			"intelligence.useModel": "Usar «{model}»",
			"intelligence.noModels": "Ningún modelo coincide.",
			"intelligence.loadingModels": "Cargando los modelos…",
			"intelligence.refresh": "Actualizar modelos",
			"intelligence.recommended": "Recomendado",
			"intelligence.save": "Guardar y usar",
			"intelligence.test": "Probar la conexión",
