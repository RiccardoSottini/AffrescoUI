		"fr": {
			"intelligence.title": "Assistant IA",
			"intelligence.intro": "Choisissez le fournisseur d'intelligence qu'utilise l'assistant de chaque application. Les clés sont gardées dans le trousseau du système, jamais dans un fichier.",
			"intelligence.inUse": "Utilisé : {provider} · {model}",
