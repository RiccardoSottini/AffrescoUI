{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Sign in: three screens (sign in, create an account, signed in), validation with check, a reset dialog, light and dark tokens, no code.",
	"window": { "title": "Sign in", "width": 960, "height": 720, "minWidth": 600, "minHeight": 640 },
	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 15, "fallback": ["icons"] },
		"small": { "file": "../fonts/Roboto-Regular.ttf", "size": 13, "fallback": ["iconsSmall"] },
		"title": { "file": "../fonts/Roboto-Regular.ttf", "size": 26 },
		"icons": { "file": "../fonts/Lucide.ttf", "size": 18 },
		"iconsSmall": { "file": "../fonts/Lucide.ttf", "size": 13 },
		"logo": { "file": "../fonts/Lucide.ttf", "size": 22 }
	},
	"tokens": {
		"radius.card": 16,
		"radius.field": 10,
		"color.background": { "light": "#eef2ff", "dark": "#0b1020" },
		"color.glow": { "light": "#818cf855", "dark": "#6366f130" },
		"color.glow2": { "light": "#f0abfc44", "dark": "#a855f724" },
		"color.surface": { "light": "#ffffff", "dark": "#141b2e" },
		"color.text": { "light": "#0f172a", "dark": "#e2e8f0" },
		"color.muted": { "light": "#64748b", "dark": "#94a3b8" },
		"color.border": { "light": "#e2e8f0", "dark": "#26304a" },
		"color.input": { "light": "#f8fafc", "dark": "#0f1527" },
		"color.inputFocused": { "light": "#ffffff", "dark": "#111a33" },
		"color.hover": { "light": "#f1f5f9", "dark": "#1c2540" },
		"color.accent": { "light": "#6366f1", "dark": "#818cf8" },
		"color.accentHover": { "light": "#7477f3", "dark": "#939cfa" },
		"color.accentPressed": { "light": "#4f46e5", "dark": "#6366f1" },
		"color.accentText": { "light": "#ffffff", "dark": "#0b1020" },
		"color.accentSoft": { "light": "#e0e7ff", "dark": "#1e2550" },
		"color.error": { "light": "#dc2626", "dark": "#f87171" },
		"color.weak": { "light": "#ef4444", "dark": "#f87171" },
		"color.fair": { "light": "#f59e0b", "dark": "#fbbf24" },
		"color.good": { "light": "#6366f1", "dark": "#818cf8" },
		"color.strong": { "light": "#16a34a", "dark": "#4ade80" },
		"color.shadow": { "light": "#0f172a1f", "dark": "#00000066" },
		"color.backdrop": { "light": "#0f172a66", "dark": "#000000a0" },
		"color.toast": { "light": "#0f172a", "dark": "#e2e8f0" },
		"color.toastText": { "light": "#ffffff", "dark": "#0f172a" }
	},
	"colors": { "accent": "#6366f1", "accentHover": "#7477f3", "fieldFocused": "#ffffff" },
	"theme": "{{state.theme}}",
	"state": {
		"email": "",
		"password": "",
		"name": "",
		"submitted": false,
		"theme": "light",
		"focus": "",
		"showPassword": false,
		"remember": true,
		"terms": false,
		"forgot": { "open": false, "email": "", "error": "" },
		"toast": { "open": false, "message": "" }
	},
	"stateTypes": {
		"email": { "type": "string" },
		"password": { "type": "string" },
		"name": { "type": "string" },
		"submitted": { "type": "boolean" },
		"theme": { "enum": ["light", "dark"] },
		"focus": { "type": "string" },
		"showPassword": { "type": "boolean" },
		"remember": { "type": "boolean" },
		"terms": { "type": "boolean" }
	},
	"persist": ["state.theme", "state.remember"],
	"computed": {
		"emailValid": "{{contains(state.email, '@') && contains(state.email, '.')}}",
		"passwordValid": "{{length(state.password) >= 8}}",
		"strength": "{{length(state.password) == 0 ? 0 : 1 + (length(state.password) >= 8 ? 1 : 0) + (lower(state.password) != state.password ? 1 : 0) + (some(split(state.password, ''), contains('0123456789', it)) ? 1 : 0)}}",
		"strengthName": "{{['', 'Weak', 'Fair', 'Good', 'Strong'][computed.strength]}}",
		"errors": "{{!state.submitted ? 0 : (computed.emailValid ? 0 : 1) + (computed.passwordValid ? 0 : 1)}}",
		"initials": "{{upper(slice(length(trim(state.name)) > 0 ? trim(state.name) : state.email, 0, 1))}}"
	},
	"styles": {
		"caption": { "type": "label", "height": 20, "textColor": "@color.muted", "anchors": { "left": 0, "right": 0 } },
		"fieldLabel": {
			"type": "label",
			"font": "small",
			"height": 18,
			"textColor": "@color.text",
			"anchors": { "left": 0, "right": 0 }
		},
		"fieldBox": {
			"anchors": { "left": 0, "right": 0, "top": 0 },
			"height": 44,
			"radius": "@radius.field",
			"color": "@color.input",
			"borderWidth": 1,
			"borderColor": "@color.border",
			"hover": { "borderColor": "@color.muted" }
		},
		"fieldBoxOn": {
			"style": "fieldBox",
			"color": "@color.inputFocused",
			"borderWidth": 2,
			"borderColor": "@color.accent",
			"hover": { "borderColor": "@color.accent" },
			"shadow": { "y": 0, "blur": 8, "color": "@color.glow" }
		},
		"fieldBoxError": {
			"style": "fieldBox",
			"borderColor": "@color.error",
			"hover": { "borderColor": "@color.error" }
		},
		"input": {
			"type": "textarea",
			"padding": 8,
			"color": "transparent",
			"textColor": "@color.text",
			"placeholderColor": "@color.muted"
		},
		"inputHidden": { "style": "input", "textColor": "transparent" },
		"field": {
			"type": "textarea",
			"padding": 10,
			"radius": "@radius.field",
			"borderWidth": 1,
			"color": "@color.input",
			"focused": { "borderColor": "@color.accent" },
			"textColor": "@color.text",
			"placeholderColor": "@color.muted"
		},
		"title": {
			"type": "label",
			"font": "title",
			"height": 34,
			"textColor": "@color.text",
			"anchors": { "left": 0, "right": 0 }
		},
		"primary": {
			"type": "label",
			"height": 46,
			"anchors": { "left": 0, "right": 0 },
			"align": "center",
			"radius": "@radius.field",
			"color": "@color.accent",
			"textColor": "@color.accentText",
			"cursor": "hand",
			"focusable": true,
			"role": "button",
			"shadow": { "y": 4, "blur": 12, "color": "@color.glow" },
			"hover": { "color": "@color.accentHover" },
			"pressed": { "color": "@color.accentPressed" },
			"transition": { "color": 120 }
		},
		"secondary": {
			"style": "primary",
			"color": "transparent",
			"textColor": "@color.text",
			"borderWidth": 1,
			"borderColor": "@color.border",
			"shadow": { "color": "#00000000" },
			"hover": { "color": "@color.hover" },
			"pressed": { "color": "@color.border" }
		},
		"link": {
			"type": "label",
			"height": 30,
			"anchors": { "left": 0, "right": 0 },
			"align": "center",
			"textColor": "@color.accent",
			"cursor": "hand",
			"hover": { "textColor": "@color.accentPressed" }
		},
		"smallLink": {
			"type": "label",
			"font": "small",
			"textColor": "@color.accent",
			"cursor": "hand",
			"fitText": true,
			"hover": { "textColor": "@color.accentPressed" }
		},
		"iconButton": {
			"type": "label",
			"text": "",
			"width": 32,
			"height": 32,
			"radius": 8,
			"color": "transparent",
			"textColor": "@color.muted",
			"align": "center",
			"cursor": "hand",
			"hover": { "color": "@color.hover", "textColor": "@color.text" }
		},
		"card": {
			"width": 420,
			"radius": "@radius.card",
			"color": "@color.surface",
			"borderWidth": 1,
			"borderColor": "@color.border",
			"shadow": { "y": 12, "blur": 32, "color": "@color.shadow" }
		},
		"form": { "type": "column", "fill": 36, "gap": 8 },
		"logo": {
			"type": "label",
			"font": "logo",
			"icon": "feather",
			"text": "",
			"width": 48,
			"height": 48,
			"radius": 14,
			"align": "center",
			"color": "@color.accent",
			"textColor": "@color.accentText",
			"shadow": { "y": 6, "blur": 16, "color": "@color.glow" }
		},
		"spacer": { "height": 6, "anchors": { "left": 0, "right": 0 }, "color": "transparent" },
		"checkRow": {
			"type": "row",
			"height": 22,
			"gap": 8,
			"alignItems": "center",
			"anchors": { "left": 0, "right": 0 }
		},
		"checkOff": {
			"type": "label",
			"font": "iconsSmall",
			"text": "",
			"width": 18,
			"height": 18,
			"radius": 5,
			"align": "center",
			"color": "@color.input",
			"borderWidth": 1,
			"borderColor": "@color.border",
			"cursor": "hand",
			"focusable": true,
			"role": "checkbox",
			"hover": { "borderColor": "@color.accent" }
		},
		"checkOn": {
			"style": "checkOff",
			"icon": "check",
			"color": "@color.accent",
			"borderColor": "@color.accent",
			"textColor": "@color.accentText"
		}
	},
	"components": {
		"checkedField": {
			"note": "A field with an icon and its error under it once the form was submitted; secret ones hide their text behind dots and have an eye to show it. params: bind, content, key, icon, placeholder, valid, message, secret",
			"params": {
				"bind": "",
				"content": "",
				"key": "",
				"icon": "",
				"placeholder": "",
				"valid": true,
				"message": "",
				"secret": false
			},
			"node": {
				"id": "panel-checked-field",
				"check": { "value": "{{!state.submitted || valid}}", "rule": "{{value}}", "message": "{{message}}" },
				"let": { "hidden": "{{secret && !state.showPassword}}", "on": "{{state.focus == key}}" },
				"anchors": { "left": 0, "right": 0 },
				"height": "{{error ? 68 : 44}}",
				"color": "transparent",
				"children": [
					{
						"id": "field-box",
						"style": "{{on ? 'fieldBoxOn' : error ? 'fieldBoxError' : 'fieldBox'}}",
						"children": [
							{
								"id": "field-icon",
								"type": "label",
								"font": "icons",
								"icon": "{{icon}}",
								"text": "",
								"anchors": { "left": 12, "top": 0, "bottom": 0 },
								"width": 20,
								"align": "center",
								"textColor": "{{on ? '@color.accent' : '@color.muted'}}"
							},
							{
								"id": "field-dots",
								"type": "label",
								"text": "{{hidden ? join(map(slice(split(content, ''), 0, 40), '•'), '') : ''}}",
								"textColor": "@color.text",
								"align": { "horizontal": "start", "vertical": "center" },
								"anchors": { "left": 42, "right": 44, "top": 0, "bottom": 0 }
							},
							{
								"id": "textarea-placeholder",
								"style": "{{hidden ? 'inputHidden' : 'input'}}",
								"anchors": { "left": 34, "right": "{{secret ? 44 : 8}}", "top": 1, "bottom": 1 },
								"placeholder": "{{placeholder}}",
								"bind": "{{bind}}",
								"label": "{{placeholder}}",
								"onFocus": { "set": "state.focus", "to": "{{key}}" },
								"onBlur": {
									"if": "{{state.focus == key}}",
									"then": [{ "set": "state.focus", "to": "" }]
								}
							},
							{
								"id": "field-eye",
								"when": "{{secret}}",
								"style": "iconButton",
								"font": "iconsSmall",
								"icon": "{{state.showPassword ? 'eye-off' : 'eye'}}",
								"anchors": { "right": 6, "top": 6 },
								"tooltip": "{{state.showPassword ? 'Hide the password' : 'Show the password'}}",
								"onClick": { "set": "state.showPassword", "to": "{{!state.showPassword}}" }
							}
						]
					},
					{
						"id": "label-error",
						"when": "{{error}}",
						"type": "label",
						"font": "small",
						"icon": "circle-alert",
						"text": "{{error}}",
						"textColor": "@color.error",
						"anchors": { "left": 2, "right": 0, "top": 50 },
						"height": 18
					}
				]
			}
		}
	},
	"actions": {
		"notify": [
			{ "note": "with: message. A toast in the corner for a few seconds" },
			{ "set": "state.toast", "to": { "open": true, "message": "{{message}}" } },
			{ "debounce": 4000, "do": [{ "set": "state.toast.open", "to": false }] }
		],
		"signIn": [
			{ "set": "state.submitted", "to": true },
			{ "if": "{{!computed.emailValid || !computed.passwordValid}}", "then": [{ "stop": true }] },
			{ "set": "state.submitted", "to": false },
			{ "navigate": "signedIn" }
		],
		"createAccount": [
			{ "set": "state.submitted", "to": true },
			{
				"if": "{{length(trim(state.name)) == 0 || !computed.emailValid || !computed.passwordValid}}",
				"then": [{ "stop": true }]
			},
			{ "set": "state.submitted", "to": false },
			{ "navigate": "signedIn" },
			{ "run": "notify", "with": { "message": "Welcome, {{trim(state.name)}}" } }
		],
		"signOut": [
			{ "set": "state.password", "to": "" },
			{ "set": "state.showPassword", "to": false },
			{ "navigate": "signIn" }
		],
		"openForgot": [
			{ "set": "state.forgot", "to": { "open": true, "email": "{{state.email}}", "error": "" } },
			{ "focus": "#forgotEmail" }
		],
		"sendReset": [
			{
				"if": "{{!(contains(state.forgot.email, '@') && contains(state.forgot.email, '.'))}}",
				"then": [{ "set": "state.forgot.error", "to": "Enter the email of your account" }, { "stop": true }]
			},
			{ "set": "state.forgot.open", "to": false },
			{ "run": "notify", "with": { "message": "We sent a reset link to {{state.forgot.email}}" } }
		],
		"closeForgot": [{ "set": "state.forgot.open", "to": false }],
		"toggleTheme": [{ "set": "state.theme", "to": "{{state.theme == 'light' ? 'dark' : 'light'}}" }]
	},
	"keys": { "escape": { "navigate": "back" }, "mod+j": "toggleTheme" },
	"screens": {
		"signIn": {
			"id": "panel-sign-in",
			"type": "column",
			"fill": 0,
			"justify": "center",
			"alignItems": "center",
			"color": "transparent",
			"children": [
				{
					"id": "card",
					"style": "card",
					"height": "{{502 + computed.errors * 24}}",
					"children": [
						{
							"id": "stack-form",
							"style": "form",
							"children": [
								{ "id": "logo", "style": "logo" },
								{ "id": "spacer-logo", "style": "spacer", "height": 4 },
								{ "id": "label-welcome-back", "style": "title", "text": "Welcome back" },
								{
									"id": "label-sign-in-to",
									"style": "caption",
									"text": "Sign in to continue to AffrescoUI"
								},
								{ "id": "spacer-head", "style": "spacer" },
								{ "id": "label-email", "style": "fieldLabel", "text": "Email" },
								{
									"id": "email",
									"use": "checkedField",
									"with": {
										"bind": "state.email",
										"content": "{{state.email}}",
										"key": "email",
										"icon": "mail",
										"placeholder": "you@example.com",
										"valid": "{{computed.emailValid}}",
										"message": "Enter an email address"
									}
								},
								{
									"id": "row-password",
									"type": "row",
									"height": 18,
									"justify": "space-between",
									"anchors": { "left": 0, "right": 0 },
									"children": [
										{
											"id": "label-password",
											"style": "fieldLabel",
											"anchors": {},
											"fitText": true,
											"text": "Password"
										},
										{
											"id": "forgot",
											"style": "smallLink",
											"text": "Forgot password?",
											"onClick": "openForgot"
										}
									]
								},
								{
									"id": "password",
									"use": "checkedField",
									"with": {
										"bind": "state.password",
										"content": "{{state.password}}",
										"key": "password",
										"icon": "lock",
										"placeholder": "At least 8 characters",
										"valid": "{{computed.passwordValid}}",
										"message": "At least 8 characters",
										"secret": true
									}
								},
								{
									"id": "row-remember",
									"style": "checkRow",
									"children": [
										{
											"id": "remember",
											"style": "{{state.remember ? 'checkOn' : 'checkOff'}}",
											"label": "Remember me",
											"onClick": { "set": "state.remember", "to": "{{!state.remember}}" }
										},
										{
											"id": "label-remember",
											"type": "label",
											"font": "small",
											"text": "Remember me on this device",
											"fitText": true,
											"textColor": "@color.muted",
											"cursor": "hand",
											"onClick": { "set": "state.remember", "to": "{{!state.remember}}" }
										}
									]
								},
								{ "id": "spacer-button", "style": "spacer", "height": 2 },
								{
									"id": "signIn",
									"style": "primary",
									"icon": "log-in",
									"text": "Sign in",
									"onClick": "signIn"
								},
								{
									"id": "toCreate",
									"style": "link",
									"text": "No account yet? Create one",
									"onClick": [
										{ "set": "state.submitted", "to": false },
										{ "navigate": "createAccount" }
									]
								}
							]
						}
					],
					"keys": { "enter": "signIn" }
				}
			]
		},
		"createAccount": {
			"id": "panel-create-account",
			"type": "column",
			"fill": 0,
			"justify": "center",
			"alignItems": "center",
			"color": "transparent",
			"children": [
				{
					"id": "panel-card",
					"style": "card",
					"height": "{{572 + (state.submitted ? (length(trim(state.name)) > 0 ? 0 : 1) + computed.errors : 0) * 24}}",
					"children": [
						{
							"id": "stack-form-2",
							"style": "form",
							"children": [
								{ "id": "logo-2", "style": "logo" },
								{ "id": "spacer-logo-2", "style": "spacer", "height": 4 },
								{ "id": "label-create-an-account", "style": "title", "text": "Create an account" },
								{
									"id": "label-create-caption",
									"style": "caption",
									"text": "Free, and it takes a minute"
								},
								{ "id": "spacer-head-2", "style": "spacer" },
								{ "id": "label-name", "style": "fieldLabel", "text": "Name" },
								{
									"id": "checked-field-form",
									"use": "checkedField",
									"with": {
										"bind": "state.name",
										"content": "{{state.name}}",
										"key": "name",
										"icon": "user",
										"placeholder": "Your name",
										"valid": "{{length(trim(state.name)) > 0}}",
										"message": "Enter your name"
									}
								},
								{ "id": "label-email-2", "style": "fieldLabel", "text": "Email" },
								{
									"id": "checked-field-form-2",
									"use": "checkedField",
									"with": {
										"bind": "state.email",
										"content": "{{state.email}}",
										"key": "email",
										"icon": "mail",
										"placeholder": "you@example.com",
										"valid": "{{computed.emailValid}}",
										"message": "Enter an email address"
									}
								},
								{ "id": "label-password-2", "style": "fieldLabel", "text": "Password" },
								{
									"id": "checked-field-form-3",
									"use": "checkedField",
									"with": {
										"bind": "state.password",
										"content": "{{state.password}}",
										"key": "password",
										"icon": "lock",
										"placeholder": "At least 8 characters",
										"valid": "{{computed.passwordValid}}",
										"message": "At least 8 characters",
										"secret": true
									}
								},
								{
									"id": "strength",
									"type": "row",
									"gap": 6,
									"height": 18,
									"alignItems": "center",
									"anchors": { "left": 0, "right": 0 },
									"children": [
										{
											"id": "strength-bar",
											"repeat": { "for": "level", "in": "{{[1, 2, 3, 4]}}" },
											"width": 54,
											"height": 5,
											"radius": 3,
											"color": "{{computed.strength >= level ? ['', '@color.weak', '@color.fair', '@color.good', '@color.strong'][computed.strength] : '@color.border'}}"
										},
										{
											"id": "strength-name",
											"type": "label",
											"font": "small",
											"fitText": true,
											"height": 18,
											"text": "{{length(state.password) == 0 ? 'Use 8 or more characters, a capital and a digit' : computed.strengthName + ' password'}}",
											"textColor": "@color.muted"
										}
									]
								},
								{ "id": "spacer-button-2", "style": "spacer", "height": 2 },
								{
									"id": "label-create-account",
									"style": "primary",
									"icon": "user-plus",
									"text": "Create account",
									"onClick": "createAccount"
								},
								{
									"id": "label-back-to-sign",
									"style": "link",
									"text": "Back to sign in (Esc)",
									"onClick": { "navigate": "back" }
								}
							]
						}
					],
					"keys": { "enter": "createAccount" }
				}
			]
		},
		"signedIn": {
			"id": "panel-signed-in",
			"type": "column",
			"fill": 0,
			"justify": "center",
			"alignItems": "center",
			"color": "transparent",
			"children": [
				{
					"id": "panel-card-2",
					"style": "card",
					"height": 320,
					"children": [
						{
							"id": "stack-form-3",
							"style": "form",
							"children": [
								{
									"id": "avatar",
									"type": "label",
									"font": "title",
									"text": "{{computed.initials}}",
									"width": 56,
									"height": 56,
									"radius": 999,
									"align": "center",
									"color": "@color.accentSoft",
									"textColor": "@color.accent"
								},
								{ "id": "spacer-avatar", "style": "spacer", "height": 4 },
								{ "id": "label-you-re-in", "style": "title", "text": "You're in" },
								{
									"id": "label-signed-in-as",
									"style": "caption",
									"text": "Signed in as {{state.email}}"
								},
								{
									"id": "label-remembered",
									"type": "label",
									"font": "small",
									"height": 20,
									"anchors": { "left": 0, "right": 0 },
									"icon": "{{state.remember ? 'shield-check' : 'clock'}}",
									"textColor": "@color.muted",
									"text": "{{state.remember ? 'This device stays signed in' : 'You will be signed out when you close the app'}}"
								},
								{ "id": "spacer-signed", "style": "spacer", "height": 16 },
								{
									"id": "label-sign-out",
									"style": "secondary",
									"icon": "log-out",
									"text": "Sign out",
									"onClick": "signOut"
								}
							]
						}
					]
				}
			]
		}
	},
	"root": {
		"id": "panel-root",
		"color": "@color.background",
		"children": [
			{
				"id": "glow",
				"width": 520,
				"height": 520,
				"radius": 999,
				"x": -160,
				"y": -200,
				"color": "@color.glow",
				"shadow": { "blur": 120, "color": "@color.glow" }
			},
			{
				"id": "glow-2",
				"width": 460,
				"height": 460,
				"radius": 999,
				"anchors": { "right": -140, "bottom": -180 },
				"color": "@color.glow2",
				"shadow": { "blur": 120, "color": "@color.glow2" }
			},
			{ "id": "screens", "type": "outlet", "fill": 0 },
			{
				"id": "themeToggle",
				"style": "iconButton",
				"icon": "{{state.theme == 'light' ? 'moon' : 'sun'}}",
				"anchors": { "right": 20, "top": 18 },
				"tooltip": "Switch light and dark (Cmd+J)",
				"onClick": "toggleTheme"
			},
			{
				"id": "footer",
				"type": "label",
				"font": "small",
				"textColor": "@color.muted",
				"align": "center",
				"anchors": { "left": 0, "right": 0, "bottom": 18 },
				"height": 18,
				"text": "An AffrescoUI template  ·  every screen, rule and colour is in one JSON file"
			},
			{
				"id": "forgotDialog",
				"use": "dialog",
				"with": {
					"open": "state.forgot.open",
					"title": "Reset your password",
					"message": "We will email you a link to choose a new one.",
					"width": 420,
					"height": "{{state.forgot.error == '' ? 196 : 218}}",
					"color": "@color.surface",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"highlight": "@color.accent",
					"backdrop": "@color.backdrop",
					"buttons": [
						{ "title": "Send link", "run": "sendReset" },
						{ "title": "Cancel", "run": "closeForgot" }
					]
				},
				"children": [
					{
						"id": "forgotEmail",
						"style": "field",
						"anchors": { "left": 20, "right": 20, "top": 76 },
						"height": 38,
						"borderColor": "{{state.forgot.error == '' ? '@color.border' : '@color.error'}}",
						"placeholder": "you@example.com",
						"bind": "state.forgot.email",
						"onChange": { "set": "state.forgot.error", "to": "" },
						"onSubmit": "sendReset"
					},
					{
						"id": "forgotError",
						"when": "{{state.forgot.error != ''}}",
						"type": "label",
						"font": "small",
						"icon": "circle-alert",
						"text": "{{state.forgot.error}}",
						"textColor": "@color.error",
						"anchors": { "left": 22, "right": 20, "top": 120 },
						"height": 18
					}
				]
			},
			{
				"id": "toast",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"color": "@color.toast",
					"textColor": "@color.toastText",
					"accent": "@color.accent"
				}
			}
		]
	}
}
