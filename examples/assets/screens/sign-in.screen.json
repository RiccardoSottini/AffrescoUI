{
	"$schema": "../../../schema/sglgui-screen.schema.json",
	"format": "sglgui-screen",
	"version": 1,

	"window": { "title": "Sign in", "width": 900, "height": 640, "minWidth": 600, "minHeight": 560 },

	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 16 },
		"title": { "file": "../fonts/Roboto-Regular.ttf", "size": 28 }
	},

	"colors": {
		"background": "#0f172a",
		"card": "#ffffff",
		"text": "#0f172a",
		"muted": "#64748b",
		"field": "#f1f5f9",
		"fieldFocused": "#e0e7ff",
		"accent": "#6366f1",
		"accentHover": "#7477f3",
		"accentPressed": "#4f46e5"
	},

	"styles": {
		"caption": { "type": "label", "height": 22, "textColor": "@muted", "anchors": { "left": 0, "right": 0 } },
		"field": {
			"type": "textarea",
			"height": 44,
			"padding": 12,
			"anchors": { "left": 0, "right": 0 },
			"color": "@field",
			"focused": { "color": "@fieldFocused" },
			"textColor": "@text"
		}
	},

	"root": {
		"color": "@background",
		"children": [
			{
				"id": "card",
				"anchors": { "left": "25%", "right": "25%", "top": 70, "bottom": 70 },
				"color": "@card",
				"children": [
					{
						"type": "stack",
						"fill": 40,
						"gap": 10,
						"children": [
							{ "type": "label", "text": "Welcome back", "font": "title", "height": 40, "textColor": "@text", "anchors": { "left": 0, "right": 0 } },
							{ "style": "caption", "text": "Sign in to continue to sGLGUI" },
							{ "height": 10, "color": "transparent" },
							{ "style": "caption", "text": "Email" },
							{ "id": "email", "style": "field", "placeholder": "you@example.com" },
							{ "style": "caption", "text": "Password" },
							{ "id": "password", "style": "field", "placeholder": "At least 8 characters" },
							{ "height": 10, "color": "transparent" },
							{
								"id": "signIn",
								"type": "label",
								"text": "Sign in",
								"height": 46,
								"anchors": { "left": 0, "right": 0 },
								"align": "center",
								"color": "@accent",
								"textColor": "#ffffff",
								"cursor": "hand",
								"hover": { "color": "@accentHover" },
								"pressed": { "color": "@accentPressed" },
								"onClick": "signIn"
							},
							{
								"type": "label",
								"text": "No account yet? Create one",
								"height": 30,
								"anchors": { "left": 0, "right": 0 },
								"align": "center",
								"textColor": "@accent",
								"cursor": "hand",
								"onClick": "createAccount"
							}
						]
					}
				]
			}
		]
	}
}
