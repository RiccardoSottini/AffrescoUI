{
	"$schema": "../../../schema/sglgui-screen.schema.json",
	"format": "sglgui-screen",
	"version": 1,

	"window": { "title": "Tempo: an sGLGUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 15 },
		"small": { "file": "../fonts/Roboto-Regular.ttf", "size": 12 },
		"heading": { "file": "../fonts/Roboto-Regular.ttf", "size": 17 },
		"title": { "file": "../fonts/Roboto-Regular.ttf", "size": 44 },
		"cover": { "file": "../fonts/Roboto-Regular.ttf", "size": 64 },
		"brand": { "file": "../fonts/Roboto-Regular.ttf", "size": 24 }
	},

	"colors": {
		"background": "#100d17",
		"sidebar": "#0a0810",
		"surface": "#17131f",
		"rowHover": "#221c2e",
		"playingRow": "#2a1f33",
		"bar": "#0d0b13",
		"text": "#f4f1fa",
		"muted": "#9a92ab",
		"faint": "#3a3347",
		"border": "#241e2f",
		"accent": "#fb7185",
		"accentHover": "#fda4af",
		"button": "#241e2f",
		"buttonHover": "#30283d"
	},

	"permissions": {
		"authors": { "studio": "allow", "app": "allow", "agent": "review", "*": "review" },
		"reviewers": ["studio"],
		"locked": ["#statusBar"]
	},

	"state": {
		"current": 0,
		"playingList": 0,
		"playingTrack": 2,
		"isPlaying": true,
		"progress": 38,
		"volume": 70,
		"playlists": [
			{
				"name": "Late Night Code",
				"initials": "LN",
				"color": "#7c3aed",
				"description": "Low-key beats for long sessions. Updated every Friday.",
				"length": "38 min",
				"tracks": [
					{ "title": "Vertex Buffers", "artist": "The Shaders", "album": "Core Profile", "time": "3:42" },
					{ "title": "Dirty Flags", "artist": "Nora Vale", "album": "Redraw", "time": "4:05" },
					{ "title": "One Draw Call", "artist": "The Shaders", "album": "Core Profile", "time": "3:18" },
					{ "title": "Glyph Atlas", "artist": "Kerning Club", "album": "Baseline", "time": "5:01" },
					{ "title": "Sixteen Bytes", "artist": "Nora Vale", "album": "Redraw", "time": "2:57" },
					{ "title": "Wait Events", "artist": "Idle Loop", "album": "Zero Percent", "time": "4:33" },
					{ "title": "Reconcile", "artist": "Kerning Club", "album": "Baseline", "time": "3:50" },
					{ "title": "Hot Path", "artist": "Idle Loop", "album": "Zero Percent", "time": "3:24" },
					{ "title": "Retina", "artist": "The Shaders", "album": "Core Profile", "time": "4:12" }
				]
			},
			{
				"name": "Morning Run",
				"initials": "MR",
				"color": "#ea580c",
				"description": "Fast, bright and loud. 160 bpm and up.",
				"length": "24 min",
				"tracks": [
					{ "title": "First Light", "artist": "Halfway", "album": "Pace", "time": "3:05" },
					{ "title": "Uphill", "artist": "Mira Sol", "album": "Stride", "time": "2:48" },
					{ "title": "Second Wind", "artist": "Halfway", "album": "Pace", "time": "3:31" },
					{ "title": "Finish Line", "artist": "Mira Sol", "album": "Stride", "time": "4:02" }
				]
			},
			{
				"name": "Sunday Jazz",
				"initials": "SJ",
				"color": "#0d9488",
				"description": "Slow standards and new takes on old tunes.",
				"length": "51 min",
				"tracks": [
					{ "title": "Blue Hour", "artist": "Ada Quartet", "album": "Standards", "time": "6:12" },
					{ "title": "Rainy Avenue", "artist": "Leo Marsh Trio", "album": "Avenue", "time": "5:40" },
					{ "title": "Slow Burn", "artist": "Ada Quartet", "album": "Standards", "time": "7:03" }
				]
			},
			{
				"name": "Focus",
				"initials": "FO",
				"color": "#2563eb",
				"description": "Ambient textures without words.",
				"length": "1 h 12 min",
				"tracks": [
					{ "title": "Deep Work", "artist": "Quiet Rooms", "album": "Hours", "time": "8:20" },
					{ "title": "Flow State", "artist": "Quiet Rooms", "album": "Hours", "time": "9:45" }
				]
			}
		]
	},

	"styles": {
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"control": {
			"type": "label",
			"font": "heading",
			"height": 36,
			"align": "center",
			"color": "@button",
			"hover": { "color": "@buttonHover" },
			"textColor": "@text",
			"cursor": "hand"
		}
	},

	"actions": {
		"next": [
			{ "set": "state.playingTrack", "to": { "$min": [{ "$add": ["{{state.playingTrack}}", 1] }, { "$subtract": [{ "$length": "{{state.playlists[state.playingList].tracks}}" }, 1] }] } },
			{ "set": "state.progress", "to": 0 },
			{ "set": "state.isPlaying", "to": true }
		],
		"previous": [
			{ "set": "state.playingTrack", "to": { "$max": [{ "$subtract": ["{{state.playingTrack}}", 1] }, 0] } },
			{ "set": "state.progress", "to": 0 },
			{ "set": "state.isPlaying", "to": true }
		]
	},

	"root": {
		"color": "@background",
		"children": [
			{
				"id": "sidebar",
				"anchors": { "left": 0, "top": 0, "bottom": 96 },
				"width": 240,
				"color": "@sidebar",
				"children": [
					{ "type": "label", "text": "Tempo", "font": "brand", "textColor": "@text", "anchors": { "left": 28, "top": 28 }, "fitText": true },
					{ "style": "caption", "text": "an sGLGUI template", "anchors": { "left": 28, "top": 62 } },
					{
						"type": "stack",
						"anchors": { "left": 12, "right": 12, "top": 100 },
						"height": 140,
						"gap": 2,
						"children": [
							{
								"repeat": { "for": "item", "in": ["Home", "Search", "Library"] },
								"type": "label",
								"text": "{{item}}",
								"anchors": { "left": 0, "right": 0 },
								"height": 40,
								"padding": 16,
								"align": { "horizontal": "start", "vertical": "center" },
								"color": "@sidebar",
								"hover": { "color": "@surface" },
								"textColor": { "$if": [{ "$equals": ["{{index}}", 2] }, "@text", "@muted"] },
								"cursor": "hand"
							}
						]
					},
					{ "style": "caption", "text": "PLAYLISTS", "anchors": { "left": 28, "top": 252 } },
					{
						"id": "playlists",
						"type": "stack",
						"anchors": { "left": 12, "right": 12, "top": 276, "bottom": 12 },
						"gap": 4,
						"children": [
							{
								"repeat": { "for": "list", "in": "state.playlists" },
								"anchors": { "left": 0, "right": 0 },
								"height": 56,
								"color": { "$if": [{ "$equals": ["{{index}}", "{{state.current}}"] }, "@surface", "@sidebar"] },
								"children": [
									{
										"type": "label",
										"text": "{{list.initials}}",
										"font": "small",
										"anchors": { "left": 10, "top": 8 },
										"width": 40,
										"height": 40,
										"align": "center",
										"color": "{{list.color}}",
										"textColor": "#ffffff"
									},
									{ "type": "label", "text": "{{list.name}}", "textColor": "@text", "anchors": { "left": 62, "top": 10 }, "fitText": true },
									{
										"style": "caption",
										"text": { "$concat": [{ "$length": "{{list.tracks}}" }, " songs"] },
										"anchors": { "left": 62, "top": 31 }
									},
									{
										"when": { "$and": [{ "$equals": ["{{index}}", "{{state.playingList}}"] }, "{{state.isPlaying}}"] },
										"anchors": { "right": 14, "top": 25 },
										"width": 6,
										"height": 6,
										"color": "@accent"
									},
									{
										"fill": 0,
										"color": "transparent",
										"hover": { "color": "#ffffff0d" },
										"cursor": "hand",
										"onClick": [{ "set": "state.current", "to": "{{index}}" }]
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "main",
				"anchors": { "left": 240, "right": 0, "top": 0, "bottom": 96 },
				"color": "transparent",
				"children": [
					{
						"id": "header",
						"anchors": { "left": 0, "right": 0, "top": 0 },
						"height": 264,
						"color": "@surface",
						"children": [
							{
								"type": "label",
								"text": "{{state.playlists[state.current].initials}}",
								"font": "cover",
								"anchors": { "left": 40, "top": 40 },
								"width": 184,
								"height": 184,
								"align": "center",
								"color": "{{state.playlists[state.current].color}}",
								"textColor": "#ffffff"
							},
							{ "style": "caption", "text": "PLAYLIST", "anchors": { "left": 256, "top": 74 } },
							{
								"type": "label",
								"text": "{{state.playlists[state.current].name}}",
								"font": "title",
								"textColor": "@text",
								"anchors": { "left": 252, "top": 92 },
								"fitText": true
							},
							{
								"type": "label",
								"text": "{{state.playlists[state.current].description}}",
								"textColor": "@muted",
								"anchors": { "left": 256, "top": 152 },
								"fitText": true
							},
							{
								"style": "caption",
								"text": { "$concat": [{ "$length": "{{state.playlists[state.current].tracks}}" }, " songs  ·  ", "{{state.playlists[state.current].length}}"] },
								"textColor": "@text",
								"anchors": { "left": 256, "top": 178 }
							},
							{
								"type": "label",
								"text": "Play",
								"font": "heading",
								"anchors": { "left": 256, "top": 196 },
								"width": 112,
								"height": 28,
								"align": "center",
								"color": "@accent",
								"hover": { "color": "@accentHover" },
								"textColor": "#1a0b10",
								"cursor": "hand",
								"onClick": [
									{ "set": "state.playingList", "to": "{{state.current}}" },
									{ "set": "state.playingTrack", "to": 0 },
									{ "set": "state.progress", "to": 0 },
									{ "set": "state.isPlaying", "to": true }
								]
							}
						]
					},
					{
						"id": "columns",
						"anchors": { "left": 40, "right": 40, "top": 284 },
						"height": 28,
						"color": "transparent",
						"children": [
							{ "style": "caption", "text": "#", "anchors": { "left": 12, "top": 6 } },
							{ "style": "caption", "text": "TITLE", "anchors": { "left": 52, "top": 6 } },
							{ "style": "caption", "text": "ALBUM", "x": "55%", "y": 6 },
							{ "style": "caption", "text": "TIME", "anchors": { "right": 16, "top": 6 } },
							{ "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 1, "color": "@border" }
						]
					},
					{
						"id": "tracks",
						"type": "stack",
						"anchors": { "left": 40, "right": 40, "top": 320, "bottom": 8 },
						"gap": 2,
						"children": [
							{
								"repeat": { "for": "track", "in": "state.playlists[state.current].tracks", "index": "t" },
								"anchors": { "left": 0, "right": 0 },
								"height": 40,
								"color": { "$if": [{ "$and": [{ "$equals": ["{{state.current}}", "{{state.playingList}}"] }, { "$equals": ["{{t}}", "{{state.playingTrack}}"] }] }, "@playingRow", "transparent"] },
								"children": [
									{
										"type": "label",
										"text": { "$add": ["{{t}}", 1] },
										"textColor": "@muted",
										"anchors": { "left": 12, "top": 0, "bottom": 0 },
										"width": 30,
										"align": { "horizontal": "start", "vertical": "center" }
									},
									{
										"type": "label",
										"text": "{{track.title}}",
										"textColor": { "$if": [{ "$and": [{ "$equals": ["{{state.current}}", "{{state.playingList}}"] }, { "$equals": ["{{t}}", "{{state.playingTrack}}"] }] }, "@accent", "@text"] },
										"anchors": { "left": 52, "top": 3 },
										"fitText": true
									},
									{ "style": "caption", "text": "{{track.artist}}", "anchors": { "left": 52, "top": 22 } },
									{ "type": "label", "text": "{{track.album}}", "textColor": "@muted", "x": "55%", "y": 11, "fitText": true },
									{ "type": "label", "text": "{{track.time}}", "textColor": "@muted", "anchors": { "right": 16, "top": 11 }, "fitText": true },
									{
										"fill": 0,
										"color": "transparent",
										"hover": { "color": "#ffffff0b" },
										"cursor": "hand",
										"onClick": [
											{ "set": "state.playingList", "to": "{{state.current}}" },
											{ "set": "state.playingTrack", "to": "{{t}}" },
											{ "set": "state.progress", "to": 0 },
											{ "set": "state.isPlaying", "to": true }
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "player",
				"anchors": { "left": 0, "right": 0, "bottom": 32 },
				"height": 64,
				"color": "@bar",
				"children": [
					{ "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"type": "label",
						"text": "{{state.playlists[state.playingList].initials}}",
						"font": "small",
						"anchors": { "left": 16, "top": 12 },
						"width": 40,
						"height": 40,
						"align": "center",
						"color": "{{state.playlists[state.playingList].color}}",
						"textColor": "#ffffff"
					},
					{
						"type": "label",
						"text": "{{state.playlists[state.playingList].tracks[state.playingTrack].title}}",
						"textColor": "@text",
						"anchors": { "left": 68, "top": 13 },
						"fitText": true
					},
					{
						"style": "caption",
						"text": "{{state.playlists[state.playingList].tracks[state.playingTrack].artist}}",
						"anchors": { "left": 68, "top": 35 }
					},
					{
						"id": "controls",
						"anchors": { "left": "35%", "right": "35%", "top": 0 },
						"height": 40,
						"color": "transparent",
						"children": [
							{ "style": "control", "text": "«", "anchors": { "left": "20%", "right": "64%", "top": 8 }, "height": 28, "onClick": "previous" },
							{
								"style": "control",
								"text": { "$if": ["{{state.isPlaying}}", "||", ">"] },
								"anchors": { "left": "38%", "right": "38%", "top": 6 },
								"height": 32,
								"color": "@accent",
								"hover": { "color": "@accentHover" },
								"textColor": "#1a0b10",
								"onClick": [{ "toggle": "state.isPlaying" }]
							},
							{ "style": "control", "text": "»", "anchors": { "left": "64%", "right": "20%", "top": 8 }, "height": 28, "onClick": "next" }
						]
					},
					{
						"x": "30%",
						"y": 46,
						"width": "40%",
						"height": 4,
						"color": "@faint",
						"children": [{ "anchors": { "left": 0, "top": 0, "bottom": 0 }, "width": "{{state.progress}}%", "color": "@accent" }]
					},
					{ "style": "caption", "text": "1:24", "x": { "$concat": ["25.5%"] }, "y": 41 },
					{ "style": "caption", "text": "{{state.playlists[state.playingList].tracks[state.playingTrack].time}}", "x": "71%", "y": 41 },
					{ "style": "caption", "text": "Volume", "anchors": { "right": 196, "top": 25 } },
					{
						"style": "control",
						"text": "-",
						"anchors": { "right": 152, "top": 18 },
						"width": 28,
						"height": 28,
						"onClick": [{ "set": "state.volume", "to": { "$max": [{ "$subtract": ["{{state.volume}}", 10] }, 0] } }]
					},
					{
						"anchors": { "right": 52, "top": 30 },
						"width": 92,
						"height": 4,
						"color": "@faint",
						"children": [{ "anchors": { "left": 0, "top": 0, "bottom": 0 }, "width": "{{state.volume}}%", "color": "@text" }]
					},
					{
						"style": "control",
						"text": "+",
						"anchors": { "right": 16, "top": 18 },
						"width": 28,
						"height": 28,
						"onClick": [{ "set": "state.volume", "to": { "$min": [{ "$add": ["{{state.volume}}", 10] }, 100] } }]
					}
				]
			},
			{
				"id": "statusBar",
				"anchors": { "left": 0, "right": 0, "bottom": 0 },
				"height": 32,
				"color": "@sidebar",
				"children": [
					{ "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"type": "label",
						"text": "Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "left": 24, "top": 0, "bottom": 0, "right": 200 },
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{
						"type": "label",
						"text": "{{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "right": 24, "top": 0, "bottom": 0 },
						"width": 160,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			}
		]
	}
}
