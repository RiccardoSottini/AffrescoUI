{
	"$schema": "../../../schema/sglgui-screen.schema.json",
	"format": "sglgui-screen",
	"version": 1,

	"window": { "title": "Forge: an sGLGUI template", "width": 1280, "height": 800, "minWidth": 1040, "minHeight": 640 },

	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 14 },
		"small": { "file": "../fonts/Roboto-Regular.ttf", "size": 12 },
		"code": { "file": "../fonts/Roboto-Regular.ttf", "size": 14 }
	},

	"colors": {
		"background": "#1b1d23",
		"activity": "#14161b",
		"sidebar": "#181a20",
		"tabs": "#14161b",
		"tab": "#181a20",
		"tabActive": "#1b1d23",
		"hover": "#23262e",
		"selected": "#2a2e38",
		"panel": "#16181d",
		"text": "#d6d9e0",
		"muted": "#7c8291",
		"faint": "#4b505c",
		"border": "#262931",
		"accent": "#5b8cff",
		"status": "#3b5bdb",
		"statusText": "#eef2ff",
		"input": "#1f2229",
		"plain": "#d6d9e0",
		"comment": "#6f8f6b",
		"keyword": "#c49bff",
		"type": "#5fd0dd",
		"string": "#e6b071",
		"heading": "#7aa7ff",
		"prompt": "#7ee2a8"
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"]
	},

	"state": {
		"project": "board-app",
		"tabs": [0, 1],
		"active": 0,
		"found": false,
		"openFile": 0,
		"command": "",
		"tree": [
			{ "label": "src/", "depth": 0, "file": -1 },
			{ "label": "main.cpp", "depth": 1, "file": 0 },
			{ "label": "Board.hpp", "depth": 1, "file": 1 },
			{ "label": "Board.cpp", "depth": 1, "file": 2 },
			{ "label": "screens/", "depth": 0, "file": -1 },
			{ "label": "board.screen.json", "depth": 1, "file": 3 },
			{ "label": "CMakeLists.txt", "depth": 0, "file": 4 },
			{ "label": "README.md", "depth": 0, "file": 5 }
		],
		"files": [
			{
				"name": "main.cpp",
				"path": "src / main.cpp",
				"language": "C++",
				"lines": [
					{ "t": "#include <sgl/sgl.hpp>", "c": "keyword" },
					{ "t": "#include \"Board.hpp\"", "c": "keyword" },
					{ "t": "", "c": "plain" },
					{ "t": "// A native board app: the UI is a live document, the logic is C++", "c": "comment" },
					{ "t": "int main() {", "c": "type" },
					{ "t": "    sgl::Application app;", "c": "plain" },
					{ "t": "    sgl::Screen screen = sgl::Screen::fromFile(\"screens/board.screen.json\");", "c": "plain" },
					{ "t": "    screen.createWindow(app);", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "    Board board(screen);", "c": "plain" },
					{ "t": "    screen.onAction(\"archive\", [&](sgl::Panel&) { board.archiveDone(); });", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "    // Let an AI agent change the running app; its changes wait for review", "c": "comment" },
					{ "t": "    screen.listen(app, \"/tmp/board/agent.sock\", \"agent\");", "c": "string" },
					{ "t": "    return app.run();", "c": "keyword" },
					{ "t": "}", "c": "type" }
				]
			},
			{
				"name": "Board.hpp",
				"path": "src / Board.hpp",
				"language": "C++",
				"lines": [
					{ "t": "#pragma once", "c": "keyword" },
					{ "t": "", "c": "plain" },
					{ "t": "#include <sgl/Screen.hpp>", "c": "keyword" },
					{ "t": "", "c": "plain" },
					{ "t": "/// @brief Native logic behind the board screen.", "c": "comment" },
					{ "t": "class Board {", "c": "type" },
					{ "t": "public:", "c": "keyword" },
					{ "t": "    explicit Board(sgl::Screen& screen);", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "    /// @brief Moves every card in Done to the archive.", "c": "comment" },
					{ "t": "    void archiveDone();", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "private:", "c": "keyword" },
					{ "t": "    sgl::Screen& screen_; ///< The board's live document.", "c": "plain" },
					{ "t": "};", "c": "type" }
				]
			},
			{
				"name": "Board.cpp",
				"path": "src / Board.cpp",
				"language": "C++",
				"lines": [
					{ "t": "#include \"Board.hpp\"", "c": "keyword" },
					{ "t": "", "c": "plain" },
					{ "t": "Board::Board(sgl::Screen& screen) : screen_(screen) {}", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "void Board::archiveDone() {", "c": "type" },
					{ "t": "    // The app's own change: no review, but locks still apply", "c": "comment" },
					{ "t": "    screen_.applyRevision(R\"({\"message\": \"Archive done cards\",", "c": "string" },
					{ "t": "        \"patch\": [{\"op\": \"replace\", \"path\": \"/state/columns/3/cards\", \"value\": []}]})\");", "c": "string" },
					{ "t": "}", "c": "type" }
				]
			},
			{
				"name": "board.screen.json",
				"path": "screens / board.screen.json",
				"language": "JSON",
				"lines": [
					{ "t": "{", "c": "plain" },
					{ "t": "    \"format\": \"sglgui-screen\",", "c": "string" },
					{ "t": "    \"version\": 1,", "c": "plain" },
					{ "t": "    \"permissions\": { \"authors\": { \"agent\": \"review\" } },", "c": "string" },
					{ "t": "    \"state\": { \"columns\": [ ... ] },", "c": "plain" },
					{ "t": "    \"root\": { \"children\": [ ... ] }", "c": "plain" },
					{ "t": "}", "c": "plain" }
				]
			},
			{
				"name": "CMakeLists.txt",
				"path": "CMakeLists.txt",
				"language": "CMake",
				"lines": [
					{ "t": "cmake_minimum_required(VERSION 3.25)", "c": "keyword" },
					{ "t": "project(board-app CXX)", "c": "keyword" },
					{ "t": "", "c": "plain" },
					{ "t": "add_subdirectory(external/sGLGUI)", "c": "plain" },
					{ "t": "add_executable(board src/main.cpp src/Board.cpp)", "c": "plain" },
					{ "t": "target_link_libraries(board PRIVATE sglgui::sglgui)", "c": "plain" }
				]
			},
			{
				"name": "README.md",
				"path": "README.md",
				"language": "Markdown",
				"lines": [
					{ "t": "# board-app", "c": "heading" },
					{ "t": "", "c": "plain" },
					{ "t": "A native task board built on sGLGUI.", "c": "plain" },
					{ "t": "", "c": "plain" },
					{ "t": "## Build", "c": "heading" },
					{ "t": "    cmake -S . -B build && cmake --build build", "c": "string" }
				]
			}
		],
		"terminal": [
			{ "t": "$ cmake --build build", "c": "prompt" },
			{ "t": "[ 50%] Building CXX object src/Board.cpp.o", "c": "plain" },
			{ "t": "[100%] Linking CXX executable board", "c": "plain" },
			{ "t": "Build finished: 0 warnings", "c": "comment" }
		]
	},

	"styles": {
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true }
	},

	"actions": {
		"open": [
			{ "set": "state.found", "to": false },
			{ "forEach": "state.tabs", "as": "tab", "do": [{ "if": { "$equals": ["{{tab}}", "{{state.openFile}}"] }, "then": [{ "set": "state.found", "to": true }] }] },
			{ "if": { "$not": "{{state.found}}" }, "then": [{ "push": "state.tabs", "value": "{{state.openFile}}" }] },
			{ "set": "state.active", "to": "{{state.openFile}}" }
		],
		"runCommand": [
			{ "if": { "$empty": "{{state.command}}" }, "then": [{ "stop": true }] },
			{ "push": "state.terminal", "value": { "t": "$ {{state.command}}", "c": "prompt" } },
			{
				"if": { "$equals": ["{{state.command}}", "clear"] },
				"then": [{ "set": "state.terminal", "to": [] }],
				"else": [
					{
						"if": { "$equals": ["{{state.command}}", "help"] },
						"then": [{ "push": "state.terminal", "value": { "t": "commands: build, run, help, clear", "c": "plain" } }],
						"else": [
							{
								"if": { "$equals": ["{{state.command}}", "build"] },
								"then": [{ "push": "state.terminal", "value": { "t": "[100%] Built target board: 0 warnings", "c": "comment" } }],
								"else": [
									{
										"if": { "$equals": ["{{state.command}}", "run"] },
										"then": [{ "push": "state.terminal", "value": { "t": "board: listening on /tmp/board/agent.sock", "c": "plain" } }],
										"else": [{ "push": "state.terminal", "value": { "t": "{{state.command}}: command not found (try help)", "c": "string" } }]
									}
								]
							}
						]
					}
				]
			},
			{ "set": "state.command", "to": "" }
		]
	},

	"root": {
		"color": "@background",
		"children": [
			{
				"id": "activityBar",
				"anchors": { "left": 0, "top": 0, "bottom": 28 },
				"width": 48,
				"color": "@activity",
				"children": [
					{
						"repeat": { "for": "item", "in": ["Fi", "Se", "Gi", "Ru"] },
						"type": "label",
						"text": "{{item}}",
						"font": "small",
						"anchors": { "left": 8, "top": { "$add": [{ "$multiply": ["{{index}}", 44] }, 12] } },
						"width": 32,
						"height": 32,
						"align": "center",
						"color": { "$if": [{ "$equals": ["{{index}}", 0] }, "@selected", "@activity"] },
						"hover": { "color": "@hover" },
						"textColor": { "$if": [{ "$equals": ["{{index}}", 0] }, "@text", "@muted"] },
						"cursor": "hand"
					}
				]
			},
			{
				"id": "explorer",
				"anchors": { "left": 48, "top": 0, "bottom": 28 },
				"width": 232,
				"color": "@sidebar",
				"children": [
					{ "style": "caption", "text": "EXPLORER", "anchors": { "left": 20, "top": 14 } },
					{ "type": "label", "text": "{{state.project}}", "font": "small", "textColor": "@text", "anchors": { "left": 20, "top": 42 }, "fitText": true },
					{
						"id": "tree",
						"type": "stack",
						"anchors": { "left": 0, "right": 0, "top": 66, "bottom": 0 },
						"gap": 0,
						"children": [
							{
								"repeat": { "for": "entry", "in": "state.tree" },
								"type": "label",
								"text": "{{entry.label}}",
								"anchors": { "left": { "$add": [{ "$multiply": ["{{entry.depth}}", 16] }, 8] }, "right": 8 },
								"height": 26,
								"padding": 12,
								"align": { "horizontal": "start", "vertical": "center" },
								"color": { "$if": [{ "$equals": ["{{entry.file}}", "{{state.active}}"] }, "@selected", "@sidebar"] },
								"hover": { "color": { "$if": [{ "$equals": ["{{entry.file}}", "{{state.active}}"] }, "@selected", "@hover"] } },
								"textColor": { "$if": [{ "$less": ["{{entry.file}}", 0] }, "@muted", "@text"] },
								"cursor": "hand",
								"onClick": [{ "if": { "$greaterOrEqual": ["{{entry.file}}", 0] }, "then": [{ "set": "state.openFile", "to": "{{entry.file}}" }, { "run": "open" }] }]
							}
						]
					}
				]
			},
			{
				"id": "editorArea",
				"anchors": { "left": 280, "right": 0, "top": 0, "bottom": 28 },
				"color": "transparent",
				"children": [
					{
						"id": "tabs",
						"anchors": { "left": 0, "right": 0, "top": 0 },
						"height": 36,
						"color": "@tabs",
						"children": [
							{
								"repeat": { "for": "tab", "in": "state.tabs", "index": "i" },
								"type": "label",
								"text": "{{state.files[tab].name}}",
								"anchors": { "top": 0, "bottom": 0 },
								"x": { "$multiply": ["{{i}}", 168] },
								"width": 167,
								"padding": 14,
								"align": { "horizontal": "start", "vertical": "center" },
								"color": { "$if": [{ "$equals": ["{{tab}}", "{{state.active}}"] }, "@tabActive", "@tab"] },
								"hover": { "color": { "$if": [{ "$equals": ["{{tab}}", "{{state.active}}"] }, "@tabActive", "@hover"] } },
								"textColor": { "$if": [{ "$equals": ["{{tab}}", "{{state.active}}"] }, "@text", "@muted"] },
								"cursor": "hand",
								"onClick": [{ "set": "state.active", "to": "{{tab}}" }],
								"children": [
									{ "when": { "$equals": ["{{tab}}", "{{state.active}}"] }, "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 2, "color": "@accent" },
									{
										"type": "label",
										"text": "×",
										"anchors": { "right": 8, "top": 8 },
										"width": 20,
										"height": 20,
										"align": "center",
										"color": "transparent",
										"hover": { "color": "@selected" },
										"textColor": "@muted",
										"cursor": "hand",
										"onClick": [
											{
												"if": { "$equals": ["{{tab}}", "{{state.active}}"] },
												"then": [{ "remove": "state.tabs", "at": "{{i}}" }, { "set": "state.active", "to": "{{state.tabs[0]}}" }],
												"else": [{ "remove": "state.tabs", "at": "{{i}}" }]
											}
										]
									}
								]
							}
						]
					},
					{
						"id": "breadcrumbs",
						"when": "{{state.files[state.active]}}",
						"style": "caption",
						"text": "{{state.files[state.active].path}}",
						"anchors": { "left": 20, "top": 44 }
					},
					{
						"id": "editor",
						"when": "{{state.files[state.active]}}",
						"type": "stack",
						"anchors": { "left": 0, "right": 0, "top": 70, "bottom": 212 },
						"gap": 0,
						"children": [
							{
								"repeat": { "for": "line", "in": "state.files[state.active].lines" },
								"anchors": { "left": 0, "right": 0 },
								"height": 22,
								"color": "transparent",
								"children": [
									{
										"type": "label",
										"text": { "$add": ["{{index}}", 1] },
										"font": "code",
										"textColor": "@faint",
										"anchors": { "left": 0, "top": 0, "bottom": 0 },
										"width": 48,
										"align": { "horizontal": "end", "vertical": "center" }
									},
									{
										"type": "label",
										"text": "{{line.t}}",
										"font": "code",
										"textColor": "@{{line.c}}",
										"anchors": { "left": 72, "right": 16, "top": 0, "bottom": 0 },
										"align": { "horizontal": "start", "vertical": "center" }
									}
								]
							}
						]
					},
					{
						"id": "welcome",
						"when": { "$not": "{{state.files[state.active]}}" },
						"type": "label",
						"text": "No file open. Pick one in the explorer.",
						"textColor": "@muted",
						"anchors": { "left": 0, "right": 0, "top": 36, "bottom": 212 },
						"align": "center"
					},
					{
						"id": "terminal",
						"anchors": { "left": 0, "right": 0, "bottom": 0 },
						"height": 204,
						"color": "@panel",
						"children": [
							{ "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
							{ "type": "label", "text": "TERMINAL", "font": "small", "textColor": "@text", "anchors": { "left": 20, "top": 10 }, "fitText": true },
							{ "anchors": { "left": 20, "top": 28 }, "width": 58, "height": 1, "color": "@accent" },
							{
								"type": "stack",
								"anchors": { "left": 20, "right": 20, "top": 40, "bottom": 44 },
								"align": "end",
								"gap": 0,
								"children": [
									{
										"repeat": { "for": "out", "in": "state.terminal" },
										"type": "label",
										"text": "{{out.t}}",
										"font": "code",
										"textColor": "@{{out.c}}",
										"anchors": { "left": 0, "right": 0 },
										"height": 20,
										"align": { "horizontal": "start", "vertical": "center" }
									}
								]
							},
							{
								"id": "command",
								"type": "textarea",
								"font": "code",
								"anchors": { "left": 20, "right": 20, "bottom": 10 },
								"height": 28,
								"padding": 8,
								"color": "@input",
								"focused": { "color": "@hover" },
								"textColor": "@text",
								"placeholder": "$ type a command (try help) and press Enter",
								"placeholderColor": "@faint",
								"bind": "state.command",
								"onSubmit": "runCommand"
							}
						]
					}
				]
			},
			{
				"id": "statusBar",
				"anchors": { "left": 0, "right": 0, "bottom": 0 },
				"height": 28,
				"color": "@status",
				"children": [
					{
						"type": "label",
						"text": "main  ·  Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@statusText",
						"anchors": { "left": 16, "top": 0, "bottom": 0, "right": 300 },
						"align": { "horizontal": "start", "vertical": "center" }
					},
					{
						"type": "label",
						"text": "{{state.files[state.active].language}}  ·  UTF-8  ·  {{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@statusText",
						"anchors": { "right": 16, "top": 0, "bottom": 0 },
						"width": 280,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			}
		]
	}
}
