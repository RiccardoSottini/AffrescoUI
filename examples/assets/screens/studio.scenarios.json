{
	"format": "affrescoui-scenarios",
	"version": 1,
	"screen": "studio.screen.json",
	"scenarios": [
		{
			"name": "studio-starts-disconnected",
			"note": "Before a host answers, the header offers Reconnect and the queue is empty",
			"steps": [
				{ "expect": { "node": "#status", "text": "Not connected: start affrescoui_host (retrying every 2 s)" } },
				{ "expect": { "node": "#label-reconnect", "exists": true } },
				{ "expect": { "node": "#label-main-revision-revision", "exists": false } },
				{ "expect": { "node": "#label-nothing-to-review", "exists": true } },
				{ "expect": { "node": "#logEmpty", "exists": true } }
			]
		},
		{
			"name": "connecting-shows-the-queue",
			"note": "The hello and the document fill the header, the tabs and the first proposal",
			"steps": [
				{ "action": "host:hello", "event": { "revision": 4, "head": { "short": "a1b2c3d" }, "you": "riccardo", "canReview": true, "mode": "default" } },
				{ "action": "host:document", "event": { "revision": 4, "head": { "short": "a1b2c3d" }, "document": {}, "state": {}, "proposals": [{ "id": 3, "branch": "proposal/3", "author": "claude", "message": "Add a Blocked column", "base": "a1b2c3d", "head": "e4f5a6b", "short": "e4f5a6b", "commits": 1, "operations": 3, "touches": ["/root/children/1"], "remember": ["add columns"], "changes": ["add #column-blocked", "set #column-blocked/title \"Blocked\"", "set #boardName/text \"Q4\""], "reason": "asks", "time": 1760000000 }, { "id": 4, "branch": "proposal/4", "author": "claude", "message": "Switch to a dark theme", "base": "a1b2c3d", "head": "c7d8e9f", "short": "c7d8e9f", "commits": 2, "operations": 1, "touches": ["/theme"], "remember": [], "changes": ["set /theme \"dark\""], "reason": "asks", "time": 1760000100 }], "previewing": null, "mode": "default", "grants": [{ "rule": "edit text", "grantedBy": "riccardo", "proposal": 2, "time": 1759990000 }], "you": "riccardo", "canReview": true } },
				{ "action": "host:history", "event": { "revision": 4, "entries": [{ "id": "0f0f0f00f0f0f00f0f0f00f0f0f00f0f0f0", "short": "0f0f0f0", "number": 0, "parents": [], "author": "host", "committer": "host", "message": "The Kanban template", "time": 1759990000, "proposal": null }, { "id": "1a1a1a11a1a1a11a1a1a11a1a1a11a1a1a1", "short": "1a1a1a1", "number": 1, "parents": [], "author": "riccardo", "committer": "riccardo", "message": "Rename the board to Q4", "time": 1759990001, "proposal": null }, { "id": "2b2b2b22b2b2b22b2b2b22b2b2b22b2b2b2", "short": "2b2b2b2", "number": 2, "parents": [], "author": "claude", "committer": "riccardo", "message": "Shorter card titles", "time": 1759990002, "proposal": null }, { "id": "3c3c3c33c3c3c33c3c3c33c3c3c33c3c3c3", "short": "3c3c3c3", "number": 3, "parents": [], "author": "claude", "committer": "riccardo", "message": "Add due dates", "time": 1759990003, "proposal": null }, { "id": "a1b2c3da1b2c3da1b2c3da1b2c3da1b2c3d", "short": "a1b2c3d", "number": 4, "parents": [], "author": "riccardo", "committer": "riccardo", "message": "Direct change from the Studio", "time": 1759990004, "proposal": null }] } },
				{ "expect": { "state": "connected", "is": true } },
				{ "expect": { "node": "#status", "text": "Connected as 'riccardo'" } },
				{ "expect": { "node": "#label-main-revision-revision", "text": "main  ·  revision 4  ·  a1b2c3d" } },
				{ "expect": { "node": "#label-p-message", "text": "Add a Blocked column" } },
