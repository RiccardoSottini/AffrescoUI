{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,

	"note": "Streak: a habit tracker. Tick habits, click heatmap days to change them; habits and the heatmap are kept on disk (persist).",

	"window": {
		"title": "Streak: an AffrescoUI template",
		"width": 1280,
		"height": 800,
		"minWidth": 1040,
		"minHeight": 640
	},

	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 15 },
		"small": { "file": "../fonts/Roboto-Regular.ttf", "size": 12 },
		"heading": { "file": "../fonts/Roboto-Regular.ttf", "size": 17 },
		"title": { "file": "../fonts/Roboto-Regular.ttf", "size": 26 },
		"figure": { "file": "../fonts/Roboto-Regular.ttf", "size": 34 }
	},

	"colors": {
		"background": "#f6f5f2",
		"surface": "#ffffff",
		"text": "#1c1917",
		"muted": "#78716c",
		"border": "#e7e5e4",
		"rowHover": "#fafaf9",
		"input": "#f5f5f4",
		"inputFocused": "#ecfdf5",
		"accent": "#16a34a",
		"accentSoft": "#dcfce7",
		"track": "#f0efed"
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent(/actions)"],
		"deny": ["*(#statusBar)"],
		"reviewers": ["studio"]
	},

	"state": {
		"today": "Thursday, 15 October",
		"newHabit": "",
		"palette": ["#e2ece6", "#a7f3c0", "#4ade80", "#16a34a", "#14532d"],
		"habitColors": ["#16a34a", "#2563eb", "#d97706", "#db2777", "#7c3aed", "#0891b2"],
		"habits": [
			{ "name": "Read 20 pages", "done": true, "streak": 12, "week": 86, "color": "#16a34a" },
			{ "name": "Run or walk 5 km", "done": true, "streak": 5, "week": 71, "color": "#2563eb" },
			{ "name": "Practise C++ for an hour", "done": false, "streak": 31, "week": 100, "color": "#d97706" },
			{ "name": "No phone after 22:00", "done": false, "streak": 3, "week": 43, "color": "#db2777" },
			{ "name": "Ten minutes of stretching", "done": false, "streak": 0, "week": 29, "color": "#7c3aed" }
		],
		"days": ["Mon", "", "Wed", "", "Fri", "", "Sun"],
		"weeks": [
			[2, 2, 2, 1, 1, 1, 2],
			[2, 3, 2, 2, 2, 0, 2],
			[3, 3, 0, 0, 1, 0, 1],
			[2, 3, 1, 2, 3, 0, 3],
			[3, 3, 1, 1, 2, 1, 2],
			[3, 2, 1, 2, 4, 0, 2],
			[3, 1, 2, 4, 0, 1, 1],
			[2, 3, 2, 1, 3, 2, 2],
			[4, 3, 3, 1, 3, 1, 1],
			[1, 2, 2, 4, 0, 0, 2],
			[4, 3, 1, 0, 3, 1, 0],
			[4, 4, 3, 3, 3, 4, 2],
			[3, 3, 1, 4, 4, 2, 0],
			[2, 4, 1, 3, 4, 1, 4],
			[4, 3, 3, 4, 3, 3, 1],
			[3, 4, 3, 2, 4, 4, 2],
			[2, 3, 3, 3, 4, 1, 4],
			[2, 2, 4, 4, 4, 3, 2],
			[4, 4, 3, 4, 4, 2, 3],
			[4, 4, 4, 2, 0, 0, 0]
		]
	},

	"stateTypes": {
		"today": {"type": "string"},
		"newHabit": {"type": "string"},
		"palette": {"type": "array", "items": {"type": "string"}},
		"habitColors": {"type": "array", "items": {"type": "string"}},
		"habits": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "done": {"type": "boolean"}, "streak": {"type": "number"}, "week": {"type": "number"}, "color": {"type": "string"}}}},
		"days": {"type": "array", "items": {"type": "string"}},
		"weeks": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
	},

	"persist": ["state.habits", "state.weeks"],

	"computed": {
		"doneToday": "{{count(state.habits, it.done)}}",
		"bestStreak": "{{max(map(state.habits, it.streak))}}",
		"checkIns": "{{sum(state.weeks, sum(it))}}"
	},

	"watch": { "computed.doneToday": { "set": "state.weeks[19][3]", "to": "{{min(event.value, 4)}}" } },

	"styles": {
		"card": { "color": "@surface" },
		"cardTitle": {
			"type": "label",
			"font": "heading",
			"textColor": "@text",
			"anchors": { "left": 24, "top": 20 },
			"fitText": true
		},
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"legend": { "anchors": { "top": 1 }, "width": 14, "height": 14 }
	},

	"actions": {
		"check": [
			{ "note": "with: h (a habit's index): ticks or unticks it and moves its streak" },
			{ "toggle": "state.habits[h].done" },
			{
				"set": "state.habits[h].streak",
				"to": "{{state.habits[h].done ? state.habits[h].streak + 1 : max(state.habits[h].streak - 1, 0)}}"
			}
		],
		"addHabit": [
			{ "if": "{{len(trim(state.newHabit)) == 0}}", "then": [{ "stop": true }] },
			{
				"push": "state.habits",
				"value": {
					"name": "{{trim(state.newHabit)}}",
					"done": false,
					"streak": 0,
					"week": 0,
					"color": "{{state.habitColors[len(state.habits) % len(state.habitColors)]}}"
				}
			},
			{ "set": "state.newHabit", "to": "" }
		]
	},

	"keys": { "mod+n": { "focus": "#newHabit" } },

	"root": {
		"id": "panel-root",
		"color": "@background",
		"children": [
			{
				"type": "label",
				"text": "Streak",
				"font": "title",
				"textColor": "@text",
				"anchors": { "left": 32, "top": 28 },
				"fitText": true,
				"id": "logo"
			},
			{ "id": "label-an-affresco-ui", "style": "caption", "text": "an AffrescoUI template", "anchors": { "left": 34, "top": 64 } },
			{
				"type": "label",
				"text": "{{state.today}}",
				"font": "heading",
				"textColor": "@muted",
				"anchors": { "right": 32, "top": 34 },
				"fitText": true,
				"id": "date"
			},
			{
				"id": "today",
				"anchors": { "left": 24, "top": 100, "bottom": 56 },
				"width": 400,
				"style": "card",
				"children": [
					{ "id": "label-today", "style": "cardTitle", "text": "Today" },
					{
						"style": "caption",
						"text": "{{computed.doneToday}} of {{len(state.habits)}} done",
						"anchors": { "right": 24, "top": 24 },
						"id": "doneCount"
					},
					{
						"anchors": { "left": 24, "right": 24, "top": 56 },
						"height": 6,
						"color": "@track",
						"children": [
							{
								"id": "panel-progress",
								"anchors": { "left": 0, "top": 0, "bottom": 0 },
								"width": "{{round(computed.doneToday * 100 / max(len(state.habits), 1))}}%",
								"color": "@accent"
							}
						],
						"id": "progress"
					},
					{
						"id": "habits",
						"type": "stack",
						"anchors": { "left": 12, "right": 12, "top": 80, "bottom": 72 },
						"gap": 4,
						"children": [
							{
								"id": "habit",
								"repeat": { "for": "habit", "in": "state.habits", "index": "h" },
								"anchors": { "left": 0, "right": 0 },
								"height": 64,
								"color": "@surface",
								"hover": { "color": "@rowHover" },
								"cursor": "hand",
								"onClick": { "run": "check", "with": { "h": "{{h}}" } },
								"children": [
									{
										"id": "panel-habit",
										"anchors": { "left": 0, "top": 12, "bottom": 12 },
										"width": 3,
										"color": "{{habit.color}}"
									},
									{
										"id": "checkbox-habit",
										"type": "checkbox",
										"anchors": { "left": 16, "top": 21 },
										"width": 22,
										"height": 22,
										"checked": "{{habit.done}}",
										"activeColor": "{{habit.color}}",
										"trackColor": "@border",
										"knobColor": "@surface",
										"onChange": { "run": "check", "with": { "h": "{{h}}" } }
									},
									{
										"id": "label-habit-name",
										"type": "label",
										"text": "{{habit.name}}",
										"textColor": "{{habit.done ? '@muted' : '@text'}}",
										"anchors": { "left": 54, "top": 13 },
										"fitText": true
									},
									{
										"id": "label-habit-streak-0",
										"style": "caption",
										"text": "{{habit.streak > 0 ? habit.streak + ' day streak' : 'Start today'}}",
										"anchors": { "left": 54, "top": 36 }
									},
									{
										"id": "label-habit-week",
										"type": "label",
										"text": "{{habit.week}}%",
										"font": "small",
										"textColor": "{{habit.color}}",
										"anchors": { "right": 14, "top": 0, "bottom": 0 },
										"width": 48,
										"align": { "horizontal": "end", "vertical": "center" }
									}
								]
							}
						],
						"scroll": "vertical"
					},
					{
						"id": "newHabit",
						"type": "textarea",
						"anchors": { "left": 24, "right": 24, "bottom": 20 },
						"height": 38,
						"padding": 12,
						"color": "@input",
						"focused": { "color": "@inputFocused" },
						"textColor": "@text",
						"placeholder": "Add a habit and press Enter",
						"placeholderColor": "@muted",
						"bind": "state.newHabit",
						"onSubmit": "addHabit"
					}
				]
			},
			{
				"id": "stats",
				"anchors": { "left": 440, "right": 24, "top": 100 },
				"height": 112,
				"children": [
					{
						"id": "panel-stat",
						"repeat": {
							"for": "stat",
							"in": [
								{ "label": "Current streak", "value": "{{plural(state.habits[0].streak, 'day')}}" },
								{ "label": "Best streak", "value": "{{plural(computed.bestStreak, 'day')}}" },
								{
									"label": "Completed today",
									"value": "{{computed.doneToday}} / {{len(state.habits)}}"
								},
								{ "label": "Check-ins", "value": "{{computed.checkIns}}" }
							]
						},
						"anchors": { "top": 0, "bottom": 0 },
						"color": "transparent",
						"children": [
							{
								"id": "panel-card",
								"anchors": { "left": 0, "right": 16, "top": 0, "bottom": 0 },
								"style": "card",
								"children": [
									{
										"id": "label-stat-label",
										"style": "caption",
										"text": "{{stat.label}}",
										"anchors": { "left": 20, "top": 20 }
									},
									{
										"id": "label-stat-value",
										"type": "label",
										"text": "{{stat.value}}",
										"font": "figure",
										"textColor": "@text",
										"anchors": { "left": 20, "top": 44 },
										"fitText": true
									}
								]
							}
						],
						"grow": 1
					}
				],
				"type": "row"
			},
			{
				"id": "grid",
				"anchors": { "left": 440, "right": 40, "top": 228 },
				"height": 252,
				"style": "card",
				"children": [
					{ "id": "label-last-20-weeks", "style": "cardTitle", "text": "Last 20 weeks" },
					{ "id": "label-click-a-day", "style": "caption", "text": "Click a day to change it", "anchors": { "right": 24, "top": 24 } },
					{
						"anchors": { "left": 24, "top": 62 },
						"width": 40,
						"height": 160,
						"color": "transparent",
						"children": [
							{
								"id": "label-day",
								"repeat": { "for": "day", "in": "state.days" },
								"style": "caption",
								"text": "{{day}}",
								"anchors": { "left": 0 },
								"y": "{{index * 22 + 2}}"
							}
						],
						"id": "days"
					},
					{
						"anchors": { "left": 72, "top": 62 },
						"width": 440,
						"height": 154,
						"children": [
							{
								"id": "column-week",
								"repeat": { "for": "week", "in": "state.weeks", "index": "w" },
								"anchors": { "top": 0, "bottom": 0 },
								"width": 18,
								"children": [
									{
										"id": "panel-level",
										"repeat": { "for": "level", "in": "week", "index": "d" },
										"anchors": { "left": 0, "right": 0 },
										"height": 18,
										"color": "{{state.palette[level]}}",
										"cursor": "hand",
										"onClick": { "set": "state.weeks[w][d]", "to": "{{(level + 1) % 5}}" },
										"tooltip": "{{state.days[d] ? state.days[d] + ': ' : ''}}{{plural(level, 'habit')}}"
									}
								],
								"type": "column",
								"gap": 4
							}
						],
						"id": "heatmap",
						"type": "row",
						"gap": 4
					},
					{
						"anchors": { "right": 24, "bottom": 18 },
						"width": 200,
						"height": 16,
						"color": "transparent",
						"children": [
							{ "id": "label-less", "style": "caption", "text": "Less", "anchors": { "left": 0, "top": 0 } },
							{
								"id": "row-legend",
								"type": "row",
								"gap": 6,
								"anchors": { "left": 40, "top": 0 },
								"width": 100,
								"height": 16,
								"children": [
									{
										"id": "panel-shade",
										"repeat": { "for": "shade", "in": "state.palette" },
										"style": "legend",
										"color": "{{shade}}"
									}
								]
							},
							{ "id": "label-more", "style": "caption", "text": "More", "anchors": { "left": 146, "top": 0 } }
						],
						"id": "legend"
					}
				]
			},
			{
				"id": "weekly",
				"anchors": { "left": 440, "right": 40, "top": 496, "bottom": 56 },
				"style": "card",
				"children": [
					{ "id": "label-this-week", "style": "cardTitle", "text": "This week" },
					{
						"type": "stack",
						"anchors": { "left": 24, "right": 24, "top": 60, "bottom": 16 },
						"gap": 14,
						"children": [
							{
								"id": "panel-habit-2",
								"repeat": { "for": "habit", "in": "state.habits" },
								"anchors": { "left": 0, "right": 0 },
								"height": 18,
								"color": "transparent",
								"children": [
									{
										"id": "label-habit-name-2",
										"type": "label",
										"text": "{{habit.name}}",
										"font": "small",
										"textColor": "@text",
										"anchors": { "left": 0, "top": 0, "bottom": 0 },
										"width": 200,
										"align": { "horizontal": "start", "vertical": "center" }
									},
									{
										"id": "panel-habit-3",
										"anchors": { "left": 210, "right": 56, "top": 6 },
										"height": 6,
										"color": "@track",
										"children": [
											{
												"id": "panel-habit-4",
												"anchors": { "left": 0, "top": 0, "bottom": 0 },
												"width": "{{habit.week}}%",
												"color": "{{habit.color}}"
											}
										]
									},
									{
										"id": "label-habit-week-2",
										"type": "label",
										"text": "{{habit.week}}%",
										"font": "small",
										"textColor": "@muted",
										"anchors": { "right": 0, "top": 0, "bottom": 0 },
										"width": 48,
										"align": { "horizontal": "end", "vertical": "center" }
									}
								]
							}
						],
						"id": "weeklyBars"
					}
				]
			},
			{
				"id": "statusBar",
				"anchors": { "left": 0, "right": 0, "bottom": 0 },
				"height": 32,
				"color": "@surface",
				"children": [
					{ "id": "panel-status-bar", "anchors": { "left": 0, "right": 0, "top": 0 }, "height": 1, "color": "@border" },
					{
						"type": "label",
						"text": "Revision {{revision.number}}  ·  {{revision.author}}: {{revision.message}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "left": 32, "top": 0, "bottom": 0, "right": 200 },
						"align": { "horizontal": "start", "vertical": "center" },
						"id": "statusText"
					},
					{
						"type": "label",
						"text": "{{window.width}} × {{window.height}}",
						"font": "small",
						"textColor": "@muted",
						"anchors": { "right": 32, "top": 0, "bottom": 0 },
						"width": 160,
						"align": { "horizontal": "end", "vertical": "center" },
						"id": "statusSize"
					}
				]
			}
		]
	}
}
