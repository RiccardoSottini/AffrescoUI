														"anchors": {
															"left": 128,
															"bottom": 16
														},
														"width": 80,
														"onClick": {
															"run": "accept",
															"with": {
																"always": false
															}
														}
													},
													{
														"id": "label-always-allow",
														"when": "{{!empty(computed.current.remember)}}",
														"style": "goodButton",
														"text": "Always allow",
														"anchors": {
															"left": 216,
															"bottom": 16
														},
														"width": 100,
														"onClick": {
															"run": "accept",
															"with": {
																"always": true
															}
														},
														"tooltip": "Don't ask again for: {{join(computed.current.remember, ', ')}}"
													},
													{
														"id": "label-reject",
														"style": "badButton",
														"text": "Reject",
														"icon": "x",
														"anchors": {
															"right": 16,
															"bottom": 16
														},
														"width": 80,
														"onClick": "askReject"
													}
												]
											}
										]
									},
									{
										"id": "historyPage",
										"when": "{{state.tab == 'history'}}",
										"anchors": {
											"left": 0,
											"right": 0,
											"top": 52,
											"bottom": 0
										},
										"color": "transparent",
										"children": [
											{
												"id": "label-history",
												"style": "caption",
												"text": "{{plural(len(state.history), 'commit')}} on main, newest first",
												"anchors": {
													"left": 20,
													"top": 8
												}
											},
											{
												"id": "label-undo",
												"style": "smallButton",
												"text": "Undo",
												"icon": "undo-2",
												"anchors": {
													"right": 20,
													"top": 0
												},
												"width": 76,
												"onClick": [
													{
														"send": "host",
														"data": {
															"type": "undo"
														}
													}
												],
												"tooltip": "Cmd+Z"
											},
											{
												"id": "history",
												"type": "table",
												"anchors": {
													"left": 12,
													"right": 12,
													"top": 40,
													"bottom": 128
												},
												"color": "transparent",
												"rowHeight": 30,
												"items": "{{map(reverse(state.history), {id: text(it.number), cells: [it.number, it.short, it.author, it.message, it.committer != it.author ? it.committer : '']})}}",
												"value": "{{computed.entry != null ? text(computed.entry.number) : ''}}",
												"columns": [
													{
														"id": "number",
														"title": "#",
														"width": 36
													},
													{
														"id": "short",
														"title": "Commit",
														"width": 72
													},
													{
														"id": "author",
														"title": "Author",
														"width": 80
													},
													{
														"id": "message",
														"title": "Message",
														"width": 180
													},
													{
														"id": "approved",
														"title": "Approved by",
														"width": 96
													}
												],
												"textColor": "@color.text",
												"selectedTextColor": "@color.text",
												"selectedBackground": "@color.accentSoft",
												"accentColor": "@color.accent",
												"onChange": {
													"set": "state.historyPick",
													"to": "{{number(event.value)}}"
												}
											},
											{
												"id": "entry",
												"when": "{{computed.entry != null}}",
												"anchors": {
													"left": 20,
													"right": 20,
													"bottom": 20
												},
												"height": 96,
												"color": "@color.cardRaised",
												"radius": "@radius.card",
												"borderWidth": 1,
												"borderColor": "@color.border",
												"children": [
													{
														"id": "label-entry-number-entry",
														"style": "caption",
														"text": "{{computed.entry.number}}  ·  {{computed.entry.short}}{{computed.entry.committer != computed.entry.author ? '  ·  approved by ' + computed.entry.committer : ''}}{{computed.entry.number == state.revision ? '  ·  current' : ''}}",
														"anchors": {
															"left": 16,
															"top": 12
														}
													},
													{
														"id": "label-entry-author-entry",
														"type": "label",
														"text": "{{computed.entry.author}}: {{computed.entry.message}}",
														"textColor": "@color.text",
														"anchors": {
															"left": 16,
															"right": 16,
															"top": 32
														},
														"height": 18
													},
													{
														"id": "label-revert",
														"when": "{{computed.entry.number > 0}}",
														"style": "smallButton",
														"text": "Revert",
														"anchors": {
															"left": 16,
															"bottom": 14
														},
														"width": 72,
														"tooltip": "A new commit that undoes this one",
														"onClick": {
															"run": "askHistory",
															"with": {
																"kind": "revert"
															}
														}
													},
													{
														"id": "label-restore",
														"when": "{{computed.entry.number != state.revision}}",
														"style": "smallButton",
														"text": "Restore",
														"anchors": {
															"left": 96,
															"bottom": 14
														},
														"width": 72,
														"tooltip": "A new commit that brings the app back to this one",
														"onClick": {
															"run": "askHistory",
															"with": {
																"kind": "restore"
															}
														}
													}
												]
											}
										]
									},
									{
										"id": "rulesPage",
										"when": "{{state.tab == 'rules'}}",
										"anchors": {
											"left": 0,
											"right": 0,
											"top": 52,
											"bottom": 0
										},
										"color": "transparent",
										"children": [
											{
												"id": "label-mode",
												"type": "label",
												"font": "heading",
												"text": "Approval mode",
												"textColor": "@color.text",
												"anchors": {
													"left": 20,
													"top": 8
												},
												"fitText": true
											},
											{
												"id": "mode",
												"type": "row",
												"gap": 4,
												"anchors": {
													"left": 20,
													"top": 40
												},
												"width": 330,
												"height": 32,
												"children": [
													{
														"id": "label-m-label",
														"repeat": {
															"for": "m",
															"in": "state.modes"
														},
														"style": "smallButton",
														"height": 32,
														"text": "{{m.label}}",
														"width": "{{m.width}}",
														"color": "{{state.mode == m.mode ? '@color.accent' : '@color.neutral'}}",
														"textColor": "{{state.mode == m.mode ? '#ffffff' : '@color.text'}}",
														"onClick": {
															"send": "host",
															"data": {
																"type": "setMode",
																"mode": "{{m.mode}}"
															}
														}
													}
												]
											},
											{
												"id": "label-mode-help-mode",
												"style": "caption",
												"text": "{{state.modeHelp[state.mode]}}",
												"anchors": {
													"left": 20,
													"top": 84
												}
											},
											{
												"id": "label-grants",
												"type": "label",
												"font": "heading",
												"text": "Don't ask again",
												"textColor": "@color.text",
												"anchors": {
													"left": 20,
													"top": 128
												},
												"fitText": true
											},
											{
												"id": "label-grants-help",
												"style": "caption",
												"text": "{{len(state.grants) == 0 ? 'No rules yet: Always allow on a proposal adds one.' : 'Changes these rules match apply without asking.'}}",
												"anchors": {
													"left": 20,
													"top": 154
												}
											},
											{
												"id": "grants",
												"type": "stack",
												"gap": 6,
												"anchors": {
													"left": 20,
													"right": 20,
													"top": 182,
													"bottom": 20
												},
												"color": "transparent",
												"scroll": "vertical",
												"children": [
													{
														"id": "panel-g",
														"repeat": {
															"for": "g",
															"in": "state.grants"
														},
														"anchors": {
															"left": 0,
															"right": 0
														},
														"height": 52,
														"color": "@color.cardRaised",
														"radius": "@radius.chip",
														"borderWidth": 1,
														"borderColor": "@color.border",
														"children": [
															{
																"id": "label-don-t-ask",
																"type": "label",
																"text": "Don't ask again: {{g.rule}}",
																"textColor": "@color.logReview",
																"anchors": {
																	"left": 12,
																	"right": 92,
																	"top": 8
																},
																"height": 18
															},
															{
																"id": "label-granted-by",
																"style": "caption",
																"text": "Granted by {{g.grantedBy}}{{g.proposal != null ? ' on proposal #' + g.proposal : ''}}",
																"anchors": {
																	"left": 12,
																	"top": 28
																}
															},
															{
																"id": "label-revoke",
																"style": "smallButton",
																"text": "Revoke",
																"anchors": {
																	"right": 12,
																	"top": 12
																},
																"width": 68,
																"onClick": [
																	{
																		"send": "host",
																		"data": {
																			"type": "revoke",
																			"rule": "{{g.rule}}"
																		}
																	}
																]
															}
														]
													}
												]
											}
										]
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "rejectDialog",
				"use": "dialog",
				"with": {
					"open": "state.rejecting.open",
					"title": "Reject proposal #{{state.rejecting.id}}?",
					"message": "“{{state.rejecting.message}}” is dropped and the app stays as it is.",
					"width": 440,
					"height": 160,
					"highlight": "@color.bad",
					"buttons": [
						{
							"title": "Reject",
							"run": "reject"
						},
						{
							"title": "Cancel",
							"run": "closeReject"
						}
					],
					"color": "@color.card",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"backdrop": "@color.backdrop"
				}
			},
			{
				"id": "historyDialog",
				"use": "dialog",
				"with": {
					"open": "state.changing.open",
					"title": "{{state.changing.kind == 'revert' ? 'Revert' : 'Restore'}} revision {{state.changing.number}}?",
					"message": "{{state.changing.kind == 'revert' ? 'A new commit undoes “' + state.changing.message + '”.' : 'A new commit brings the app back to how it was at this revision.'}}",
					"width": 460,
					"height": 160,
					"highlight": "@color.accent",
					"buttons": [
						{
							"title": "{{state.changing.kind == 'revert' ? 'Revert' : 'Restore'}}",
							"run": "changeHistory"
						},
						{
							"title": "Cancel",
							"run": "closeHistory"
						}
					],
					"color": "@color.card",
					"textColor": "@color.text",
					"dimColor": "@color.muted",
					"backdrop": "@color.backdrop"
				}
			},
			{
				"id": "toast",
				"use": "toast",
				"with": {
					"open": "state.toast.open",
					"message": "{{state.toast.message}}",
					"color": "@color.cardRaised",
					"textColor": "@color.text",
					"accent": "@color.accent"
				}
			}
		]
	}
}
