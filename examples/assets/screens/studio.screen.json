{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 1,
	"note": "The AffrescoUI Studio: the person's client for a running host. Layout, behaviour and the connection are all in this file. Ask and direct changes on the left; on the right, tabs for the review queue (a list of proposals and the chosen one's details), the history of main, and the approval rules. Cmd+1, 2 and 3 switch the tabs, Cmd+J light and dark, Cmd+Z undoes.",
	"window": {
		"title": "AffrescoUI Studio",
		"width": 1100,
		"height": 760,
		"minWidth": 920,
		"minHeight": 640
	},
	"fonts": {
		"default": {
			"file": "../fonts/Roboto-Regular.ttf",
			"size": 14,
			"fallback": ["icons", "symbols"]
		},
		"small": {
			"file": "../fonts/Roboto-Regular.ttf",
			"size": 12,
			"fallback": ["iconsSmall", "symbols"]
		},
		"heading": {
			"file": "../fonts/Roboto-Regular.ttf",
			"size": 16,
			"fallback": ["icons"]
		},
		"title": {
			"file": "../fonts/Roboto-Regular.ttf",
			"size": 20,
			"fallback": ["iconsLarge"]
		},
		"icons": {
			"file": "../fonts/Lucide.ttf",
			"size": 16
		},
		"iconsSmall": {
			"file": "../fonts/Lucide.ttf",
			"size": 13
		},
		"iconsLarge": {
			"file": "../fonts/Lucide.ttf",
			"size": 24
		},
		"symbols": {
			"file": "../fonts/JetBrainsMono-Regular.ttf",
			"size": 12
		}
	},
	"theme": "{{state.theme}}",
	"tokens": {
		"radius.card": 10,
		"radius.chip": 6,
		"color.background": {
			"light": "#eef1f6",
			"dark": "#0b1020"
		},
		"color.card": {
			"light": "#ffffff",
			"dark": "#131a2e"
		},
		"color.cardRaised": {
			"light": "#f5f7fb",
			"dark": "#1b2440"
		},
		"color.border": {
			"light": "#dbe1ea",
			"dark": "#232d4b"
		},
		"color.text": {
			"light": "#0f172a",
			"dark": "#e2e8f0"
		},
		"color.muted": {
			"light": "#64748b",
			"dark": "#7c89a8"
		},
		"color.input": {
			"light": "#f5f7fb",
			"dark": "#0e1426"
		},
		"color.inputFocused": {
			"light": "#eef2ff",
			"dark": "#18213d"
		},
		"color.accent": {
			"light": "#4f46e5",
			"dark": "#6366f1"
		},
		"color.accentHover": {
			"light": "#6366f1",
			"dark": "#7c7ff5"
		},
		"color.accentPressed": {
			"light": "#4338ca",
			"dark": "#4f46e5"
		},
		"color.accentSoft": {
			"light": "#e0e7ff",
			"dark": "#272f5a"
		},
		"color.good": {
			"light": "#16a34a",
			"dark": "#22c55e"
		},
		"color.goodHover": {
			"light": "#22c55e",
			"dark": "#4ade80"
		},
		"color.goodText": {
			"light": "#ffffff",
			"dark": "#052e16"
		},
		"color.bad": {
			"light": "#dc2626",
			"dark": "#ef4444"
		},
		"color.badHover": {
			"light": "#ef4444",
			"dark": "#f87171"
		},
		"color.neutral": {
			"light": "#e5e9f0",
			"dark": "#2a3556"
		},
		"color.neutralHover": {
			"light": "#d5dbe5",
			"dark": "#35426b"
		},
		"color.hover": {
			"light": "#eef1f6",
			"dark": "#1b2440"
		},
		"color.backdrop": {
			"light": "#0f172a66",
			"dark": "#00000099"
		},
		"color.logYou": {
			"light": "#4338ca",
			"dark": "#a5b4fc"
		},
		"color.logAi": {
			"light": "#0f766e",
			"dark": "#5eead4"
		},
		"color.logCommit": {
			"light": "#334155",
			"dark": "#cbd5e1"
		},
		"color.logReview": {
			"light": "#b45309",
			"dark": "#fcd34d"
		},
		"color.logError": {
			"light": "#b91c1c",
			"dark": "#fca5a5"
		},
		"color.logSystem": {
			"light": "#64748b",
			"dark": "#7c89a8"
		}
	},
	"channels": {
		"host": {
			"socket": "studio.sock",
			"reconnect": {
				"after": 2000
			}
		}
	},
	"persist": ["state.theme", "state.sizes"],
	"state": {
		"theme": "dark",
		"tab": "review",
		"sizes": [560],
		"selected": null,
		"historyPick": null,
		"rejecting": {
			"open": false,
			"id": 0,
			"message": ""
		},
		"changing": {
			"open": false,
			"kind": "revert",
			"number": 0,
			"message": ""
		},
		"toast": {
			"open": false,
			"message": ""
		},
		"connected": false,
		"status": "Connecting to the host...",
		"canReview": false,
		"revision": 0,
		"head": "",
		"mode": "default",
		"grants": [],
		"proposals": [],
		"previewing": null,
		"history": [],
		"log": [],
		"draft": "",
		"patch": "",
		"modes": [
			{
				"mode": "default",
				"label": "Ask first",
				"width": 96
			},
			{
				"mode": "acceptEdits",
				"label": "Accept edits",
				"width": 112
			},
			{
				"mode": "plan",
				"label": "Plan",
				"width": 72
			}
		],
		"modeHelp": {
			"default": "Ask first: AI changes no rule allows wait here for you.",
			"acceptEdits": "Accept edits: AI changes apply right away, unless a rule always asks.",
			"plan": "Plan: the AI can only propose, even where it is allowed."
		},
		"logColors": {
			"you": "@color.logYou",
			"ai": "@color.logAi",
			"commit": "@color.logCommit",
			"review": "@color.logReview",
			"error": "@color.logError"
		}
	},
	"stateTypes": {
		"theme": {
			"enum": ["light", "dark"]
		},
		"tab": {
			"enum": ["review", "history", "rules"]
		},
		"sizes": {
			"type": "array"
		},
		"selected": {
			"type": ["number", "null"]
		},
		"historyPick": {
			"type": ["number", "null"]
		},
		"connected": {
			"type": "boolean"
		},
		"status": {
			"type": "string"
		},
		"canReview": {
			"type": "boolean"
		},
		"revision": {
			"type": "number"
		},
		"head": {
			"type": "string"
		},
		"mode": {
			"enum": ["default", "acceptEdits", "plan"]
		},
		"grants": {
			"type": "array"
		},
		"proposals": {
			"type": "array"
		},
		"previewing": {
			"type": ["number", "null"]
		},
		"history": {
			"type": "array"
		},
		"log": {
			"type": "array"
		},
		"draft": {
			"type": "string"
		},
		"patch": {
			"type": "string"
		},
		"modes": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"mode": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"width": {
						"type": "number"
					}
				}
			}
		},
		"modeHelp": {
			"type": "object",
			"properties": {
				"default": {
					"type": "string"
				},
				"acceptEdits": {
					"type": "string"
				},
				"plan": {
					"type": "string"
				}
			}
		},
		"logColors": {
			"type": "object",
			"properties": {
				"you": {
					"type": "string"
				},
				"ai": {
					"type": "string"
				},
				"commit": {
					"type": "string"
				},
				"review": {
					"type": "string"
				},
				"error": {
					"type": "string"
				}
			}
		}
	},
	"computed": {
		"current": "{{find(state.proposals, it.id == state.selected) ?? (len(state.proposals) > 0 ? state.proposals[0] : null)}}",
		"entry": "{{find(state.history, it.number == state.historyPick) ?? (len(state.history) > 0 ? state.history[len(state.history) - 1] : null)}}",
		"tabs": "{{[{id: 'review', label: len(state.proposals) > 0 ? 'Review (' + len(state.proposals) + ')' : 'Review', closable: false}, {id: 'history', label: 'History', closable: false}, {id: 'rules', label: len(state.grants) > 0 ? 'Rules (' + len(state.grants) + ')' : 'Rules', closable: false}]}}"
	},
	"styles": {
		"card": {
			"color": "@color.card",
			"radius": "@radius.card",
			"borderWidth": 1,
			"borderColor": "@color.border"
		},
		"cardTitle": {
			"type": "label",
			"font": "heading",
			"textColor": "@color.text",
			"anchors": {
				"left": 20,
				"top": 16
			},
			"fitText": true
		},
		"caption": {
			"type": "label",
			"font": "small",
			"textColor": "@color.muted",
			"fitText": true
		},
		"input": {
			"type": "textarea",
			"height": 40,
			"padding": 12,
			"radius": "@radius.chip",
			"borderWidth": 1,
			"borderColor": "@color.border",
			"color": "@color.input",
			"focused": {
				"color": "@color.inputFocused",
				"borderColor": "@color.accent"
			},
			"textColor": "@color.text",
			"placeholderColor": "@color.muted"
		},
		"button": {
			"type": "label",
			"align": "center",
			"radius": "@radius.chip",
			"color": "@color.accent",
			"hover": {
				"color": "@color.accentHover"
			},
			"pressed": {
				"color": "@color.accentPressed"
			},
			"textColor": "#ffffff",
			"cursor": "hand"
		},
		"smallButton": {
			"type": "label",
			"font": "small",
			"align": "center",
			"height": 28,
			"radius": "@radius.chip",
			"color": "@color.neutral",
			"hover": {
				"color": "@color.neutralHover"
			},
			"textColor": "@color.text",
			"cursor": "hand"
		},
		"goodButton": {
			"style": "smallButton",
			"color": "@color.good",
			"hover": {
				"color": "@color.goodHover"
			},
			"textColor": "@color.goodText"
		},
		"badButton": {
			"style": "smallButton",
			"color": "@color.bad",
			"hover": {
				"color": "@color.badHover"
			},
			"textColor": "#ffffff"
		},
		"iconButton": {
			"type": "label",
			"text": "",
			"width": 32,
			"height": 32,
			"radius": 8,
			"color": "transparent",
			"textColor": "@color.muted",
			"align": "center",
			"cursor": "hand",
			"hover": {
				"color": "@color.hover",
				"textColor": "@color.text"
			}
		},
		"empty": {
			"type": "label",
			"textColor": "@color.muted",
			"align": "center",
			"wrap": true
		}
	},
	"actions": {
		"ask": [
			{
				"if": "{{len(trim(state.draft)) == 0}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"send": "host",
				"data": {
					"type": "request",
					"id": "request-{{len(state.log)}}",
					"text": "{{state.draft}}"
				}
			},
			{
				"push": "state.log",
				"value": {
					"kind": "you",
					"text": "You: {{state.draft}}"
				}
			},
			{
				"set": "state.draft",
				"to": ""
			}
		],
		"applyPatch": [
			{
				"note": "A JSON Patch [...] or compact edits {\"set\": {...}}, as typed"
			},
			{
				"if": "{{len(trim(state.patch)) == 0}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"if": "{{type(parseJson(state.patch)) == 'list'}}",
				"then": [
					{
						"send": "host",
						"data": {
							"type": "revision",
							"message": "Direct change from the Studio",
							"patch": "{{parseJson(state.patch)}}"
						}
					}
				],
				"else": [
					{
						"if": "{{type(parseJson(state.patch)) == 'object'}}",
						"then": [
							{
								"send": "host",
								"data": "{{merge({ type: 'revision', message: 'Direct change from the Studio' }, parseJson(state.patch))}}"
							}
						],
						"else": [
							{
								"push": "state.log",
								"value": {
									"kind": "error",
									"text": "Not JSON: a patch [{\"op\": ...}] or edits {\"set\": {...}}"
								}
							},
							{
								"stop": true
							}
						]
					}
				]
			},
			{
				"set": "state.patch",
				"to": ""
			}
		],
		"refreshHistory": [
			{
				"send": "host",
				"data": {
					"type": "getHistory",
					"limit": 50
				}
			}
		],
		"notify": [
			{
				"note": "with: message. A toast in the corner for a few seconds"
			},
			{
				"set": "state.toast",
				"to": {
					"open": true,
					"message": "{{message}}"
				}
			},
			{
				"debounce": 4000,
				"do": [
					{
						"set": "state.toast.open",
						"to": false
					}
				]
			}
		],
		"toggleTheme": [
			{
				"set": "state.theme",
				"to": "{{state.theme == 'light' ? 'dark' : 'light'}}"
			}
		],
		"accept": [
			{
				"note": "with: always. Accepts the chosen proposal at the head that was reviewed"
			},
			{
				"if": "{{computed.current == null}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"if": "{{always}}",
				"then": [
					{
						"send": "host",
						"data": {
							"type": "accept",
							"proposal": "{{computed.current.id}}",
							"head": "{{computed.current.head}}",
							"dontAskAgain": true
						}
					}
				],
				"else": [
					{
						"send": "host",
						"data": {
							"type": "accept",
							"proposal": "{{computed.current.id}}",
							"head": "{{computed.current.head}}"
						}
					}
				]
			}
		],
		"togglePreview": [
			{
				"if": "{{computed.current == null}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"if": "{{computed.current.id == state.previewing}}",
				"then": [
					{
						"send": "host",
						"data": {
							"type": "endPreview"
						}
					}
				],
				"else": [
					{
						"send": "host",
						"data": {
							"type": "preview",
							"proposal": "{{computed.current.id}}"
						}
					}
				]
			}
		],
		"askReject": [
			{
				"if": "{{computed.current == null}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"set": "state.rejecting",
				"to": {
					"open": true,
					"id": "{{computed.current.id}}",
					"message": "{{computed.current.message}}"
				}
			}
		],
		"reject": [
			{
				"send": "host",
				"data": {
					"type": "reject",
					"proposal": "{{state.rejecting.id}}"
				}
			},
			{
				"set": "state.rejecting.open",
				"to": false
			}
		],
		"closeReject": [
			{
				"set": "state.rejecting.open",
				"to": false
			}
		],
		"askHistory": [
			{
				"note": "with: kind, revert or restore. Asks before changing main"
			},
			{
				"if": "{{computed.entry == null}}",
				"then": [
					{
						"stop": true
					}
				]
			},
			{
				"set": "state.changing",
				"to": {
					"open": true,
					"kind": "{{kind}}",
					"number": "{{computed.entry.number}}",
					"message": "{{computed.entry.message}}"
				}
			}
		],
		"changeHistory": [
			{
				"if": "{{state.changing.kind == 'revert'}}",
				"then": [
					{
						"send": "host",
						"data": {
							"type": "revert",
							"revision": "{{state.changing.number}}"
						}
					}
				],
				"else": [
					{
						"send": "host",
						"data": {
							"type": "restore",
							"revision": "{{state.changing.number}}"
						}
					}
				]
			},
			{
				"set": "state.changing.open",
				"to": false
			}
		],
		"closeHistory": [
			{
				"set": "state.changing.open",
				"to": false
			}
		],
		"host:hello": [
			{
				"set": "state.connected",
				"to": true
			},
			{
				"set": "state.canReview",
				"to": "{{event.canReview}}"
			},
			{
				"set": "state.revision",
				"to": "{{event.revision}}"
			},
			{
				"set": "state.head",
				"to": "{{event.head.short}}"
			},
			{
				"set": "state.status",
				"to": "Connected as '{{event.you}}'"
			},
			{
				"push": "state.log",
				"value": {
					"kind": "system",
					"text": "Connected to the host, at revision {{event.revision}} ({{event.head.short}})"
				}
			},
			{
				"send": "host",
				"data": {
					"type": "getDocument"
				}
			},
			{
				"run": "refreshHistory"
			}
		],
		"host:document": [
			{
				"set": "state.proposals",
				"to": "{{event.proposals}}"
			},
			{
				"set": "state.previewing",
				"to": "{{event.previewing}}"
			},
			{
				"set": "state.mode",
				"to": "{{event.mode}}"
			},
			{
				"set": "state.grants",
				"to": "{{event.grants}}"
			},
			{
				"set": "state.revision",
				"to": "{{event.revision}}"
			},
			{
				"set": "state.head",
				"to": "{{event.head.short}}"
			}
		],
		"host:review": [
			{
				"if": "{{len(event.proposals) > len(state.proposals)}}",
				"then": [
					{
						"run": "notify",
						"with": {
							"message": "New proposal #{{event.proposals[len(event.proposals) - 1].id}} from {{event.proposals[len(event.proposals) - 1].author}}"
						}
					}
				]
			},
			{
				"set": "state.proposals",
				"to": "{{event.proposals}}"
			},
			{
				"set": "state.previewing",
				"to": "{{event.previewing}}"
			},
			{
				"set": "state.mode",
				"to": "{{event.mode}}"
			},
			{
				"set": "state.grants",
				"to": "{{event.grants}}"
			}
		],
		"host:history": [
			{
				"set": "state.history",
				"to": "{{event.entries}}"
			}
		],
		"host:committed": [
			{
				"set": "state.revision",
				"to": "{{event.revision}}"
			},
			{
				"set": "state.head",
				"to": "{{event.short}}"
			},
			{
				"push": "state.log",
				"value": {
					"kind": "commit",
					"text": "Revision {{event.revision}} ({{event.short}}) by {{event.author}}: {{event.message}}"
				}
			},
			{
				"run": "refreshHistory"
			}
		],
		"host:applied": [
			{
				"if": "{{event.proposal != null}}",
				"then": [
					{
						"push": "state.log",
						"value": {
							"kind": "review",
							"text": "Proposal #{{event.proposal}} merged"
						}
					},
					{
						"run": "notify",
						"with": {
							"message": "Proposal #{{event.proposal}} merged"
						}
					}
				]
			}
		],
		"host:proposed": [
			{
				"push": "state.log",
				"value": {
					"kind": "review",
					"text": "Waiting for review as proposal #{{event.proposal}}"
				}
			}
		],
		"host:rejected": [
			{
				"push": "state.log",
				"value": {
					"kind": "error",
					"text": "{{event.proposal != null ? 'Proposal #' + event.proposal + ' rejected: ' + event.error : 'Rejected: ' + event.error}}"
				}
			}
		],
		"host:reply": [
			{
				"push": "state.log",
				"value": {
					"kind": "ai",
					"text": "{{event.from}}: {{event.text}}"
				}
			}
		],
		"host:error": [
			{
				"push": "state.log",
				"value": {
					"kind": "error",
					"text": "{{event.message}}"
				}
			}
		],
		"host:event": [
			{
				"push": "state.log",
				"value": {
					"kind": "system",
					"text": "The app emitted '{{event.name}}'"
				}
			}
		],
		"host:closed": [
			{
				"if": "{{state.connected}}",
				"then": [
					{
						"push": "state.log",
						"value": {
							"kind": "error",
							"text": "{{event.message}}"
						}
					}
				]
			},
			{
				"set": "state.connected",
				"to": false
			},
			{
				"set": "state.status",
				"to": "Not connected: start affrescoui_host (retrying every 2 s)"
			}
		],
		"host:open": [
			{
				"set": "state.status",
				"to": "Connected, waiting for the host"
			}
		]
	},
	"keys": {
		"mod+enter": "ask",
		"mod+z": {
			"send": "host",
			"data": {
				"type": "undo"
			}
		},
		"mod+1": {
			"set": "state.tab",
			"to": "review"
		},
		"mod+2": {
			"set": "state.tab",
			"to": "history"
		},
		"mod+3": {
			"set": "state.tab",
			"to": "rules"
		},
		"mod+j": "toggleTheme"
	},
