{
	"$schema": "../../../schema/sglgui-screen.schema.json",
	"format": "sglgui-screen",
	"version": 1,

	"window": { "title": "sGLGUI Studio", "width": 1000, "height": 760, "minWidth": 880, "minHeight": 640 },

	"fonts": {
		"default": { "file": "../fonts/Roboto-Regular.ttf", "size": 14 },
		"small": { "file": "../fonts/Roboto-Regular.ttf", "size": 12 },
		"heading": { "file": "../fonts/Roboto-Regular.ttf", "size": 16 },
		"title": { "file": "../fonts/Roboto-Regular.ttf", "size": 20 }
	},

	"colors": {
		"background": "#0b1020",
		"card": "#131a2e",
		"cardRaised": "#1b2440",
		"border": "#232d4b",
		"text": "#e2e8f0",
		"muted": "#7c89a8",
		"input": "#0e1426",
		"inputFocused": "#18213d",
		"accent": "#6366f1",
		"accentHover": "#7c7ff5",
		"accentPressed": "#4f46e5",
		"good": "#22c55e",
		"goodHover": "#4ade80",
		"bad": "#ef4444",
		"badHover": "#f87171",
		"neutral": "#2a3556",
		"neutralHover": "#35426b",
		"logYou": "#a5b4fc",
		"logAi": "#5eead4",
		"logCommit": "#cbd5e1",
		"logReview": "#fcd34d",
		"logError": "#fca5a5",
		"logSystem": "#7c89a8"
	},

	"state": {
		"connected": false,
		"status": "Connecting to the host...",
		"canReview": false,
		"revision": 0,
		"head": "",
		"mode": "default",
		"grants": [],
		"proposals": [],
		"previewing": null,
		"history": [],
		"log": [],
		"draft": "",
		"patch": "",
		"requests": 0
	},

	"styles": {
		"card": { "color": "@card" },
		"cardTitle": { "type": "label", "font": "heading", "textColor": "@text", "anchors": { "left": 20, "top": 16 }, "fitText": true },
		"caption": { "type": "label", "font": "small", "textColor": "@muted", "fitText": true },
		"input": {
			"type": "textarea",
			"height": 40,
			"padding": 12,
			"color": "@input",
			"focused": { "color": "@inputFocused" },
			"textColor": "@text",
			"placeholderColor": "@muted"
		},
		"button": {
			"type": "label",
			"align": "center",
			"color": "@accent",
			"hover": { "color": "@accentHover" },
			"pressed": { "color": "@accentPressed" },
			"textColor": "#ffffff",
			"cursor": "hand"
		},
		"smallButton": {
			"type": "label",
			"font": "small",
			"align": "center",
			"height": 26,
			"color": "@neutral",
			"hover": { "color": "@neutralHover" },
			"textColor": "@text",
			"cursor": "hand"
		}
	},

	"actions": {
		"ask": [
			{ "if": { "$empty": "{{state.draft}}" }, "then": [{ "stop": true }] },
			{ "increment": "state.requests" },
			{ "emit": "send", "data": { "type": "request", "id": { "$concat": ["request-", "{{state.requests}}"] }, "text": "{{state.draft}}" } },
			{ "push": "state.log", "value": { "kind": "you", "text": "You: {{state.draft}}" } },
			{ "set": "state.draft", "to": "" }
		],
		"applyPatch": [
			{ "if": { "$empty": "{{state.patch}}" }, "then": [{ "stop": true }] },
			{ "emit": "sendPatch", "data": { "text": "{{state.patch}}" } },
			{ "set": "state.patch", "to": "" }
		],
		"refreshHistory": [{ "emit": "send", "data": { "type": "getHistory", "limit": 4 } }],

		"host:hello": [
			{ "set": "state.connected", "to": true },
			{ "set": "state.canReview", "to": "{{event.canReview}}" },
			{ "set": "state.revision", "to": "{{event.revision}}" },
			{ "set": "state.head", "to": "{{event.head.short}}" },
			{ "set": "state.status", "to": "Connected as '{{event.you}}'" },
			{ "push": "state.log", "value": { "kind": "system", "text": "Connected to the host, at revision {{event.revision}} ({{event.head.short}})" } },
			{ "emit": "send", "data": { "type": "getDocument" } },
			{ "run": "refreshHistory" }
		],
		"host:document": [
			{ "set": "state.proposals", "to": "{{event.proposals}}" },
			{ "set": "state.previewing", "to": "{{event.previewing}}" },
			{ "set": "state.mode", "to": "{{event.mode}}" },
			{ "set": "state.grants", "to": "{{event.grants}}" },
			{ "set": "state.revision", "to": "{{event.revision}}" },
			{ "set": "state.head", "to": "{{event.head.short}}" }
		],
		"host:review": [
			{ "set": "state.proposals", "to": "{{event.proposals}}" },
			{ "set": "state.previewing", "to": "{{event.previewing}}" },
			{ "set": "state.mode", "to": "{{event.mode}}" },
			{ "set": "state.grants", "to": "{{event.grants}}" }
		],
		"host:history": [{ "set": "state.history", "to": "{{event.entries}}" }],
		"host:committed": [
			{ "set": "state.revision", "to": "{{event.revision}}" },
			{ "set": "state.head", "to": "{{event.short}}" },
			{ "push": "state.log", "value": { "kind": "commit", "text": "Revision {{event.revision}} ({{event.short}}) by {{event.author}}: {{event.message}}" } },
			{ "run": "refreshHistory" }
		],
		"host:applied": [
			{
				"if": { "$notEquals": ["{{event.proposal}}", null] },
				"then": [{ "push": "state.log", "value": { "kind": "review", "text": "Proposal #{{event.proposal}} merged" } }]
			}
		],
		"host:proposed": [
			{ "push": "state.log", "value": { "kind": "review", "text": "Waiting for review as proposal #{{event.proposal}}" } }
		],
		"host:rejected": [
			{
				"push": "state.log",
				"value": {
					"kind": "error",
					"text": { "$if": [{ "$notEquals": ["{{event.proposal}}", null] }, "Proposal #{{event.proposal}} rejected: {{event.error}}", "Rejected: {{event.error}}"] }
				}
			}
		],
		"host:reply": [{ "push": "state.log", "value": { "kind": "ai", "text": "{{event.from}}: {{event.text}}" } }],
		"host:error": [{ "push": "state.log", "value": { "kind": "error", "text": "{{event.message}}" } }],
		"host:event": [{ "push": "state.log", "value": { "kind": "system", "text": "The app emitted '{{event.name}}'" } }],
		"host:closed": [
			{ "set": "state.connected", "to": false },
			{ "set": "state.status", "to": "Not connected: start sglgui_host, then reconnect" },
			{ "push": "state.log", "value": { "kind": "error", "text": "{{event.message}}" } }
		],
		"local:error": [{ "push": "state.log", "value": { "kind": "error", "text": "{{event.message}}" } }]
	},

	"root": {
		"color": "@background",
		"children": [
			{
				"id": "header",
				"anchors": { "left": 0, "right": 0, "top": 0 },
				"height": 64,
				"color": "@card",
				"children": [
					{ "type": "label", "text": "sGLGUI Studio", "font": "title", "textColor": "@text", "anchors": { "left": 24, "top": 0, "bottom": 0 }, "width": 200, "align": { "horizontal": "start", "vertical": "center" } },
					{ "anchors": { "left": 214, "top": 28 }, "width": 8, "height": 8, "color": { "$if": ["{{state.connected}}", "@good", "@bad"] } },
					{ "type": "label", "text": "{{state.status}}", "textColor": "@muted", "anchors": { "left": 232, "top": 0, "bottom": 0, "right": 300 }, "align": { "horizontal": "start", "vertical": "center" } },
					{
						"when": { "$not": "{{state.connected}}" },
						"style": "smallButton",
						"text": "Reconnect",
						"anchors": { "right": 24, "top": 19 },
						"width": 96,
						"onClick": [{ "emit": "reconnect" }]
					},
					{
						"when": "{{state.connected}}",
						"type": "label",
						"text": "main  ·  revision {{state.revision}}  ·  {{state.head}}",
						"textColor": "@muted",
						"anchors": { "right": 24, "top": 0, "bottom": 0 },
						"width": 280,
						"align": { "horizontal": "end", "vertical": "center" }
					}
				]
			},
			{
				"id": "left",
				"anchors": { "left": 0, "top": 64, "bottom": 0 },
				"width": "55%",
				"color": "transparent",
				"children": [
					{
						"id": "askCard",
						"style": "card",
						"anchors": { "left": 20, "right": 10, "top": 20 },
						"height": 132,
						"children": [
							{ "style": "cardTitle", "text": "Ask the AI" },
							{ "style": "caption", "text": "Describe a change in plain words. An AI agent connected through MCP builds it.", "anchors": { "left": 20, "top": 42 } },
							{ "id": "draft", "style": "input", "anchors": { "left": 20, "right": 112, "top": 72 }, "placeholder": "e.g. add a Blocked column, or switch to a dark theme", "bind": "state.draft", "onSubmit": "ask", "autofocus": true },
							{ "style": "button", "text": "Send", "anchors": { "right": 20, "top": 72 }, "width": 80, "height": 40, "onClick": "ask" }
						]
					},
					{
						"id": "patchCard",
						"style": "card",
						"anchors": { "left": 20, "right": 10, "top": 168 },
						"height": 132,
						"children": [
							{ "style": "cardTitle", "text": "Direct change" },
							{ "style": "caption", "text": "A JSON Patch, applied as you. Paste with Cmd+V. Paths can start with a node id: #boardName/text", "anchors": { "left": 20, "top": 42 } },
							{ "id": "patch", "style": "input", "anchors": { "left": 20, "right": 112, "top": 72 }, "placeholder": "[{\"op\": \"replace\", \"path\": \"/colors/accent\", \"value\": \"#e11d48\"}]", "bind": "state.patch", "onSubmit": "applyPatch" },
							{ "style": "button", "text": "Apply", "anchors": { "right": 20, "top": 72 }, "width": 80, "height": 40, "onClick": "applyPatch" }
						]
					},
					{
						"id": "activityCard",
						"style": "card",
						"anchors": { "left": 20, "right": 10, "top": 316, "bottom": 20 },
						"children": [
							{ "style": "cardTitle", "text": "Activity" },
							{
								"id": "log",
								"type": "stack",
								"align": "end",
								"gap": 8,
								"anchors": { "left": 20, "right": 20, "top": 48, "bottom": 16 },
								"children": [
									{
										"repeat": { "for": "entry", "in": "state.log" },
										"type": "label",
										"text": "{{entry.text}}",
										"anchors": { "left": 0 },
										"wrap": true,
										"fitText": { "maxWidth": 460 },
										"textColor": {
											"$if": [{ "$equals": ["{{entry.kind}}", "you"] }, "@logYou",
											{ "$if": [{ "$equals": ["{{entry.kind}}", "ai"] }, "@logAi",
											{ "$if": [{ "$equals": ["{{entry.kind}}", "commit"] }, "@logCommit",
											{ "$if": [{ "$equals": ["{{entry.kind}}", "review"] }, "@logReview",
											{ "$if": [{ "$equals": ["{{entry.kind}}", "error"] }, "@logError", "@logSystem"] }] }] }] }]
										}
									}
								]
							}
						]
					}
				]
			},
			{
				"id": "right",
				"anchors": { "right": 0, "top": 64, "bottom": 0 },
				"width": "45%",
				"color": "transparent",
				"children": [
					{
						"id": "reviewCard",
						"style": "card",
						"anchors": { "left": 10, "right": 20, "top": 20 },
						"height": 380,
						"children": [
							{ "style": "cardTitle", "text": { "$concat": ["Review (", { "$length": "{{state.proposals}}" }, ")"] } },
							{
								"id": "mode",
								"anchors": { "right": 20, "top": 14 },
								"width": 222,
								"height": 26,
								"color": "transparent",
								"children": [
									{
										"style": "smallButton",
										"text": "Ask first",
										"anchors": { "left": 0, "top": 0 },
										"width": 70,
										"color": { "$if": [{ "$equals": ["{{state.mode}}", "default"] }, "@accent", "@neutral"] },
										"onClick": [{ "emit": "send", "data": { "type": "setMode", "mode": "default" } }]
									},
									{
										"style": "smallButton",
										"text": "Accept edits",
										"anchors": { "left": 74, "top": 0 },
										"width": 88,
										"color": { "$if": [{ "$equals": ["{{state.mode}}", "acceptEdits"] }, "@accent", "@neutral"] },
										"onClick": [{ "emit": "send", "data": { "type": "setMode", "mode": "acceptEdits" } }]
									},
									{
										"style": "smallButton",
										"text": "Plan",
										"anchors": { "left": 166, "top": 0 },
										"width": 56,
										"color": { "$if": [{ "$equals": ["{{state.mode}}", "plan"] }, "@accent", "@neutral"] },
										"onClick": [{ "emit": "send", "data": { "type": "setMode", "mode": "plan" } }]
									}
								]
							},
							{
								"style": "caption",
								"text": {
									"$if": [{ "$equals": ["{{state.mode}}", "acceptEdits"] }, "Accept edits: AI changes apply right away, unless a rule always asks.",
									{ "$if": [{ "$equals": ["{{state.mode}}", "plan"] }, "Plan: the AI can only propose, even where it is allowed.",
									"Ask first: AI changes no rule allows wait here for you."] }]
								},
								"anchors": { "left": 20, "top": 48 }
							},
							{
								"id": "proposals",
								"type": "stack",
								"gap": 8,
								"anchors": { "left": 20, "right": 20, "top": 72, "bottom": { "$add": [12, { "$multiply": [28, { "$length": "{{state.grants}}" }] }] } },
								"children": [
									{
										"repeat": { "for": "p", "in": "state.proposals" },
										"anchors": { "left": 0, "right": 0 },
										"height": 104,
										"color": { "$if": [{ "$equals": ["{{p.id}}", "{{state.previewing}}"] }, "@neutral", "@cardRaised"] },
										"children": [
											{ "style": "caption", "text": "#{{p.id}}  ·  {{p.author}}  ·  {{p.commits}} commit(s), {{p.operations}} change(s)  ·  {{p.short}}", "anchors": { "left": 14, "top": 8 } },
											{ "type": "label", "text": "{{p.message}}", "textColor": "@text", "anchors": { "left": 14, "right": 14, "top": 26 }, "height": 20 },
											{ "style": "caption", "text": { "$concat": ["Changes ", { "$join": ["{{p.touches}}", ", "] }] }, "anchors": { "left": 14, "top": 50 } },
											{
												"style": "smallButton",
												"text": { "$if": [{ "$equals": ["{{p.id}}", "{{state.previewing}}"] }, "End preview", "Preview"] },
												"anchors": { "left": 14, "bottom": 10 },
												"width": 84,
												"onClick": [
													{
														"if": { "$equals": ["{{p.id}}", "{{state.previewing}}"] },
														"then": [{ "emit": "send", "data": { "type": "endPreview" } }],
														"else": [{ "emit": "send", "data": { "type": "preview", "proposal": "{{p.id}}" } }]
													}
												]
											},
											{
												"style": "smallButton",
												"text": "Accept",
												"anchors": { "left": 106, "bottom": 10 },
												"width": 68,
												"color": "@good",
												"hover": { "color": "@goodHover" },
												"textColor": "#052e16",
												"onClick": [{ "emit": "send", "data": { "type": "accept", "proposal": "{{p.id}}", "head": "{{p.head}}" } }]
											},
											{
												"when": { "$not": { "$empty": "{{p.remember}}" } },
												"style": "smallButton",
												"text": "Always allow",
												"anchors": { "left": 182, "bottom": 10 },
												"width": 96,
												"color": "@good",
												"hover": { "color": "@goodHover" },
												"textColor": "#052e16",
												"onClick": [{ "emit": "send", "data": { "type": "accept", "proposal": "{{p.id}}", "head": "{{p.head}}", "dontAskAgain": true } }]
											},
											{
												"style": "smallButton",
												"text": "Reject",
												"anchors": { "right": 14, "bottom": 10 },
												"width": 68,
												"color": "@bad",
												"hover": { "color": "@badHover" },
												"textColor": "#ffffff",
												"onClick": [{ "emit": "send", "data": { "type": "reject", "proposal": "{{p.id}}" } }]
											}
										]
									}
								]
							},
							{
								"id": "grants",
								"type": "stack",
								"gap": 2,
								"anchors": { "left": 20, "right": 20, "bottom": 12 },
								"height": { "$multiply": [28, { "$length": "{{state.grants}}" }] },
								"color": "transparent",
								"children": [
									{
										"repeat": { "for": "g", "in": "state.grants" },
										"anchors": { "left": 0, "right": 0 },
										"height": 26,
										"color": "transparent",
										"children": [
											{ "type": "label", "text": "Don't ask again: {{g.rule}}", "font": "small", "textColor": "@logReview", "anchors": { "left": 0, "right": 80, "top": 0, "bottom": 0 }, "align": { "horizontal": "start", "vertical": "center" } },
											{
												"style": "smallButton",
												"text": "Revoke",
												"anchors": { "right": 0, "top": 0 },
												"width": 68,
												"onClick": [{ "emit": "send", "data": { "type": "revoke", "rule": "{{g.rule}}" } }]
											}
										]
									}
								]
							}
						]
					},
					{
						"id": "historyCard",
						"style": "card",
						"anchors": { "left": 10, "right": 20, "top": 416, "bottom": 20 },
						"children": [
							{ "style": "cardTitle", "text": "History" },
							{
								"style": "smallButton",
								"text": "Undo",
								"anchors": { "right": 20, "top": 14 },
								"width": 72,
								"onClick": [{ "emit": "send", "data": { "type": "undo" } }]
							},
							{
								"id": "history",
								"type": "stack",
								"align": "end",
								"gap": 4,
								"anchors": { "left": 20, "right": 20, "top": 52, "bottom": 16 },
								"children": [
									{
										"repeat": { "for": "entry", "in": "state.history" },
										"anchors": { "left": 0, "right": 0 },
										"height": 40,
										"color": { "$if": [{ "$equals": ["{{entry.number}}", "{{state.revision}}"] }, "@cardRaised", "@card"] },
										"children": [
											{
												"type": "label",
												"font": "small",
												"textColor": "@muted",
												"text": {
													"$concat": ["{{entry.number}}  ·  {{entry.short}}",
													{ "$if": [{ "$notEquals": ["{{entry.committer}}", "{{entry.author}}"] }, "  ·  approved by {{entry.committer}}", ""] }]
												},
												"anchors": { "left": 8, "right": 140, "top": 4 },
												"height": 14
											},
											{ "type": "label", "text": "{{entry.author}}: {{entry.message}}", "textColor": "@text", "anchors": { "left": 8, "right": 140, "top": 19 }, "height": 18 },
											{
												"when": { "$greater": ["{{entry.number}}", 0] },
												"style": "smallButton",
												"text": "Revert",
												"anchors": { "right": 72, "top": 7 },
												"width": 62,
												"onClick": [{ "emit": "send", "data": { "type": "revert", "revision": "{{entry.number}}" } }]
											},
											{
												"when": { "$notEquals": ["{{entry.number}}", "{{state.revision}}"] },
												"style": "smallButton",
												"text": "Restore",
												"anchors": { "right": 4, "top": 7 },
												"width": 64,
												"onClick": [{ "emit": "send", "data": { "type": "restore", "revision": "{{entry.number}}" } }]
											}
										]
									}
								]
							}
						]
					}
				]
			}
		]
	}
}
