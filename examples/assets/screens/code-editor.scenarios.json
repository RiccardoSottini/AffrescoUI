{
	"$schema": "../../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 1,
	"note": "What the Code editor template (Forge) does, checked headless: affrescoui test code-editor.scenarios.json",
	"screen": "code-editor.screen.json",
	"scenarios": [
		{
			"name": "open-a-file-from-the-explorer",
			"note": "Clicking a file in the explorer opens it in a new tab and makes it the active one",
			"steps": [
				{ "click": "#entry", "nth": 3 },
				{ "expect": { "state": "active", "is": 2 } },
				{ "expect": { "state": "tabs", "is": [0, 1, 2] } },
				{ "expect": { "node": "#tab", "nth": 2, "text": "Board.cpp" } },
				{ "expect": { "node": "#breadcrumbs", "text": "src / Board.cpp" } },
				{ "click": "#entry", "nth": 0, "note": "a folder opens nothing" },
				{ "expect": { "state": "tabs.length", "is": 3 } },
				{ "click": "#tab", "nth": 0 },
				{ "expect": { "state": "active", "is": 0 } },
				{ "expect": { "node": "#breadcrumbs", "text": "src / main.cpp" } }
			]
		},
		{
			"name": "edit-and-save",
			"note": "Typing in the editor marks the file unsaved with a dot on its tab, and Cmd+S saves it",
			"steps": [
				{ "click": "#editor" },
				{ "key": "mod+a" },
				{ "type": "int main() {}" },
				{ "expect": { "state": "files[0].text", "is": "int main() {}" } },
				{ "expect": { "state": "files[0].dirty", "is": true } },
				{ "expect": { "node": "#panel-files-tab", "exists": true } },
				{ "expect": { "node": "#statusSize", "text": "Ln 1, Col 14  ·  Spaces: 4  ·  UTF-8  ·  C++" } },
				{ "key": "mod+s" },
				{ "expect": { "state": "files[0].dirty", "is": false } },
				{ "expect": { "node": "#panel-files-tab", "exists": false } }
			]
		},
		{
			"name": "undo-an-edit",
			"note": "Cmd+Z in the editor brings back the text that typing replaced",
			"steps": [
				{ "click": "#editor" },
				{ "key": "mod+a" },
				{ "type": "x" },
				{ "expect": { "node": "#editor", "text": "x" } },
				{ "expect": { "state": "files[0].text.length", "is": 1 } },
				{ "key": "mod+z" },
				{ "expect": { "state": "files[0].text.length", "is": 547, "note": "main.cpp as it was" } }
			]
		},
		{
			"name": "close-tabs",
			"note": "Cmd+W closes the active tab and the next one takes its place; with no tab left the welcome text shows",
			"steps": [
				{ "key": "mod+w" },
				{ "expect": { "state": "tabs", "is": [1] } },
				{ "expect": { "state": "active", "is": 1 } },
				{ "expect": { "node": "#breadcrumbs", "text": "src / Board.hpp" } },
				{ "click": "#label-files-tab-dirty", "note": "the × on the last tab" },
				{ "expect": { "state": "tabs", "is": [] } },
				{ "expect": { "node": "#welcome", "exists": true } },
				{ "expect": { "node": "#editor", "exists": false } },
				{ "expect": { "node": "#statusSize", "text": "No file" } }
			]
		},
		{
			"name": "open-a-file-from-the-palette",
			"note": "Cmd+P opens the palette, typing filters the files by name, and Enter opens the first match",
			"steps": [
				{ "key": "mod+p" },
				{ "wait": 0, "note": "the focus lands on the next frame" },
				{ "expect": { "state": "palette", "is": true } },
				{ "expect": { "node": "#paletteInput", "property": "focused", "is": true } },
				{ "type": "read" },
				{ "expect": { "node": "#label-files-f-name", "text": "README.md" } },
				{ "expect": { "node": "#panel-f", "nth": 1, "exists": false } },
				{ "key": "enter" },
				{ "expect": { "state": "palette", "is": false } },
				{ "expect": { "state": "active", "is": 5 } },
				{ "expect": { "node": "#tab", "nth": 2, "text": "README.md" } }
			]
		},
		{
			"name": "palette-with-no-match",
			"note": "A query that matches no file says so, and Enter opens nothing",
			"steps": [
				{ "key": "mod+p" },
				{ "wait": 0 },
				{ "type": "zzz" },
				{ "expect": { "node": "#label-no-file-matches", "text": "No file matches 'zzz'" } },
				{ "key": "enter" },
				{ "expect": { "state": "palette", "is": true } },
				{ "expect": { "state": "tabs.length", "is": 2 } }
			]
		},
		{
			"name": "run-terminal-commands",
			"note": "Cmd+J focuses the terminal; help prints the commands, an unknown one says so, and clear empties it",
			"steps": [
				{ "key": "mod+j" },
				{ "wait": 0 },
				{ "type": "help" },
				{ "key": "enter" },
				{ "expect": { "state": "terminal.length", "is": 6 } },
				{ "expect": { "node": "#label-out-t", "nth": 5, "text": "commands: build, run, help, clear" } },
				{ "expect": { "state": "command", "is": "" } },
				{ "type": "deploy" },
				{ "key": "enter" },
				{ "expect": { "node": "#label-out-t", "nth": 7, "text": "deploy: command not found (try help)" } },
				{ "type": "clear" },
				{ "key": "enter" },
				{ "expect": { "state": "terminal", "is": [] } }
			]
		}
	]
}
