{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "orrery.screen.json",
	"note": "Orrery's own checks.",
	"scenarios": [
		{
			"name": "starts-on-day-zero",
			"steps": [
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"node": "#day",
						"text": "Day 0"
					}
				},
				{
					"expect": {
						"node": "#next-label",
						"text": "Next: Solar eclipse on day 30 (in 30 days)"
					}
				},
				{
					"expect": {
						"node": "#view-earth",
						"exists": true
					}
				}
			]
		},
		{
			"name": "next-event-moves-the-planets",
			"steps": [
				{
					"click": "#next-event"
				},
				{
					"wait": 800
				},
				{
					"expect": {
						"state": "time",
						"is": 29.5
					}
				},
				{
					"expect": {
						"node": "#next-label",
						"text": "Next: Lunar eclipse on day 44 (in 15 days)"
					}
				},
				{
					"click": "#rewind"
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				}
			]
		},
		{
			"name": "play-advances-the-playhead",
			"steps": [
				{
					"click": "#play"
				},
				{
					"wait": 500
				},
				{
					"expect": {
						"state": "playing",
						"is": true
					}
				},
				{
					"click": "#play"
				},
				{
					"expect": {
						"state": "playing",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#day",
						"text": "Day 9"
					}
				}
			]
		},
		{
			"name": "annotate-the-chart",
			"steps": [
				{
					"expect": {
						"state": "notes.length",
						"is": 1
					}
				},
				{
					"click": "#add-note"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 2
					}
				},
				{
					"expect": {
						"state": "notes[1].x",
						"is": -35
					}
				},
				{
					"click": "#mark"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 4
					}
				},
				{
					"click": "#clear-notes"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 0
					}
				}
			]
		},
		{
			"name": "reparent-in-the-graph",
			"steps": [
				{
					"action": "reparent",
					"event": {
						"from": "earth",
						"output": "satellites",
						"to": "mars",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[5].parent",
						"is": "earth"
					}
				},
				{
					"action": "orbitAround",
					"event": {
						"from": "earth",
						"output": "satellites",
						"to": "mars",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[5].parent",
						"is": "sun"
					}
				}
			]
		},
		{
			"name": "turn-and-zoom-the-view",
			"note": "The camera's handlers are on the view's pane, so they work where the 3D view isn't drawn too (the note in its place).",
			"steps": [
				{
					"drag": [200, 200],
					"to": [300, 200]
				},
				{
					"expect": {
						"state": "camera.yaw",
						"is": -0.4
					}
				},
				{
					"expect": {
						"state": "grab",
						"is": null
					}
				},
				{
					"scroll": "#view-pane",
					"dy": -3
				},
				{
					"expect": {
						"state": "camera.distance",
						"is": 12.3
					}
				}
			]
		},
		{
			"name": "overlays-show-the-selection-and-the-time",
			"steps": [
				{
					"expect": {
						"node": "#info-name",
						"text": "Earth"
					}
				},
				{
					"expect": {
						"node": "#info-distance",
						"text": "Distance: 3.34 AU"
					}
				},
				{
					"expect": {
						"node": "#info-radius",
						"text": "Radius: 6371 km"
					}
				},
				{
					"expect": {
						"node": "#time-date",
						"text": "2030-01-01 00:00 UTC"
					}
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Paused"
					}
				},
				{
					"key": "space"
				},
				{
					"key": "l"
				},
				{
					"expect": {
						"state": "speed",
						"is": 10
					}
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "17,280,000x faster: 200 days a second"
					}
				},
				{
					"key": "k"
				},
				{
					"key": "k"
				},
				{
					"expect": {
						"state": "speed",
						"is": 0.1
					}
				},
				{
					"key": "j"
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Reversed, 172,800x faster: 2 days a second"
					}
				},
				{
					"key": "space"
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Paused"
					}
				},
				{
					"key": "shift+1"
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "speed",
						"is": 1
					}
				}
			]
		},
		{
			"name": "go-to-and-follow-the-selection",
			"steps": [
				{
					"key": "g"
				},
				{
					"wait": 1000
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				},
				{
					"expect": {
						"state": "fly",
						"is": 0
					}
				},
				{
					"key": "f"
				},
				{
					"expect": {
						"state": "follow",
						"is": ""
					}
				},
				{
					"key": "f"
				},
				{
					"wait": 700
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				}
			]
		},
		{
			"name": "centre-the-selection",
			"steps": [
				{
					"key": "c"
				},
				{
					"wait": 700
				},
				{
					"expect": {
						"state": "follow",
						"is": ""
					}
				},
				{
					"expect": {
						"state": "fly",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "camera.tx",
						"is": 4.3
					}
				}
			]
		},
		{
			"name": "toggle-orbits-and-labels",
			"steps": [
				{
					"key": "o"
				},
				{
					"expect": {
						"state": "showOrbits",
						"is": false
					}
				},
				{
					"key": "p"
				},
				{
					"expect": {
						"state": "showLabels",
						"is": false
					}
				},
				{
					"key": "o"
				},
				{
					"expect": {
						"state": "showOrbits",
						"is": true
					}
				}
			]
		},
		{
			"name": "time-stops-at-the-start",
			"steps": [
				{
					"key": "j"
				},
				{
					"key": "space"
				},
				{
					"wait": 300
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "playing",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#next-label",
						"text": "No more events in this window"
					}
				}
			]
		},
		{
			"name": "show-the-browser",
			"steps": [
				{
					"expect": {
						"state": "showBrowser",
						"is": false
					}
				},
				{
					"key": "b"
				},
				{
					"expect": {
						"state": "showBrowser",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#browser-bodies",
						"property": "visible",
						"is": true
					}
				},
				{
					"key": "b"
				},
				{
					"expect": {
						"state": "showBrowser",
						"is": false
					}
				}
			]
		},
		{
			"name": "narrow-and-widen-the-field",
			"steps": [
				{
					"expect": {
						"node": "#view-fov",
						"text": "FOV: 48° 53′ (1.00x)"
					}
				},
				{
					"key": "period"
				},
				{
					"expect": {
						"state": "zoom",
						"is": 1.375
					}
				},
				{
					"expect": {
						"node": "#view-fov",
						"text": "FOV: 39° 57′ (1.25x)"
					}
				},
				{
					"key": "comma"
				},
				{
					"expect": {
						"state": "zoom",
						"is": 1.1
					}
				}
			]
		},
		{
			"name": "bookmark-and-return",
			"steps": [
				{
					"scroll": "#view-pane",
					"dy": -3
				},
				{
					"key": "mod+d"
				},
				{
					"expect": {
						"state": "bookmarks.length",
						"is": 2
					}
				},
				{
					"expect": {
						"state": "bookmark",
						"is": "place-1"
					}
				},
				{
					"expect": {
						"state": "browserTab",
						"is": "places"
					}
				},
				{
					"expect": {
						"state": "bookmarks[1].camera.distance",
						"is": 12.3
					}
				},
				{
					"action": "goToBookmark",
					"event": {
						"value": "overview"
					}
				},
				{
					"expect": {
						"state": "bookmark",
						"is": "overview"
					}
				},
				{
					"expect": {
						"state": "camera.distance",
						"is": 15
					}
				},
				{
					"action": "goToBookmark",
					"event": {
						"value": "place-1"
					}
				},
				{
					"expect": {
						"state": "camera.distance",
						"is": 12.3
					}
				}
			]
		},
		{
			"name": "bookmarks-keep-the-time-and-the-field",
			"steps": [
				{
					"key": "period"
				},
				{
					"click": "#next-event"
				},
				{
					"wait": 800
				},
				{
					"key": "mod+d"
				},
				{
					"expect": {
						"state": "bookmarks[1].time",
						"is": 29.5
					}
				},
				{
					"action": "goToBookmark",
					"event": {
						"value": "overview"
					}
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "zoom",
						"is": 1.1
					}
				},
				{
					"action": "goToBookmark",
					"event": {
						"value": "place-1"
					}
				},
				{
					"expect": {
						"state": "time",
						"is": 29.5
					}
				},
				{
					"expect": {
						"state": "zoom",
						"is": 1.375
					}
				},
				{
					"click": "#delete-bookmark"
				},
				{
					"expect": {
						"state": "bookmarks.length",
						"is": 1
					}
				},
				{
					"expect": {
						"state": "bookmark",
						"is": "overview"
					}
				},
				{
					"key": "mod+d"
				},
				{
					"expect": {
						"state": "bookmark",
						"is": "place-2"
					}
				}
			]
		},
		{
			"name": "go-to-twice-lands-once",
			"steps": [
				{
					"key": "g"
				},
				{
					"wait": 300
				},
				{
					"key": "g"
				},
				{
					"wait": 1100
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				},
				{
					"expect": {
						"state": "fly",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "flying",
						"is": ""
					}
				},
				{
					"expect": {
						"state": "flights",
						"is": 2
					}
				}
			]
		},
		{
			"name": "go-to-while-playing",
			"steps": [
				{
					"key": "space"
				},
				{
					"key": "g"
				},
				{
					"wait": 1100
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				},
				{
					"expect": {
						"state": "fly",
						"is": 0
					}
				},
				{
					"key": "space"
				}
			]
		},
		{
			"name": "reparent-onto-a-moon-but-not-into-a-loop",
			"steps": [
				{
					"action": "reparent",
					"event": {
						"from": "moon",
						"output": "satellites",
						"to": "mars",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[5].parent",
						"is": "moon"
					}
				},
				{
					"action": "reparent",
					"event": {
						"from": "mars",
						"output": "satellites",
						"to": "earth",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[3].parent",
						"is": "sun"
					}
				},
				{
					"action": "reparent",
					"event": {
						"from": "mars",
						"output": "satellites",
						"to": "venus",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[2].parent",
						"is": "sun"
					}
				}
			]
		},
		{
			"name": "a-small-window-keeps-the-graph",
			"steps": [
				{
					"resize": [1000, 700]
				},
				{
					"wait": 50
				},
				{
					"expect": {
						"node": "#view-hint",
						"property": "visible",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#chart",
						"property": "height",
						"is": 188
					}
				}
			]
		},
		{
			"name": "the-lit-side-is-drawn",
			"steps": [
				{
					"expect": {
						"node": "#view-shade-earth",
						"property": "visible",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#view-shade-sun",
						"property": "visible",
						"is": false
					}
				},
				{
					"key": "mod+comma"
				},
				{
					"expect": {
						"state": "renderOpen",
						"is": true
					}
				},
				{
					"click": "#render-shading-toggle"
				},
				{
					"expect": {
						"state": "showShading",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#view-shade-earth",
						"property": "visible",
						"is": false
					}
				}
			]
		},
		{
			"name": "render-options-hide-the-stars",
			"steps": [
				{
					"action": "openRender"
				},
				{
					"expect": {
						"state": "renderOpen",
						"is": true
					}
				},
				{
					"click": "#render-stars-toggle"
				},
				{
					"expect": {
						"state": "showStars",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#view-stars",
						"property": "visible",
						"is": false
					}
				},
				{
					"key": "escape"
				},
				{
					"expect": {
						"state": "renderOpen",
						"is": false
					}
				}
			]
		}
	]
}
