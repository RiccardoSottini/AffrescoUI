				}
			]
		},
		{
			"name": "show-the-browser",
			"steps": [
				{
					"expect": {
						"state": "showBrowser",
						"is": false
					}
				},
				{
					"key": "b"
				},
				{
					"expect": {
						"state": "showBrowser",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#browser-bodies",
						"property": "visible",
						"is": true
					}
				},
				{
					"key": "b"
				},
				{
					"expect": {
						"state": "showBrowser",
						"is": false
					}
				}
			]
		},
		{
			"name": "narrow-and-widen-the-field",
			"steps": [
				{
					"expect": {
						"node": "#view-fov",
