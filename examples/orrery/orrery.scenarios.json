{
	"format": "affrescoui-scenarios",
	"version": 2,
	"screen": "orrery.screen.json",
	"note": "Orrery's own checks.",
	"scenarios": [
		{
			"name": "starts-on-day-zero",
			"steps": [
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"node": {
							"role": "text",
							"name": "Day 0"
						},
						"property": "visible",
						"is": true
					}
				},
				{
					"expect": {
						"node": {
							"role": "text",
							"name": "Next: Solar eclipse on day 30 (in 30 days)"
						},
						"property": "visible",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#view-scene",
						"property": "visible",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#view-label-earth",
						"exists": true
					}
				},
				{
					"expect": {
						"state": "sceneView.selection[0]",
						"is": "earth"
					}
				}
			]
		},
		{
			"name": "next-event-moves-the-planets",
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Next event"
					}
				},
				{
					"wait": 800
				},
				{
					"expect": {
						"state": "time",
						"is": 29.5
					}
				},
				{
					"expect": {
						"node": {
							"role": "text",
							"name": "Next: Lunar eclipse on day 44 (in 15 days)"
						},
						"property": "visible",
						"is": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Back to day 0"
					}
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				}
			]
		},
		{
			"name": "play-advances-the-playhead",
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Play"
					}
				},
				{
					"wait": 500
				},
				{
					"expect": {
						"state": "playing",
						"is": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Pause"
					}
				},
				{
					"expect": {
						"state": "playing",
						"is": false
					}
				},
				{
					"expect": {
						"node": {
							"role": "text",
							"name": "Day 9"
						},
						"property": "visible",
						"is": true
					}
				}
			]
		},
		{
			"name": "annotate-the-chart",
			"steps": [
				{
					"action": "skyAbove"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 1
					}
				},
				{
					"click": "#add-note"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 2
					}
				},
				{
					"expect": {
						"state": "notes[1].x",
						"is": -35
					}
				},
				{
					"click": "#mark"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 4
					}
				},
				{
					"click": "#clear-notes"
				},
				{
					"expect": {
						"state": "notes.length",
						"is": 0
					}
				}
			]
		},
		{
			"name": "reparent-in-the-graph",
			"steps": [
				{
					"action": "reparent",
					"event": {
						"from": "earth",
						"output": "satellites",
						"to": "mars",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[5].parent",
						"is": "earth"
					}
				},
				{
					"action": "orbitAround",
					"event": {
						"from": "earth",
						"output": "satellites",
						"to": "mars",
						"input": "orbits"
					}
				},
				{
					"expect": {
						"state": "bodies[5].parent",
						"is": "sun"
					}
				}
			]
		},
		{
			"name": "turn-and-zoom-the-view",
			"note": "The camera's handlers are on the view's pane, so they work where the 3D view isn't drawn too (the note in its place).",
			"steps": [
				{
					"drag": [
						200,
						200
					],
					"to": [
						300,
						200
					]
				},
				{
					"expect": {
						"state": "camera.yaw",
						"is": -0.4
					}
				},
				{
					"expect": {
						"state": "grab",
						"is": null
					}
				},
				{
					"scroll": "#view-pane",
					"dy": -3
				},
				{
					"expect": {
						"state": "camera.distance",
						"is": 12.3
					}
				}
			]
		},
		{
			"name": "overlays-show-the-selection-and-the-time",
			"steps": [
				{
					"expect": {
						"node": "#info-name",
						"text": "Earth"
					}
				},
				{
					"expect": {
						"node": "#info-distance",
						"text": "Distance: 3.34 AU"
					}
				},
				{
					"expect": {
						"node": "#info-radius",
						"text": "Radius: 6371 km"
					}
				},
				{
					"expect": {
						"node": "#time-date",
						"text": "2030-01-01 00:00 UTC"
					}
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Paused"
					}
				},
				{
					"key": "space"
				},
				{
					"key": "l"
				},
				{
					"expect": {
						"state": "speed",
						"is": 10
					}
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "17,280,000x faster: 200 days a second"
					}
				},
				{
					"key": "k"
				},
				{
					"key": "k"
				},
				{
					"expect": {
						"state": "speed",
						"is": 0.1
					}
				},
				{
					"key": "j"
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Reversed, 172,800x faster: 2 days a second"
					}
				},
				{
					"key": "space"
				},
				{
					"expect": {
						"node": "#time-rate",
						"text": "Paused"
					}
				},
				{
					"key": "shift+1"
				},
				{
					"expect": {
						"state": "time",
						"is": 0
					}
				},
				{
					"expect": {
						"state": "speed",
						"is": 1
					}
				}
			]
		},
		{
			"name": "go-to-and-follow-the-selection",
			"steps": [
				{
					"key": "g"
				},
				{
					"wait": 1000
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				},
				{
					"expect": {
						"state": "fly",
						"is": 0
					}
				},
				{
					"key": "f"
				},
				{
					"expect": {
						"state": "follow",
						"is": ""
					}
				},
				{
					"key": "f"
				},
				{
					"wait": 700
				},
				{
					"expect": {
						"state": "follow",
						"is": "earth"
					}
				}
			]
		},
		{
			"name": "centre-the-selection",
