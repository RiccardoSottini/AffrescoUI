{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The slide show. The node audience draws the slide being shown into the image 'audience' (a snapshot), with its transition from the slide before and its builds: the audience window shows that image, and so does this window, full screen, or the presenter view beside the next slide, the notes and a timer. state.show.t runs from 0 to 1 through a transition, and state.show.clock through the builds of the step shown (milliseconds), both animated. Each slide is also drawn once into its own image, 'slide-<id>', by the page nodes: the thumbnails, the sorter and the presenter view show those images, and the PDF export draws the page nodes themselves, as vectors.",

	"windows": {
		"audience": { "title": "Slide show", "image": "audience", "background": "#000000", "fullscreen": true, "onClick": "showNext", "onClose": "showEnd" }
	},

	"state": {
		"presenterView": false,
		"show": { "on": false, "index": 0, "from": -1, "step": 0, "clock": 0, "t": 1, "black": false, "white": false, "ended": false, "seconds": 0, "paused": false, "notesSize": 18 }
	},

	"computed": {
		"showOrder": "{{filter(range(length(state.deck.slides)), !(state.deck.slides[it].hidden ?? false))}}",
		"showSlide": "{{state.deck.slides[state.show.index] ?? state.deck.slides[0]}}",
		"showFrom": "{{state.show.from >= 0 ? state.deck.slides[state.show.from] : null}}",
		"showKind": "{{state.show.t >= 1 ? 'none' : computed.showSlide.transition.kind ?? 'none'}}",
		"showFades": "{{computed.showKind == 'fade' || computed.showKind == 'morph'}}",
		"showTimings": "{{scan(computed.showSlide.animations ?? [], merge(it, { step: acc.step + (it.start == 'click' ? 1 : 0), start: (it.start == 'click' ? 0 : it.start == 'with' ? acc.start : acc.end) + (it.delay ?? 0), end: (it.start == 'click' ? 0 : it.start == 'with' ? acc.start : acc.end) + (it.delay ?? 0) + (it.ms ?? 500) }), { step: 0, start: 0, end: 0 })}}",
		"showSteps": "{{count(computed.showSlide.animations ?? [], it.start == 'click')}}",
		"showNext": "{{find(computed.showOrder, it > state.show.index)}}",
		"showPrevious": "{{find(reverse(computed.showOrder), it < state.show.index)}}",
		"showPosition": "{{indexOf(computed.showOrder, state.show.index) + 1}}",
		"showTimer": "{{pad(floor(state.show.seconds / 3600), 2, '0') + ':' + pad(floor(state.show.seconds / 60) % 60, 2, '0') + ':' + pad(state.show.seconds % 60, 2, '0')}}"
	},

	"actions": {
		"present": [
			{ "set": "state.show", "to": "{{merge(state.show, { on: true, from: -1, black: false, white: false, ended: false, seconds: 0, paused: false })}}" },
			{ "run": "showEnter", "with": { "index": "{{find(computed.showOrder, it >= from) ?? computed.showOrder[0] ?? 0}}", "previous": -1 } },
			{ "if": "{{state.presenterView}}", "then": [{ "openWindow": "audience" }], "else": [{ "fullscreen": true }] },
			{ "focus": "#show-view" }
		],
		"showEnter": [
			{ "set": "state.show", "to": "{{merge(state.show, { index: index, from: previous, step: 0, clock: 0, t: 0, ended: false })}}" },
			{ "if": "{{(computed.showSlide.transition.kind ?? 'none') == 'none'}}",
			  "then": [{ "set": "state.show.t", "to": 1 }],
			  "else": [{ "animate": "state.show.t", "to": 1, "ms": "{{computed.showSlide.transition.ms ?? 500}}", "easing": "inOut" }] },
			{ "run": "showPlay" }
		],
		"showPlay": [
			{ "if": "{{max(concat([0], map(filter(computed.showTimings, it.step == state.show.step), it.end))) > 0}}",
			  "then": [{ "animate": "state.show.clock", "to": "{{max(concat([0], map(filter(computed.showTimings, it.step == state.show.step), it.end)))}}", "ms": "{{max(concat([0], map(filter(computed.showTimings, it.step == state.show.step), it.end)))}}", "easing": "linear" }],
			  "else": [{ "set": "state.show.clock", "to": 0 }] }
		],
		"showNext": [
			{ "if": "{{state.show.ended}}", "then": [{ "run": "showEnd" }],
			  "else": [{ "if": "{{state.show.step < computed.showSteps}}",
			             "then": [{ "set": "state.show.clock", "to": 0 }, { "increment": "state.show.step" }, { "set": "state.show.t", "to": 1 }, { "run": "showPlay" }],
			             "else": [{ "if": "{{computed.showNext != null}}",
			                        "then": [{ "run": "showEnter", "with": { "index": "{{computed.showNext}}", "previous": "{{state.show.index}}" } }],
			                        "else": [{ "set": "state.show.ended", "to": true }] }] }] }
		],
		"showPrevious": [
			{ "if": "{{state.show.ended}}", "then": [{ "set": "state.show.ended", "to": false }],
			  "else": [{ "if": "{{state.show.step > 0}}",
			             "then": [{ "set": "state.show.clock", "to": 1000000 }, { "increment": "state.show.step", "by": -1 }],
			             "else": [{ "if": "{{computed.showPrevious != null}}",
			                        "then": [{ "run": "showGo", "with": { "index": "{{computed.showPrevious}}", "built": true } }] }] }] }
		],
		"showGo": [
			{ "set": "state.show", "to": "{{merge(state.show, { index: clamp(index, 0, length(state.deck.slides) - 1), from: -1, t: 1, clock: 1000000, ended: false, black: false, white: false })}}" },
			{ "set": "state.show.step", "to": "{{built ? computed.showSteps : 0}}" }
		],
		"showBlack": [{ "set": "state.show.white", "to": false }, { "toggle": "state.show.black" }],
		"showWhite": [{ "set": "state.show.black", "to": false }, { "toggle": "state.show.white" }],
		"showEnd": [
			{ "if": "{{state.show.on}}", "then": [
				{ "set": "state.current", "to": "{{state.show.index}}" },
				{ "set": "state.show", "to": "{{merge(state.show, { on: false, t: 1, from: -1, black: false, white: false, ended: false })}}" },
				{ "set": "state.board.selection", "to": [] },
				{ "if": "{{windows.audience.open}}", "then": [{ "closeWindow": "audience" }] },
				{ "if": "{{windows.main.fullscreen}}", "then": [{ "fullscreen": false }] },
				{ "focus": "#thumbnails" }
			] }
		],
		"togglePresenterView": [{ "toggle": "state.presenterView" }],
		"showTick": [{ "if": "{{!state.show.paused}}", "then": [{ "increment": "state.show.seconds" }] }]
	},

	"keys": {
		"right": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"down": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"pagedown": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"space": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"enter": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"n": [{ "when": "{{state.show.on}}", "do": "showNext" }],
		"left": [{ "when": "{{state.show.on}}", "do": "showPrevious" }],
		"up": [{ "when": "{{state.show.on}}", "do": "showPrevious" }],
		"pageup": [{ "when": "{{state.show.on}}", "do": "showPrevious" }],
		"p": [{ "when": "{{state.show.on}}", "do": "showPrevious" }],
		"home": [{ "when": "{{state.show.on}}", "do": "showGo", "with": { "index": "{{computed.showOrder[0] ?? 0}}", "built": false } }],
		"end": [{ "when": "{{state.show.on}}", "do": "showGo", "with": { "index": "{{computed.showOrder[length(computed.showOrder) - 1] ?? 0}}", "built": true } }],
		"b": [{ "when": "{{state.show.on}}", "do": "showBlack" }],
		"period": [{ "when": "{{state.show.on}}", "do": "showBlack" }],
		"w": [{ "when": "{{state.show.on}}", "do": "showWhite" }],
		"comma": [{ "when": "{{state.show.on}}", "do": "showWhite" }],
		"f5": [{ "when": "{{!state.show.on}}", "do": "present", "with": { "from": 0 } }],
		"shift+f5": [{ "when": "{{!state.show.on}}", "do": "present", "with": { "from": "{{state.current}}" } }]
	},

	"overlays": {
		"zShow": { "use": "showView", "when": "{{state.show.on}}", "anchors": { "left": 0, "right": 0, "top": 0, "bottom": 0 } }
	},

	"styles": {
		"presenterButton": {
			"type": "label", "height": 32, "fitText": true, "padding": 10, "radius": 6, "color": "#2f2f37", "textColor": "#f2f2f5", "cursor": "hand",
			"focusable": true, "hover": { "color": "#3d3d48" }
		},
		"presenterButtonOn": { "style": "presenterButton", "color": "#4b3fa8", "hover": { "color": "#5d51c0" } }
	},

	"components": {
		"showSlide": {
			"params": { "slide": null, "step": 0, "clock": 0, "timings": [], "prefix": "" },
			"note": "A slide as the show draws it: the objects whose builds haven't come yet left out, the one building faded in over the background, wiped in, flown in from the bottom or grown.",
			"node": {
				"id": "{{prefix + 'show'}}", "color": "transparent", "x": 0, "y": 0, "width": 960, "height": 540,
				"let": {
					"layout": "{{find(computed.layouts, it.id == slide.layout) ?? computed.layouts[1]}}",
					"ground": "{{slice(computed.palette[slide.background ?? computed.theme.background] ?? slide.background ?? '#ffffff', 0, 7)}}"
				},
				"children": [
					{ "use": "slideBackground", "with": { "slide": "{{slide}}", "prefix": "{{prefix}}" } },
					{
						"repeat": { "for": "o", "in": "{{slide.objects}}", "key": "{{o.id}}" },
						"let": {
							"a": "{{find(timings, it.target == o.id)}}",
							"p": "{{a == null || a.step < step ? 1 : a.step > step ? 0 : clamp((clock - a.start) / max(a.ms ?? 500, 1), 0, 1)}}",
							"q": "{{a == null ? 1 : a.kind == 'exit' ? 1 - p : p}}",
							"ph": "{{find(layout.ph, it.ph == o.ph) ?? {}}}",
							"box": "{{{ x: o.x ?? ph.x ?? 0, y: o.y ?? ph.y ?? 0, w: o.w ?? ph.w ?? 100, h: o.h ?? ph.h ?? 100 }}}",
							"effect": "{{q >= 1 ? 'none' : a.effect ?? 'appear'}}"
						},
						"id": "{{prefix + 'build-' + o.id}}", "when": "{{q > 0}}", "color": "transparent",
						"x": 0, "y": 0, "width": "{{effect == 'wipe' ? box.x + box.w * q : 960}}", "height": 540,
						"translate": "{{effect == 'fly' ? [0, (1 - q) * (560 - box.y)] : [0, 0]}}",
						"scale": "{{effect == 'zoom' ? max(q, 0.01) : 1}}",
						"transformOrigin": "{{[(box.x + box.w / 2) / 9.6, (box.y + box.h / 2) / 5.4]}}",
						"children": [
							{ "use": "slideObject", "with": { "o": "{{o}}", "prefix": "{{prefix}}", "layout": "{{layout}}", "edit": false } },
							{ "id": "{{prefix + 'veil-' + o.id}}", "when": "{{effect == 'fade'}}", "x": "{{box.x - 4}}", "y": "{{box.y - 4}}", "width": "{{box.w + 8}}", "height": "{{box.h + 8}}",
							  "rotate": "{{o.rotate ?? 0}}",
							  "color": "{{gradientColor({ stops: [{ at: 0, color: ground }, { at: 1, color: ground + '00' }] }, q)}}" }
						]
					}
				]
			}
		},

		"showStage": {
			"params": {},
			"note": "What the audience sees: the slide before under (or, for reveal, over) the slide shown, as its transition goes; a fade goes through black.",
			"node": {
				"id": "audience", "snapshot": { "image": "audience", "scale": 2 }, "x": 0, "y": 0, "width": 960, "height": 540, "color": "#000000",
				"let": {
					"k": "{{computed.showKind}}",
					"t": "{{state.show.t}}",
					"u": "{{1 - state.show.t}}",
					"d": "{{computed.showSlide.transition.direction ?? 'left'}}",
					"dx": "{{d == 'left' ? 960 : d == 'right' ? -960 : 0}}",
					"dy": "{{d == 'up' ? 540 : d == 'down' ? -540 : 0}}",
					"band": "{{k == 'wipe' ? (d == 'left' ? [960 * u, 0, 960 * t, 540] : d == 'right' ? [0, 0, 960 * t, 540] : d == 'up' ? [0, 540 * u, 960, 540 * t] : [0, 0, 960, 540 * t]) : k == 'split' ? [480 * u, 0, 960 * t, 540] : [0, 0, 960, 540]}}"
				},
				"children": [
					{ "id": "show-from", "when": "{{computed.showFrom != null && k != 'none' && k != 'reveal' && !(computed.showFades && t >= 0.5)}}",
					  "color": "transparent", "x": 0, "y": 0, "width": 960, "height": 540,
					  "translate": "{{k == 'push' ? [-dx * t, -dy * t] : [0, 0]}}",
					  "children": [{ "use": "slidePage", "with": { "slide": "{{computed.showFrom}}", "prefix": "f-" } }] },
					{ "id": "show-to", "when": "{{!(computed.showFades && t < 0.5)}}", "color": "transparent",
					  "x": "{{band[0]}}", "y": "{{band[1]}}", "width": "{{max(band[2], 0)}}", "height": "{{max(band[3], 0)}}",
					  "translate": "{{k == 'push' || k == 'cover' ? [dx * u, dy * u] : [0, 0]}}",
					  "children": [{ "id": "show-to-page", "color": "transparent", "x": "{{-band[0]}}", "y": "{{-band[1]}}", "width": 960, "height": 540,
					                 "children": [{ "use": "showSlide", "with": { "slide": "{{computed.showSlide}}", "step": "{{state.show.step}}", "clock": "{{state.show.clock}}",
					                                                            "timings": "{{computed.showTimings}}", "prefix": "a-" } }] }] },
					{ "id": "show-from-over", "when": "{{computed.showFrom != null && k == 'reveal'}}", "color": "transparent", "x": 0, "y": 0, "width": 960, "height": 540,
					  "translate": "{{[-dx * t, -dy * t]}}",
					  "children": [{ "use": "slidePage", "with": { "slide": "{{computed.showFrom}}", "prefix": "r-" } }] },
					{ "id": "show-fade", "when": "{{computed.showFades}}", "x": 0, "y": 0, "width": 960, "height": 540,
					  "color": "{{gradientColor({ stops: [{ at: 0, color: '#00000000' }, { at: 1, color: '#000000' }] }, t < 0.5 ? 2 * t : 2 * u)}}" },
					{ "id": "show-blank", "when": "{{state.show.black || state.show.white || state.show.ended}}", "x": 0, "y": 0, "width": 960, "height": 540,
					  "color": "{{state.show.white ? '#ffffff' : '#000000'}}",
					  "children": [{ "type": "label", "id": "show-ended", "when": "{{state.show.ended}}", "x": 0, "y": 16, "width": 960, "height": 24, "align": "center",
					                 "runs": [{ "text": "End of the slide show. Click to leave.", "size": 14, "color": "#d0d0d8" }] }] }
				]
			}
		},

		"slideImage": {
			"params": { "s": null },
			"note": "A slide drawn once into the image 'slide-<id>', for the thumbnails, the sorter and the presenter view; the export draws these nodes as PDF pages.",
			"node": {
				"id": "{{'page-' + s.id}}", "snapshot": { "image": "{{'slide-' + s.id}}", "scale": "{{clamp(window.scale / 4, 0.25, 1)}}" },
				"x": 0, "y": 0, "width": 960, "height": 540, "color": "#ffffff",
				"children": [{ "use": "slidePage", "with": { "slide": "{{s}}", "prefix": "{{'p' + s.id + '-'}}" } }]
			}
		},

		"showView": {
			"params": {},
			"note": "This window while the show runs: the show itself, full screen, or the presenter view.",
			"node": {
				"id": "show-view", "color": "#000000", "focusable": true, "role": "dialog", "label": "Slide show",
				"onClick": [{ "if": "{{!state.presenterView}}", "then": [{ "run": "showNext" }] }],
				"children": [
					{ "type": "image", "id": "show-image", "when": "{{!state.presenterView}}", "fill": 0, "source": "audience", "fit": "contain" },
					{ "use": "presenter", "when": "{{state.presenterView}}" }
				]
			}
		},

		"presenter": {
			"params": {},
			"node": {
				"id": "presenter", "fill": 0, "color": "#18181d",
				"every": { "ms": 1000, "do": "showTick" },
				"children": [
					{ "type": "row", "id": "presenter-top", "anchors": { "left": 24, "right": 24, "top": 12 }, "height": 36, "gap": 8, "alignItems": "center", "color": "transparent",
					  "children": [
						{ "type": "label", "id": "presenter-timer", "fitText": true, "height": 32, "textColor": "#f2f2f5", "runs": [{ "text": "{{computed.showTimer}}", "size": 22 }] },
						{ "type": "label", "id": "presenter-pause", "style": "presenterButton", "runs": [{ "icon": "{{state.show.paused ? 'play' : 'pause'}}", "size": 15 }],
						  "tooltip": "{{state.show.paused ? 'Resume the timer' : 'Pause the timer'}}", "onClick": [{ "toggle": "state.show.paused" }] },
						{ "type": "label", "id": "presenter-reset", "style": "presenterButton", "runs": [{ "icon": "rotate-ccw", "size": 15 }], "tooltip": "Restart the timer",
						  "onClick": [{ "set": "state.show.seconds", "to": 0 }] },
						{ "id": "presenter-top-gap", "grow": 1, "height": 1, "color": "transparent" },
						{ "type": "label", "id": "presenter-clock", "fitText": true, "height": 32, "textColor": "#a9a9b8", "runs": [{ "text": "{{time(now(), 'HH:mm')}}", "size": 16 }] }
					  ] },
					{ "id": "presenter-current", "anchors": { "left": 24, "top": 60, "right": 384, "bottom": 76 }, "color": "#000000", "radius": 4,
					  "children": [{ "type": "image", "id": "presenter-current-image", "fill": 0, "source": "audience", "fit": "contain" }] },
					{ "type": "column", "id": "presenter-side", "width": 336, "anchors": { "right": 24, "top": 60, "bottom": 76 }, "gap": 8, "color": "transparent", "alignItems": "stretch",
					  "children": [
						{ "type": "label", "id": "presenter-next-title", "height": 20, "textColor": "#a9a9b8",
						  "runs": [{ "text": "{{computed.showNext != null ? 'Next' : 'End of the slide show'}}", "size": 13 }] },
						{ "id": "presenter-next", "height": 189, "color": "#000000", "radius": 4,
						  "children": [{ "type": "image", "id": "presenter-next-image", "fill": 0, "when": "{{computed.showNext != null}}",
						                 "source": "{{'slide-' + state.deck.slides[computed.showNext].id}}", "fit": "contain" }] },
						{ "type": "row", "id": "presenter-notes-bar", "height": 24, "gap": 4, "alignItems": "center", "color": "transparent", "children": [
							{ "type": "label", "id": "presenter-notes-title", "grow": 1, "height": 20, "textColor": "#a9a9b8", "runs": [{ "text": "Notes", "size": 13 }] },
							{ "type": "label", "id": "presenter-notes-smaller", "style": "presenterButton", "height": 24, "padding": 6, "runs": [{ "icon": "a-arrow-down", "size": 14 }],
							  "tooltip": "Smaller notes", "onClick": [{ "set": "state.show.notesSize", "to": "{{max(state.show.notesSize - 2, 10)}}" }] },
							{ "type": "label", "id": "presenter-notes-larger", "style": "presenterButton", "height": 24, "padding": 6, "runs": [{ "icon": "a-arrow-up", "size": 14 }],
							  "tooltip": "Larger notes", "onClick": [{ "set": "state.show.notesSize", "to": "{{min(state.show.notesSize + 2, 48)}}" }] }
						] },
						{ "type": "column", "id": "presenter-notes-box", "grow": 1, "scroll": "vertical", "color": "transparent", "children": [
							{ "type": "label", "id": "presenter-notes", "width": 336, "wrap": true, "fitText": { "maxWidth": 336 }, "align": "start",
							  "runs": [{ "text": "{{(computed.showSlide.notes ?? '') == '' ? 'No notes for this slide.' : computed.showSlide.notes}}", "size": "{{state.show.notesSize}}",
							             "color": "{{(computed.showSlide.notes ?? '') == '' ? '#7d7d8c' : '#f2f2f5'}}" }] }
						] }
					  ] },
					{ "type": "row", "id": "presenter-controls", "anchors": { "left": 24, "right": 24, "bottom": 22 }, "height": 36, "gap": 8, "alignItems": "center", "color": "transparent",
					  "children": [
						{ "type": "label", "id": "presenter-previous", "style": "presenterButton", "runs": [{ "icon": "chevron-left", "size": 16 }], "tooltip": "Previous (Left)", "onClick": "showPrevious" },
						{ "type": "label", "id": "presenter-where", "fitText": true, "height": 32, "padding": 6, "textColor": "#f2f2f5",
						  "runs": [{ "text": "{{'Slide ' + computed.showPosition + ' of ' + length(computed.showOrder)}}", "size": 14 }] },
						{ "type": "label", "id": "presenter-forward", "style": "presenterButton", "runs": [{ "icon": "chevron-right", "size": 16 }], "tooltip": "Next (Right)", "onClick": "showNext" },
						{ "type": "label", "id": "presenter-black", "style": "{{state.show.black ? 'presenterButtonOn' : 'presenterButton'}}",
						  "runs": [{ "icon": "square", "size": 14 }, { "text": " Black (B)", "size": 13 }], "onClick": "showBlack" },
						{ "id": "presenter-gap", "grow": 1, "height": 1, "color": "transparent" },
						{ "type": "label", "id": "presenter-end", "style": "presenterButton", "runs": [{ "text": "End Slide Show", "size": 13 }], "onClick": "showEnd" }
					  ] }
				]
			}
		}
	}
}
