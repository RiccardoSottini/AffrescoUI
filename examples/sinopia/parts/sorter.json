{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "The slide sorter, reusable: thumbnails of slides (host images thumb-<id>, drawn by rendering each slide's panel to an image and cached until the slide changes), a vertical list and a wrapping grid, with section headers, skipped slides dimmed and crossed, and drag to reorder. It needs only a list of { id, index, skip, section } and two action names, so another app (Tempera, for its pages) includes this file and draws its own thumbnails.",

	"components": {
		"slideThumb": {
			"params": { "slide": null, "selected": false, "width": 160, "pick": "", "move": "", "slides": [], "prefix": "thumb" },
			"node": {
				"type": "column", "id": "{{prefix + '-' + slide.id}}", "width": "{{width}}", "height": "{{width * state.render.height / max(1, state.render.width) + 20}}", "gap": 4, "color": "transparent",
				"drag": { "data": { "id": "{{slide.id}}" } },
				"onDrop": { "run": "{{move}}", "with": { "from": "{{indexOf(map(slides, it.id), event.data.id)}}", "to": "{{slide.index}}" } },
				"onClick": { "run": "{{pick}}", "with": { "index": "{{slide.index}}" } },
				"children": [
					{
						"id": "{{prefix + '-' + slide.id + '-frame'}}", "width": "{{width}}", "aspectRatio": "{{state.render.width / max(1, state.render.height)}}",
						"color": "@paper", "radius": 3, "borderWidth": "{{selected ? 2 : 1}}", "borderColor": "{{selected ? '@accent' : '@line'}}",
						"dragOver": { "borderColor": "@accent", "borderWidth": 3 },
						"children": [
							{ "type": "image", "id": "{{prefix + '-' + slide.id + '-image'}}", "fill": 2, "source": "{{'thumb-' + slide.id}}", "fit": "contain" },
							{ "id": "{{prefix + '-' + slide.id + '-skip'}}", "fill": 0, "color": "#ffffffa0", "when": "{{slide.skip}}", "radius": 3,
							  "children": [{ "type": "label", "id": "{{prefix + '-' + slide.id + '-skipped'}}", "fill": 0, "icon": "eye-off", "align": "center", "textColor": "@muted" }] }
						]
					},
					{ "type": "label", "id": "{{prefix + '-' + slide.id + '-number'}}", "width": "{{width}}", "height": 16, "text": "{{text(slide.index + 1) + (slide.skip ? '  skipped' : '')}}",
					  "textColor": "{{selected ? '@accent' : '@muted'}}", "align": "center" }
				]
			}
		},
		"slideList": {
			"params": { "slides": [], "current": 0, "sections": [], "pick": "", "move": "", "width": 160, "prefix": "list" },
			"node": {
				"type": "column", "id": "{{prefix}}", "fill": 0, "gap": 6, "scroll": "vertical", "alignItems": "center", "color": "transparent",
				"children": [
					{
						"repeat": { "for": "slide", "in": "{{slides}}", "key": "{{slide.id}}" },
						"type": "column", "id": "{{prefix + '-row-' + slide.id}}", "width": "{{width}}", "gap": 4, "color": "transparent",
						"let": { "header": "{{slide.section != '' && slide.section != (slide.index > 0 ? slides[slide.index - 1].section : '')}}" },
						"height": "{{width * state.render.height / max(1, state.render.width) + 20 + (header ? 24 : 0)}}",
						"children": [
							{ "type": "label", "id": "{{prefix + '-section-' + slide.id}}", "when": "{{header}}",
							  "width": "{{width}}", "height": 20, "text": "{{find(sections, it.id == slide.section).title ?? slide.section}}", "textColor": "@ink" },
							{ "use": "slideThumb", "with": { "slide": "{{slide}}", "selected": "{{slide.index == current}}", "width": "{{width}}",
							  "pick": "{{pick}}", "move": "{{move}}", "slides": "{{slides}}", "prefix": "{{prefix}}" } }
						]
					}
				]
			}
		},
		"slideSorter": {
			"params": { "slides": [], "current": 0, "pick": "", "move": "", "width": 200, "prefix": "sorter" },
			"node": {
				"type": "row", "id": "{{prefix + '-grid'}}", "fill": 0, "wrap": true, "gap": 16, "scroll": "vertical", "color": "transparent",
				"children": [
					{ "repeat": { "for": "slide", "in": "{{slides}}", "key": "{{slide.id}}" },
					  "use": "slideThumb", "with": { "slide": "{{slide}}", "selected": "{{slide.index == current}}", "width": "{{width}}",
					  "pick": "{{pick}}", "move": "{{move}}", "slides": "{{slides}}", "prefix": "{{prefix}}" } }
				]
			}
		}
	}
}
