{
	"$schema": "../../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "Sinopia's checks of the ribbon's galleries, the effects, the builds and the export of every slide: affrescoui test effects.scenarios.json.",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "sinopia-ribbon-over-the-slide",
			"note": "With the ribbon collapsed, a tab shows it over the slide; a click elsewhere hides it, and its pin keeps it open in its place",
			"steps": [
				{
					"click": "#ribbon-collapse"
				},
				{
					"expect": {
						"node": "#ribbon",
						"exists": false
					}
				},
				{
					"click": "#tab-design-label"
				},
				{
					"expect": {
						"node": "#ribbon-peek",
						"exists": true
					}
				},
				{
					"expect": {
						"state": "ribbon",
						"is": false
					}
				},
				{
					"expect": {
						"node": "#gal-themes",
						"exists": true
					}
				},
				{
					"click": "#thumb-s2-row"
				},
				{
					"expect": {
						"state": "ribbonPeek",
						"is": false
					}
				},
				{
					"click": "#tab-home-label"
				},
				{
					"expect": {
						"state": "ribbonPeek",
						"is": true
					}
				},
				{
					"click": "#ribbon-pin"
				},
				{
					"expect": {
						"state": "ribbon",
						"is": true
					}
				},
				{
					"expect": {
						"node": "#ribbon-peek",
						"exists": false
					}
				},
				{
					"expect": {
						"node": "#ribbon",
						"exists": true
					}
				}
			]
		},
		{
			"name": "sinopia-wipe-from-every-side",
			"note": "A wipe build starts from the left; Motion's side button turns it to the top, the right and the bottom, and the show plays it",
			"steps": [
				{
					"click": "#o2"
				},
				{
					"click": "#tab-animations-label"
				},
				{
					"click": "#fx-wipe"
				},
				{
					"expect": {
						"state": "deck.slides[0].animations[0].effect",
						"is": "wipe"
					}
				},
				{
					"expect": {
						"node": "#motion-side",
						"text": " From left"
					}
				},
				{
					"click": "#motion-side"
				},
				{
					"expect": {
						"state": "deck.slides[0].animations[0].direction",
						"is": "top"
					}
				},
				{
					"click": "#motion-side"
				},
				{
					"expect": {
						"state": "deck.slides[0].animations[0].direction",
						"is": "right"
					}
				},
				{
					"key": "f5"
				},
				{
					"key": "right"
				},
				{
					"wait": 200
				},
				{
					"expect": {
						"state": "show.step",
						"is": 1
					}
				},
				{
					"wait": 600
				},
				{
					"key": "escape"
				},
				{
					"click": "#o2"
				},
				{
					"click": "#motion-side"
				},
				{
					"expect": {
						"state": "deck.slides[0].animations[0].direction",
						"is": "bottom"
					}
				}
			]
		},
		{
			"name": "sinopia-export-every-slide-as-pictures",
			"note": "File, All Slides writes a numbered PNG for every slide in the show (the hidden one left out)",
			"steps": [
				{
					"click": "#tab-file-label"
				},
				{
					"choose": "deck.png"
				},
				{
					"click": "#b-export-pngs"
				},
				{
					"wait": 0
				},
				{
					"expect": {
						"state": "fileStatus",
						"is": "Exported 6 pictures, from deck-1.png."
					}
				}
			]
		}
	]
}
