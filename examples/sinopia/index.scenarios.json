{
	"$schema": "../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "Sinopia's checks: affrescoui test index.scenarios.json. The presenter's clock reads the wall clock, so its frames are checked by their nodes and state, not by pictures.",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "sinopia-load-the-sample",
			"note": "The sample deck loads: seven slides in two sections, the first picked, its thumbnails listed",
			"steps": [
				{ "wait": 0},
				{ "expect": { "state": "deck.title", "is": "Harbour Lights" } },
				{ "expect": { "state": "deck.slides.length", "is": 7} },
				{ "expect": { "state": "deck.sections.length", "is": 2} },
				{ "expect": { "state": "current", "is": 0} },
				{ "expect": { "node": "#thumb-s1-row", "exists": true} },
				{ "expect": { "node": "#thumb-s7-row", "exists": true} },
				{ "expect": { "node": "#o1", "exists": true} },
				{ "expect": { "node": "#status-slide", "text": "Slide 1 of 7" } }
			]
		},
		{
			"name": "sinopia-pick-a-slide",
			"note": "A thumbnail click picks its slide; the arrows move through the list from there",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "expect": { "state": "current", "is": 3} },
				{ "expect": { "node": "#status-slide", "text": "Slide 4 of 7" } },
				{ "expect": { "node": "#o9", "exists": true} },
				{ "wait": 0},
				{ "key": "down" },
				{ "expect": { "state": "current", "is": 4} },
				{ "key": "up" },
				{ "key": "up" },
				{ "expect": { "state": "current", "is": 2} },
				{ "key": "pageup" },
				{ "key": "pageup" },
				{ "key": "pageup" },
				{ "expect": { "state": "current", "is": 0} }
			]
		},
		{
			"name": "sinopia-add-a-shape",
			"note": "A shape from the gallery lands in the middle of the slide, selected, and undo takes it away",
			"steps": [
				{ "click": "#gal-shape-ellipse" },
				{ "expect": { "state": "deck.slides[0].objects.length", "is": 3} },
				{ "expect": { "state": "deck.slides[0].objects[2].kind", "is": "shape" } },
				{ "expect": { "state": "deck.slides[0].objects[2].shape", "is": "ellipse" } },
				{ "expect": { "state": "board.selection[0]", "is": "o40" } },
				{ "expect": { "state": "deck.next", "is": 41} },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[0].objects.length", "is": 2} }
			]
		},
		{
			"name": "sinopia-add-a-text-box",
			"note": "Insert, Text Box: a text object saying Text, selected",
			"steps": [
				{ "click": "#tab-insert-label" },
				{ "click": "#b-ins-textbox" },
				{ "expect": { "state": "deck.slides[0].objects.length", "is": 3} },
				{ "expect": { "state": "deck.slides[0].objects[2].kind", "is": "text" } },
				{ "expect": { "state": "deck.slides[0].objects[2].text", "is": "Text" } },
				{ "expect": { "state": "board.selection[0]", "is": "o40" } }
			]
		},
		{
			"name": "sinopia-format-fill-and-line",
			"note": "The format pane paints the selected shape's fill and line from the theme and thickens the line",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "click": "#tab-view-label" },
				{ "click": "#b-format-pane" },
				{ "expect": { "state": "formatPane", "is": true} },
				{ "expect": { "node": "#format-title", "text": "Format Shape" } },
				{ "click": "#format-fill-accent3" },
				{ "expect": { "state": "deck.slides[3].objects[1].fill", "is": "accent3" } },
				{ "click": "#format-line-dark1" },
				{ "expect": { "state": "deck.slides[3].objects[1].line", "is": "dark1" } },
				{ "click": "#format-line-width-more" },
				{ "expect": { "state": "deck.slides[3].objects[1].lineWidth", "is": 1.5} },
				{ "click": "#format-fill-none" },
				{ "expect": { "state": "deck.slides[3].objects[1].fill", "is": "none" } },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[3].objects[1].fill", "is": "accent3" } }
			]
		},
		{
			"name": "sinopia-format-size-and-rotation",
			"note": "The format pane's steppers size, place and turn the selected shape",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "click": "#tab-view-label" },
				{ "click": "#b-format-pane" },
				{ "expect": { "node": "#format-w-value", "text": "210.0" } },
				{ "click": "#format-w-more" },
				{ "expect": { "state": "deck.slides[3].objects[1].w", "is": 220} },
				{ "click": "#format-h-less" },
				{ "expect": { "state": "deck.slides[3].objects[1].h", "is": 80} },
				{ "click": "#format-x-more" },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 76} },
				{ "click": "#format-rotate-more" },
				{ "click": "#format-rotate-more" },
				{ "expect": { "state": "deck.slides[3].objects[1].rotate", "is": 30} },
				{ "expect": { "node": "#format-rotate-value", "text": "30.0°" } }
			]
		},
		{
			"name": "sinopia-delete-and-undo",
			"note": "Delete removes the selected shape and its build; undo brings both back, redo removes them again",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "key": "delete" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 6} },
				{ "expect": { "state": "deck.slides[3].animations.length", "is": 3} },
				{ "expect": { "node": "#o9", "exists": false} },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 7} },
				{ "expect": { "state": "deck.slides[3].animations.length", "is": 4} },
				{ "expect": { "node": "#o9", "exists": true} },
				{ "key": "mod+y" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 6} }
			]
		},
		{
			"name": "sinopia-duplicate-an-object",
			"note": "Ctrl+D copies the selection a little down and right and selects the copy; copy and paste do too",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "key": "mod+d" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 8} },
				{ "expect": { "state": "deck.slides[3].objects[7].x", "is": 84} },
				{ "expect": { "state": "deck.slides[3].objects[7].y", "is": 218} },
				{ "expect": { "state": "deck.slides[3].objects[7].fill", "is": "accent1" } },
				{ "expect": { "state": "board.selection[0]", "is": "o40" } },
				{ "key": "mod+c" },
				{ "key": "mod+v" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 9} },
				{ "expect": { "state": "deck.slides[3].objects[8].x", "is": 102} }
			]
		},
		{
			"name": "sinopia-arrange-order",
			"note": "Arrange's menu moves the selected shape in the drawing order: to the front, one back, to the back, one forward",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "expect": { "state": "deck.slides[3].objects[6].id", "is": "o14" } },
				{ "click": "#b-arrange" },
				{ "expect": { "state": "arrangeMenu.open", "is": true } },
				{ "click": { "role": "menuitem", "name": "Bring to Front" } },
				{ "expect": { "state": "deck.slides[3].objects[6].id", "is": "o9" } },
				{ "expect": { "state": "deck.slides[3].objects[1].id", "is": "o10" } },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Send Backward" } },
				{ "expect": { "state": "deck.slides[3].objects[5].id", "is": "o9" } },
				{ "expect": { "state": "deck.slides[3].objects[6].id", "is": "o14" } },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Send to Back" } },
				{ "expect": { "state": "deck.slides[3].objects[0].id", "is": "o9" } },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Bring Forward" } },
				{ "expect": { "state": "deck.slides[3].objects[0].id", "is": "o8" } },
				{ "expect": { "state": "deck.slides[3].objects[1].id", "is": "o9" } },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[3].objects[0].id", "is": "o9" } }
			]
		},
		{
			"name": "sinopia-align-and-distribute",
			"note": "One shape aligns to the slide, several to the box around them; distribute leaves equal gaps; the arrow keys nudge",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Align Right" } },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 750 } },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Align Center" } },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 375 } },
				{ "key": "mod+z" },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 66 } },
				{ "click": "#o9" },
				{ "key": "right" },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 67 } },
				{ "key": "shift+down" },
				{ "expect": { "state": "deck.slides[3].objects[1].y", "is": 210 } },
				{ "key": "mod+z" },
				{ "key": "mod+z" },
				{ "key": "mod+a" },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Align Bottom" } },
				{ "expect": { "state": "deck.slides[3].objects[1].y", "is": 346 } },
				{ "expect": { "state": "deck.slides[3].objects[0].y", "is": 331 } },
				{ "expect": { "state": "deck.slides[3].objects[5].y", "is": 352 } },
				{ "key": "mod+z" },
				{ "click": "#o10" },
				{ "key": "shift+right" },
				{ "key": "shift+right" },
				{ "key": "shift+right" },
				{ "expect": { "state": "deck.slides[3].objects[2].x", "is": 300 } },
				{ "click": "#o13" },
				{ "key": "delete" },
				{ "click": "#o14" },
				{ "key": "delete" },
				{ "click": "#o8" },
				{ "key": "delete" },
				{ "expect": { "state": "deck.slides.length", "is": 7 } },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 4 } },
				{ "key": "mod+a" },
				{ "click": "#b-arrange" },
				{ "click": { "role": "menuitem", "name": "Distribute Horizontally" } },
				{ "expect": { "state": "deck.slides[3].objects[0].x", "is": 66 } },
				{ "expect": { "state": "deck.slides[3].objects[1].x", "is": 270 } },
				{ "expect": { "state": "deck.slides[3].objects[3].x", "is": 678 } }
			]
		},
		{
			"name": "sinopia-lock-an-object",
			"note": "A locked shape survives Delete and keeps its place; unlocked, it goes",
			"steps": [
				{ "click": "#thumb-s4-row" },
				{ "click": "#o9" },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "click": "#tab-view-label" },
				{ "click": "#b-format-pane" },
				{ "click": "#format-lock" },
				{ "expect": { "state": "deck.slides[3].objects[1].locked", "is": true} },
				{ "expect": { "node": "#format-lock", "text": " Locked" } },
				{ "key": "delete" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 7} },
				{ "expect": { "state": "board.selection[0]", "is": "o9" } },
				{ "click": "#format-lock" },
				{ "expect": { "state": "deck.slides[3].objects[1].locked", "is": false} },
				{ "key": "delete" },
				{ "expect": { "state": "deck.slides[3].objects.length", "is": 6} }
			]
		},
		{
			"name": "sinopia-add-an-animation",
			"note": "Motion gives the selected subtitle a fade on a click, then starts it with the previous and lengthens it",
			"steps": [
				{ "click": "#o2" },
				{ "click": "#tab-animations-label" },
				{ "click": "#fx-fade" },
				{ "expect": { "state": "deck.slides[0].animations.length", "is": 1} },
				{ "expect": { "state": "deck.slides[0].animations[0].target", "is": "o2" } },
				{ "expect": { "state": "deck.slides[0].animations[0].effect", "is": "fade" } },
				{ "expect": { "state": "deck.slides[0].animations[0].start", "is": "click" } },
				{ "expect": { "node": "#motion-count", "text": "1 on this slide, 1 on a click" } },
				{ "click": "#motion-start-with" },
				{ "expect": { "state": "deck.slides[0].animations[0].start", "is": "with" } },
				{ "click": "#motion-longer" },
				{ "expect": { "state": "deck.slides[0].animations[0].ms", "is": 750} },
				{ "click": "#b-exit" },
				{ "expect": { "state": "deck.slides[0].animations[0].kind", "is": "exit" } },
				{ "click": "#fx-none" },
				{ "expect": { "state": "deck.slides[0].animations.length", "is": 0} }
			]
		},
		{
			"name": "sinopia-new-duplicate-delete-slide",
			"note": "New Slide adds one after the current, a duplicate copies it with new ids, Delete removes it",
			"steps": [
				{ "click": "#b-new-slide" },
				{ "expect": { "state": "deck.slides.length", "is": 8} },
				{ "expect": { "state": "current", "is": 1} },
				{ "expect": { "state": "deck.slides[1].layout", "is": "content" } },
				{ "expect": { "state": "deck.slides[1].id", "is": "s40" } },
				{ "key": "mod+m" },
				{ "expect": { "state": "deck.slides.length", "is": 9} },
				{ "expect": { "state": "current", "is": 2} },
				{ "click": "#thumb-s4-row" },
				{ "action": "duplicateSlide" },
				{ "expect": { "state": "deck.slides.length", "is": 10} },
				{ "expect": { "state": "current", "is": 6} },
				{ "expect": { "state": "deck.slides[6].objects.length", "is": 7} },
				{ "expect": { "state": "deck.slides[6].layout", "is": "titleOnly" } },
				{ "action": "deleteSlide" },
				{ "expect": { "state": "deck.slides.length", "is": 9} },
				{ "expect": { "state": "current", "is": 6} },
				{ "expect": { "state": "deck.slides[5].id", "is": "s4" } },
				{ "expect": { "state": "deck.slides[6].id", "is": "s5" } },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides.length", "is": 10} }
			]
		},
		{
			"name": "sinopia-slide-transition",
			"note": "Transitions sets the slide's kind, its duration and direction, and applies it to every slide",
			"steps": [
				{ "click": "#tab-transitions-label" },
				{ "click": "#tr-wipe" },
				{ "expect": { "state": "deck.slides[0].transition.kind", "is": "wipe" } },
				{ "click": "#timing-longer" },
				{ "expect": { "state": "deck.slides[0].transition.ms", "is": 950} },
				{ "expect": { "node": "#timing-duration", "text": " Duration: 0.95" } },
				{ "click": "#b-effect-options" },
				{ "expect": { "state": "deck.slides[0].transition.direction", "is": "up" } },
				{ "click": "#timing-apply" },
				{ "expect": { "state": "deck.slides[3].transition.kind", "is": "wipe" } },
				{ "expect": { "state": "deck.slides[6].transition.ms", "is": 950} },
				{ "click": "#tr-none" },
				{ "expect": { "state": "deck.slides[0].transition.kind", "is": "none" } }
			]
		},
		{
			"name": "sinopia-hide-a-slide",
			"note": "Hide Slide leaves a slide out of the show and veils its thumbnail; again brings it back",
			"steps": [
				{ "click": "#thumb-s2-row" },
				{ "click": "#tab-slideShow-label" },
				{ "click": "#b-hide-slide" },
				{ "expect": { "state": "deck.slides[1].hidden", "is": true} },
				{ "expect": { "node": "#thumb-s2-veil", "exists": true} },
				{ "click": "#b-hide-slide" },
				{ "expect": { "state": "deck.slides[1].hidden", "is": false} },
				{ "expect": { "node": "#thumb-s2-veil", "exists": false} }
			]
		},
		{
			"name": "sinopia-speaker-notes",
			"note": "The notes under the slide are the slide's: typed into, hidden and shown",
			"steps": [
				{ "click": "#thumb-s6-row" },
				{ "expect": { "node": "#notes-placeholder", "text": "Click to add notes" } },
				{ "click": "#notes" },
				{ "wait": 0},
				{ "type": "Thank the volunteers." },
				{ "expect": { "state": "deck.slides[5].notes", "is": "Thank the volunteers." } },
				{ "expect": { "node": "#notes-placeholder", "text": "" } },
				{ "click": "#status-notes" },
				{ "expect": { "state": "notes", "is": false} },
				{ "expect": { "node": "#notes", "exists": false} },
				{ "click": "#status-notes" },
				{ "expect": { "node": "#notes", "exists": true} }
			]
		},
		{
			"name": "sinopia-outline-view",
			"note": "Outline View lists the slides' text in place of the thumbnails; a click picks a slide",
			"steps": [
				{ "click": "#tab-view-label" },
				{ "click": "#b-outline-view" },
				{ "expect": { "state": "view", "is": "outline" } },
				{ "expect": { "node": "#thumbnails", "exists": false} },
				{ "expect": { "node": "#outline-s1-text", "text": "Harbour Lights\nA winter festival on the waterfront\nPlanning review · Spring" } },
				{ "click": "#outline-s4" },
				{ "expect": { "state": "current", "is": 3} },
				{ "expect": { "node": "#status-slide", "text": "Slide 4 of 7" } },
				{ "wait": 0},
				{ "key": "down" },
				{ "expect": { "state": "current", "is": 4} },
				{ "click": "#b-normal" },
				{ "expect": { "node": "#thumbnails", "exists": true} }
			]
		},
		{
			"name": "sinopia-sorter-view",
			"note": "Slide Sorter shows every slide in a grid; a click picks one, Enter opens it",
			"steps": [
				{ "click": "#status-sorter" },
				{ "expect": { "state": "view", "is": "sorter" } },
				{ "expect": { "node": "#board", "exists": false} },
				{ "expect": { "node": "#sorter-s7-hidden", "exists": true} },
				{ "click": "#sorter-s5" },
				{ "expect": { "state": "current", "is": 4} },
				{ "wait": 0},
				{ "key": "right" },
				{ "expect": { "state": "current", "is": 5} },
				{ "key": "enter" },
				{ "expect": { "state": "view", "is": "normal" } },
				{ "expect": { "node": "#board", "exists": true} }
			]
		},
		{
			"name": "sinopia-sorter-drag-to-reorder",
			"note": "In the sorter a slide dragged onto another moves there",
			"steps": [
				{ "click": "#status-sorter" },
				{ "drag": "#sorter-s1", "to": "#sorter-s3" },
				{ "expect": { "state": "deck.slides[2].id", "is": "s1" } },
				{ "expect": { "state": "deck.slides[0].id", "is": "s2" } },
				{ "expect": { "state": "current", "is": 2} },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides[0].id", "is": "s1" } }
			]
		},
		{
			"name": "sinopia-dark-mode",
			"note": "Dark Mode turns the window dark and leaves the slides as they are",
			"steps": [
				{ "click": "#tab-view-label" },
				{ "click": "#b-dark" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "expect": { "node": "#main", "property": "color", "is": "#18171d" } },
				{ "click": "#b-dark" },
				{ "expect": { "state": "theme", "is": "light" } },
				{ "expect": { "node": "#main", "property": "color", "is": "#e5e5eb" } }
			]
		},
		{
			"name": "sinopia-export-pdf",
			"note": "File, PDF writes a page for every slide in the show (the hidden one left out)",
			"steps": [
				{ "click": "#tab-file-label" },
				{ "choose": "deck.pdf" },
				{ "click": "#b-export-pdf" },
				{ "wait": 0},
				{ "expect": { "state": "fileStatus", "is": "Exported deck.pdf, 6 pages." } },
				{ "choose": null},
				{ "click": "#b-export-pdf" },
				{ "wait": 0},
				{ "expect": { "state": "fileStatus", "is": "Exported deck.pdf, 6 pages." } }
			]
		},
		{
			"name": "sinopia-save-and-open",
			"note": "The deck saves as JSON and opens again, as an undoable change; a file that isn't a deck is refused",
			"steps": [
				{ "choose": "deck.json" },
				{ "key": "mod+s" },
				{ "wait": 0},
				{ "expect": { "state": "fileStatus", "is": "Saved deck.json." } },
				{ "action": "deleteSlide" },
				{ "expect": { "state": "deck.slides.length", "is": 6} },
				{ "click": "#tab-file-label" },
				{ "click": "#b-open" },
				{ "wait": 0},
				{ "expect": { "state": "deck.slides.length", "is": 7} },
				{ "expect": { "state": "fileStatus", "is": "Opened deck.json." } },
				{ "expect": { "state": "current", "is": 0} },
				{ "expect": { "state": "opened", "is": null} },
				{ "key": "mod+z" },
				{ "expect": { "state": "deck.slides.length", "is": 6} }
			]
		},
		{
			"name": "sinopia-present-and-step",
			"note": "The show starts from the first slide; a click or an arrow plays the slide's builds, then the next slide",
			"steps": [
				{ "click": "#present-button" },
				{ "expect": { "state": "show.on", "is": true} },
				{ "expect": { "state": "show.index", "is": 0} },
				{ "expect": { "node": "#show-view", "exists": true} },
				{ "wait": 800},
				{ "expect": { "state": "show.t", "is": 1} },
				{ "key": "right" },
				{ "expect": { "state": "show.index", "is": 1} },
				{ "wait": 700},
				{ "key": "space" },
				{ "expect": { "state": "show.index", "is": 1} },
				{ "expect": { "state": "show.step", "is": 1} },
				{ "key": "right" },
				{ "expect": { "state": "show.index", "is": 2} },
				{ "key": "left" },
				{ "expect": { "state": "show.index", "is": 1} },
				{ "key": "escape" },
				{ "expect": { "state": "show.on", "is": false} },
				{ "expect": { "state": "current", "is": 1} }
			]
		},
		{
			"name": "sinopia-present-skips-and-blacks",
			"note": "The show skips a hidden slide; B and W blank the screen black or white and back",
			"steps": [
				{ "click": "#thumb-s6-row" },
				{ "key": "shift+f5" },
				{ "expect": { "state": "show.index", "is": 5} },
				{ "key": "right" },
				{ "expect": { "state": "show.ended", "is": true} },
				{ "expect": { "node": "#show-ended", "exists": true} },
				{ "key": "b" },
				{ "expect": { "state": "show.black", "is": true} },
				{ "key": "b" },
				{ "expect": { "state": "show.black", "is": false} },
				{ "key": "w" },
				{ "expect": { "state": "show.white", "is": true} },
				{ "key": "period" },
				{ "expect": { "state": "show.white", "is": false} },
				{ "expect": { "state": "show.black", "is": true} },
				{ "key": "right" },
				{ "expect": { "state": "show.on", "is": false} }
			]
		},
		{
			"name": "sinopia-present-ends-at-the-end",
			"note": "End jumps to the last slide built; one more step ends the show on the last slide",
			"steps": [
				{ "key": "f5" },
				{ "key": "end" },
				{ "expect": { "state": "show.index", "is": 5} },
				{ "expect": { "state": "show.step", "is": 0} },
				{ "key": "right" },
				{ "expect": { "state": "show.ended", "is": true} },
				{ "key": "right" },
				{ "expect": { "state": "show.on", "is": false} },
				{ "expect": { "state": "current", "is": 5} },
				{ "expect": { "node": "#show-view", "exists": false} }
			]
		},
		{
			"name": "sinopia-presenting-keys-off-when-editing",
			"note": "With the show off, its keys don't play: the arrows and B leave the deck alone",
			"steps": [
				{ "click": "#o2" },
				{ "key": "n" },
				{ "key": "b" },
				{ "key": "w" },
				{ "expect": { "state": "show.on", "is": false} },
				{ "expect": { "state": "show.black", "is": false} },
				{ "expect": { "state": "current", "is": 0} },
				{ "key": "f5" },
				{ "expect": { "state": "show.on", "is": true} },
				{ "key": "escape" },
				{ "expect": { "state": "show.on", "is": false} }
			]
		},
		{
			"name": "sinopia-presenter-view",
			"note": "With Presenter View on, the show opens in a window of its own and this one shows the notes, the next slide and a timer",
			"steps": [
				{ "click": "#tab-slideShow-label" },
				{ "click": "#cb-presenter-caption" },
				{ "expect": { "state": "presenterView", "is": true} },
				{ "click": "#b-from-start" },
				{ "expect": { "state": "show.on", "is": true} },
				{ "expect": { "node": "#presenter-current", "exists": true} },
				{ "expect": { "node": "#presenter-notes-box", "exists": true} },
				{ "expect": { "node": "#presenter-notes", "text": "Welcome everyone. Two minutes on why we are doing this, then the plan." } },
				{ "click": "#presenter-forward" },
				{ "expect": { "state": "show.index", "is": 1} },
				{ "click": "#presenter-notes-larger" },
				{ "expect": { "state": "show.notesSize", "is": 20} },
				{ "click": "#presenter-end" },
				{ "expect": { "state": "show.on", "is": false} },
				{ "expect": { "node": "#presenter-current", "exists": false} }
			]
		},
		{
			"name": "sinopia-present-from-current",
			"note": "Start and the status bar's button present from the slide being edited",
			"steps": [
				{ "click": "#thumb-s3-row" },
				{ "click": "#status-show" },
				{ "expect": { "state": "show.on", "is": true} },
				{ "expect": { "state": "show.index", "is": 2} },
				{ "key": "escape" },
				{ "click": "#thumb-s5-row" },
				{ "click": "#qat-present" },
				{ "expect": { "state": "show.index", "is": 0} },
				{ "key": "escape" },
				{ "expect": { "state": "current", "is": 0} }
			]
		},
		{
			"name": "sinopia-the-sorter",
			"note": "The sample deck in the sorter, every slide in a grid in place of the canvas (the gallery's scene, tools/media/gallery.json)",
			"steps": [
				{ "wait": 400},
				{ "click": "#status-sorter" },
				{ "wait": 0},
				{ "expect": { "state": "view", "is": "sorter" } },
				{ "expect": { "node": "#sorter-grid", "exists": true} }
			]
		}
	]
}
