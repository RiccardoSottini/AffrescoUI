{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Sinopia, a presentation editor, written only in the format: the deck lives in state.deck (parts/sample-deck.json), its themes and layouts in parts/themes.json, its shapes in parts/geometry.json, and every slide is drawn by parts/slide.json, in the thumbnails and on the canvas alike. The ribbon is parts/ribbon.json and parts/tabs.json; editing is parts/edit.json.",

	"include": ["parts/themes.json", "parts/geometry.json", "parts/slide.json", "parts/sample-deck.json", "parts/edit.json", "parts/ribbon.json", "parts/tabs.json", "parts/show.json", "parts/views.json", "../shared/addons/assistant/assistant.json"],

	"theme": "{{state.theme}}",

	"window": { "title": "Sinopia", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 },

	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["icons"] },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 12 }
	},

	"colors": {
		"brand": { "light": "#4b3fa8", "dark": "#7a6fe0" },
		"brandLine": { "light": "#4b3fa8", "dark": "#8f85ee" },
		"brandHover": { "light": "#5d51c0", "dark": "#8a80ea" },
		"onBrand": { "light": "#ffffff", "dark": "#ffffff" },
		"titleBar": { "light": "#e8e7f1", "dark": "#1f1e26" },
		"titleInk": { "light": "#2a2740", "dark": "#e9e8f2" },
		"titleHover": { "light": "#d9d7e8", "dark": "#33313e" },
		"rb": { "light": "#f5f5f9", "dark": "#2a2932" },
		"rbInk": { "light": "#25232f", "dark": "#ecebf3" },
		"rbMuted": { "light": "#5e5c6f", "dark": "#a8a6b8" },
		"rbHover": { "light": "#e6e5ef", "dark": "#3a3845" },
		"rbPressed": { "light": "#d5d3e4", "dark": "#464453" },
		"rbChecked": { "light": "#e0ddf3", "dark": "#45406a" },
		"rbCheckedHover": { "light": "#d2cfec", "dark": "#514b7a" },
		"rbDisabled": { "light": "#a7a5b6", "dark": "#6c6a7b" },
		"rbFieldBg": { "light": "#ffffff", "dark": "#1d1c23" },
		"rbFieldLine": { "light": "#cac8d8", "dark": "#4a4857" },
		"rbFieldHover": { "light": "#5e5c6f", "dark": "#a8a6b8" },
		"rbLine": { "light": "#dad8e4", "dark": "#3d3b48" },
		"work": { "light": "#e5e5eb", "dark": "#18171d" },
		"thumbLine": { "light": "#cac8d8", "dark": "#4a4857" },
		"thumbHover": { "light": "#aeabc6", "dark": "#5d5873" },
		"notes": { "light": "#ffffff", "dark": "#202027" },
		"barLine": { "light": "#dad8e4", "dark": "#3d3b48" },
		"handles": { "light": "#4b3fa8", "dark": "#8f85ee" },
		"barInk": { "light": "#3e3c4d", "dark": "#d6d4e2" },
		"faint": { "light": "#8a8a8a", "dark": "#8d8b9c" }
	},

	"tokens": {
		"assistant.accent": "@brand", "assistant.accentHover": "@brandHover", "assistant.onAccent": "@onBrand",
		"assistant.surface": "@rbFieldBg", "assistant.raised": "@rb", "assistant.border": "@rbLine", "assistant.text": "@rbInk",
		"assistant.dim": "@rbMuted", "assistant.dot": "@rbDisabled", "assistant.warningBackground": "@work"
	},

	"styles": {
		"tab": {
			"type": "label", "height": 36, "fitText": true, "padding": 10, "radius": 14, "color": "transparent", "textColor": "@rbInk", "cursor": "hand",
			"focusable": true, "role": "tab", "hover": { "color": "@rbHover" }
		},
		"titleButton": {
			"type": "label", "width": 32, "height": 32, "radius": 8, "align": "center", "color": "transparent", "textColor": "@titleInk", "cursor": "hand",
			"focusable": true, "hover": { "color": "@titleHover" }
		},
		"barButton": {
			"type": "label", "height": 22, "fitText": true, "padding": 4, "radius": 6, "color": "transparent", "textColor": "@barInk", "cursor": "hand",
			"hover": { "color": "@rbHover" }
		},
		"barButtonOn": { "style": "barButton", "color": "@rbChecked" },
		"pillButton": {
			"type": "label", "height": 28, "fitText": true, "padding": 10, "radius": 14, "color": "@rbFieldBg", "borderWidth": 1, "borderColor": "@rbFieldLine",
			"textColor": "@rbInk", "cursor": "hand", "hover": { "color": "@rbHover" }
		}
	},

	"permissions": {
		"allow": ["studio"],
		"ask": ["agent"],
		"reviewers": ["studio"]
	},

	"state": {
		"current": 0,
		"theme": "light",
		"tab": "home",
		"view": "normal",
		"notes": true,
		"ruler": false,
		"gridlines": false,
		"guides": false,
		"fit": true,
		"popup": "",
		"board": { "camera": { "x": 0, "y": 0, "zoom": 1 }, "selection": [], "guides": { "vertical": [], "horizontal": [] } }
	},

	"persist": ["state.deck", "state.theme", "state.presenterView"],

	"computed": {
		"tabs": [
			{ "id": "file", "title": "File" }, { "id": "home", "title": "Home" }, { "id": "insert", "title": "Insert" }, { "id": "draw", "title": "Ink" },
			{ "id": "design", "title": "Design" }, { "id": "transitions", "title": "Transitions" }, { "id": "animations", "title": "Motion" },
			{ "id": "slideShow", "title": "Present" }, { "id": "record", "title": "Record" }, { "id": "review", "title": "Check" },
			{ "id": "view", "title": "View" }, { "id": "help", "title": "Help" }
		],
		"canvasWidth": "{{max(window.width - (state.view == 'outline' ? 300 : 200) - (state.formatPane ? 260 : 0), 100)}}",
		"canvasHeight": "{{max(window.height - 40 - 36 - 96 - 24 - (state.notes ? 77 : 0), 100)}}",
		"fitZoom": "{{min((computed.canvasWidth - 56) / 960, (computed.canvasHeight - 40) / 540)}}",
		"fitCamera": "{{ {x: 480 - computed.canvasWidth / (2 * computed.fitZoom), y: 270 - computed.canvasHeight / (2 * computed.fitZoom), zoom: computed.fitZoom} }}",
		"view": "{{state.fit ? merge(state.board, {camera: computed.fitCamera}) : state.board}}",
		"zoom": "{{computed.view.camera.zoom}}",
		"slideTitle": "{{trim(split(find(computed.objects, it.ph == 'title' || it.ph == 'ctrTitle').text ?? '', '\n')[0])}}",
		"sectionFirsts": "{{map(state.deck.sections ?? [], it.first)}}",
		"sectionAt": "{{map(state.deck.slides, indexOf(computed.sectionFirsts, index) < 0 ? null : state.deck.sections[indexOf(computed.sectionFirsts, index)])}}"
	},

	"actions": {
		"fit": [{ "set": "state.fit", "to": true }],
		"zoomBy": [
			{ "set": "state.board", "to": "{{merge(computed.view, {camera: {x: computed.view.camera.x + computed.canvasWidth / 2 / computed.zoom - computed.canvasWidth / 2 / clamp(computed.zoom * by, 0.1, 4), y: computed.view.camera.y + computed.canvasHeight / 2 / computed.zoom - computed.canvasHeight / 2 / clamp(computed.zoom * by, 0.1, 4), zoom: clamp(computed.zoom * by, 0.1, 4)}})}}" },
			{ "set": "state.fit", "to": false }
		],
		"viewChanged": [
			{ "set": "state.board", "to": "{{view}}" },
			{ "if": "{{abs(view.camera.zoom - computed.fitCamera.zoom) > 0.0001 || abs(view.camera.x - computed.fitCamera.x) > 0.01 || abs(view.camera.y - computed.fitCamera.y) > 0.01}}",
			  "then": [{ "set": "state.fit", "to": false }] }
		]
	},

	"keys": {
		"mod+z": [{ "when": "{{!context.textInputFocus}}", "do": "undo" }],
		"mod+y": [{ "when": "{{!context.textInputFocus}}", "do": "redo" }],
		"mod+shift+z": [{ "when": "{{!context.textInputFocus}}", "do": "redo" }],
		"mod+m": [{ "when": "{{!context.textInputFocus}}", "do": "newSlide", "with": { "layout": "content" } }],
		"mod+d": [{ "when": "{{!context.textInputFocus && length(computed.selected) > 0}}", "do": "duplicateObjects" }],
		"mod+c": [{ "when": "{{!context.textInputFocus}}", "do": "copyObjects" }],
		"mod+x": [{ "when": "{{!context.textInputFocus}}", "do": "cutObjects" }],
		"mod+v": [{ "when": "{{!context.textInputFocus}}", "do": "pasteObjects" }],
		"mod+a": [{ "when": "{{!context.textInputFocus}}", "do": "selectAll" }],
		"mod+b": [{ "when": "{{!context.textInputFocus}}", "do": "toggleText", "with": { "key": "bold" } }],
		"mod+i": [{ "when": "{{!context.textInputFocus}}", "do": "toggleText", "with": { "key": "italic" } }],
		"mod+u": [{ "when": "{{!context.textInputFocus}}", "do": "toggleText", "with": { "key": "underline" } }],
		"mod+l": [{ "when": "{{!context.textInputFocus}}", "do": "setObjects", "with": { "props": { "align": "left" } } }],
		"mod+e": [{ "when": "{{!context.textInputFocus}}", "do": "setObjects", "with": { "props": { "align": "center" } } }],
		"mod+r": [{ "when": "{{!context.textInputFocus}}", "do": "setObjects", "with": { "props": { "align": "right" } } }],
		"mod+j": [{ "when": "{{!context.textInputFocus}}", "do": "setObjects", "with": { "props": { "align": "justify" } } }],
		"mod+shift+.": [{ "when": "{{!context.textInputFocus}}", "do": "growText", "with": { "by": 1 } }],
		"mod+shift+,": [{ "when": "{{!context.textInputFocus}}", "do": "growText", "with": { "by": -1 } }],
		"delete": [{ "when": "{{!context.textInputFocus && length(computed.selected) > 0}}", "do": "deleteObjects" }],
		"backspace": [{ "when": "{{state.show.on}}", "do": "showPrevious" }, { "when": "{{!context.textInputFocus && length(computed.selected) > 0}}", "do": "deleteObjects" }],
		"escape": [{ "when": "{{state.show.on}}", "do": "showEnd" }, { "when": "{{!context.textInputFocus && length(state.board.selection) > 0}}", "do": [{ "set": "state.board.selection", "to": [] }] }]
	},

	"root": {
		"id": "root", "color": "@work",
		"children": [{
		"type": "column", "id": "window", "fill": 0, "color": "@work", "alignItems": "stretch",
		"children": [
			{
				"id": "title-bar", "height": 40, "color": "@titleBar",
				"children": [
					{ "type": "row", "id": "title-left", "x": 0, "y": 0, "height": 40, "fitContent": "width", "gap": 2, "alignItems": "center", "color": "transparent",
					  "children": [
						{ "type": "label", "id": "app-mark", "width": 40, "height": 40, "align": "center", "textColor": "@brand", "runs": [{ "icon": "gallery-vertical-end", "size": 18 }] },
						{ "type": "label", "id": "autosave", "height": 32, "fitText": true, "padding": 6, "textColor": "@titleInk", "runs": [{ "text": "Keep saved ", "size": 12 }] },
						{ "id": "autosave-switch", "width": 34, "height": 16, "radius": 8, "color": "transparent", "borderWidth": 1, "borderColor": "@rbMuted", "cursor": "hand",
						  "tooltip": "Keeps the deck saved on this computer as you work",
						  "children": [{ "id": "autosave-knob", "x": 4, "y": 4, "width": 8, "height": 8, "radius": 4, "color": "@rbMuted" }] },
						{ "type": "label", "id": "autosave-state", "height": 32, "fitText": true, "padding": 4, "textColor": "@titleInk", "runs": [{ "text": "Off", "size": 12 }] },
						{ "type": "label", "id": "qat-save", "style": "titleButton", "runs": [{ "icon": "save", "size": 16 }], "tooltip": "Save (Ctrl+S)", "onClick": "saveDeck" },
						{ "type": "label", "id": "qat-undo", "style": "titleButton", "width": 40, "runs": [{ "icon": "undo-2", "size": 16 }, { "text": " ", "size": 8 }, { "icon": "chevron-down", "size": 9 }],
						  "textColor": "{{computed.canUndo ? '@titleInk' : '#2a274066'}}", "tooltip": "Undo (Ctrl+Z)", "onClick": "undo" },
						{ "type": "label", "id": "qat-redo", "style": "titleButton", "runs": [{ "icon": "redo-2", "size": 16 }],
						  "textColor": "{{computed.canRedo ? '@titleInk' : '#2a274066'}}", "tooltip": "Redo (Ctrl+Y)", "onClick": "redo" },
						{ "type": "label", "id": "qat-present", "style": "titleButton", "runs": [{ "icon": "projector", "size": 16 }], "tooltip": "Present from the start (F5)",
						  "onClick": { "run": "present", "with": { "from": 0 } } },
						{ "type": "label", "id": "qat-more", "style": "titleButton", "width": 22, "runs": [{ "icon": "chevron-down", "size": 11 }], "tooltip": "More quick commands" },
						{ "type": "label", "id": "doc-title", "height": 32, "fitText": true, "padding": 8, "radius": 8, "textColor": "@titleInk", "cursor": "hand", "hover": { "color": "@titleHover" },
						  "runs": [{ "text": "{{state.deck.title}}", "size": 12 }, { "text": "  ·  On this computer ", "size": 12 }, { "icon": "chevron-down", "size": 9 }] }
					  ] },
					{ "id": "search", "y": 6, "height": 28, "width": "{{clamp(window.width * 0.3, 200, 460)}}", "x": "{{(window.width - clamp(window.width * 0.3, 200, 460)) / 2 + 120}}",
					  "radius": 14, "color": "#ffffff", "borderWidth": 1, "borderColor": "@rbFieldLine", "cursor": "ibeam",
					  "children": [{ "type": "label", "id": "search-text", "fill": 0, "padding": 12, "textColor": "#5e5c6f", "runs": [{ "icon": "search", "size": 14 }, { "text": "  Search commands and slides", "size": 12 }] }] },
					{ "type": "row", "id": "title-right", "anchors": { "right": 8 }, "y": 0, "height": 40, "width": 80, "gap": 6, "justify": "end", "alignItems": "center", "color": "transparent",
					  "children": [
						{ "type": "label", "id": "coauthor", "style": "titleButton", "runs": [{ "icon": "lightbulb", "size": 16 }], "tooltip": "Suggestions" },
						{ "type": "label", "id": "account", "width": 28, "height": 28, "radius": 14, "align": "center", "color": "@brand", "textColor": "@onBrand", "runs": [{ "icon": "user", "size": 15 }], "tooltip": "Account" }
					  ] }
				]
			},
			{
				"type": "row", "id": "tab-row", "height": 36, "color": "@rb", "alignItems": "center",
				"children": [
					{ "id": "tab-row-pad", "width": 6, "height": 1, "color": "transparent" },
					{ "repeat": { "for": "t", "in": "{{computed.tabs}}", "key": "{{t.id}}" },
					  "type": "column", "id": "{{'tab-' + t.id + '-box'}}", "fitContent": "width", "height": 36, "color": "transparent", "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "{{'tab-' + t.id + '-label'}}", "style": "tab", "height": 33, "selected": "{{state.tab == t.id}}",
						  "textColor": "{{state.tab == t.id ? '@brand' : '@rbInk'}}", "color": "{{state.tab == t.id ? '@rbChecked' : 'transparent'}}",
						  "runs": [{ "text": "{{t.title}}", "size": 13, "bold": "{{state.tab == t.id}}" }],
						  "onClick": [{ "set": "state.tab", "to": "{{t.id}}" }] },
						{ "id": "{{'tab-' + t.id + '-line'}}", "width": "{{max(nodes['tab-' + t.id + '-label'].width - 16, 10)}}", "height": 3, "radius": 1.5,
						  "color": "transparent" }
					  ] },
					{ "id": "tab-row-gap", "grow": 1, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "comments-button", "style": "barButton", "height": 28, "padding": 8, "textColor": "@rbInk",
					  "radius": 14, "runs": [{ "icon": "message-circle", "size": 15 }, { "text": " Comments", "size": 12 }] },
					{ "id": "tab-row-gap-1", "width": 6, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "record-button", "style": "pillButton",
					  "runs": [{ "icon": "circle-dot", "size": 14, "color": "#c50f1f" }, { "text": " Record", "size": 12 }] },
					{ "id": "tab-row-gap-2", "width": 6, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "present-button", "style": "pillButton",
					  "runs": [{ "icon": "projector", "size": 14 }, { "text": " Start", "size": 12 }],
					  "tooltip": "Present from this slide (Shift+F5)", "onClick": { "run": "present", "with": { "from": "{{state.current}}" } } },
					{ "id": "tab-row-gap-3", "width": 6, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "share-button", "style": "pillButton", "color": "@brandLine", "borderColor": "@brandLine", "textColor": "@onBrand", "hover": { "color": "@brand" },
					  "runs": [{ "icon": "send", "size": 14 }, { "text": " Share ", "size": 12 }, { "icon": "chevron-down", "size": 9 }] },
					{ "id": "tab-row-pad-end", "width": 10, "height": 1, "color": "transparent" }
				]
			},
			{
				"id": "ribbon", "height": 96, "color": "@rb",
				"children": [
					{ "id": "ribbon-body", "y": 2, "anchors": { "left": 6, "right": 30 }, "height": 92, "color": "transparent",
					  "children": [
						{ "use": "tabHome", "when": "{{state.tab == 'home'}}" },
						{ "use": "tabInsert", "when": "{{state.tab == 'insert'}}" },
						{ "use": "tabDesign", "when": "{{state.tab == 'design'}}" },
						{ "use": "tabTransitions", "when": "{{state.tab == 'transitions'}}" },
						{ "use": "tabView", "when": "{{state.tab == 'view'}}" },
						{ "use": "tabFile", "when": "{{state.tab == 'file'}}" },
						{ "use": "tabMotion", "when": "{{state.tab == 'animations'}}" },
						{ "use": "tabPresent", "when": "{{state.tab == 'slideShow'}}" },
						{ "use": "tabPlain", "when": "{{!contains(['home', 'insert', 'design', 'transitions', 'view', 'file', 'animations', 'slideShow'], state.tab)}}",
						  "with": { "name": "{{find(computed.tabs, it.id == state.tab).title}}" } }
					  ] },
					{ "type": "label", "id": "ribbon-collapse", "anchors": { "right": 6, "bottom": 6 }, "width": 20, "height": 20, "style": "rbButton", "align": "center",
					  "runs": [{ "icon": "chevron-up", "size": 12 }], "tooltip": "Hide the toolbar (Ctrl+F1)" },
					{ "id": "ribbon-line", "anchors": { "left": 0, "right": 0, "bottom": 0 }, "height": 1, "color": "@barLine" }
				]
			},
			{
				"type": "row", "id": "main", "grow": 1, "color": "@work", "alignItems": "stretch",
				"children": [
					{
						"type": "column", "id": "thumbnails", "when": "{{state.view == 'normal'}}", "width": 200, "color": "@work", "scroll": "vertical", "gap": 0, "focusable": true, "role": "list", "label": "Slides",
						"keys": {
							"up": { "run": "pickSlide", "with": { "index": "{{state.current - 1}}" } },
							"down": { "run": "pickSlide", "with": { "index": "{{state.current + 1}}" } },
							"pageup": { "run": "pickSlide", "with": { "index": "{{state.current - 1}}" } },
							"pagedown": { "run": "pickSlide", "with": { "index": "{{state.current + 1}}" } },
							"home": { "run": "pickSlide", "with": { "index": 0 } },
							"end": { "run": "pickSlide", "with": { "index": "{{length(state.deck.slides) - 1}}" } },
							"enter": { "run": "newSlide", "with": { "layout": "content" } },
							"delete": "deleteSlide",
							"backspace": "deleteSlide"
						},
						"children": [
							{ "id": "thumbs-top", "height": 10, "width": 200, "color": "transparent" },
							{ "repeat": { "for": "s", "in": "{{state.deck.slides}}", "index": "i", "key": "{{s.id}}" },
							  "type": "column", "id": "{{'thumb-' + s.id}}", "fitContent": "height", "width": 200, "color": "transparent",
							  "children": [
								{ "type": "label", "id": "{{'thumb-' + s.id + '-section'}}", "when": "{{computed.sectionAt[i] != null}}", "width": 200, "height": 24, "padding": 8,
								  "textColor": "@rbInk", "runs": [{ "icon": "chevron-down", "size": 10 }, { "text": "{{' ' + computed.sectionAt[i].name}}", "size": 12 }] },
								{ "type": "row", "id": "{{'thumb-' + s.id + '-row'}}", "width": 200, "height": 104, "color": "transparent", "cursor": "hand", "role": "listitem",
								  "selected": "{{i == state.current}}", "label": "{{'Slide ' + (i + 1)}}",
								  "drag": { "data": { "slide": "{{i}}" } },
								  "onDrop": { "run": "moveSlide", "with": { "from": "{{event.data.slide ?? -1}}", "to": "{{i}}" } },
								  "onClick": [{ "run": "pickSlide", "with": { "index": "{{i}}" } }, { "focus": "#thumbnails" }],
								  "children": [
									{ "type": "column", "id": "{{'thumb-' + s.id + '-gutter'}}", "width": 24, "height": 96, "color": "transparent", "alignItems": "end", "children": [
										{ "type": "label", "id": "{{'thumb-' + s.id + '-number'}}", "width": 22, "height": 18, "align": "end",
										  "textColor": "{{i == state.current ? '@brandLine' : '@rbInk'}}",
										  "runs": [{ "text": "{{text(i + 1)}}", "size": 12, "bold": "{{i == state.current}}" }] },
										{ "type": "label", "id": "{{'thumb-' + s.id + '-star'}}", "when": "{{(s.transition.kind ?? 'none') != 'none' || length(s.animations ?? []) > 0}}",
										  "width": 22, "height": 16, "align": "end", "textColor": "@rbMuted", "runs": [{ "icon": "star", "size": 10 }], "tooltip": "Has a transition or animations" }
									] },
									{ "id": "{{'thumb-' + s.id + '-gap'}}", "width": 4, "height": 1, "color": "transparent" },
									{ "id": "{{'thumb-' + s.id + '-frame'}}", "width": 164, "height": 94, "radius": 6,
									  "color": "{{i == state.current ? '@brandLine' : 'transparent'}}",
									  "hover": { "color": "{{i == state.current ? '@brandLine' : '@thumbHover'}}" }, "dragOver": { "color": "@brandLine" },
									  "children": [
										{ "id": "{{'thumb-' + s.id + '-paper'}}", "x": 2, "y": 2, "width": 160, "height": 90, "color": "#ffffff", "borderWidth": 1, "borderColor": "@thumbLine",
										  "children": [
											{ "type": "image", "id": "{{'thumb-' + s.id + '-page'}}", "x": 0, "y": 0, "width": 160, "height": 90, "source": "{{'slide-' + s.id}}", "fit": "fill" },
											{ "id": "{{'thumb-' + s.id + '-veil'}}", "when": "{{s.hidden ?? false}}", "fill": 0, "color": "#ffffff99" }
										  ] }
									  ] }
								  ] }
							  ] },
							{ "id": "thumbs-bottom", "height": 20, "width": 200, "color": "transparent" }
						]
					},
					{ "use": "outlineView", "when": "{{state.view == 'outline'}}" },
					{ "use": "sorterView", "when": "{{state.view == 'sorter'}}" },
					{
						"type": "column", "id": "centre", "when": "{{state.view != 'sorter'}}", "grow": 1, "color": "@work", "alignItems": "stretch",
						"children": [
							{
								"type": "canvas", "id": "board", "grow": 1, "focusable": true, "color": "@work", "accentColor": "@handles",
								"view": "{{computed.view}}", "scaleChildren": true, "snap": true, "rulers": "{{state.ruler}}", "grid": "{{state.gridlines ? 12 : 0}}",
								"label": "{{'Slide ' + (state.current + 1) + (computed.slideTitle == '' ? '' : ', ' + computed.slideTitle)}}",
								"onChange": { "run": "viewChanged", "with": { "view": "{{event.value}}" } },
								"onTransform": { "run": "placeObjects", "with": { "moved": "{{event.items}}" } },
								"children": [
									{ "x": 0, "y": 0, "width": 960, "height": 540, "color": "#ffffff", "shadow": { "x": 0, "y": 1, "blur": 4, "color": "#00000033" },
									  "children": [{ "use": "slideBackground", "with": { "slide": "{{computed.slide}}", "prefix": "e-" } }] },
									{ "repeat": { "for": "o", "in": "{{computed.objects}}", "key": "{{o.id}}" },
									  "use": "slideObject", "with": { "o": "{{o}}", "prefix": "", "layout": "{{computed.layout}}", "edit": true } }
								]
							},
							{ "id": "notes-line", "height": 1, "color": "@barLine", "when": "{{state.notes}}" },
							{ "id": "notes-pane", "height": 76, "color": "@notes", "when": "{{state.notes}}",
							  "children": [
								{ "type": "label", "id": "notes-placeholder", "x": 14, "y": 8, "width": 400, "height": 20, "textColor": "@faint",
								  "when": "{{(computed.slide.notes ?? '') == ''}}", "runs": [{ "text": "Click to add notes", "size": 13 }] },
								{ "type": "editor", "id": "notes", "fill": 4, "color": "transparent", "wrap": true, "textColor": "@rbInk", "lineColor": "transparent",
								  "label": "Notes", "bind": "{{'state.deck.slides[' + state.current + '].notes'}}" }
							  ] }
						]
					},
					{ "use": "formatPane", "when": "{{state.formatPane && state.view != 'sorter'}}" }
				]
			},
			{
				"type": "row", "id": "status-bar", "height": 24, "color": "@rb", "alignItems": "center", "gap": 2,
				"children": [
					{ "id": "status-pad", "width": 8, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "status-slide", "style": "barButton", "runs": [{ "text": "{{'Slide ' + (state.current + 1) + ' of ' + length(state.deck.slides)}}", "size": 11 }] },
					{ "type": "label", "id": "status-language", "style": "barButton", "runs": [{ "icon": "spell-check", "size": 13 }, { "text": " English (United States)", "size": 11 }] },
					{ "type": "label", "id": "status-access", "style": "barButton", "runs": [{ "icon": "badge-check", "size": 13 }, { "text": " Access check: all clear", "size": 11 }] },
					{ "id": "status-gap", "grow": 1, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "status-notes", "style": "{{state.notes ? 'barButtonOn' : 'barButton'}}", "runs": [{ "icon": "notebook-pen", "size": 13 }, { "text": " Notes", "size": 11 }],
					  "onClick": [{ "toggle": "state.notes" }] },
					{ "type": "label", "id": "status-display", "style": "barButton", "runs": [{ "icon": "monitor", "size": 13 }, { "text": " Display", "size": 11 }] },
					{ "type": "label", "id": "status-comments", "style": "barButton", "runs": [{ "icon": "message-circle", "size": 13 }, { "text": " Comments", "size": 11 }] },
					{ "id": "status-gap-2", "width": 8, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "status-normal", "style": "{{state.view == 'normal' ? 'barButtonOn' : 'barButton'}}", "runs": [{ "icon": "panel-left", "size": 14 }], "tooltip": "Normal",
					  "onClick": [{ "set": "state.view", "to": "normal" }] },
					{ "type": "label", "id": "status-sorter", "style": "{{state.view == 'sorter' ? 'barButtonOn' : 'barButton'}}", "runs": [{ "icon": "layout-grid", "size": 14 }], "tooltip": "Slide Sorter",
					  "onClick": [{ "set": "state.view", "to": "sorter" }] },
					{ "type": "label", "id": "status-reading", "style": "barButton", "runs": [{ "icon": "book-open", "size": 14 }], "tooltip": "Reading View" },
					{ "type": "label", "id": "status-show", "style": "barButton", "runs": [{ "icon": "projector", "size": 14 }], "tooltip": "Present from this slide",
					  "onClick": { "run": "present", "with": { "from": "{{state.current}}" } } },
					{ "id": "status-gap-3", "width": 8, "height": 1, "color": "transparent" },
					{ "type": "label", "id": "zoom-out", "style": "barButton", "runs": [{ "icon": "minus", "size": 12 }], "tooltip": "Zoom Out", "onClick": { "run": "zoomBy", "with": { "by": 0.9 } } },
					{ "type": "slider", "id": "zoom-slider", "width": 100, "height": 16, "trackColor": "@rbFieldLine", "activeColor": "@rbMuted", "knobColor": "@rbFieldBg", "min": 10, "max": 400, "value": "{{round(computed.zoom * 100)}}",
					  "label": "Zoom", "onChange": { "run": "zoomBy", "with": { "by": "{{event.value / 100 / computed.zoom}}" } } },
					{ "type": "label", "id": "zoom-in", "style": "barButton", "runs": [{ "icon": "plus", "size": 12 }], "tooltip": "Zoom In", "onClick": { "run": "zoomBy", "with": { "by": 1.1 } } },
					{ "type": "label", "id": "zoom-percent", "style": "barButton", "width": 40, "align": "center", "runs": [{ "text": "{{round(computed.zoom * 100) + '%'}}", "size": 11 }] },
					{ "type": "label", "id": "zoom-fit", "style": "{{state.fit ? 'barButtonOn' : 'barButton'}}", "runs": [{ "icon": "maximize", "size": 13 }], "tooltip": "Fit slide to current window", "onClick": "fit" },
					{ "id": "status-pad-end", "width": 8, "height": 1, "color": "transparent" }
				]
			}
		]
		},
		{ "repeat": { "for": "s", "in": "{{state.deck.slides}}", "key": "{{s.id}}" }, "use": "slideImage", "with": { "s": "{{s}}" } },
		{ "use": "showStage", "when": "{{state.show.on}}" }]
	}
}
