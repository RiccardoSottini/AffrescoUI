{
	"title": "Sinopia tour",
	"size": "16:9",
	"theme": {
		"background": "#ffffff",
		"text": "#1f2937",
		"accent": "#7c3aed",
		"accent2": "#f59e0b",
		"muted": "#e5e7eb"
	},
	"masters": [
		{ "id": "plain", "name": "Plain", "background": "@background", "objects": [
			{ "id": "band", "kind": "rect", "x": 0, "y": 438, "w": 800, "h": 12, "fill": "@accent" }
		] }
	],
	"layouts": [
		{ "id": "title", "name": "Title", "master": "plain", "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 80, "y": 150, "w": 640, "h": 80,
			  "text": "Title", "textSize": 48, "bold": true, "align": "center" },
			{ "id": "subtitle", "kind": "text", "placeholder": "subtitle", "x": 80, "y": 240, "w": 640, "h": 50,
			  "text": "Subtitle", "textSize": 24, "align": "center" }
		] },
		{ "id": "content", "name": "Title and content", "master": "plain", "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 48, "y": 32, "w": 704, "h": 60,
			  "text": "Title", "textSize": 36, "bold": true },
			{ "id": "body", "kind": "text", "placeholder": "body", "x": 48, "y": 110, "w": 704, "h": 300,
			  "text": "Body", "textSize": 22 }
		] },
		{ "id": "blank", "name": "Blank", "master": "plain", "objects": [] }
	],
	"sections": [
		{ "id": "intro", "title": "Introduction" },
		{ "id": "shapes", "title": "Shapes" }
	],
	"slides": [
		{ "id": "s1", "layout": "title", "section": "intro", "notes": "Welcome everyone. This deck is a JSON file.",
		  "transition": { "kind": "fade", "ms": 400 },
		  "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 80, "y": 150, "w": 640, "h": 80,
			  "text": "Sinopia", "textSize": 48, "bold": true, "align": "center" },
			{ "id": "subtitle", "kind": "text", "placeholder": "subtitle", "x": 80, "y": 240, "w": 640, "h": 50,
			  "runs": [ { "text": "Slides and vector documents, " }, { "text": "in JSON", "bold": true, "color": "@accent" } ],
			  "textSize": 24, "align": "center" }
		] },
		{ "id": "s2", "layout": "content", "section": "intro", "notes": "Three points, one per click.",
		  "transition": { "kind": "push", "ms": 500 },
		  "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 48, "y": 32, "w": 704, "h": 60,
			  "text": "Why decks as documents", "textSize": 36, "bold": true },
			{ "id": "point1", "kind": "text", "x": 48, "y": 120, "w": 704, "h": 50, "text": "Diffs you can read",
			  "textSize": 26, "build": { "kind": "appear", "order": 1 } },
			{ "id": "point2", "kind": "text", "x": 48, "y": 190, "w": 704, "h": 50, "text": "Changes people and agents review",
			  "textSize": 26, "build": { "kind": "fade", "order": 2 } },
			{ "id": "point3", "kind": "text", "x": 48, "y": 260, "w": 704, "h": 50, "text": "One file, many outputs",
			  "textSize": 26, "build": { "kind": "fly", "order": 3 } }
		] },
		{ "id": "s3", "layout": "blank", "section": "shapes", "notes": "Every shape is a vector.",
		  "transition": { "kind": "wipe", "ms": 500 },
		  "objects": [
			{ "id": "card", "kind": "rect", "x": 40, "y": 40, "w": 200, "h": 120, "radius": 16,
			  "gradient": { "from": "@accent", "to": "#c4b5fd", "angle": 90 },
			  "shadow": { "x": 0, "y": 6, "blur": 10, "color": "#00000040" },
			  "text": "Gradient", "textColor": "#ffffff", "textSize": 22, "align": "center" },
			{ "id": "disc", "kind": "ellipse", "x": 290, "y": 40, "w": 140, "h": 140, "fill": "@accent2",
			  "stroke": "#b45309", "strokeWidth": 3 },
			{ "id": "hexagon", "kind": "polygon", "sides": 6, "x": 480, "y": 40, "w": 140, "h": 140, "fill": "#10b981" },
			{ "id": "star", "kind": "star", "sides": 5, "inner": 0.45, "x": 640, "y": 40, "w": 130, "h": 130,
			  "fill": "#fbbf24", "rotate": 12 },
			{ "id": "rule", "kind": "line", "x": 40, "y": 240, "w": 720, "h": 1, "stroke": "@muted", "strokeWidth": 2 },
			{ "id": "pointer", "kind": "arrow", "x": 40, "y": 280, "w": 200, "h": 80, "fill": "@accent" },
			{ "id": "wave", "kind": "path", "x": 300, "y": 270, "w": 260, "h": 120, "view": { "w": 100, "h": 100 },
			  "d": "M0 80C30 0 70 0 100 80", "stroke": "@accent", "strokeWidth": 4 },
			{ "id": "pair", "kind": "group", "x": 600, "y": 280, "w": 160, "h": 100, "children": [
				{ "id": "back", "kind": "rect", "x": 0, "y": 0, "w": 100, "h": 70, "fill": "@muted", "radius": 8 },
				{ "id": "front", "kind": "rect", "x": 60, "y": 30, "w": 100, "h": 70, "fill": "@accent2", "radius": 8 }
			] }
		] },
		{ "id": "s4", "layout": "content", "section": "shapes", "skip": true, "notes": "A spare slide, skipped.",
		  "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 48, "y": 32, "w": 704, "h": 60,
			  "text": "Backup slide", "textSize": 36, "bold": true }
		] },
		{ "id": "s5", "layout": "title", "section": "shapes", "notes": "Thank you. Questions?",
		  "transition": { "kind": "zoom", "ms": 500 },
		  "objects": [
			{ "id": "title", "kind": "text", "placeholder": "title", "x": 80, "y": 170, "w": 640, "h": 80,
			  "text": "Thank you", "textSize": 48, "bold": true, "align": "center" }
		] }
	]
}
