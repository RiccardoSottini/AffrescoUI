{
	"$schema": "../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "What the Sign-in template does, checked headless: affrescoui test index.scenarios.json",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "sign-in",
			"note": "A valid email and a password of 8 characters or more sign in and greet the user by email",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "expect": { "state": "email", "is": "ada@example.com" } },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-you-re-in", "text": "You're in" } },
				{ "expect": { "node": "#label-signed-in-as", "text": "Signed in as ada@example.com" } },
				{ "expect": { "node": "#signIn", "exists": false } },
				{ "expect": { "state": "submitted", "is": false } }
			]
		},
		{
			"name": "errors-show-only-after-submit",
			"note": "A wrong email and a short password show no error while typing, and both errors once Sign in is pressed",
			"steps": [
				{ "click": "#email" },
				{ "type": "not-an-email" },
				{ "click": "#password" },
				{ "type": "short" },
				{ "expect": { "node": "#label-error", "exists": false } },
				{ "click": "#signIn" },
				{ "expect": { "state": "submitted", "is": true } },
				{ "expect": { "node": "#label-error", "nth": 0, "text": "Enter an email address" } },
				{ "expect": { "node": "#label-error", "nth": 1, "text": "At least 8 characters" } },
				{ "expect": { "node": "#email", "property": "height", "is": 68 } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } }
			]
		},
		{
			"name": "fixing-a-field-clears-its-error",
			"note": "After a failed sign-in, correcting the email removes its error at once while the password's stays",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada" },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": true } },
				{ "click": "#email" },
				{ "type": "@example.com" },
				{ "expect": { "node": "#label-error", "text": "At least 8 characters" } },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": false } },
				{ "expect": { "node": "#email", "property": "height", "is": 44 } }
			]
		},
		{
			"name": "go-to-create-account-and-back",
			"note": "The link opens the create-account screen without old errors; its back link and Escape return to sign in",
			"steps": [
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "exists": true } },
				{ "click": "#toCreate" },
				{ "expect": { "node": "#label-create-an-account", "text": "Create an account" } },
				{ "expect": { "node": "#label-error", "exists": false } },
				{ "click": "#label-back-to-sign" },
				{ "expect": { "node": "#label-welcome-back", "exists": true } },
				{ "click": "#toCreate" },
				{ "key": "escape" },
				{ "expect": { "node": "#label-create-an-account", "exists": false } },
				{ "expect": { "node": "#toCreate", "exists": true } }
			]
		},
		{
			"name": "create-an-account",
			"note": "Create account needs a name too; with all four fields valid (the password confirmed) it signs in",
			"steps": [
				{ "click": "#toCreate" },
				{ "click": "#checked-field-form-2" },
				{ "type": "jon@example.com" },
				{ "click": "#checked-field-form-3" },
				{ "type": "a long password" },
				{ "click": "#confirm-password" },
				{ "type": "a long password" },
				{ "click": "#label-create-account" },
				{ "expect": { "node": "#label-error", "text": "Enter your name" } },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": false } },
				{ "click": "#checked-field-form" },
				{ "type": "Jon Doe" },
				{ "click": "#label-create-account" },
				{ "expect": { "state": "name", "is": "Jon Doe" } },
				{ "expect": { "node": "#label-signed-in-as", "text": "Signed in as jon@example.com" } }
			]
		},
		{
			"name": "sign-out",
			"note": "Signing out returns to sign in with the email kept and the password cleared",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "12345678" },
				{ "click": "#signIn" },
				{ "click": "#label-sign-out" },
				{ "expect": { "state": "password", "is": "" } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "text": "ada@example.com" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "text": "" } }
			]
		},
		{
			"name": "enter-signs-in",
			"note": "Enter anywhere in the card signs in, like the button",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "key": "enter" },
				{ "expect": { "node": "#label-you-re-in", "exists": true } }
			]
		},
		{
			"name": "switch-the-theme",
			"note": "The moon button and Cmd+J switch between the light and the dark tokens",
			"steps": [
				{ "click": "#themeToggle" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "key": "mod+j" },
				{ "expect": { "state": "theme", "is": "light" } }
			]
		},
		{
			"name": "show-and-hide-the-password",
			"note": "The password is a secret field until the eye is pressed; the eye's name says what it does",
			"steps": [
				{ "click": "#password" },
				{ "type": "abc" },
				{ "expect": { "node": "#field-eye", "property": "name", "is": "Show the password" } },
				{ "expect": { "state": "password", "is": "abc" } },
				{ "click": "#field-eye" },
				{ "expect": { "state": "showPassword", "is": true } },
				{ "expect": { "node": "#field-eye", "property": "name", "is": "Hide the password" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "text": "abc" } },
				{ "click": "#field-eye" },
				{ "expect": { "state": "showPassword", "is": false } },
				{ "expect": { "node": "#field-eye", "property": "name", "is": "Show the password" } }
			]
		},
		{
			"name": "the-focused-field-is-marked",
			"note": "Focusing a field remembers which one, for its accent border",
			"steps": [
				{ "click": "#email" },
				{ "expect": { "state": "focus", "is": "email" } },
				{ "click": "#password" },
				{ "expect": { "state": "focus", "is": "password" } }
			]
		},
		{
			"name": "remember-me",
			"note": "Remember me is on by default; the box or its text turns it off, and the signed-in card says so",
			"steps": [
				{ "expect": { "state": "remember", "is": true } },
				{ "click": "#remember" },
				{ "expect": { "state": "remember", "is": false } },
				{ "click": "#label-remember" },
				{ "click": "#label-remember" },
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-remembered", "text": "You will be signed out when you close the app" } }
			]
		},
		{
			"name": "reset-the-password",
			"note": "Forgot password? asks for the email (prefilled), checks it and says the link was sent",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example" },
				{ "click": "#forgot" },
				{ "wait": 50 },
				{ "expect": { "state": "forgot.open", "is": true } },
				{ "expect": { "state": "forgot.email", "is": "ada@example" } },
				{ "key": "enter" },
				{ "expect": { "state": "forgot.error", "is": "Enter the email of your account" } },
				{ "expect": { "node": "#forgotError", "exists": true } },
				{ "type": ".com" },
				{ "expect": { "state": "forgot.error", "is": "" } },
				{ "key": "enter" },
				{ "expect": { "state": "forgot.open", "is": false } },
				{ "expect": { "state": "toast.message", "is": "We sent a reset link to ada@example.com" } },
				{ "wait": 4100 },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "cancel-the-reset",
			"note": "Escape closes the reset dialog and sends nothing",
			"steps": [
				{ "click": "#forgot" },
				{ "wait": 50 },
				{ "key": "escape" },
				{ "expect": { "state": "forgot.open", "is": false } },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "password-strength",
			"note": "The meter follows passwordStrength: length and variety (capitals, digits, symbols); the hint says what to add",
			"steps": [
				{ "click": "#toCreate" },
				{ "expect": { "node": "#strength-name", "text": "Use 12 or more characters: capitals, digits, symbols" } },
				{ "expect": { "node": "#strength-meter", "property": "name", "is": "No password yet" } },
				{ "click": "#checked-field-form-3" },
				{ "type": "abc" },
				{ "expect": { "node": "#strength-meter", "property": "name", "is": "Weak password" } },
				{ "expect": { "node": "#strength-name", "text": "Add more characters, a capital, a digit, and a symbol" } },
				{ "type": "defghA1" },
				{ "expect": { "node": "#strength-meter", "property": "name", "is": "Fair password" } },
				{ "type": "bc" },
				{ "expect": { "node": "#strength-meter", "property": "name", "is": "Good password" } },
				{ "expect": { "node": "#strength-name", "text": "Add a symbol" } },
				{ "type": "!" },
				{ "expect": { "node": "#strength-meter", "property": "name", "is": "Strong password" } },
				{ "expect": { "node": "#strength-name", "text": "Looks strong" } },
				{ "expect": { "node": "#strength-meter", "property": "role", "is": "status" } }
			]
		},
		{
			"name": "welcome-after-creating",
			"note": "A new account is greeted by name in a toast and an initial",
			"steps": [
				{ "click": "#toCreate" },
				{ "click": "#checked-field-form" },
				{ "type": "jon snow" },
				{ "click": "#checked-field-form-2" },
				{ "type": "jon@example.com" },
				{ "click": "#checked-field-form-3" },
				{ "type": "a long password" },
				{ "click": "#confirm-password" },
				{ "type": "a long password" },
				{ "key": "enter" },
				{ "expect": { "node": "#avatar", "text": "J" } },
				{ "expect": { "state": "toast.message", "is": "Welcome, jon snow" } }
			]
		},
		{
			"name": "escape-keeps-the-session",
			"note": "Bug: Escape after signing in went back to the sign-in form while still signed in",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "click": "#signIn" },
				{ "key": "escape" },
				{ "expect": { "node": "#label-you-re-in", "exists": true } },
				{ "expect": { "node": "#label-welcome-back", "exists": false } }
			]
		},
		{
			"name": "escape-after-signing-out",
			"note": "Bug: after signing out, Escape went back to the signed-in screen",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "click": "#signIn" },
				{ "click": "#label-sign-out" },
				{ "click": "#email" },
				{ "key": "escape" },
				{ "expect": { "node": "#label-you-re-in", "exists": false } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } }
			]
		},
		{
			"name": "keyboard-only-sign-in",
			"note": "Bug: links and buttons could not be reached by Tab. Signs in with the keyboard alone: Tab, Space and Enter",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "key": "tab" },
				{ "expect": { "node": "#forgot", "property": "focused", "is": true } },
				{ "key": "tab" },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "property": "focused", "is": true } },
				{ "type": "correct horse" },
				{ "key": "tab" },
				{ "expect": { "node": "#field-eye", "property": "focused", "is": true } },
				{ "key": "space" },
				{ "expect": { "state": "showPassword", "is": true } },
				{ "key": "tab" },
				{ "expect": { "node": "#remember", "property": "focused", "is": true } },
				{ "key": "space" },
				{ "expect": { "state": "remember", "is": false } },
				{ "key": "tab" },
				{ "expect": { "node": "#signIn", "property": "focused", "is": true } },
				{ "key": "enter" },
				{ "expect": { "node": "#label-you-re-in", "exists": true } },
				{ "expect": { "node": "#label-remembered", "text": "You will be signed out when you close the app" } }
			]
		},
		{
			"name": "enter-runs-the-focused-control",
			"note": "Bug: Enter on a focused link or button in the card signed in instead of running it",
			"steps": [
				{ "click": "#email" },
				{ "key": "tab" },
				{ "expect": { "node": "#forgot", "property": "focused", "is": true } },
				{ "key": "enter" },
				{ "wait": 50 },
				{ "expect": { "state": "forgot.open", "is": true } },
				{ "key": "escape" },
				{ "expect": { "state": "forgot.open", "is": false } },
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "key": "tab" },
				{ "expect": { "node": "#field-eye", "property": "focused", "is": true } },
				{ "key": "enter" },
				{ "expect": { "state": "showPassword", "is": true } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } },
				{ "click": "#password" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "expect": { "node": "#provider", "property": "focused", "is": true } },
				{ "key": "tab" },
				{ "expect": { "node": "#toCreate", "property": "focused", "is": true } },
				{ "key": "enter" },
				{ "expect": { "node": "#label-create-an-account", "exists": true } },
				{ "expect": { "node": "#label-you-re-in", "exists": false } }
			]
		},
		{
			"name": "tab-reaches-the-top-bar",
			"note": "Bug: the theme button could not be focused and had the text role; the top bar is reached by Tab and named",
			"steps": [
				{ "click": "#email" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "key": "tab" },
				{ "expect": { "node": "#toCreate", "property": "focused", "is": true } },
				{ "key": "tab" },
				{ "expect": { "node": "#lang", "nth": 0, "property": "focused", "is": true } },
				{ "key": "right" },
				{ "expect": { "state": "locale", "is": "en" } },
				{ "expect": { "node": "#languages", "property": "role", "is": "radiogroup" } },
				{ "expect": { "node": "#lang", "nth": 1, "property": "role", "is": "radio" } },
				{ "expect": { "node": "#lang", "nth": 1, "property": "name", "is": "Español" } },
				{ "key": "tab" },
				{ "expect": { "node": "#slowToggle", "property": "focused", "is": true } },
				{ "expect": { "node": "#slowToggle", "property": "role", "is": "switch" } },
				{ "key": "tab" },
				{ "expect": { "node": "#shortcutsButton", "property": "focused", "is": true } },
				{ "key": "tab" },
				{ "expect": { "node": "#themeToggle", "property": "focused", "is": true } },
				{ "expect": { "node": "#themeToggle", "property": "role", "is": "button" } },
				{ "key": "space" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "key": "enter" },
				{ "expect": { "state": "theme", "is": "light" } }
			]
		},
		{
			"name": "fields-are-named-and-errors-announced",
			"note": "Bug: fields were named by their placeholder, and errors had no role or description",
			"steps": [
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "property": "name", "is": "Email" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "property": "name", "is": "Password" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "property": "description", "is": "" } },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "nth": 0, "property": "role", "is": "alert" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "property": "description", "is": "Enter an email address" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "property": "description", "is": "At least 8 characters" } },
				{ "expect": { "node": "#announcer", "property": "role", "is": "status" } },
				{ "expect": { "node": "#signIn", "property": "role", "is": "button" } },
				{ "expect": { "node": "#toCreate", "property": "role", "is": "link" } },
				{ "expect": { "node": "#remember", "property": "role", "is": "checkbox" } }
			]
		},
		{
			"name": "smallest-window",
			"note": "Bug: at the smallest window the create card with its errors ran past the window and over the footer",
			"steps": [
				{ "resize": [480, 640] },
				{ "wait": 50 },
				{ "click": "#toCreate" },
				{ "scroll": "#stack-form-2", "dy": -20 },
				{ "click": "#label-create-account" },
				{ "expect": { "node": "#panel-root", "property": "width", "is": 480 } },
				{ "expect": { "node": "#panel-card", "property": "width", "is": 420 } },
				{ "expect": { "node": "#panel-card", "property": "x", "is": 30 } },
				{ "expect": { "node": "#panel-card", "property": "y", "is": 64 } },
				{ "expect": { "node": "#panel-card", "property": "height", "is": 524 } },
				{ "expect": { "node": "#footer", "exists": false } },
				{ "expect": { "node": "#themeToggle", "property": "shown", "is": true } },
				{ "key": "escape" },
				{ "expect": { "node": "#card", "property": "y", "is": 68 } },
				{ "expect": { "node": "#card", "property": "height", "is": 516 } },
				{ "expect": { "node": "#signIn", "property": "shown", "is": true } },
				{ "expect": { "node": "#logo", "exists": false } }
			]
		},
		{
			"name": "resizing-relays-out-at-once",
			"note": "Bug: sizes worked out in computed values kept the old window size until the next click, so the first click after a resize hit the wrong field",
			"steps": [
				{ "resize": [480, 640] },
				{ "expect": { "node": "#logo", "exists": false } },
				{ "expect": { "node": "#card", "property": "y", "is": 68 } },
				{ "expect": { "node": "#card", "property": "height", "is": 516 } },
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "expect": { "state": "email", "is": "ada@example.com" } },
				{ "expect": { "state": "password", "is": "" } },
				{ "resize": [960, 720] },
				{ "expect": { "node": "#logo", "exists": true } },
				{ "expect": { "node": "#card", "property": "height", "is": 584 } }
			]
		},
		{
			"name": "full-screen",
			"note": "At 1920 by 1080 the card stays 420 wide in the middle, with the logo and the footer",
			"steps": [
				{ "resize": [1920, 1080] },
				{ "expect": { "node": "#card", "property": "width", "is": 420 } },
				{ "expect": { "node": "#card", "property": "x", "is": 750 } },
				{ "expect": { "node": "#logo", "exists": true } },
				{ "expect": { "node": "#footer", "property": "shown", "is": true } },
				{ "expect": { "node": "#themeToggle", "property": "x", "is": 1872 } }
			]
		},
		{
			"name": "sign-in-light-theme",
			"note": "The light theme: a white card on a pale background (the toggle's name, with its key as each platform writes it, is in tests/unit/automation.cpp)",
			"steps": [
				{ "expect": { "state": "theme", "is": "light" } },
				{ "expect": { "node": "#card", "property": "color", "is": "#ffffff" } },
				{ "expect": { "node": "#panel-root", "property": "color", "is": "#eef2ff" } }
			]
		},
		{
			"name": "dark-theme",
			"note": "The dark theme from the moon button: a deep card on a dark background, and back with Cmd+J (Ctrl+J off macOS)",
			"steps": [
				{ "click": "#themeToggle" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "expect": { "node": "#card", "property": "color", "is": "#141b2e" } },
				{ "expect": { "node": "#panel-root", "property": "color", "is": "#0b1020" } },
				{ "key": "mod+j" },
				{ "expect": { "node": "#card", "property": "color", "is": "#ffffff" } }
			]
		},
		{
			"name": "spanish",
			"note": "The ES chip switches every text to Spanish, errors included",
			"steps": [
				{ "click": "#lang", "nth": 1 },
				{ "expect": { "state": "locale", "is": "es" } },
				{ "expect": { "node": "#label-welcome-back", "text": "Te damos la bienvenida de nuevo" } },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "nth": 0, "text": "Introduce una dirección de correo" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "property": "name", "is": "Correo electrónico" } }
			]
		},
		{
			"name": "sign-in-french",
			"note": "Cmd+L twice switches to French: the texts are French and the layout stays left to right",
