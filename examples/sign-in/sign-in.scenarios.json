{
	"$schema": "../../../schema/affrescoui-scenarios.schema.json",
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "What the Sign-in template does, checked headless: affrescoui test sign-in.scenarios.json",
	"screen": "sign-in.screen.json",
	"scenarios": [
		{
			"name": "sign-in",
			"note": "A valid email and a password of 8 characters or more sign in and greet the user by email",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "expect": { "state": "email", "is": "ada@example.com" } },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-you-re-in", "text": "You're in" } },
				{ "expect": { "node": "#label-signed-in-as", "text": "Signed in as ada@example.com" } },
				{ "expect": { "node": "#signIn", "exists": false } },
				{ "expect": { "state": "submitted", "is": false } }
			]
		},
		{
			"name": "errors-show-only-after-submit",
			"note": "A wrong email and a short password show no error while typing, and both errors once Sign in is pressed",
			"steps": [
				{ "click": "#email" },
				{ "type": "not-an-email" },
				{ "click": "#password" },
				{ "type": "short" },
				{ "expect": { "node": "#label-error", "exists": false } },
				{ "click": "#signIn" },
				{ "expect": { "state": "submitted", "is": true } },
				{ "expect": { "node": "#label-error", "nth": 0, "text": "Enter an email address" } },
				{ "expect": { "node": "#label-error", "nth": 1, "text": "At least 8 characters" } },
				{ "expect": { "node": "#email", "property": "height", "is": 68 } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } }
			]
		},
		{
			"name": "fixing-a-field-clears-its-error",
			"note": "After a failed sign-in, correcting the email removes its error at once while the password's stays",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada" },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": true } },
				{ "click": "#email" },
				{ "type": "@example.com" },
				{ "expect": { "node": "#label-error", "text": "At least 8 characters" } },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": false } },
				{ "expect": { "node": "#email", "property": "height", "is": 44 } }
			]
		},
		{
			"name": "go-to-create-account-and-back",
			"note": "The link opens the create-account screen without old errors; its back link and Escape return to sign in",
			"steps": [
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-error", "exists": true } },
				{ "click": "#toCreate" },
				{ "expect": { "node": "#label-create-an-account", "text": "Create an account" } },
				{ "expect": { "node": "#label-error", "exists": false } },
				{ "click": "#label-back-to-sign" },
				{ "expect": { "node": "#label-welcome-back", "exists": true } },
				{ "click": "#toCreate" },
				{ "key": "escape" },
				{ "expect": { "node": "#label-create-an-account", "exists": false } },
				{ "expect": { "node": "#toCreate", "exists": true } }
			]
		},
		{
			"name": "create-an-account",
			"note": "Create account needs a name too; with all three fields valid it signs in",
			"steps": [
				{ "click": "#toCreate" },
				{ "click": "#checked-field-form-2" },
				{ "type": "jon@example.com" },
				{ "click": "#checked-field-form-3" },
				{ "type": "a long password" },
				{ "click": "#label-create-account" },
				{ "expect": { "node": "#label-error", "text": "Enter your name" } },
				{ "expect": { "node": "#label-error", "nth": 1, "exists": false } },
				{ "click": "#checked-field-form" },
				{ "type": "Jon Doe" },
				{ "click": "#label-create-account" },
				{ "expect": { "state": "name", "is": "Jon Doe" } },
				{ "expect": { "node": "#label-signed-in-as", "text": "Signed in as jon@example.com" } }
			]
		},
		{
			"name": "sign-out",
			"note": "Signing out returns to sign in with the email kept and the password cleared",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "12345678" },
				{ "click": "#signIn" },
				{ "click": "#label-sign-out" },
				{ "expect": { "state": "password", "is": "" } },
				{ "expect": { "node": "#label-welcome-back", "exists": true } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 0, "text": "ada@example.com" } },
				{ "expect": { "node": "#textarea-placeholder", "nth": 1, "text": "" } }
			]
		},
		{
			"name": "enter-signs-in",
			"note": "Enter anywhere in the card signs in, like the button",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "key": "enter" },
				{ "expect": { "node": "#label-you-re-in", "exists": true } }
			]
		},
		{
			"name": "switch-the-theme",
			"note": "The moon button and Cmd+J switch between the light and the dark tokens",
			"steps": [
				{ "click": "#themeToggle" },
				{ "expect": { "state": "theme", "is": "dark" } },
				{ "key": "mod+j" },
				{ "expect": { "state": "theme", "is": "light" } }
			]
		},
		{
			"name": "show-and-hide-the-password",
			"note": "The password shows as dots until the eye is pressed",
			"steps": [
				{ "click": "#password" },
				{ "type": "abc" },
				{ "expect": { "node": "#field-dots", "nth": 1, "text": "•••" } },
				{ "click": "#field-eye" },
				{ "expect": { "state": "showPassword", "is": true } },
				{ "expect": { "node": "#field-dots", "nth": 1, "text": "" } },
				{ "click": "#field-eye" },
				{ "expect": { "node": "#field-dots", "nth": 1, "text": "•••" } }
			]
		},
		{
			"name": "the-focused-field-is-marked",
			"note": "Focusing a field remembers which one, for its accent border",
			"steps": [
				{ "click": "#email" },
				{ "expect": { "state": "focus", "is": "email" } },
				{ "click": "#password" },
				{ "expect": { "state": "focus", "is": "password" } }
			]
		},
		{
			"name": "remember-me",
			"note": "Remember me is on by default; the box or its text turns it off, and the signed-in card says so",
			"steps": [
				{ "expect": { "state": "remember", "is": true } },
				{ "click": "#remember" },
				{ "expect": { "state": "remember", "is": false } },
				{ "click": "#label-remember" },
				{ "click": "#label-remember" },
				{ "click": "#email" },
				{ "type": "ada@example.com" },
				{ "click": "#password" },
				{ "type": "correct horse" },
				{ "click": "#signIn" },
				{ "expect": { "node": "#label-remembered", "text": "You will be signed out when you close the app" } }
			]
		},
		{
			"name": "reset-the-password",
			"note": "Forgot password? asks for the email (prefilled), checks it and says the link was sent",
			"steps": [
				{ "click": "#email" },
				{ "type": "ada@example" },
				{ "click": "#forgot" },
				{ "wait": 50 },
				{ "expect": { "state": "forgot.open", "is": true } },
				{ "expect": { "state": "forgot.email", "is": "ada@example" } },
				{ "key": "enter" },
				{ "expect": { "state": "forgot.error", "is": "Enter the email of your account" } },
				{ "expect": { "node": "#forgotError", "exists": true } },
				{ "type": ".com" },
				{ "expect": { "state": "forgot.error", "is": "" } },
				{ "key": "enter" },
				{ "expect": { "state": "forgot.open", "is": false } },
				{ "expect": { "state": "toast.message", "is": "We sent a reset link to ada@example.com" } },
				{ "wait": 4100 },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "cancel-the-reset",
			"note": "Escape closes the reset dialog and sends nothing",
			"steps": [
				{ "click": "#forgot" },
				{ "wait": 50 },
				{ "key": "escape" },
				{ "expect": { "state": "forgot.open", "is": false } },
				{ "expect": { "state": "toast.open", "is": false } }
			]
		},
		{
			"name": "password-strength",
			"note": "The meter grows with the length, a capital and a digit",
			"steps": [
				{ "click": "#toCreate" },
				{ "expect": { "node": "#strength-name", "text": "Use 8 or more characters, a capital and a digit" } },
				{ "click": "#checked-field-form-3" },
				{ "type": "abc" },
				{ "expect": { "node": "#strength-name", "text": "Weak password" } },
				{ "type": "defgh" },
				{ "expect": { "node": "#strength-name", "text": "Fair password" } },
				{ "type": "A" },
				{ "expect": { "node": "#strength-name", "text": "Good password" } },
				{ "type": "1" },
				{ "expect": { "node": "#strength-name", "text": "Strong password" } }
			]
		},
		{
			"name": "welcome-after-creating",
			"note": "A new account is greeted by name in a toast and an initial",
			"steps": [
				{ "click": "#toCreate" },
				{ "click": "#checked-field-form" },
				{ "type": "jon snow" },
				{ "click": "#checked-field-form-2" },
				{ "type": "jon@example.com" },
				{ "click": "#checked-field-form-3" },
				{ "type": "a long password" },
				{ "key": "enter" },
				{ "expect": { "node": "#avatar", "text": "J" } },
				{ "expect": { "state": "toast.message", "is": "Welcome, jon snow" } }
			]
		}
	]
}
