{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Tempera's commands: one action per native (tempera.*), each taking its arguments as args and putting the new snapshot in state.doc; the commands people choose from the menus and keys; and the watches that preview and apply filters, so a panel added by a revision (which may not call natives) works by setting state.filter.",

	"computed": {
		"activeLayer": "{{find(state.doc.layers, it.id == state.doc.active)}}",
		"zoomPercent": "{{round(state.doc.view.zoom * 1000) / 10}}"
	},

	"actions": {
		"setTool": [{ "call": "tempera.setTool", "with": "{{args}}", "into": "state.doc" }],
		"setOptions": [{ "call": "tempera.setOptions", "with": "{{args}}", "into": "state.doc" }],
		"select": [{ "call": "tempera.select", "with": "{{args}}", "into": "state.doc" }],
		"pointer": [{ "call": "tempera.pointer", "with": "{{args}}", "into": "state.doc" }],
		"crop": [{ "call": "tempera.crop", "with": "{{args}}", "into": "state.doc" }],
		"setProfile": [{ "call": "tempera.setProfile", "with": "{{args}}", "into": "state.doc" }],
		"fillSelection": [{ "call": "tempera.fillSelection", "with": "{{args}}", "into": "state.doc" }],
		"zoom": [{ "call": "tempera.zoom", "with": "{{args}}", "into": "state.doc" }],
		"feather": [{ "call": "tempera.feather", "with": "{{args}}", "into": "state.doc" }],
		"setLayer": [{ "call": "tempera.setLayer", "with": "{{args}}", "into": "state.doc" }],
		"addLayer": [{ "call": "tempera.addLayer", "with": "{{args}}", "into": "state.doc" }],
		"moveLayer": [{ "call": "tempera.moveLayer", "with": "{{args}}", "into": "state.doc" }],
		"deleteLayer": [{ "call": "tempera.deleteLayer", "with": "{{args}}", "into": "state.doc" }],
		"duplicateLayer": [{ "call": "tempera.duplicateLayer", "with": "{{args}}", "into": "state.doc" }],
		"selectLayer": [{ "call": "tempera.selectLayer", "with": "{{args}}", "into": "state.doc" }],
		"addMask": [{ "call": "tempera.addMask", "with": "{{args}}", "into": "state.doc" }],
		"deleteMask": [{ "call": "tempera.deleteMask", "with": "{{args}}", "into": "state.doc" }],
		"goToHistory": [{ "call": "tempera.history", "with": "{{args}}", "into": "state.doc" }],
		"newDocument": [{ "call": "tempera.new", "with": "{{args}}", "into": "state.doc" }],
		"save": [{ "call": "tempera.save", "with": "{{args}}", "into": "state.doc" }],

		"setGradient": [{ "set": "state.gradientEdit", "to": "{{args}}" }, { "run": "setOptions", "with": { "args": { "gradient": "{{args}}" } } }],
		"perform": [{ "note": "Runs an action with arguments, for the scenarios: event.run and event.args." },
			{ "run": "{{event.run}}", "with": { "args": "{{event.args}}" } }],
		"temperaChanged": [{ "set": "state.doc", "to": "{{event}}" }],

		"undo": { "title": "Undo", "category": "Edit", "icon": "undo-2", "enablement": "{{state.doc.canUndo}}",
			"do": [{ "call": "tempera.undo", "into": "state.doc" }] },
		"redo": { "title": "Redo", "category": "Edit", "icon": "redo-2", "enablement": "{{state.doc.canRedo}}",
			"do": [{ "call": "tempera.redo", "into": "state.doc" }] },
		"openFile": { "title": "Open...", "category": "File", "icon": "folder-open",
			"do": [{ "call": "tempera.open", "into": "state.doc" }] },
		"revert": { "title": "Revert", "category": "File", "icon": "rotate-ccw",
			"do": [{ "call": "tempera.revert", "into": "state.doc" }] },
		"saveProject": { "title": "Save...", "category": "File", "icon": "save",
			"do": [{ "run": "save", "with": { "args": { "format": "tempera" } } }] },
		"exportPng": { "title": "Export as PNG...", "category": "File", "icon": "image",
			"do": [{ "run": "save", "with": { "args": { "format": "png" } } }] },
		"exportJpeg": { "title": "Export as JPEG...", "category": "File", "icon": "image",
			"do": [{ "run": "save", "with": { "args": { "format": "jpeg" } } }] },
		"showNewDialog": { "title": "New...", "category": "File", "icon": "file-plus",
			"do": [{ "set": "state.newDoc.open", "to": true }] },
		"createDocument": [{ "run": "newDocument", "with": { "args": { "width": "{{clamp(number(state.newDoc.width) ?? 1, 1, 20000)}}", "height": "{{clamp(number(state.newDoc.height) ?? 1, 1, 20000)}}", "format": "{{state.newDoc.format}}" } } },
			{ "set": "state.newDoc.open", "to": false }],
		"newSample": { "title": "New Sample", "category": "File", "icon": "sparkles",
			"do": [{ "run": "newDocument", "with": { "args": { "sample": true } } }] },

		"fillForeground": { "title": "Fill with Foreground", "category": "Edit", "icon": "paint-bucket",
			"do": [{ "run": "fillSelection", "with": { "args": {} } }] },
		"swapColours": { "title": "Swap Colours", "category": "Edit", "icon": "arrow-left-right",
			"do": [{ "run": "setOptions", "with": { "args": { "swap": true } } }] },
		"resetColours": { "title": "Default Colours", "category": "Edit", "icon": "rotate-ccw",
			"do": [{ "run": "setOptions", "with": { "args": { "reset": true } } }] },
		"brushSmaller": { "title": "Smaller Brush", "category": "Edit", "icon": "minus",
			"do": [{ "run": "setOptions", "with": { "args": { "sizeStep": -1 } } }] },
		"brushLarger": { "title": "Larger Brush", "category": "Edit", "icon": "plus",
			"do": [{ "run": "setOptions", "with": { "args": { "sizeStep": 1 } } }] },

		"cropToSelection": { "title": "Crop to Selection", "category": "Image", "icon": "crop",
			"enablement": "{{state.doc.selection}}",
			"do": [{ "run": "crop", "with": { "args": { "x": "{{state.doc.bounds[0]}}", "y": "{{state.doc.bounds[1]}}",
				"width": "{{state.doc.bounds[2]}}", "height": "{{state.doc.bounds[3]}}" } } }] },
		"toggleProof": { "title": "Proof Colours", "category": "Image", "icon": "eye",
			"do": [{ "run": "setProfile", "with": { "args": { "proof": "{{empty(state.doc.proof) ? 'gray' : ''}}" } } }] },

		"newLayer": { "title": "New Layer", "category": "Layer", "icon": "plus",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "pixel" } } }] },
		"newGroup": { "title": "New Group", "category": "Layer", "icon": "folder",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "group" } } }] },
		"duplicateActive": { "title": "Duplicate Layer", "category": "Layer", "icon": "copy",
			"do": [{ "run": "duplicateLayer", "with": { "args": {} } }] },
		"deleteActive": { "title": "Delete Layer", "category": "Layer", "icon": "trash-2",
			"enablement": "{{length(state.doc.layers) > 1}}",
			"do": [{ "run": "deleteLayer", "with": { "args": {} } }] },
		"layerUp": { "title": "Bring Forward", "category": "Layer", "icon": "arrow-up",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": 1 } } }] },
		"layerDown": { "title": "Send Backward", "category": "Layer", "icon": "arrow-down",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": -1 } } }] },
		"addLayerMask": { "title": "Add Layer Mask", "category": "Layer", "icon": "circle-dot",
			"enablement": "{{computed.activeLayer && !computed.activeLayer.mask}}",
			"do": [{ "run": "addMask", "with": { "args": {} } }] },
		"deleteLayerMask": { "title": "Delete Layer Mask", "category": "Layer", "icon": "square-x",
			"enablement": "{{computed.activeLayer && computed.activeLayer.mask}}",
			"do": [{ "run": "deleteMask", "with": { "args": {} } }] },
		"toggleClipping": { "title": "Clipping Mask", "category": "Layer", "icon": "paperclip",
			"do": [{ "run": "setLayer", "with": { "args": { "clipped": "{{!computed.activeLayer.clipped}}" } } }] },

		"selectAll": { "title": "All", "category": "Select", "icon": "square",
			"do": [{ "run": "select", "with": { "args": { "kind": "all" } } }] },
		"deselect": { "title": "Deselect", "category": "Select", "icon": "square-x",
			"do": [{ "run": "select", "with": { "args": { "kind": "none" } } }] },
		"invertSelection": { "title": "Inverse", "category": "Select", "icon": "contrast",
			"do": [{ "run": "select", "with": { "args": { "kind": "invert" } } }] },
		"colorRange": { "title": "Colour Range", "category": "Select", "icon": "pipette",
			"do": [{ "run": "select", "with": { "args": { "kind": "colorRange", "color": "{{state.doc.foreground}}",
				"fuzziness": 40, "allLayers": true } } }] },
		"featherSelection": { "title": "Feather 8 px", "category": "Select", "icon": "feather",
			"enablement": "{{state.doc.selection}}",
			"do": [{ "run": "feather", "with": { "args": { "radius": 8 } } }] },
		"toggleQuickMask": { "title": "Quick Mask", "category": "Select", "icon": "scan-line",
			"do": [{ "run": "setOptions", "with": { "args": { "quickMask": "{{!state.doc.options.quickMask}}" } } }] },

		"showFilter": [{ "note": "Only sets state, so a revision's button may run it; the watches preview." },
			{ "set": "state.filter.kind", "to": "{{args.kind}}" }, { "set": "state.filter.open", "to": true }],
		"previewFilterNow": [{ "if": "{{state.filter.open && state.filter.live}}",
			"then": [{ "call": "tempera.previewFilter", "with": "{{state.filter}}", "into": "state.doc" }] }],
		"liveChanged": [{ "if": "{{state.filter.live}}", "then": [{ "run": "previewFilterNow" }],
			"else": [{ "call": "tempera.cancelFilter", "into": "state.doc" }] }],
		"commitFilter": [{ "call": "tempera.applyFilter", "with": "{{state.filter}}", "into": "state.doc" },
			{ "set": "state.filter.open", "to": false }],
		"discardFilter": [{ "call": "tempera.cancelFilter", "into": "state.doc" }, { "set": "state.filter.open", "to": false }],

		"zoomIn": { "title": "Zoom In", "category": "View", "icon": "zoom-in",
			"do": [{ "run": "zoom", "with": { "args": { "by": 2 } } }] },
		"zoomOut": { "title": "Zoom Out", "category": "View", "icon": "zoom-out",
			"do": [{ "run": "zoom", "with": { "args": { "by": 0.5 } } }] },
		"actualPixels": { "title": "100%", "category": "View", "icon": "scan",
			"do": [{ "run": "zoom", "with": { "args": { "to": 1 } } }] },
		"fitOnScreen": { "title": "Fit on Screen", "category": "View", "icon": "maximize",
			"do": [{ "call": "tempera.fit", "into": "state.doc" }] },
		"toggleRulers": { "title": "Rulers", "category": "View", "icon": "ruler",
			"do": [{ "toggle": "state.view.rulers" }] },
		"toggleGuides": { "title": "Guides", "category": "View", "icon": "grid",
			"do": [{ "toggle": "state.view.guides" }] },
		"clearGuides": { "title": "Clear Guides", "category": "View", "icon": "eraser",
			"do": [{ "set": "state.guides", "to": { "vertical": [], "horizontal": [] } }] },
		"addGuide": [{ "push": "state.guides[args.axis]", "value": "{{round(args.at)}}" }],
		"toggleTheme": { "title": "Dark Theme", "category": "View", "icon": "moon",
			"do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },

		"showPanel": [{ "set": "state.panels[args.slot]", "to": "{{args.id}}" }],
		"showAbout": { "title": "About Tempera", "category": "Help", "icon": "info", "do": [{ "set": "state.about", "to": true }] },
		"acceptAgentProposal": [{ "accept": "{{proposals[0].id}}", "head": "{{proposals[0].head}}" }]
	},

	"watch": {
		"state.filter.open": { "run": "previewFilterNow" },
		"state.filter.kind": { "run": "previewFilterNow" },
		"state.filter.radius": { "run": "previewFilterNow" },
		"state.filter.amount": { "run": "previewFilterNow" },
		"state.filter.threshold": { "run": "previewFilterNow" },
		"state.filter.angle": { "run": "previewFilterNow" },
		"state.filter.distance": { "run": "previewFilterNow" },
		"state.filter.live": { "run": "liveChanged" },
		"state.filter.apply": { "run": "commitFilter" },
		"state.filter.cancel": { "run": "discardFilter" }
	},

	"keys": {
		"v": { "do": "setTool", "with": { "args": { "tool": "move" } } },
		"m": { "do": "setTool", "with": { "args": { "tool": "marquee" } } },
		"shift+m": { "do": "setTool", "with": { "args": { "tool": "ellipse" } } },
		"l": { "do": "setTool", "with": { "args": { "tool": "lasso" } } },
		"shift+l": { "do": "setTool", "with": { "args": { "tool": "polygon" } } },
		"w": { "do": "setTool", "with": { "args": { "tool": "wand" } } },
		"c": { "do": "setTool", "with": { "args": { "tool": "crop" } } },
		"b": { "do": "setTool", "with": { "args": { "tool": "brush" } } },
		"e": { "do": "setTool", "with": { "args": { "tool": "eraser" } } },
		"s": { "do": "setTool", "with": { "args": { "tool": "clone" } } },
		"g": { "do": "setTool", "with": { "args": { "tool": "gradient" } } },
		"shift+g": { "do": "setTool", "with": { "args": { "tool": "fill" } } },
		"i": { "do": "setTool", "with": { "args": { "tool": "eyedropper" } } },
		"h": { "do": "setTool", "with": { "args": { "tool": "hand" } } },
		"z": { "do": "setTool", "with": { "args": { "tool": "zoom" } } },
		"d": "resetColours",
		"x": "swapColours",
		"q": "toggleQuickMask",
		"comma": "brushSmaller",
		"period": "brushLarger",
		"alt+backspace": "fillForeground",
		"mod+n": "showNewDialog",
		"mod+o": "openFile",
		"mod+s": "saveProject",
		"mod+shift+e": "exportPng",
		"mod+z": "undo",
		"mod+shift+z": "redo",
		"mod+a": "selectAll",
		"mod+d": "deselect",
		"mod+shift+i": "invertSelection",
		"mod+shift+n": "newLayer",
		"mod+j": "duplicateActive",
		"mod+g": "newGroup",
		"mod+alt+g": "toggleClipping",
		"mod+up": "layerUp",
		"mod+down": "layerDown",
		"mod+y": "toggleProof",
		"mod+equal": "zoomIn",
		"mod+minus": "zoomOut",
		"mod+0": "fitOnScreen",
		"mod+1": "actualPixels",
		"mod+r": "toggleRulers"
	},

	"menus": {
		"file": {
			"new": { "run": "showNewDialog", "group": "1_new", "order": 1 },
			"sample": { "run": "newSample", "group": "1_new", "order": 2 },
			"open": { "run": "openFile", "group": "1_new", "order": 3 },
			"save": { "run": "saveProject", "group": "2_save", "order": 1 },
			"png": { "run": "exportPng", "group": "2_save", "order": 2 },
			"jpeg": { "run": "exportJpeg", "group": "2_save", "order": 3 },
			"revert": { "run": "revert", "group": "3_revert" }
		},
		"edit": {
			"undo": { "run": "undo", "group": "1_history", "order": 1 },
			"redo": { "run": "redo", "group": "1_history", "order": 2 },
			"fill": { "run": "fillForeground", "group": "2_fill" },
			"swap": { "run": "swapColours", "group": "3_colours", "order": 1 },
			"reset": { "run": "resetColours", "group": "3_colours", "order": 2 }
		},
		"image": {
			"crop": { "run": "cropToSelection", "group": "1_size" },
			"working": { "submenu": "workingSpace", "title": "Working Space", "group": "2_colour", "order": 1 },
			"proof": { "submenu": "proofSpace", "title": "Proof Setup", "group": "2_colour", "order": 2 },
			"proofColours": { "run": "toggleProof", "group": "2_colour", "order": 3 }
		},
		"workingSpace": {
			"srgb": { "run": "setProfile", "with": { "args": { "working": "srgb" } }, "title": "sRGB", "order": 1 },
			"displayP3": { "run": "setProfile", "with": { "args": { "working": "displayP3" } }, "title": "Display P3", "order": 2 },
			"wideRgb": { "run": "setProfile", "with": { "args": { "working": "wideRgb" } }, "title": "Wide RGB", "order": 3 },
			"gray": { "run": "setProfile", "with": { "args": { "working": "gray" } }, "title": "Grey", "order": 4 }
		},
		"proofSpace": {
			"none": { "run": "setProfile", "with": { "args": { "proof": "" } }, "title": "None", "group": "1_none" },
			"srgb": { "run": "setProfile", "with": { "args": { "proof": "srgb" } }, "title": "sRGB", "group": "2_spaces", "order": 1 },
			"displayP3": { "run": "setProfile", "with": { "args": { "proof": "displayP3" } }, "title": "Display P3", "group": "2_spaces", "order": 2 },
			"gray": { "run": "setProfile", "with": { "args": { "proof": "gray" } }, "title": "Grey", "group": "2_spaces", "order": 3 }
		},
		"layer": {
			"new": { "run": "newLayer", "group": "1_new", "order": 1 },
			"group": { "run": "newGroup", "group": "1_new", "order": 2 },
			"adjustment": { "submenu": "adjustmentLayers", "title": "New Adjustment Layer", "group": "1_new", "order": 3 },
			"duplicate": { "run": "duplicateActive", "group": "2_layer", "order": 1 },
			"delete": { "run": "deleteActive", "group": "2_layer", "order": 2 },
			"addMask": { "run": "addLayerMask", "group": "3_mask", "order": 1 },
			"deleteMask": { "run": "deleteLayerMask", "group": "3_mask", "order": 2 },
			"clip": { "run": "toggleClipping", "group": "3_mask", "order": 3 },
			"up": { "run": "layerUp", "group": "4_order", "order": 1 },
			"down": { "run": "layerDown", "group": "4_order", "order": 2 }
		},
		"adjustmentLayers": {
			"levels": { "run": "addLayer", "with": { "args": { "kind": "levels", "name": "Levels" } }, "title": "Levels...", "order": 1 },
			"curves": { "run": "addLayer", "with": { "args": { "kind": "curves", "name": "Curves" } }, "title": "Curves...", "order": 2 },
			"hueSaturation": { "run": "addLayer", "with": { "args": { "kind": "hue-saturation", "name": "Hue/Saturation" } }, "title": "Hue/Saturation...", "order": 3 },
			"colorBalance": { "run": "addLayer", "with": { "args": { "kind": "color-balance", "name": "Colour Balance" } }, "title": "Colour Balance...", "order": 4 },
			"brightnessContrast": { "run": "addLayer", "with": { "args": { "kind": "brightness-contrast", "name": "Brightness/Contrast" } }, "title": "Brightness/Contrast...", "order": 5 },
			"invert": { "run": "addLayer", "with": { "args": { "kind": "invert", "name": "Invert" } }, "title": "Invert", "order": 6 },
			"threshold": { "run": "addLayer", "with": { "args": { "kind": "threshold", "name": "Threshold" } }, "title": "Threshold...", "order": 7 },
			"gradientMap": { "run": "addLayer", "with": { "args": { "kind": "gradient-map", "name": "Gradient Map" } }, "title": "Gradient Map...", "order": 8 }
		},
		"select": {
			"all": { "run": "selectAll", "group": "1_select", "order": 1 },
			"none": { "run": "deselect", "group": "1_select", "order": 2 },
			"inverse": { "run": "invertSelection", "group": "1_select", "order": 3 },
			"colorRange": { "run": "colorRange", "group": "2_range" },
			"feather": { "run": "featherSelection", "group": "3_modify" },
			"quickMask": { "run": "toggleQuickMask", "group": "4_mask" }
		},
		"filter": {
			"gaussianBlur": { "run": "showFilter", "with": { "args": { "kind": "gaussian-blur" } }, "title": "Gaussian Blur...", "group": "1_blur", "order": 1 },
			"motionBlur": { "run": "showFilter", "with": { "args": { "kind": "motion-blur" } }, "title": "Motion Blur...", "group": "1_blur", "order": 2 },
			"sharpen": { "run": "showFilter", "with": { "args": { "kind": "sharpen" } }, "title": "Sharpen...", "group": "2_sharpen", "order": 1 },
			"unsharpMask": { "run": "showFilter", "with": { "args": { "kind": "unsharp-mask" } }, "title": "Unsharp Mask...", "group": "2_sharpen", "order": 2 },
			"addNoise": { "run": "showFilter", "with": { "args": { "kind": "add-noise" } }, "title": "Add Noise...", "group": "3_noise" }
		},
		"view": {
			"zoomIn": { "run": "zoomIn", "group": "1_zoom", "order": 1 },
			"zoomOut": { "run": "zoomOut", "group": "1_zoom", "order": 2 },
			"fit": { "run": "fitOnScreen", "group": "1_zoom", "order": 3 },
			"actual": { "run": "actualPixels", "group": "1_zoom", "order": 4 },
			"rulers": { "run": "toggleRulers", "group": "2_show", "order": 1 },
			"guides": { "run": "toggleGuides", "group": "2_show", "order": 2 },
			"clearGuides": { "run": "clearGuides", "group": "2_show", "order": 3 },
			"theme": { "run": "toggleTheme", "group": "3_theme" }
		},
		"window": {
			"navigator": { "run": "showPanel", "with": { "args": { "slot": "top", "id": "navigator" } }, "title": "Navigator", "group": "1_top", "order": 1 },
			"color": { "run": "showPanel", "with": { "args": { "slot": "top", "id": "color" } }, "title": "Colour", "group": "1_top", "order": 2 },
			"swatches": { "run": "showPanel", "with": { "args": { "slot": "top", "id": "swatches" } }, "title": "Swatches", "group": "1_top", "order": 3 },
			"properties": { "run": "showPanel", "with": { "args": { "slot": "top", "id": "properties" } }, "title": "Properties", "group": "1_top", "order": 4 },
			"layers": { "run": "showPanel", "with": { "args": { "slot": "bottom", "id": "layers" } }, "title": "Layers", "group": "2_bottom", "order": 1 },
