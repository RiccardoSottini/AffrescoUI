{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Tempera's panels and dialogs. The dock on the right holds three tabbed groups (Colour | Swatches, Properties | Adjustments, Layers | Channels | Paths), and an icon strip beside it opens History and the Navigator. Every change goes through a tempera.* native, which returns the new snapshot into state.doc; the filter dialog only edits state.filter, and watches (parts/commands.json) preview, apply or cancel it.",

	"computed": {
		"adjustment": "{{computed.activeLayer.adjustment}}",
		"adjustmentKind": "{{computed.activeLayer.adjustment.kind ?? ''}}",
		"filterTitle": "{{find(state.filters, it.id == state.filter.kind).title ?? 'Filter'}}",
		"blendTitle": "{{join(map(split(computed.activeLayer.blend ?? 'normal', '-'), upper(slice(it, 0, 1)) + slice(it, 1)), ' ')}}"
	},

	"components": {
		"tGroup": {
			"params": { "slot": "", "tabs": [] },
			"node": {
				"type": "column", "id": "group-{{slot}}", "width": "100%", "color": "@panel",
				"children": [
					{ "type": "tabs", "id": "panel-tabs-{{slot}}", "width": "100%", "height": 24, "color": "@header",
					  "tabs": "{{map(tabs, {id: lower(it), label: it, closable: false})}}", "value": "{{state.panels[slot]}}",
					  "textColor": "@muted", "activeTextColor": "@text", "activeBackground": "@panel", "accentColor": "@panel",
					  "onChange": { "run": "showPanel", "with": { "args": { "slot": "{{slot}}", "id": "{{event.value}}" } } } },
					{ "id": "panel-{{slot}}", "style": "clear", "width": "100%", "grow": 1, "children": [{ "slot": true }] }
				]
			}
		},
		"tPopout": {
			"params": { "name": "", "icon": "", "title": "", "height": 300 },
			"node": {
				"id": "{{name}}-popout-anchor", "style": "clear", "width": 28, "height": 26,
				"children": [
					{ "use": "tIcon", "id": "{{name}}-button", "width": 28, "height": 26,
					  "with": { "icon": "{{icon}}", "tip": "{{title}}", "on": "{{state.popout[name]}}", "run": "showPopout", "args": { "id": "{{name}}" } } },
					{ "type": "column", "id": "{{name}}-popout", "role": "region", "label": "{{title}}", "width": 250, "height": "{{height}}", "color": "@panel",
					  "borderWidth": 1, "borderColor": "@background", "overlay": { "placement": "left", "open": "{{'state.popout.' + name}}", "dismiss": "outside" },
					  "children": [
						{ "type": "label", "text": "{{title}}", "textColor": "@text", "width": "100%", "height": 24, "padding": 8, "color": "@header" },
						{ "style": "clear", "width": "100%", "grow": 1, "children": [{ "slot": true }] }
					  ] }
				]
			}
		},
		"tAdjustSlider": {
			"params": { "title": "", "key": "", "value": 0, "min": 0, "max": 100, "scale": 100 },
			"node": {
				"type": "row", "height": 26, "alignItems": "center", "gap": 6, "width": "100%",
				"children": [
					{ "style": "dim", "fitText": false, "text": "{{title}}", "width": 74, "height": 20 },
					{ "type": "slider", "label": "{{title}}", "grow": 1, "height": 16, "min": "{{min}}", "max": "{{max}}", "step": 1,
					  "value": "{{round(value * scale)}}", "trackColor": "@border", "activeColor": "@muted", "knobColor": "@text",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment":
					    "{{merge(computed.adjustment, parseJson('{' + json(key) + ': ' + json(event.value / scale) + '}'))}}" } } } },
					{ "type": "label", "text": "{{round(value * scale)}}", "textColor": "@text", "width": 34, "height": 20 }
				]
			}
		},
		"tBalanceSlider": {
			"params": { "title": "", "channel": 0 },
			"node": {
				"type": "row", "height": 26, "alignItems": "center", "gap": 6, "width": "100%",
				"children": [
					{ "style": "dim", "fitText": false, "text": "{{title}}", "width": 74, "height": 20 },
					{ "type": "slider", "label": "{{title}}", "grow": 1, "height": 16, "min": -100, "max": 100, "step": 1,
					  "value": "{{round(computed.adjustment.balance[channel] * 100)}}", "trackColor": "@border", "activeColor": "@muted", "knobColor": "@text",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment":
					    "{{merge(computed.adjustment, {balance: map(range(3), it == channel ? event.value / 100 : computed.adjustment.balance[it])})}}" } } } },
					{ "type": "label", "text": "{{round(computed.adjustment.balance[channel] * 100)}}", "textColor": "@text", "width": 34, "height": 20 }
				]
			}
		},
		"tFilterSlider": {
			"params": { "title": "", "key": "", "min": 0, "max": 100 },
			"node": {
				"type": "row", "height": 28, "alignItems": "center", "gap": 8, "width": "100%",
				"children": [
					{ "style": "dim", "fitText": false, "text": "{{title}}", "width": 80, "height": 20 },
					{ "type": "slider", "id": "filter-{{key}}", "label": "{{title}}", "grow": 1, "height": 16, "min": "{{min}}", "max": "{{max}}",
					  "step": 1, "value": "{{state.filter[key]}}", "trackColor": "@border", "activeColor": "@accent", "knobColor": "@text",
					  "onChange": [{ "set": "state.filter[key]", "to": "{{event.value}}" }] },
					{ "type": "label", "text": "{{round(state.filter[key])}}", "textColor": "@text", "width": 40, "height": 20 }
				]
			}
		},

		"temperaPanels": {
			"node": {
				"type": "row", "id": "dock", "width": 297, "height": "100%", "gap": 1,
				"children": [
					{ "type": "column", "id": "panel-icons", "role": "toolbar", "label": "Collapsed panels", "width": 34, "height": "100%",
					  "color": "@panel", "alignItems": "center", "gap": 2,
					  "children": [
						{ "height": 4, "width": 1, "style": "clear" },
						{ "use": "tPopout", "with": { "name": "history", "icon": "history", "title": "History" }, "children": [{ "use": "temperaHistory" }] },
						{ "use": "tPopout", "with": { "name": "navigator", "icon": "compass", "title": "Navigator", "height": 250 }, "children": [{ "use": "temperaNavigator" }] }
					  ] },
					{ "type": "column", "id": "panels", "point": "panels.dock", "role": "complementary", "label": "Panels", "width": 262, "height": "100%",
					  "color": "@background",
					  "children": [
						{ "use": "tGroup", "height": 170, "with": { "slot": "colour", "tabs": ["Colour", "Swatches"] }, "children": [
							{ "use": "temperaColour", "when": "{{state.panels.colour == 'colour'}}" },
							{ "use": "temperaSwatches", "when": "{{state.panels.colour == 'swatches'}}" }
						] },
						{ "id": "panels-split-1", "style": "clear", "width": "100%", "height": 1 },
						{ "use": "tGroup", "height": 200, "with": { "slot": "properties", "tabs": ["Properties", "Adjustments"] }, "children": [
							{ "use": "temperaProperties", "when": "{{state.panels.properties == 'properties'}}" },
							{ "use": "temperaAdjustments", "when": "{{state.panels.properties == 'adjustments'}}" }
						] },
						{ "id": "panels-split-2", "style": "clear", "width": "100%", "height": 1 },
						{ "use": "tGroup", "grow": 1, "with": { "slot": "layers", "tabs": ["Layers", "Channels", "Paths"] }, "children": [
							{ "use": "temperaLayers", "when": "{{state.panels.layers == 'layers'}}" },
							{ "use": "temperaChannels", "when": "{{state.panels.layers == 'channels'}}" },
							{ "style": "dim", "id": "paths-empty", "when": "{{state.panels.layers == 'paths'}}", "anchors": { "left": 10, "top": 10 },
							  "text": "No paths: the pen tool isn't available yet." }
						] }
					  ] }
				]
			}
		},

		"temperaNavigator": {
			"node": {
				"type": "column", "id": "navigator", "fill": true, "gap": 6, "alignItems": "center",
				"children": [
					{ "height": 4, "width": 1, "style": "clear" },
					{ "type": "image", "id": "navigator-picture", "label": "Navigator", "source": "navigator", "fit": "contain",
					  "width": 234, "height": 170, "color": "@canvasBack" },
					{ "type": "row", "id": "navigator-zoom", "height": 26, "gap": 4, "alignItems": "center",
					  "children": [
						{ "type": "label", "id": "navigator-percent", "text": "{{computed.zoomPercent}}%", "textColor": "@text", "width": 56, "height": 22 },
						{ "use": "tIcon", "id": "navigator-out", "with": { "icon": "zoom-out", "run": "zoomOut", "tip": "Zoom Out" } },
						{ "use": "tIcon", "id": "navigator-fit", "with": { "icon": "maximize", "run": "fitOnScreen", "tip": "Fit on Screen" } },
						{ "use": "tIcon", "id": "navigator-in", "with": { "icon": "zoom-in", "run": "zoomIn", "tip": "Zoom In" } }
					  ] }
				]
			}
		},

		"temperaColour": {
			"node": {
				"type": "colorPicker", "id": "colour-picker", "label": "Foreground colour", "anchors": { "left": 8, "right": 8, "top": 6, "bottom": 6 },
				"value": "{{state.doc.foreground}}", "fields": false, "alpha": false, "textColor": "@text", "accentColor": "@accent",
				"onChange": { "run": "setOptions", "with": { "args": { "foreground": "{{event.value}}" } } }
			}
		},

		"temperaSwatches": {
			"node": {
				"type": "grid", "id": "swatches", "role": "group", "label": "Swatches", "columns": 12, "gap": 3,
				"anchors": { "left": 8, "right": 8, "top": 8 }, "height": 40,
				"children": [
					{ "id": "swatch-{{index}}", "repeat": { "for": "swatch", "in": "state.swatches", "index": "index" }, "role": "button",
					  "label": "Swatch {{swatch}}", "tooltip": "{{swatch}}", "width": 17, "height": 17, "color": "{{swatch}}",
					  "borderWidth": 1, "borderColor": "@border", "cursor": "hand", "hover": { "borderColor": "@text" },
					  "onClick": { "run": "setOptions", "with": { "args": { "foreground": "{{swatch}}" } } } }
				]
			}
		},

		"temperaProperties": {
			"node": {
				"type": "column", "id": "properties", "role": "region", "label": "Properties", "anchors": { "left": 10, "right": 10, "top": 6, "bottom": 6 },
				"gap": 4, "scroll": "vertical",
				"children": [
					{ "type": "label", "id": "properties-kind", "textColor": "@text", "fitText": true,
					  "icon": "{{!computed.activeLayer ? 'circle-off' : computed.activeLayer.kind == 'group' ? 'folder' : computed.adjustment ? 'contrast' : 'image'}}",
					  "text": "{{!computed.activeLayer ? 'No layer' : computed.activeLayer.kind == 'group' ? 'Group' : computed.adjustment ? (find(state.adjustments, it.id == computed.adjustmentKind).title ?? '') : 'Pixel Layer'}}" },
					{ "style": "dim", "id": "properties-name", "when": "{{computed.activeLayer && !computed.adjustment}}",
					  "text": "{{computed.activeLayer.name}}: {{computed.blendTitle}}, {{computed.activeLayer.opacity}}% opacity" },
					{ "id": "properties-line", "width": "100%", "height": 1, "color": "@border" },
					{ "use": "tAdjustSlider", "id": "adjust-input-black", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Input black", "key": "inputBlack", "value": "{{computed.adjustment.inputBlack}}", "max": 255, "scale": 255 } },
					{ "use": "tAdjustSlider", "id": "adjust-input-white", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Input white", "key": "inputWhite", "value": "{{computed.adjustment.inputWhite}}", "max": 255, "scale": 255 } },
					{ "use": "tAdjustSlider", "id": "adjust-gamma", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Gamma", "key": "gamma", "value": "{{computed.adjustment.gamma}}", "min": 10, "max": 400, "scale": 100 } },
					{ "use": "tAdjustSlider", "id": "adjust-output-black", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Output black", "key": "outputBlack", "value": "{{computed.adjustment.outputBlack}}", "max": 255, "scale": 255 } },
					{ "use": "tAdjustSlider", "id": "adjust-output-white", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Output white", "key": "outputWhite", "value": "{{computed.adjustment.outputWhite}}", "max": 255, "scale": 255 } },
					{ "type": "curves", "id": "adjust-curve", "label": "Curve", "when": "{{computed.adjustmentKind == 'curves'}}", "width": 200, "height": 140,
					  "value": "{{merge({points: []}, {points: computed.adjustment.curve})}}", "accentColor": "@accent",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment": "{{merge(computed.adjustment, {curve: event.value.points})}}" } } } },
					{ "use": "tAdjustSlider", "id": "adjust-hue", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Hue", "key": "hue", "value": "{{computed.adjustment.hue}}", "min": -180, "max": 180, "scale": 1 } },
					{ "use": "tAdjustSlider", "id": "adjust-saturation", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Saturation", "key": "saturation", "value": "{{computed.adjustment.saturation}}", "min": -100 } },
					{ "use": "tAdjustSlider", "id": "adjust-lightness", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Lightness", "key": "lightness", "value": "{{computed.adjustment.lightness}}", "min": -100 } },
					{ "use": "tBalanceSlider", "id": "adjust-cyan-red", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Cyan / Red", "channel": 0 } },
					{ "use": "tBalanceSlider", "id": "adjust-magenta-green", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Mag. / Green", "channel": 1 } },
					{ "use": "tBalanceSlider", "id": "adjust-yellow-blue", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Yellow / Blue", "channel": 2 } },
					{ "use": "tAdjustSlider", "id": "adjust-brightness", "when": "{{computed.adjustmentKind == 'brightness-contrast'}}",
					  "with": { "title": "Brightness", "key": "brightness", "value": "{{computed.adjustment.brightness}}", "min": -100 } },
					{ "use": "tAdjustSlider", "id": "adjust-contrast", "when": "{{computed.adjustmentKind == 'brightness-contrast'}}",
					  "with": { "title": "Contrast", "key": "contrast", "value": "{{computed.adjustment.contrast}}", "min": -100 } },
					{ "use": "tAdjustSlider", "id": "adjust-level", "when": "{{computed.adjustmentKind == 'threshold'}}",
					  "with": { "title": "Level", "key": "level", "value": "{{computed.adjustment.level}}", "max": 255, "scale": 255 } },
					{ "style": "dim", "fitText": false, "id": "adjust-plain", "width": "100%", "height": 34, "wrap": true,
					  "when": "{{!computed.adjustment || computed.adjustmentKind == 'invert' || computed.adjustmentKind == 'gradient-map'}}",
					  "text": "{{computed.adjustmentKind == 'invert' ? 'Inverts the colours below.' : computed.adjustment ? 'Maps the lightness below to the foreground and background colours.' : 'Transform and alignment are not available yet.'}}" }
				]
			}
		},

		"temperaAdjustments": {
			"node": {
				"type": "column", "id": "adjustments", "role": "region", "label": "Adjustments", "anchors": { "left": 10, "right": 10, "top": 8, "bottom": 8 }, "gap": 8,
				"children": [
					{ "style": "dim", "text": "Add an adjustment" },
					{ "type": "row", "id": "adjustment-icons", "width": "100%", "height": 24, "gap": 3,
					  "children": [
						{ "use": "tIcon", "repeat": { "for": "a", "in": "state.adjustments" }, "id": "adjustment-{{a.id}}",
						  "with": { "icon": "{{a.icon}}", "tip": "{{a.title}}", "run": "addLayer", "args": { "kind": "{{a.id}}", "name": "{{a.title}}" } } }
					  ] }
				]
			}
		},

		"temperaChannels": {
			"node": {
				"type": "column", "id": "channels", "role": "list", "label": "Channels", "fill": true,
				"children": [
					{ "type": "row", "repeat": { "for": "c", "in": "{{['RGB', 'Red', 'Green', 'Blue']}}", "index": "i" }, "role": "listitem", "label": "{{c}}",
					  "width": "100%", "height": 34, "alignItems": "center", "gap": 8, "color": "{{i == 0 ? '@selected' : 'transparent'}}",
					  "children": [
						{ "type": "label", "icon": "eye", "textColor": "@text", "width": 26, "height": 20, "align": "center" },
						{ "type": "image", "source": "navigator", "fit": "contain", "width": 30, "height": 26, "color": "@canvasBack", "visible": "{{i == 0}}" },
						{ "type": "label", "text": "{{c}}", "textColor": "@text", "grow": 1, "height": 20 },
						{ "style": "dim", "text": "Cmd+{{i + 2}}" },
						{ "width": 6, "height": 1, "style": "clear" }
					  ] },
					{ "style": "dim", "anchors": { "left": 10 }, "text": "Editing single channels isn't available yet." }
				]
			}
		},

		"temperaLayers": {
			"node": {
				"type": "column", "id": "layers", "role": "region", "label": "Layers", "fill": true,
				"children": [
					{ "type": "row", "id": "layers-blend-row", "height": 30, "width": "100%", "gap": 6, "alignItems": "center",
					  "children": [
						{ "width": 2, "height": 1, "style": "clear" },
						{ "use": "tPicker", "id": "layer-blend", "with": { "title": "{{computed.blendTitle}}", "tip": "Blend mode", "width": 104, "open": "state.blendMenu",
						  "items": "{{map(state.blends, it == '-' ? {separator: true} : {title: join(map(split(it, '-'), upper(slice(it, 0, 1)) + slice(it, 1)), ' '), checked: it == computed.activeLayer.blend, run: 'setLayer', with: {args: {blend: it}}})}}" } },
						{ "grow": 1, "height": 1, "style": "clear" },
						{ "use": "tSlider", "id": "layer-opacity", "with": { "title": "Opacity", "key": "opacity", "value": "{{computed.activeLayer.opacity ?? 100}}", "run": "setLayer", "width": 36 } }
					  ] },
					{ "type": "row", "id": "layers-lock-row", "height": 26, "width": "100%", "gap": 2, "alignItems": "center",
					  "children": [
						{ "width": 6, "height": 1, "style": "clear" },
						{ "style": "dim", "text": "Lock:" },
						{ "use": "tIcon", "id": "lock-pixels", "with": { "icon": "brush", "tip": "Lock image pixels", "on": "{{computed.activeLayer.lockPixels}}",
						  "run": "setLayer", "args": { "lockPixels": "{{!computed.activeLayer.lockPixels}}" } } },
						{ "use": "tIcon", "id": "lock-position", "with": { "icon": "move", "tip": "Lock position", "on": "{{computed.activeLayer.lockPosition}}",
						  "run": "setLayer", "args": { "lockPosition": "{{!computed.activeLayer.lockPosition}}" } } },
						{ "use": "tIcon", "id": "lock-all", "with": { "icon": "lock", "tip": "Lock all", "on": "{{computed.activeLayer.lockAll}}",
						  "run": "setLayer", "args": { "lockAll": "{{!computed.activeLayer.lockAll}}" } } },
						{ "grow": 1, "height": 1, "style": "clear" },
						{ "style": "dim", "id": "layer-fill", "tooltip": "Fill opacity isn't available yet", "text": "Fill: 100%" },
						{ "width": 8, "height": 1, "style": "clear" }
					  ] },
					{ "width": "100%", "height": 1, "color": "@border" },
					{ "type": "column", "id": "layer-rows", "role": "list", "label": "Layers", "width": "100%", "grow": 1, "scroll": "vertical",
					  "children": [
						{ "type": "row", "id": "layer-{{layer.id}}", "repeat": { "for": "layer", "in": "state.doc.layers", "key": "{{layer.id}}" },
						  "role": "listitem", "label": "{{layer.name}}", "selected": "{{layer.id == state.doc.active}}", "width": "100%", "height": 36,
						  "alignItems": "center", "gap": 5, "cursor": "hand",
						  "color": "{{layer.id == state.doc.active ? '@selected' : 'transparent'}}", "hover": { "color": "@hover" },
						  "drag": { "data": { "id": "{{layer.id}}" } },
						  "onDrop": { "run": "moveLayer", "with": { "args": { "id": "{{event.data.id}}", "onto": "{{layer.id}}" } } },
						  "onClick": { "run": "selectLayer", "with": { "args": { "id": "{{layer.id}}" } } },
						  "children": [
							{ "type": "label", "id": "layer-eye-{{layer.id}}", "role": "button", "label": "Visibility of {{layer.name}}",
							  "icon": "{{layer.visible ? 'eye' : ''}}", "width": 26, "height": 36, "align": "center", "cursor": "hand", "textColor": "@text",
							  "borderWidth": 1, "borderColor": "@background",
							  "onClick": { "run": "setLayer", "with": { "args": { "id": "{{layer.id}}", "visible": "{{!layer.visible}}" } } } },
							{ "style": "clear", "width": "{{layer.depth * 14}}", "height": 1 },
							{ "type": "label", "when": "{{layer.kind == 'group'}}", "icon": "chevron-down", "textColor": "@muted", "width": 12 },
							{ "type": "label", "id": "layer-clip-{{layer.id}}", "when": "{{layer.clipped}}", "icon": "corner-left-down", "textColor": "@muted",
							  "width": 14, "tooltip": "Clipped to the layer below" },
							{ "type": "image", "id": "layer-thumb-{{layer.id}}", "when": "{{!empty(layer.thumbnail)}}", "source": "{{layer.thumbnail}}",
							  "fit": "contain", "width": 30, "height": 28, "color": "@canvasBack", "borderWidth": 1, "borderColor": "@border" },
							{ "type": "label", "id": "layer-icon-{{layer.id}}", "when": "{{empty(layer.thumbnail)}}",
							  "icon": "{{layer.kind == 'group' ? 'folder' : 'contrast'}}", "font": "iconsLarge", "width": 30, "height": 28,
							  "align": "center", "textColor": "@text" },
							{ "type": "label", "id": "layer-mask-{{layer.id}}", "when": "{{layer.mask}}", "icon": "link", "font": "small", "textColor": "@muted",
							  "width": 10, "tooltip": "Layer mask, linked" },
							{ "when": "{{layer.mask}}", "width": 30, "height": 28, "color": "#ffffff", "borderWidth": 1, "borderColor": "@border", "tooltip": "Layer mask" },
							{ "type": "label", "id": "layer-name-{{layer.id}}", "text": "{{layer.name}}", "textColor": "@text", "grow": 1, "height": 20 },
							{ "type": "label", "id": "layer-lock-{{layer.id}}", "when": "{{layer.lockAll || layer.lockPixels || layer.lockPosition}}",
							  "icon": "lock", "textColor": "@muted", "width": 16, "tooltip": "Locked" },
							{ "width": 6, "height": 1, "style": "clear" }
						  ] }
					  ] },
					{ "type": "row", "id": "layer-buttons", "role": "toolbar", "label": "Layer actions", "width": "100%", "height": 28,
					  "alignItems": "center", "justify": "end", "gap": 2, "color": "@panel",
					  "children": [
						{ "use": "tIcon", "id": "layer-link", "with": { "icon": "link", "tip": "Link layers, not available yet", "off": true } },
						{ "use": "tIcon", "id": "layer-fx", "with": { "icon": "sparkles", "tip": "Layer style, not available yet", "off": true } },
						{ "use": "tIcon", "id": "layer-add-mask", "with": { "icon": "circle-dot", "tip": "Add layer mask", "run": "addLayerMask" } },
						{ "use": "tIcon", "id": "layer-adjust", "with": { "icon": "contrast", "tip": "New fill or adjustment layer", "on": "{{state.adjustMenu}}" },
						  "onClick": [{ "toggle": "state.adjustMenu" }],
						  "children": [
							{ "use": "menu", "id": "adjust-menu", "with": { "open": "state.adjustMenu", "placement": "above", "width": 200, "icons": true,
							  "items": "{{map(state.adjustments, {title: it.title + '...', icon: it.icon, run: 'addLayer', with: {args: {kind: it.id, name: it.title}}})}}" } }
						  ] },
						{ "use": "tIcon", "id": "layer-new-group", "with": { "icon": "folder", "tip": "Create a new group", "run": "newGroup" } },
						{ "use": "tIcon", "id": "layer-new", "with": { "icon": "plus-square", "tip": "Create a new layer", "run": "newLayer" } },
						{ "use": "tIcon", "id": "layer-delete", "with": { "icon": "trash-2", "tip": "Delete layer", "run": "deleteActive" } },
						{ "width": 6, "height": 1, "style": "clear" }
					  ] }
				]
			}
		},

		"temperaHistory": {
			"node": {
				"type": "column", "id": "history", "fill": true,
				"children": [
					{ "type": "list", "id": "history-list", "label": "History", "width": "100%", "grow": 1, "color": "@panel", "rowHeight": 24,
					  "items": "{{state.doc.history}}", "value": "{{text(state.doc.position)}}", "textColor": "@text",
					  "selectedTextColor": "@text", "selectedBackground": "@selected", "accentColor": "@accent",
					  "onChange": { "run": "goToHistory", "with": { "args": { "position": "{{number(event.value)}}" } } } },
					{ "style": "dim", "fitText": false, "id": "history-dropped", "when": "{{state.doc.dropped > 0}}", "font": "small",
					  "text": "{{state.doc.dropped}} older steps dropped to stay within the undo memory", "width": "100%", "height": 18, "padding": 4 }
				]
			}
		},

		"temperaFilterDialog": {
			"node": {
				"style": "clear", "width": 0, "height": 0, "children": [{
				"use": "dialog", "id": "filter-dialog",
				"with": { "open": "state.filter.open", "title": "{{computed.filterTitle}}", "message": "", "width": 380, "height": 250,
				          "buttons": [{ "title": "Cancel", "run": "discardFilter" }, { "title": "OK", "run": "commitFilter" }] },
				"children": [
					{ "type": "column", "id": "filter-fields", "anchors": { "left": 20, "right": 20, "top": 44, "bottom": 52 }, "gap": 2,
					  "children": [
						{ "use": "tFilterSlider", "when": "{{state.filter.kind != 'add-noise' && state.filter.kind != 'motion-blur'}}",
						  "with": { "title": "Radius", "key": "radius", "min": 1, "max": 100 } },
						{ "use": "tFilterSlider", "when": "{{state.filter.kind != 'gaussian-blur' && state.filter.kind != 'motion-blur'}}",
						  "with": { "title": "Amount", "key": "amount", "min": 1, "max": 500 } },
						{ "use": "tFilterSlider", "when": "{{state.filter.kind == 'unsharp-mask'}}",
						  "with": { "title": "Threshold", "key": "threshold", "max": 255 } },
						{ "use": "tFilterSlider", "when": "{{state.filter.kind == 'motion-blur'}}",
						  "with": { "title": "Angle", "key": "angle", "min": -180, "max": 180 } },
						{ "use": "tFilterSlider", "when": "{{state.filter.kind == 'motion-blur'}}",
						  "with": { "title": "Distance", "key": "distance", "min": 1, "max": 200 } },
						{ "type": "row", "id": "filter-live-row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "type": "checkbox", "id": "filter-live", "label": "Preview", "width": 14, "height": 14, "bind": "state.filter.live",
							  "activeColor": "@accent", "trackColor": "@border", "knobColor": "@input" },
							{ "type": "label", "text": "Preview", "textColor": "@text", "fitText": true }
						  ] }
					  ] }
				]
				}]
			}
		},

		"temperaNewDialog": {
			"node": {
				"style": "clear", "width": 0, "height": 0, "children": [{
				"use": "dialog", "id": "new-dialog",
				"with": { "open": "state.newDoc.open", "title": "New Document", "message": "", "width": 360, "height": 230,
				          "buttons": [{ "title": "Cancel" }, { "title": "Create", "run": "createDocument" }] },
				"children": [
					{ "type": "column", "id": "new-fields", "anchors": { "left": 20, "right": 20, "top": 44, "bottom": 52 }, "gap": 6,
					  "children": [
						{ "type": "row", "repeat": { "for": "f", "in": "{{['width', 'height']}}" }, "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "style": "dim", "fitText": false, "text": "{{upper(slice(f, 0, 1)) + slice(f, 1)}}", "width": 70, "height": 20 },
							{ "type": "textarea", "id": "new-{{f}}", "label": "{{f}}", "width": 100, "height": 24, "padding": 4, "color": "@input", "textColor": "@text",
							  "borderWidth": 1, "borderColor": "@border", "radius": 2, "bind": "{{'state.newDoc.' + f}}" },
							{ "style": "dim", "text": "Pixels" }
						  ] },
						{ "type": "row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "style": "dim", "fitText": false, "text": "Bit depth", "width": 70, "height": 20 },
							{ "type": "tabs", "id": "new-format", "width": 200, "height": 24, "bind": "state.newDoc.format",
							  "tabs": [{ "id": "rgba8", "label": "8 bit", "closable": false }, { "id": "rgba16f", "label": "16 bit float", "closable": false }],
							  "textColor": "@muted", "activeTextColor": "@text", "activeBackground": "@selected", "accentColor": "@accent" }
						  ] }
					  ] }
				]
				}]
			}
		}
	}
}
