{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Tempera's panels and dialogs. Two stacks on the right, each with tabs: Navigator, Colour, Swatches and Properties above, Layers and History below. Every change goes through a tempera.* native, which returns the new snapshot into state.doc; the filter dialog only edits state.filter, and watches (parts/commands.json) preview, apply or cancel it.",

	"computed": {
		"adjustment": "{{computed.activeLayer.adjustment}}",
		"adjustmentKind": "{{computed.activeLayer.adjustment.kind ?? ''}}",
		"filterTitle": "{{find(state.filters, it.id == state.filter.kind).title ?? 'Filter'}}"
	},

	"components": {
		"temperaTab": {
			"params": { "slot": "top", "tabs": [] },
			"node": {
				"type": "tabs", "id": "panel-tabs-{{slot}}", "width": "100%", "height": 28, "color": "@panel", "tabs": "{{tabs}}",
				"value": "{{state.panels[slot]}}", "textColor": "@muted", "activeTextColor": "@text", "activeBackground": "@background",
				"accentColor": "@accent", "onChange": { "run": "showPanel", "with": { "args": { "slot": "{{slot}}", "id": "{{event.value}}" } } }
			}
		},
		"temperaAdjustSlider": {
			"params": { "title": "", "key": "", "value": 0, "min": 0, "max": 100, "scale": 100 },
			"node": {
				"type": "row", "height": 26, "alignItems": "center", "gap": 6, "width": "100%",
				"children": [
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{title}}", "textColor": "@muted", "width": 74 },
					{ "type": "slider", "label": "{{title}}", "grow": 1, "height": 20, "min": "{{min}}", "max": "{{max}}", "step": 1,
					  "value": "{{round(value * scale)}}", "trackColor": "@border", "activeColor": "@accent", "knobColor": "@text",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment":
					    "{{merge(computed.adjustment, parseJson('{' + json(key) + ': ' + json(event.value / scale) + '}'))}}" } } } },
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{round(value * scale)}}", "textColor": "@text", "width": 36 }
				]
			}
		},
		"temperaBalanceSlider": {
			"params": { "title": "", "channel": 0 },
			"node": {
				"type": "row", "height": 26, "alignItems": "center", "gap": 6, "width": "100%",
				"children": [
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{title}}", "textColor": "@muted", "width": 74 },
					{ "type": "slider", "label": "{{title}}", "grow": 1, "height": 20, "min": -100, "max": 100, "step": 1,
					  "value": "{{round(computed.adjustment.balance[channel] * 100)}}", "trackColor": "@border", "activeColor": "@accent",
					  "knobColor": "@text",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment":
					    "{{merge(computed.adjustment, {balance: map(range(3), it == channel ? event.value / 100 : computed.adjustment.balance[it])})}}" } } } },
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{round(computed.adjustment.balance[channel] * 100)}}", "textColor": "@text", "width": 36 }
				]
			}
		},
		"temperaFilterSlider": {
			"params": { "title": "", "key": "", "min": 0, "max": 100 },
			"node": {
				"type": "row", "height": 28, "alignItems": "center", "gap": 8, "width": "100%",
				"children": [
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{title}}", "textColor": "@muted", "width": 80 },
					{ "type": "slider", "id": "filter-{{key}}", "label": "{{title}}", "grow": 1, "height": 20, "min": "{{min}}", "max": "{{max}}",
					  "step": 1, "value": "{{state.filter[key]}}", "trackColor": "@border", "activeColor": "@accent", "knobColor": "@text",
					  "onChange": [{ "set": "state.filter[key]", "to": "{{event.value}}" }] },
					{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{round(state.filter[key])}}", "textColor": "@text", "width": 40 }
				]
			}
		},

		"temperaPanels": {
			"node": {
				"type": "column", "id": "panels", "role": "complementary", "label": "Panels", "width": 270, "height": "100%",
				"color": "@panel", "borderWidth": 1, "borderColor": "@border",
				"children": [
					{ "use": "temperaTab", "with": { "slot": "top", "tabs": [
						{ "id": "navigator", "label": "Navigator", "closable": false }, { "id": "color", "label": "Colour", "closable": false },
						{ "id": "swatches", "label": "Swatches", "closable": false }, { "id": "properties", "label": "Properties", "closable": false }] } },
					{ "id": "panel-top", "color": "transparent", "width": "100%", "height": 262,
					  "children": [
						{ "use": "temperaNavigator", "when": "{{state.panels.top == 'navigator'}}" },
						{ "use": "temperaColour", "when": "{{state.panels.top == 'color'}}" },
						{ "use": "temperaSwatches", "when": "{{state.panels.top == 'swatches'}}" },
						{ "use": "temperaProperties", "when": "{{state.panels.top == 'properties'}}" }
					  ] },
					{ "id": "panel-split", "width": "100%", "height": 1, "color": "@border" },
					{ "use": "temperaTab", "with": { "slot": "bottom", "tabs": [
						{ "id": "layers", "label": "Layers", "closable": false }, { "id": "history", "label": "History", "closable": false }] } },
					{ "id": "panel-bottom", "color": "transparent", "width": "100%", "grow": 1,
					  "children": [
						{ "use": "temperaLayers", "when": "{{state.panels.bottom == 'layers'}}" },
						{ "use": "temperaHistory", "when": "{{state.panels.bottom == 'history'}}" }
					  ] }
				]
			}
		},

		"temperaNavigator": {
			"node": {
				"type": "column", "id": "navigator", "role": "region", "label": "Navigator", "fill": true, "gap": 8, "alignItems": "center",
				"children": [
					{ "id": "navigator-gap", "color": "transparent", "height": 2 },
					{ "type": "image", "id": "navigator-picture", "label": "Navigator", "source": "navigator", "fit": "contain",
					  "width": 246, "height": 190, "color": "@canvasBack" },
					{ "type": "row", "id": "navigator-zoom", "height": 28, "gap": 6, "alignItems": "center",
					  "children": [
						{ "use": "temperaButton", "id": "navigator-out", "with": { "icon": "zoom-out", "run": "zoomOut", "tip": "Zoom Out" } },
						{ "type": "label", "height": 24, "id": "navigator-percent", "text": "{{computed.zoomPercent}}%", "textColor": "@text", "width": 64, "align": { "horizontal": "center", "vertical": "center" } },
						{ "use": "temperaButton", "id": "navigator-in", "with": { "icon": "zoom-in", "run": "zoomIn", "tip": "Zoom In" } },
						{ "use": "temperaButton", "id": "navigator-fit", "with": { "title": "Fit", "run": "fitOnScreen" } }
					  ] }
				]
			}
		},

		"temperaColour": {
			"node": {
				"type": "colorPicker", "id": "colour-picker", "label": "Foreground colour", "anchors": { "left": 8, "right": 8, "top": 6, "bottom": 6 },
				"value": "{{state.doc.foreground}}", "fields": true, "alpha": false, "textColor": "@text", "accentColor": "@accent",
				"onChange": { "run": "setOptions", "with": { "args": { "foreground": "{{event.value}}" } } }
			}
		},

		"temperaSwatches": {
			"node": {
				"type": "grid", "id": "swatches", "role": "group", "label": "Swatches", "columns": 8, "gap": 6,
				"anchors": { "left": 10, "right": 10, "top": 10 }, "height": 64,
				"children": [
					{ "id": "swatch-{{index}}", "repeat": { "for": "swatch", "in": "state.swatches", "index": "index" }, "role": "button",
					  "label": "Swatch {{swatch}}", "tooltip": "{{swatch}}", "width": 24, "height": 24, "radius": 3, "color": "{{swatch}}",
					  "borderWidth": 1, "borderColor": "@border", "cursor": "hand", "hover": { "borderColor": "@text" },
					  "onClick": { "run": "setOptions", "with": { "args": { "foreground": "{{swatch}}" } } } }
				]
			}
		},

		"temperaProperties": {
			"node": {
				"type": "column", "id": "properties", "role": "region", "label": "Properties", "anchors": { "left": 10, "right": 10, "top": 6, "bottom": 6 },
				"gap": 4, "scroll": "vertical",
				"children": [
					{ "type": "label", "id": "properties-none", "when": "{{!computed.activeLayer}}", "text": "No layer", "textColor": "@muted", "fitText": true },
					{ "type": "label", "id": "properties-name", "when": "{{computed.activeLayer}}", "text": "{{computed.activeLayer.name}}", "textColor": "@text",
					  "fitText": true },
					{ "type": "row", "id": "properties-blend-row", "when": "{{computed.activeLayer}}", "height": 28, "gap": 6, "alignItems": "center", "width": "100%",
					  "children": [
						{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Blend", "textColor": "@muted", "width": 74 },
						{ "type": "label", "align": { "horizontal": "start", "vertical": "center" }, "id": "properties-blend", "role": "button", "label": "Blend mode", "text": "{{computed.activeLayer.blend}}",
						  "icon": "chevron-down", "grow": 1, "height": 24, "padding": 4, "radius": 4, "color": "@input", "textColor": "@text",
						  "borderWidth": 1, "borderColor": "@border", "cursor": "hand", "onClick": [{ "toggle": "state.blendMenu" }],
						  "children": [
							{ "use": "menu", "id": "blend-menu", "with": { "open": "state.blendMenu", "width": 180, "color": "@panel", "textColor": "@text",
							  "dimColor": "@muted", "highlight": "@hover",
							  "items": "{{map(state.blends, {title: it, run: 'setLayer', with: {args: {blend: it}}})}}" } }
						  ] }
					  ] },
					{ "type": "row", "id": "properties-opacity", "when": "{{computed.activeLayer}}", "height": 26, "alignItems": "center", "gap": 6, "width": "100%",
					  "children": [
						{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Opacity", "textColor": "@muted", "width": 74 },
						{ "type": "slider", "id": "layer-opacity", "label": "Layer opacity", "grow": 1, "height": 20, "min": 0, "max": 100, "step": 1,
						  "value": "{{computed.activeLayer.opacity}}", "trackColor": "@border", "activeColor": "@accent", "knobColor": "@text",
						  "onChange": { "run": "setLayer", "with": { "args": { "opacity": "{{event.value}}" } } } },
						{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "{{computed.activeLayer.opacity}}%", "textColor": "@text", "width": 36 }
					  ] },
					{ "type": "row", "id": "properties-locks", "when": "{{computed.activeLayer}}", "height": 26, "alignItems": "center", "gap": 10, "width": "100%",
					  "children": [
						{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Lock", "textColor": "@muted", "width": 66 },
						{ "type": "checkbox", "id": "lock-pixels", "label": "Lock pixels", "width": 16, "height": 16, "checked": "{{computed.activeLayer.lockPixels}}",
						  "activeColor": "@accent", "trackColor": "@border", "knobColor": "@input",
						  "onChange": { "run": "setLayer", "with": { "args": { "lockPixels": "{{event.value}}" } } } },
						{ "type": "label", "text": "Pixels", "textColor": "@text", "fitText": true },
						{ "type": "checkbox", "id": "lock-position", "label": "Lock position", "width": 16, "height": 16, "checked": "{{computed.activeLayer.lockPosition}}",
						  "activeColor": "@accent", "trackColor": "@border", "knobColor": "@input",
						  "onChange": { "run": "setLayer", "with": { "args": { "lockPosition": "{{event.value}}" } } } },
						{ "type": "label", "text": "Move", "textColor": "@text", "fitText": true },
						{ "type": "checkbox", "id": "lock-all", "label": "Lock all", "width": 16, "height": 16, "checked": "{{computed.activeLayer.lockAll}}",
						  "activeColor": "@accent", "trackColor": "@border", "knobColor": "@input",
						  "onChange": { "run": "setLayer", "with": { "args": { "lockAll": "{{event.value}}" } } } },
						{ "type": "label", "text": "All", "textColor": "@text", "fitText": true }
					  ] },
					{ "id": "properties-line", "when": "{{computed.adjustment}}", "width": "100%", "height": 1, "color": "@border" },
					{ "type": "label", "id": "adjustment-title", "when": "{{computed.adjustment}}", "font": "small",
					  "text": "{{(find(state.adjustments, it.id == computed.adjustmentKind).title ?? '') + ' adjustment'}}", "textColor": "@muted", "fitText": true },
					{ "use": "temperaAdjustSlider", "id": "adjust-input-black", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Input black", "key": "inputBlack", "value": "{{computed.adjustment.inputBlack}}", "max": 255, "scale": 255 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-input-white", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Input white", "key": "inputWhite", "value": "{{computed.adjustment.inputWhite}}", "max": 255, "scale": 255 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-gamma", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Gamma", "key": "gamma", "value": "{{computed.adjustment.gamma}}", "min": 10, "max": 400, "scale": 100 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-output-black", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Output black", "key": "outputBlack", "value": "{{computed.adjustment.outputBlack}}", "max": 255, "scale": 255 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-output-white", "when": "{{computed.adjustmentKind == 'levels'}}",
					  "with": { "title": "Output white", "key": "outputWhite", "value": "{{computed.adjustment.outputWhite}}", "max": 255, "scale": 255 } },
					{ "type": "curves", "id": "adjust-curve", "label": "Curve", "when": "{{computed.adjustmentKind == 'curves'}}", "width": 200, "height": 160,
					  "value": "{{merge({points: []}, {points: computed.adjustment.curve})}}", "accentColor": "@accent",
					  "onChange": { "run": "setLayer", "with": { "args": { "adjustment": "{{merge(computed.adjustment, {curve: event.value.points})}}" } } } },
					{ "use": "temperaAdjustSlider", "id": "adjust-hue", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Hue", "key": "hue", "value": "{{computed.adjustment.hue}}", "min": -180, "max": 180, "scale": 1 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-saturation", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Saturation", "key": "saturation", "value": "{{computed.adjustment.saturation}}", "min": -100 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-lightness", "when": "{{computed.adjustmentKind == 'hue-saturation'}}",
					  "with": { "title": "Lightness", "key": "lightness", "value": "{{computed.adjustment.lightness}}", "min": -100 } },
					{ "use": "temperaBalanceSlider", "id": "adjust-cyan-red", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Cyan / Red", "channel": 0 } },
					{ "use": "temperaBalanceSlider", "id": "adjust-magenta-green", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Mag. / Green", "channel": 1 } },
					{ "use": "temperaBalanceSlider", "id": "adjust-yellow-blue", "when": "{{computed.adjustmentKind == 'color-balance'}}",
					  "with": { "title": "Yellow / Blue", "channel": 2 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-brightness", "when": "{{computed.adjustmentKind == 'brightness-contrast'}}",
					  "with": { "title": "Brightness", "key": "brightness", "value": "{{computed.adjustment.brightness}}", "min": -100 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-contrast", "when": "{{computed.adjustmentKind == 'brightness-contrast'}}",
					  "with": { "title": "Contrast", "key": "contrast", "value": "{{computed.adjustment.contrast}}", "min": -100 } },
					{ "use": "temperaAdjustSlider", "id": "adjust-level", "when": "{{computed.adjustmentKind == 'threshold'}}",
					  "with": { "title": "Level", "key": "level", "value": "{{computed.adjustment.level}}", "max": 255, "scale": 255 } },
					{ "type": "label", "align": { "horizontal": "start", "vertical": "center" }, "id": "adjust-plain", "when": "{{computed.adjustmentKind == 'invert' || computed.adjustmentKind == 'gradient-map'}}",
					  "text": "{{computed.adjustmentKind == 'invert' ? 'Inverts the colours below.' : 'Maps the lightness below to the foreground and background colours.'}}",
					  "textColor": "@muted", "width": "100%", "height": 34, "wrap": true }
				]
			}
		},

		"temperaLayers": {
			"node": {
				"type": "column", "id": "layers", "role": "region", "label": "Layers", "fill": true,
				"children": [
					{ "type": "column", "id": "layer-rows", "role": "list", "label": "Layers", "width": "100%", "grow": 1, "scroll": "vertical",
					  "children": [
						{ "type": "row", "id": "layer-{{layer.id}}", "repeat": { "for": "layer", "in": "state.doc.layers", "key": "{{layer.id}}" },
						  "role": "listitem", "label": "{{layer.name}}", "selected": "{{layer.id == state.doc.active}}", "width": "100%", "height": 40,
						  "alignItems": "center", "gap": 6, "cursor": "hand",
						  "color": "{{layer.id == state.doc.active ? '@selected' : 'transparent'}}", "hover": { "color": "@hover" },
						  "drag": { "data": { "id": "{{layer.id}}" } },
						  "onDrop": { "run": "moveLayer", "with": { "args": { "id": "{{event.data.id}}", "onto": "{{layer.id}}" } } },
						  "onClick": { "run": "selectLayer", "with": { "args": { "id": "{{layer.id}}" } } },
						  "children": [
							{ "id": "layer-indent-{{layer.id}}", "color": "transparent", "width": "{{4 + layer.depth * 14}}", "height": 1 },
							{ "type": "label", "id": "layer-eye-{{layer.id}}", "role": "button", "label": "Visibility of {{layer.name}}",
							  "icon": "{{layer.visible ? 'eye' : 'eye-off'}}", "width": 20, "height": 20, "align": "center", "cursor": "hand",
							  "textColor": "{{layer.visible ? '@text' : '@muted'}}",
							  "onClick": { "run": "setLayer", "with": { "args": { "id": "{{layer.id}}", "visible": "{{!layer.visible}}" } } } },
							{ "type": "label", "id": "layer-clip-{{layer.id}}", "when": "{{layer.clipped}}", "icon": "corner-left-down", "textColor": "@muted",
							  "width": 14, "tooltip": "Clipped to the layer below" },
							{ "type": "image", "id": "layer-thumb-{{layer.id}}", "when": "{{!empty(layer.thumbnail)}}", "source": "{{layer.thumbnail}}",
							  "fit": "contain", "width": 32, "height": 32, "color": "@canvasBack", "borderWidth": 1, "borderColor": "@border" },
							{ "type": "label", "id": "layer-icon-{{layer.id}}", "when": "{{empty(layer.thumbnail)}}",
							  "icon": "{{layer.kind == 'group' ? 'folder' : 'contrast'}}", "font": "iconsLarge", "width": 32, "height": 32,
							  "align": "center", "textColor": "@muted" },
							{ "type": "label", "align": { "horizontal": "start", "vertical": "center" }, "id": "layer-name-{{layer.id}}", "text": "{{layer.name}}", "textColor": "@text", "grow": 1, "height": 20 },
							{ "type": "label", "id": "layer-mask-{{layer.id}}", "when": "{{layer.mask}}", "icon": "circle-dot", "textColor": "@text",
							  "width": 16, "tooltip": "Layer mask" },
							{ "type": "label", "id": "layer-lock-{{layer.id}}", "when": "{{layer.lockAll || layer.lockPixels || layer.lockPosition}}",
							  "icon": "lock", "textColor": "@muted", "width": 16, "tooltip": "Locked" },
							{ "id": "layer-end-{{layer.id}}", "color": "transparent", "width": 4, "height": 1 }
						  ] }
					  ] },
					{ "type": "row", "id": "layer-buttons", "role": "toolbar", "label": "Layer actions", "width": "100%", "height": 32,
					  "alignItems": "center", "justify": "end", "gap": 2, "borderWidth": 1, "borderColor": "@border",
					  "children": [
						{ "type": "label", "id": "layer-adjust", "role": "button", "label": "New adjustment layer", "icon": "contrast", "width": 28, "height": 26,
						  "align": "center", "radius": 4, "cursor": "hand", "tooltip": "New adjustment layer", "textColor": "@text", "hover": { "color": "@hover" },
						  "onClick": [{ "toggle": "state.adjustMenu" }],
						  "children": [
							{ "use": "menu", "id": "adjust-menu", "with": { "open": "state.adjustMenu", "placement": "above", "width": 200, "color": "@panel",
							  "textColor": "@text", "dimColor": "@muted", "highlight": "@hover",
							  "items": "{{map(state.adjustments, {title: it.title, run: 'addLayer', with: {args: {kind: it.id, name: it.title}}})}}" } }
						  ] },
						{ "type": "label", "id": "layer-add-mask", "role": "button", "label": "Add layer mask", "icon": "circle-dot", "width": 28, "height": 26,
						  "align": "center", "radius": 4, "cursor": "hand", "tooltip": "Add layer mask", "textColor": "@text", "hover": { "color": "@hover" },
						  "onClick": { "run": "addLayerMask" } },
						{ "type": "label", "id": "layer-new-group", "role": "button", "label": "New group", "icon": "folder-plus", "width": 28, "height": 26,
						  "align": "center", "radius": 4, "cursor": "hand", "tooltip": "New group", "textColor": "@text", "hover": { "color": "@hover" },
						  "onClick": { "run": "newGroup" } },
						{ "type": "label", "id": "layer-new", "role": "button", "label": "New layer", "icon": "plus", "width": 28, "height": 26,
						  "align": "center", "radius": 4, "cursor": "hand", "tooltip": "New layer", "textColor": "@text", "hover": { "color": "@hover" },
						  "onClick": { "run": "newLayer" } },
						{ "type": "label", "id": "layer-delete", "role": "button", "label": "Delete layer", "icon": "trash-2", "width": 28, "height": 26,
						  "align": "center", "radius": 4, "cursor": "hand", "tooltip": "Delete layer", "textColor": "@text", "hover": { "color": "@hover" },
						  "onClick": { "run": "deleteActive" } },
						{ "id": "layer-buttons-end", "color": "transparent", "width": 4, "height": 1 }
					  ] }
				]
			}
		},

		"temperaHistory": {
			"node": {
				"type": "column", "id": "history", "role": "region", "label": "History", "fill": true,
				"children": [
					{ "type": "list", "id": "history-list", "label": "History", "width": "100%", "grow": 1, "color": "@panel", "rowHeight": 26,
					  "items": "{{state.doc.history}}", "value": "{{text(state.doc.position)}}", "textColor": "@text",
					  "selectedTextColor": "@text", "selectedBackground": "@selected", "accentColor": "@accent",
					  "onChange": { "run": "goToHistory", "with": { "args": { "position": "{{number(event.value)}}" } } } },
					{ "type": "label", "align": { "horizontal": "start", "vertical": "center" }, "id": "history-dropped", "when": "{{state.doc.dropped > 0}}", "font": "small",
					  "text": "{{state.doc.dropped}} older steps dropped to stay within the undo memory", "textColor": "@muted",
					  "width": "100%", "height": 18, "padding": 4 }
				]
			}
		},

		"temperaFilterDialog": {
			"node": {
				"use": "dialog", "id": "filter-dialog",
				"with": { "open": "state.filter.open", "title": "{{computed.filterTitle}}", "message": "", "width": 380, "height": 250,
				          "color": "@panel", "textColor": "@text", "dimColor": "@muted", "highlight": "@accent",
				          "buttons": [{ "title": "Cancel", "run": "discardFilter" }, { "title": "Apply", "run": "commitFilter" }] },
				"children": [
					{ "type": "column", "id": "filter-fields", "anchors": { "left": 20, "right": 20, "top": 44, "bottom": 52 }, "gap": 2,
					  "children": [
						{ "use": "temperaFilterSlider", "when": "{{state.filter.kind != 'add-noise' && state.filter.kind != 'motion-blur'}}",
						  "with": { "title": "Radius", "key": "radius", "min": 1, "max": 100 } },
						{ "use": "temperaFilterSlider", "when": "{{state.filter.kind != 'gaussian-blur' && state.filter.kind != 'motion-blur'}}",
						  "with": { "title": "Amount", "key": "amount", "min": 1, "max": 500 } },
						{ "use": "temperaFilterSlider", "when": "{{state.filter.kind == 'unsharp-mask'}}",
						  "with": { "title": "Threshold", "key": "threshold", "max": 255 } },
						{ "use": "temperaFilterSlider", "when": "{{state.filter.kind == 'motion-blur'}}",
						  "with": { "title": "Angle", "key": "angle", "min": -180, "max": 180 } },
						{ "use": "temperaFilterSlider", "when": "{{state.filter.kind == 'motion-blur'}}",
						  "with": { "title": "Distance", "key": "distance", "min": 1, "max": 200 } },
						{ "type": "row", "id": "filter-live-row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "type": "checkbox", "id": "filter-live", "label": "Preview", "width": 16, "height": 16, "bind": "state.filter.live",
							  "activeColor": "@accent", "trackColor": "@border", "knobColor": "@input" },
							{ "type": "label", "text": "Preview", "textColor": "@text", "fitText": true }
						  ] }
					  ] }
				]
			}
		},

		"temperaNewDialog": {
			"node": {
				"use": "dialog", "id": "new-dialog",
				"with": { "open": "state.newDoc.open", "title": "New Image", "message": "", "width": 360, "height": 230,
				          "color": "@panel", "textColor": "@text", "dimColor": "@muted", "highlight": "@accent",
				          "buttons": [{ "title": "Cancel" }, { "title": "Create", "run": "createDocument" }] },
				"children": [
					{ "type": "column", "id": "new-fields", "anchors": { "left": 20, "right": 20, "top": 44, "bottom": 52 }, "gap": 6,
					  "children": [
						{ "type": "row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Width", "textColor": "@muted", "width": 70 },
							{ "type": "textarea", "id": "new-width", "label": "Width", "width": 100, "height": 26, "color": "@input", "textColor": "@text",
							  "borderWidth": 1, "borderColor": "@border", "radius": 4, "bind": "state.newDoc.width" },
							{ "type": "label", "text": "px", "textColor": "@muted", "fitText": true }
						  ] },
						{ "type": "row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Height", "textColor": "@muted", "width": 70 },
							{ "type": "textarea", "id": "new-height", "label": "Height", "width": 100, "height": 26, "color": "@input", "textColor": "@text",
							  "borderWidth": 1, "borderColor": "@border", "radius": 4, "bind": "state.newDoc.height" },
							{ "type": "label", "text": "px", "textColor": "@muted", "fitText": true }
						  ] },
						{ "type": "row", "height": 28, "gap": 8, "alignItems": "center",
						  "children": [
							{ "type": "label", "height": 24, "align": { "horizontal": "start", "vertical": "center" }, "text": "Depth", "textColor": "@muted", "width": 70 },
							{ "type": "tabs", "id": "new-format", "width": 200, "height": 26, "bind": "state.newDoc.format",
							  "tabs": [{ "id": "rgba8", "label": "8-bit", "closable": false }, { "id": "rgba16f", "label": "16-bit float", "closable": false }],
							  "textColor": "@muted", "activeTextColor": "@text", "activeBackground": "@selected", "accentColor": "@accent" }
						  ] }
					  ] }
				]
			}
		}
	}
}
