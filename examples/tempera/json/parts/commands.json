{
	"$schema": "../../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Tempera's commands: one action per operation of the image step on the image doc (the images section), each taking its arguments as args; the library puts the image's snapshot in state.doc; the commands people choose from the menus and keys; and the watches that preview and apply filters, so a panel added by a revision works by setting state.filter.",

	"computed": {
		"activeLayer": "{{find(state.doc.layers, it.id == state.doc.active)}}",
		"layerBelow": "{{find(slice(state.doc.layers, indexOf(map(state.doc.layers, it.id), state.doc.active) + 1), it.depth <= (computed.activeLayer.depth ?? 0))}}",
		"searchItems": "{{map(filter(commands, it.enabled != false && !empty(it.title ?? '') && it.name != 'unavailable'), {title: (empty(it.category ?? '') ? '' : it.category + ': ') + it.title, run: it.name})}}",
		"nextGroupName": "{{'Group ' + (count(state.doc.layers, it.kind == 'group') + 1)}}",
		"groupBelow": "{{slice(state.doc.layers, indexOf(map(state.doc.layers, it.id), state.doc.active) + 1)}}",
		"groupEnds": "{{scan(computed.groupBelow, acc || it.depth <= computed.activeLayer.depth, false)}}",
		"groupChildren": "{{filter(computed.groupBelow, it.depth == computed.activeLayer.depth + 1 && !computed.groupEnds[index])}}",
		"fillContents": "{{[{id: 'foreground', title: 'Foreground Colour', color: state.doc.foreground}, {id: 'background', title: 'Background Colour', color: state.doc.background}, {id: 'black', title: 'Black', color: '#000000'}, {id: 'grey', title: '50% Grey', color: '#808080'}, {id: 'white', title: 'White', color: '#ffffff'}]}}",
		"zoomPercent": "{{round(state.doc.view.zoom * 1000) / 10}}"
	},

	"actions": {
		"setTool": [{ "if": "{{args.tool == 'pencil' && state.doc.tool != 'pencil'}}", "then": [{ "set": "state.brushHardness", "to": "{{state.doc.options.hardness}}" }] },
			{ "if": "{{state.doc.tool == 'pencil' && args.tool != 'pencil'}}",
			  "then": [{ "image": "setTool", "with": "{{args}}" }, { "image": "setOptions", "with": { "hardness": "{{state.brushHardness}}" } }],
			  "else": [{ "image": "setTool", "with": "{{args}}" }] }],
		"setOptions": [{ "image": "setOptions", "with": "{{args}}" }],
		"select": [{ "image": "select", "with": "{{args}}" }],
		"pointer": [{ "image": "pointer", "with": "{{args}}" }],
		"crop": [{ "image": "crop", "with": "{{args}}" }],
		"setProfile": [{ "image": "setProfile", "with": "{{args}}" }],
		"fillSelection": [{ "image": "fillSelection", "with": "{{args}}" }],
		"zoom": [{ "image": "zoom", "with": "{{args}}" }],
		"feather": [{ "image": "feather", "with": "{{args}}" }],
		"setLayer": [{ "image": "setLayer", "with": "{{args}}" }],
		"addLayer": [{ "image": "addLayer", "with": "{{args}}" }],
		"moveLayer": [{ "image": "moveLayer", "with": "{{args}}" }],
		"deleteLayer": [{ "image": "deleteLayer", "with": "{{args}}" }],
		"duplicateLayer": [{ "image": "duplicateLayer", "with": "{{args}}" }],
		"selectLayer": [{ "image": "selectLayer", "with": "{{args}}" }],
		"addMask": [{ "image": "addMask", "with": "{{args}}" }],
		"deleteMask": [{ "image": "deleteMask", "with": "{{args}}" }],
		"goToHistory": [{ "image": "history", "with": "{{args}}" }],
		"newDocument": [{ "image": "newImage", "with": "{{args}}" }],
		"save": [{ "image": "save", "with": "{{args}}" }],

		"setGradient": [{ "set": "state.gradientEdit", "to": "{{args}}" }, { "run": "setOptions", "with": { "args": { "gradient": "{{args}}" } } }],
		"perform": [{ "note": "Runs an action with arguments, for the scenarios: event.run and event.args." },
			{ "run": "{{event.run}}", "with": { "args": "{{event.args}}" } }],

		"undo": { "title": "Undo", "category": "Edit", "icon": "undo-2", "enablement": "{{state.doc.canUndo}}",
			"do": [{ "image": "undo" }] },
		"redo": { "title": "Redo", "category": "Edit", "icon": "redo-2", "enablement": "{{state.doc.canRedo}}",
			"do": [{ "image": "redo" }] },
		"openFile": { "title": "Open...", "category": "File", "icon": "folder-open",
			"do": [{ "image": "open", "with": { "projectExtension": "tempera" } }] },
		"closeDocument": { "title": "Close", "category": "File", "icon": "x",
			"do": [{ "if": "{{state.doc.canUndo}}", "then": [{ "set": "state.closeAsk", "to": true }], "else": [{ "run": "discardDocument" }] }] },
		"discardDocument": [{ "note": "Tempera always shows a document: closing one leaves a blank one in its place." },
			{ "image": "newImage", "with": { "width": "{{state.doc.width}}", "height": "{{state.doc.height}}" } },
			{ "set": "state.docName", "to": "Untitled" }, { "set": "state.closeAsk", "to": false }],
		"revert": { "title": "Revert", "category": "File", "icon": "rotate-ccw",
			"do": [{ "image": "revert" }] },
		"saveProject": { "title": "Save...", "category": "File", "icon": "save",
			"do": [{ "run": "save", "with": { "args": { "format": "project", "extension": "tempera" } } }] },
		"saveProjectAs": { "title": "Save As...", "category": "File", "icon": "save-all",
			"do": [{ "run": "save", "with": { "args": { "format": "project", "extension": "tempera" } } }] },
		"exportPng": { "title": "Export as PNG...", "category": "File", "icon": "image",
			"do": [{ "run": "save", "with": { "args": { "format": "png" } } }] },
		"exportJpeg": { "title": "Export as JPEG...", "category": "File", "icon": "image",
			"do": [{ "run": "save", "with": { "args": { "format": "jpeg" } } }] },
		"showNewDialog": { "title": "New...", "category": "File", "icon": "file-plus",
			"do": [{ "set": "state.newDoc.open", "to": true }] },
		"setFillContents": [{ "set": "state.fill.contents", "to": "{{args.id}}" }],
		"applyFill": [{ "run": "fillSelection", "with": { "args": { "color": "{{find(computed.fillContents, it.id == state.fill.contents).color ?? state.doc.foreground}}" } } }],
		"newPreset": [{ "set": "state.newDoc.width", "to": "{{args.width}}" }, { "set": "state.newDoc.height", "to": "{{args.height}}" }],
		"levelsLayer": { "title": "Levels...", "category": "Image", "icon": "sliders-horizontal",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "levels", "name": "Levels" } } }] },
		"curvesLayer": { "title": "Curves...", "category": "Image", "icon": "spline",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "curves", "name": "Curves" } } }] },
		"hueSaturationLayer": { "title": "Hue/Saturation...", "category": "Image", "icon": "droplet",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "hue-saturation", "name": "Hue/Saturation" } } }] },
		"colorBalanceLayer": { "title": "Colour Balance...", "category": "Image", "icon": "scale",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "color-balance", "name": "Colour Balance" } } }] },
		"invertLayer": { "title": "Invert", "category": "Image", "icon": "contrast",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "invert", "name": "Invert" } } }] },
		"blackWhiteLayer": { "title": "Black & White...", "category": "Image", "icon": "blend",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "hue-saturation", "name": "Black & White" } } },
			       { "run": "setAdjustment", "with": { "args": { "saturation": -1 } } }] },
		"createDocument": [{ "run": "newDocument", "with": { "args": { "width": "{{clamp(number(state.newDoc.width) ?? 1, 1, 20000)}}", "height": "{{clamp(number(state.newDoc.height) ?? 1, 1, 20000)}}", "format": "{{state.newDoc.format}}" } } },
			{ "set": "state.newDoc.open", "to": false }],
		"newSample": { "title": "New Sample", "category": "File", "icon": "sparkles",
			"do": [{ "run": "drawSample" }] },
		"drawSample": [{ "note": "The sample, 1200 × 800: a dawn sky, a sun and hills, each a layer; then no history, and the brush." },
			{ "image": "newImage", "with": { "width": 1200, "height": 800 } },
			{ "image": "setLayer", "with": { "id": "{{state.doc.active}}", "name": "Sky" } },
			{ "image": "setTool", "with": { "tool": "gradient" } },
			{ "image": "setOptions", "with": { "shape": "linear", "gradient": { "stops": [{ "at": 0, "color": "#5485d1" }, { "at": 1, "color": "#f7d6a8" }] } } },
			{ "image": "pointer", "with": { "points": [{ "phase": "press", "x": 600, "y": 0 }, { "phase": "move", "x": 600, "y": 280 }, { "phase": "release", "x": 600, "y": 560 }] } },
			{ "image": "addLayer", "with": { "kind": "pixel", "name": "Sun" } },
			{ "image": "select", "with": { "kind": "ellipse", "from": { "x": 792, "y": 128 }, "to": { "x": 952, "y": 288 } } },
			{ "image": "fillSelection", "with": { "color": "#ffdb5c" } },
			{ "image": "addLayer", "with": { "kind": "pixel", "name": "Hills" } },
			{ "image": "select", "with": { "kind": "polygon", "points": "{{concat(map(range(49), { x: 1200 * it / 48, y: 800 * (0.66 + 0.07 * sin(9 * it / 48) + 0.04 * sin(23 * it / 48)) }), [{ x: 1200, y: 800 }, { x: 0, y: 800 }])}}" } },
			{ "image": "fillSelection", "with": { "color": "#3b784f" } },
			{ "image": "select", "with": { "kind": "none" } },
			{ "image": "setOptions", "with": { "gradientPreset": "Foreground to Background" } },
			{ "image": "setTool", "with": { "tool": "brush" } },
			{ "image": "clearHistory" }],

		"fillForeground": { "title": "Fill with Foreground", "category": "Edit", "icon": "paint-bucket",
			"do": [{ "run": "fillSelection", "with": { "args": {} } }] },
		"fillBackground": { "title": "Fill with Background", "category": "Edit", "icon": "paint-bucket",
			"do": [{ "run": "fillSelection", "with": { "args": { "color": "{{state.doc.background}}" } } }] },
		"showFill": { "title": "Fill...", "category": "Edit", "icon": "paint-bucket",
			"do": [{ "set": "state.fill.open", "to": true }] },
		"swapColours": { "title": "Swap Colours", "category": "Edit", "icon": "arrow-left-right",
			"do": [{ "run": "setOptions", "with": { "args": { "swap": true } } }] },
		"resetColours": { "title": "Default Colours", "category": "Edit", "icon": "rotate-ccw",
			"do": [{ "run": "setOptions", "with": { "args": { "reset": true } } }] },
		"brushSmaller": { "title": "Smaller Brush", "category": "Edit", "icon": "minus",
			"do": [{ "run": "setOptions", "with": { "args": { "sizeStep": -1 } } }] },
		"brushLarger": { "title": "Larger Brush", "category": "Edit", "icon": "plus",
			"do": [{ "run": "setOptions", "with": { "args": { "sizeStep": 1 } } }] },

		"cropToSelection": { "title": "Crop to Selection", "category": "Image", "icon": "crop",
			"enablement": "{{state.doc.selection}}",
			"do": [{ "run": "crop", "with": { "args": { "x": "{{state.doc.bounds[0]}}", "y": "{{state.doc.bounds[1]}}",
				"width": "{{state.doc.bounds[2]}}", "height": "{{state.doc.bounds[3]}}" } } }] },
		"cropToRatio": { "title": "Crop to a Ratio", "category": "Image", "icon": "crop", "enablement": "{{state.doc.width > 0}}",
			"do": [{ "set": "state.cropSize", "to": "{{state.doc.width * args.height > state.doc.height * args.width ? [max(1, floor(state.doc.height * args.width / args.height)), state.doc.height] : [state.doc.width, max(1, floor(state.doc.width * args.height / args.width))]}}" },
				{ "run": "crop", "with": { "args": { "x": "{{floor((state.doc.width - state.cropSize[0]) / 2)}}", "y": "{{floor((state.doc.height - state.cropSize[1]) / 2)}}",
					"width": "{{state.cropSize[0]}}", "height": "{{state.cropSize[1]}}" } } }] },
		"toggleProof": { "title": "Proof Colours", "category": "Image", "icon": "eye",
			"do": [{ "run": "setProfile", "with": { "args": { "proof": "{{empty(state.doc.proof) ? 'gray' : ''}}" } } }] },

		"newLayer": { "title": "New Layer", "category": "Layer", "icon": "plus",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "pixel" } } }] },
		"newGroup": { "title": "New Group", "category": "Layer", "icon": "folder",
			"do": [{ "run": "addLayer", "with": { "args": { "kind": "group", "name": "{{computed.nextGroupName}}" } } }] },
		"groupLayers": { "title": "Group Layers", "category": "Layer", "icon": "folder-input", "enablement": "{{!empty(state.doc.active)}}",
			"do": [{ "set": "state.grouping", "to": "{{state.doc.active}}" }, { "run": "addLayer", "with": { "args": { "kind": "group", "name": "{{computed.nextGroupName}}" } } },
				{ "run": "moveLayer", "with": { "args": { "id": "{{state.grouping}}", "into": "{{state.doc.active}}" } } }] },
		"ungroupLayers": { "title": "Ungroup Layers", "category": "Layer", "icon": "folder-output", "enablement": "{{computed.activeLayer.kind == 'group'}}",
			"do": [{ "set": "state.grouping", "to": "{{state.doc.active}}" },
				{ "forEach": "{{reverse(computed.groupChildren)}}", "as": "child", "do": [{ "run": "moveLayer", "with": { "args": { "id": "{{child.id}}", "onto": "{{state.grouping}}" } } }] },
				{ "run": "deleteLayer", "with": { "args": { "id": "{{state.grouping}}" } } }] },
		"duplicateActive": { "title": "Duplicate Layer", "category": "Layer", "icon": "copy",
			"do": [{ "run": "duplicateLayer", "with": { "args": {} } }] },
		"deleteActive": { "title": "Delete Layer", "category": "Layer", "icon": "trash-2",
			"enablement": "{{length(state.doc.layers) > 1}}",
			"do": [{ "run": "deleteLayer", "with": { "args": {} } }] },
		"layerUp": { "title": "Bring Forward", "category": "Layer", "icon": "arrow-up",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": 1 } } }] },
		"layerDown": { "title": "Send Backward", "category": "Layer", "icon": "arrow-down",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": -1 } } }] },
		"layerToFront": { "title": "Bring to Front", "category": "Layer", "icon": "chevrons-up",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": 1000000 } } }] },
		"layerToBack": { "title": "Send to Back", "category": "Layer", "icon": "chevrons-down",
			"do": [{ "run": "moveLayer", "with": { "args": { "by": -1000000 } } }] },
		"toggleLockAll": { "title": "Lock All", "category": "Layer", "icon": "lock",
			"do": [{ "run": "setLayer", "with": { "args": { "lockAll": "{{!computed.activeLayer.lockAll}}" } } }] },
		"addLayerMask": { "title": "Add Layer Mask", "category": "Layer", "icon": "circle-dot",
			"enablement": "{{computed.activeLayer && !computed.activeLayer.mask}}",
			"do": [{ "run": "addMask", "with": { "args": {} } }] },
		"deleteLayerMask": { "title": "Delete Layer Mask", "category": "Layer", "icon": "square-x",
			"enablement": "{{computed.activeLayer && computed.activeLayer.mask}}",
			"do": [{ "run": "deleteMask", "with": { "args": {} } }] },
		"toggleClipping": { "title": "Clipping Mask", "category": "Layer", "icon": "paperclip",
			"do": [{ "run": "setLayer", "with": { "args": { "clipped": "{{!computed.activeLayer.clipped}}" } } }] },

		"cutPixels": { "title": "Cut", "category": "Edit", "icon": "scissors", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "cut" }] },
		"copyPixels": { "title": "Copy", "category": "Edit", "icon": "copy", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "copy" }] },
		"copyMerged": { "title": "Copy Merged", "category": "Edit", "icon": "layers-2",
			"do": [{ "image": "copy", "with": { "merged": true } }] },
		"pastePixels": { "title": "Paste", "category": "Edit", "icon": "clipboard-paste", "enablement": "{{state.doc.clipboard}}",
			"do": [{ "image": "paste" }] },
		"clearPixels": { "title": "Clear", "category": "Edit", "icon": "delete", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "clear" }] },
		"transformActive": [{ "image": "transformLayer", "with": "{{args}}" }],
		"showTransform": { "title": "Free Transform...", "category": "Edit", "icon": "scaling", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "set": "state.transform", "to": { "open": true, "x": 0, "y": 0, "scaleX": 100, "scaleY": 100, "angle": 0 } }] },
		"applyTransform": [{ "run": "transformActive", "with": { "args": { "x": "{{number(state.transform.x) ?? 0}}", "y": "{{number(state.transform.y) ?? 0}}",
			"scaleX": "{{number(state.transform.scaleX) ?? 100}}", "scaleY": "{{number(state.transform.scaleY) ?? 100}}", "angle": "{{number(state.transform.angle) ?? 0}}" } } },
			{ "set": "state.transform.open", "to": false }],
		"transformBox": [{ "note": "The Properties panel's W, H, X and Y: the active layer moves and scales as the box (the selection, or the image) would." },
			{ "run": "transformActive", "with": { "args": { "x": "{{(args.x ?? computed.box[0]) - computed.box[0]}}", "y": "{{(args.y ?? computed.box[1]) - computed.box[1]}}",
				"scaleX": "{{(args.w ?? computed.box[2]) * 100 / computed.box[2]}}", "scaleY": "{{(args.h ?? computed.box[3]) * 100 / computed.box[3]}}" } } }],
		"alignActive": { "title": "Align", "category": "Layer", "icon": "align-start-vertical", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "alignLayer", "with": "{{args}}" }] },
		"layerViaCopy": { "title": "Layer via Copy", "category": "Layer", "icon": "copy-plus", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "copy" }, { "image": "paste", "with": { "name": "{{computed.activeLayer.name}} copy" } }] },
		"layerViaCut": { "title": "Layer via Cut", "category": "Layer", "icon": "scissors", "enablement": "{{computed.activeLayer.kind == 'pixel'}}",
			"do": [{ "image": "cut" }, { "image": "paste", "with": { "name": "{{computed.activeLayer.name}} cut" } }] },
		"rotateLayer180": { "title": "Rotate Layer 180°", "category": "Edit", "icon": "rotate-cw",
			"do": [{ "run": "transformActive", "with": { "args": { "angle": 180 } } }] },
		"rotateLayerRight": { "title": "Rotate Layer 90° Clockwise", "category": "Edit", "icon": "rotate-cw",
			"do": [{ "run": "transformActive", "with": { "args": { "angle": 90 } } }] },
		"rotateLayerLeft": { "title": "Rotate Layer 90° Anticlockwise", "category": "Edit", "icon": "rotate-ccw",
			"do": [{ "run": "transformActive", "with": { "args": { "angle": -90 } } }] },
		"flipLayerHorizontal": { "title": "Flip Layer Horizontal", "category": "Edit", "icon": "flip-horizontal",
			"do": [{ "run": "transformActive", "with": { "args": { "scaleX": -100 } } }] },
		"flipLayerVertical": { "title": "Flip Layer Vertical", "category": "Edit", "icon": "flip-vertical",
			"do": [{ "run": "transformActive", "with": { "args": { "scaleY": -100 } } }] },

		"showImageSize": { "title": "Image Size...", "category": "Image", "icon": "scaling",
			"do": [{ "set": "state.resize", "to": { "open": true, "width": "{{state.doc.width}}", "height": "{{state.doc.height}}", "linked": true } }] },
		"applyImageSize": [{ "image": "imageSize", "with": {
			"width": "{{clamp(number(state.resize.width) ?? state.doc.width, 1, 30000)}}",
			"height": "{{state.resize.linked ? null : clamp(number(state.resize.height) ?? state.doc.height, 1, 30000)}}" } },
			{ "set": "state.resize.open", "to": false }],
		"showCanvasSize": { "title": "Canvas Size...", "category": "Image", "icon": "frame",
			"do": [{ "set": "state.canvasSize", "to": { "open": true, "width": "{{state.doc.width}}", "height": "{{state.doc.height}}", "anchor": "center" } }] },
		"applyCanvasSize": [{ "image": "canvasSize", "with": {
			"width": "{{clamp(number(state.canvasSize.width) ?? state.doc.width, 1, 30000)}}", "height": "{{clamp(number(state.canvasSize.height) ?? state.doc.height, 1, 30000)}}",
			"anchor": "{{state.canvasSize.anchor}}" } },
			{ "set": "state.canvasSize.open", "to": false }],
		"rotateCanvas180": { "title": "Rotate Image 180°", "category": "Image", "icon": "rotate-cw",
			"do": [{ "image": "rotateCanvas", "with": { "angle": 180 } }] },
		"rotateCanvasRight": { "title": "Rotate Image 90° Clockwise", "category": "Image", "icon": "rotate-cw-square",
			"do": [{ "image": "rotateCanvas", "with": { "angle": 90 } }] },
		"rotateCanvasLeft": { "title": "Rotate Image 90° Anticlockwise", "category": "Image", "icon": "rotate-ccw-square",
			"do": [{ "image": "rotateCanvas", "with": { "angle": 270 } }] },
		"flipCanvasHorizontal": { "title": "Flip Image Horizontal", "category": "Image", "icon": "flip-horizontal-2",
			"do": [{ "image": "flipCanvas", "with": { "direction": "horizontal" } }] },
		"flipCanvasVertical": { "title": "Flip Image Vertical", "category": "Image", "icon": "flip-vertical-2",
			"do": [{ "image": "flipCanvas", "with": { "direction": "vertical" } }] },

		"mergeDown": { "title": "Merge Down", "category": "Layer", "icon": "arrow-down-to-line",
			"enablement": "{{computed.layerBelow.kind == 'pixel' && computed.layerBelow.depth == computed.activeLayer.depth}}",
			"do": [{ "image": "mergeDown" }] },
		"mergeVisible": { "title": "Merge Visible", "category": "Layer", "icon": "layers-2",
			"enablement": "{{some(state.doc.layers, it.depth == 0 && it.visible)}}",
			"do": [{ "image": "mergeVisible" }] },
		"flattenImage": { "title": "Flatten Image", "category": "Layer", "icon": "square-stack",
			"do": [{ "image": "flatten", "with": { "background": "{{state.doc.background}}" } }] },
		"deleteHidden": { "title": "Delete Hidden Layers", "category": "Layer", "icon": "eye-off",
			"enablement": "{{some(state.doc.layers, !it.visible)}}",
			"do": [{ "image": "deleteHidden" }] },
		"showRename": { "title": "Rename Layer...", "category": "Layer", "icon": "pencil", "enablement": "{{computed.activeLayer != null}}",
			"do": [{ "set": "state.rename", "to": { "open": true, "name": "{{computed.activeLayer.name}}" } }] },
		"applyRename": [{ "if": "{{!empty(trim(state.rename.name ?? ''))}}",
			"then": [{ "image": "setLayer", "with": { "id": "{{state.doc.active}}", "name": "{{trim(state.rename.name)}}" } }] },
			{ "set": "state.rename.open", "to": false }],

		"selectAll": { "title": "All", "category": "Select", "icon": "square",
			"do": [{ "run": "select", "with": { "args": { "kind": "all" } } }] },
		"deselect": { "title": "Deselect", "category": "Select", "icon": "square-x",
			"do": [{ "run": "select", "with": { "args": { "kind": "none" } } }] },
		"invertSelection": { "title": "Inverse", "category": "Select", "icon": "contrast",
			"do": [{ "run": "select", "with": { "args": { "kind": "invert" } } }] },
		"colorRange": { "title": "Colour Range", "category": "Select", "icon": "pipette",
			"do": [{ "run": "select", "with": { "args": { "kind": "colorRange", "color": "{{state.doc.foreground}}",
				"fuzziness": 40, "allLayers": true } } }] },
		"featherSelection": { "title": "Feather 8 px", "category": "Select", "icon": "feather",
			"enablement": "{{state.doc.selection}}",
			"do": [{ "run": "feather", "with": { "args": { "radius": 8 } } }] },
		"toggleQuickMask": { "title": "Quick Mask", "category": "Select", "icon": "scan-line",
			"do": [{ "run": "setOptions", "with": { "args": { "quickMask": "{{!state.doc.options.quickMask}}" } } }] },

		"showFilter": [{ "note": "Only sets state, so a revision's button may run it; the watches preview." },
			{ "set": "state.filter.kind", "to": "{{args.kind}}" }, { "set": "state.filter.open", "to": true }],
		"previewFilterNow": [{ "if": "{{state.filter.open && state.filter.live}}",
			"then": [{ "image": "previewFilter", "with": "{{state.filter}}" }] }],
		"liveChanged": [{ "if": "{{state.filter.live}}", "then": [{ "run": "previewFilterNow" }],
			"else": [{ "image": "cancelFilter" }] }],
		"commitFilter": [{ "image": "applyFilter", "with": "{{state.filter}}" },
			{ "set": "state.filter.open", "to": false }],
		"discardFilter": [{ "image": "cancelFilter" }, { "set": "state.filter.open", "to": false }],

		"zoomIn": { "title": "Zoom In", "category": "View", "icon": "zoom-in",
			"do": [{ "run": "zoom", "with": { "args": { "by": 2 } } }] },
		"zoomOut": { "title": "Zoom Out", "category": "View", "icon": "zoom-out",
			"do": [{ "run": "zoom", "with": { "args": { "by": 0.5 } } }] },
		"actualPixels": { "title": "100%", "category": "View", "icon": "scan",
			"do": [{ "run": "zoom", "with": { "args": { "to": 1 } } }] },
		"fitOnScreen": { "title": "Fit on Screen", "category": "View", "icon": "maximize",
			"do": [{ "image": "fit" }] },
		"toggleRulers": { "title": "Rulers", "category": "View", "icon": "ruler",
			"do": [{ "toggle": "state.view.rulers" }] },
		"toggleGuides": { "title": "Guides", "category": "View", "icon": "grid-3-x-3",
			"do": [{ "toggle": "state.view.guides" }] },
		"clearGuides": { "title": "Clear Guides", "category": "View", "icon": "eraser",
			"do": [{ "set": "state.guides", "to": { "vertical": [], "horizontal": [] } }] },
		"setAdjustment": [{ "run": "setLayer", "with": { "args": { "adjustment": "{{merge(computed.adjustment, args)}}" } } }],
		"setBalance": [{ "run": "setLayer", "with": { "args": { "adjustment":
			"{{merge(computed.adjustment, {balance: map(range(3), it == args.channel ? args.value : computed.adjustment.balance[it])})}}" } } }],
		"setFilterValue": [{ "set": "{{'state.filter.' + keys(args)[0]}}", "to": "{{values(args)[0]}}" }],
		"toggleLayerKind": [{ "set": "state.layerFilter", "to": "{{ {on: true, kinds: contains(state.layerFilter.kinds, args.kind) ? filter(state.layerFilter.kinds, it != args.kind) : concat(state.layerFilter.kinds, [args.kind])} }}" }],
		"foldGroup": [{ "set": "state.foldedGroups", "to": "{{contains(state.foldedGroups, args.id) ? filter(state.foldedGroups, it != args.id) : concat(state.foldedGroups, [args.id])}}" }],
		"toggleLayerFilter": [{ "toggle": "state.layerFilter.on" }],
		"setStatusInfo": [{ "set": "state.statusInfo", "to": "{{args.id}}" }],
		"setScreenMode": [{ "set": "state.screenMode", "to": "{{args.mode}}" }],
		"cycleScreenMode": { "title": "Change Screen Mode", "category": "View", "icon": "monitor",
			"do": [{ "set": "state.screenMode", "to": "{{state.screenMode == 'standard' ? 'full' : 'standard'}}" }] },
		"addGuide": [{ "push": "state.guides[args.axis]", "value": "{{round(args.at)}}" }],
		"toggleTheme": { "title": "Dark Theme", "category": "View", "icon": "moon",
			"do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },

		"showPanel": [{ "set": "state.panels[args.slot]", "to": "{{args.id}}" }],
		"showPopout": [{ "set": "state.popout", "to": "{{ {history: args.id == 'history' && !state.popout.history, navigator: args.id == 'navigator' && !state.popout.navigator} }}" }],
		"showSearch": { "title": "Search", "category": "Help", "icon": "search", "do": [{ "set": "state.quickPick.open", "to": true }] },
		"resetWorkspace": { "title": "Reset the Workspace", "category": "Window", "icon": "layout-panel-left",
			"do": [{ "set": "state.panels", "to": { "colour": "colour", "properties": "properties", "layers": "layers" } },
			       { "set": "state.popout", "to": { "history": false, "navigator": false } }, { "set": "state.screenMode", "to": "standard" }] },
		"unavailable": { "title": "Not available yet", "enablement": "{{false}}", "do": [{ "set": "state.doc.message", "to": "Not available yet" }] },
		"showAbout": { "title": "About Tempera", "category": "Help", "icon": "info", "do": [{ "set": "state.about", "to": true }] },
		"acceptAgentProposal": [{ "accept": "{{proposals[0].id}}", "head": "{{proposals[0].head}}" }],
		"measureTones": [{ "note": "Levels and Curves show the image's tones; other layers don't need them measured." },
			{ "if": "{{computed.adjustmentKind == 'levels' || computed.adjustmentKind == 'curves'}}",
			  "then": [{ "image": "histogram", "with": { "bins": 64 } }] }]
	},

	"watch": {
		"state.filter.open": { "run": "previewFilterNow" },
		"state.filter.kind": { "run": "previewFilterNow" },
		"state.filter.radius": { "run": "previewFilterNow" },
		"state.filter.amount": { "run": "previewFilterNow" },
		"state.filter.threshold": { "run": "previewFilterNow" },
		"state.filter.angle": { "run": "previewFilterNow" },
		"state.filter.distance": { "run": "previewFilterNow" },
		"state.filter.live": { "run": "liveChanged" },
		"state.filter.apply": { "run": "commitFilter" },
		"state.filter.cancel": { "run": "discardFilter" },
		"state.doc.active": { "run": "measureTones" },
		"state.doc.revision": { "run": "measureTones" }
	},

