			"sun": { "run": "addObject", "with": { "args": { "kind": "light", "name": "Sun", "light": { "type": "directional", "intensity": 3 } } }, "title": "Sun", "icon": "sun", "order": 2 },
			"spot": { "run": "addObject", "with": { "args": { "kind": "light", "name": "Spot", "light": { "type": "spot", "intensity": 60 } } }, "title": "Spot", "icon": "cone", "order": 3 }
