{
	"$schema": "../../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Modello's actions, keys and menus: G, R and S move, turn and scale the selection after the pointer (X, Y and Z lock an axis, Shift a plane, digits type the amount, Enter or a click confirms, Escape or a right click cancels); Shift+A adds, X and Delete delete, Shift+D duplicates, H hides; the numpad turns the view; Ctrl+Z undoes. Every change of the scene goes through an action that keeps an undo snapshot first.",
	"computed": {
		"openedIsScene": "{{type(state.opened) == 'object' ? state.opened.format == 'modello-scene' && type(state.opened.added) == 'number' && (type(state.opened.scene) == 'object' ? type(state.opened.scene.materials) == 'list' && (type(state.opened.scene.nodes) == 'list' ? length(state.opened.scene.nodes) <= 500 && every(state.opened.scene.nodes, (type(it) == 'object' ? type(it.id) == 'string' && type(it.name) == 'string' && (it.kind == 'mesh' || it.kind == 'light' || it.kind == 'camera') && (type(it.translation) == 'list' ? length(it.translation) == 3 && every(it.translation, type(it) == 'number') : false) && (type(it.rotationDegrees) == 'list' ? length(it.rotationDegrees) == 3 && every(it.rotationDegrees, type(it) == 'number') : false) && (type(it.scale) == 'list' ? length(it.scale) == 3 && every(it.scale, type(it) == 'number') : false) : false)) : false) : false) : false}}",
		"centre": "{{ { x: nodes.viewport.x + nodes.viewport.width / 2 - 100, y: nodes.viewport.y + nodes.viewport.height / 2 - 60 } }}",
		"lastCentre": "{{state.lastOp == null || length(state.lastOp.base) == 0 ? [0, 0, 0] : map([sum(map(state.lastOp.base, it.translation[0])), sum(map(state.lastOp.base, it.translation[1])), sum(map(state.lastOp.base, it.translation[2]))], it / length(state.lastOp.base))}}",
		"searchItems": "{{map(filter(commands, it.enabled && it.name != 'search'), { title: it.title, detail: it.keyLabel ?? it.category, icon: it.icon, run: it.name })}}",
		"cameraNode": "{{find(state.scene.nodes, it.kind == 'camera')}}",
		"modalName": "{{state.modal ? (state.modal.mode == 'translate' ? 'Move' : state.modal.mode == 'rotate' ? 'Rotate' : 'Resize') : ''}}"
	},
	"actions": {
		"pick": [
			{ "if": "{{state.modal != null}}", "then": [{ "stop": true }] },
			{ "if": "{{event.type == 'boxSelect'}}", "then": [
				{ "set": "state.view.selection", "to": "{{concat(event.shift ? filter(state.view.selection, !contains(event.ids, it)) : [], filter(event.ids, contains(computed.pickable, it)))}}" },
				{ "if": "{{!contains(state.view.selection, state.active)}}",
				  "then": [{ "set": "state.active", "to": "{{length(state.view.selection) > 0 ? state.view.selection[length(state.view.selection) - 1] : null}}" }] },
				{ "stop": true }
			] },
			{ "if": "{{event.type != 'pick'}}", "then": [{ "stop": true }] },
			{ "if": "{{event.button == 'right' && event.shift}}", "then": [{ "set": "state.cursor", "to": "{{map(event.point, round(it * 10000) / 10000)}}" }, { "stop": true }] },
			{ "if": "{{event.button == 'right'}}", "then": [{ "run": "openPopup", "with": { "args": { "menu": "objectContext", "x": "{{nodes.viewport.x + event.x}}", "y": "{{nodes.viewport.y + event.y}}" } } }, { "stop": true }] },
			{ "if": "{{state.tool == 'cursor'}}", "then": [{ "set": "state.cursor", "to": "{{map(event.point, round(it * 10000) / 10000)}}" }, { "stop": true }] },
			{ "if": "{{state.tool == 'measure'}}", "then": [{ "run": "measurePoint", "with": { "args": { "point": "{{event.point}}", "x": "{{event.x}}", "y": "{{event.y}}" } } }, { "stop": true }] },
			{ "if": "{{state.tool == 'add'}}", "then": [{ "run": "addObject", "with": { "args": { "kind": "mesh", "mesh": "cube", "name": "Cube", "light": null, "at": "{{map(event.point, round(it * 10000) / 10000)}}" } } }, { "stop": true }] },
			{ "if": "{{event.id == null || !contains(computed.pickable, event.id)}}",
			  "then": [{ "if": "{{!event.shift}}", "then": [{ "set": "state.view.selection", "to": [] }] }, { "stop": true }] },
			{ "run": "selectNode", "with": { "args": { "id": "{{event.id}}", "shift": "{{event.shift}}" } } }
		],
		"measurePoint": [
			{ "if": "{{length(state.measure.points) >= 2 || !equals(state.measure.camera, state.view.camera)}}",
			  "then": [{ "set": "state.measure", "to": { "points": [], "screen": [], "camera": "{{state.view.camera}}" } }] },
			{ "push": "state.measure.points", "value": "{{map(args.point, round(it * 10000) / 10000)}}" },
			{ "push": "state.measure.screen", "value": "{{[args.x, args.y]}}" }
		],
		"transformed": [
			{ "if": "{{event.phase == 'preview'}}", "then": [{ "set": "state.modalText", "to": "{{event.text}}" }, { "stop": true }] },
			{ "set": "state.modal", "to": null },
			{ "set": "state.modalText", "to": "" },
			{ "if": "{{event.phase != 'end'}}", "then": [{ "stop": true }] },
			{ "run": "snapshot" },
			{ "set": "state.lastBase", "to": [] },
			{ "forEach": "{{event.nodes}}", "as": "m", "do": [
				{ "push": "state.lastBase", "value": "{{find(state.undoStack[length(state.undoStack) - 1].nodes, it.id == m.id)}}" },
				{ "set": "state.scene.nodes[indexOf(map(state.scene.nodes, it.id), m.id)]",
				  "to": "{{merge(state.scene.nodes[indexOf(map(state.scene.nodes, it.id), m.id)], { translation: map(m.translation, round(it * 10000) / 10000), rotationDegrees: map(m.rotationDegrees, round(it * 1000) / 1000), scale: map(m.scale, round(it * 10000) / 10000) })}}" }
			] },
			{ "set": "state.last", "to": "{{event.text}}" },
			{ "set": "state.lastOp", "to": "{{ { title: event.mode == 'translate' ? 'Move' : event.mode == 'rotate' ? 'Rotate' : 'Resize', kind: event.mode, base: state.lastBase, values: event.mode == 'translate' ? map(event.nodes[0].translation, round((it - state.lastBase[0].translation[index]) * 10000) / 10000) : event.mode == 'scale' ? map(event.nodes[0].scale, state.lastBase[0].scale[index] == 0 ? 1 : round(it / state.lastBase[0].scale[index] * 10000) / 10000) : null } }}" }
		],
		"search": { "title": "Search…", "category": "Edit", "icon": "search", "do": [{ "dismiss": true }, { "set": "state.quickPick", "to": { "open": true, "query": "" } }] },
		"adjustLastPanel": { "title": "Adjust Last Operation", "category": "Edit", "do": [{ "set": "state.redoOpen", "to": true }] },
		"adjustLast": [
			{ "if": "{{state.lastOp == null || state.lastOp.values == null}}", "then": [{ "stop": true }] },
			{ "set": "state.lastOp.values[args.axis]", "to": "{{round(args.value * 10000) / 10000}}" },
			{ "forEach": "{{state.lastOp.base}}", "as": "b", "do": [
				{ "set": "state.scene.nodes[indexOf(map(state.scene.nodes, it.id), b.id)]",
				  "to": "{{merge(b, state.lastOp.kind == 'scale' ? { translation: map(b.translation, computed.lastCentre[index] + (it - computed.lastCentre[index]) * state.lastOp.values[index]), scale: map(b.scale, round(it * state.lastOp.values[index] * 10000) / 10000) } : { translation: map(b.translation, round((it + state.lastOp.values[index]) * 10000) / 10000) })}}" }
			] }
		],
		"snapshot": [
			{ "set": "state.lastOp", "to": null },
			{ "push": "state.undoStack", "value": "{{state.scene}}" },
			{ "if": "{{length(state.undoStack) > 32}}", "then": [{ "remove": "state.undoStack", "at": 0 }] },
			{ "set": "state.redoStack", "to": [] }
		],
		"undo": {
			"title": "Undo", "category": "Edit", "icon": "undo-2", "enablement": "{{length(state.undoStack) > 0}}",
			"do": [
				{ "set": "state.lastOp", "to": null },
				{ "push": "state.redoStack", "value": "{{state.scene}}" },
				{ "set": "state.scene", "to": "{{state.undoStack[length(state.undoStack) - 1]}}" },
				{ "remove": "state.undoStack", "at": "{{length(state.undoStack) - 1}}" },
				{ "set": "state.view.selection", "to": "{{filter(state.view.selection, some(state.scene.nodes, it.id == state.view.selection[index]))}}" }
			]
		},
		"redo": {
			"title": "Redo", "category": "Edit", "icon": "redo-2", "enablement": "{{length(state.redoStack) > 0}}",
			"do": [
				{ "push": "state.undoStack", "value": "{{state.scene}}" },
				{ "set": "state.scene", "to": "{{state.redoStack[length(state.redoStack) - 1]}}" },
				{ "remove": "state.redoStack", "at": "{{length(state.redoStack) - 1}}" }
			]
		},
		"startTransform": [
			{ "if": "{{length(state.view.selection) == 0}}", "then": [{ "stop": true }] },
			{ "set": "state.modal", "to": { "mode": "{{args.mode}}", "axis": "view", "typed": "" } },
			{ "set": "state.modalText", "to": "{{computed.modalName}}" },
			{ "transform": "#viewport", "mode": "{{args.mode}}" }
		],
		"grab": { "title": "Move", "category": "Object", "icon": "move", "do": [{ "run": "startTransform", "with": { "args": { "mode": "translate" } } }] },
		"rotate": { "title": "Rotate", "category": "Object", "icon": "rotate-cw", "do": [{ "run": "startTransform", "with": { "args": { "mode": "rotate" } } }] },
		"resize": { "title": "Scale", "category": "Object", "icon": "scale-3-d", "do": [{ "run": "startTransform", "with": { "args": { "mode": "scale" } } }] },
		"lockAxis": [
			{ "set": "state.modal.axis", "to": "{{state.modal.axis == args.axis ? 'view' : args.axis}}" },
			{ "transform": "#viewport", "axis": "{{state.modal.axis}}" }
		],
		"typeDigit": [
			{ "set": "state.modal.typed", "to": "{{args.key == 'back' ? slice(state.modal.typed, 0, max(0, length(state.modal.typed) - 1)) : args.key == '-' ? (slice(state.modal.typed, 0, 1) == '-' ? slice(state.modal.typed, 1) : '-' + state.modal.typed) : state.modal.typed + args.key}}" },
			{ "transform": "#viewport", "value": "{{number(state.modal.typed)}}" }
		],
		"confirmTransform": [{ "transform": "#viewport", "end": "confirm" }],
		"cancelTransform": [{ "transform": "#viewport", "end": "cancel" }, { "set": "state.modal", "to": null }],
		"openPopup": [
			{ "set": "state.ctx", "to": { "open": true, "menu": "{{args.menu}}", "x": "{{args.x ?? computed.centre.x}}", "y": "{{args.y ?? computed.centre.y}}" } }
		],
		"addMenu": { "title": "Add", "category": "Object", "icon": "plus", "do": [{ "run": "openPopup", "with": { "args": { "menu": "add" } } }] },
		"deleteMenu": { "title": "Delete…", "category": "Object", "do": [{ "if": "{{length(state.view.selection) > 0}}", "then": [{ "run": "openPopup", "with": { "args": { "menu": "delete" } } }] }] },
		"uniqueName": [
			{ "set": "state.tmp", "to": { "n": 0, "name": "{{args.name}}" } },
			{ "while": "{{some(state.scene.nodes, it.name == state.tmp.name)}}", "do": [
				{ "increment": "state.tmp.n", "by": 1 },
				{ "set": "state.tmp.name", "to": "{{args.name + '.' + pad(state.tmp.n, 3, '0')}}" }
			] }
		],
		"addObject": [
			{ "dismiss": true },
			{ "if": "{{state.mode != 'object'}}", "then": [{ "set": "state.mode", "to": "object" }] },
			{ "run": "snapshot" },
			{ "increment": "state.added", "by": 1 },
			{ "run": "uniqueName", "with": { "args": { "name": "{{args.name}}" } } },
			{ "push": "state.scene.nodes", "value": {
				"id": "{{lower(args.kind)}}-{{state.added}}", "name": "{{state.tmp.name}}", "kind": "{{args.kind}}",
				"mesh": "{{args.mesh ?? null}}", "material": "{{args.kind == 'mesh' ? 'material' : null}}",
				"light": "{{args.light ?? null}}", "camera": "{{args.kind == 'camera' ? { fieldOfView: 0.69 } : null}}",
				"translation": "{{args.at ?? state.cursor}}", "rotationDegrees": [0, 0, 0], "scale": [1, 1, 1] } },
			{ "set": "state.view.selection", "to": "{{[lower(args.kind) + '-' + state.added]}}" },
			{ "set": "state.active", "to": "{{lower(args.kind) + '-' + state.added}}" },
			{ "set": "state.last", "to": "Add {{args.name}}" },
			{ "set": "state.lastOp", "to": "{{ { title: 'Add ' + args.name, kind: 'translate', label: 'Location', base: [merge(state.scene.nodes[length(state.scene.nodes) - 1], { translation: [0, 0, 0] })], values: args.at ?? state.cursor } }}" }
		],
		"deleteSelected": {
			"title": "Delete", "category": "Object", "icon": "trash-2", "enablement": "{{length(state.view.selection) > 0}}",
			"do": [
				{ "dismiss": true },
				{ "run": "snapshot" },
				{ "set": "state.scene.nodes", "to": "{{filter(state.scene.nodes, !contains(state.view.selection, it.id))}}" },
				{ "set": "state.view.selection", "to": [] },
				{ "set": "state.active", "to": null },
				{ "set": "state.last", "to": "Delete" }
			]
		},
		"duplicate": {
			"title": "Duplicate Objects", "category": "Object", "icon": "copy", "enablement": "{{length(state.view.selection) > 0}}",
			"do": [
				{ "run": "snapshot" },
				{ "set": "state.dupes", "to": [] },
				{ "forEach": "{{computed.selectedNodes}}", "as": "m", "do": [
					{ "increment": "state.added", "by": 1 },
					{ "run": "uniqueName", "with": { "args": { "name": "{{split(m.name, '.')[0]}}" } } },
					{ "push": "state.scene.nodes", "value": "{{merge(m, { id: split(m.id, '-')[0] + '-' + state.added, name: state.tmp.name })}}" },
					{ "push": "state.dupes", "value": "{{split(m.id, '-')[0] + '-' + state.added}}" }
				] },
				{ "set": "state.view.selection", "to": "{{state.dupes}}" },
				{ "set": "state.active", "to": "{{state.dupes[length(state.dupes) - 1]}}" },
				{ "after": 0, "do": [{ "run": "startTransform", "with": { "args": { "mode": "translate" } } }] }
			]
		},
		"hideSelected": {
			"title": "Hide Selected", "category": "Object", "icon": "eye-off",
			"do": [
				{ "set": "state.scene.nodes", "to": "{{map(state.scene.nodes, contains(state.view.selection, it.id) ? merge(it, { visible: false }) : it)}}" },
				{ "set": "state.view.selection", "to": [] }
			]
		},
		"hideUnselected": {
			"title": "Hide Unselected", "category": "Object",
			"do": [{ "set": "state.scene.nodes", "to": "{{map(state.scene.nodes, contains(state.view.selection, it.id) ? it : merge(it, { visible: false }))}}" }]
		},
		"revealHidden": {
			"title": "Show Hidden Objects", "category": "Object", "icon": "eye",
			"do": [
				{ "set": "state.view.selection", "to": "{{map(filter(state.scene.nodes, it.visible == false), it.id)}}" },
				{ "set": "state.scene.nodes", "to": "{{map(state.scene.nodes, merge(it, { visible: true }))}}" }
			]
		},
		"selectAll": { "title": "Select All", "category": "Select", "do": [{ "set": "state.view.selection", "to": "{{computed.pickable}}" }] },
		"selectNone": { "title": "Select None", "category": "Select", "do": [{ "set": "state.view.selection", "to": [] }] },
		"selectInvert": { "title": "Invert Selection", "category": "Select", "do": [{ "set": "state.view.selection", "to": "{{filter(computed.pickable, !contains(state.view.selection, it))}}" }] },
		"selectNode": [
			{ "if": "{{!args.shift}}", "then": [{ "set": "state.view.selection", "to": "{{[args.id]}}" }, { "set": "state.active", "to": "{{args.id}}" }, { "stop": true }] },
			{ "if": "{{contains(state.view.selection, args.id) && state.active == args.id}}",
			  "then": [{ "set": "state.view.selection", "to": "{{filter(state.view.selection, it != args.id)}}" }],
			  "else": [{ "set": "state.view.selection", "to": "{{concat(filter(state.view.selection, it != args.id), [args.id])}}" }, { "set": "state.active", "to": "{{args.id}}" }] }
		],
		"toggleFlag": [
			{ "set": "state.scene.nodes[indexOf(map(state.scene.nodes, it.id), args.id)][args.key]",
			  "to": "{{state.scene.nodes[indexOf(map(state.scene.nodes, it.id), args.id)][args.key] == false}}" },
			{ "if": "{{args.key != 'render' && state.scene.nodes[indexOf(map(state.scene.nodes, it.id), args.id)][args.key] == false}}",
			  "then": [{ "set": "state.view.selection", "to": "{{filter(state.view.selection, it != args.id)}}" }] }
		],
		"setField": [
			{ "if": "{{args.key == 'redo'}}", "then": [{ "run": "adjustLast", "with": { "args": { "axis": "{{args.axis}}", "value": "{{args.value}}" } } }, { "stop": true }] },
			{ "if": "{{computed.activeIndex < 0}}", "then": [{ "stop": true }] },
			{ "set": "state.scene.nodes[computed.activeIndex][args.key][args.axis]", "to": "{{round(args.value * 10000) / 10000}}" }
		],
		"rename": [
			{ "if": "{{trim(args.name) == '' || computed.activeIndex < 0}}", "then": [{ "stop": true }] },
			{ "run": "snapshot" },
			{ "set": "state.scene.nodes[computed.activeIndex].name", "to": "{{trim(args.name)}}" }
		],
		"setMode": { "title": "Set Mode", "category": "Object", "do": [{ "dismiss": true }, { "set": "state.mode", "to": "{{args.mode}}" }] },
		"setOption": [{ "dismiss": true }, { "set": "state[args.key]", "to": "{{args.value}}" }],
		"toggleOption": [{ "toggle": "state[args.key]" }],
		"toggleOverlay": [{ "toggle": "state.overlay[args.key]" }],
		"toggleKind": [
			{ "set": "state[args.list]", "to": "{{contains(state[args.list], args.kind) ? filter(state[args.list], it != args.kind) : concat(state[args.list], [args.kind])}}" },
			{ "set": "state.view.selection", "to": "{{filter(state.view.selection, contains(computed.pickable, it))}}" }
		],
		"setObjectGizmo": [{ "set": "state.objectGizmo", "to": "{{state.objectGizmo == args.mode ? null : args.mode}}" }],
		"toggleXray": { "title": "Toggle X-Ray", "category": "View", "icon": "square-dashed-bottom", "do": [{ "toggle": "state.xray" }] },
		"toggleSnap": { "title": "Toggle Snapping", "category": "Object", "icon": "magnet", "do": [{ "toggle": "state.snap" }] },
		"toggleOverlays": { "title": "Toggle Overlays", "category": "View", "do": [{ "toggle": "state.overlays" }] },
		"setTool": [
			{ "set": "state.tool", "to": "{{args.tool}}" },
			{ "set": "state.measure", "to": { "points": [], "screen": [], "camera": null } }
		],
		"toggleSidebar": { "title": "Sidebar", "category": "View", "do": [{ "toggle": "state.sidebar" }] },
		"toggleToolbar": { "title": "Toolbar", "category": "View", "do": [{ "set": "state.toolbar", "to": "{{state.toolbar == false}}" }] },
		"toggleTheme": { "title": "Toggle Light and Dark Theme", "category": "Window", "icon": "sun-moon", "do": [{ "set": "state.theme", "to": "{{state.theme == 'dark' ? 'light' : 'dark'}}" }] },
		"viewAxis": [{ "set": "state.inCamera", "to": false }, { "camera": "#viewport", "view": "{{args.view}}" }],
		"viewFront": { "title": "Front", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "front" } } }] },
		"viewBack": { "title": "Back", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "back" } } }] },
		"viewRight": { "title": "Right", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "right" } } }] },
		"viewLeft": { "title": "Left", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "left" } } }] },
		"viewTop": { "title": "Top", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "top" } } }] },
		"viewBottom": { "title": "Bottom", "category": "View", "do": [{ "run": "viewAxis", "with": { "args": { "view": "bottom" } } }] },
		"viewCamera": {
			"title": "Camera", "category": "View", "icon": "video", "enablement": "{{computed.cameraNode != null}}",
			"do": [
				{ "if": "{{state.inCamera}}", "then": [{ "set": "state.inCamera", "to": false }, { "stop": true }] },
				{ "set": "state.view.camera", "to": "{{ { target: [computed.cameraNode.translation[0] - sin(radians(computed.cameraNode.rotationDegrees[0])) * sin(radians(computed.cameraNode.rotationDegrees[2])) * 10, computed.cameraNode.translation[1] + sin(radians(computed.cameraNode.rotationDegrees[0])) * cos(radians(computed.cameraNode.rotationDegrees[2])) * 10, computed.cameraNode.translation[2] - cos(radians(computed.cameraNode.rotationDegrees[0])) * 10], yaw: radians(computed.cameraNode.rotationDegrees[2]), pitch: pi() / 2 - radians(computed.cameraNode.rotationDegrees[0]), distance: 10, fieldOfView: computed.cameraNode.camera.fieldOfView ?? 0.69, orthographic: false } }}" },
				{ "set": "state.inCamera", "to": true }
			]
		},
		"toggleProjection": { "title": "Perspective/Orthographic", "category": "View", "do": [{ "camera": "#viewport", "projection": "toggle" }] },
		"frameSelected": { "title": "Frame Selected", "category": "View", "do": [{ "set": "state.inCamera", "to": false }, { "camera": "#viewport", "frame": "selection" }] },
		"frameAll": { "title": "Frame All", "category": "View", "do": [{ "set": "state.inCamera", "to": false }, { "camera": "#viewport", "frame": "all" }] },
		"orbitView": [{ "set": "state.inCamera", "to": false }, { "camera": "#viewport", "orbit": "{{args.orbit}}" }],
		"zoomView": [{ "camera": "#viewport", "zoom": "{{args.steps}}" }],
		"navDrag": [
			{ "if": "{{args.id == 'zoom'}}", "then": [{ "camera": "#viewport", "zoom": "{{-args.dy * 0.05}}" }] },
			{ "if": "{{args.id == 'pan'}}", "then": [{ "set": "state.view.camera.target", "to": "{{[state.view.camera.target[0] - (cos(state.view.camera.yaw) * args.dx) * state.view.camera.distance * 0.002, state.view.camera.target[1] + (sin(state.view.camera.yaw) * args.dx) * state.view.camera.distance * 0.002, state.view.camera.target[2] + args.dy * state.view.camera.distance * 0.002]}}" }] }
		],
		"navClick": [
			{ "if": "{{args.id == 'camera'}}", "then": [{ "run": "viewCamera" }] },
			{ "if": "{{args.id == 'ortho'}}", "then": [{ "run": "toggleProjection" }] }
		],
		"insertKeyframe": {
			"title": "Insert Keyframe", "category": "Animation", "icon": "diamond", "enablement": "{{length(state.view.selection) > 0}}",
			"do": [
				{ "if": "{{!contains(state.keys, state.frame)}}", "then": [{ "set": "state.keys", "to": "{{sort(concat(state.keys, [state.frame]))}}" }] },
				{ "set": "state.last", "to": "Insert Keyframe" }
			]
		},
		"play": { "title": "Play Animation", "category": "Playback", "icon": "play", "do": [{ "set": "state.playing", "to": "{{state.playing != 'forward' ? 'forward' : false}}" }] },
		"playReverse": { "title": "Play Animation in Reverse", "category": "Playback", "do": [{ "set": "state.playing", "to": "{{state.playing != 'reverse' ? 'reverse' : false}}" }] },
		"tick": [{ "set": "state.frame", "to": "{{state.playing == 'reverse' ? (state.frame <= state.start ? state.end : state.frame - 1) : (state.frame >= state.end ? state.start : state.frame + 1)}}" }],
		"jumpStart": { "title": "Jump to Start", "category": "Playback", "do": [{ "set": "state.frame", "to": "{{state.start}}" }] },
		"jumpEnd": { "title": "Jump to End", "category": "Playback", "do": [{ "set": "state.frame", "to": "{{state.end}}" }] },
		"prevKey": { "title": "Jump to Previous Keyframe", "category": "Playback", "do": [{ "set": "state.frame", "to": "{{max(concat([state.start], filter(state.keys, it < state.frame)))}}" }] },
		"nextKey": { "title": "Jump to Next Keyframe", "category": "Playback", "do": [{ "set": "state.frame", "to": "{{min(concat([state.end], filter(state.keys, it > state.frame)))}}" }] },
		"about": { "title": "About Modello", "category": "Help", "icon": "info", "do": [{ "dismiss": true }, { "set": "state.about", "to": true }] },
		"newScene": {
			"title": "New", "category": "File", "icon": "file-plus",
			"do": [
				{ "dismiss": true },
				{ "run": "snapshot" },
				{ "set": "state.scene.nodes", "to": "{{state.startScene.nodes}}" }
			]
		},
		"saveScene": {
			"title": "Save", "category": "File", "icon": "save",
			"do": [
				{ "dismiss": true },
				{ "saveFile": "{{ { format: 'modello-scene', version: 1, scene: state.scene, added: state.added } }}", "name": "scene.json",
				  "title": "Save the scene",
				  "onDone": [{ "set": "state.fileStatus", "to": "{{'Saved ' + result.name}}" }],
				  "onError": [{ "set": "state.fileStatus", "to": "{{'Not saved: ' + error.message}}" }] }
			]
		},
		"openScene": {
			"title": "Open…", "category": "File", "icon": "folder-open",
			"do": [
				{ "dismiss": true },
				{ "openFile": "state.opened", "extensions": ["json"], "title": "Open a scene",
				  "onDone": [{ "set": "state.openedName", "to": "{{result.name}}" }, { "run": "sceneOpened" }],
				  "onError": [{ "set": "state.fileStatus", "to": "{{'Not opened: ' + error.message}}" }] }
			]
		},
		"sceneOpened": [
			{ "if": "{{computed.openedIsScene}}",
			  "then": [
				{ "if": "{{state.mode != 'object'}}", "then": [{ "set": "state.mode", "to": "object" }] },
				{ "run": "snapshot" },
				{ "set": "state.scene", "to": "{{state.opened.scene}}" },
				{ "set": "state.added", "to": "{{max(state.added, state.opened.added)}}" },
				{ "set": "state.view.selection", "to": [] },
				{ "set": "state.active", "to": null },
				{ "set": "state.fileStatus", "to": "{{'Opened ' + state.openedName}}" }
			  ],
			  "else": [{ "set": "state.fileStatus", "to": "{{'Not opened: ' + (state.openedName ?? 'the file') + ' is not a Modello scene'}}" }] },
			{ "set": "state.opened", "to": null },
			{ "set": "state.openedName", "to": null }
		]
	},
	"keys": {
		"g": { "do": "grab" },
		"r": { "do": "rotate" },
		"s": { "do": "resize" },
		"x": [{ "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "x" } } }, { "do": "deleteMenu" }],
		"y": [{ "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "y" } } }],
		"z": [{ "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "z" } } }, { "do": "openPopup", "with": { "args": { "menu": "shading" } } }],
		"shift+x": { "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "yz" } } },
		"shift+y": { "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "zx" } } },
		"shift+z": { "when": "{{state.modal != null}}", "do": "lockAxis", "with": { "args": { "axis": "xy" } } },
		"0": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "0" } } }],
		"1": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "1" } } }],
		"2": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "2" } } }],
		"3": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "3" } } }],
		"4": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "4" } } }],
		"5": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "5" } } }],
		"6": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "6" } } }],
		"7": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "7" } } }],
		"8": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "8" } } }],
		"9": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "9" } } }],
		"period": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "." } } }],
		"minus": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "-" } } }],
		"backspace": [{ "when": "{{state.modal != null}}", "do": "typeDigit", "with": { "args": { "key": "back" } } }],
		"enter": [{ "when": "{{state.modal != null}}", "do": "confirmTransform" }],
		"escape": [{ "when": "{{state.modal != null}}", "do": "cancelTransform" }],
		"shift+a": { "do": "addMenu" },
		"delete": { "do": "deleteSelected" },
		"shift+d": { "do": "duplicate" },
		"h": { "do": "hideSelected" },
		"shift+h": { "do": "hideUnselected" },
		"alt+h": { "do": "revealHidden" },
		"a": { "do": "selectAll" },
		"alt+a": { "do": "selectNone" },
		"mod+i": { "do": "selectInvert" },
		"numpad1": { "do": "viewFront" },
		"mod+numpad1": { "do": "viewBack" },
		"numpad3": { "do": "viewRight" },
		"mod+numpad3": { "do": "viewLeft" },
		"numpad7": { "do": "viewTop" },
		"mod+numpad7": { "do": "viewBottom" },
		"numpad5": { "do": "toggleProjection" },
		"numpad0": { "do": "viewCamera" },
		"numpadperiod": { "do": "frameSelected" },
		"home": { "do": "frameAll" },
		"numpad4": { "do": "orbitView", "with": { "args": { "orbit": [-15, 0] } } },
		"numpad6": { "do": "orbitView", "with": { "args": { "orbit": [15, 0] } } },
		"numpad8": { "do": "orbitView", "with": { "args": { "orbit": [0, -15] } } },
		"numpad2": { "do": "orbitView", "with": { "args": { "orbit": [0, 15] } } },
		"numpadplus": { "do": "zoomView", "with": { "args": { "steps": 1 } } },
		"numpadminus": { "do": "zoomView", "with": { "args": { "steps": -1 } } },
		"mod+z": { "do": "undo" },
		"mod+shift+z": { "do": "redo" },
		"n": { "do": "toggleSidebar" },
		"f3": { "do": "search" },
		"f9": { "when": "{{state.lastOp != null}}", "do": "adjustLastPanel" },
		"t": { "do": "toggleToolbar" },
		"alt+z": { "do": "toggleXray" },
		"shift+alt+z": { "do": "toggleOverlays" },
		"shift+tab": { "when": "{{!context.textInputFocus}}", "do": "toggleSnap" },
		"i": { "do": "insertKeyframe" },
		"space": { "when": "{{!context.textInputFocus}}", "do": "play" },
		"shift+left": { "do": "jumpStart" },
		"shift+right": { "do": "jumpEnd" },
		"mod+n": { "do": "newScene" },
		"mod+s": { "do": "saveScene" },
		"mod+o": { "do": "openScene" }
	},
	"menus": {
