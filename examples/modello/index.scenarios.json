{
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "Modello's scenarios: the stock host's runtime plays them (affrescoui test examples/modello/index.scenarios.json)",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "modello-start",
			"note": "The start scene: the cube selected and active, its name in the properties, the status bar's counts",
			"steps": [
				{ "expect": { "state": "view.selection", "is": ["cube"] } },
				{ "expect": { "state": "active", "is": "cube" } },
				{ "expect": { "node": "#viewport", "exists": true } },
				{ "expect": { "state": "ctx.open", "is": false } }
			]
		},
		{
			"name": "modello-grab-typed",
			"note": "G, X, 2, Enter moves the cube two units along X; Ctrl+Z puts it back",
			"steps": [
				{ "key": "g" },
				{ "expect": { "state": "modal.mode", "is": "translate" } },
				{ "key": "x" },
				{ "expect": { "state": "modal.axis", "is": "x" } },
				{ "key": "2" },
				{ "key": "enter" },
				{ "wait": 20 },
				{ "expect": { "state": "modal", "is": null } },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [2, 0, 0] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [0, 0, 0] } }
			]
		},
		{
			"name": "modello-adjust-last",
			"note": "After G, X, 2, Enter the Adjust Last Operation panel shows Move [2, 0, 0]; its X field stepped moves the cube again; Ctrl+Z hides it",
			"steps": [
				{ "key": "g" },
				{ "key": "x" },
				{ "key": "2" },
				{ "key": "enter" },
				{ "wait": 20 },
				{ "expect": { "state": "lastOp.values", "is": [2, 0, 0] } },
				{ "expect": { "node": "#redo-panel", "exists": true } },
				{ "click": "#field-redo-0" },
				{ "key": "right" },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [2.1, 0, 0] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "lastOp", "is": null } }
			]
		},
		{
			"name": "modello-search",
			"note": "F3 opens the search over the commands; Escape closes it",
			"steps": [
				{ "key": "f3" },
				{ "wait": 20 },
				{ "expect": { "state": "quickPick.open", "is": true } },
				{ "expect": { "node": "#search", "exists": true } },
				{ "key": "escape" },
				{ "wait": 20 },
				{ "expect": { "state": "quickPick.open", "is": false } }
			]
		},
		{
			"name": "modello-scale-cancel",
			"note": "S, 3, Escape leaves the scale as it was",
			"steps": [
				{ "key": "s" },
				{ "key": "3" },
				{ "key": "escape" },
				{ "wait": 20 },
				{ "expect": { "state": "modal", "is": null } },
				{ "expect": { "state": "scene.nodes[1].scale", "is": [1, 1, 1] } }
			]
		},
		{
			"name": "modello-add-delete",
			"note": "Shift+A opens the Add menu; X opens Delete; select all, then H hides and Alt+H reveals",
			"steps": [
				{ "key": "shift+a" },
				{ "expect": { "state": "ctx.menu", "is": "add" } },
				{ "expect": { "state": "ctx.open", "is": true } },
				{ "key": "escape" },
				{ "key": "x" },
				{ "expect": { "state": "ctx.menu", "is": "delete" } },
				{ "key": "escape" },
				{ "key": "a" },
				{ "expect": { "state": "view.selection", "is": ["camera", "cube", "light"] } },
				{ "key": "h" },
				{ "expect": { "state": "scene.nodes[1].visible", "is": false } },
				{ "key": "alt+h" },
				{ "expect": { "state": "scene.nodes[1].visible", "is": true } }
			]
		},
		{ "name": "modello-assistant-open", "note": "The assistant's panel open over the viewport, with no agent connected: the note on how to connect one and three suggestions",
		  "steps": [{ "key": "mod+shift+a" }, { "wait": 300 }, { "expect": { "state": "assistant.open", "is": true } }] },
		{
			"name": "modello-assistant",
			"note": "Ctrl+Shift+A opens the assistant's panel and Escape closes it",
			"steps": [
				{ "key": "mod+shift+a" },
				{ "wait": 50 },
				{ "expect": { "state": "assistant.open", "is": true } },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "expect": { "state": "assistant.open", "is": false } }
			]
		},
		{
			"name": "modello-views",
			"note": "Numpad 7 looks from the top, 5 switches to orthographic, Ctrl+numpad 1 looks from the back, N opens the sidebar",
			"steps": [
				{ "key": "numpad7" },
				{ "wait": 20 },
				{ "expect": { "node": "#view-name", "text": "Top Perspective" } },
				{ "key": "numpad5" },
				{ "wait": 50 },
				{ "expect": { "state": "view.camera.orthographic", "is": true } },
				{ "key": "mod+numpad1" },
				{ "wait": 20 },
				{ "expect": { "node": "#view-name", "text": "Back Orthographic" } },
				{ "key": "n" },
				{ "expect": { "state": "sidebar", "is": true } }
			]
		},
		{
			"name": "modello-save-and-open",
			"note": "Ctrl+S saves the scene as JSON and Ctrl+O opens it again, as an undoable change; a cancelled dialog changes nothing",
			"steps": [
				{ "choose": "scene.json" },
				{ "key": "mod+s" },
				{ "wait": 0 },
				{ "expect": { "state": "fileStatus", "is": "Saved scene.json" } },
				{ "action": "deleteSelected" },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "key": "mod+o" },
				{ "wait": 0 },
				{ "expect": { "state": "scene.nodes.length", "is": 3 } },
				{ "expect": { "state": "scene.nodes[1].id", "is": "cube" } },
				{ "expect": { "state": "fileStatus", "is": "Opened scene.json" } },
				{ "expect": { "state": "opened", "is": null } },
				{ "expect": { "state": "view.selection", "is": [] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "choose": null },
				{ "key": "mod+o" },
				{ "wait": 0 },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "expect": { "state": "fileStatus", "is": "Opened scene.json" } }
			]
		},
		{
			"name": "modello-open-refuses-other-files",
			"note": "A file that isn't a Modello scene (or one whose objects lack a place) is refused and the scene stays as it was",
			"steps": [
				{ "revision": { "type": "revision", "message": "Another app's file", "set": {
					"/state/opened": { "format": "modello-scene", "version": 1, "added": 0, "scene": { "materials": [], "nodes": [{ "id": "a", "name": "A", "kind": "mesh" }] } } } } },
				{ "action": "sceneOpened" },
				{ "wait": 0 },
				{ "expect": { "state": "fileStatus", "is": "Not opened: the file is not a Modello scene" } },
				{ "expect": { "state": "scene.nodes.length", "is": 3 } },
				{ "expect": { "state": "opened", "is": null } },
				{ "expect": { "state": "undoStack.length", "is": 0 } }
			]
		}
	]
}
