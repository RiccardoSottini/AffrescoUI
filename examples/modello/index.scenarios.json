{
	"format": "affrescoui-scenarios",
	"version": 2,
	"note": "Modello's scenarios: the stock host's runtime plays them (affrescoui test examples/modello/index.scenarios.json)",
	"screen": "index.screen.json",
	"scenarios": [
		{
			"name": "modello-start",
			"note": "The start scene: the cube selected and active, its name in the properties, the status bar's counts",
			"steps": [
				{ "expect": { "state": "view.selection", "is": ["cube"] } },
				{ "expect": { "state": "active", "is": "cube" } },
				{ "expect": { "node": "#viewport", "exists": true } },
				{ "expect": { "state": "ctx.open", "is": false } }
			]
		},
		{
			"name": "modello-grab-typed",
			"note": "G, X, 2, Enter moves the cube two units along X; Ctrl+Z puts it back",
			"steps": [
				{ "key": "g" },
				{ "expect": { "state": "modal.mode", "is": "translate" } },
				{ "key": "x" },
				{ "expect": { "state": "modal.axis", "is": "x" } },
				{ "key": "2" },
				{ "key": "enter" },
				{ "wait": 20 },
				{ "expect": { "state": "modal", "is": null } },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [2, 0, 0] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [0, 0, 0] } }
			]
		},
		{
			"name": "modello-adjust-last",
			"note": "After G, X, 2, Enter the Adjust Last Operation panel shows Move [2, 0, 0]; its X field stepped moves the cube again; Ctrl+Z hides it",
			"steps": [
				{ "key": "g" },
				{ "key": "x" },
				{ "key": "2" },
				{ "key": "enter" },
				{ "wait": 20 },
				{ "expect": { "state": "lastOp.values", "is": [2, 0, 0] } },
				{ "expect": { "node": "#redo-panel", "exists": true } },
				{ "click": "#field-redo-0" },
				{ "key": "right" },
				{ "expect": { "state": "scene.nodes[1].translation", "is": [2.1, 0, 0] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "lastOp", "is": null } }
			]
		},
		{
			"name": "modello-search",
			"note": "F3 opens the search over the commands; Escape closes it",
			"steps": [
				{ "key": "f3" },
				{ "wait": 20 },
				{ "expect": { "state": "quickPick.open", "is": true } },
				{ "expect": { "node": "#search", "exists": true } },
				{ "key": "escape" },
				{ "wait": 20 },
				{ "expect": { "state": "quickPick.open", "is": false } }
			]
		},
		{
			"name": "modello-scale-cancel",
			"note": "S, 3, Escape leaves the scale as it was",
			"steps": [
				{ "key": "s" },
				{ "key": "3" },
				{ "key": "escape" },
				{ "wait": 20 },
				{ "expect": { "state": "modal", "is": null } },
				{ "expect": { "state": "scene.nodes[1].scale", "is": [1, 1, 1] } }
			]
		},
		{
			"name": "modello-add-delete",
			"note": "Shift+A opens the Add menu; X opens Delete; select all, then H hides and Alt+H reveals",
			"steps": [
				{ "key": "shift+a" },
				{ "expect": { "state": "ctx.menu", "is": "add" } },
				{ "expect": { "state": "ctx.open", "is": true } },
				{ "key": "escape" },
				{ "key": "x" },
				{ "expect": { "state": "ctx.menu", "is": "delete" } },
				{ "key": "escape" },
				{ "key": "a" },
				{ "expect": { "state": "view.selection", "is": ["camera", "cube", "light"] } },
				{ "key": "h" },
				{ "expect": { "state": "scene.nodes[1].visible", "is": false } },
				{ "key": "alt+h" },
				{ "expect": { "state": "scene.nodes[1].visible", "is": true } }
			]
		},
		{ "name": "modello-assistant-open", "note": "The assistant's panel open over the viewport, with no agent connected: the note on how to connect one and three suggestions",
		  "steps": [{ "key": "mod+shift+a" }, { "wait": 300 }, { "expect": { "state": "assistant.open", "is": true } }] },
		{
			"name": "modello-assistant",
			"note": "Ctrl+Shift+A opens the assistant's panel and Escape closes it",
			"steps": [
				{ "key": "mod+shift+a" },
				{ "wait": 50 },
				{ "expect": { "state": "assistant.open", "is": true } },
				{ "key": "escape" },
				{ "wait": 50 },
				{ "expect": { "state": "assistant.open", "is": false } }
			]
		},
		{
			"name": "modello-views",
			"note": "Numpad 7 looks from the top, 5 switches to orthographic, Ctrl+numpad 1 looks from the back, N opens the sidebar",
			"steps": [
				{ "key": "numpad7" },
				{ "wait": 20 },
				{ "expect": { "node": "#view-name", "text": "Top Perspective" } },
				{ "key": "numpad5" },
				{ "wait": 50 },
				{ "expect": { "state": "view.camera.orthographic", "is": true } },
				{ "key": "mod+numpad1" },
				{ "wait": 20 },
				{ "expect": { "node": "#view-name", "text": "Back Orthographic" } },
				{ "key": "n" },
				{ "expect": { "state": "sidebar", "is": true } }
			]
		},
		{
			"name": "modello-save-and-open",
			"note": "Ctrl+S saves the scene as JSON and Ctrl+O opens it again, as an undoable change; a cancelled dialog changes nothing",
			"steps": [
				{ "choose": "scene.json" },
				{ "key": "mod+s" },
				{ "wait": 0 },
				{ "expect": { "state": "fileStatus", "is": "Saved scene.json" } },
				{ "action": "deleteSelected" },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "key": "mod+o" },
				{ "wait": 0 },
				{ "expect": { "state": "scene.nodes.length", "is": 3 } },
				{ "expect": { "state": "scene.nodes[1].id", "is": "cube" } },
				{ "expect": { "state": "fileStatus", "is": "Opened scene.json" } },
				{ "expect": { "state": "opened", "is": null } },
				{ "expect": { "state": "view.selection", "is": [] } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "choose": null },
				{ "key": "mod+o" },
				{ "wait": 0 },
				{ "expect": { "state": "scene.nodes.length", "is": 2 } },
				{ "expect": { "state": "fileStatus", "is": "Opened scene.json" } }
			]
		},
		{
			"name": "modello-open-refuses-other-files",
			"note": "A file that isn't a Modello scene (or one whose objects lack a place) is refused and the scene stays as it was",
			"steps": [
				{ "revision": { "type": "revision", "message": "Another app's file", "set": {
					"/state/opened": { "format": "modello-scene", "version": 1, "added": 0, "scene": { "materials": [], "nodes": [{ "id": "a", "name": "A", "kind": "mesh" }] } } } } },
				{ "action": "sceneOpened" },
				{ "wait": 0 },
				{ "expect": { "state": "fileStatus", "is": "Not opened: the file is not a Modello scene" } },
				{ "expect": { "state": "scene.nodes.length", "is": 3 } },
				{ "expect": { "state": "opened", "is": null } },
				{ "expect": { "state": "undoStack.length", "is": 0 } }
			]
		},
		{
			"name": "modello-header-transform",
			"note": "The header's transform settings: the snap step from its menu and Shift+Tab, Normal orientation turns the gizmo to local, the bounding box pivot; proportional editing is shown disabled with its reason",
			"steps": [
				{ "click": "#snap-target" },
				{ "click": { "role": "menuitem", "name": "Increment 10 m, 15°" } },
				{ "expect": { "state": "snapStep", "is": "coarse" } },
				{ "key": "shift+tab" },
				{ "expect": { "state": "snap", "is": true } },
				{ "click": "#orientation" },
				{ "click": { "role": "menuitem", "name": "Normal" } },
				{ "expect": { "state": "orientation", "is": "normal" } },
				{ "key": "g" },
				{ "expect": { "state": "modal.mode", "is": "translate" } },
				{ "key": "escape" },
				{ "click": "#pivot" },
				{ "click": { "role": "menuitem", "name": "Bounding Box Center" } },
				{ "expect": { "state": "pivot", "is": "bounds" } },
				{ "click": "#proportional" },
				{ "expect": { "node": "#proportional", "property": "tooltip", "is": "Proportional Editing isn't available yet: it moves a mesh's vertices" } },
				{ "click": "#mode" },
				{ "click": { "role": "menuitem", "name": "Edit Mode" } },
				{ "expect": { "state": "mode", "is": "object" } }
			]
		},
		{
			"name": "modello-header-display",
			"note": "The display menus: X-ray with Alt+Z, the statistics overlay, overlays off with Shift+Alt+Z, lights hidden by kind, the navigation gizmo off, scene lights for the material preview",
			"steps": [
				{ "key": "alt+z" },
				{ "expect": { "state": "xray", "is": true } },
				{ "click": "#overlays-menu" },
				{ "click": { "role": "menuitem", "name": "Statistics" } },
				{ "expect": { "state": "overlay.stats", "is": true } },
				{ "expect": { "node": "#view-stats", "text": "Objects 1 / 3   Lights 1   Cameras 1" } },
				{ "key": "escape" },
				{ "key": "shift+alt+z" },
				{ "expect": { "state": "overlays", "is": false } },
				{ "expect": { "node": "#view-name", "exists": false } },
				{ "key": "shift+alt+z" },
				{ "click": "#visibility" },
				{ "click": { "role": "menuitem", "name": "Lights Visible" } },
				{ "expect": { "state": "hiddenKinds", "is": ["light"] } },
				{ "key": "escape" },
				{ "key": "a" },
				{ "expect": { "state": "view.selection", "is": ["camera", "cube"] } },
				{ "click": "#gizmos-menu" },
				{ "click": { "role": "menuitem", "name": "Navigate" } },
				{ "expect": { "state": "navGizmo", "is": false } },
				{ "expect": { "node": "#navigator", "exists": false } },
				{ "key": "escape" },
				{ "click": "#shading-material" },
				{ "click": "#shading-menu" },
				{ "click": { "role": "menuitem", "name": "Scene Lights" } },
				{ "expect": { "state": "sceneLights", "is": true } }
			]
		},
		{
			"name": "modello-tools",
			"note": "The toolbar's tools: a click with Cursor places the 3D cursor, Measure takes two points and shows the distance, Add Cube adds one where clicked; Transform is disabled; a click on nothing clears the selection and a box selects the meshes in it",
			"steps": [
				{ "click": "#tool-transform" },
				{ "expect": { "state": "tool", "is": "select" } },
				{ "click": [300, 650] },
				{ "expect": { "state": "view.selection", "is": [] } },
				{ "click": [550, 340] },
				{ "expect": { "state": "view.selection", "is": ["cube"] } },
				{ "click": "#tool-cursor" },
				{ "action": "pick", "event": { "type": "pick", "id": null, "button": "left", "shift": false, "x": 300, "y": 600, "point": [1.5, -2.25, 0] } },
				{ "expect": { "state": "cursor", "is": [1.5, -2.25, 0] } },
				{ "click": "#tool-measure" },
				{ "click": [300, 600] },
				{ "click": [700, 650] },
				{ "expect": { "state": "measure.points.length", "is": 2 } },
				{ "expect": { "node": "#measure-length", "exists": true } },
				{ "click": "#tool-add" },
				{ "action": "pick", "event": { "type": "pick", "id": null, "button": "left", "shift": false, "x": 300, "y": 600, "point": [2, 1, 0] } },
				{ "expect": { "state": "scene.nodes.length", "is": 4 } },
				{ "expect": { "state": "scene.nodes[3].translation", "is": [2, 1, 0] } },
				{ "click": "#tool-select" },
				{ "drag": [150, 200], "to": [1000, 700] },
				{ "expect": { "state": "view.selection", "is": ["cube", "mesh-1"] } }
			]
		},
		{
			"name": "modello-sidebar-fields",
			"note": "The sidebar: a lock keeps an axis still under G; the Tool tab toggles snapping; the View tab sets the focal length and orthographic view; the 3D Cursor fields move the cursor and Reset puts it back; the rotation mode is disabled; undo keeps the selection",
			"steps": [
				{ "click": [550, 340] },
				{ "key": "n" },
				{ "click": "#lock-translation-0" },
				{ "expect": { "state": "scene.nodes[1].lock_translation", "is": [true, false, false] } },
				{ "expect": { "node": "#lock-translation-0", "property": "tooltip", "is": "Locked: moving with the gizmo or G, R and S leaves it" } },
				{ "key": "g" },
				{ "key": "x" },
				{ "key": "2" },
				{ "key": "enter" },
				{ "wait": 20 },
				{ "expect": { "state": "scene.nodes[1].translation[0]", "is": 0 } },
				{ "click": "#field-translation-1" },
				{ "key": "right" },
				{ "expect": { "state": "scene.nodes[1].translation[1]", "is": 0.1 } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes[1].translation[1]", "is": 0 } },
				{ "expect": { "state": "view.selection", "is": ["cube"] } },
				{ "expect": { "node": "#rotation-mode", "property": "tooltip", "is": "Other rotation modes (quaternion, axis angle) aren't available yet" } },
				{ "click": { "role": "tab", "name": "Tool" } },
				{ "click": "#tool-snap" },
				{ "expect": { "state": "snap", "is": true } },
				{ "click": { "role": "tab", "name": "View" } },
				{ "click": "#field-lens-0" },
				{ "key": "right" },
				{ "expect": { "state": "view.camera.fieldOfView", "is": 0.622 } },
				{ "click": "#view-ortho" },
				{ "expect": { "state": "view.camera.orthographic", "is": true } },
				{ "click": "#field-cursor-0" },
				{ "key": "right" },
				{ "expect": { "state": "cursor", "is": [0.1, 0, 0] } },
				{ "click": "#cursor-reset" },
				{ "expect": { "state": "cursor", "is": [0, 0, 0] } }
			]
		},
		{
			"name": "modello-top-bar",
			"note": "An editor's type menu swaps it with the area showing the chosen editor; the unbuilt editor types and workspaces are disabled; a workspace applies its preset (the timeline's size, the shading, the properties tab); the scene and view layer names can be edited, their pickers are disabled",
			"steps": [
				{ "click": "#editor-type-timeline" },
				{ "click": { "role": "menuitem", "name": "3D Viewport" } },
				{ "expect": { "state": "areas", "is": { "a": "timeline", "b": "viewport", "c": "outliner", "d": "properties" } } },
				{ "expect": { "node": "#viewport", "exists": true } },
				{ "click": "#editor-type-outliner" },
				{ "click": { "role": "menuitem", "name": "Image Editor" } },
				{ "key": "escape" },
				{ "expect": { "state": "areas.c", "is": "outliner" } },
				{ "click": "#workspace-animation" },
				{ "expect": { "state": "workspace", "is": "Animate" } },
				{ "expect": { "state": "areas.a", "is": "viewport" } },
				{ "expect": { "state": "sizes.left", "is": [520] } },
				{ "click": "#workspace-shading" },
				{ "expect": { "state": "shading", "is": "material" } },
				{ "expect": { "state": "propTab", "is": "material" } },
				{ "click": "#workspace-sculpting" },
				{ "expect": { "state": "workspace", "is": "Materials" } },
				{ "expect": { "node": "#workspace-sculpting", "property": "tooltip", "is": "Sculpt isn't available yet: it needs sculpting a mesh" } },
				{ "click": "#workspace-layout" },
				{ "expect": { "state": "shading", "is": "solid" } },
				{ "expect": { "state": "sizes.left", "is": [720] } },
				{ "click": "#scene-name-field" },
				{ "key": "end" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "type": "Studio" },
				{ "key": "enter" },
				{ "expect": { "state": "sceneName", "is": "Studio" } },
				{ "click": "#layer-picker" },
				{ "expect": { "node": "#layer-picker", "property": "tooltip", "is": "Modello has one view layer: more layers aren't available yet" } }
			]
		},
		{
			"name": "modello-outliner",
			"note": "The outliner's display mode and filter menus, its chevrons, the collection's toggles, a double click or F2 that renames in place and the row's context menu all work; New Collection is disabled with its reason",
			"steps": [
				{ "click": "#outliner-filter" },
				{ "click": { "role": "menuitem", "name": "Lights" } },
				{ "expect": { "state": "outlinerHide", "is": ["light"] } },
				{ "expect": { "node": "#outliner-light", "exists": false } },
				{ "click": "#outliner-filter" },
				{ "click": { "role": "menuitem", "name": "Only Selected" } },
				{ "expect": { "node": "#outliner-camera", "exists": false } },
				{ "click": "#outliner-filter" },
				{ "click": { "role": "menuitem", "name": "Only Selected" } },
				{ "click": "#outliner-display" },
				{ "click": { "role": "menuitem", "name": "Object List" } },
				{ "expect": { "state": "outlinerMode", "is": "list" } },
				{ "expect": { "node": "#outliner-root", "exists": false } },
				{ "click": "#outliner-display" },
				{ "click": { "role": "menuitem", "name": "View Layer" } },
				{ "expect": { "node": "#outliner-new", "property": "tooltip", "is": "Modello keeps one collection: more collections aren't available yet" } },
				{ "click": "#outliner-cube-chevron" },
				{ "expect": { "node": "#outliner-cube-data", "exists": true } },
				{ "expect": { "node": "#outliner-cube-material", "exists": true } },
				{ "click": "#outliner-cube-material" },
				{ "expect": { "state": "propTab", "is": "material" } },
				{ "capture": "expanded" },
				{ "click": "#outliner-collection-chevron" },
				{ "expect": { "node": "#outliner-cube", "exists": false } },
				{ "click": "#outliner-collection-chevron" },
				{ "click": "#outliner-collection-visible" },
				{ "expect": { "state": "collection.visible", "is": false } },
				{ "click": [480, 300] },
				{ "expect": { "state": "view.selection", "is": [] } },
				{ "click": "#outliner-collection-visible" },
				{ "wait": 500 },
				{ "click": "#outliner-camera" },
				{ "click": "#outliner-camera" },
				{ "wait": 0 },
				{ "expect": { "state": "renaming", "is": "camera" } },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "key": "backspace" },
				{ "type": "Shot" },
				{ "key": "enter" },
				{ "expect": { "state": "scene.nodes[0].name", "is": "Shot" } },
				{ "expect": { "state": "renaming", "is": null } },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.nodes[0].name", "is": "Camera" } },
				{ "click": "#outliner-cube" },
				{ "key": "shift+f10" },
				{ "expect": { "state": "ctx.menu", "is": "outlinerContext" } },
				{ "capture": "context" },
				{ "click": { "role": "menuitem", "name": "Rename" } },
				{ "wait": 100 },
				{ "expect": { "state": "renaming", "is": "cube" } },
				{ "key": "escape" },
				{ "expect": { "state": "renaming", "is": null } },
				{ "expect": { "state": "scene.nodes[1].name", "is": "Cube" } },
				{ "click": "#outliner-camera" },
				{ "key": "f2" },
				{ "wait": 100 },
				{ "expect": { "state": "renaming", "is": "camera" } },
				{ "type": "2" },
				{ "key": "enter" },
				{ "expect": { "state": "scene.nodes[0].name", "is": "Camera2" } }
			]
		},
		{
			"name": "modello-properties",
			"note": "The properties editor's panels edit the scene: the material's metallic and base colour (a picker, undone in one step), the world colour, a light's type and power, a camera's focal length, the frame range, the exposure, an object's and the collection's visibility; the search keeps the panels that match; the tabs and panels Modello can't fill yet are disabled and say why.",
			"steps": [
				{ "click": "#prop-tab-material" },
				{ "click": "#field-scene-materials-0-metallic" },
				{ "key": "right" },
				{ "expect": { "state": "scene.materials[0].metallic", "is": 0.05 } },
				{ "click": "#color-material" },
				{ "wait": 50 },
				{ "click": [1130, 410] },
				{ "wait": 50 },
				{ "expect": { "state": "scene.materials[0].baseColor", "is": [0.9608, 0.9216, 0.9216, 1.0] } },
				{ "capture": "material" },
				{ "key": "mod+z" },
				{ "expect": { "state": "scene.materials[0].baseColor", "is": [0.8, 0.8, 0.8, 1] } },
				{ "click": "#color-material" },
				{ "click": "#properties-search" },
				{ "type": "rough" },
				{ "expect": { "node": "#field-scene-materials-0-roughness", "exists": true } },
				{ "expect": { "node": "#panel-materialSettings", "exists": false } },
				{ "key": "backspace" },
{ "key": "backspace" },
{ "key": "backspace" },
{ "key": "backspace" },
{ "key": "backspace" },
				{ "expect": { "node": "#panel-materialSettings", "property": "tooltip", "is": "Blend and shadow settings aren't available yet" } },
				{ "click": "#prop-tab-world" },
				{ "click": "#color-world" },
				{ "wait": 50 },
				{ "click": [1130, 410] },
				{ "wait": 50 },
				{ "expect": { "state": "world.color", "is": "#ebeff5" } },
				{ "click": "#color-world" },
				{ "click": "#outliner-light" },
				{ "click": "#prop-tab-data" },
				{ "click": "#light-type-spot" },
				{ "expect": { "state": "scene.nodes[2].light.type", "is": "spot" } },
				{ "click": "#field-scene-nodes-2-light-intensity" },
				{ "key": "left" },
				{ "expect": { "state": "scene.nodes[2].light.intensity", "is": 55.0 } },
				{ "capture": "light" },
