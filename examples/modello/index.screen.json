{
	"$schema": "../../schema/affrescoui-screen.schema.json",
	"format": "affrescoui-screen",
	"version": 2,
	"note": "Modello, a 3D modeller, written only in the format: the stock host runs it. This file names the window, the fonts, the colours, the state and the areas; parts/commands.json holds the actions, keys and menus, parts/viewport.json the 3D viewport and its header, parts/editors.json the other editors (outliner, properties, timeline) and the bars.",
	"window": { "title": "Modello", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 640 },
	"fonts": {
		"default": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 12, "fallback": ["icons"] },
		"small": { "file": "../shared/fonts/Roboto-Regular.ttf", "size": 11, "fallback": ["icons"] },
		"icons": { "file": "../shared/fonts/Lucide.ttf", "size": 14 },
		"iconsSmall": { "file": "../shared/fonts/Lucide.ttf", "size": 12 }
	},
	"include": ["parts/commands.json", "parts/viewport.json", "parts/editors.json", "../shared/addons/assistant/assistant.json"],
	"theme": "{{state.theme}}",
	"tokens": {
		"gap": { "dark": "#0e1116", "light": "#9aa3ae" },
		"bar": { "dark": "#161a21", "light": "#c9d0d8" },
		"header": { "dark": "#222833", "light": "#d6dce3" },
		"view": { "dark": "#2b323d", "light": "#bcc4cd" },
		"region": { "dark": "#1c2129", "light": "#e3e8ed" },
		"rowAlt": { "dark": "#212730", "light": "#dbe1e7" },
		"panel": { "dark": "#29303b", "light": "#e9edf1" },
		"panelBack": { "dark": "#20262f", "light": "#d9dfe5" },
		"widget": { "dark": "#38404d", "light": "#f4f6f8" },
		"widgetHover": { "dark": "#465061", "light": "#ffffff" },
		"menuWidget": { "dark": "#1f252e", "light": "#e6eaee" },
		"field": { "dark": "#12161c", "light": "#ffffff" },
		"text": { "dark": "#e3e8ef", "light": "#161b22" },
		"dim": { "dark": "#93a0b0", "light": "#4f5966" },
		"faint": { "dark": "#535e6c", "light": "#96a0ac" },
		"sel": { "dark": "#1f7f74", "light": "#1f8a7d" },
		"selRow": { "dark": "#1b3f3d", "light": "#a9dcd4" },
		"active": { "dark": "#6ff2df", "light": "#007f72" },
		"selected": { "dark": "#22b8a6", "light": "#00695e" },
		"grid": { "dark": "#3d4654", "light": "#98a1ab" },
		"toolGroup": { "dark": "#141820e6", "light": "#e9edf1eb" },
		"navButton": { "dark": "#14182080", "light": "#ffffff80" },
		"navHover": { "dark": "#465061cc", "light": "#ffffffcc" },
		"navBall": { "dark": "#ffffff12", "light": "#ffffff40" },
		"object": { "dark": "#c3ccd8", "light": "#3a4350" },
		"data": { "dark": "#7d8a9b", "light": "#66717e" },
		"axisX": "#e8604c",
		"axisY": "#4cbf7a",
		"axisZ": "#5b74f0",
		"kit.background": { "dark": "#222833", "light": "#d6dce3" },
		"kit.surface": { "dark": "#151920", "light": "#eef1f4" },
		"kit.bar": { "dark": "#161a21", "light": "#c9d0d8" },
		"kit.barHover": { "dark": "#2e3540", "light": "#e3e8ed" },
		"kit.field": { "dark": "#12161c", "light": "#ffffff" },
		"kit.text": { "dark": "#e3e8ef", "light": "#161b22" },
		"kit.dim": { "dark": "#8794a5", "light": "#5d6774" },
		"kit.body": { "dark": "#b8c1cd", "light": "#353c46" },
		"kit.selection": { "dark": "#1f7f74", "light": "#1f8a7d" },
		"kit.border": { "dark": "#262d37", "light": "#a3acb6" },
		"kit.primary": { "dark": "#1f7f74", "light": "#1f8a7d" },
		"kit.secondary": { "dark": "#38404d", "light": "#f4f6f8" },
		"kit.onSecondary": { "dark": "#e3e8ef", "light": "#161b22" },
		"kit.accent": { "dark": "#5fd6c6", "light": "#0f6e64" },
		"assistant.accent": "@sel",
		"assistant.accentHover": { "dark": "#24897d", "light": "#1f7f74" },
		"assistant.onAccent": "#ffffff",
		"assistant.surface": "@panelBack",
		"assistant.raised": "@panel",
		"assistant.border": "@gap",
		"assistant.text": "@text",
		"assistant.dim": "@dim",
		"kit.radius": 6,
		"kit.cardRadius": 6
	},
	"permissions": { "allow": ["studio"], "ask": ["agent"], "reviewers": ["studio", "user"] },
	"state": {
		"theme": "dark",
		"workspace": "Layout",
		"mode": "object",
		"tool": "select",
		"menuBar": {},
		"open": {},
		"view": {
			"camera": { "target": [0, 0, 0], "yaw": 0.7, "pitch": 0.58, "distance": 17.5, "fieldOfView": 0.68 },
			"selection": ["cube"]
		},
		"active": "cube",
		"scene": {
			"nodes": [
				{ "id": "camera", "name": "Camera", "kind": "camera", "camera": { "fieldOfView": 0.69 },
				  "translation": [7.36, -6.93, 4.96], "rotationDegrees": [63.6, 0, 46.7], "scale": [1, 1, 1] },
				{ "id": "cube", "name": "Cube", "kind": "mesh", "mesh": "cube", "material": "material",
				  "translation": [0, 0, 0], "rotationDegrees": [0, 0, 0], "scale": [1, 1, 1] },
				{ "id": "light", "name": "Light", "kind": "light", "light": { "type": "point", "intensity": 60 },
				  "translation": [4.08, 1.0, 5.9], "rotationDegrees": [37.3, 3.2, 106.9], "scale": [1, 1, 1] }
			],
			"materials": [{ "id": "material", "name": "Material", "baseColor": [0.8, 0.8, 0.8, 1], "roughness": 0.5 }]
		},
		"cursor": [0, 0, 0],
		"pivot": "median",
		"orientation": "global",
		"snap": false,
		"proportional": false,
		"shading": "solid",
		"overlays": true,
		"gizmos": true,
		"xray": false,
		"modal": null,
		"modalText": "",
		"undoStack": [],
		"redoStack": [],
		"last": "",
		"added": 0,
		"frame": 1,
		"start": 1,
		"end": 250,
		"playing": false,
		"propTab": "object",
		"panels": { "transform": true },
		"sidebar": false,
		"sidebarTab": "Item",
		"ctx": { "open": false, "menu": "", "x": 0, "y": 0 },
		"about": false,
		"lastOp": null,
		"lastBase": [],
		"redoOpen": true,
		"quickPick": { "open": false, "query": "" },
		"fileStatus": "",
		"opened": null,
		"openedName": null,
		"sizes": { "main": [1102], "left": [720], "right": [262] }
	},
	"computed": {
		"activeNode": "{{find(state.scene.nodes, it.id == state.active)}}",
		"selectedNodes": "{{filter(state.scene.nodes, contains(state.view.selection, it.id))}}",
		"gizmo": "{{merge({ visible: state.gizmos && contains(['move', 'rotate', 'scale'], state.tool), mode: state.tool == 'rotate' ? 'rotate' : state.tool == 'scale' ? 'scale' : 'translate', space: state.orientation == 'local' ? 'local' : 'world', snap: state.snap ? { translate: 1, rotate: 5, scale: 0.1 } : {} }, state.pivot == 'cursor' ? { pivot: state.cursor } : state.pivot == 'active' && computed.activeNode ? { pivot: computed.activeNode.translation } : {})}}"
	},
	"onLoad": { "set": "state.startScene", "to": "{{state.scene}}" },
	"root": {
		"id": "root",
		"color": "@gap",
		"children": [{
			"type": "column", "id": "workspace", "fill": true,
			"children": [
				{ "use": "topBar" },
				{
					"type": "split", "id": "areas", "width": "100%", "grow": 1, "bind": "state.sizes.main", "minSize": 240,
					"sashSize": 4, "defaultSizes": [1102],
					"children": [
						{
							"type": "split", "id": "left-areas", "direction": "column", "bind": "state.sizes.left",
							"minSize": [200, 60], "sashSize": 4, "defaultSizes": [720],
							"children": [{ "use": "viewportArea" }, { "use": "timelineArea" }]
						},
						{
							"type": "split", "id": "right-areas", "direction": "column", "bind": "state.sizes.right",
							"minSize": [80, 160], "sashSize": 4, "defaultSizes": [262],
							"children": [{ "use": "outlinerArea" }, { "use": "propertiesArea" }]
						}
					]
				},
				{ "use": "modelloStatusBar" }
			]
		},
		{ "id": "playback", "when": "{{state.playing != false}}", "width": 0, "height": 0, "every": { "ms": 42, "do": "tick" } },
		{ "use": "contextMenu", "id": "popup", "with": { "open": "state.ctx.open", "x": "{{state.ctx.x}}", "y": "{{state.ctx.y}}",
		  "items": "{{menus[state.ctx.menu] ?? []}}", "icons": "{{some(menus[state.ctx.menu] ?? [], it.icon != null)}}" } },
		{ "use": "dialog", "id": "about-dialog", "with": { "open": "state.about", "title": "Modello 1.0", "width": 360, "height": 170,
		  "message": "A 3D modeller written only as AffrescoUI screen documents: the stock host runs it.",
		  "buttons": [{ "title": "Close" }] } },
		{ "when": "{{state.quickPick.open}}", "use": "quickPick", "id": "search", "with": { "width": 460, "rows": 12, "rowHeight": 22,
		  "providers": [{ "items": "{{computed.searchItems}}", "placeholder": "Search for a command" }] } }]
	}
}
